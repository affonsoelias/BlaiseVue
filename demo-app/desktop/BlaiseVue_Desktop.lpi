        <IsPartOfProject Value="True"/>
        <UnitName Value="uDesktopBridge"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="bin/windows/BlaiseVue_Desktop"/>
    </Target>
    <SearchPaths>
