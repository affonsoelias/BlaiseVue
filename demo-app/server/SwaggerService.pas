function TSwaggerService.HandleRequest(Ctxt: THttpServerRequestAbstract; const CleanUrl: RawUtf8; out HttpResult: cardinal): Boolean;
var
  HostPort: RawUtf8;
  p: Integer;
begin
  Result := False;

  // 1. Interactive Swagger UI Explorer
  if (CleanUrl = '/api/docs') or (CleanUrl = '/api/docs/') or (CleanUrl = '/api/swagger') then
  begin
    Ctxt.OutContentType := 'text/html; charset=utf-8';
    Ctxt.OutContent := GetSwaggerHtml;
    HttpResult := HTTP_SUCCESS;
    Result := True;
    Exit;
  end;

  // 2. OpenAPI 3.0 JSON Specification
  if (CleanUrl = '/api/openapi.json') or (CleanUrl = '/api/docs/swagger.json') or (CleanUrl = '/api/swagger.json') then
  begin
    HostPort := '';
    p := Pos('host: ', LowerCase(string(Ctxt.InHeaders)));
    if p > 0 then
    begin
      HostPort := Trim(Copy(Ctxt.InHeaders, p + 6, MaxInt));
      p := Pos(#13, string(HostPort));
      if p > 0 then HostPort := Copy(HostPort, 1, p - 1);
      p := Pos(#10, string(HostPort));
      if p > 0 then HostPort := Copy(HostPort, 1, p - 1);
    end;

    Ctxt.OutContentType := JSON_CONTENT_TYPE;
    Ctxt.OutContent := GenerateOpenApiJson(HostPort);
    HttpResult := HTTP_SUCCESS;
    Result := True;
    Exit;
  end;
end;

