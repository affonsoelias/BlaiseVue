unit AuthService;

{
  AuthService - Enterprise mORMot 2 Authentication & JWT Service
  --------------------------------------------------------------
  Auto-generated by BlaiseVue CLI (bv mormot auth)
  Provides native password hashing (SHA-256) and RFC-compliant JWT tokens (HS256).

  Endpoints:
  - POST /api/auth/login    : Authenticates user credentials & returns JWT token
  - POST /api/auth/logout   : Invalidates / flushes active session
  - GET  /api/auth/me       : Returns current authenticated user profile
  - POST /api/auth/register : Registers new user account
}

{$I mormot.defines.inc}

interface

uses
  sysutils,
  classes,
  dateutils,
  variants,
  mormot.core.base,
  mormot.core.os,
  mormot.core.text,
  mormot.core.buffers,
  mormot.core.json,
  mormot.core.variants,
  mormot.crypt.core,
  mormot.net.http,
  mormot.net.server,
  ServerModels;

type
  TBroadcastEventProc = procedure(const EventName, DataJson: RawUtf8) of object;

  TAuthService = class
  private
    FSecretKey: RawUtf8;
    FUsers: TUserWithPasswordDynArray;
    FNextId: Integer;
    FOnBroadcast: TBroadcastEventProc;
    function FindUserIndexByEmail(const AEmail: RawUtf8): Integer;
    function FindUserIndexById(AId: Integer): Integer;
    function HashPassword(const APassword: RawUtf8): RawUtf8;
  public
    constructor Create(const ASecretKey: RawUtf8 = 'blaisevue_jwt_super_secret_key_2026');
    destructor Destroy; override;
    function GenerateJwt(const AUser: TAuthUser): RawUtf8;
    function ValidateToken(const AToken: RawUtf8; out AUser: TAuthUser): Boolean;
    function Login(const AEmail, APassword: RawUtf8; out AToken: RawUtf8; out AUser: TAuthUser): Boolean;
    function RegisterUser(const AName, AEmail, APassword, ARole: RawUtf8; out AToken: RawUtf8; out AUser: TAuthUser): Boolean;
    function UserToJson(const AUser: TAuthUser): RawUtf8;
    function HandleRequest(Ctxt: THttpServerRequestAbstract; const CleanUrl: RawUtf8; out HttpResult: cardinal): Boolean;
    property SecretKey: RawUtf8 read FSecretKey write FSecretKey;
    property OnBroadcast: TBroadcastEventProc read FOnBroadcast write FOnBroadcast;
  end;

implementation

{ TAuthService }

constructor TAuthService.Create(const ASecretKey: RawUtf8);
var
  Idx: Integer;
begin
  inherited Create;
  FSecretKey := ASecretKey;
  FNextId := 1;
  SetLength(FUsers, 3);

  // 1. Seed Administrator
  FUsers[0].User.ID := FNextId;
  Inc(FNextId);
  FUsers[0].User.Name := 'Admin';
  FUsers[0].User.Email := 'admin@blaisevue.dev';
  FUsers[0].User.Role := 'admin';
  FUsers[0].User.CreatedAt := DateTimeToStr(Now);
  FUsers[0].PasswordHash := HashPassword('admin123');

  // 2. Seed Manager
  FUsers[1].User.ID := FNextId;
  Inc(FNextId);
  FUsers[1].User.Name := 'Manager';
  FUsers[1].User.Email := 'manager@blaisevue.dev';
  FUsers[1].User.Role := 'manager';
  FUsers[1].User.CreatedAt := DateTimeToStr(Now);
  FUsers[1].PasswordHash := HashPassword('manager123');

  // 3. Seed Standard User
  FUsers[2].User.ID := FNextId;
  Inc(FNextId);
  FUsers[2].User.Name := 'Standard User';
  FUsers[2].User.Email := 'user@blaisevue.dev';
  FUsers[2].User.Role := 'user';
  FUsers[2].User.CreatedAt := DateTimeToStr(Now);
  FUsers[2].PasswordHash := HashPassword('user123');
end;

destructor TAuthService.Destroy;
begin
  SetLength(FUsers, 0);
  inherited Destroy;
end;

function TAuthService.FindUserIndexByEmail(const AEmail: RawUtf8): Integer;
var
  i: Integer;
  Target: RawUtf8;
begin
  Result := -1;
  Target := LowerCase(Trim(AEmail));
  for i := 0 to High(FUsers) do
  begin
    if LowerCase(Trim(FUsers[i].User.Email)) = Target then
      Exit(i);
  end;
end;

function TAuthService.FindUserIndexById(AId: Integer): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := 0 to High(FUsers) do
  begin
    if FUsers[i].User.ID = AId then
      Exit(i);
  end;
end;

function TAuthService.HashPassword(const APassword: RawUtf8): RawUtf8;
begin
  Result := Sha256('bv_salt_2026_' + APassword);
end;

function TAuthService.UserToJson(const AUser: TAuthUser): RawUtf8;
begin
  Result := '{"id":' + IntToStr(AUser.ID) +
            ',"name":"' + StringReplace(AUser.Name, '"', '\"', [rfReplaceAll]) + '"' +
            ',"email":"' + StringReplace(AUser.Email, '"', '\"', [rfReplaceAll]) + '"' +
            ',"role":"' + StringReplace(AUser.Role, '"', '\"', [rfReplaceAll]) + '"' +
            ',"createdAt":"' + AUser.CreatedAt + '"}';
end;

function TAuthService.GenerateJwt(const AUser: TAuthUser): RawUtf8;
var
  HeaderJson, PayloadJson, HeaderB64, PayloadB64, SigningInput, SigB64: RawUtf8;
  NowUnix, ExpUnix: Int64;
  Digest: TSha256Digest;
begin
  HeaderJson := '{"alg":"HS256","typ":"JWT"}';
  NowUnix := DateTimeToUnix(Now);
  ExpUnix := NowUnix + (24 * 3600); // 24 hours validity

  PayloadJson := '{"sub":' + IntToStr(AUser.ID) +
                 ',"email":"' + StringReplace(AUser.Email, '"', '\"', [rfReplaceAll]) + '"' +
                 ',"name":"' + StringReplace(AUser.Name, '"', '\"', [rfReplaceAll]) + '"' +
                 ',"role":"' + StringReplace(AUser.Role, '"', '\"', [rfReplaceAll]) + '"' +
                 ',"iat":' + IntToStr(NowUnix) +
                 ',"exp":' + IntToStr(ExpUnix) + '}';

  HeaderB64 := BinToBase64uri(HeaderJson);
  PayloadB64 := BinToBase64uri(PayloadJson);
  SigningInput := HeaderB64 + '.' + PayloadB64;

  HmacSha256(FSecretKey, SigningInput, Digest);
  SigB64 := BinToBase64uri(Digest);

  Result := SigningInput + '.' + SigB64;
end;

function TAuthService.ValidateToken(const AToken: RawUtf8; out AUser: TAuthUser): Boolean;
var
  p1, p2: Integer;
  SigningInput, SigReceived, ExpectedSig, PayloadB64, PayloadJson: RawUtf8;
  Digest: TSha256Digest;
  Doc: TDocVariantData;
  ExpUnix: Int64;
  V: Variant;
begin
  Result := False;
  FillChar(AUser, SizeOf(AUser), 0);
  if AToken = '' then Exit;

  p1 := Pos('.', string(AToken));
  if p1 = 0 then Exit;
  p2 := PosEx('.', string(AToken), p1 + 1);
  if p2 = 0 then Exit;

  SigningInput := Copy(AToken, 1, p2 - 1);
  SigReceived := Copy(AToken, p2 + 1, MaxInt);

  HmacSha256(FSecretKey, SigningInput, Digest);
  ExpectedSig := BinToBase64uri(Digest);

  if SigReceived <> ExpectedSig then
    Exit;

  PayloadB64 := Copy(AToken, p1 + 1, p2 - p1 - 1);
  PayloadJson := Base64uriToBin(PayloadB64);

  Doc.InitJson(PayloadJson);
  try
    V := Doc.GetValueOrDefault('exp', 0);
    ExpUnix := Int64(V);
    if (ExpUnix > 0) and (DateTimeToUnix(Now) > ExpUnix) then
      Exit; // Token expired!

    V := Doc.GetValueOrDefault('sub', 0);
    AUser.ID := Integer(V);
    V := Doc.GetValueOrDefault('name', '');
    AUser.Name := VariantToUtf8(V);
    V := Doc.GetValueOrDefault('email', '');
    AUser.Email := VariantToUtf8(V);
    V := Doc.GetValueOrDefault('role', 'user');
    AUser.Role := VariantToUtf8(V);
    Result := True;
  finally
    Doc.Clear;
  end;
end;

function TAuthService.Login(const AEmail, APassword: RawUtf8; out AToken: RawUtf8; out AUser: TAuthUser): Boolean;
var
  Idx: Integer;
  ExpectedHash: RawUtf8;
begin
  Result := False;
  AToken := '';
  FillChar(AUser, SizeOf(AUser), 0);

  Idx := FindUserIndexByEmail(AEmail);
  if Idx < 0 then Exit;

  ExpectedHash := HashPassword(APassword);
  if FUsers[Idx].PasswordHash <> ExpectedHash then Exit;

  AUser := FUsers[Idx].User;
  AToken := GenerateJwt(AUser);
  Result := True;
end;

function TAuthService.RegisterUser(const AName, AEmail, APassword, ARole: RawUtf8; out AToken: RawUtf8; out AUser: TAuthUser): Boolean;
var
  Idx: Integer;
  NewEntry: TUserWithPassword;
begin
  Result := False;
  AToken := '';
  FillChar(AUser, SizeOf(AUser), 0);

  if Trim(AEmail) = '' then Exit;
  if FindUserIndexByEmail(AEmail) >= 0 then Exit; // Already exists

  NewEntry.User.ID := FNextId;
  Inc(FNextId);
  NewEntry.User.Name := Trim(AName);
  if NewEntry.User.Name = '' then
    NewEntry.User.Name := 'User ' + IntToStr(NewEntry.User.ID);
  NewEntry.User.Email := LowerCase(Trim(AEmail));
  NewEntry.User.Role := LowerCase(Trim(ARole));
  if (NewEntry.User.Role <> 'admin') and (NewEntry.User.Role <> 'manager') then
    NewEntry.User.Role := 'user';
  NewEntry.User.CreatedAt := DateTimeToStr(Now);
  NewEntry.PasswordHash := HashPassword(APassword);

  Idx := Length(FUsers);
  SetLength(FUsers, Idx + 1);
  FUsers[Idx] := NewEntry;

  AUser := NewEntry.User;
  AToken := GenerateJwt(AUser);
  Result := True;
end;

function TAuthService.HandleRequest(Ctxt: THttpServerRequestAbstract; const CleanUrl: RawUtf8; out HttpResult: cardinal): Boolean;
var
  Doc: TDocVariantData;
  V: Variant;
  ReqEmail, ReqPassword, ReqName, ReqRole, Token, OutToken: RawUtf8;
  AuthUser: TAuthUser;
  p: Integer;
begin
  Result := False;
  if (CleanUrl <> '/api/auth/login') and
     (CleanUrl <> '/api/auth/logout') and
     (CleanUrl <> '/api/auth/me') and
     (CleanUrl <> '/api/auth/register') then
    Exit;

  Result := True;
  Ctxt.OutContentType := JSON_CONTENT_TYPE;

  // 1. POST /api/auth/login
  if (Ctxt.Method = 'POST') and (CleanUrl = '/api/auth/login') then
  begin
    Doc.InitJson(Ctxt.InContent);
    try
      V := Doc.GetValueOrDefault('email', '');
      ReqEmail := VariantToUtf8(V);
      V := Doc.GetValueOrDefault('password', '');
      ReqPassword := VariantToUtf8(V);
    finally
      Doc.Clear;
    end;

    if Login(ReqEmail, ReqPassword, OutToken, AuthUser) then
    begin
      Ctxt.OutContent := '{"success":true,"token":"' + OutToken + '","user":' + UserToJson(AuthUser) + '}';
      HttpResult := HTTP_SUCCESS;
      if Assigned(FOnBroadcast) then
        FOnBroadcast('user_logged_in', '{"id":' + IntToStr(AuthUser.ID) + ',"email":"' + AuthUser.Email + '"}');
    end
    else
    begin
      Ctxt.OutContent := '{"success":false,"error":"Invalid email or password"}';
      HttpResult := 401; // Unauthorized
    end;
    Exit;
  end;

  // 2. POST /api/auth/logout
  if (Ctxt.Method = 'POST') and (CleanUrl = '/api/auth/logout') then
  begin
    Ctxt.OutContent := '{"success":true,"message":"Logged out successfully"}';
    HttpResult := HTTP_SUCCESS;
    Exit;
  end;

  // 3. GET /api/auth/me
  if (Ctxt.Method = 'GET') and (CleanUrl = '/api/auth/me') then
  begin
    Token := Ctxt.AuthBearer;
    if Token = '' then
    begin
      p := Pos('bearer ', LowerCase(string(Ctxt.InHeaders)));
      if p > 0 then
      begin
        Token := Trim(Copy(Ctxt.InHeaders, p + 7, MaxInt));
        p := Pos(#13, string(Token));
        if p > 0 then Token := Copy(Token, 1, p - 1);
        p := Pos(#10, string(Token));
        if p > 0 then Token := Copy(Token, 1, p - 1);
      end;
    end;

    if ValidateToken(Token, AuthUser) then
    begin
      Ctxt.OutContent := '{"success":true,"user":' + UserToJson(AuthUser) + '}';
      HttpResult := HTTP_SUCCESS;
    end
    else
    begin
      Ctxt.OutContent := '{"success":false,"error":"Unauthorized or expired token"}';
      HttpResult := 401;
    end;
    Exit;
  end;

  // 4. POST /api/auth/register
  if (Ctxt.Method = 'POST') and (CleanUrl = '/api/auth/register') then
  begin
    Doc.InitJson(Ctxt.InContent);
    try
      V := Doc.GetValueOrDefault('name', '');
      ReqName := VariantToUtf8(V);
      V := Doc.GetValueOrDefault('email', '');
      ReqEmail := VariantToUtf8(V);
      V := Doc.GetValueOrDefault('password', '');
      ReqPassword := VariantToUtf8(V);
      V := Doc.GetValueOrDefault('role', 'user');
      ReqRole := VariantToUtf8(V);
    finally
      Doc.Clear;
    end;

    if RegisterUser(ReqName, ReqEmail, ReqPassword, ReqRole, OutToken, AuthUser) then
    begin
      Ctxt.OutContent := '{"success":true,"token":"' + OutToken + '","user":' + UserToJson(AuthUser) + '}';
      HttpResult := HTTP_CREATED;
      if Assigned(FOnBroadcast) then
        FOnBroadcast('user_registered', '{"id":' + IntToStr(AuthUser.ID) + ',"email":"' + AuthUser.Email + '"}');
    end
    else
    begin
      Ctxt.OutContent := '{"success":false,"error":"Registration failed. Email may already exist."}';
      HttpResult := HTTP_BADREQUEST;
    end;
    Exit;
  end;

  Ctxt.OutContent := '{"error":"Method not allowed"}';
  HttpResult := HTTP_BADREQUEST;
end;

end.

