function TCrudCustomerService.FindIndexById(AId: Integer): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := 0 to High(FItems) do
    if FItems[i].ID = AId then
      Exit(i);
end;

function TCrudCustomerService.ItemToJson(const AItem: TCustomer): RawUtf8;
var
  SNum: string;
begin
  Result := '{"id":' + IntToStr(AItem.ID);
  Result := Result + ',"name":"' + StringReplace(StringReplace(AItem.Name, '\', '\\', [rfReplaceAll]), '"', '\"', [rfReplaceAll]) + '"';
  Result := Result + ',"email":"' + StringReplace(StringReplace(AItem.Email, '\', '\\', [rfReplaceAll]), '"', '\"', [rfReplaceAll]) + '"';
  Result := Result + ',"phone":"' + StringReplace(StringReplace(AItem.Phone, '\', '\\', [rfReplaceAll]), '"', '\"', [rfReplaceAll]) + '"';
  if AItem.Active then
    Result := Result + ',"active":true'
  else
    Result := Result + ',"active":false';
  Result := Result + ',"createdAt":"' + AItem.CreatedAt + '"}';
end;

function TCrudCustomerService.GetAllJson: RawUtf8;
var
  i: Integer;
begin
  Result := '[';
  for i := 0 to High(FItems) do
  begin
    if i > 0 then Result := Result + ',';
    Result := Result + ItemToJson(FItems[i]);
  end;
  Result := Result + ']';
end;

function TCrudCustomerService.GetByIdJson(AId: Integer; out AJson: RawUtf8): Boolean;
var
  Idx: Integer;
begin
  Idx := FindIndexById(AId);
  if Idx >= 0 then
  begin
    AJson := ItemToJson(FItems[Idx]);
    Result := True;
  end
  else
  begin
    AJson := '';
    Result := False;
  end;
end;

function TCrudCustomerService.CreateItemFromJson(const AJson: RawUtf8; out ANewId: Integer; out AItemJson: RawUtf8): Boolean;
var
  Doc: TDocVariantData;
  V: Variant;
  Idx: Integer;
  NewItem: TCustomer;
begin
  Result := False;
  ANewId := 0;
  AItemJson := '';
  Doc.InitJson(AJson);
  try
    NewItem.ID := FNextId;
    Inc(FNextId);
    V := Doc.GetValueOrDefault('name', 'New Customer');
    NewItem.Name := VariantToUtf8(V);
    V := Doc.GetValueOrDefault('email', '');
    NewItem.Email := VariantToUtf8(V);
    V := Doc.GetValueOrDefault('phone', '');
    NewItem.Phone := VariantToUtf8(V);
    V := Doc.GetValueOrDefault('active', True);
    NewItem.Active := Boolean(V);
    NewItem.CreatedAt := DateTimeToStr(Now);
    Idx := Length(FItems);
    SetLength(FItems, Idx + 1);
    FItems[Idx] := NewItem;
    ANewId := NewItem.ID;
    AItemJson := ItemToJson(NewItem);
    Result := True;
  finally
    Doc.Clear;
  end;
end;

function TCrudCustomerService.UpdateItemFromJson(AId: Integer; const AJson: RawUtf8; out AItemJson: RawUtf8): Boolean;
var
  Doc: TDocVariantData;
  V: Variant;
  Idx: Integer;
begin
  Result := False;
  AItemJson := '';
  Idx := FindIndexById(AId);
  if Idx < 0 then Exit;
  Doc.InitJson(AJson);
  try
    V := Doc.GetValueOrDefault('name', FItems[Idx].Name);
    FItems[Idx].Name := VariantToUtf8(V);
    V := Doc.GetValueOrDefault('email', FItems[Idx].Email);
    FItems[Idx].Email := VariantToUtf8(V);
    V := Doc.GetValueOrDefault('phone', FItems[Idx].Phone);
    FItems[Idx].Phone := VariantToUtf8(V);
    V := Doc.GetValueOrDefault('active', FItems[Idx].Active);
    FItems[Idx].Active := Boolean(V);
    AItemJson := ItemToJson(FItems[Idx]);
    Result := True;
  finally
    Doc.Clear;
  end;
end;

function TCrudCustomerService.DeleteItem(AId: Integer): Boolean;
var
  Idx, i: Integer;
begin
  Result := False;
  Idx := FindIndexById(AId);
  if Idx < 0 then Exit;
  for i := Idx to High(FItems) - 1 do
    FItems[i] := FItems[i + 1];
  SetLength(FItems, Length(FItems) - 1);
  Result := True;
end;

function TCrudCustomerService.HandleRequest(Ctxt: THttpServerRequestAbstract; const CleanUrl: RawUtf8; out HttpResult: cardinal): Boolean;
var
  BasePath, IdStr, OutJson, NewJson: RawUtf8;
  ItemId, ValCode, NewId: Integer;
begin
  Result := False;
  BasePath := '/api/customers';
  if (CleanUrl <> BasePath) and (Copy(CleanUrl, 1, Length(BasePath) + 1) <> BasePath + '/') then
    Exit;

  Result := True;
  Ctxt.OutContentType := JSON_CONTENT_TYPE;

  // 1. GET /api/customers
  if (Ctxt.Method = 'GET') and (CleanUrl = BasePath) then
  begin
    Ctxt.OutContent := GetAllJson;
    HttpResult := HTTP_SUCCESS;
    Exit;
  end;

  // 2. GET /api/customers/:id
  if (Ctxt.Method = 'GET') and (Copy(CleanUrl, 1, Length(BasePath) + 1) = BasePath + '/') then
  begin
    IdStr := Copy(CleanUrl, Length(BasePath) + 2, MaxInt);
    Val(string(IdStr), ItemId, ValCode);
    if (ValCode = 0) and GetByIdJson(ItemId, OutJson) then
    begin
      Ctxt.OutContent := OutJson;
      HttpResult := HTTP_SUCCESS;
    end
    else
    begin
      Ctxt.OutContent := '{"error":"Customer not found","id":' + IdStr + '}';
      HttpResult := HTTP_NOTFOUND;
    end;
    Exit;
  end;

  // 3. POST /api/customers
  if (Ctxt.Method = 'POST') and (CleanUrl = BasePath) then
  begin
    if CreateItemFromJson(Ctxt.InContent, NewId, NewJson) then
    begin
      Ctxt.OutContent := '{"success":true,"id":' + IntToStr(NewId) + ',"data":' + NewJson + '}';
      HttpResult := HTTP_CREATED;
      if Assigned(FOnBroadcast) then
        FOnBroadcast('customer_created', NewJson);
    end
    else
    begin
      Ctxt.OutContent := '{"error":"Failed to create customer"}';
      HttpResult := HTTP_BADREQUEST;
    end;
    Exit;
  end;

  // 4. PUT /api/customers/:id
  if (Ctxt.Method = 'PUT') and (Copy(CleanUrl, 1, Length(BasePath) + 1) = BasePath + '/') then
  begin
    IdStr := Copy(CleanUrl, Length(BasePath) + 2, MaxInt);
    Val(string(IdStr), ItemId, ValCode);
    if (ValCode = 0) and UpdateItemFromJson(ItemId, Ctxt.InContent, NewJson) then
    begin
      Ctxt.OutContent := '{"success":true,"id":' + IntToStr(ItemId) + ',"data":' + NewJson + '}';
      HttpResult := HTTP_SUCCESS;
      if Assigned(FOnBroadcast) then
        FOnBroadcast('customer_updated', NewJson);
    end
    else
    begin
      Ctxt.OutContent := '{"error":"Customer not found or invalid payload","id":' + IdStr + '}';
      HttpResult := HTTP_NOTFOUND;
    end;
    Exit;
  end;

  // 5. DELETE /api/customers/:id
  if (Ctxt.Method = 'DELETE') and (Copy(CleanUrl, 1, Length(BasePath) + 1) = BasePath + '/') then
  begin
    IdStr := Copy(CleanUrl, Length(BasePath) + 2, MaxInt);
    Val(string(IdStr), ItemId, ValCode);
    if (ValCode = 0) and DeleteItem(ItemId) then
    begin
      Ctxt.OutContent := '{"success":true,"id":' + IntToStr(ItemId) + '}';
      HttpResult := HTTP_SUCCESS;
      if Assigned(FOnBroadcast) then
        FOnBroadcast('customer_deleted', '{"id":' + IntToStr(ItemId) + '}');
    end
    else
    begin
      Ctxt.OutContent := '{"error":"Customer not found","id":' + IdStr + '}';
      HttpResult := HTTP_NOTFOUND;
    end;
    Exit;
  end;

  Ctxt.OutContent := '{"error":"Method not allowed"}';
  HttpResult := HTTP_BADREQUEST;
end;

