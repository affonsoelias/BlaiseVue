    FItems[Idx].Category := VariantToUtf8(V);
    AItemJson := ItemToJson(FItems[Idx]);
    Result := True;
  finally
    Doc.Clear;
  end;
end;

function TCrudProductService.DeleteItem(AId: Integer): Boolean;
var
  Idx, i: Integer;
begin
  Result := False;
  Idx := FindIndexById(AId);
  if Idx < 0 then Exit;
  for i := Idx to High(FItems) - 1 do
    FItems[i] := FItems[i + 1];
  SetLength(FItems, Length(FItems) - 1);
  Result := True;
end;

function TCrudProductService.HandleRequest(Ctxt: THttpServerRequestAbstract; const CleanUrl: RawUtf8; out HttpResult: cardinal): Boolean;
var
  BasePath, IdStr, OutJson, NewJson: RawUtf8;
  ItemId, ValCode, NewId: Integer;
begin
  Result := False;
  BasePath := '/api/products';
  if (CleanUrl <> BasePath) and (Copy(CleanUrl, 1, Length(BasePath) + 1) <> BasePath + '/') then
    Exit;

  Result := True;
  Ctxt.OutContentType := JSON_CONTENT_TYPE;

  // 1. GET /api/products
  if (Ctxt.Method = 'GET') and (CleanUrl = BasePath) then
  begin
    Ctxt.OutContent := GetAllJson;
    HttpResult := HTTP_SUCCESS;
    Exit;
  end;

  // 2. GET /api/products/:id
  if (Ctxt.Method = 'GET') and (Copy(CleanUrl, 1, Length(BasePath) + 1) = BasePath + '/') then
  begin
    IdStr := Copy(CleanUrl, Length(BasePath) + 2, MaxInt);
    Val(string(IdStr), ItemId, ValCode);
    if (ValCode = 0) and GetByIdJson(ItemId, OutJson) then
    begin
      Ctxt.OutContent := OutJson;
      HttpResult := HTTP_SUCCESS;
    end
    else
    begin
      Ctxt.OutContent := '{"error":"Product not found","id":' + IdStr + '}';
      HttpResult := HTTP_NOTFOUND;
    end;
    Exit;
  end;

  // 3. POST /api/products
  if (Ctxt.Method = 'POST') and (CleanUrl = BasePath) then
  begin
    if CreateItemFromJson(Ctxt.InContent, NewId, NewJson) then
    begin
      Ctxt.OutContent := '{"success":true,"id":' + IntToStr(NewId) + ',"data":' + NewJson + '}';
      HttpResult := HTTP_CREATED;
      if Assigned(FOnBroadcast) then
        FOnBroadcast('product_created', NewJson);
    end
    else
    begin
      Ctxt.OutContent := '{"error":"Failed to create product"}';
      HttpResult := HTTP_BADREQUEST;
    end;
    Exit;
  end;

  // 4. PUT /api/products/:id
  if (Ctxt.Method = 'PUT') and (Copy(CleanUrl, 1, Length(BasePath) + 1) = BasePath + '/') then
  begin
    IdStr := Copy(CleanUrl, Length(BasePath) + 2, MaxInt);
    Val(string(IdStr), ItemId, ValCode);
    if (ValCode = 0) and UpdateItemFromJson(ItemId, Ctxt.InContent, NewJson) then
    begin
      Ctxt.OutContent := '{"success":true,"id":' + IntToStr(ItemId) + ',"data":' + NewJson + '}';
      HttpResult := HTTP_SUCCESS;
      if Assigned(FOnBroadcast) then
        FOnBroadcast('product_updated', NewJson);
    end
    else
    begin
      Ctxt.OutContent := '{"error":"Product not found or invalid payload","id":' + IdStr + '}';
      HttpResult := HTTP_NOTFOUND;
    end;
    Exit;
  end;

  // 5. DELETE /api/products/:id
  if (Ctxt.Method = 'DELETE') and (Copy(CleanUrl, 1, Length(BasePath) + 1) = BasePath + '/') then
  begin
    IdStr := Copy(CleanUrl, Length(BasePath) + 2, MaxInt);
    Val(string(IdStr), ItemId, ValCode);
    if (ValCode = 0) and DeleteItem(ItemId) then
    begin
      Ctxt.OutContent := '{"success":true,"id":' + IntToStr(ItemId) + '}';
      HttpResult := HTTP_SUCCESS;
      if Assigned(FOnBroadcast) then
        FOnBroadcast('product_deleted', '{"id":' + IntToStr(ItemId) + '}');
    end
    else
    begin
      Ctxt.OutContent := '{"error":"Product not found","id":' + IdStr + '}';
      HttpResult := HTTP_NOTFOUND;
    end;
    Exit;
  end;

  Ctxt.OutContent := '{"error":"Method not allowed"}';
  HttpResult := HTTP_BADREQUEST;
end;

