function TCrudProductService.FindIndexById(AId: Integer): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := 0 to High(FItems) do
    if FItems[i].ID = AId then
      Exit(i);
end;

function TCrudProductService.ItemToJson(const AItem: TProduct): RawUtf8;
var
  SNum: string;
begin
  Result := '{"id":' + IntToStr(AItem.ID);
  Result := Result + ',"name":"' + StringReplace(StringReplace(AItem.Name, '\', '\\', [rfReplaceAll]), '"', '\"', [rfReplaceAll]) + '"';
  Str(AItem.Price:0:2, SNum);
  Result := Result + ',"price":' + RawUtf8(Trim(SNum));
  Result := Result + ',"stock":' + IntToStr(AItem.Stock);
  Result := Result + ',"category":"' + StringReplace(StringReplace(AItem.Category, '\', '\\', [rfReplaceAll]), '"', '\"', [rfReplaceAll]) + '"';
  Result := Result + ',"createdAt":"' + AItem.CreatedAt + '"}';
end;

function TCrudProductService.GetAllJson: RawUtf8;
var
  i: Integer;
begin
  Result := '[';
  for i := 0 to High(FItems) do
  begin
    if i > 0 then Result := Result + ',';
    Result := Result + ItemToJson(FItems[i]);
  end;
  Result := Result + ']';
end;

function TCrudProductService.GetByIdJson(AId: Integer; out AJson: RawUtf8): Boolean;
var
  Idx: Integer;
begin
  Idx := FindIndexById(AId);
  if Idx >= 0 then
  begin
    AJson := ItemToJson(FItems[Idx]);
    Result := True;
  end
  else
  begin
    AJson := '';
    Result := False;
  end;
end;

function TCrudProductService.CreateItemFromJson(const AJson: RawUtf8; out ANewId: Integer; out AItemJson: RawUtf8): Boolean;
var
  Doc: TDocVariantData;
  V: Variant;
  Idx: Integer;
  NewItem: TProduct;
begin
  Result := False;
  ANewId := 0;
  AItemJson := '';
  Doc.InitJson(AJson);
  try
    NewItem.ID := FNextId;
    Inc(FNextId);
    V := Doc.GetValueOrDefault('name', 'New Product');
    NewItem.Name := VariantToUtf8(V);
    V := Doc.GetValueOrDefault('price', 0.0);
    NewItem.Price := Double(V);
    V := Doc.GetValueOrDefault('stock', 0);
    NewItem.Stock := Integer(V);
    V := Doc.GetValueOrDefault('category', 'New Product');
    NewItem.Category := VariantToUtf8(V);
    NewItem.CreatedAt := DateTimeToStr(Now);
    Idx := Length(FItems);
    SetLength(FItems, Idx + 1);
    FItems[Idx] := NewItem;
    ANewId := NewItem.ID;
    AItemJson := ItemToJson(NewItem);
    Result := True;
  finally
    Doc.Clear;
  end;
end;

function TCrudProductService.UpdateItemFromJson(AId: Integer; const AJson: RawUtf8; out AItemJson: RawUtf8): Boolean;
var
  Doc: TDocVariantData;
  V: Variant;
  Idx: Integer;
  NewTitle: RawUtf8;
begin
  Result := False;
  AItemJson := '';
  Idx := FindIndexById(AId);
  if Idx < 0 then Exit;
  Doc.InitJson(AJson);
  try
    V := Doc.GetValueOrDefault('name', FItems[Idx].Name);
    FItems[Idx].Name := VariantToUtf8(V);
    V := Doc.GetValueOrDefault('price', FItems[Idx].Price);
