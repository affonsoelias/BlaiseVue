program reports_test;

{$mode objfpc}

uses
  JS, Web, SysUtils,
  BVTestUtils, BVComponents, BVReactivity, BVCompiler, BVDataSet,
  BlaiseReports, BVPascalDX, BlaiseVue,
  uBVReportViewer;

function CreateSampleSalesDataSet: TBVDataSet;
var
  Rows: TJSArray;
  R1, R2, R3, R4: TJSObject;
begin
  Result := TBVDataSet.Create;
  Rows := TJSArray.new;

  R1 := TJSObject.new;
  R1['id'] := 101;
  R1['customer'] := 'Acme Corporation';
  R1['category'] := 'Enterprise Cloud';
  R1['total'] := 1250.50;
  R1['paid'] := True;
  Rows.push(R1);

  R2 := TJSObject.new;
  R2['id'] := 102;
  R2['customer'] := 'Globex Systems, Inc.';
  R2['category'] := 'Hardware & POS';
  R2['total'] := 450.00;
  R2['paid'] := True;
  Rows.push(R2);

  R3 := TJSObject.new;
  R3['id'] := 103;
  R3['customer'] := 'Initech "Labs" & Co';
  R3['category'] := 'Consulting <Pro>';
  R3['total'] := 800.25;
  R3['paid'] := False;
  Rows.push(R3);

  R4 := TJSObject.new;
  R4['id'] := 104;
  R4['customer'] := 'Stark Industries';
  R4['category'] := 'Enterprise Cloud';
  R4['total'] := 2500.25;
  R4['paid'] := True;
  Rows.push(R4);

  Result.LoadFromData(Rows);
end;

var
  Wrapper: TWrapper;
  ViewerProps: TJSObject;

begin
  Register_uBVReportViewer;

  Describe('BlaiseVue 5.0 Pillar 1: BlaiseReports (Native Vector PDF, Excel & Print Engine)', procedure
    begin
      // 1. Declarative Fluent Builder & TBVDataSet Binding
      It('should configure TBVReport fluently and bind directly to TBVDataSet', procedure
        var
          DS: TBVDataSet;
          Rep: TBVReport;
          MetaJS: TJSObject;
          ColsJS: TJSArray;
        begin
          DS := CreateSampleSalesDataSet;
          Rep := TBVReport.Create(DS);
          Rep.Title('Monthly Sales Report')
             .Subtitle('Q4 Consolidated Revenue')
             .Header('Generated by BlaiseVue ERP')
             .Footer('Confidential - Internal Audit Only')
             .Company('BlaiseVue Enterprise Ltd.', 'BV-ERP')
             .Author('Finance Bot')
             .ThemeColor('#0f172a')
             .CurrencySymbol('$')
             .Columns(['id:Invoice #', 'customer:Customer Name', 'category:Segment', 'total:Amount:currency']);

          Expect(Rep.ReportTitle).ToBe('Monthly Sales Report');
          Expect(Rep.ReportSubtitle).ToBe('Q4 Consolidated Revenue');
          Expect(Rep.ReportHeader).ToBe('Generated by BlaiseVue ERP');
          Expect(Rep.ReportFooter).ToBe('Confidential - Internal Audit Only');
          Expect(Rep.CompanyName).ToBe('BlaiseVue Enterprise Ltd.');
          Expect(Rep.BadgeLogoText).ToBe('BV-ERP');
          Expect(Rep.GetRecordCount).ToBe(4);
          Expect(Rep.GetColumnCount).ToBe(4);

          MetaJS := Rep.ToJS;
          Expect(MetaJS['title']).ToBe('Monthly Sales Report');
          Expect(MetaJS['recordCount']).ToBe(4);
          ColsJS := TJSArray(MetaJS['columns']);
          Expect(ColsJS.length).ToBe(4);
          Expect(TJSObject(ColsJS[0])['fieldName']).ToBe('id');
          Expect(TJSObject(ColsJS[0])['caption']).ToBe('Invoice #');
          Expect(TJSObject(ColsJS[3])['fieldName']).ToBe('total');
          Expect(TJSObject(ColsJS[3])['format']).ToBe('currency');
          Expect(TJSObject(ColsJS[3])['align']).ToBe('right');
        end);

      // 2. Aggregate Summary Calculations (Sum, Average, Count, Min, Max)
      It('should compute accurate summary aggregates (aggSum, aggAverage, aggCount, aggMin, aggMax)', procedure
        var
          DS: TBVDataSet;
          Rep: TBVReport;
          SummariesJS: TJSArray;
        begin
          DS := CreateSampleSalesDataSet;
          Rep := TBVReport.Create(DS);
          Rep.CurrencySymbol('$')
             .AddSummary('Grand Total', 'total', aggSum, 'currency')
             .AddSummary('Average Order', 'total', aggAverage, 'currency')
             .AddSummary('Invoice Count', 'id', aggCount, 'integer')
             .AddSummary('Smallest Deal', 'total', aggMin, 'currency')
             .AddSummary('Largest Deal', 'total', aggMax, 'currency');

          Expect(Rep.GetSummaryCount).ToBe(5);
          // 1250.50 + 450.00 + 800.25 + 2500.25 = 5001.00
          Expect(Rep.ComputeSummary('total', aggSum)).ToBe(5001);
          // 5001.00 / 4 = 1250.25
          Expect(Rep.ComputeSummary('total', aggAverage)).ToBe(1250.25);
          Expect(Rep.ComputeSummary('id', aggCount)).ToBe(4);
          Expect(Rep.ComputeSummary('total', aggMin)).ToBe(450);
          Expect(Rep.ComputeSummary('total', aggMax)).ToBe(2500.25);

          SummariesJS := Rep.GetSummariesJS;
          Expect(SummariesJS.length).ToBe(5);
          Expect(TJSObject(SummariesJS[0])['label']).ToBe('Grand Total');
          Expect(TJSObject(SummariesJS[0])['formattedValue']).ToBe('$5,001.00');
          Expect(TJSObject(SummariesJS[2])['formattedValue']).ToBe('4');
        end);

      // 3a. WinAnsi text keeps Helvetica and is written as octal escapes, not raw characters
      It('should keep Helvetica and write accented WinAnsi text as octal escapes', procedure
        var
          DS: TBVDataSet;
          Rep: TBVReport;
          PdfContent, Accented: string;
        begin
          DS := CreateSampleSalesDataSet;
          Rep := TBVReport.Create(DS);
          asm Accented = 'Relat' + String.fromCharCode(0xF3) + 'rio ' + String.fromCharCode(0x20AC); end;
          Rep.Title(Accented).Columns(['customer:Customer']);
          PdfContent := Rep.GeneratePDF;
          Expect(Pos('/BaseFont /Helvetica', PdfContent) > 0).ToBe(True);
          Expect(Pos('(Relat\363rio \200) Tj', PdfContent) > 0).ToBe(True);
        end);

      // 3b. Text outside WinAnsi switches the PDF to the embedded Latin + Greek fonts
      It('should embed a Unicode font and stay pure ASCII when PDF text is Greek', procedure
        var
          DS: TBVDataSet;
          Rep: TBVReport;
          PdfContent, Greek: string;
          IsAscii, OffsetsOk: Boolean;
        begin
          asm Greek = String.fromCharCode(0x391, 0x3BD, 0x3B1, 0x3C6, 0x3BF, 0x3C1, 0x3AC); end;
          DS := CreateSampleSalesDataSet;
          Rep := TBVReport.Create(DS);
          Rep.Title(Greek + ' (2026)').Author(Greek).Columns(['customer:Customer']);
          PdfContent := Rep.GeneratePDF;
          IsAscii := False;
          OffsetsOk := False;
          asm
            IsAscii = !new RegExp('[^\\x00-\\x7F]').test(PdfContent);
            var offset = parseInt(PdfContent.substring(PdfContent.lastIndexOf('startxref') + 10), 10);
            OffsetsOk = PdfContent.substr(offset, 4) === 'xref';
          end;
          Expect(IsAscii).ToBe(True);
          Expect(OffsetsOk).ToBe(True);
          Expect(Pos('/Subtype /Type0', PdfContent) > 0).ToBe(True);
          Expect(Pos('/Encoding /Identity-H', PdfContent) > 0).ToBe(True);
          Expect(Pos('/FontFile2', PdfContent) > 0).ToBe(True);
          Expect(Pos('/ToUnicode', PdfContent) > 0).ToBe(True);
          Expect(Pos('/BaseFont /Helvetica', PdfContent) > 0).ToBe(False);
          Expect(Pos('/Title <FEFF0391', PdfContent) > 0).ToBe(True);
          Expect(Pos(') Tj', PdfContent) > 0).ToBe(False);
          Expect(Pos(' Tj', PdfContent) > 0).ToBe(True);
        end);

      // 3. Native Vector PDF 1.4 Generation & Multi-Page Pagination
      It('should generate valid native Vector PDF 1.4 documents with pagination, headers, footers and xref table', procedure
        var
          DS: TBVDataSet;
          Rep: TBVReport;
          PdfContent: string;
        begin
          DS := CreateSampleSalesDataSet;
          Rep := TBVReport.Create(DS);
          Rep.Title('Executive Revenue Report')
             .Header('Fiscal Year 2026')
             .Footer('BlaiseReports Vector Engine')
             .Company('BlaiseCorp')
             .RowsPerPage(2) // Force 4 records into 2 pages (2 rows per page)
             .Columns(['id:ID', 'customer:Customer', 'total:Total:currency'])
             .AddSummary('Total Revenue', 'total', aggSum, 'currency');

          Expect(Rep.GetPageCount).ToBe(2);

          PdfContent := Rep.ExportPDF('sales_2026.pdf');

          // Verify Export metadata
          Expect(Rep.LastExportedFileName).ToBe('sales_2026.pdf');
          Expect(Rep.LastExportedMimeType).ToBe('application/pdf');

          // Verify Vector PDF 1.4 structural markers
          Expect(Pos('%PDF-1.4', PdfContent) = 1).ToBe(True);
          Expect(Pos('/Type /Catalog', PdfContent) > 0).ToBe(True);
          Expect(Pos('/BaseFont /Helvetica-Bold', PdfContent) > 0).ToBe(True);
          Expect(Pos('(Executive Revenue Report) Tj', PdfContent) > 0).ToBe(True);
          Expect(Pos('(Fiscal Year 2026) Tj', PdfContent) > 0).ToBe(True);
          Expect(Pos('(Acme Corporation) Tj', PdfContent) > 0).ToBe(True);
          Expect(Pos('(Stark Industries) Tj', PdfContent) > 0).ToBe(True);
          Expect(Pos('(Total Revenue: $5,001.00) Tj', PdfContent) > 0).ToBe(True);

          // Verify multi-page running page numbers
          Expect(Pos('(Page 1 of 2) Tj', PdfContent) > 0).ToBe(True);
          Expect(Pos('(Page 2 of 2) Tj', PdfContent) > 0).ToBe(True);
          Expect(Pos('/Count 2', PdfContent) > 0).ToBe(True);

          // Verify XRef table and EOF trailer
          Expect(Pos('xref', PdfContent) > 0).ToBe(True);
          Expect(Pos('startxref', PdfContent) > 0).ToBe(True);
          Expect(Pos('%%EOF', PdfContent) > 0).ToBe(True);
        end);

      // 4. Native Excel (.xlsx / SpreadsheetML) Export with Typed Cells & Styles
      It('should generate native Excel SpreadsheetML with strongly typed Number/String/Boolean cells and currency styles', procedure
        var
          DS: TBVDataSet;
          Rep: TBVReport;
          XlsContent: string;
        begin
          DS := CreateSampleSalesDataSet;
          Rep := TBVReport.Create(DS);
          Rep.Title('Q4 Accounting Sheet')
             .Company('BlaiseVue Corp')
             .Columns(['id:ID:integer', 'customer:Customer', 'category:Category', 'total:Amount:currency', 'paid:Paid'])
             .AddSummary('Grand Total', 'total', aggSum, 'currency');

          XlsContent := Rep.ExportExcel('accounting_q4.xlsx');

          Expect(Rep.LastExportedFileName).ToBe('accounting_q4.xlsx');
          Expect(Pos('<?mso-application progid="Excel.Sheet"?>', XlsContent) > 0).ToBe(True);
          Expect(Pos('<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"', XlsContent) > 0).ToBe(True);
          Expect(Pos('<Style ss:ID="sCurrency">', XlsContent) > 0).ToBe(True);

          // Verify XML escaping for special characters in row 3 ('Initech "Labs" & Co', 'Consulting <Pro>')
          Expect(Pos('Initech &quot;Labs&quot; &amp; Co', XlsContent) > 0).ToBe(True);
          Expect(Pos('Consulting &lt;Pro&gt;', XlsContent) > 0).ToBe(True);

          // Verify strongly-typed Number and Boolean cells
          Expect(Pos('<Cell ss:StyleID="sCurrency"><Data ss:Type="Number">1250.5</Data></Cell>', XlsContent) > 0).ToBe(True);
          Expect(Pos('<Cell ss:StyleID="sInteger"><Data ss:Type="Number">101</Data></Cell>', XlsContent) > 0).ToBe(True);
          Expect(Pos('<Data ss:Type="Boolean">1</Data>', XlsContent) > 0).ToBe(True);

          // Verify Summary Row
          Expect(Pos('<Cell ss:StyleID="sSummaryLabel"><Data ss:Type="String">Grand Total</Data></Cell>', XlsContent) > 0).ToBe(True);
          Expect(Pos('<Cell ss:StyleID="sSummaryValue"><Data ss:Type="Number">5001</Data></Cell>', XlsContent) > 0).ToBe(True);
        end);

      // 5. Streaming RFC 4180 CSV Export with UTF-8 BOM & Custom Delimiters
      It('should generate RFC 4180 compliant CSV with UTF-8 BOM, quote escaping and custom delimiters', procedure
        var
          DS: TBVDataSet;
          Rep: TBVReport;
          CsvContent: string;
        begin
          DS := CreateSampleSalesDataSet;
          Rep := TBVReport.Create(DS);
          Rep.Columns(['id:ID', 'customer:Customer', 'total:Total'])
             .IncludeBOM(True)
             .CSVDelimiter(',')
             .AddSummary('Total Sum', 'total', aggSum);

          CsvContent := Rep.ExportCSV('customers.csv');

          Expect(Rep.LastExportedFileName).ToBe('customers.csv');
          // Verify header
          Expect(Pos('ID,Customer,Total', CsvContent) > 0).ToBe(True);
          // Verify RFC 4180 escaping for comma in 'Globex Systems, Inc.' and quotes in 'Initech "Labs" & Co'
          Expect(Pos('102,"Globex Systems, Inc.",450', CsvContent) > 0).ToBe(True);
          Expect(Pos('103,"Initech ""Labs"" & Co",800.25', CsvContent) > 0).ToBe(True);
          // Verify summary row
          Expect(Pos('Total Sum,"$5,001.00"', CsvContent) > 0).ToBe(True);

          // Test semicolon delimiter for European/Brazilian Excel locale
          Rep.CSVDelimiter(';');
          CsvContent := Rep.GenerateCSV;
          Expect(Pos('ID;Customer;Total', CsvContent) > 0).ToBe(True);
          Expect(Pos('101;Acme Corporation;1250.5', CsvContent) > 0).ToBe(True);
        end);

      // 6. Print-Optimized HTML & Thermal POS Layouts (A4, Letter, 80mm, 58mm)
      It('should generate print-optimized HTML with @media print and @page rules for A4, Letter and Thermal POS (80mm/58mm)', procedure
        var
          DS: TBVDataSet;
          Rep: TBVReport;
          HtmlA4, HtmlThermal80, HtmlThermal58: string;
        begin
          DS := CreateSampleSalesDataSet;
          Rep := TBVReport.Create(DS);
          Rep.Title('POS Receipt #9001')
             .Company('BlaiseRetail POS', 'POS')
             .Columns(['customer:Item', 'total:Price:currency'])
             .AddSummary('TOTAL DUE', 'total', aggSum, 'currency');

          // Default A4 Portrait
          HtmlA4 := Rep.GeneratePrintHTML;
          Expect(Pos('@page { size: A4 portrait; margin: 12mm; }', HtmlA4) > 0).ToBe(True);
          Expect(Pos('@media print', HtmlA4) > 0).ToBe(True);
          Expect(Pos('bv-layout-a4', HtmlA4) > 0).ToBe(True);

          // Thermal 80mm POS Receipt
          Rep.PageSize('thermal-80mm');
          Expect(Rep.Layout).ToBe(plThermal80mm);
          HtmlThermal80 := Rep.GeneratePrintHTML;
          Expect(Pos('@page { size: 80mm auto; margin: 2mm; }', HtmlThermal80) > 0).ToBe(True);
          Expect(Pos('bv-layout-thermal-80mm', HtmlThermal80) > 0).ToBe(True);
          Expect(Pos('TOTAL DUE', HtmlThermal80) > 0).ToBe(True);
          Expect(Pos('$5,001.00', HtmlThermal80) > 0).ToBe(True);

          // Thermal 58mm POS Receipt
          Rep.PageSize('58mm');
          Expect(Rep.Layout).ToBe(plThermal58mm);
          HtmlThermal58 := Rep.GeneratePrintHTML;
          Expect(Pos('@page { size: 58mm auto; margin: 1.5mm; }', HtmlThermal58) > 0).ToBe(True);
          Expect(Pos('bv-layout-thermal-58mm', HtmlThermal58) > 0).ToBe(True);
        end);

      // 7. Reactive <bv-report-viewer> Component Mounting & Interactive Toolbar
      It('should mount <bv-report-viewer> component and render report preview, summary cards and export buttons', procedure
        var
          DS: TBVDataSet;
          Rep: TBVReport;
          HtmlOut: string;
        begin
          DS := CreateSampleSalesDataSet;
          Rep := TBVReport.Create(DS);
          Rep.Title('Live Viewer Report')
             .Header('Interactive Preview Mode')
             .Footer('Generated by <bv-report-viewer>')
             .Company('BlaiseVue Cloud')
             .Columns(['id:ID', 'customer:Customer', 'total:Revenue:currency'])
             .AddSummary('Net Total', 'total', aggSum, 'currency');

          ViewerProps := TJSObject.new;
          ViewerProps['report'] := Rep;

          Wrapper := Mount('bv-report-viewer', ViewerProps);
          Expect(Wrapper.Element).ToBeDefined;
          Expect(Wrapper.Find('.bv-report-viewer-root')).ToBeDefined;

          HtmlOut := Wrapper.HTML;
          Expect(Pos('bv-report-toolbar', HtmlOut) > 0).ToBe(True);
          Expect(Pos('Live Viewer Report', HtmlOut) > 0).ToBe(True);
          Expect(Pos('Acme Corporation', HtmlOut) > 0).ToBe(True);
          Expect(Pos('$1,250.50', HtmlOut) > 0).ToBe(True);
          Expect(Pos('Net Total', HtmlOut) > 0).ToBe(True);
          Expect(Pos('$5,001.00', HtmlOut) > 0).ToBe(True);
          Expect(Pos('Export PDF', HtmlOut) > 0).ToBe(True);
          Expect(Pos('Export Excel', HtmlOut) > 0).ToBe(True);
          Expect(Pos('Export CSV', HtmlOut) > 0).ToBe(True);
        end);

      // 8. Zero-ASM Pascal DX Report Helpers (BVPascalDX)
      It('should create, configure and export reports using 100% pure Object Pascal DX helpers in BVPascalDX', procedure
        var
          DS: TBVDataSet;
          Rep: JSValue;
          PdfStr, XlsStr, CsvStr, HtmlStr: string;
          SumTotal: Double;
        begin
          DS := CreateSampleSalesDataSet;
          Rep := NewReport(DS);
          ReportSetTitle(Rep, 'DX Zero-ASM Report', 'Pure Pascal Reporting');
          ReportSetHeader(Rep, 'Header Line', 'Footer Line');
          ReportSetCompany(Rep, 'Pascal Systems', 'PS');
          ReportSetPageLayout(Rep, 'a4-landscape');
          ReportSetColumns(Rep, ['id:Order ID', 'customer:Client', 'total:Value:currency']);
          ReportAddSummary(Rep, 'Total Value', 'total', 'sum', 'currency');

          SumTotal := ReportComputeSummary(Rep, 'total', 'sum');
          Expect(SumTotal).ToBe(5001);

          PdfStr := ReportExportPDF(Rep, 'dx_report.pdf');
          Expect(Pos('%PDF-1.4', PdfStr) = 1).ToBe(True);
          Expect(Pos('(DX Zero-ASM Report) Tj', PdfStr) > 0).ToBe(True);

          XlsStr := ReportExportExcel(Rep, 'dx_report.xlsx');
          Expect(Pos('<Workbook', XlsStr) > 0).ToBe(True);

          CsvStr := ReportExportCSV(Rep, 'dx_report.csv');
          Expect(Pos('Order ID,Client,Value', CsvStr) > 0).ToBe(True);

          HtmlStr := ReportPrintPreview(Rep);
          Expect(Pos('bv-layout-a4-landscape', HtmlStr) > 0).ToBe(True);
        end);
    end);
end.
