<template>
  <div class="mobile-view-container">
    <bv-ion-app :mode="currentMode">
      <bv-ion-header>
        <bv-ion-toolbar>
          <bv-ion-title title="📱 BlaiseVue Mobile & Desktop Ecosystem" />
          <div slot="end">
            <bv-ion-badge :value="currentMode.toUpperCase()" :color="currentMode === 'ios' ? 'primary' : 'success'" />
          </div>
        </bv-ion-toolbar>
      </bv-ion-header>

      <bv-ion-content :padding="true">
        <!-- INTRO CARD -->
        <bv-ion-card title="Componentes Universais (Mobile, Web & Desktop)" subtitle="Ionic Aesthetics + Object Pascal">
          <p style="margin-bottom: 12px; color: #4b5563; line-height: 1.5;">
            Os componentes <strong>blaise-ui-mobile</strong> são 100% universais! Funcionam no <strong>Navegador Web</strong> (PWA), no <strong>Desktop nativo</strong> (via WebUI4Delphi) e no <strong>Dispositivo Móvel</strong> (via Capacitor/Android).
          </p>

          <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px;">
            <bv-ion-button label="🍎 Estilo iOS (Cupertino)" color="primary" fill="outline" @click="setIosMode" />
            <bv-ion-button label="🤖 Estilo Android (Material Design)" color="success" fill="outline" @click="setMdMode" />
          </div>
        </bv-ion-card>

        <!-- PASCAL CONTROLLERS CARD -->
        <bv-ion-card title="Controladores Pascal Tipados (BlaiseIonic.pas)" subtitle="Feedback e Diálogos Nativos">
          <p style="margin-bottom: 12px; color: #4b5563;">
            Dispare diálogos e notificações nativas diretamente do Object Pascal sem manipulação manual de DOM:
          </p>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px;">
            <bv-ion-button label="🔔 Toast" color="dark" @click="showToast" />
            <bv-ion-button label="💬 Alerta" color="primary" @click="showAlert" />
            <bv-ion-button label="❓ Confirmar" color="warning" @click="showConfirm" />
            <bv-ion-button label="⏳ Loading" color="secondary" @click="showLoading" />
            <bv-ion-button label="📑 Action Sheet" color="danger" @click="showActionSheet" />
          </div>

          <div b-if="lastAction" style="margin-top: 14px; padding: 10px; background: #f3f4f6; border-radius: 8px; font-size: 0.88rem; color: #1f2937;">
            <strong>Última Ação:</strong> {{ lastAction }}
          </div>
        </bv-ion-card>

        <!-- MOBILE LIST & INSET ITEMS -->
        <bv-ion-card title="Listas e Itens Agrupados" subtitle="Inset List (<bv-ion-list :inset='true'>)">
          <bv-ion-list :inset="true">
            <bv-ion-item title="mORMot 2 Native Server" subtitle="Conexão HTTP/WebSocket ativa na porta 8090" :detail="true">
              <bv-ion-badge value="Online" color="success" slot="end" />
            </bv-ion-item>

            <bv-ion-item title="Armazenamento Local" subtitle="Cache de dados e ORM sincronizados" :detail="true">
              <bv-ion-badge value="SQLite" color="primary" slot="end" />
            </bv-ion-item>

            <bv-ion-item title="Plataforma de Execução" subtitle="Multiplataforma Web, Desktop e Android" :detail="true">
              <bv-ion-badge value="Universal" color="dark" slot="end" />
            </bv-ion-item>
          </bv-ion-list>
        </bv-ion-card>
      </bv-ion-content>
    </bv-ion-app>
  </div>
</template>

<script>
  {
    MobileView.bv - Mobile & Universal UI Showcase
    ---------------------------------------------
    Demonstrates blaise-ui-mobile components and BlaiseIonic Pascal controllers.
  }

  data:
    currentMode: string = 'md';
    lastAction: string = '';

  created:
    begin
      asm
        if (window.$ionic) {
          this.currentMode = window.$ionic.getMode();
        }
      end;
    end;

  methods:
    procedure setIosMode;
    begin
      asm
        this.currentMode = 'ios';
        if (window.$ionic) window.$ionic.setMode('ios');
        this.lastAction = 'Modo visual alterado para iOS (Cupertino)';
      end;
    end;

    procedure setMdMode;
    begin
      asm
        this.currentMode = 'md';
        if (window.$ionic) window.$ionic.setMode('md');
        this.lastAction = 'Modo visual alterado para Android (Material Design)';
      end;
    end;

    procedure showToast;
    begin
      asm
        pas.BlaiseIonic.TIonicToast.Show('Notificação rápida com estilo nativo!', 2500, 'bottom', 'success');
        this.lastAction = 'TIonicToast.Show disparado!';
      end;
    end;

    procedure showAlert;
    begin
      asm
        pas.BlaiseIonic.TIonicAlert.Alert('BlaiseVue Mobile', 'Estes componentes funcionam igualmente na Web, no Desktop e no Celular!', 'Entendido');
        this.lastAction = 'TIonicAlert.Alert exibido!';
      end;
    end;

    procedure showConfirm;
    begin
      asm
        let self = this;
        self.lastAction = 'TIonicAlert.Confirm aberto...';
        pas.BlaiseIonic.TIonicAlert.Confirm('Confirmar Operação', 'Deseja sincronizar os dados locais com o mORMot 2?',
          function() {
            self.lastAction = 'Confirmação aceita! Sincronizando...';
            pas.BlaiseIonic.TIonicToast.Show('Dados sincronizados com sucesso!', 2000, 'bottom', 'primary');
          },
          function() {
            self.lastAction = 'Operação cancelada pelo usuário.';
          }
        );
      end;
    end;

    procedure showLoading;
    begin
      asm
        pas.BlaiseIonic.TIonicLoading.Present('Carregando registros...', 1800);
        this.lastAction = 'TIonicLoading.Present exibido (auto-dispensa em 1.8s)';
      end;
    end;

    procedure showActionSheet;
    begin
      asm
        let self = this;
        self.lastAction = 'TIonicActionSheet.Show aberto...';
        pas.BlaiseIonic.TIonicActionSheet.Show('Ações do Registro', ['Compartilhar', 'Editar', 'Duplicar', 'Excluir'],
          function(opt, idx) {
            self.lastAction = 'Opção selecionada no Action Sheet: ' + opt;
            pas.BlaiseIonic.TIonicToast.Show('Selecionado: ' + opt, 1800, 'bottom', 'dark');
          }
        );
      end;
    end;
</script>

<style>
  .mobile-view-container {
    max-width: 720px;
    margin: 0 auto;
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    min-height: calc(100vh - 120px);
  }
</style>
