<template>
  <div class="mobile-view-container">
    <bv-ion-app :mode="currentMode">
      <bv-ion-header>
        <bv-ion-toolbar>
          <bv-ion-title title="📱 BlaiseVue Mobile & Desktop Ecosystem"></bv-ion-title>
          <div slot="end">
            <bv-ion-badge :value="currentMode.toUpperCase()" :color="currentMode === 'ios' ? 'primary' : 'success'"></bv-ion-badge>
          </div>
        </bv-ion-toolbar>
      </bv-ion-header>

      <bv-ion-content :padding="true">
        <!-- INTRO CARD -->
        <bv-ion-card title="Universal Components (Mobile, Web & Desktop)" subtitle="Ionic Aesthetics + Object Pascal">
          <p style="margin-bottom: 14px; color: #4b5563; line-height: 1.5;">
            The <strong>blaise-ui-mobile</strong> components are 100% universal! Run on **Web Browser** (PWA), native **Desktop** (via WebUI4Delphi), and on **Mobile devices** (via Capacitor/Android).
          </p>

          <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            <bv-ion-button label="🍎 iOS Style (Cupertino)" color="primary" fill="outline" @click="setIosMode"></bv-ion-button>
            <bv-ion-button label="🤖 Android Style (Material Design)" color="success" fill="outline" @click="setMdMode"></bv-ion-button>
          </div>
        </bv-ion-card>

        <!-- PASCAL CONTROLLERS CARD -->
        <bv-ion-card title="Typed Pascal Controllers (BlaiseIonic.pas)" subtitle="Native Feedback & Dialogs">
          <p style="margin-bottom: 12px; color: #4b5563;">
            Trigger native dialogues and notifications directly from Object Pascal without manual DOM manipulation:
          </p>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 8px;">
            <bv-ion-button label="🔔 Toast" color="dark" @click="showToast"></bv-ion-button>
            <bv-ion-button label="💬 Alert" color="primary" @click="showAlert"></bv-ion-button>
            <bv-ion-button label="❓ Confirm" color="warning" @click="showConfirm"></bv-ion-button>
            <bv-ion-button label="⏳ Loading" color="secondary" @click="showLoading"></bv-ion-button>
            <bv-ion-button label="📑 Action Sheet" color="danger" @click="showActionSheet"></bv-ion-button>
          </div>

          <div b-if="lastAction" style="margin-top: 14px; padding: 10px 14px; background: #f3f4f6; border-radius: 8px; font-size: 0.88rem; color: #1f2937;">
            <strong>Last Action:</strong> {{ lastAction }}
          </div>
        </bv-ion-card>

        <!-- EXPANDABLE ACCORDION LIST -->
        <bv-ion-card title="Expandable Accordion Lists" subtitle="Click item or chevron (›) to expand details">
          <bv-ion-list :inset="true">
            <!-- ITEM 1 -->
            <bv-ion-item title="mORMot 2 Native Server" subtitle="Active HTTP/WebSocket connection on port 8090" :expandable="true" :expanded="true">
              <bv-ion-badge value="Online" color="success" slot="end"></bv-ion-badge>
              <div slot="expanded" style="display: flex; flex-direction: column; gap: 6px;">
                <div>⚡ <strong>Server Port:</strong> <code>8090</code> (HTTP 1.1 + WebSockets RFC 6455)</div>
                <div>🚀 <strong>Average Latency:</strong> &lt; 2ms concurrent processing</div>
                <div>💾 <strong>RAM Usage:</strong> ~22 MB RAM (Free Pascal 64-bit)</div>
                <div>🔒 <strong>Security:</strong> RFC 7519 JWT Auth with Argon2/SHA-256</div>
              </div>
            </bv-ion-item>

            <!-- ITEM 2 -->
            <bv-ion-item title="Local Storage & Cache" subtitle="Synchronized SQLite / IndexedDB database" :expandable="true">
              <bv-ion-badge value="SQLite" color="primary" slot="end"></bv-ion-badge>
              <div slot="expanded" style="display: flex; flex-direction: column; gap: 6px;">
                <div>📦 <strong>ORM Engine:</strong> Synopse mORMot 2 with SQLite3 embedded</div>
                <div>🔄 <strong>Real-Time Sync:</strong> Automated WebSocket notifications</div>
                <div>📱 <strong>Offline Mode:</strong> Full functionality without active internet</div>
                <div>📊 <strong>Mapped Tables:</strong> Customers, Products, AuthUsers</div>
              </div>
            </bv-ion-item>

            <!-- ITEM 3 -->
            <bv-ion-item title="Universal Execution Platform" subtitle="Pascal codebase shared across Web, Desktop and Android" :expandable="true">
              <bv-ion-badge value="Universal" color="dark" slot="end"></bv-ion-badge>
              <div slot="expanded" style="display: flex; flex-direction: column; gap: 6px;">
                <div>🌐 <strong>Web (PWA):</strong> Compatible with all modern browsers</div>
                <div>🖥️ <strong>Desktop:</strong> Ultralightweight native binary via WebUI4Delphi (&lt; 10 MB)</div>
                <div>📱 <strong>Mobile:</strong> Native Android APK packaged via Capacitor</div>
                <div>🎨 <strong>Adaptive UI:</strong> Auto-toggles Cupertino and Material Design</div>
              </div>
            </bv-ion-item>
          </bv-ion-list>
        </bv-ion-card>
      </bv-ion-content>
    </bv-ion-app>
  </div>
</template>

<script>
  {
    MobileView.bv - Mobile & Universal UI Showcase
    ---------------------------------------------
    Demonstrates blaise-ui-mobile components and BlaiseIonic Pascal controllers.
  }

  data:
    currentMode: string = 'md';
    lastAction: string = '';

  created:
    begin
      this.currentMode := IonicGetMode;
    end;

  methods:
    procedure setIosMode;
    begin
      this.currentMode := 'ios';
      IonicSetMode('ios');
      this.lastAction := 'Visual mode switched to 🍎 iOS (Cupertino)';
    end;

    procedure setMdMode;
    begin
      this.currentMode := 'md';
      IonicSetMode('md');
      this.lastAction := 'Visual mode switched to 🤖 Android (Material Design)';
    end;

    procedure showToast;
    begin
      IonicToast('Fast notification with native look and feel!', 2500, 'bottom', 'success');
      this.lastAction := '🔔 TIonicToast.Show triggered successfully!';
    end;

    procedure showAlert;
    begin
      IonicAlert('BlaiseVue Mobile', 'These components run identically on Web, Desktop, and Mobile!', 'Understood');
      this.lastAction := '💬 TIonicAlert.Alert displayed!';
    end;

    procedure onConfirmOk;
    begin
      this.lastAction := '✅ Confirmation accepted! Data synchronized!';
      IonicToast('Data synced successfully!', 2000, 'bottom', 'primary');
    end;

    procedure onConfirmCancel;
    begin
      this.lastAction := '❌ Operation cancelled by user.';
    end;

    procedure showConfirm;
    begin
      this.lastAction := '❓ TIonicAlert.Confirm opened...';
      IonicConfirm(this, 'Confirm Operation', 'Do you want to sync local data with mORMot 2?', 'onConfirmOk', 'onConfirmCancel');
    end;

    procedure showLoading;
    begin
      IonicLoading('Loading records...', 1800);
      this.lastAction := '⏳ TIonicLoading.Present displayed (auto-dismiss in 1.8s)';
    end;

    procedure onSheetSelect(opt, idx: JSValue);
    begin
      this.lastAction := '👉 Option selected in Action Sheet: ' + String(opt);
      IonicToast('Selected: ' + String(opt), 1800, 'bottom', 'dark');
    end;

    procedure showActionSheet;
    begin
      this.lastAction := '📑 TIonicActionSheet.Show opened...';
      IonicActionSheet(this, 'Record Actions', ['Share', 'Edit', 'Duplicate', 'Delete'], 'onSheetSelect');
    end;
</script>

<style>
  .mobile-view-container {
    max-width: 760px;
    margin: 0 auto;
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    min-height: calc(100vh - 120px);
    margin-bottom: 80px;
  }
</style>
