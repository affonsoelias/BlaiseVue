<template>
  <div class="login-page">
    <div class="login-card">
      <!-- HEADER -->
      <div class="login-header">
        <div class="login-icon">🔐</div>
        <h2 class="login-title">Autenticação BlaiseVue</h2>
        <p class="login-subtitle">Acesso seguro com tokens JWT nativos emitidos pelo mORMot 2</p>
      </div>

      <!-- ALREADY LOGGED IN BANNER -->
      <div class="logged-in-box" v-if="$auth && $auth.isAuthenticated">
        <div class="user-info-row">
          <span class="user-avatar">👤</span>
          <div>
            <strong>{{ $auth.user.name }}</strong>
            <div class="user-email">{{ $auth.user.email }}</div>
          </div>
          <span class="role-badge" :class="'role-' + $auth.user.role">{{ $auth.user.role }}</span>
        </div>
        <div class="logged-actions">
          <a href="#/" class="bui-btn bui-btn-primary">Ir para o Início 🏠</a>
          <button class="bui-btn bui-btn-danger" @click="handleLogout">Encerrar Sessão 🚪</button>
        </div>
      </div>

      <!-- LOGIN FORM -->
      <div class="login-form" v-if="!$auth || !$auth.isAuthenticated">
        <div class="form-group">
          <label class="form-label">E-mail de Acesso:</label>
          <input
            type="email"
            class="form-control"
            placeholder="ex: admin@blaisevue.dev"
            b-model="email"
          />
        </div>

        <div class="form-group">
          <label class="form-label">Senha:</label>
          <input
            type="password"
            class="form-control"
            placeholder="••••••••"
            b-model="password"
          />
        </div>

        <!-- ERROR MESSAGE -->
        <div class="auth-error-banner" v-if="errorMessage">
          ⚠️ {{ errorMessage }}
        </div>

        <!-- SUCCESS MESSAGE -->
        <div class="auth-success-banner" v-if="successMessage">
          ✅ {{ successMessage }}
        </div>

        <!-- SUBMIT BUTTON -->
        <button
          class="bui-btn bui-btn-primary btn-block"
          :disabled="loading"
          @click="submitLogin"
        >
          <span v-if="!loading">Entrar no Sistema 🚀</span>
          <span v-if="loading">Autenticando no mORMot 2... ⏳</span>
        </button>

        <!-- QUICK DEMO LOGINS -->
        <div class="demo-logins-section">
          <div class="demo-divider"><span>Acesso Rápido de Demonstração</span></div>
          <div class="demo-buttons">
            <button class="demo-btn demo-admin" @click="quickLogin('admin@blaisevue.dev', 'admin123')">
              ⚡ Admin
            </button>
            <button class="demo-btn demo-manager" @click="quickLogin('manager@blaisevue.dev', 'manager123')">
              👥 Gerente
            </button>
            <button class="demo-btn demo-user" @click="quickLogin('user@blaisevue.dev', 'user123')">
              👤 Usuário
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
  {
    LoginView.bv - Enterprise JWT Login View
    -----------------------------------------
    Auto-generated by BlaiseVue CLI (bv mormot auth)
    Integrates with mORMot 2 native backend /api/auth/login and $auth helper.
  }

  data:
    email: string = '';
    password: string = '';
    errorMessage: string = '';
    successMessage: string = '';
    loading: boolean = false;

  methods:
    procedure quickLogin(e, p: string);
    begin
      this.email := e;
      this.password := p;
      this.errorMessage := '';
      this.submitLogin();
    end;

    procedure submitLogin;
    begin
      if (this.email = '') or (this.password = '') then
      begin
        this.errorMessage := 'Por favor, informe o e-mail e a senha.';
        Exit;
      end;
      AuthLogin(this, this.email, this.password, '#/');
    end;

    procedure handleLogout;
    begin
      AuthLogout(this);
    end;
</script>

<style>
  .login-page { min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 24px 16px; }
  .login-card { background: #ffffff; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.08); width: 100%; max-width: 440px; padding: 32px 28px; border: 1px solid #e2e8f0; }
  .login-header { text-align: center; margin-bottom: 24px; }
  .login-icon { font-size: 40px; margin-bottom: 8px; }
  .login-title { font-size: 22px; font-weight: 700; color: #1e293b; margin: 0 0 6px 0; }
  .login-subtitle { font-size: 13px; color: #64748b; margin: 0; }
  .form-group { margin-bottom: 16px; }
  .form-label { display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 6px; }
  .form-control { width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; box-sizing: border-box; outline: none; transition: all 0.2s; }
  .form-control:focus { border-color: #42b883; box-shadow: 0 0 0 3px rgba(66, 184, 131, 0.15); }
  .auth-error-banner { background: #fee2e2; color: #dc2626; padding: 10px 14px; border-radius: 6px; font-size: 13px; margin-bottom: 16px; border: 1px solid #fecaca; }
  .auth-success-banner { background: #dcfce7; color: #15803d; padding: 10px 14px; border-radius: 6px; font-size: 13px; margin-bottom: 16px; border: 1px solid #bbf7d0; }
  .bui-btn { padding: 10px 18px; border-radius: 6px; font-size: 14px; font-weight: 600; border: none; cursor: pointer; transition: all 0.2s; text-decoration: none; display: inline-block; text-align: center; }
  .btn-block { width: 100%; display: block; }
  .bui-btn-primary { background: #42b883; color: white; }
  .bui-btn-primary:hover { background: #33a06f; }
  .bui-btn-danger { background: #ef4444; color: white; }
  .bui-btn-danger:hover { background: #dc2626; }
  .demo-logins-section { margin-top: 24px; }
  .demo-divider { display: flex; align-items: center; text-align: center; color: #94a3b8; font-size: 12px; margin-bottom: 14px; }
  .demo-divider::before, .demo-divider::after { content: ''; flex: 1; border-bottom: 1px solid #e2e8f0; }
  .demo-divider span { padding: 0 10px; }
  .demo-buttons { display: flex; gap: 8px; }
  .demo-btn { flex: 1; padding: 8px 4px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; border: 1px solid #cbd5e1; background: #f8fafc; color: #334155; transition: all 0.2s; }
  .demo-btn:hover { background: #e2e8f0; }
  .demo-admin:hover { border-color: #8b5cf6; color: #7c3aed; }
  .demo-manager:hover { border-color: #3b82f6; color: #2563eb; }
  .demo-user:hover { border-color: #10b981; color: #059669; }
  .logged-in-box { padding: 18px; background: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0; }
  .user-info-row { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .user-avatar { font-size: 32px; }
  .user-email { font-size: 12px; color: #64748b; }
  .role-badge { padding: 3px 8px; border-radius: 12px; font-size: 11px; font-weight: 700; text-transform: uppercase; margin-left: auto; }
  .role-admin { background: #ede9fe; color: #7c3aed; }
  .role-manager { background: #dbeafe; color: #2563eb; }
  .role-user { background: #e2e8f0; color: #475569; }
  .logged-actions { display: flex; gap: 8px; }
  .logged-actions .bui-btn { flex: 1; }
</style>

