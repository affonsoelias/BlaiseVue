<template>
  <div class="product-view-page">
    <!-- HEADER SECTION -->
    <div class="crud-header">
      <div>
        <h1 class="crud-title">📦 Product Management</h1>
        <p class="crud-subtitle">High-throughput reactive CRUD module connected to mORMot 2 native backend.</p>
      </div>
      <div class="crud-header-btns">
        <button class="bui-btn bui-btn-primary" @click="openCreateModal">➕ New Product</button>
        <button class="bui-btn bui-btn-secondary" @click="fetchItems">🔄 Refresh</button>
      </div>
    </div>

    <!-- REAL-TIME SYNC & STATS BAR -->
    <div class="crud-stats-bar">
      <span class="sync-badge">🟢 Real-time WebSocket Sync Active</span>
      <span class="count-badge">Total: <strong>{{ items.length }}</strong> products</span>
    </div>

    <!-- SEARCH & FILTER TOOLBAR -->
    <div class="crud-toolbar">
      <input
        type="text"
        class="crud-search-input"
        placeholder="🔍 Search products by any keyword..."
        b-model="searchQuery"
      />
    </div>

    <!-- RESPONSIVE DATA TABLE -->
    <div class="crud-table-wrap">
      <table class="crud-table">
        <thead>
          <tr>
            <th style="width: 70px;">ID</th>
            <th>Name</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Category</th>
            <th>Created</th>
            <th style="width: 170px; text-align: center;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <tr b-for="item in filteredItems">
            <td class="cell-id">#{{ item.id }}</td>
            <td><strong>{{ item.name }}</strong></td>
            <td><span class="badge-price">$ {{ Number(item.price).toFixed(2) }}</span></td>
            <td><span class="badge-num">{{ item.stock }}</span></td>
            <td><strong>{{ item.category }}</strong></td>
            <td class="cell-date">{{ item.createdAt }}</td>
            <td class="cell-actions">
              <button class="action-btn edit-btn" title="Edit" @click="openEditModal(item)">✏️ Edit</button>
              <button class="action-btn del-btn" title="Delete" @click="deleteItem(item.id)">🗑️ Delete</button>
            </td>
          </tr>
        </tbody>
      </table>

      <!-- EMPTY STATE -->
      <div class="crud-empty" v-if="filteredItems.length === 0">
        <div class="empty-icon">📂</div>
        <h3>No products found</h3>
        <p v-if="searchQuery">No matching records for "<strong>{{ searchQuery }}</strong>".</p>
        <p v-if="!searchQuery">Click "➕ New Product" above to add your first record!</p>
      </div>
    </div>

    <!-- MODAL DIALOG -->
    <div class="crud-modal-backdrop" v-if="isModalOpen">
      <div class="crud-modal">
        <div class="modal-header">
          <h3>{{ isEditing ? '✏️ Edit ' + modelTitle : '➕ New ' + modelTitle }}</h3>
          <button class="modal-close-btn" @click="closeModal">✕</button>
        </div>
        <div class="modal-body">
          <div class="form-group">
            <label class="form-label">Name:</label>
            <input type="text" class="form-control" b-model="form.name" placeholder="Enter name..." />
          </div>
          <div class="form-group">
            <label class="form-label">Price:</label>
            <input type="number" step="0.01" class="form-control" b-model="form.price" placeholder="0.00" />
          </div>
          <div class="form-group">
            <label class="form-label">Stock:</label>
            <input type="number" class="form-control" b-model="form.stock" placeholder="0" />
          </div>
          <div class="form-group">
            <label class="form-label">Category:</label>
            <input type="text" class="form-control" b-model="form.category" placeholder="Enter category..." />
          </div>
          <div class="form-error-banner" v-if="formError">
            ⚠️ {{ formError }}
          </div>
        </div>
        <div class="modal-footer">
          <button class="bui-btn bui-btn-secondary" @click="closeModal">Cancel</button>
          <button class="bui-btn bui-btn-primary" @click="saveItem">
            {{ isEditing ? 'Save Changes' : 'Create ' + modelTitle }}
          </button>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
  {
    ProductView.bv - High-Performance Reactive CRUD View
    ---------------------------------------------------------
    Auto-generated by BlaiseVue CLI (bv mormot crud Product)
    Features: Real-time WebSockets ($ws), Full REST ($api), Instant Search & Validation
  }

  data:
    modelTitle: string = 'Product';
    apiEndpoint: string = 'products';
    items: JSValue = [];
    searchQuery: string = '';
    isModalOpen: boolean = false;
    isEditing: boolean = false;
    currentEditId: integer = 0;
    formError: string = '';
    form: JSValue = nil;

  computed:
    function filteredItems: JSValue;
    begin
      Result := FilterByQuery(this.items, this.searchQuery);
    end;

  methods:
    procedure resetForm;
    var
      F: JSValue;
    begin
      F := NewObject;
      SetField(F, 'name', '');
      SetField(F, 'price', 0.0);
      SetField(F, 'stock', 0);
      SetField(F, 'category', '');
      this.form := F;
      this.formError := '';
    end;

    procedure openCreateModal;
    begin
      this.resetForm();
      this.isEditing := false;
      this.currentEditId := 0;
      this.isModalOpen := true;
    end;

    procedure openEditModal(item: JSValue);
    begin
      this.form := ObjectAssign(NewObject, item);
      this.currentEditId := GetFieldInt(item, 'id', 0);
      this.isEditing := true;
      this.formError := '';
      this.isModalOpen := true;
    end;

    procedure closeModal;
    begin
      this.isModalOpen := false;
      this.formError := '';
    end;

    procedure fetchItems;
    begin
      ApiFetch(this, '/api/' + String(this.apiEndpoint), 'items');
    end;

    procedure saveItem;
    begin
      if not Boolean(this.form) then Exit;
      ApiSave(this, '/api/' + String(this.apiEndpoint), Integer(this.currentEditId), Boolean(this.isEditing), this.form, 'fetchItems');
    end;

    procedure deleteItem(id: integer);
    begin
      ApiDelete(this, '/api/' + String(this.apiEndpoint), id, 'Are you sure you want to delete this ' + String(this.modelTitle) + '?', 'fetchItems');
    end;

    procedure setupWebSocket;
    begin
      ApiSetupRealtime(this, LowerCase(String(this.modelTitle)), 'fetchItems');
    end;

  mounted:
    begin
      this.resetForm();
      this.fetchItems();
      this.setupWebSocket();
    end;
</script>

<style>
  .product-view-page { padding: 24px; max-width: 1200px; margin: 0 auto; }
  .crud-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px; }
  .crud-title { font-size: 24px; font-weight: 700; color: #2c3e50; }
  .crud-subtitle { color: #7f8c8d; font-size: 14px; margin-top: 4px; }
  .crud-header-btns { display: flex; gap: 8px; }
  .crud-stats-bar { display: flex; gap: 12px; margin-bottom: 16px; align-items: center; }
  .sync-badge { background: #e8f8f5; color: #1abc9c; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; border: 1px solid #a3e4d7; }
  .count-badge { background: #edf2f7; color: #4a5568; padding: 4px 10px; border-radius: 20px; font-size: 12px; }
  .crud-toolbar { margin-bottom: 16px; }
  .crud-search-input { width: 100%; max-width: 400px; padding: 10px 14px; border: 1px solid #cbd5e0; border-radius: 6px; font-size: 14px; outline: none; }
  .crud-search-input:focus { border-color: #42b883; box-shadow: 0 0 0 3px rgba(66, 184, 131, 0.15); }
  .crud-table-wrap { background: #fff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); overflow-x: auto; }
  .crud-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; }
  .crud-table th { background: #f8fafc; padding: 12px 16px; font-weight: 600; color: #475569; border-bottom: 2px solid #e2e8f0; }
  .crud-table td { padding: 12px 16px; border-bottom: 1px solid #f1f5f9; color: #334155; }
  .crud-table tr:hover { background: #f8fafc; }
  .cell-id { font-weight: 600; color: #64748b; font-family: monospace; }
  .cell-date { font-size: 12px; color: #94a3b8; }
  .badge-num { background: #e0f2fe; color: #0284c7; padding: 2px 8px; border-radius: 12px; font-weight: 600; font-size: 12px; }
  .badge-price { font-weight: 700; color: #16a34a; }
  .status-pill { padding: 3px 8px; border-radius: 12px; font-size: 11px; font-weight: 600; }
  .pill-active { background: #dcfce7; color: #15803d; }
  .pill-inactive { background: #fee2e2; color: #b91c1c; }
  .cell-actions { display: flex; gap: 6px; justify-content: center; }
  .action-btn { padding: 5px 10px; border-radius: 4px; font-size: 12px; border: 1px solid transparent; cursor: pointer; transition: all 0.2s; font-weight: 500; }
  .edit-btn { background: #f1f5f9; color: #334155; border-color: #cbd5e1; }
  .edit-btn:hover { background: #e2e8f0; }
  .del-btn { background: #fef2f2; color: #dc2626; border-color: #fecaca; }
  .del-btn:hover { background: #fee2e2; }
  .crud-empty { padding: 48px 16px; text-align: center; color: #64748b; }
  .empty-icon { font-size: 42px; margin-bottom: 8px; }
  .crud-modal-backdrop { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1050; }
  .crud-modal { background: #fff; border-radius: 8px; width: 90%; max-width: 520px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); overflow: hidden; animation: modalIn 0.2s ease-out; }
  @keyframes modalIn { from { transform: scale(0.95); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  .modal-header { padding: 16px 20px; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; }
  .modal-close-btn { background: none; border: none; font-size: 18px; cursor: pointer; color: #94a3b8; }
  .modal-close-btn:hover { color: #1e293b; }
  .modal-body { padding: 20px; max-height: 70vh; overflow-y: auto; }
  .modal-footer { padding: 14px 20px; background: #f8fafc; border-top: 1px solid #e2e8f0; display: flex; justify-content: flex-end; gap: 8px; }
  .form-group { margin-bottom: 14px; }
  .form-label { display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 4px; }
  .form-control { width: 100%; padding: 8px 12px; border: 1px solid #cbd5e0; border-radius: 6px; font-size: 14px; outline: none; }
  .form-control:focus { border-color: #42b883; box-shadow: 0 0 0 3px rgba(66, 184, 131, 0.15); }
  .checkbox-container { display: flex; align-items: center; gap: 8px; font-size: 14px; cursor: pointer; margin-top: 6px; }
  .form-error-banner { margin-top: 10px; background: #fee2e2; color: #dc2626; padding: 8px 12px; border-radius: 6px; font-size: 13px; }
  .bui-btn { padding: 8px 16px; border-radius: 6px; font-size: 14px; font-weight: 600; border: none; cursor: pointer; transition: all 0.2s; }
  .bui-btn-primary { background: #42b883; color: white; }
  .bui-btn-primary:hover { background: #33a06f; }
  .bui-btn-secondary { background: #e2e8f0; color: #334155; }
  .bui-btn-secondary:hover { background: #cbd5e1; }
</style>
