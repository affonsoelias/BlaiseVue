<template>
  <div translate="no" class="notranslate app-shell" :class="{ 'sidebar-collapsed': isSidebarCollapsed }">
    <!-- RESPONSIVE SIDEBAR NAVIGATION (DRAWER ON MOBILE, PINNED ON DESKTOP) -->
    <app-sidebar :is-open="isMobileMenuOpen" :is-collapsed="isSidebarCollapsed" @close="closeMobileMenu"></app-sidebar>

    <!-- MAIN APPLICATION WRAPPER -->
    <div class="app-main-layout">
      <!-- HEADER WITH BREADCRUMBS, THEME SWITCHER & LOCALE CONTROLS -->
      <app-header @toggle-sidebar="toggleSidebar"></app-header>

      <!-- RESPONSIVE VIEW OUTLET -->
      <main class="app-content-body">
        <bv-container class="main-content-container">
          <router-view></router-view>
        </bv-container>
      </main>

      <!-- STATUS BAR FOOTER -->
      <app-footer></app-footer>
    </div>

    <!-- MOBILE BOTTOM NAVIGATION BAR (QUICK THUMB ACCESSIBILITY) -->
    <bv-bottom-nav class="mobile-bottom-bar">
      <bv-bottom-nav-item href="#/" icon="🏠" label="Home"></bv-bottom-nav-item>
      <bv-bottom-nav-item href="#/pro" icon="⚡" label="Pro"></bv-bottom-nav-item>
      <bv-bottom-nav-item href="#/dataset" icon="💾" label="Data"></bv-bottom-nav-item>
      <bv-bottom-nav-item href="#/bootstrap" icon="🎨" label="BlaiseUI"></bv-bottom-nav-item>
      <bv-bottom-nav-item href="#/mobile" icon="📱" label="Mobile"></bv-bottom-nav-item>
      <bv-bottom-nav-item href="docs/index.html" icon="📚" label="Docs"></bv-bottom-nav-item>
    </bv-bottom-nav>
  </div>
</template>

<script uses="uAppVersion">
    {
    App.bv - The Root Application Shell
    -------------------------------------------------------------------------
    Orchestrates the main responsive layout (Sidebar, Header, Viewport, Footer),
    initializes global store metadata, and configures SPA routing in Object Pascal.
    }

  data:
    isMobileMenuOpen: boolean = false;
    isSidebarCollapsed: boolean = true;

    { Dependency Injection: Provides runtime environment context to all child components }
  provide:
    begin
      Result := TJSObject.new;
      Result['getAmbiente'] := function(): TJSObject
    begin
      Result := TJSObject.new;
      Result['id'] := 42;
      Result['status'] := 'Production 🛡️';
    end;
    end;

    { Lifecycle: Initialize global state in the centralized store }
  created:
    begin
      if APP_VERSION = '' then;
      TJSObject(this['$store'])['user'] := 'Pascal Master 🚀';

      I18nAddMessages('en', '{"nav":{"home":"Home","about":"About","pro":"Pro & Wasm ⚡","form":"Form 📋","blaiseui":"BlaiseUI Kit 🎨","charts":"Charts 📊","showcase":"Showcase ✨"},"status":{"globalStore":"Global Store","localeActive":"Active Locale","theme":"Theme"},"form":{"title":"Reactive Form Validation","subtitle":"Demonstrating b-validate, $errors, and $v in BlaiseVue","name":"Full Name","email":"Corporate Email","city":"City","submit":"Validate & Submit 🚀","reset":"Reset Form 🔄","fillValid":"Fill Valid Sample ✨","statusValid":"Valid ✅","statusInvalid":"Invalid ❌","formState":"Form Status"},"pro":{"title":"⚡ BlaiseVue Pro & WebAssembly Engine","transitionTitle":"🎬 FLIP List Transitions (<transition-group>)","shuffle":"Shuffle 🔀","add":"Add Item ➕","remove":"Remove First ➖","resetList":"Reset List 🔄"}}');
      I18nAddMessages('pt', '{"nav":{"home":"Início","about":"Sobre","pro":"Pro & Wasm ⚡","form":"Formulário 📋","blaiseui":"BlaiseUI Kit 🎨","charts":"Gráficos 📊","showcase":"Showcase ✨"},"status":{"globalStore":"Memória Global","localeActive":"Idioma Ativo","theme":"Tema"},"form":{"title":"Formulário de Validação Reativa","subtitle":"Demonstração de b-validate, $errors e $v no BlaiseVue","name":"Nome Completo","email":"E-mail Corporativo","city":"Cidade","submit":"Validar & Enviar 🚀","reset":"Limpar Formulário 🔄","fillValid":"Preencher Válido ✨","statusValid":"Válido ✅","statusInvalid":"Inválido ❌","formState":"Status do Formulário"},"pro":{"title":"⚡ BlaiseVue Pro & WebAssembly Engine","transitionTitle":"🎬 Lista com Animações FLIP (<transition-group>)","shuffle":"Embaralhar 🔀","add":"Adicionar Item ➕","remove":"Remover Primeiro ➖","resetList":"Resetar Lista 🔄"}}');

      { Default to English as the primary framework showcase language }
      I18nSetLocale('en');
    end;

  methods:
    procedure toggleSidebar;
    begin
      if window.innerWidth <= 992 then
      this.isMobileMenuOpen := not this.isMobileMenuOpen
      else
      this.isSidebarCollapsed := not this.isSidebarCollapsed;
    end;

    procedure closeMobileMenu;
    begin
      this.isMobileMenuOpen := false;
    end;

    { Router Configuration: Maps URI hashes to Component Tags }
    router:
  routes:
    '/': 'home-page';
    '/about': 'about-page';
    '/fragments': 'fragments-view-page';
    '/pro': 'pro-features-page';
    '/bootstrap': 'lib-bootstrap-page';
    '/charts': 'charts-page';
    '/reports': 'reports-view-page';
    '/showcase': 'showcase-page';
    '/dataset': 'dataset-view-page';
    '/customers': 'customer-view-page';
    '/products': 'product-view-page';
    '/login': 'login-view-page';
    '/mobile': 'mobile-view-page';
    '/form': 'formulario-page';
    '/i18n': 'i18n-lab-view-page';
    '/user/:id': 'user-profile-page';
</script>

<style>
  :root {
    --bv-bg: var(--bs-body-bg, #f8fafc);
    --bv-surface: var(--bs-tertiary-bg, #ffffff);
    --bv-surface-subtle: var(--bs-secondary-bg, #f8fafc);
    --bv-border: var(--bs-border-color, #e2e8f0);
    --bv-text: var(--bs-body-color, #1e293b);
    --bv-text-muted: var(--bs-secondary-color, #64748b);
    --bv-input-bg: #ffffff;
    --bv-hover-bg: #f1f5f9;
    --bv-code-bg: #f1f5f9;
    --bv-code-color: #0f172a;
    --bv-shadow: 0 1px 3px rgba(0, 0, 0, 0.06);
  }

  html[data-bs-theme="dark"],
  html.theme-dark,
  body.theme-dark {
    --bv-bg: var(--bs-body-bg, #0f172a);
    --bv-surface: var(--bs-tertiary-bg, #1e293b);
    --bv-surface-subtle: var(--bs-secondary-bg, #162032);
    --bv-border: var(--bs-border-color, rgba(255, 255, 255, 0.14));
    --bv-text: var(--bs-body-color, #f1f5f9);
    --bv-text-muted: var(--bs-secondary-color, #94a3b8);
    --bv-input-bg: var(--bs-body-bg, #0f172a);
    --bv-hover-bg: rgba(255, 255, 255, 0.06);
    --bv-code-bg: #0f172a;
    --bv-code-color: #38bdf8;
    --bv-shadow: 0 4px 12px rgba(0, 0, 0, 0.3);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: var(--bv-bg); color: var(--bv-text); min-height: 100vh; }

  .app-shell {
    display: flex;
    min-height: 100vh;
  }
  .app-main-layout {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin-left: 260px; /* Sidebar width on desktop */
    transition: margin-left 0.3s ease;
  }
  .app-shell.sidebar-collapsed .app-main-layout {
    margin-left: 0;
  }
  .app-content-body {
    flex: 1;
    padding: 24px 0;
  }
  .main-content-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .mobile-bottom-bar {
    display: none;
  }

  /* Responsive layout for tablets and mobile */
  @media (max-width: 992px) {
  html, body {
    overflow-x: clip;
  }
  .app-main-layout {
    margin-left: 0;
    overflow-x: clip;
  }
  .main-content-container {
    padding: 0 12px;
  }
  .mobile-bottom-bar {
    display: flex;
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    z-index: 1010;
  }
  .app-content-body {
    padding: 16px 0 80px 0; /* Room for bottom bar on mobile */
  }
  }
  @media (max-width: 768px) {
  .section { padding: 16px; }
  pre {
    max-width: 100%;
    white-space: pre-wrap;
    word-break: break-word;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  }

  /* Global typography & shared view utility classes */
  h1, h2, h3, h4 { color: var(--bv-text); font-weight: 700; margin-bottom: 12px; }
  p { line-height: 1.6; color: var(--bv-text-muted); }
  .section { background: var(--bv-surface); color: var(--bv-text); border-radius: 12px; padding: 24px; margin-bottom: 24px; box-shadow: var(--bv-shadow); border: 1px solid var(--bv-border); }
  .section-title { color: #42b883; border-bottom: 2px solid #42b883; padding-bottom: 8px; margin-bottom: 16px; }

  .btn-primary, .btn-danger, .btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    cursor: pointer;
    margin: 4px 4px 4px 0;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-primary {
    background: #42b883;
    color: #ffffff;
    border: 2px solid #42b883;
  }
  .btn-primary:hover {
    background: #33a06f;
    border-color: #33a06f;
  }
  .btn-danger {
    background: #e74c3c;
    color: #ffffff;
    border: 2px solid #e74c3c;
  }
  .btn-danger:hover {
    background: #c0392b;
    border-color: #c0392b;
  }
  .btn-outline {
    background: transparent;
    border: 2px solid #42b883;
    color: #42b883;
  }
  .btn-outline:hover {
    background: #42b883;
    color: #ffffff;
  }

  .badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 12px;
    color: #ffffff;
    font-weight: 600;
    font-size: 12px;
    line-height: 1.3;
  }
  .badge-green { background: #42b883; }
  .badge-blue { background: #3498db; }
  .badge-orange { background: #e67e22; }
  .badge-gray { background: #64748b; }

  .section input[type="text"],
  .section input[type="number"],
  .section select {
    width: 100%;
    padding: 10px 12px;
    border: 1.5px solid var(--bv-border);
    border-radius: 6px;
    font-size: 14px;
    margin: 6px 0;
    background: var(--bv-input-bg);
    color: var(--bv-text);
  }
  .section input[type="text"]:focus,
  .section input[type="number"]:focus,
  .section select:focus {
    border-color: #42b883;
    outline: none;
    box-shadow: 0 0 0 3px rgba(66, 184, 131, 0.15);
  }
  .section table { width: 100%; border-collapse: collapse; margin: 12px 0; }
  .section th, .section td { padding: 10px 14px; border: 1px solid var(--bv-border); text-align: left; color: var(--bv-text); }
  .section th { background: var(--bv-surface-subtle); font-weight: 600; color: var(--bv-text); }
  code { background: var(--bv-code-bg); color: var(--bv-code-color); padding: 2px 6px; border-radius: 4px; font-family: 'Consolas', monospace; font-size: 13px; }
  hr { border: none; border-top: 1px solid var(--bv-border); margin: 16px 0; }
</style>

