  }
  .header-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .header-control-group {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .ctrl-btn {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    color: #334155;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .ctrl-btn:hover {
    background: #e2e8f0;
  }
  .ctrl-btn.btn-active {
    background: #10b981;
    border-color: #10b981;
    color: #ffffff;
    font-weight: 600;
  }
  .theme-select {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    color: #334155;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 13px;
    outline: none;
    cursor: pointer;
  }
  .user-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    color: #0f172a;
    padding: 6px 14px;
    border-radius: 20px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .user-pill:hover {
    background: #e2e8f0;
    border-color: #94a3b8;
  }

  /* Dark mode overrides */
  html[data-bs-theme="dark"] .app-header, body.theme-dark .app-header {
    background: #1e293b;
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }
  html[data-bs-theme="dark"] .crumb-current, body.theme-dark .crumb-current {
    color: #f8fafc;
  }
  html[data-bs-theme="dark"] .menu-toggle-btn, body.theme-dark .menu-toggle-btn {
    background: #334155;
    border-color: #475569;
    color: #f8fafc;
  }
  html[data-bs-theme="dark"] .ctrl-btn, body.theme-dark .ctrl-btn {
    background: #334155;
    border-color: #475569;
    color: #f8fafc;
  }
  html[data-bs-theme="dark"] .theme-select, body.theme-dark .theme-select {
    background: #334155;
    border-color: #475569;
    color: #f8fafc;
  }
  html[data-bs-theme="dark"] .user-pill, body.theme-dark .user-pill {
    background: #334155;
    border-color: #475569;
