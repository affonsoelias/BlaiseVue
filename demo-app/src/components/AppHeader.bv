<template>
  <header class="app-header">
    <div class="header-left">
      <button class="menu-toggle-btn" @click="toggleSidebar" title="Toggle Navigation Menu">
        ☰
      </button>
      <div class="header-breadcrumb">
        <span class="crumb-app">BlaiseVue</span>
        <span class="crumb-separator">/</span>
        <strong class="crumb-current">Enterprise Showcase</strong>
      </div>
    </div>

    <div class="header-right">
      <!-- Language Switcher -->
      <div class="header-control-group lang-group">
        <button 
          class="ctrl-btn lang-btn" 
          :class="{ 'btn-active': $i18n.locale === 'en' }" 
          @click="$setLocale('en')" 
          title="Switch to English">
          🇺🇸 EN
        </button>
        <button 
          class="ctrl-btn lang-btn" 
          :class="{ 'btn-active': $i18n.locale === 'pt' }" 
          @click="$setLocale('pt')" 
          title="Mudar para Português">
          🇧🇷 PT
        </button>
      </div>

      <!-- Quick Dark/Light Toggle -->
      <button 
        class="ctrl-btn theme-toggle-btn" 
        @click="$theme.toggle()" 
        :title="$theme.isDark ? 'Switch to Light Theme' : 'Switch to Dark Theme'">
        <span v-if="$theme.isDark">☀️ Light</span>
        <span v-if="!$theme.isDark">🌙 Dark</span>
      </button>

      <!-- Bootswatch Theme Dropdown -->
      <div class="header-control-group theme-select-wrapper">
        <select class="theme-select" :value="$theme.current" @change="onThemeSelect($event)" title="Choose Bootswatch Theme">
          <option value="flatly">Flatly (Clean Light)</option>
          <option value="darkly">Darkly (Modern Dark)</option>
          <option value="cosmo">Cosmo</option>
          <option value="lux">Lux</option>
          <option value="zephyr">Zephyr</option>
          <option value="cyborg">Cyborg</option>
          <option value="solar">Solar</option>
          <option value="vapor">Vapor</option>
          <option value="pulse">Pulse</option>
        </select>
      </div>

      <!-- User Auth Pill -->
      <a href="#/login" class="user-pill" title="Authentication Status">
        <span class="user-icon">👤</span>
        <span class="user-name">{{ ($auth && $auth.isAuthenticated) ? $auth.user.name : 'Sign In' }}</span>
      </a>
    </div>
  </header>
</template>

<script>
  {
    AppHeader.bv
    -------------------------------------------------------------------------
    Top header bar with breadcrumb navigation, theme toggle (Dark/Light),
    Bootswatch theme selector, language switcher, and authentication indicator.
  }

  methods:
    procedure toggleSidebar;
    begin
      $emit('toggle-sidebar');
    end;

    procedure onThemeSelect(e: JSValue);
    var
      sel: string;
    begin
      sel := string(TJSObject(TJSObject(e)['target'])['value']);
      if sel <> '' then
        ThemeSet(sel);
    end;
</script>

<style scoped>
