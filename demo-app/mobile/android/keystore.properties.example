# BlaiseVue Production Android Keystore Configuration
# Copy this file to keystore.properties and fill in your production credentials.
# NEVER commit keystore.properties or your private .jks / .keystore to Git!
#
# storeFile=my-release-key.jks
# storePassword=YourStorePassword
# keyAlias=my-key-alias
# keyPassword=YourKeyPassword
