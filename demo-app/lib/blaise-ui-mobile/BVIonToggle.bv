<template>
  <label class="bui-ion-toggle" :class="wrapperClass">
    <span class="bui-ion-toggle-label" b-if="label">
      <slot>{{ label }}</slot>
    </span>
    <button
      type="button"
      role="switch"
      class="bui-ion-toggle-track"
      :aria-checked="currentChecked ? 'true' : 'false'"
      :disabled="isDisabled"
      @click="handleToggle">
      <span class="bui-ion-toggle-handle"></span>
    </button>
  </label>
</template>

<script>
  {
    BVIonToggle - Mobile Native Toggle Switch
    -----------------------------------------
    Props:
    - label: string
    - checked: boolean
    - value: boolean
    - modelValue: boolean
    - color: string ('primary' | 'success' | 'warning' | 'danger')
    - disabled: boolean
  }

  props:
    label: string = '';
    checked: boolean = false;
    value: boolean = false;
    modelValue: boolean = false;
    color: string = 'primary';
    disabled: boolean = false;

  data:
    internalChecked: boolean = false;
    hasInteracted: boolean = false;

  computed:
    function currentChecked: boolean;
    begin
      asm
        if (this.hasInteracted) {
          return Boolean(this.internalChecked === true);
        }
        return Boolean(this.checked === true || this.checked === 'true' ||
                       this.modelValue === true || this.modelValue === 'true' ||
                       this.value === true || this.value === 'true');
      end;
    end;

    function isDisabled: boolean;
    begin
      asm
        return Boolean(this.disabled === true || this.disabled === 'true');
      end;
    end;

    function wrapperClass: string;
    begin
      asm
        var c = this.color || 'primary';
        var chk = this.currentChecked ? ' is-checked' : '';
        var dis = this.isDisabled ? ' is-disabled' : '';
        return 'bui-ion-toggle bui-ion-toggle-' + c + chk + dis;
      end;
    end;

  methods:
    procedure handleToggle(ev: JSValue);
    begin
      asm
        if (this.isDisabled) return;
        var next = !this.currentChecked;
        this.hasInteracted = true;
        this.internalChecked = next;
        this.$emit('update:modelValue', next);
        this.$emit('change', next);
        this.$emit('ionChange', next);
      end;
    end;
</script>
