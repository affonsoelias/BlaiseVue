<template>
  <div class="bui-input-group">
    <label class="bui-input-label" b-if="label">{{ label }}</label>
    <input 
      :type="type" 
      class="bui-input-field" 
      :placeholder="placeholder"
      :value="value"
      @input="handleInput"
    />
  </div>
</template>

<script>
  data:
    label: string = '';
    placeholder: string = '';
    type: string = 'text';
    value: string = '';

  methods:
    procedure handleInput(ev: JSValue);
    begin
      asm
        let val = (ev && ev.target) ? ev.target.value : '';
        this.value = val;
        this.$emit('input', val);
      end;
    end;
</script>
