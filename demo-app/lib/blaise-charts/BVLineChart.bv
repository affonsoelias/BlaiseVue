<template>
  <bv-chart type="line" :data="data" :options="options" :width="width" :height="height" :themeAware="themeAware" @chart-click="handleClick"></bv-chart>
</template>

<script>
  {
    BVLineChart - Dedicated Line & Area Trend Chart Component
  }

  props:
    data: JSValue = null;
    options: JSValue = null;
    width: string = '100%';
    height: string = '380px';
    themeAware: boolean = true;

  methods:
    procedure handleClick(ev: JSValue);
    begin
      asm this.$emit('chart-click', ev); end;
    end;
</script>
