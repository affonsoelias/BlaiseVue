{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "BlaiseVue",
  "scopeName": "text.html.blaisevue",
  "fileTypes": ["bv"],
  "patterns": [
    {
      "include": "#template-tag"
    },
    {
      "include": "#script-tag"
    },
    {
      "include": "#style-tag"
    }
  ],
  "repository": {
    "template-tag": {
      "begin": "(<)(template)([^>]*)(>)",
      "end": "(</)(template)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "meta.tag.attributes.html" },
        "4": { "name": "punctuation.definition.tag.end.html" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        {
          "include": "#mustache-interpolation"
        },
        {
          "include": "#blaisevue-directives"
        },
        {
          "include": "#blaisevue-components"
        },
        {
          "include": "text.html.basic"
        }
      ]
    },
    "mustache-interpolation": {
      "name": "meta.interpolation.blaisevue",
      "begin": "(\\{\\{)",
      "end": "(\\}\\})",
      "beginCaptures": {
        "1": { "name": "punctuation.section.embedded.begin.blaisevue" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.section.embedded.end.blaisevue" }
      },
      "patterns": [
        {
          "name": "variable.language.blaisevue",
          "match": "\\$(store|router|route|i18n|t|theme|errors|v|wasm|emit|parent|refs)\\b"
        },
        {
          "name": "string.quoted.single.blaisevue",
          "begin": "'",
          "end": "'"
        },
        {
          "name": "string.quoted.double.blaisevue",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "constant.numeric.blaisevue",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        {
          "name": "constant.language.boolean.blaisevue",
          "match": "\\b(true|false)\\b"
        },
        {
          "include": "source.js"
        }
      ]
    },
    "blaisevue-directives": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.directive.blaisevue",
          "match": "\\b(b-model|b-validate|b-for|b-if|b-else-if|b-else|b-show|b-bind|b-on|b-html|b-text|v-model|v-if|v-else-if|v-else|v-for|v-show)\\b"
        },
        {
          "name": "entity.other.attribute-name.event.blaisevue",
          "match": "@([a-zA-Z0-9_.-]+)"
        },
        {
          "name": "entity.other.attribute-name.binding.blaisevue",
          "match": ":([a-zA-Z0-9_.-]+)"
        }
      ]
    },
    "blaisevue-components": {
      "patterns": [
        {
          "name": "entity.name.tag.custom.blaisevue",
          "match": "(?<=<\\/?)(bv-[a-zA-Z0-9-]+|router-view|router-link|teleport|suspense|transition|transition-group)(?=[\\s>\\/])"
        }
      ]
    },
    "script-tag": {
      "begin": "(<)(script)([^>]*)(>)",
      "end": "(</)(script)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "meta.tag.attributes.html" },
        "4": { "name": "punctuation.definition.tag.end.html" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        {
          "name": "meta.asm.js.blaisevue",
          "begin": "(?i:\\basm\\b)",
          "end": "(?i:\\bend\\b)",
          "beginCaptures": {
            "0": { "name": "keyword.control.pascal.blaisevue" }
          },
          "endCaptures": {
            "0": { "name": "keyword.control.pascal.blaisevue" }
          },
          "patterns": [
            { "include": "source.js" }
          ]
        },
        {
          "name": "keyword.section.pascal.blaisevue",
          "match": "\\b(props|data|methods|computed|watch|created|mounted|updated|provide|inject|components|router|validations)(?=\\s*:)"
        },
        {
          "name": "variable.language.blaisevue",
          "match": "\\$(store|router|route|i18n|t|theme|errors|v|wasm|emit|parent|refs)\\b"
        },
        {
          "name": "comment.line.double-slash.pascal",
          "match": "//.*$"
        },
        {
          "name": "comment.block.curly.pascal",
          "begin": "\\{",
          "end": "\\}"
        },
        {
          "name": "comment.block.parenthesis.pascal",
          "begin": "\\(\\*",
          "end": "\\*\\)"
        },
        {
          "name": "string.quoted.single.pascal",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.pascal",
              "match": "''"
            }
          ]
        },
        {
          "name": "keyword.control.pascal",
          "match": "(?i:\\b(if|then|else|while|do|for|to|downto|repeat|until|case|of|try|except|finally|raise|with|as|is|begin|end|procedure|function|constructor|destructor|override|inherited|var|type|const|record|array|class)\\b)"
        },
        {
          "name": "storage.type.pascal",
          "match": "(?i:\\b(string|integer|boolean|double|single|byte|word|char|cardinal|JSValue|TJSObject|TJSArray|JSValueArray|TObject)\\b)"
        },
        {
          "name": "constant.language.pascal",
          "match": "(?i:\\b(nil|true|false|Self|Result)\\b)"
        },
        {
          "name": "constant.numeric.pascal",
          "match": "\\b\\d+(\\.\\d+)?\\b|\\$[0-9a-fA-F]+"
        },
        {
          "include": "source.pascal"
        }
      ]
    },
    "style-tag": {
      "begin": "(<)(style)([^>]*)(>)",
      "end": "(</)(style)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "meta.tag.attributes.html" },
        "4": { "name": "punctuation.definition.tag.end.html" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        { "include": "source.css" }
      ]
    }
  }
}
