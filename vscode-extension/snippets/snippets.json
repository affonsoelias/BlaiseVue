{
  "BlaiseVue SFC Component": {
    "prefix": "bv-comp",
    "body": [
      "<template>",
      "  <div class=\"${1:my-component}\">",
      "    <h2>{{ title }}</h2>",
      "    <p>{{ message }}</p>",
      "    <bv-btn variant=\"primary\" @click=\"handleClick\">Click Me</bv-btn>",
      "  </div>",
      "</template>",
      "",
      "<script>",
      "  props:",
      "    title: string = '${2:Default Title}';",
      "",
      "  data:",
      "    message: string = 'Welcome to BlaiseVue!';",
      "",
      "  methods:",
      "    procedure handleClick(ev: JSValue);",
      "    begin",
      "      window.alert('Action triggered from ' + string(this['title']));",
      "    end;",
      "</script>",
      "",
      "<style>",
      "  .${1:my-component} {",
      "    padding: 1rem;",
      "  }",
      "</style>"
    ],
    "description": "Scaffold a new BlaiseVue Single File Component (.bv)"
  },
  "BlaiseVue SFC Full (All Sections)": {
    "prefix": "bv-comp-full",
    "body": [
      "<template>",
      "  <div class=\"${1:container}\">",
      "    <h3>{{ title }}</h3>",
      "    <p>Counter: {{ counter }} (Double: {{ doubleCounter }})</p>",
      "    <bv-btn variant=\"success\" @click=\"increment\">+1</bv-btn>",
      "  </div>",
      "</template>",
      "",
      "<script>",
      "  props:",
      "    title: string = '${2:Component Title}';",
      "",
      "  data:",
      "    counter: integer = 0;",
      "",
      "  computed:",
      "    function doubleCounter: integer;",
      "    begin",
      "      Result := integer(this['counter']) * 2;",
      "    end;",
      "",
      "  watch:",
      "    procedure onCounterChange(newVal, oldVal: JSValue);",
      "    begin",
      "      console.log('Counter changed to:', newVal);",
      "    end;",
      "",
      "  created:",
      "    begin",
      "      console.log('Component created: ' + string(this['title']));",
      "    end;",
      "",
      "  mounted:",
      "    begin",
      "      console.log('Component mounted to DOM');",
      "    end;",
      "",
      "  methods:",
      "    procedure increment(ev: JSValue);",
      "    begin",
      "      this['counter'] := integer(this['counter']) + 1;",
      "    end;",
      "</script>",
      "",
      "<style>",
      "  .${1:container} {",
      "    margin: 1rem 0;",
      "  }",
      "</style>"
    ],
    "description": "Scaffold a full BlaiseVue component with props, data, computed, watch, and lifecycle hooks"
  },
  "BlaiseVue Reactive Validated Form": {
    "prefix": "bv-form",
    "body": [
      "<form @submit.prevent=\"handleSubmit\" class=\"needs-validation\">",
      "  <div class=\"mb-3\">",
      "    <label class=\"form-label\">Name</label>",
      "    <input type=\"text\" class=\"form-control\" :class=\"{ 'is-invalid': $errors.name }\" b-model=\"form.name\" b-validate=\"required|min:3\">",
      "    <div class=\"invalid-feedback\" v-if=\"$errors.name\">{{ $errors.name }}</div>",
      "  </div>",
      "",
      "  <div class=\"mb-3\">",
      "    <label class=\"form-label\">Email</label>",
      "    <input type=\"email\" class=\"form-control\" :class=\"{ 'is-invalid': $errors.email }\" b-model=\"form.email\" b-validate=\"required|email\">",
      "    <div class=\"invalid-feedback\" v-if=\"$errors.email\">{{ $errors.email }}</div>",
      "  </div>",
      "",
      "  <bv-btn variant=\"primary\" type=\"submit\" :disabled=\"$v.$invalid\">Submit</bv-btn>",
      "</form>"
    ],
    "description": "Reactive form with b-validate, $errors, and $v integration"
  },
  "BlaiseUI Button (bv-btn)": {
    "prefix": "bv-btn",
    "body": [
      "<bv-btn variant=\"${1|primary,secondary,success,danger,warning,info,outline-primary,outline-success,outline-danger|}\" size=\"${2|md,sm,lg|}\" @click=\"${3:handleClick}\">",
      "  ${4:Button Label}",
      "</bv-btn>"
    ],
    "description": "Insert a BlaiseUI button"
  },
  "BlaiseUI Card (bv-card)": {
    "prefix": "bv-card",
    "body": [
      "<bv-card title=\"${1:Card Title}\" hasFooter=\"true\">",
      "  <p>${2:Card body content goes here...}</p>",
      "  <template #footer>",
      "    <bv-btn variant=\"primary\" size=\"sm\">${3:Action}</bv-btn>",
      "  </template>",
      "</bv-card>"
    ],
    "description": "Insert a BlaiseUI Card component"
  },
  "BlaiseUI Modal (bv-modal)": {
    "prefix": "bv-modal",
    "body": [
      "<bv-modal title=\"${1:Modal Title}\" :show=\"${2:isModalOpen}\" okLabel=\"Save\" cancelLabel=\"Cancel\" @ok=\"${3:handleSave}\" @close=\"${4:handleClose}\">",
      "  <p>${5:Modal dialog body content...}</p>",
      "</bv-modal>"
    ],
    "description": "Insert a BlaiseUI Teleported Modal dialog"
  },
  "BlaiseUI Input (bv-input)": {
    "prefix": "bv-input",
    "body": [
      "<bv-input label=\"${1:Field Label}\" placeholder=\"${2:Enter value...}\" type=\"${3|text,email,password,number|}\" b-model=\"${4:fieldName}\"></bv-input>"
    ],
    "description": "Insert a BlaiseUI input field"
  },
  "BlaiseUI Icon (bv-icon)": {
    "prefix": "bv-icon",
    "body": [
      "<bv-icon name=\"${1|check-circle,warning,gear-fill,heart-fill,star-fill,moon-fill,sun-fill,code-slash,cpu,bootstrap-fill,trash,pencil|}\" size=\"${2:18}\" color=\"${3:currentColor}\"></bv-icon>"
    ],
    "description": "Insert a BlaiseUI SVG/Bootstrap Icon"
  },
  "BlaiseUI Badge (bv-badge)": {
    "prefix": "bv-badge",
    "body": [
      "<bv-badge variant=\"${1|primary,secondary,success,danger,warning,info|}\" :pill=\"${2|true,false|}\">${3:Badge Text}</bv-badge>"
    ],
    "description": "Insert a BlaiseUI badge/pill"
  },
  "BlaiseUI Alert (bv-alert)": {
    "prefix": "bv-alert",
    "body": [
      "<bv-alert variant=\"${1|success,danger,warning,info,primary|}\" dismissible=\"true\" @close=\"${2:handleAlertClose}\">",
      "  ${3:Alert notification message!}",
      "</bv-alert>"
    ],
    "description": "Insert a BlaiseUI dismissible alert"
  },
  "BlaiseUI Toast (bv-toast)": {
    "prefix": "bv-toast",
    "body": [
      "<bv-toast title=\"${1:Notification}\" message=\"${2:Operation completed successfully!}\" variant=\"success\" :duration=\"3000\"></bv-toast>"
    ],
    "description": "Insert a BlaiseUI animated notification toast"
  },
  "BlaiseUI Chart (bv-chart)": {
    "prefix": "bv-chart",
    "body": [
      "<bv-chart type=\"${1|bar,line,pie,doughnut,radar,polarArea|}\" :data=\"${2:chartData}\" :options=\"${3:chartOptions}\" height=\"260\"></bv-chart>"
    ],
    "description": "Insert a reactive BlaiseUI Chart.js component"
  },
  "BlaiseThemes Theme Toggle": {
    "prefix": "bv-theme-toggle",
    "body": [
      "<bv-theme-toggle></bv-theme-toggle>"
    ],
    "description": "Insert a dark/light mode toggle button"
  },
  "BlaiseThemes Theme Select": {
    "prefix": "bv-theme-select",
    "body": [
      "<bv-theme-select></bv-theme-select>"
    ],
    "description": "Insert a Bootswatch theme dropdown selector"
  },
  "FLIP List Transition Group": {
    "prefix": "bv-transition-group",
    "body": [
      "<transition-group name=\"list\" tag=\"div\" class=\"${1:item-list}\">",
      "  <div v-for=\"item in ${2:items}\" :key=\"item.id\" class=\"list-item\">",
      "    {{ item.name }}",
      "  </div>",
      "</transition-group>"
    ],
    "description": "Insert a FLIP animated transition-group container"
  },
  "Teleport Portal": {
    "prefix": "bv-teleport",
    "body": [
      "<teleport to=\"${1|body,#modal-root,#portal-target|}\">",
      "  <div class=\"${2:teleported-content}\">",
      "    ${3:<!-- Rendered at target portal destination -->}",
      "  </div>",
      "</teleport>"
    ],
    "description": "Insert a BlaiseVue Teleport portal"
  },
  "WebAssembly Accelerator Call ($wasm)": {
    "prefix": "bv-wasm",
    "body": [
      "procedure runWasmComputation;",
      "var",
      "  res: JSValue;",
      "begin",
      "  if Boolean(window['$wasm'] && window['$wasm']['isReady']) then",
      "  begin",
      "    res := window['$wasm'].call('${1:computeFunction}', [${2:param1}]);",
      "    console.log('Wasm computed:', res);",
      "  end",
      "  else",
      "  begin",
      "    // Native Pascal / JS Fallback",
      "    console.log('Running Pascal fallback computation');",
      "  end;",
      "end;"
    ],
    "description": "Pascal method invoking WebAssembly ($wasm) with automatic fallback"
  },
  "Global Store Access ($store)": {
    "prefix": "bv-store",
    "body": [
      "this['$store']['${1:propertyName}'] := ${2:value};"
    ],
    "description": "Access or mutate global reactive store property"
  },
  "Internationalization Helper ($t)": {
    "prefix": "bv-i18n",
    "body": [
      "{{ $t('${1:common.greeting}') }}"
    ],
    "description": "Insert an internationalized translation string"
  },
  "Pascal Method Routine": {
    "prefix": "bv-method",
    "body": [
      "procedure ${1:methodName}(ev: JSValue);",
      "begin",
      "  ${2:// Procedure body}",
      "end;"
    ],
    "description": "Insert a Pascal procedure in methods: section"
  },
  "Pascal Computed Property": {
    "prefix": "bv-computed",
    "body": [
      "function ${1:computedName}: ${2|string,integer,boolean,JSValue|};",
      "begin",
      "  Result := ${3:value};",
      "end;"
    ],
    "description": "Insert a Pascal function in computed: section"
  },
  "Mobile Camera Photo Capture ($mobile.camera)": {
    "prefix": "bv-mobile-camera",
    "body": [
      "procedure capturePhoto(ev: JSValue);",
      "begin",
      "  if Boolean(window['$mobile'] && window['$mobile']['camera']) then",
      "  begin",
      "    window['$mobile']['camera'].takePhoto(procedure(imgUrl: JSValue)",
      "      begin",
      "        this['${1:photoUrl}'] := imgUrl;",
      "      end);",
      "  end;",
      "end;"
    ],
    "description": "Capture camera photo via Capacitor with Web fallback"
  },
  "Mobile Geolocation GPS ($mobile.geolocation)": {
    "prefix": "bv-mobile-geo",
    "body": [
      "procedure fetchLocation(ev: JSValue);",
      "begin",
      "  if Boolean(window['$mobile'] && window['$mobile']['geolocation']) then",
      "  begin",
      "    window['$mobile']['geolocation'].getCurrentPosition(procedure(pos: JSValue)",
      "      begin",
      "        console.log('Latitude:', pos['coords']['latitude']);",
      "        console.log('Longitude:', pos['coords']['longitude']);",
      "      end);",
      "  end;",
      "end;"
    ],
    "description": "Get GPS coordinates via Capacitor with Web fallback"
  },
  "Mobile Haptics Feedback ($mobile.haptics)": {
    "prefix": "bv-mobile-haptics",
    "body": [
      "procedure triggerFeedback;",
      "begin",
      "  if Boolean(window['$mobile'] && window['$mobile']['haptics']) then",
      "  begin",
      "    window['$mobile']['haptics'].impact('${1|medium,light,heavy|}');",
      "  end;",
      "end;"
    ],
    "description": "Trigger haptic vibration feedback on mobile device"
  }
}
