# BlaiseVue .gitignore - Professional Clean State 🛡️

# 🌍 Node.js
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 🛡️ BlaiseCLI Artifacts (bin/)
bin/*.o
bin/*.ppu
bin/*.dcu
bin/*.rsj
bin/bv
bin/bv.exe
bin/bv_new
bin/bv_new.exe
bin/bv.bak
bin/bv.bak.exe
bin/bv_old*
bin/bv_running*
bin/lib/
**/server/bin/
**/server/lib/
**/server-mormot/bin/
**/server-mormot/lib/
**/desktop/bin/
**/desktop/units/

# 🏰 Pascal Build Artifacts (Global)
*.o
*.obj
*.ppu
*.ppu.js
*.rsj
*.exe
*.dll
*.so
*.dylib
*.compiled
*.apk
*.aab
*.ipa
*.lps
*.bak

# ⚙️ Embedded Tools & Resources
temp/
obj/
*.running
*.old
scratch/
packagefiles.xml

# Ensure essential tools in pas2js/ and vendor/ are tracked!
!pas2js/
!pas2js/**
!vendor/
!vendor/**
!vendor/**/*.o
!vendor/**/*.obj
!vendor/**/*.a
vendor/mormot2/packages/lazarus/lib/

# 📊 Local Logs & Trace
compile_log.txt
compile_err.txt
file_list.txt
.vscode/

# 📦 Generated Application Bundles
demo-app/dist/js/*.js
demo-app/generated/
demo-app/rtl.js
generated/
rtl.js
app.cfg
my-app/
deploy/
**/deploy/
.bv_backup/
**/.bv_backup/
.blaisevue/
.bv_upgrade_backup/
dist/
dist_*/
*.zip
**/desktop/assets/js/main.*.js


# 🍎 OS Files
.DS_Store
Thumbs.db
