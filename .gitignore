# BlaiseVue .gitignore - Professional Clean State 🛡️

# 🌍 Node.js
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 🛡️ BlaiseCLI Artifacts (bin/)
bin/*.exe
bin/*.o
bin/*.ppu
bin/*.dcu
bin/*.rsj
bin/lib/
**/server/bin/
**/server/lib/

# 🏰 Pascal Build Artifacts (Global)
*.o
*.obj
*.ppu
*.ppu.js
*.rsj
*.exe
*.dll
*.so
*.dylib
*.compiled
*.apk
*.aab
*.ipa

# ⚙️ Embedded Tools & Resources
temp/
obj/

# Ensure essential tools in pas2js/ and vendor/ are tracked!
!pas2js/
!pas2js/**
!vendor/
!vendor/**
!vendor/**/*.o
!vendor/**/*.obj
!vendor/**/*.a

# 📊 Local Logs & Trace
compile_log.txt
compile_err.txt
file_list.txt
.vscode/

# 📦 Generated Application Bundles
demo-app/dist/js/*.js
demo-app/generated/
demo-app/rtl.js
my-app/

# 🍎 OS Files
.DS_Store
Thumbs.db
