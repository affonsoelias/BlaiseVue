                 'const' + #10 +
                 '  APP_NAME = ''' + StringReplace(AppName, '''', '''''', [
                 rfReplaceAll]) + ''';' + #10 +
                 '  APP_VERSION = ''' + StringReplace(AppVersion, '''', '''''',
                 [rfReplaceAll]) + ''';' + #10 +
                 '  APP_AUTHOR = ''' + StringReplace(AppAuthor, '''', '''''', [
                 rfReplaceAll]) + ''';' + #10 +
                 '  APP_LICENSE = ''' + StringReplace(AppLicense, '''', '''''',
                 [rfReplaceAll]) + ''';' + #10 +
                 '  APP_BUILD_DATE = ''' + BuildDate + ''';' + #10#10 +
