{ Downloads and installs a package archive directly from an HTTP/HTTPS URL. }
Procedure InstallDirectArchive(Const URL: String; IsGlobal: Boolean);

Var 
  TargetBase, DownloadURL, ZipName: string;
  Client: TFPHTTPClient;
  UnZipper: TUnZipper;
Begin
  If IsGlobal Then
    TargetBase := GetGlobalPackagesPath
  Else
    TargetBase := GetCurrentDir + DirectorySeparator + 'lib' +
                  DirectorySeparator;
  ForceDir(TargetBase);
  If FileExists(URL) Or FileExists(ExpandFileName(URL)) Then
    Begin
      ZipName := URL;
      If Not FileExists(ZipName) Then ZipName := ExpandFileName(URL);
      WriteLn('Installing from local archive: ', ZipName);
    End
  Else
    Begin
      DownloadURL := URL;
      ZipName := TargetBase + 'temp_download.zip';
      WriteLn('Downloading from: ', DownloadURL);
      Client := TFPHTTPClient.Create(Nil);
      Try
        Try
          Client.AllowRedirect := True;
          Client.Get(DownloadURL, ZipName);
        Except
          on E: Exception Do
                Begin
                  WriteLn('Download error: ', E.Message);
                  Halt(1);
                End;
    End;
Finally
  Client.Free;
End;
End;

WriteLn('Extracting to ' + TargetBase + '...');
UnZipper := TUnZipper.Create;
Try
  UnZipper.FileName := ZipName;
  UnZipper.OutputPath := TargetBase;
  UnZipper.Examine;
  UnZipper.UnZipAllFiles;
Finally
  UnZipper.Free;
End;

If (ZipName = TargetBase + 'temp_download.zip') And FileExists(ZipName) Then
  DeleteFile(ZipName);

WriteLn('Installation completed successfully!');
End;

{ Returns the list of registered package repository names ordered by priority. }
Procedure GetOrderedRepoNames(out RepoNames: TStringList);

Var 
  RootObj, RepoObj: TJSONObject;
  ReposArr: TJSONArray;
  i: Integer;
  RName, DefaultName: string;
  IsDef: Boolean;
Begin
  RepoNames := TStringList.Create;
  DefaultName := '';
  If LoadReposRegistry(RootObj) Then
    Begin
      Try
        ReposArr := RootObj.Get('repositories', TJSONArray(Nil));
        If Assigned(ReposArr) Then
          Begin
            For i := 0 To ReposArr.Count - 1 Do
              Begin
                If ReposArr.Types[i] = jtObject Then
                  Begin
                    RepoObj := TJSONObject(ReposArr.Objects[i]);
                    IsDef := RepoObj.Get('default', False);
                    If IsDef Then
                      Begin
                        DefaultName := RepoObj.Get('name', '');
                        Break;
                      End;
                  End;
              End;
            If (DefaultName = '') And (ReposArr.Count > 0) And (ReposArr.Types[0
               ] = jtObject) Then
              DefaultName := TJSONObject(ReposArr.Objects[0]).Get('name', '');

            If DefaultName <> '' Then
              RepoNames.Add(DefaultName);

            For i := 0 To ReposArr.Count - 1 Do
              Begin
                If ReposArr.Types[i] = jtObject Then
                  Begin
                    RepoObj := TJSONObject(ReposArr.Objects[i]);
                    RName := RepoObj.Get('name', '');
                    If (RName <> '') And (Not SameText(RName, DefaultName)) Then
                      RepoNames.Add(RName);
                  End;
              End;
          End;
      Finally
        RootObj.Free;
    End;
End;

If RepoNames.Count = 0 Then
  RepoNames.Add('official');
End;




{ Parses a SemVer 2.0 version string into numeric major, minor, patch and prerelease suffix. }
Procedure ParseSemVerParts(Const VerStr: String; out Major, Minor, Patch:
                           Integer; out Prerelease: String);

Var 
  CleanStr, MainPart, ExtraPart: string;
  Parts: TStringList;
  DashPos: Integer;
Begin
  Major := 0;
  Minor := 0;
  Patch := 0;
  Prerelease := '';
  CleanStr := Trim(VerStr);
  If (CleanStr <> '') And ((CleanStr[1] = 'v') Or (CleanStr[1] = 'V')) Then
    CleanStr := Copy(CleanStr, 2, Length(CleanStr) - 1);

  DashPos := Pos('-', CleanStr);
  If DashPos > 0 Then
    Begin
      MainPart := Copy(CleanStr, 1, DashPos - 1);
      ExtraPart := Copy(CleanStr, DashPos + 1, Length(CleanStr) - DashPos);
      Prerelease := ExtraPart;
    End
  Else
    MainPart := CleanStr;

  Parts := TStringList.Create;
  Try
    Parts.Delimiter := '.';
    Parts.StrictDelimiter := True;
    Parts.DelimitedText := MainPart;
    If Parts.Count >= 1 Then Major := StrToIntDef(Parts[0], 0);
    If Parts.Count >= 2 Then Minor := StrToIntDef(Parts[1], 0);
    If Parts.Count >= 3 Then Patch := StrToIntDef(Parts[2], 0);
  Finally
    Parts.Free;
End;
End;




{ Compares two SemVer strings. Returns 1 if V1 > V2, -1 if V1 < V2, 0 if V1 = V2. }
Function CompareSemVer(Const V1, V2: String): Integer;

Var 
  Maj1, Min1, Pat1, Maj2, Min2, Pat2: Integer;
  Pre1, Pre2: string;
Begin
  ParseSemVerParts(V1, Maj1, Min1, Pat1, Pre1);
  ParseSemVerParts(V2, Maj2, Min2, Pat2, Pre2);

  If Maj1 <> Maj2 Then
    Begin
      If Maj1 > Maj2 Then Result := 1
      Else Result := -1;
      Exit;
    End;
  If Min1 <> Min2 Then
    Begin
      If Min1 > Min2 Then Result := 1
      Else Result := -1;
      Exit;
    End;
  If Pat1 <> Pat2 Then
    Begin
      If Pat1 > Pat2 Then Result := 1
      Else Result := -1;
      Exit;
    End;

  If (Pre1 = '') And (Pre2 <> '') Then
    Result := 1
  Else If (Pre1 <> '') And (Pre2 = '') Then
         Result := -1
  Else If Pre1 <> Pre2 Then
         Result := CompareStr(Pre1, Pre2)
  Else
    Result := 0;
End;




{ Checks whether a candidate SemVer satisfies a range specifier (^, ~, >=, <=, latest, *). }
Function MatchSemVerRange(Const CandidateVer, RangeSpec: String): Boolean;

Var 
  CleanSpec, CleanCandidate, TargetVer: string;
  MajC, MinC, PatC, MajS, MinS, PatS: Integer;
  PreC, PreS: string;
  Cmp: Integer;
Begin
  CleanSpec := Trim(RangeSpec);
  CleanCandidate := Trim(CandidateVer);

  If (CleanSpec = '') Or (CleanSpec = '*') Or (CleanSpec = 'x') Or (CleanSpec =
     'X') Or
     SameText(CleanSpec, 'latest') Or SameText(CleanSpec, 'any') Then
    Begin
      Result := True;
      Exit;
    End;

  ParseSemVerParts(CleanCandidate, MajC, MinC, PatC, PreC);

  If CleanSpec[1] = '^' Then
    Begin
      TargetVer := Copy(CleanSpec, 2, Length(CleanSpec) - 1);
      ParseSemVerParts(TargetVer, MajS, MinS, PatS, PreS);
      Cmp := CompareSemVer(CleanCandidate, TargetVer);
      If Cmp < 0 Then
        Begin
          Result := False;
          Exit;
        End;
      If MajS > 0 Then
        Result := (MajC = MajS)
      Else If MinS > 0 Then
             Result := (MajC = 0) And (MinC = MinS)
      Else
        Result := (MajC = 0) And (MinC = 0) And (PatC = PatS);
      Exit;
    End;

  If CleanSpec[1] = '~' Then
    Begin
      TargetVer := Copy(CleanSpec, 2, Length(CleanSpec) - 1);
      ParseSemVerParts(TargetVer, MajS, MinS, PatS, PreS);
      Cmp := CompareSemVer(CleanCandidate, TargetVer);
      If Cmp < 0 Then
        Begin
          Result := False;
          Exit;
        End;
      Result := (MajC = MajS) And (MinC = MinS);
      Exit;
    End;

  If StartsText('>=', CleanSpec) Then
    Begin
      TargetVer := Trim(Copy(CleanSpec, 3, Length(CleanSpec) - 2));
      Result := CompareSemVer(CleanCandidate, TargetVer) >= 0;
      Exit;
    End;

  If StartsText('<=', CleanSpec) Then
    Begin
      TargetVer := Trim(Copy(CleanSpec, 3, Length(CleanSpec) - 2));
      Result := CompareSemVer(CleanCandidate, TargetVer) <= 0;
      Exit;
    End;

  If (CleanSpec <> '') And ((CleanSpec[1] = 'v') Or (CleanSpec[1] = 'V')) Then
    CleanSpec := Copy(CleanSpec, 2, Length(CleanSpec) - 1);
  If (CleanCandidate <> '') And ((CleanCandidate[1] = 'v') Or (CleanCandidate[1]
     = 'V')) Then
    CleanCandidate := Copy(CleanCandidate, 2, Length(CleanCandidate) - 1);

  Result := (CleanCandidate = CleanSpec);
End;




{ Queries registered package repositories to locate a package satisfying a SemVer constraint. }
Function FindPackageInEcosystem(Const PkgName: String; Const ReqVersion: String;
                                out FoundVersion, DownloadURL, Checksum,
                                RepoName: String; Const TargetRepo: String = '')
: Boolean;

Var 
  CacheDir, CacheFile, RawJson, PkgKey, CandidateVer, DesiredVer, CurrentRepo:


                                                                          string
  ;
  BestVer, BestDownloadURL, BestChecksum: string;
  Parser: TJSONParser;
  Data: TJSONData;
  RootObj, PackagesObj, PkgObj, VerObj: TJSONObject;
  VersionsArr: TJSONArray;
  i, j, rIdx: Integer;
  RepoList, FoundInOtherRepos: TStringList;
  MatchedInThisRepo: Boolean;
Begin
  Result := False;
  FoundVersion := '';
  DownloadURL := '';
  Checksum := '';
  RepoName := '';
  CacheDir := ExtractFileDir(GetReposConfigPath) + DirectorySeparator + 'cache';
  If Not DirectoryExists(CacheDir) Then
    CmdRepoSync;

  RepoList := Nil;
  FoundInOtherRepos := TStringList.Create;
  Try
    If TargetRepo <> '' Then
      Begin
        RepoList := TStringList.Create;
        If FileExists(CacheDir + DirectorySeparator + TargetRepo +
           '-ecosystem.json') Then
          RepoList.Add(TargetRepo)
        Else If SameText(TargetRepo, 'official') Or SameText(TargetRepo,
                'blaisevue-ecosystem') Then
               RepoList.Add('official')
        Else
          RepoList.Add(TargetRepo);
      End
    Else
      GetOrderedRepoNames(RepoList);

    For rIdx := 0 To RepoList.Count - 1 Do
      Begin
        CurrentRepo := RepoList[rIdx];
        CacheFile := CacheDir + DirectorySeparator + CurrentRepo +
                     '-ecosystem.json';
        If Not FileExists(CacheFile) Then
          Continue;

        RawJson := ReadFileToString(CacheFile);
        If Trim(RawJson) = '' Then
          Continue;

        Parser := TJSONParser.Create(RawJson, True);
        Try
          Try
            Data := Parser.Parse;
            If Assigned(Data) And (Data.JSONType = jtObject) Then
              Begin
                RootObj := TJSONObject(Data);
                If (Not (SameText(CurrentRepo, 'official') Or SameText(
                   CurrentRepo, 'blaisevue-ecosystem'))) And
                   IsReservedCorePackageName(PkgName) Then
                  Begin
                    // Skip hijacked core name from third-party repo
                  End
                Else
                  Begin
                    PackagesObj := RootObj.Get('packages', TJSONObject(Nil));
                    If Assigned(PackagesObj) Then
                      Begin
                        For i := 0 To PackagesObj.Count - 1 Do
                          Begin
                            PkgKey := PackagesObj.Names[i];
                            If SameText(PkgKey, PkgName) Then
                              Begin
                                MatchedInThisRepo := False;
                                PkgObj := TJSONObject(PackagesObj.Items[i]);
                                DesiredVer := ReqVersion;
                                BestVer := '';
                                BestDownloadURL := '';
                                BestChecksum := '';

                                VersionsArr := PkgObj.Get('versions', TJSONArray
                                               (Nil));
                                If Assigned(VersionsArr) Then
                                  Begin
                                    For j := 0 To VersionsArr.Count - 1 Do
                                      Begin
                                        If VersionsArr.Types[j] = jtObject Then
                                          Begin
                                            VerObj := TJSONObject(VersionsArr.
                                                      Objects[j]);
                                            CandidateVer := VerObj.Get('version'
                                                            , '');
                                            If MatchSemVerRange(CandidateVer,
                                               DesiredVer) Then
                                              Begin
                                                If (BestVer = '') Or (
                                                   CompareSemVer(CandidateVer,
                                                   BestVer) > 0) Then
                                                  Begin
                                                    BestVer := CandidateVer;
                                                    BestDownloadURL := VerObj.
                                                                       Get(


                                                                  'download_url'
                                                                       , '');
                                                    BestChecksum := VerObj.Get(
                                                                    'checksum',
                                                                    '');
                                                  End;
                                              End;
                                          End
                                        Else If VersionsArr.Types[j] = jtString
                                               Then
                                               Begin
                                                 CandidateVer := VersionsArr.
                                                                 Strings[j];
                                                 If MatchSemVerRange(
                                                    CandidateVer, DesiredVer)
                                                   Then
                                                   Begin
                                                     If (BestVer = '') Or (
                                                        CompareSemVer(
                                                        CandidateVer, BestVer) >
                                                        0) Then
                                                       Begin
                                                         BestVer := CandidateVer
                                                         ;
                                                         BestDownloadURL := 


                                                                          PkgObj
                                                                            .Get
                                                                            (


                                                                      'download'
                                                                            , ''
                                                                            );
                                                         BestDownloadURL := 


                                                                   StringReplace
                                                                            (


                                                                 BestDownloadURL
                                                                            ,


                                                                         '{tag}'
                                                                            ,


                                                                          PkgKey
                                                                            +
                                                                            '@'
                                                                            +


                                                                    CandidateVer
                                                                            , [


                                                                    rfReplaceAll
                                                                            ]);
                                                         BestDownloadURL := 


                                                                   StringReplace
                                                                            (


                                                                 BestDownloadURL
                                                                            ,


                                                                     '{package}'
                                                                            ,


                                                                          PkgKey
                                                                            , [


                                                                    rfReplaceAll
                                                                            ]);
                                                         BestDownloadURL := 


                                                                   StringReplace
                                                                            (


                                                                 BestDownloadURL
                                                                            ,


                                                                     '{version}'
                                                                            ,


                                                                    CandidateVer
                                                                            , [


                                                                    rfReplaceAll
                                                                            ]);
                                                         BestChecksum := '';
                                                       End;
                                                   End;
                                               End;
                                      End;
                                  End;

                                If (BestVer = '') And ((DesiredVer = '') Or
                                   SameText(DesiredVer, 'latest')) Then
                                  Begin
                                    BestVer := PkgObj.Get('latest', '');
                                    If BestVer <> '' Then
                                      Begin
                                        BestDownloadURL := PkgObj.Get('download'
                                                           , '');
                                        BestDownloadURL := StringReplace(
                                                           BestDownloadURL,
                                                           '{tag}', PkgKey + '@'
                                                           + BestVer, [
                                                           rfReplaceAll]);
                                        BestDownloadURL := StringReplace(
                                                           BestDownloadURL,
                                                           '{package}', PkgKey,
                                                           [rfReplaceAll]);
                                        BestDownloadURL := StringReplace(
                                                           BestDownloadURL,
                                                           '{version}', BestVer,
                                                           [rfReplaceAll]);
                                        BestChecksum := PkgObj.Get('checksum',
                                                        '');
                                      End;
                                  End;

                                If BestVer <> '' Then
                                  Begin
                                    If Not Result Then
                                      Begin
                                        FoundVersion := BestVer;
                                        DownloadURL := BestDownloadURL;
                                        Checksum := BestChecksum;
                                        RepoName := RootObj.Get('name',
                                                    CurrentRepo);
                                        Result := True;
                                        MatchedInThisRepo := True;
                                      End
                                    Else
                                      MatchedInThisRepo := True;
                                  End;

                                If MatchedInThisRepo And Result And (Not
                                   SameText(RepoName, CurrentRepo)) Then
                                  Begin
                                    If FoundInOtherRepos.IndexOf(CurrentRepo) <
                                       0 Then
                                      FoundInOtherRepos.Add(CurrentRepo);
                                  End;
                                Break;
                              End;
                          End;
                      End;
                  End;
                Data.Free;
              End;
          Except
      End;
  Finally
    Parser.Free;
End;

If (TargetRepo <> '') And Result Then
  Break;
End;

If (TargetRepo = '') And Result And (FoundInOtherRepos.Count > 0) Then
  Begin
    WriteLn('Notice: Package "' + PkgName + '" was also found in repository: ' +
            FoundInOtherRepos.CommaText + '.');
    WriteLn('        Using [' + RepoName +


           '] (by priority). To specify repository, use: bv lib install <repo>:'
            + PkgName);
  End;
Finally
  If Assigned(RepoList) Then RepoList.Free;
  FoundInOtherRepos.Free;
End;
End;

{ Searches for a developer tool in registered ecosystem repositories. }
Function FindToolInEcosystem(Const ToolName: String; Const ReqVersion: String;
                             out FoundVersion, DownloadURL, Checksum, RepoName,
                             FoundType: String;
                             Const TargetRepo: String = ''): Boolean;

Var 
  CacheDir, CurrentRepo, CacheFile, RawJson, DesiredVer, CandidateVer, ToolKey,
  DeclaredType: string;
  BestVer, BestDownloadURL, BestChecksum: string;
  RepoList: TStringList;
  rIdx, i, j: Integer;
  Parser: TJSONParser;
  Data: TJSONData;
  RootObj, ToolsObj, ToolObj, VerObj: TJSONObject;
  VersionsArr: TJSONArray;
  CleanName: string;
Begin
  Result := False;
  FoundVersion := '';
  DownloadURL := '';
  Checksum := '';
  RepoName := '';
  FoundType := 'third-party';

  CleanName := LowerCase(Trim(ToolName));
  If StartsText('@blaise/', CleanName) Then
    CleanName := Copy(CleanName, 9, Length(CleanName) - 8);

  CacheDir := ExtractFileDir(GetReposConfigPath) + DirectorySeparator + 'cache';
  If Not DirectoryExists(CacheDir) Then
    CmdRepoSync;

  RepoList := TStringList.Create;
  Try
    If TargetRepo <> '' Then
      Begin
        If FileExists(CacheDir + DirectorySeparator + TargetRepo +
           '-ecosystem.json') Then
          RepoList.Add(TargetRepo)
        Else If SameText(TargetRepo, 'official') Or SameText(TargetRepo,
                'blaisevue-ecosystem') Then
               RepoList.Add('official')
        Else
          RepoList.Add(TargetRepo);
      End
    Else
      GetOrderedRepoNames(RepoList);

    For rIdx := 0 To RepoList.Count - 1 Do
      Begin
        CurrentRepo := RepoList[rIdx];
        CacheFile := CacheDir + DirectorySeparator + CurrentRepo +
                     '-ecosystem.json';
        If Not FileExists(CacheFile) Then
          Continue;

        RawJson := ReadFileToString(CacheFile);
        If Trim(RawJson) = '' Then
          Continue;

        Parser := TJSONParser.Create(RawJson, True);
        Try
          Try
            Data := Parser.Parse;
            If Assigned(Data) And (Data.JSONType = jtObject) Then
              Begin
                RootObj := TJSONObject(Data);

                // 1. Check "tools" section
                ToolsObj := RootObj.Get('tools', TJSONObject(Nil));
                // 2. If not found in "tools", check "packages" section
                If Not Assigned(ToolsObj) Then
                  ToolsObj := RootObj.Get('packages', TJSONObject(Nil));

                If Assigned(ToolsObj) Then
                  Begin
                    For i := 0 To ToolsObj.Count - 1 Do
                      Begin
                        ToolKey := ToolsObj.Names[i];
                        If SameText(ToolKey, ToolName) Or
                           SameText(ToolKey, CleanName) Or
                           SameText('blaise-' + ToolKey, ToolName) Or
                           SameText(ToolKey, 'blaise-' + CleanName) Or
                           SameText(ToolKey, 'blaise-' + ToolName) Then
                          Begin
                            ToolObj := TJSONObject(ToolsObj.Items[i]);

                            DeclaredType := LowerCase(ToolObj.Get('type', ''));
                            If DeclaredType <> '' Then
                              FoundType := DeclaredType
                            Else If SameText(CurrentRepo, 'official') Or
                                    StartsText('blaise-', LowerCase(ToolKey))
                                   Then
                                   FoundType := 'co-official'
                            Else
                              FoundType := 'third-party';

                            DesiredVer := ReqVersion;
                            BestVer := '';
                            BestDownloadURL := '';
                            BestChecksum := '';

                            VersionsArr := ToolObj.Get('versions', TJSONArray(
                                           Nil));
                            If Assigned(VersionsArr) Then
                              Begin
                                For j := 0 To VersionsArr.Count - 1 Do
                                  Begin
                                    If VersionsArr.Types[j] = jtObject Then
                                      Begin
                                        VerObj := TJSONObject(VersionsArr.
                                                  Objects[j]);
                                        CandidateVer := VerObj.Get('version', ''
                                                        );
                                        If MatchSemVerRange(CandidateVer,
                                           DesiredVer) Then
                                          Begin
                                            If (BestVer = '') Or (CompareSemVer(
                                               CandidateVer, BestVer) > 0) Then
                                              Begin
                                                BestVer := CandidateVer;
                                                BestDownloadURL := VerObj.Get(


                                                                  'download_url'
                                                                   , '');
                                                If BestDownloadURL = '' Then
                                                  BestDownloadURL := VerObj.Get(
                                                                     'url', '');
                                                BestChecksum := VerObj.Get(
                                                                'checksum', '');
                                              End;
                                          End;
                                      End
                                    Else If VersionsArr.Types[j] = jtString Then
                                           Begin
                                             CandidateVer := VersionsArr.Strings
                                                             [j];
                                             If MatchSemVerRange(CandidateVer,
                                                DesiredVer) Then
                                               Begin
                                                 If (BestVer = '') Or (
                                                    CompareSemVer(CandidateVer,
                                                    BestVer) > 0) Then
                                                   Begin
                                                     BestVer := CandidateVer;
                                                     BestDownloadURL := ToolObj.
                                                                        Get(


                                                                      'download'
                                                                        , '');
                                                     BestChecksum := ToolObj.Get
                                                                     ('checksum'
                                                                     , '');
                                                   End;
                                               End;
                                           End;
                                  End;
                              End;

                            If (BestVer = '') And ((DesiredVer = '') Or SameText
                               (DesiredVer, 'latest')) Then
                              Begin
                                BestVer := ToolObj.Get('latest', '');
                                If BestVer <> '' Then
                                  Begin
                                    BestDownloadURL := ToolObj.Get(
                                                       'download_url', ToolObj.
                                                       Get('download', ''));
                                    BestChecksum := ToolObj.Get('checksum', '');
                                  End;
                              End;

                            If BestVer <> '' Then
                              Begin
                                FoundVersion := BestVer;
                                DownloadURL := BestDownloadURL;
                                Checksum := BestChecksum;
                                RepoName := RootObj.Get('name', CurrentRepo);
                                Result := True;
                              End
                            Else If Not Assigned(VersionsArr) Then
                                   Begin
                                     CandidateVer := ToolObj.Get('version',
                                                     ToolObj.Get('latest',
                                                     '1.0.0'));
                                     If MatchSemVerRange(CandidateVer,
                                        DesiredVer) Then
                                       Begin
                                         FoundVersion := CandidateVer;
                                         DownloadURL := ToolObj.Get(
                                                        'download_url', ToolObj.
                                                        Get('download', ''));
                                         Checksum := ToolObj.Get('checksum', '')
                                         ;
                                         RepoName := RootObj.Get('name',
                                                     CurrentRepo);
                                         Result := (DownloadURL <> '');
                                       End;
                                   End;

                            If Result Then
                              Break;
                          End;
                      End;
                  End;
              End;
          Except
      End;
  Finally
    Parser.Free;
End;

If Result Then
  Break;
End;
Finally
  If Assigned(RepoList) Then RepoList.Free;
End;
End;




{ Lists all installed libraries and framework packages for the current project or globally (bv lib list). }
Procedure CmdLibList(IsGlobal: Boolean = False);

Var 
  SR: TSearchRec;
  Path, Extra, Ver: string;
  Count: Integer;
Begin
  WriteLn('');
  If IsGlobal Then
    Begin
      Path := GetGlobalPackagesPath;
      WriteLn('=== User Global Packages (~/.blaisevue/packages) ===');
      WriteLn(StringOfChar('-', 55));
      Count := 0;
      If FindFirst(Path + '*', faDirectory, SR) = 0 Then
        Begin
          Repeat
            If (SR.Name <> '.') And (SR.Name <> '..') And ((SR.Attr And
               faDirectory) <> 0) Then
              Begin
                Inc(Count);
                Ver := GetPackageVersionFromFolder(Path + SR.Name);
                If Ver <> '' Then Ver := ' (v' + Ver + ')';
                WriteLn('  - ', SR.Name, Ver);
              End;
          Until FindNext(SR) <> 0;
          FindClose(SR);
        End;
      If Count = 0 Then
        WriteLn('  (No global packages installed)');
      WriteLn(StringOfChar('-', 55));
    End
  Else
    Begin
      Path := GetCurrentDir + DirectorySeparator + 'lib' + DirectorySeparator;
      WriteLn('=== Installed Libraries in Project (/lib) ===');
      WriteLn(StringOfChar('-', 55));
      Count := 0;
      If DirectoryExists(Path) And (FindFirst(Path + '*', faDirectory, SR) = 0)
        Then
        Begin
          Repeat
            If (SR.Name <> '.') And (SR.Name <> '..') And ((SR.Attr And
               faDirectory) <> 0) Then
              Begin
                Inc(Count);
                Extra := '';
                Ver := GetPackageVersionFromFolder(Path + SR.Name);
                If Ver <> '' Then Extra := ' (v' + Ver + ')';
                If IsOfficialCorePackage(SR.Name) Then
                  Extra := Extra + ' [Official Core]';
                If FileExists(Path + SR.Name + DirectorySeparator + 'setup.pas')
                  Then
                  Extra := Extra + ' [Scripted]';
                WriteLn('  - ', SR.Name, Extra);
              End;
          Until FindNext(SR) <> 0;
          FindClose(SR);
        End;
      If Count = 0 Then
        WriteLn('  (No libraries installed in /lib)');
      WriteLn(StringOfChar('-', 55));
      WriteLn('Official Core Packages (packages/core):');
      WriteLn('  - blaise-themes, blaise-icons, blaise-ui, blaise-ui-mobile,');
      WriteLn('    blaise-charts, blaise-reports, blaise-studio');
      WriteLn('Use "bv lib list --global" to view packages in global cache.');
      WriteLn(StringOfChar('-', 55));
    End;
End;




{ Uninstalls a package and removes its source code and assets from the project (bv lib remove). }
Procedure CmdLibRemove(Const LibName: String; IsGlobal: Boolean = False);

Var 
  Path, CorePath: string;
  CanonicalName: string;
Begin
  CanonicalName := LowerCase(Trim(LibName));
  If StartsText('@', CanonicalName) Then
    CanonicalName := Copy(CanonicalName, 2, Length(CanonicalName) - 1);
  CorePath := GetPackagesPath + CanonicalName;
  If DirectoryExists(CorePath) Or
     (CanonicalName = 'themes') Or (CanonicalName = 'icons') Or
     (CanonicalName = 'ui') Or (CanonicalName = 'mobile') Or
     (CanonicalName = 'charts') Or (CanonicalName = 'reports') Or (CanonicalName
     = 'studio') Then
    Begin
      If IsGlobal Then
        Begin
          WriteLn('Action blocked: "' + LibName +


'" is an official core framework package (packages/core/) and cannot be removed from framework.'
          );
          Exit;
        End;
    End;

  If IsGlobal Then
    Begin
      Path := GetGlobalPackagesPath + CanonicalName;
      If DirectoryExists(Path) Then
        Begin
          DeleteDir(Path);
          WriteLn('Global package "' + LibName +
                  '" removed successfully from ~/.blaisevue/packages/.');
        End
      Else
        WriteLn('Error: Global package "' + LibName +
                '" not found in ~/.blaisevue/packages/.');
    End
  Else
    Begin
      Path := GetCurrentDir + DirectorySeparator + 'lib' + DirectorySeparator +
              LibName;
      If Not DirectoryExists(Path) Then
        Begin
          If (CanonicalName = 'themes') Or (CanonicalName = 'blaise-themes')
            Then Path := GetCurrentDir + DirectorySeparator + 'lib' +
                         DirectorySeparator + 'themes'
          Else If (CanonicalName = 'icons') Or (CanonicalName = 'blaise-icons')
                 Then Path := GetCurrentDir + DirectorySeparator + 'lib' +
                              DirectorySeparator + 'icons'
          Else If (CanonicalName = 'ui') Or (CanonicalName = 'blaise-ui') Then
                 Path := GetCurrentDir + DirectorySeparator + 'lib' +
                         DirectorySeparator + 'blaise-ui'
          Else If (CanonicalName = 'mobile') Or (CanonicalName =
                  'blaise-ui-mobile') Then Path := GetCurrentDir +
                                                   DirectorySeparator + 'lib' +
                                                   DirectorySeparator +
                                                   'blaise-ui-mobile'
          Else If (CanonicalName = 'charts') Or (CanonicalName = 'blaise-charts'
                  ) Then Path := GetCurrentDir + DirectorySeparator + 'lib' +
                                 DirectorySeparator + 'blaise-charts'
          Else If (CanonicalName = 'reports') Or (CanonicalName =
                  'blaise-reports') Then Path := GetCurrentDir +
                                                 DirectorySeparator + 'lib' +
                                                 DirectorySeparator +
                                                 'blaise-reports'
          Else If (CanonicalName = 'studio') Or (CanonicalName = 'blaise-studio'
                  ) Then Path := GetCurrentDir + DirectorySeparator + 'lib' +
                                 DirectorySeparator + 'blaise-studio';
        End;

      If DirectoryExists(Path) Then
        Begin
          If FileExists(Path + DirectorySeparator + 'setup.pas') Then
            Begin
              WriteLn('Detected setup script. Running cleanup...');
              RunSetupScript(LibName, 'remove');
            End;
          DeleteDir(Path);
          WriteLn('Library "' + LibName + '" removed from /lib successfully.');
        End
      Else
        WriteLn('Error: Library "' + LibName + '" not found in /lib.');
    End;
End;




{ Installs a package from registry, local folder, or URL into the project (bv lib install). }
Procedure CmdLibInstall(Const TargetArg: String; IsGlobal: Boolean = False);

Var 
  RawArg, PkgName, ReqVersion, TargetRepo, RemainingArg: string;
  AtPos, ColonPos: Integer;
  LibPath, GlobalPath, TempZip: string;
  FoundVer, DownloadURL, Checksum, RepoName, CachedVer: string;
  Client: TFPHTTPClient;
Begin
  RawArg := Trim(TargetArg);
  If RawArg = '' Then
    Begin
      WriteLn('Usage: bv lib install [<repo>:]<package[@version]> [--global|-g]'
      );
      WriteLn('       bv lib install <url|archive.zip> [--global|-g]');
      Exit;
    End;

  If StartsText('http://', RawArg) Or StartsText('https://', RawArg) Or
     (LowerCase(ExtractFileExt(RawArg)) = '.zip') Or FileExists(RawArg) Or
     FileExists(ExpandFileName(RawArg)) Then
    Begin
      InstallDirectArchive(RawArg, IsGlobal);
      Exit;
    End;

  // Check for <repo>:<package>[@version]
  ColonPos := Pos(':', RawArg);
  If ColonPos > 0 Then
    Begin
      TargetRepo := Trim(Copy(RawArg, 1, ColonPos - 1));
      RemainingArg := Trim(Copy(RawArg, ColonPos + 1, Length(RawArg) - ColonPos)
                      );
    End
  Else
    Begin
      TargetRepo := '';
      RemainingArg := RawArg;
    End;

  If (Length(RemainingArg) > 1) And (RemainingArg[1] = '@') Then
    Begin
      AtPos := Pos('@', Copy(RemainingArg, 2, Length(RemainingArg) - 1));
      If AtPos > 0 Then
        Begin
          PkgName := Copy(RemainingArg, 2, AtPos - 1);
          ReqVersion := Trim(Copy(RemainingArg, AtPos + 2, Length(RemainingArg)
                        - AtPos - 1));
        End
      Else
        Begin
          PkgName := Copy(RemainingArg, 2, Length(RemainingArg) - 1);
          ReqVersion := '';
        End;
    End
  Else
    Begin
      AtPos := Pos('@', RemainingArg);
      If AtPos > 0 Then
        Begin
          PkgName := Trim(Copy(RemainingArg, 1, AtPos - 1));
          ReqVersion := Trim(Copy(RemainingArg, AtPos + 1, Length(RemainingArg)
                        - AtPos));
        End
      Else
        Begin
          PkgName := Trim(RemainingArg);
          ReqVersion := '';
        End;
    End;

  If PkgName = '' Then
    Begin
      WriteLn('Error: Invalid package name in "' + RawArg + '".');
      Exit;
    End;

  // Security Check: Core Reserved Names from third-party repositories
  If (TargetRepo <> '') And (Not (SameText(TargetRepo, 'official') Or SameText(
     TargetRepo, 'blaisevue-ecosystem'))) And IsReservedCorePackageName(PkgName)
    Then
    Begin
      WriteLn('Error: Cannot install package "' + PkgName +
              '" from repository "' + TargetRepo + '".');
      WriteLn('The package name "' + PkgName +
              '" is reserved for the official BlaiseVue Core framework.');
      WriteLn(


'Third-party repositories are not permitted to publish packages with reserved core names.'
      );
      Halt(1);
    End;




// If TargetRepo is empty or official, check if it is a local native core package:
  If (TargetRepo = '') Or SameText(TargetRepo, 'official') Or SameText(
     TargetRepo, 'blaisevue-ecosystem') Then
    Begin
      If IsOfficialCorePackage(PkgName) Then
        Begin
          If IsGlobal Then
            Begin
              WriteLn('Notice: Package "' + PkgName +


                    '" is an official core framework package in packages/core/.'
              );
              WriteLn(


          'It is already available natively across all BlaiseVue installations.'
              );
              Exit;
            End;
          InstallCorePackage(PkgName);
          Exit;
        End;
    End;

  GlobalPath := GetGlobalPackagesPath + PkgName;
  LibPath := GetCurrentDir + DirectorySeparator + 'lib' + DirectorySeparator +
             PkgName;
  If TargetRepo <> '' Then
    WriteLn('Searching for package "' + PkgName + '" in repository [' +
            TargetRepo + ']...')
  Else
    WriteLn('Searching for package "' + PkgName +
            '" in ecosystem repositories...');

  If FindPackageInEcosystem(PkgName, ReqVersion, FoundVer, DownloadURL, Checksum
     , RepoName, TargetRepo) Then
    Begin
      If (Not IsGlobal) And DirectoryExists(GlobalPath) Then
        Begin
          CachedVer := GetPackageVersionFromFolder(GlobalPath);
          If (CachedVer <> '') And (CachedVer = FoundVer) Then
            Begin
              WriteLn('Installing package "' + PkgName + '" (v' + CachedVer +
                      ') from user global cache (~/.blaisevue/packages)...');
              ForceDir(GetCurrentDir + DirectorySeparator + 'lib');
              If DirectoryExists(LibPath) Then DeleteDir(LibPath);
              ForceDir(LibPath);
              CopyDir(GlobalPath, LibPath, []);
              WriteLn('Package "' + PkgName + '" installed successfully in lib/'
                      + PkgName + '/.');
              If FileExists(LibPath + DirectorySeparator + 'setup.pas') Then
                Begin
                  WriteLn('Executing package setup script...');
                  RunSetupScript(PkgName, 'install');
                End;
              Exit;
            End;
        End;
    End
  Else
    Begin
      If (TargetRepo = '') And (Not IsGlobal) And DirectoryExists(GlobalPath)
        Then
        Begin
          CachedVer := GetPackageVersionFromFolder(GlobalPath);
          If (ReqVersion = '') Or (ReqVersion = CachedVer) Then
            Begin
              WriteLn(


                   'Notice: Remote catalog unreachable. Using cached version (v'
                      + CachedVer + ')...');
              ForceDir(GetCurrentDir + DirectorySeparator + 'lib');
              If DirectoryExists(LibPath) Then DeleteDir(LibPath);
              ForceDir(LibPath);
              CopyDir(GlobalPath, LibPath, []);
              WriteLn('Package "' + PkgName + '" installed successfully in lib/'
                      + PkgName + '/.');
              Exit;
            End;
        End;

      WriteLn('Error: Package "' + PkgName + '"');
      If ReqVersion <> '' Then
        WriteLn('  Requested version: ' + ReqVersion)
      Else
        WriteLn('  (latest version)');
      If TargetRepo <> '' Then
        WriteLn('Was not found in repository [' + TargetRepo + '].')
      Else
        WriteLn('Was not found in any registered repositories.');
      WriteLn(


'Hint: Run "bv repo sync" to update catalog or "bv repo list" to view registered repositories.'
      );
      Halt(1);
    End;

  WriteLn('Found in [' + RepoName + ']: ' + PkgName + ' v' + FoundVer);
  WriteLn('Downloading package: ' + DownloadURL);
  TempZip := GetUserBlaiseVueDir + DirectorySeparator + 'cache' +
             DirectorySeparator + PkgName + '-' + FoundVer + '.zip';
  ForceDir(ExtractFileDir(TempZip));
  Client := TFPHTTPClient.Create(Nil);
  Try
    Try
      Client.AllowRedirect := True;
      Client.Get(DownloadURL, TempZip);
    Except
      on E: Exception Do
            Begin
              WriteLn('Error downloading package: ' + E.Message);
              Halt(1);
            End;
End;
Finally
  Client.Free;
End;

WriteLn('Extracting to user global cache (~/.blaisevue/packages/' + PkgName +
        ')...');
If DirectoryExists(GlobalPath) Then DeleteDir(GlobalPath);
ForceDir(GlobalPath);
ExtractZipSmart(TempZip, GetGlobalPackagesPath, PkgName);
If Not IsGlobal Then
  Begin
    ForceDir(GetCurrentDir + DirectorySeparator + 'lib');
    If DirectoryExists(LibPath) Then DeleteDir(LibPath);
    ForceDir(LibPath);
    CopyDir(GlobalPath, LibPath, []);
    WriteLn('Package "' + PkgName + '" (v' + FoundVer +
            ') installed successfully in lib/' + PkgName + '/.');
    If FileExists(LibPath + DirectorySeparator + 'setup.pas') Then
      Begin
        WriteLn('Executing package setup script...');
        RunSetupScript(PkgName, 'install');
      End;
  End
Else
  Begin
    WriteLn('Global package "' + PkgName + '" (v' + FoundVer +
            ') installed successfully!');
  End;
End;




{ Updates installed packages to their latest compatible SemVer versions (bv lib update). }
Procedure CmdLibUpdate(Const LibName: String = ''; IsGlobal: Boolean = False);

Var 
  TargetBase, PkgDir, CurrentVer, FoundVer, DownloadURL, Checksum, RepoName:


                                                                          string
  ;
  RawArg, TargetRepo, PkgName: string;
  ColonPos: Integer;
  SR: TSearchRec;
  UpdatedCount: Integer;
Begin
  If IsGlobal Then
    TargetBase := GetGlobalPackagesPath
  Else
    TargetBase := GetCurrentDir + DirectorySeparator + 'lib' +
                  DirectorySeparator;

  RawArg := Trim(LibName);
  If RawArg <> '' Then
    Begin
      ColonPos := Pos(':', RawArg);
      If ColonPos > 0 Then
        Begin
          TargetRepo := Trim(Copy(RawArg, 1, ColonPos - 1));
          PkgName := Trim(Copy(RawArg, ColonPos + 1, Length(RawArg) - ColonPos))
          ;
        End
      Else
        Begin
          TargetRepo := '';
          PkgName := RawArg;
        End;

      If (Not IsGlobal) And (TargetRepo = '') And IsOfficialCorePackage(PkgName)
        Then
        Begin
          WriteLn('Package "' + PkgName +


'" is an official core framework package. It updates automatically with BlaiseVue framework updates (bv self-update).'
          );
          Exit;
        End;

      PkgDir := TargetBase + PkgName;
      If Not DirectoryExists(PkgDir) Then
        Begin
          WriteLn('Library "' + PkgName + '" not found in ' + TargetBase +
                  ' to update.');
          Exit;
        End;
      CurrentVer := GetPackageVersionFromFolder(PkgDir);
      If FindPackageInEcosystem(PkgName, 'latest', FoundVer, DownloadURL,
         Checksum, RepoName, TargetRepo) Then
        Begin
          If (CurrentVer <> '') And (CurrentVer = FoundVer) Then
            WriteLn('Package "' + PkgName + '" is already up to date (v' +
                    CurrentVer + ') [' + RepoName + '].')
          Else
            Begin
              WriteLn('Updating "' + PkgName + '" from v' + CurrentVer + ' to v'
                      + FoundVer + ' [' + RepoName + ']...');
              If TargetRepo <> '' Then
                CmdLibInstall(TargetRepo + ':' + PkgName + '@' + FoundVer,
                              IsGlobal)
              Else
                CmdLibInstall(PkgName + '@' + FoundVer, IsGlobal);
            End;
        End
      Else
        Begin
          If TargetRepo <> '' Then
            WriteLn('Package "' + PkgName + '" not found in repository [' +
                    TargetRepo + '].')
          Else
            WriteLn('Package "' + PkgName +
                    '" not found in ecosystem repositories.');
        End;
      Exit;
    End;

  WriteLn('Checking for library updates in ' + TargetBase + '...');
  UpdatedCount := 0;
  If DirectoryExists(TargetBase) And (FindFirst(TargetBase + '*', faDirectory,
     SR) = 0) Then
    Begin
      Repeat
        If (SR.Name <> '.') And (SR.Name <> '..') And ((SR.Attr And faDirectory)
           <> 0) Then
          Begin
            CurrentVer := GetPackageVersionFromFolder(TargetBase + SR.Name);
            If (Not IsGlobal) And IsOfficialCorePackage(SR.Name) Then
              Begin
                WriteLn('  [OK] ' + SR.Name + ' (v' + CurrentVer +
                        ') is an official core package.');
              End
            Else If FindPackageInEcosystem(SR.Name, 'latest', FoundVer,
                    DownloadURL, Checksum, RepoName) Then
                   Begin
                     If (CurrentVer <> '') And (CurrentVer <> FoundVer) Then
                       Begin
                         WriteLn('  [Updating] ' + SR.Name + ': v' + CurrentVer
                                 + ' -> v' + FoundVer);
                         CmdLibInstall(SR.Name + '@' + FoundVer, IsGlobal);
                         Inc(UpdatedCount);
                       End
                     Else
                       WriteLn('  [OK] ' + SR.Name + ' (v' + CurrentVer +
                               ') is up to date.');
                   End;
          End;
      Until FindNext(SR) <> 0;
      FindClose(SR);
    End;
  If UpdatedCount = 0 Then
    WriteLn('All libraries are up to date!')
  Else
    WriteLn(IntToStr(UpdatedCount) + ' library(ies) updated successfully!');
End;




{ Checks if newer versions of installed packages are available in registered repositories (bv lib outdated). }
Procedure CmdLibOutdated(IsGlobal: Boolean = False);

Var 
  TargetBase, InstalledVer, FoundVer, DownloadURL, Checksum, RepoName, RowStatus
  : string;
  SR: TSearchRec;
  TotalCount, OutdatedCount: Integer;
  IsCore: Boolean;
Begin
  If IsGlobal Then
    TargetBase := GetGlobalPackagesPath
  Else
    TargetBase := GetCurrentDir + DirectorySeparator + 'lib' +
                  DirectorySeparator;

  WriteLn('');
  WriteLn('=== Package Version Inspection (bv lib outdated) ===');
  If IsGlobal Then
    WriteLn('Scope: User Global Cache (~/.blaisevue/packages)')
  Else
    WriteLn('Scope: Local Project (/lib)');
  WriteLn(StringOfChar('-', 78));
  WriteLn(PadRight('Package', 22), PadRight('Installed', 14), PadRight('Latest',
                                                                       16),
  PadRight('Status', 26));
  WriteLn(StringOfChar('-', 78));
  TotalCount := 0;
  OutdatedCount := 0;
  If DirectoryExists(TargetBase) And (FindFirst(TargetBase + '*', faDirectory,
     SR) = 0) Then
    Begin
      Repeat
        If (SR.Name <> '.') And (SR.Name <> '..') And ((SR.Attr And faDirectory)
           <> 0) Then
          Begin
            Inc(TotalCount);
            InstalledVer := GetPackageVersionFromFolder(TargetBase + SR.Name);
            IsCore := (Not IsGlobal) And IsOfficialCorePackage(SR.Name);
            If IsCore Then
              Begin
                If InstalledVer = '' Then InstalledVer := '0.1.0';
                FoundVer := InstalledVer;
                WriteLn(PadRight(SR.Name, 22), PadRight('v' + InstalledVer, 14),
                PadRight('v' + FoundVer, 16), 'Official Core (Up to date)');
              End
            Else
              Begin
                If InstalledVer = '' Then InstalledVer := 'unknown';
                If FindPackageInEcosystem(SR.Name, 'latest', FoundVer,
                   DownloadURL, Checksum, RepoName) Then
                  Begin
                    If (InstalledVer <> 'unknown') And (InstalledVer <> FoundVer
                       ) Then
                      Begin
                        Inc(OutdatedCount);
                        RowStatus := 'Outdated -> v' + FoundVer;
                        WriteLn(PadRight(SR.Name, 22), PadRight('v' +
                                                                InstalledVer, 14
                        ), PadRight('v' + FoundVer, 16), RowStatus);
                      End
                    Else
                      Begin
                        WriteLn(PadRight(SR.Name, 22), PadRight('v' +
                                                                InstalledVer, 14
                        ), PadRight('v' + FoundVer, 16), 'Up to date');
                      End;
                  End
                Else
                  Begin
                    WriteLn(PadRight(SR.Name, 22), PadRight('v' + InstalledVer,
                                                            14), PadRight('-',
                                                                          16),
                    'Not registered in catalog');
                  End;
              End;
          End;
      Until FindNext(SR) <> 0;
      FindClose(SR);
    End;

  WriteLn(StringOfChar('-', 78));
  If TotalCount = 0 Then
    WriteLn('No packages installed in current scope.')
  Else If OutdatedCount = 0 Then
         WriteLn('All ' + IntToStr(TotalCount) + ' package(s) are up to date!')
  Else
    Begin
      WriteLn(IntToStr(OutdatedCount) + ' of ' + IntToStr(TotalCount) +
      ' package(s) are outdated.');
      If IsGlobal Then
        WriteLn('To update, run: bv lib update --global')
      Else
        WriteLn('To update, run: bv lib update');
    End;
  WriteLn('');
End;




{ Searches registered package repositories for packages matching a query (bv lib search). }
Procedure CmdLibSearch(Const Query: String);

Var 
  CacheDir, CacheFile, RawJson, PkgKey, PkgDesc, PkgLatest, PkgAuthor,
  QueryLower: string;
  TargetRepo, SearchTerm, RepoName: string;
  ColonPos: Integer;
  SR: TSearchRec;
  Parser: TJSONParser;
  Data: TJSONData;
  RootObj, PackagesObj, PkgObj: TJSONObject;
  i, MatchCount: Integer;
Begin
  QueryLower := LowerCase(Trim(Query));
  TargetRepo := '';
  SearchTerm := QueryLower;
  ColonPos := Pos(':', QueryLower);
  If ColonPos > 0 Then
    Begin
      TargetRepo := Trim(Copy(QueryLower, 1, ColonPos - 1));
      SearchTerm := Trim(Copy(QueryLower, ColonPos + 1, Length(QueryLower) -
                    ColonPos));
    End;

  WriteLn('');
  WriteLn('=== Package Search in BlaiseVue Ecosystem ===');
  If TargetRepo <> '' Then
    Begin
      If SearchTerm <> '' Then
        WriteLn('Filter: repo="' + TargetRepo + '", term="' + SearchTerm + '"')
      Else
        WriteLn('Filter: repository "' + TargetRepo + '"');
    End
  Else If SearchTerm <> '' Then
         WriteLn('Filter: "' + SearchTerm + '"')
  Else
    WriteLn('Listing all available ecosystem packages:');
  WriteLn(StringOfChar('-', 65));
  CacheDir := ExtractFileDir(GetReposConfigPath) + DirectorySeparator + 'cache';
  If Not DirectoryExists(CacheDir) Then
    CmdRepoSync;

  MatchCount := 0;
  If FindFirst(CacheDir + DirectorySeparator + '*-ecosystem.json', faAnyFile, SR
     ) = 0 Then
    Begin
      Repeat
        If (SR.Name <> '.') And (SR.Name <> '..') Then
          Begin
            CacheFile := CacheDir + DirectorySeparator + SR.Name;
            RawJson := ReadFileToString(CacheFile);
            If Trim(RawJson) <> '' Then
              Begin
                Parser := TJSONParser.Create(RawJson, True);
                Try
                  Try
                    Data := Parser.Parse;
                    If Assigned(Data) And (Data.JSONType = jtObject) Then
                      Begin
                        RootObj := TJSONObject(Data);
                        RepoName := RootObj.Get('name', StringReplace(SR.Name,
                                    '-ecosystem.json', '', [rfReplaceAll]));
                        If (TargetRepo = '') Or SameText(TargetRepo, RepoName)
                           Or SameText(TargetRepo, StringReplace(SR.Name,
                           '-ecosystem.json', '', [rfReplaceAll])) Then
                          Begin
                            PackagesObj := RootObj.Get('packages', TJSONObject(
                                           Nil));
                            If Assigned(PackagesObj) Then
                              Begin
                                For i := 0 To PackagesObj.Count - 1 Do
                                  Begin
                                    PkgKey := PackagesObj.Names[i];
                                    PkgObj := TJSONObject(PackagesObj.Items[i]);
                                    PkgDesc := PkgObj.Get('description', '');
                                    PkgLatest := PkgObj.Get('latest', '');
                                    PkgAuthor := PkgObj.Get('author', '');




                     // Ignore third-party packages claiming reserved core names
                                    If (Not SameText(RepoName, 'official')) And
                                       IsReservedCorePackageName(PkgKey) Then
                                      Continue;

                                    If (SearchTerm = '') Or (Pos(SearchTerm,
                                       LowerCase(PkgKey)) > 0) Or
                                       (Pos(SearchTerm, LowerCase(PkgDesc)) > 0)
                                      Then
                                      Begin
                                        Inc(MatchCount);
                                        WriteLn('  * [' + RepoName + '] ' +
                                                PkgKey + ' (v' + PkgLatest + ')'
                                        );
                                        If PkgDesc <> '' Then
                                          WriteLn('    Description: ' + PkgDesc)
                                        ;
                                        If PkgAuthor <> '' Then
                                          WriteLn('    Author:      ', PkgAuthor
                                          );
                                        WriteLn('');
                                      End;
                                  End;
                              End;
                          End;
                      End;
                    If Assigned(Data) Then Data.Free;
                  Except
              End;
          Finally
            Parser.Free;
      End;
    End;
End;
Until FindNext(SR) <> 0;
FindClose(SR);
End;

If MatchCount = 0 Then
  WriteLn('  No packages found matching search criteria.')
Else
  WriteLn(IntToStr(MatchCount),
  ' package(s) found. To install, run: bv lib install [<repo>:]<name>');
WriteLn(StringOfChar('-', 65));
End;




{ Packages a local library into a distributable release ZIP archive (bv lib pack). }
Procedure CmdLibPack(Const TargetDir: String; SkipTests: Boolean);

Var 
  BaseDir, PkgJsonFile, PkgName, PkgVersion, DistDir, ZipFile, ChecksumFile:


                                                                          string
  ;
  Zip: TZipper;
  HashStr, JsonStr, PkgFolder: string;
  FileSizeKB: Double;
  ExitCode: Integer;
  FS: TFileStream;
  JData: TJSONData;
  JObj: TJSONObject;
{ Recursively compresses a folder tree into a ZIP archive file. }
Procedure AddDirectoryToZip(Const RootDir, SubDir: String);

Var 
  SR: TSearchRec;
  CurrentPath, EntryDisk, EntryArchive, Ext: string;
Begin
  CurrentPath := RootDir;
  If SubDir <> '' Then
    CurrentPath := CurrentPath + StringReplace(SubDir, '/', DirectorySeparator,
                   [rfReplaceAll]) + DirectorySeparator;
  If FindFirst(CurrentPath + '*', faAnyFile, SR) = 0 Then
    Begin
      Repeat
        If (SR.Name <> '.') And (SR.Name <> '..') And (SR.Name <> '.git') And (
           SR.Name <> 'node_modules') Then
          Begin
            If (SR.Attr And faDirectory) <> 0 Then
              Begin
                If SubDir = '' Then
                  AddDirectoryToZip(RootDir, SR.Name)
                Else
                  AddDirectoryToZip(RootDir, SubDir + '/' + SR.Name);
              End
            Else
              Begin
                Ext := LowerCase(ExtractFileExt(SR.Name));
                If (Ext <> '.o') And (Ext <> '.ppu') And (Ext <> '.tmp') And (
                   Ext <> '.exe') Then
                  Begin
                    EntryDisk := CurrentPath + SR.Name;
                    If SubDir = '' Then
                      EntryArchive := PkgFolder + '/' + SR.Name
                    Else
                      EntryArchive := PkgFolder + '/' + SubDir + '/' + SR.Name;
                    Zip.Entries.AddFileEntry(EntryDisk, EntryArchive);
                  End;
              End;
          End;
      Until FindNext(SR) <> 0;
      FindClose(SR);
    End;
End;
Begin
  BaseDir := TargetDir;
  If BaseDir = '' Then BaseDir := GetCurrentDir;
  BaseDir := IncludeTrailingPathDelimiter(ExpandFileName(BaseDir));
  PkgJsonFile := BaseDir + 'package.json';
  If Not FileExists(PkgJsonFile) Then
    Begin
      WriteLn('ERROR: package.json not found in ' + BaseDir);
      WriteLn(


'Ensure you are running "bv lib pack" inside a valid BlaiseVue library directory.'
      );
      Halt(1);
    End;

  PkgName := ExtractFileName(ExcludeTrailingPathDelimiter(BaseDir));
  PkgVersion := '1.0.0';
  Try
    JsonStr := ReadFileToString(PkgJsonFile);
    JData := GetJSON(JsonStr);
    Try
      If JData is TJSONObject Then
        Begin
          JObj := TJSONObject(JData);
          If JObj.IndexOfName('name') >= 0 Then PkgName := JObj.Get('name',
                                                           PkgName);
          If JObj.IndexOfName('version') >= 0 Then PkgVersion := JObj.Get(
                                                                 'version',
                                                                 PkgVersion);
        End;
    Finally
      JData.Free;
End;
Except
End;

PkgFolder := PkgName;
If IsReservedCorePackageName(PkgName) Then
  Begin
    WriteLn('WARNING: Package name "' + PkgName +
            '" matches a reserved BlaiseVue Core framework name.');
    WriteLn(


       'Third-party repositories will reject packages with reserved core names.'
    );
  End;

If Not SkipTests Then
  Begin
    If DirectoryExists(BaseDir + 'tests') Then
      Begin
        WriteLn('=== [Pre-flight] Running Automated Tests for ' + PkgName +
                ' ===');
      {$IFDEF WINDOWS}
        ExitCode := ExecuteProcess('cmd', '/c cd /d "' + BaseDir + '" && "' +
                    GetOwnExecutablePath + '" test');
      {$ELSE}
        ExitCode := ExecuteProcess('/bin/sh', ['-c', 'cd "' + BaseDir +
                    '" && exec "' + GetOwnExecutablePath + '" test']);
      {$ENDIF}
        If ExitCode <> 0 Then
          Begin
            WriteLn('');
            WriteLn('ERROR: Pre-flight tests failed with exit code ' + IntToStr(
                    ExitCode) + '!');
            WriteLn('Packaging aborted to prevent releasing a broken package.');
            WriteLn(


        'Hint: Fix test failures or pass "--skip-tests" to bypass verification.'
            );
            Halt(1);
          End;
        WriteLn('[+] Pre-flight tests passed successfully!');
        WriteLn('');
      End
    Else
      WriteLn('Notice: No tests/ directory found. Skipping automated tests.');
  End
Else
  WriteLn('Notice: Pre-flight tests skipped via --skip-tests.');

DistDir := BaseDir + 'dist' + DirectorySeparator;
ForceDir(DistDir);
ZipFile := DistDir + PkgName + '-' + PkgVersion + '.zip';
If FileExists(ZipFile) Then DeleteFile(ZipFile);
WriteLn('Assembling release artifact: ' + ExtractFileName(ZipFile) + ' ...');
Zip := TZipper.Create;
Try
  Zip.FileName := ZipFile;

  // Add root metadata files
  Zip.Entries.AddFileEntry(PkgJsonFile, PkgFolder + '/package.json');
  If FileExists(BaseDir + 'README.md') Then
    Zip.Entries.AddFileEntry(BaseDir + 'README.md', PkgFolder + '/README.md');
  If FileExists(BaseDir + 'LICENSE') Then
    Zip.Entries.AddFileEntry(BaseDir + 'LICENSE', PkgFolder + '/LICENSE');
  If FileExists(BaseDir + 'setup.pas') Then
    Zip.Entries.AddFileEntry(BaseDir + 'setup.pas', PkgFolder + '/setup.pas');

  // Add src/ directory recursively
  If DirectoryExists(BaseDir + 'src') Then
    AddDirectoryToZip(BaseDir, 'src');

  // Add styles/ directory recursively
  If DirectoryExists(BaseDir + 'styles') Then
    AddDirectoryToZip(BaseDir, 'styles');

  Zip.ZipAllFiles;
Finally
  Zip.Free;
End;

If Not FileExists(ZipFile) Then
  Begin
    WriteLn('ERROR: Failed to create archive: ' + ZipFile);
    Halt(1);
  End;

// Compute SHA-256
HashStr := FileSHA256(ZipFile);
ChecksumFile := ZipFile + '.sha256';
WriteStringToFile(ChecksumFile, HashStr + ' *' + ExtractFileName(ZipFile) + #10)
;
FileSizeKB := 0;
FS := TFileStream.Create(ZipFile, fmOpenRead Or fmShareDenyNone);
Try
  FileSizeKB := FS.Size / 1024.0;
Finally
  FS.Free;
End;

WriteLn('');
WriteLn('============================================================');
WriteLn('  📦 BlaiseVue Library Packager');
WriteLn('============================================================');
WriteLn('  Package:     ' + PkgName + ' @ v' + PkgVersion);
WriteLn('  Archive:     dist/' + ExtractFileName(ZipFile));
WriteLn('  Size:        ' + FloatToStrF(FileSizeKB, ffFixed, 8, 2) + ' KB');
WriteLn('  SHA-256:     ' + HashStr);
WriteLn('  Checksum:    dist/' + ExtractFileName(ChecksumFile));
WriteLn('============================================================');
WriteLn('🎉 Package successfully assembled and verified!');
WriteLn('');
WriteLn('Installation commands for consumers:');
WriteLn('  bv lib install https://github.com/<org>/' + PkgName +
        '/releases/download/v' + PkgVersion + '/' + ExtractFileName(ZipFile));
WriteLn('  bv lib install ./dist/' + ExtractFileName(ZipFile));
WriteLn('');
End;

