           CmdClean;
         End

  Else If Cmd = 'test' Then
         Begin
           If (ParamCount >= 2) And (LowerCase(ParamStr(2)) = 'e2e') Then
             CmdTestE2E
           Else
             Begin
               CurP := '';
               PkgNameArg := '';
               SkipTest := False;
               // Reused as IsSdkMode
               SkipTestsArg := False;
               // Reused as NoCache
               For i := 2 To ParamCount Do
                 Begin
                   NameArg := LowerCase(Trim(ParamStr(i)));
                   If NameArg = '--sdk' Then
                     SkipTest := True
                   Else If (NameArg = '--no-cache') Or (NameArg = '--fresh')
                          Then
                          SkipTestsArg := True
                   Else If Copy(ParamStr(i), 1, 1) <> '-' Then
                          Begin
                            If CurP = '' Then
                              CurP := ParamStr(i)
                            Else If PkgNameArg = '' Then
                                   PkgNameArg := ParamStr(i);
                          End;
                 End;
               If SkipTest Then
                 CmdTestSDK(CurP, PkgNameArg, SkipTestsArg)
               Else
                 CmdTest(CurP, SkipTestsArg);
             End;
         End

  Else If Cmd = 'build' Then
         Begin
           If ParamCount >= 2 Then
             Begin
               If LowerCase(ParamStr(2)) = '--release' Then
                 CmdRunBuild
               Else
                 Begin
                   WriteLn('Unknown build option: ', ParamStr(2));
