                       '<title>' + RealProjectName + '</title>', [rfReplaceAll])
            ;
            WriteStringToFile(Base + 'public' + DirectorySeparator +
                              'index.html', Content);
          End;

        // Customize mobile capacitor.config.json & purge stale demo binaries
        LazCleanName := '';
        For i := 1 To Length(RealProjectName) Do
          If RealProjectName[i] In ['a'..'z', 'A'..'Z', '0'..'9'] Then
            LazCleanName := LazCleanName + LowerCase(RealProjectName[i]);
        If LazCleanName = '' Then LazCleanName := 'app';
        If LazCleanName[1] In ['0'..'9'] Then LazCleanName := 'app' +
                                                              LazCleanName;

        If FileExists(Base + 'capacitor.config.json') Then
          Begin
            Content := ReadFileToString(Base + 'capacitor.config.json');
            Content := StringReplace(Content, 'com.blaisevue.demoapp',
                       'com.blaisevue.' + LazCleanName, [rfReplaceAll]);
            Content := StringReplace(Content, 'BlaiseVue Demo', RealProjectName,
                       [rfReplaceAll]);
            WriteStringToFile(Base + 'capacitor.config.json', Content);
          End;

        If DirectoryExists(Base + 'mobile' + DirectorySeparator + 'bin') Then
          DeleteDir(Base + 'mobile' + DirectorySeparator + 'bin');
        If DirectoryExists(Base + 'mobile' + DirectorySeparator + 'android')
          Then
          DeleteDir(Base + 'mobile' + DirectorySeparator + 'android');

