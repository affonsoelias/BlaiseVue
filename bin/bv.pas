{ Creates a directory path recursively, including any missing parent folders. }
Procedure ForceDir(Const D: String);
Begin
  If Not DirectoryExists(D) Then
    ForceDirectories(D);
End;

{ Recursively deletes a directory, all its subdirectories, and files. }
Procedure DeleteDir(Path: String);

Var 
  SR: TSearchRec;
Begin
  If Path[Length(Path)] <> DirectorySeparator Then Path := Path +
                                                           DirectorySeparator;
  If FindFirst(Path + '*', faAnyFile, SR) = 0 Then
    Begin
      Repeat

        If (SR.Name <> '.') And (SR.Name <> '..') Then
          Begin
            If (SR.Attr And faDirectory) <> 0 Then
              DeleteDir(Path + SR.Name)

            Else
              DeleteFile(Path + SR.Name);
          End;

      Until FindNext(SR) <> 0;
      FindClose(SR);
    End;

  RemoveDir(Path);
End;

{ Recursively computes total directory size in bytes. }
Function GetDirSizeBytes(Const DirPath: String): Int64;

Var 
  SR: TSearchRec;
  P: string;
Begin
  Result := 0;
  P := IncludeTrailingPathDelimiter(DirPath);
  If FindFirst(P + '*', faAnyFile, SR) = 0 Then
    Begin
      Try
        Repeat
          If (SR.Name <> '.') And (SR.Name <> '..') Then
            Begin
              If (SR.Attr And faDirectory) <> 0 Then
                Inc(Result, GetDirSizeBytes(P + SR.Name))
              Else
                Inc(Result, SR.Size);
            End;
        Until FindNext(SR) <> 0;
      Finally
        FindClose(SR);
    End;
End;
End;

{ Formats a byte count into a human-readable string (KB, MB, GB). }
Function FormatFileSizeMB(Bytes: Int64): string;
Begin
  If Bytes < 1024 Then
    Result := IntToStr(Bytes) + ' B'
  Else If Bytes < 1024 * 1024 Then
         Result := Format('%.1f KB', [Bytes / 1024.0])
  Else If Bytes < 1024 * 1024 * 1024 Then
         Result := Format('%.1f MB', [Bytes / (1024.0 * 1024.0)])
  Else
    Result := Format('%.2f GB', [Bytes / (1024.0 * 1024.0 * 1024.0)]);
End;




{ Reads and returns the entire contents of a text file as an Object Pascal string. }
Function ReadFileToString(Const FileName: String): string;

Var 
  SL: TStringList;
Begin
  SL := TStringList.Create;
  Try

    SL.LoadFromFile(FileName);
    Result := SL.Text;

  Finally

