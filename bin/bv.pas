Function ComputeTextHash(Const S: String): string;

Var 
  H: DWord;
  I: Integer;
Begin
  H := 2166136261;
  For I := 1 To Length(S) Do
    Begin
      H := H xor Ord(S[I]);
      H := DWord(QWord(H) * 16777619);
    End;
  Result := LowerCase(IntToHex(H, 8));
End;

