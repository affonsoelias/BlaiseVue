Procedure CmdNewComponent(Const CompName: String; CreateTest: Boolean = True;
                          Const UseDelSafe: Boolean = False);

Var 
  CompPath, TargetPath, Content: string;
  TestPath, TestFile, TestContent, CompTag: string;
Begin
  RequireBlaiseVueProject('bv g c');
  CompPath := GetCurrentDir + DirectorySeparator + 'src' + DirectorySeparator +
              'components' + DirectorySeparator;
  TargetPath := CompPath + CompName + '.bv';
  If FileExists(TargetPath) Then
    Begin
      WriteLn('ERROR: Component "', CompName, '.bv" already exists!');
      Halt(1);
    End;

  ForceDir(CompPath);
  CompTag := PascalToKebab(CompName);
  If UseDelSafe Then
    Content := '<template>' + #10 +
               '  <div class="' + CompTag + '">' + #10 +
               '    <h3>{{ title }}</h3>' + #10 +
               '    <p>{{ greeting() }}</p>' + #10 +
               '  </div>' + #10 +
               '</template>' + #10#10 +
               '<script lang="delsafe">' + #10 +
               '  data:' + #10 +
               '    title: string = ''' + CompName + ''';' + #10#10 +
               '  methods:' + #10 +
               '    function greeting() return String is' + #10 +
               '    begin' + #10 +
               '      return "Powered by DelSafe";' + #10 +
               '    end greeting;' + #10 +
               '</script>' + #10#10 +
               '<style>' + #10 +
               '  .' + CompTag +
            ' { padding: 12px; border: 1px solid #3498db; border-radius: 6px; }'
               + #10 +
               '</style>' + #10
  Else
    Begin
      Content := GetTemplate('TPL_COMPONENT_BV', 'component.bv');
      Content := StringReplace(Content, '{{COMP_NAME}}', CompName, [rfReplaceAll
                 ]);
    End;
  WriteStringToFile(TargetPath, Content);
  WriteLn('Component created: src/components/', CompName, '.bv');
  WriteLn('HTML Tag: <', CompTag, '>');
  If CreateTest Then
    Begin
      TestPath := GetCurrentDir + DirectorySeparator + 'tests' +
                  DirectorySeparator + 'components' + DirectorySeparator;
      TestFile := TestPath + CompName + '.test.pas';
      If Not FileExists(TestFile) Then
        Begin
          ForceDir(TestPath);
          TestContent := GetTemplate('TPL_COMPONENT_TEST_PAS',
                         'component_test.pas');
          If TestContent = '' Then
            Begin
              TestContent := 

                             'program ' + LowerCase(CompName) + '_test;' + #10#10 +

                             '{$mode objfpc}' + #10#10 +

                             'uses JS, Web, BVTestUtils, u' + CompName + ';' + #10#10 +

                             'var' + #10 +

                             '  Wrapper: TWrapper;' + #10#10 +

                             'begin' + #10 +

                             '  Register_u' + CompName + ';' + #10#10 +

                             '  Describe(''Component: ' + CompName +
                             ''', procedure' + #10 +

                             '    begin' + #10 +




            '       It(''deve montar o componente no DOM sem erros'', procedure'
                             + #10 +

                             '         begin' + #10 +

                             '            Wrapper := Mount(''' + CompTag +
                             ''');' + #10 +




                        '            Expect(Wrapper.Element <> nil).ToBe(True);'
                             + #10 +

                             '         end);' + #10 +

                             '    end);' + #10 +

                             'end.' + #10;
            End

          Else
            Begin
              TestContent := StringReplace(TestContent, '{{TEST_NAME}}',
                             LowerCase(CompName), [rfReplaceAll]);
              TestContent := StringReplace(TestContent, '{{COMP_NAME}}',
                             CompName, [rfReplaceAll]);
              TestContent := StringReplace(TestContent, '{{COMP_TAG}}', CompTag,
                             [rfReplaceAll]);
            End;

          WriteStringToFile(TestFile, TestContent);
          WriteLn('Test created: tests/components/', CompName, '.test.pas');
        End;
    End;
End;

