Function ParseJavaVersionMajor(Const OutputStr: String; out FullVer: String):


                                                                         Integer
;

Var 
  P1, P2: Integer;
  VerStr, MajorStr: string;
Begin
  Result := 0;
  FullVer := '';
  VerStr := '';
  P1 := Pos('"', OutputStr);
  If P1 > 0 Then
    Begin
      P2 := PosEx('"', OutputStr, P1 + 1);
      If P2 > P1 Then
        VerStr := Copy(OutputStr, P1 + 1, P2 - P1 - 1);
    End;
  If VerStr = '' Then
    Begin
      P1 := Pos('version ', LowerCase(OutputStr));
      If P1 > 0 Then
        Begin
          VerStr := Trim(Copy(OutputStr, P1 + 8, 20));
          If Pos(' ', VerStr) > 0 Then
            VerStr := Copy(VerStr, 1, Pos(' ', VerStr) - 1);
        End
      Else
        VerStr := Trim(OutputStr);
    End;
  FullVer := VerStr;
  If Copy(VerStr, 1, 2) = '1.' Then
    VerStr := Copy(VerStr, 3, MaxInt);
  P1 := Pos('.', VerStr);
  If P1 > 0 Then
    MajorStr := Copy(VerStr, 1, P1 - 1)
  Else
    Begin
      P1 := Pos('-', VerStr);
      If P1 > 0 Then
        MajorStr := Copy(VerStr, 1, P1 - 1)
      Else
        MajorStr := VerStr;
    End;
  Result := StrToIntDef(MajorStr, 0);
End;

Function ProbeJavaCandidate(Const CandidateDir: String; out OutVer: String; out
                            MajorVer: Integer): Boolean;

Var 
  ExePath, OutText: string;
Begin
  Result := False;
  OutVer := '';
  MajorVer := 0;
  If (CandidateDir = '') Or Not DirectoryExists(CandidateDir) Then Exit;

  ExePath := ExcludeTrailingPathDelimiter(CandidateDir) + DirectorySeparator +
             'bin' + DirectorySeparator + 'java' + {$IFDEF WINDOWS}'.exe'{$ELSE}
             ''{$ENDIF};
  If Not FileExists(ExePath) Then Exit;

  If ExecCmdCapture('"' + ExePath + '" -version 2>&1', OutText) And (OutText <>
     '') Then
    Begin
      MajorVer := ParseJavaVersionMajor(OutText, OutVer);
      If MajorVer > 0 Then
        Result := True;
    End;
End;

Procedure CheckSingleJdkDir(Const CandDir, LabelDesc: String; Var BestHome,
                            BestVer, BestDesc: String; Var BestMajor: Integer;
                            Var FallbackHome, FallbackVer, FallbackDesc: String;
                            Var FallbackMajor: Integer);

Var 
  OutVer: string;
  Major: Integer;
Begin
  If (CandDir = '') Or Not DirectoryExists(CandDir) Then Exit;
  If ProbeJavaCandidate(CandDir, OutVer, Major) Then
    Begin
      If (Major >= 17) And (Major <= 21) Then
        Begin
          If (BestMajor = 0) Or (Major = 17) Then
            Begin
              BestHome := ExcludeTrailingPathDelimiter(CandDir);
              BestVer := OutVer;
              BestDesc := LabelDesc;
              BestMajor := Major;
            End;
        End
      Else If FallbackMajor = 0 Then
             Begin
               FallbackHome := ExcludeTrailingPathDelimiter(CandDir);
               FallbackVer := OutVer;
               FallbackDesc := LabelDesc;
               FallbackMajor := Major;
             End;
    End;
End;

Procedure ScanJdkDirectory(Const BaseDir: String; Var BestHome, BestVer,
                           BestDesc: String; Var BestMajor: Integer; Var
                           FallbackHome, FallbackVer, FallbackDesc: String; Var
                           FallbackMajor: Integer);

Var 
  SR: TSearchRec;
  CandDir, OutVer: string;
  Major: Integer;
Begin
  If Not DirectoryExists(BaseDir) Then Exit;
  If FindFirst(IncludeTrailingPathDelimiter(BaseDir) + '*', faDirectory, SR) = 0
    Then
    Begin
      Try
        Repeat
          If (SR.Name <> '.') And (SR.Name <> '..') And ((SR.Attr And
             faDirectory) <> 0) Then
            Begin
              CandDir := IncludeTrailingPathDelimiter(BaseDir) + SR.Name;
              If ProbeJavaCandidate(CandDir, OutVer, Major) Then
                Begin
                  If (Major >= 17) And (Major <= 21) Then
                    Begin
                      If (BestMajor = 0) Or (Major = 17) Then
                        Begin
                          BestHome := CandDir;
                          BestVer := OutVer;
                          BestDesc := SR.Name;
                          BestMajor := Major;
                        End;
                    End
                  Else If FallbackMajor = 0 Then
                         Begin
                           FallbackHome := CandDir;
                           FallbackVer := OutVer;
                           FallbackDesc := SR.Name;
                           FallbackMajor := Major;
                         End;
                End;
            End;
        Until FindNext(SR) <> 0;
      Finally
        FindClose(SR);
    End;
End;
End;

Function FindBestJavaHome(out JavaHome, JavaVer, SourceDesc: String): Boolean;

Var 
  BestHome, BestVer, BestDesc: string;
  FallbackHome, FallbackVer, FallbackDesc: string;
  BestMajor, FallbackMajor: Integer;
  EnvJava, WhereOut, FirstLine, CandDir: string;
Begin
  JavaHome := '';
  JavaVer := '';
  SourceDesc := '';
  BestHome := '';
  BestVer := '';
  BestDesc := '';
  FallbackHome := '';
  FallbackVer := '';
  FallbackDesc := '';
  BestMajor := 0;
  FallbackMajor := 0;
  Result := False;

  // 1. Check JAVA_HOME environment variable
  EnvJava := GetEnvironmentVariable('JAVA_HOME');
  If EnvJava <> '' Then
    CheckSingleJdkDir(EnvJava, 'JAVA_HOME (' + EnvJava + ')', BestHome, BestVer,
                      BestDesc, BestMajor, FallbackHome, FallbackVer,
                      FallbackDesc, FallbackMajor);

  // 2. Check Java in system PATH
  {$IFDEF WINDOWS}
  If ExecCmdCapture('where.exe java 2>nul', WhereOut) And (WhereOut <> '') Then
    Begin
      FirstLine := Trim(Copy(WhereOut, 1, Pos(#10, WhereOut + #10) - 1));
      FirstLine := Trim(StringReplace(FirstLine, #13, '', [rfReplaceAll]));
      If FileExists(FirstLine) Then
        Begin
          CandDir := ExtractFileDir(ExtractFileDir(FirstLine));
          CheckSingleJdkDir(CandDir, 'system PATH (' + CandDir + ')', BestHome,
                            BestVer, BestDesc, BestMajor, FallbackHome,
                            FallbackVer, FallbackDesc, FallbackMajor);
        End;
    End;
  {$ELSE}
  If ExecCmdCapture('which java 2>/dev/null', WhereOut) And (WhereOut <> '')
    Then
    Begin
      FirstLine := Trim(Copy(WhereOut, 1, Pos(#10, WhereOut + #10) - 1));
      If FileExists(FirstLine) Then
        Begin
          CandDir := ExtractFileDir(ExtractFileDir(FirstLine));
          CheckSingleJdkDir(CandDir, 'system PATH (' + CandDir + ')', BestHome,
                            BestVer, BestDesc, BestMajor, FallbackHome,
                            FallbackVer, FallbackDesc, FallbackMajor);
        End;
    End;
  {$ENDIF}

  // 3. Scan common vendor JDK directories on Windows
  {$IFDEF WINDOWS}
  ScanJdkDirectory('C:\Program Files\Eclipse Adoptium', BestHome, BestVer,
                   BestDesc, BestMajor, FallbackHome, FallbackVer, FallbackDesc,
                   FallbackMajor);
  ScanJdkDirectory('C:\Program Files\Java', BestHome, BestVer, BestDesc,
                   BestMajor, FallbackHome, FallbackVer, FallbackDesc,
                   FallbackMajor);
  ScanJdkDirectory('C:\Program Files\Microsoft', BestHome, BestVer, BestDesc,
                   BestMajor, FallbackHome, FallbackVer, FallbackDesc,
                   FallbackMajor);
  ScanJdkDirectory('C:\Program Files\Zulu', BestHome, BestVer, BestDesc,
                   BestMajor, FallbackHome, FallbackVer, FallbackDesc,
                   FallbackMajor);
  ScanJdkDirectory('C:\Program Files\BellSoft\LibericaJDK', BestHome, BestVer,
                   BestDesc, BestMajor, FallbackHome, FallbackVer, FallbackDesc,
                   FallbackMajor);

  // 4. Check Android Studio bundled JBR (Windows)
  CheckSingleJdkDir('C:\Program Files\Android\Android Studio\jbr',
                    'Android Studio JBR', BestHome, BestVer, BestDesc, BestMajor
                    , FallbackHome, FallbackVer, FallbackDesc, FallbackMajor);
  EnvJava := GetEnvironmentVariable('LOCALAPPDATA');
  If EnvJava <> '' Then
    CheckSingleJdkDir(EnvJava + '\Programs\Android Studio\jbr',
                      'Android Studio JBR (Local)', BestHome, BestVer, BestDesc,
                      BestMajor, FallbackHome, FallbackVer, FallbackDesc,
                      FallbackMajor);
  {$ELSE}
    {$IFDEF DARWIN}
  CheckSingleJdkDir(


                   '/Applications/Android Studio.app/Contents/jbr/Contents/Home'
                    , 'Android Studio JBR (macOS)', BestHome, BestVer, BestDesc,
                    BestMajor, FallbackHome, FallbackVer, FallbackDesc,
                    FallbackMajor);
  ScanJdkDirectory('/Library/Java/JavaVirtualMachines', BestHome, BestVer,
                   BestDesc, BestMajor, FallbackHome, FallbackVer, FallbackDesc,
                   FallbackMajor);
    {$ELSE}
  ScanJdkDirectory('/usr/lib/jvm', BestHome, BestVer, BestDesc, BestMajor,
                   FallbackHome, FallbackVer, FallbackDesc, FallbackMajor);
  CheckSingleJdkDir('/opt/android-studio/jbr', 'Android Studio JBR (/opt)',
                    BestHome, BestVer, BestDesc, BestMajor, FallbackHome,
                    FallbackVer, FallbackDesc, FallbackMajor);
  EnvJava := GetEnvironmentVariable('HOME');
  If EnvJava <> '' Then
    CheckSingleJdkDir(EnvJava +
                      '/.local/share/JetBrains/Toolbox/apps/android-studio/jbr',
                      'Android Studio JBR (Toolbox)', BestHome, BestVer,
                      BestDesc, BestMajor, FallbackHome, FallbackVer,
                      FallbackDesc, FallbackMajor);
    {$ENDIF}
  {$ENDIF}

  If BestMajor > 0 Then
    Begin
      JavaHome := BestHome;
      JavaVer := BestVer;
      SourceDesc := BestDesc;
      Result := True;
    End
  Else If FallbackMajor > 0 Then
         Begin
           JavaHome := FallbackHome;
           JavaVer := FallbackVer;
           SourceDesc := FallbackDesc;
           Result := True;
         End;
End;

Function FindAndroidSdkPath: string;

Var 
  EnvHome, LocalApp: string;
Begin
  Result := '';
  EnvHome := GetEnvironmentVariable('ANDROID_HOME');
  If (EnvHome <> '') And DirectoryExists(EnvHome) Then Exit(


                                                    ExcludeTrailingPathDelimiter
                                                            (EnvHome));

  EnvHome := GetEnvironmentVariable('ANDROID_SDK_ROOT');
  If (EnvHome <> '') And DirectoryExists(EnvHome) Then Exit(


                                                    ExcludeTrailingPathDelimiter
                                                            (EnvHome));

  {$IFDEF WINDOWS}
  LocalApp := GetEnvironmentVariable('LOCALAPPDATA');
  If (LocalApp <> '') And DirectoryExists(LocalApp + '\Android\Sdk') Then
    Exit(LocalApp + '\Android\Sdk');
  {$ELSE}
  LocalApp := GetEnvironmentVariable('HOME');
  If LocalApp <> '' Then
    Begin
      If DirectoryExists(LocalApp + '/Android/Sdk') Then
        Exit(LocalApp + '/Android/Sdk');
      If DirectoryExists(LocalApp + '/Library/Android/sdk') Then
        Exit(LocalApp + '/Library/Android/sdk');
    End;
  {$ENDIF}
End;

Function FindAndroidADBInfo(out AdbExe, AdbVer, SourceDesc: String): Boolean;

Var 
  SdkPath, OutText, FirstLine: string;
Begin
  AdbExe := '';
  AdbVer := '';
  SourceDesc := '';
  Result := False;

  SdkPath := FindAndroidSdkPath;
  If (SdkPath <> '') And FileExists(SdkPath + DirectorySeparator +
     'platform-tools' + DirectorySeparator + 'adb' + {$IFDEF WINDOWS}'.exe'
     {$ELSE}''{$ENDIF}) Then
    Begin
      AdbExe := SdkPath + DirectorySeparator + 'platform-tools' +
                DirectorySeparator + 'adb' + {$IFDEF WINDOWS}'.exe'{$ELSE}''
                {$ENDIF};
      SourceDesc := SdkPath + DirectorySeparator + 'platform-tools';
    End
  Else
    Begin
    {$IFDEF WINDOWS}
      If ExecCmdCapture('where.exe adb 2>nul', OutText) And (OutText <> '') Then
        Begin
          FirstLine := Trim(Copy(OutText, 1, Pos(#10, OutText + #10) - 1));
          FirstLine := Trim(StringReplace(FirstLine, #13, '', [rfReplaceAll]));
          If FileExists(FirstLine) Then
            Begin
              AdbExe := FirstLine;
              SourceDesc := 'system PATH';
            End;
        End;
    {$ELSE}
      If ExecCmdCapture('which adb 2>/dev/null', OutText) And (OutText <> '')
        Then
        Begin
          FirstLine := Trim(Copy(OutText, 1, Pos(#10, OutText + #10) - 1));
          If FileExists(FirstLine) Then
            Begin
              AdbExe := FirstLine;
              SourceDesc := 'system PATH';
            End;
        End;
    {$ENDIF}
    End;

  If (AdbExe <> '') And FileExists(AdbExe) Then
    Begin
      If ExecCmdCapture('"' + AdbExe + '" version', OutText) Then
        Begin
          If Pos('version ', LowerCase(OutText)) > 0 Then
            Begin
              AdbVer := Copy(OutText, Pos('version ', LowerCase(OutText)) + 8,
                        Length(OutText));
              If Pos(#10, AdbVer) > 0 Then
                AdbVer := Copy(AdbVer, 1, Pos(#10, AdbVer) - 1);
              AdbVer := Trim(StringReplace(AdbVer, #13, '', [rfReplaceAll]));
            End
          Else
            AdbVer := 'detected';
        End;
      Result := True;
    End;
End;

Function FindAndroidEmulatorInfo(out EmuExe, SourceDesc: String; out AvdCount:
                                 Integer; out AvdListStr: String): Boolean;

Var 
  SdkPath, OutText, Line: string;
  Lines: TStringList;
  i: Integer;
Begin
  EmuExe := '';
  SourceDesc := '';
  AvdCount := 0;
  AvdListStr := '';
  Result := False;

  SdkPath := FindAndroidSdkPath;
  If (SdkPath <> '') And FileExists(SdkPath + DirectorySeparator + 'emulator' +
     DirectorySeparator + 'emulator' + {$IFDEF WINDOWS}'.exe'{$ELSE}''{$ENDIF})
    Then
    Begin
      EmuExe := SdkPath + DirectorySeparator + 'emulator' + DirectorySeparator +
                'emulator' + {$IFDEF WINDOWS}'.exe'{$ELSE}''{$ENDIF};
      SourceDesc := SdkPath + DirectorySeparator + 'emulator';
      Result := True;
    End;

  If Result And FileExists(EmuExe) Then
    Begin
      OutText := '';
      If ExecCmdCapture('"' + EmuExe + '" -list-avds', OutText) And (OutText <>
         '') Then
        Begin
          Lines := TStringList.Create;
          Try
            Lines.Text := OutText;
            For i := 0 To Lines.Count - 1 Do
              Begin
                Line := Trim(Lines[i]);
                If (Line <> '') And (Pos('INFO', Line) <> 1) And (Pos('WARNING',
                   Line) <> 1) And (Pos('ERROR', Line) <> 1) Then
                  Begin
                    Inc(AvdCount);
                    If AvdListStr = '' Then
                      AvdListStr := Line
                    Else If AvdCount <= 3 Then
                           AvdListStr := AvdListStr + ', ' + Line;
                  End;
              End;
          Finally
            Lines.Free;
        End;
    End;
End;
End;

Type 
  TBVToolOrigin = (toBuiltIn, toCoOfficial, toThirdParty);

  TBVTool = Record
    Name: string;
    Category: string;
    Description: string;
    Version: string;
    Author: string;
    Homepage: string;
    ToolType: string;
    DirPath: string;
    BinPath: string;
    StatusScript: string;
    InstallScript: string;
    RemoveScript: string;
    UpdateScript: string;
    PackScript: string;
    Origin: TBVToolOrigin;
    IsCustom: Boolean;
  End;
  TBVToolArray = array Of TBVTool;

Function ToolOriginLabel(Origin: TBVToolOrigin): string;
Begin
  Case Origin Of 
    toBuiltIn:    Result := '[Built-in]';
    toCoOfficial: Result := '[Co-Official]';
    toThirdParty: Result := '[Third-Party]';
  End;
End;




{ Dispatches execution to a developer tool lifecycle script (status.py, install.py). }
Function RunToolScript(Const ToolDir, ScriptName: String; out ScriptOutput:
                       String; CaptureOutput: Boolean = False): Integer;

Var 
  Ext, ScriptPath, RunnerCmd, CmdLine, PyExe, PyVer, IfpcExe, IfpcVer, DummyDesc
  : string;
  Proc: TProcess;
  OutputStream: TStringStream;
  BytesRead: LongInt;
  Buffer: array[0..2047] Of Byte;
Begin
  Result := -1;
  ScriptOutput := '';
  If ScriptName = '' Then Exit;
  ScriptPath := IncludeTrailingPathDelimiter(ToolDir) + ScriptName;
  If Not FileExists(ScriptPath) Then
    Begin
      WriteLn('Error: Script not found: ' + ScriptPath);
      Exit;
    End;

  Ext := LowerCase(ExtractFileExt(ScriptName));
  If Ext = '.py' Then
    Begin
      If FindPythonExecutable(PyExe, PyVer, DummyDesc) Then
        RunnerCmd := PyExe
      Else
        RunnerCmd := 'python';
    End
  Else If Ext = '.pas' Then
         Begin
           If FindInstantFPCExecutable(IfpcExe, IfpcVer, DummyDesc) Then
             RunnerCmd := IfpcExe
           Else
             RunnerCmd := 'instantfpc';
         End
  Else
    RunnerCmd := '';

  If CaptureOutput Then
    Begin
      Proc := TProcess.Create(Nil);
      Try
        If RunnerCmd <> '' Then
          Begin
            Proc.Executable := RunnerCmd;
            Proc.Parameters.Add(ScriptPath);
          End
        Else
          Proc.Executable := ScriptPath;

        Proc.CurrentDirectory := ToolDir;
        Proc.Options := [poUsePipes, poNoConsole];
        Try
          Proc.Execute;
          OutputStream := TStringStream.Create('');
          Try
            While Proc.Running Do
              Begin
                While (Proc.Output <> Nil) And (Proc.Output.NumBytesAvailable >
                      0) Do
                  Begin
                    BytesRead := Proc.Output.Read(Buffer, SizeOf(Buffer));
                    If BytesRead > 0 Then
                      OutputStream.Write(Buffer, BytesRead);
                  End;
                Sleep(10);
              End;
            While (Proc.Output <> Nil) And (Proc.Output.NumBytesAvailable > 0) 
              Do
              Begin
                BytesRead := Proc.Output.Read(Buffer, SizeOf(Buffer));
                If BytesRead > 0 Then
                  OutputStream.Write(Buffer, BytesRead);
              End;
            ScriptOutput := Trim(OutputStream.DataString);
            Result := Proc.ExitStatus;
          Finally
            OutputStream.Free;
    End;
Except
  on E: Exception Do
        Begin
          ScriptOutput := '';
          Result := -1;
        End;
End;
Finally
  Proc.Free;
End;
End
Else
  Begin
    If RunnerCmd <> '' Then
      CmdLine := RunnerCmd + ' "' + ScriptPath + '"'
    Else
      CmdLine := '"' + ScriptPath + '"';

    {$IFDEF WINDOWS}
    Result := ExecuteProcess('cmd', '/c cd /d "' + ToolDir + '" && ' + CmdLine);
    {$ELSE}
    Result := ExecuteProcess('/bin/sh', '-c "cd ''' + ToolDir + ''' && ' +
              CmdLine + '"');
    {$ENDIF}
  End;
End;

Function LoadToolFromDir(Const DirPath: String; IsCustom: Boolean; out Tool:
                         TBVTool): Boolean;

Var 
  ManifestFile, Content, TypeStr: string;
  Parser: TJSONParser;
  JsonData: TJSONData;
  Obj, ScriptsObj: TJSONObject;
Begin
  Result := False;
  Tool.Name := '';
  Tool.Category := '';
  Tool.Description := '';
  Tool.Version := '';
  Tool.Author := '';
  Tool.Homepage := '';
  Tool.ToolType := '';
  Tool.DirPath := DirPath;
  Tool.BinPath := '';
  Tool.StatusScript := '';
  Tool.InstallScript := '';
  Tool.RemoveScript := '';
  Tool.UpdateScript := '';
  Tool.PackScript := '';
  Tool.IsCustom := IsCustom;
  If Not IsCustom Then
    Tool.Origin := toBuiltIn
  Else
    Tool.Origin := toThirdParty;

  ManifestFile := IncludeTrailingPathDelimiter(DirPath) + 'tool.json';
  If Not FileExists(ManifestFile) Then Exit;
  Content := ReadFileToString(ManifestFile);
  If Content = '' Then Exit;
  Try
    Parser := TJSONParser.Create(Content);
    Try
      JsonData := Parser.Parse;
      If (JsonData <> Nil) And (JsonData is TJSONObject) Then
        Begin
          Obj := TJSONObject(JsonData);
          Tool.Name := Obj.Get('name', ExtractFileName(
                       ExcludeTrailingPathDelimiter(DirPath)));
          Tool.Category := Obj.Get('category', 'Tool');
          Tool.Description := Obj.Get('description', '');
          Tool.Version := Obj.Get('version', '');
          Tool.Author := Obj.Get('author', '');
          Tool.Homepage := Obj.Get('homepage', '');
          Tool.BinPath := Obj.Get('bin', Obj.Get('exec', Obj.Get('main', '')));
          TypeStr := LowerCase(Obj.Get('type', ''));

          If Not IsCustom Then
            Begin
              Tool.Origin := toBuiltIn;
              Tool.ToolType := 'builtin';
            End
          Else
            Begin
              If (TypeStr = 'co-official') Or (TypeStr = 'official') Or
                 StartsText('blaise-', LowerCase(Tool.Name)) Then
                Begin
                  Tool.Origin := toCoOfficial;
                  Tool.ToolType := 'co-official';
                End
              Else
                Begin
                  Tool.Origin := toThirdParty;
                  Tool.ToolType := 'third-party';
                End;
            End;

          If Obj.Find('scripts') is TJSONObject Then
            Begin
              ScriptsObj := TJSONObject(Obj.Find('scripts'));
              Tool.StatusScript := ScriptsObj.Get('status', '');
              Tool.InstallScript := ScriptsObj.Get('install', '');
              Tool.RemoveScript := ScriptsObj.Get('remove', '');
              Tool.UpdateScript := ScriptsObj.Get('update', '');
              Tool.PackScript := ScriptsObj.Get('pack', '');
            End;
          Result := True;
        End;
    Finally
      If JsonData <> Nil Then JsonData.Free;
      Parser.Free;
End;
Except
  Result := False;
End;
End;

{ Enumerates all installed tools across system and user directories. }
Function DiscoverAllTools: TBVToolArray;

Var 
  ToolsList: TBVToolArray;
  BuiltinPath, UserPath, SubDir: string;
  SR: TSearchRec;
  Tool: TBVTool;

Procedure ScanDir(Const BasePath: String; IsCustom: Boolean);
Begin
  If (BasePath <> '') And DirectoryExists(BasePath) Then
    Begin
      If FindFirst(IncludeTrailingPathDelimiter(BasePath) + '*', faDirectory, SR
         ) = 0 Then
        Begin
          Repeat
            If (SR.Name <> '.') And (SR.Name <> '..') And ((SR.Attr And
               faDirectory) <> 0) Then
              Begin
                SubDir := IncludeTrailingPathDelimiter(BasePath) + SR.Name;
                If LoadToolFromDir(SubDir, IsCustom, Tool) Then
                  Begin
                    SetLength(ToolsList, Length(ToolsList) + 1);
                    ToolsList[High(ToolsList)] := Tool;
                  End
                Else If IsCustom Then
                       Begin
                         Tool.Name := SR.Name;
                         Tool.Category := 'User Tool';
                         Tool.Description := 'Custom tool in ~/.blaisevue/tools'
                         ;
                         Tool.Version := '1.0.0';
                         Tool.Author := '';
                         Tool.Homepage := '';
                         Tool.DirPath := SubDir;
                         Tool.BinPath := '';
                         Tool.IsCustom := True;
                         If StartsText('blaise-', LowerCase(SR.Name)) Then
                           Begin
                             Tool.Origin := toCoOfficial;
                             Tool.ToolType := 'co-official';
                           End
                         Else
                           Begin
                             Tool.Origin := toThirdParty;
                             Tool.ToolType := 'third-party';
                           End;
                         Tool.StatusScript := '';
                         Tool.InstallScript := '';
                         Tool.RemoveScript := '';
                         Tool.UpdateScript := '';
                         Tool.PackScript := '';
                         If FileExists(SubDir + DirectorySeparator + 'status.py'
                            ) Then Tool.StatusScript := 'status.py'
                         Else If FileExists(SubDir + DirectorySeparator +
                                 'status.pas') Then Tool.StatusScript := 


                                                                    'status.pas'
                         ;
                         If FileExists(SubDir + DirectorySeparator +
                            'install.py') Then Tool.InstallScript := 


                                                                    'install.py'
                         Else If FileExists(SubDir + DirectorySeparator +
                                 'install.pas') Then Tool.InstallScript := 


                                                                   'install.pas'
                         ;
                         If FileExists(SubDir + DirectorySeparator + 'update.py'
                            ) Then Tool.UpdateScript := 'update.py'
                         Else If FileExists(SubDir + DirectorySeparator +
                                 'update.pas') Then Tool.UpdateScript := 


                                                                    'update.pas'
                         ;
                         If FileExists(SubDir + DirectorySeparator + 'remove.py'
                            ) Then Tool.RemoveScript := 'remove.py'
                         Else If FileExists(SubDir + DirectorySeparator +
                                 'remove.pas') Then Tool.RemoveScript := 


                                                                    'remove.pas'
                         ;
                         If FileExists(SubDir + DirectorySeparator + 'pack.py')
                           Then Tool.PackScript := 'pack.py'
                         Else If FileExists(SubDir + DirectorySeparator +
                                 'pack.pas') Then Tool.PackScript := 'pack.pas';
                         SetLength(ToolsList, Length(ToolsList) + 1);
                         ToolsList[High(ToolsList)] := Tool;
                       End;
              End;
          Until FindNext(SR) <> 0;
          FindClose(SR);
        End;
    End;
End;
Begin
  SetLength(ToolsList, 0);
  BuiltinPath := GetBuiltinToolsPath;
  ScanDir(BuiltinPath, False);
  UserPath := GetGlobalToolsPath;
  ScanDir(UserPath, True);
  Result := ToolsList;
End;

{ Lists all installed tools (built-in and user tools) (bv tool list). }
Procedure CmdToolList;

Var 
  AllTools: TBVToolArray;
  I, BuiltInCount, CoOfficialCount, ThirdPartyCount: Integer;
  StatusText, LocText, VerStr: string;
Begin
  AllTools := DiscoverAllTools;
  BuiltInCount := 0;
  CoOfficialCount := 0;
  ThirdPartyCount := 0;

  WriteLn('');
  WriteLn('=== BlaiseVue Development Tools (bv tool) ===');
  WriteLn(StringOfChar('-', 86));
  WriteLn(PadRight('Tool Name', 20), PadRight('Category', 22), PadRight(


                                                                       'Version'
                                                                        , 12),
  PadRight('Type', 15), PadRight('Status / Location', 17));
  WriteLn(StringOfChar('-', 86));

  If Length(AllTools) = 0 Then
    WriteLn('No tools found.')
  Else
    Begin
      For I := 0 To High(AllTools) Do
        Begin
          Case AllTools[I].Origin Of 
            toBuiltIn:    Inc(BuiltInCount);
            toCoOfficial: Inc(CoOfficialCount);
            toThirdParty: Inc(ThirdPartyCount);
          End;

          StatusText := '';
          If AllTools[I].StatusScript <> '' Then
            RunToolScript(AllTools[I].DirPath, AllTools[I].StatusScript,
                          StatusText, True);

          If StatusText = '' Then
            Begin
              If AllTools[I].Origin = toBuiltIn Then
                LocText := 'Available (packages/tools)'
              Else
                LocText := 'Installed (~/.blaisevue/tools)';
            End
          Else
            LocText := StatusText;

          VerStr := AllTools[I].Version;
          If (VerStr <> '') And (VerStr[1] <> 'v') Then VerStr := 'v' + VerStr;
          If VerStr = '' Then VerStr := '-';

          WriteLn(PadRight(AllTools[I].Name, 20),
          PadRight(AllTools[I].Category, 22),
          PadRight(VerStr, 12),
          PadRight(ToolOriginLabel(AllTools[I].Origin), 15),
          LocText);
        End;
    End;

  WriteLn(StringOfChar('-', 86));
  WriteLn('Total: ' + IntToStr(Length(AllTools)) + ' tool(s) found (Built-in: '
  +
  IntToStr(BuiltInCount) + ', Co-Official: ' + IntToStr(CoOfficialCount) +
  ', Third-Party: ' + IntToStr(ThirdPartyCount) + ')');
  WriteLn('User Tools Directory: ' + GetGlobalToolsPath);
  WriteLn(


'Commands: bv tool <list|search|info|install|run|update|outdated|remove|pack|init>'
  );
  WriteLn('');
End;




{ Searches registered package repositories for tools matching a query (bv tool search). }
Procedure CmdToolSearch(Const SearchTermArg: String);

Var 
  CacheDir, CacheFile, RawJson, SearchTerm, RepoName, ToolKey, ToolDesc,
  ToolLatest, ToolType: string;
  SR: TSearchRec;
  Parser: TJSONParser;
  Data: TJSONData;
  RootObj, ToolsObj, ToolObj: TJSONObject;
  i, MatchCount: Integer;
Begin
  SearchTerm := LowerCase(Trim(SearchTermArg));
  WriteLn('');
  WriteLn('=== Tool Search in BlaiseVue Ecosystem ===');
  If SearchTerm <> '' Then
    WriteLn('Searching for "' + SearchTerm + '" in registered repositories:')
  Else
    WriteLn('Listing all available ecosystem tools:');
  WriteLn(StringOfChar('-', 86));
  WriteLn(PadRight('Tool Name', 22), PadRight('Latest', 12), PadRight('Type', 15
  ), PadRight('Repository', 15), 'Description');
  WriteLn(StringOfChar('-', 86));

  CacheDir := ExtractFileDir(GetReposConfigPath) + DirectorySeparator + 'cache';
  If Not DirectoryExists(CacheDir) Then
    CmdRepoSync;

  MatchCount := 0;
  If FindFirst(CacheDir + DirectorySeparator + '*-ecosystem.json', faAnyFile, SR
     ) = 0 Then
    Begin
      Repeat
        If (SR.Name <> '.') And (SR.Name <> '..') Then
          Begin
            CacheFile := CacheDir + DirectorySeparator + SR.Name;
            RawJson := ReadFileToString(CacheFile);
            If Trim(RawJson) <> '' Then
              Begin
                Parser := TJSONParser.Create(RawJson, True);
                Try
                  Try
                    Data := Parser.Parse;
                    If Assigned(Data) And (Data.JSONType = jtObject) Then
                      Begin
                        RootObj := TJSONObject(Data);
                        RepoName := RootObj.Get('name', StringReplace(SR.Name,
                                    '-ecosystem.json', '', [rfReplaceAll]));

                        ToolsObj := RootObj.Get('tools', TJSONObject(Nil));
                        If Not Assigned(ToolsObj) Then
                          ToolsObj := RootObj.Get('packages', TJSONObject(Nil));

                        If Assigned(ToolsObj) Then
                          Begin
                            For i := 0 To ToolsObj.Count - 1 Do
                              Begin
                                ToolKey := ToolsObj.Names[i];
                                ToolObj := TJSONObject(ToolsObj.Items[i]);

                                ToolType := LowerCase(ToolObj.Get('type', ''));
                                If ToolType = '' Then
                                  Begin
                                    If SameText(RepoName, 'official') Or
                                       StartsText('blaise-', LowerCase(ToolKey))
                                      Then
                                      ToolType := 'co-official'
                                    Else
                                      ToolType := 'third-party';
                                  End;

                                ToolDesc := ToolObj.Get('description', '');
                                ToolLatest := ToolObj.Get('latest', ToolObj.Get(
                                              'version', '1.0.0'));

                                If (SearchTerm = '') Or (Pos(SearchTerm,
                                   LowerCase(ToolKey)) > 0) Or
                                   (Pos(SearchTerm, LowerCase(ToolDesc)) > 0) Or
                                   (Pos(SearchTerm, LowerCase(ToolType)) > 0)
                                  Then
                                  Begin
                                    Inc(MatchCount);
                                    If (ToolLatest <> '') And (ToolLatest[1] <>
                                       'v') Then ToolLatest := 'v' + ToolLatest;
                                    WriteLn(PadRight(ToolKey, 22),
                                    PadRight(ToolLatest, 12),
                                    PadRight('[' + ToolType + ']', 15),
                                    PadRight(RepoName, 15),
                                    ToolDesc);
                                  End;
                              End;
                          End;
                      End;
                    If Assigned(Data) Then Data.Free;
                  Except
              End;
          Finally
            Parser.Free;
      End;
    End;
End;
Until FindNext(SR) <> 0;
FindClose(SR);
End;

WriteLn(StringOfChar('-', 86));
If MatchCount = 0 Then
  WriteLn('No tools matching "' + SearchTerm +
          '" found in ecosystem repositories.')
Else
  WriteLn(IntToStr(MatchCount) +
  ' tool(s) found. To install, run: bv tool install [<repo>:]<name>');
WriteLn('');
End;

{ Displays detailed information about a tool (bv tool info). }
Procedure CmdToolInfo(Const ToolNameArg: String);

Var 
  TargetLower, FoundVer, DownloadURL, Checksum, RepoName, FoundType,
  InstalledVer, TypeStr: string;
  AllTools: TBVToolArray;
  I, FoundIndex: Integer;
  ScriptsList: string;
Begin
  TargetLower := LowerCase(Trim(ToolNameArg));
  If TargetLower = '' Then
    Begin
      WriteLn('Error: Tool name required.');
      WriteLn('Usage: bv tool info <tool-name>');
      Exit;
    End;

  AllTools := DiscoverAllTools;
  FoundIndex := -1;
  For I := 0 To High(AllTools) Do
    Begin
      If (LowerCase(AllTools[I].Name) = TargetLower) Or
         (AllTools[I].Name = 'blaise-' + TargetLower) Or
         ((TargetLower = 'vscode') And (AllTools[I].Name = 'blaise-vscode')) Or
         ((TargetLower = 'lazarus') And (AllTools[I].Name = 'blaise-lazarus'))
         Or
         ((TargetLower = 'devtools') And (AllTools[I].Name = 'blaise-devtools'))
        Then
        Begin
          FoundIndex := I;
          Break;
        End;
    End;

  InstalledVer := 'Not installed';
  TypeStr := '';
  If FoundIndex >= 0 Then
    Begin
      InstalledVer := AllTools[FoundIndex].Version;
      If (InstalledVer <> '') And (InstalledVer[1] <> 'v') Then InstalledVer := 


                                                                             'v'


                                                                               +


                                                                    InstalledVer
      ;
      TypeStr := ToolOriginLabel(AllTools[FoundIndex].Origin);
    End;

  If FindToolInEcosystem(TargetLower, 'latest', FoundVer, DownloadURL, Checksum,
     RepoName, FoundType) Then
    Begin
      If (FoundVer <> '') And (FoundVer[1] <> 'v') Then FoundVer := 'v' +
                                                                    FoundVer;
      If TypeStr = '' Then TypeStr := '[' + FoundType + ']';
    End
  Else
    FoundVer := 'Not registered in catalog';

  WriteLn('');
  WriteLn('============================================================');
  If FoundIndex >= 0 Then
    WriteLn('  [Tool Details] ' + AllTools[FoundIndex].Name)
  Else
    WriteLn('  [Tool Details] ' + TargetLower);
  WriteLn('============================================================');
  If FoundIndex >= 0 Then
    Begin
      WriteLn('  Category:        ' + AllTools[FoundIndex].Category);
      WriteLn('  Type:            ' + TypeStr);
      WriteLn('  Installed Ver:   ' + InstalledVer);
      WriteLn('  Latest Ver:      ' + FoundVer);
      If RepoName <> '' Then
        WriteLn('  Repository:      ' + RepoName);
      WriteLn('  Directory:       ' + AllTools[FoundIndex].DirPath);
      If AllTools[FoundIndex].Description <> '' Then
        WriteLn('  Description:     ' + AllTools[FoundIndex].Description);
      If AllTools[FoundIndex].Author <> '' Then
        WriteLn('  Author:          ' + AllTools[FoundIndex].Author);
      If AllTools[FoundIndex].Homepage <> '' Then
        WriteLn('  Homepage:        ' + AllTools[FoundIndex].Homepage);

      ScriptsList := '';
      If AllTools[FoundIndex].StatusScript <> '' Then ScriptsList := ScriptsList
                                                                     + 'status '
      ;
      If AllTools[FoundIndex].InstallScript <> '' Then ScriptsList := 


                                                                     ScriptsList
                                                                      +
                                                                      'install '
      ;
      If AllTools[FoundIndex].UpdateScript <> '' Then ScriptsList := ScriptsList
                                                                     + 'update '
      ;
      If AllTools[FoundIndex].RemoveScript <> '' Then ScriptsList := ScriptsList
                                                                     + 'remove '
      ;
      If AllTools[FoundIndex].PackScript <> '' Then ScriptsList := ScriptsList +
                                                                   'pack ';
      If ScriptsList <> '' Then
        WriteLn('  Scripts:         ' + Trim(ScriptsList));
    End
  Else
    Begin
      WriteLn('  Type:            ' + TypeStr);
      WriteLn('  Installed Ver:   ' + InstalledVer);
      WriteLn('  Latest Ver:      ' + FoundVer);
      If RepoName <> '' Then
        WriteLn('  Repository:      ' + RepoName);
      If DownloadURL <> '' Then
        WriteLn('  Download URL:    ' + DownloadURL);
    End;
  WriteLn('============================================================');
  WriteLn('');
End;




{ Installs a tool from ecosystem, local zip, or URL into ~/.blaisevue/tools (bv tool install). }
Procedure CmdToolInstall(Const TargetArg: String);

Var 
  RawArg, TargetRepo, ToolName, ReqVersion, RemainingArg: string;
  FoundVer, DownloadURL, Checksum, RepoName, FoundType, TempZip, DestDir, Dummy,
  NewDestDir: string;
  AllTools: TBVToolArray;
  ColonPos, AtPos, I, BuiltinIdx: Integer;
  Client: TFPHTTPClient;
  ToolRecord: TBVTool;
Begin
  RawArg := Trim(TargetArg);
  If RawArg = '' Then
    Begin
      WriteLn('Error: Target tool name, zip file, or URL required.');
      WriteLn('Usage: bv tool install [<repo>:]<name[@version]>');
      WriteLn('       bv tool install <url|archive.zip>');
      Exit;
    End;

  // Case 1: Local ZIP Archive
  If FileExists(RawArg) And (LowerCase(ExtractFileExt(RawArg)) = '.zip') Then
    Begin
      ToolName := ChangeFileExt(ExtractFileName(RawArg), '');
      DestDir := GetGlobalToolsPath + ToolName;
      WriteLn('Installing tool from local archive: ' + RawArg + ' ...');
      If DirectoryExists(DestDir) Then DeleteDir(DestDir);
      ForceDir(DestDir);
      ExtractZipSmart(RawArg, GetGlobalToolsPath, ToolName);
      If LoadToolFromDir(DestDir, True, ToolRecord) Then
        Begin
          If (ToolRecord.Name <> '') And (ToolRecord.Name <> ToolName) Then
            Begin
              NewDestDir := GetGlobalToolsPath + ToolRecord.Name;
              If DirectoryExists(NewDestDir) Then DeleteDir(NewDestDir);
              RenameFile(DestDir, NewDestDir);
              DestDir := NewDestDir;
              ToolName := ToolRecord.Name;
            End;
          If (ToolRecord.InstallScript <> '') Then
            Begin
              WriteLn('Running installation script (' + ToolRecord.InstallScript
                      + ')...');
              RunToolScript(DestDir, ToolRecord.InstallScript, Dummy, False);
            End;
        End;
      WriteLn('Tool "' + ToolName +
              '" installed successfully in ~/.blaisevue/tools/' + ToolName +
              '/.');
      Exit;
    End;

  // Case 2: URL download
  If StartsText('http://', RawArg) Or StartsText('https://', RawArg) Then
    Begin
      ToolName := ChangeFileExt(ExtractFileName(RawArg), '');
      If ToolName = '' Then ToolName := 'custom-tool';
      TempZip := GetUserBlaiseVueDir + DirectorySeparator + 'cache' +
                 DirectorySeparator + ToolName + '.zip';
      ForceDir(ExtractFileDir(TempZip));
      WriteLn('Downloading tool from URL: ' + RawArg + ' ...');
      Client := TFPHTTPClient.Create(Nil);
      Try
        Try
          Client.AllowRedirect := True;
          Client.Get(RawArg, TempZip);
        Except
          on E: Exception Do
                Begin
                  WriteLn('Error downloading tool: ' + E.Message);
                  Exit;
                End;
    End;
Finally
  Client.Free;
End;

DestDir := GetGlobalToolsPath + ToolName;
If DirectoryExists(DestDir) Then DeleteDir(DestDir);
ForceDir(DestDir);
ExtractZipSmart(TempZip, GetGlobalToolsPath, ToolName);
If LoadToolFromDir(DestDir, True, ToolRecord) Then
  Begin
    If (ToolRecord.Name <> '') And (ToolRecord.Name <> ToolName) Then
      Begin
        NewDestDir := GetGlobalToolsPath + ToolRecord.Name;
        If DirectoryExists(NewDestDir) Then DeleteDir(NewDestDir);
        RenameFile(DestDir, NewDestDir);
        DestDir := NewDestDir;
        ToolName := ToolRecord.Name;
      End;
    If (ToolRecord.InstallScript <> '') Then
      Begin
        WriteLn('Running installation script (' + ToolRecord.InstallScript +
                ')...');
        RunToolScript(DestDir, ToolRecord.InstallScript, Dummy, False);
      End;
  End;
WriteLn('Tool "' + ToolName + '" installed successfully in ~/.blaisevue/tools/'
        + ToolName + '/.');
Exit;
End;

// Case 3: Package name with optional repo and version
TargetRepo := '';
ToolName := '';
ReqVersion := '';
ColonPos := Pos(':', RawArg);
If ColonPos > 0 Then
  Begin
    TargetRepo := Trim(Copy(RawArg, 1, ColonPos - 1));
    RemainingArg := Trim(Copy(RawArg, ColonPos + 1, Length(RawArg) - ColonPos));
  End
Else
  RemainingArg := RawArg;

AtPos := Pos('@', RemainingArg);
If AtPos > 0 Then
  Begin
    ToolName := Trim(Copy(RemainingArg, 1, AtPos - 1));
    ReqVersion := Trim(Copy(RemainingArg, AtPos + 1, Length(RemainingArg) -
                  AtPos));
  End
Else
  Begin
    ToolName := Trim(RemainingArg);
    ReqVersion := '';
  End;

// Check if it's already a built-in framework tool in packages/tools/
AllTools := DiscoverAllTools;
BuiltinIdx := -1;
For I := 0 To High(AllTools) Do
  Begin
    If (AllTools[I].Origin = toBuiltIn) And
       ((LowerCase(AllTools[I].Name) = LowerCase(ToolName)) Or
       (AllTools[I].Name = 'blaise-' + LowerCase(ToolName)) Or
       ((LowerCase(ToolName) = 'vscode') And (AllTools[I].Name = 'blaise-vscode'
       )) Or
       ((LowerCase(ToolName) = 'lazarus') And (AllTools[I].Name =
       'blaise-lazarus')) Or
       ((LowerCase(ToolName) = 'devtools') And (AllTools[I].Name =
       'blaise-devtools'))) Then
      Begin
        BuiltinIdx := I;
        Break;
      End;
  End;

If (BuiltinIdx >= 0) And (ReqVersion = '') And (TargetRepo = '') Then
  Begin
    WriteLn('Notice: Tool "' + AllTools[BuiltinIdx].Name +
            '" is a built-in framework tool in packages/tools/.');
    If AllTools[BuiltinIdx].InstallScript <> '' Then
      Begin
        WriteLn('Executing built-in setup script (' + AllTools[BuiltinIdx].
                InstallScript + ')...');
        RunToolScript(AllTools[BuiltinIdx].DirPath, AllTools[BuiltinIdx].
                      InstallScript, Dummy, False);
      End;
    WriteLn('Built-in tool "' + AllTools[BuiltinIdx].Name + '" is ready.');
    Exit;
  End;

// Search in ecosystem
If TargetRepo <> '' Then
  WriteLn('Searching for tool "' + ToolName + '" in repository [' + TargetRepo +
          ']...')
Else
  WriteLn('Searching for tool "' + ToolName + '" in ecosystem repositories...');

If Not FindToolInEcosystem(ToolName, ReqVersion, FoundVer, DownloadURL, Checksum
   , RepoName, FoundType, TargetRepo) Then
  Begin
    WriteLn('Error: Tool "' + ToolName +
            '" was not found in registered repositories.');
    WriteLn('Hint: Run "bv repo sync" to update catalog or "bv tool search ' +
            ToolName + '" to look for available tools.');
    Exit;
  End;

WriteLn('Found in [' + RepoName + ']: ' + ToolName + ' v' + FoundVer + ' [' +
        FoundType + ']');
WriteLn('Downloading tool: ' + DownloadURL);
TempZip := GetUserBlaiseVueDir + DirectorySeparator + 'cache' +
           DirectorySeparator + ToolName + '-' + FoundVer + '.zip';
ForceDir(ExtractFileDir(TempZip));
Client := TFPHTTPClient.Create(Nil);
Try
  Try
    Client.AllowRedirect := True;
    Client.Get(DownloadURL, TempZip);
  Except
    on E: Exception Do
          Begin
            WriteLn('Error downloading tool: ' + E.Message);
            Exit;
          End;
End;
Finally
  Client.Free;
End;

// Checksum validation
If Checksum <> '' Then
  Begin
    If Not SameText(FileSHA256(TempZip), Checksum) And
       Not SameText('sha256:' + FileSHA256(TempZip), Checksum) Then
      Begin
        WriteLn('Error: Integrity check failed! Checksum mismatch for ' +
                ExtractFileName(TempZip));
        Exit;
      End;
  End;

DestDir := GetGlobalToolsPath + ToolName;
WriteLn('Extracting to user tools directory (~/.blaisevue/tools/' + ToolName +
        ')...');
If DirectoryExists(DestDir) Then DeleteDir(DestDir);
ForceDir(DestDir);
ExtractZipSmart(TempZip, GetGlobalToolsPath, ToolName);

If LoadToolFromDir(DestDir, True, ToolRecord) And (ToolRecord.InstallScript <>
   '') Then
  Begin
    WriteLn('Executing installation script (' + ToolRecord.InstallScript +
            ')...');
    RunToolScript(DestDir, ToolRecord.InstallScript, Dummy, False);
  End;

WriteLn('');
WriteLn('Tool "' + ToolName + '" (v' + FoundVer +
        ') installed successfully as [' + FoundType + ']!');
WriteLn('');
End;




{ Inspects installed tools against remote ecosystem catalog for available updates (bv tool outdated). }
Procedure CmdToolOutdated;

Var 
  AllTools: TBVToolArray;
  I, OutdatedCount: Integer;
  FoundVer, DownloadURL, Checksum, RepoName, FoundType, InstalledVer, RowStatus:


                                                                          string
  ;
Begin
  AllTools := DiscoverAllTools;
  OutdatedCount := 0;

  WriteLn('');
  WriteLn('=== Tool Version Inspection (bv tool outdated) ===');
  WriteLn(StringOfChar('-', 86));
  WriteLn(PadRight('Tool Name', 20), PadRight('Installed', 14), PadRight(


                                                                        'Latest'
                                                                         , 16),
  PadRight('Type', 15), 'Status');
  WriteLn(StringOfChar('-', 86));

  If Length(AllTools) = 0 Then
    WriteLn('No tools installed.')
  Else
    Begin
      For I := 0 To High(AllTools) Do
        Begin
          InstalledVer := AllTools[I].Version;
          If InstalledVer = '' Then InstalledVer := '1.0.0';

          If AllTools[I].Origin = toBuiltIn Then
            Begin
              WriteLn(PadRight(AllTools[I].Name, 20),
              PadRight('v' + InstalledVer, 14),
              PadRight('v' + InstalledVer, 16),
              PadRight('[Built-in]', 15),
              'Built-in Framework (Up to date)');
            End
          Else
            Begin
              If FindToolInEcosystem(AllTools[I].Name, 'latest', FoundVer,
                 DownloadURL, Checksum, RepoName, FoundType) Then
                Begin
                  If (FoundVer <> '') And (FoundVer <> InstalledVer) Then
                    Begin
                      Inc(OutdatedCount);
                      RowStatus := 'Update available -> v' + FoundVer;
                      WriteLn(PadRight(AllTools[I].Name, 20),
                      PadRight('v' + InstalledVer, 14),
                      PadRight('v' + FoundVer, 16),
                      PadRight(ToolOriginLabel(AllTools[I].Origin), 15),
                      RowStatus);
                    End
                  Else
                    Begin
                      WriteLn(PadRight(AllTools[I].Name, 20),
                      PadRight('v' + InstalledVer, 14),
                      PadRight('v' + InstalledVer, 16),
                      PadRight(ToolOriginLabel(AllTools[I].Origin), 15),
                      'Up to date');
                    End;
                End
              Else
                Begin
                  WriteLn(PadRight(AllTools[I].Name, 20),
                  PadRight('v' + InstalledVer, 14),
                  PadRight('-', 16),
                  PadRight(ToolOriginLabel(AllTools[I].Origin), 15),
                  'Not registered in catalog');
                End;
            End;
        End;
    End;

  WriteLn(StringOfChar('-', 86));
  If OutdatedCount = 0 Then
    WriteLn('All installed tools are up to date!')
  Else
    Begin
      WriteLn(IntToStr(OutdatedCount) + ' tool(s) have updates available.');
      WriteLn(


'To update, run: bv tool update <name> (or "bv tool update" to update all user tools)'
      );
    End;
  WriteLn('');
End;




{ Updates one or all tools in ~/.blaisevue/tools to latest ecosystem versions (bv tool update). }
Procedure CmdToolUpdate(Const TargetNameArg: String = '');

Var 
  TargetLower, FoundVer, DownloadURL, Checksum, RepoName, FoundType, TempZip,
  DestDir, Dummy: string;
  AllTools: TBVToolArray;
  I, UpdatedCount: Integer;
  Client: TFPHTTPClient;
  ToolRecord: TBVTool;
Begin
  TargetLower := LowerCase(Trim(TargetNameArg));
  AllTools := DiscoverAllTools;

  If TargetLower <> '' Then
    Begin
      For I := 0 To High(AllTools) Do
        Begin
          If (LowerCase(AllTools[I].Name) = TargetLower) Or
             (AllTools[I].Name = 'blaise-' + TargetLower) Then
            Begin
              If AllTools[I].Origin = toBuiltIn Then
                Begin
                  WriteLn('');
                  WriteLn('Notice: Tool "' + AllTools[I].Name +
                          '" is a built-in official tool in packages/tools/.');
                  WriteLn(


'Built-in framework tools are updated when updating BlaiseVue (run "bv self-update").'
                  );
                  Exit;
                End;

              WriteLn('Checking for updates for "' + AllTools[I].Name +
                      '" in ecosystem...');
              If Not FindToolInEcosystem(AllTools[I].Name, 'latest', FoundVer,
                 DownloadURL, Checksum, RepoName, FoundType) Then
                Begin
                  WriteLn('Error: Tool "' + AllTools[I].Name +
                          '" was not found in registered repositories.');
                  Exit;
                End;

              If (AllTools[I].Version <> '') And (AllTools[I].Version = FoundVer
                 ) Then
                Begin
                  WriteLn('Tool "' + AllTools[I].Name +
                          '" is already up to date (v' + FoundVer + ').');
                  Exit;
                End;

              WriteLn('Updating "' + AllTools[I].Name + '" from v' + AllTools[I]
                      .Version + ' to v' + FoundVer + ' ...');
              TempZip := GetUserBlaiseVueDir + DirectorySeparator + 'cache' +
                         DirectorySeparator + AllTools[I].Name + '-' + FoundVer
                         + '.zip';
              ForceDir(ExtractFileDir(TempZip));
              Client := TFPHTTPClient.Create(Nil);
              Try
                Client.AllowRedirect := True;
                Client.Get(DownloadURL, TempZip);
              Finally
                Client.Free;
            End;

          DestDir := GetGlobalToolsPath + AllTools[I].Name;
          ExtractZipSmart(TempZip, GetGlobalToolsPath, AllTools[I].Name);
          If LoadToolFromDir(DestDir, True, ToolRecord) Then
            Begin
              If ToolRecord.UpdateScript <> '' Then
                RunToolScript(DestDir, ToolRecord.UpdateScript, Dummy, False)
              Else If ToolRecord.InstallScript <> '' Then
                     RunToolScript(DestDir, ToolRecord.InstallScript, Dummy,
                                   False);
            End;

          WriteLn('Tool "' + AllTools[I].Name + '" updated successfully to v' +
                  FoundVer + '!');
          Exit;
        End;
    End;

  WriteLn('Error: Tool "' + TargetLower + '" is not installed.');
  Exit;
End;

// Update all user tools in ~/.blaisevue/tools
WriteLn('=== Updating All User Tools in ~/.blaisevue/tools ===');
UpdatedCount := 0;
For I := 0 To High(AllTools) Do
  Begin
    If AllTools[I].Origin <> toBuiltIn Then
      Begin
        If FindToolInEcosystem(AllTools[I].Name, 'latest', FoundVer, DownloadURL
           , Checksum, RepoName, FoundType) Then
          Begin
            If (FoundVer <> '') And (FoundVer <> AllTools[I].Version) Then
              Begin
                Write('  [+] Updating "' + AllTools[I].Name + '" (v' + AllTools[
                      I].Version + ' -> v' + FoundVer + ') ... ');
                TempZip := GetUserBlaiseVueDir + DirectorySeparator + 'cache' +
                           DirectorySeparator + AllTools[I].Name + '-' +
                           FoundVer + '.zip';
                ForceDir(ExtractFileDir(TempZip));
                Client := TFPHTTPClient.Create(Nil);
                Try
                  Try
                    Client.AllowRedirect := True;
                    Client.Get(DownloadURL, TempZip);
                    DestDir := GetGlobalToolsPath + AllTools[I].Name;
                    ExtractZipSmart(TempZip, GetGlobalToolsPath, AllTools[I].
                                    Name);
                    If LoadToolFromDir(DestDir, True, ToolRecord) And (
                       ToolRecord.UpdateScript <> '') Then
                      RunToolScript(DestDir, ToolRecord.UpdateScript, Dummy,
                                    False);
                    WriteLn('OK');
                    Inc(UpdatedCount);
                  Except
                    on E: Exception Do WriteLn('FAILED (' + E.Message + ')');
              End;
          Finally
            Client.Free;
      End;
  End;
End;
End;
End;

If UpdatedCount = 0 Then
  WriteLn('All user tools are already up to date.')
Else
  WriteLn(IntToStr(UpdatedCount) + ' tool(s) updated successfully.');
WriteLn('');
End;

{ Uninstalls a tool from ~/.blaisevue/tools (bv tool remove). }
Procedure CmdToolRemove(Const TargetNameArg: String);

Var 
  TargetLower, Dummy: string;
  AllTools: TBVToolArray;
  I, FoundIndex: Integer;
Begin
  TargetLower := LowerCase(Trim(TargetNameArg));
  If TargetLower = '' Then
    Begin
      WriteLn('Error: Target tool name required to remove.');
      WriteLn('Usage: bv tool remove <tool-name>');
      Exit;
    End;

  AllTools := DiscoverAllTools;
  FoundIndex := -1;
  For I := 0 To High(AllTools) Do
    Begin
      If (LowerCase(AllTools[I].Name) = TargetLower) Or
         (AllTools[I].Name = 'blaise-' + TargetLower) Or
         ((TargetLower = 'vscode') And (AllTools[I].Name = 'blaise-vscode')) Or
         ((TargetLower = 'lazarus') And (AllTools[I].Name = 'blaise-lazarus'))
         Or
         ((TargetLower = 'devtools') And (AllTools[I].Name = 'blaise-devtools'))
        Then
        Begin
          FoundIndex := I;
          Break;
        End;
    End;

  If FoundIndex = -1 Then
    Begin
      WriteLn('Error: Tool "' + TargetLower + '" is not installed.');
      Exit;
    End;

  // Protect Built-in official framework tools
  If AllTools[FoundIndex].Origin = toBuiltIn Then
    Begin
      WriteLn('');
      WriteLn('Error: Cannot remove tool "' + AllTools[FoundIndex].Name + '".');
      WriteLn('This is a built-in official tool located in packages/tools/.');
      WriteLn('Built-in framework tools cannot be uninstalled.');
      Exit;
    End;

  WriteLn('Removing tool "' + AllTools[FoundIndex].Name +
          '" from ~/.blaisevue/tools/...');
  If (AllTools[FoundIndex].RemoveScript <> '') And
     FileExists(IncludeTrailingPathDelimiter(AllTools[FoundIndex].DirPath) +
     AllTools[FoundIndex].RemoveScript) Then
    Begin
      WriteLn('Executing uninstall script (' + AllTools[FoundIndex].RemoveScript
              + ')...');
      RunToolScript(AllTools[FoundIndex].DirPath, AllTools[FoundIndex].
                    RemoveScript, Dummy, False);
    End;

  If DirectoryExists(AllTools[FoundIndex].DirPath) Then
    DeleteDir(AllTools[FoundIndex].DirPath);

  WriteLn('Tool "' + AllTools[FoundIndex].Name + '" removed successfully.');
End;

{ Packages a tool into a distributable release ZIP archive (bv tool pack). }
Procedure CmdToolPack(Const TargetArg: String);

Var 
  BaseDir, ToolName, ToolVersion, DistDir, ZipFile, ChecksumFile, HashStr:


                                                                          string
  ;
  AllTools: TBVToolArray;
  I, FoundIndex: Integer;
  ToolRecord: TBVTool;
  Zip: TZipper;
  FS: TFileStream;
  FileSizeKB: Double;
  Dummy: string;

Procedure AddDirToZip(Const RootDir, SubDir: String);

Var 
  SR: TSearchRec;
  CurrentPath, EntryDisk, EntryArchive, Ext: string;
Begin
  CurrentPath := RootDir;
  If SubDir <> '' Then
    CurrentPath := CurrentPath + StringReplace(SubDir, '/', DirectorySeparator,
                   [rfReplaceAll]) + DirectorySeparator;
  If FindFirst(CurrentPath + '*', faAnyFile, SR) = 0 Then
    Begin
      Repeat
        If (SR.Name <> '.') And (SR.Name <> '..') And (SR.Name <> '.git') And (
           SR.Name <> 'node_modules') And (SR.Name <> 'dist') Then
          Begin
            If (SR.Attr And faDirectory) <> 0 Then
              Begin
                If SubDir = '' Then
                  AddDirToZip(RootDir, SR.Name)
                Else
                  AddDirToZip(RootDir, SubDir + '/' + SR.Name);
              End
            Else
              Begin
                Ext := LowerCase(ExtractFileExt(SR.Name));
                If (Ext <> '.o') And (Ext <> '.ppu') And (Ext <> '.tmp') And (
                   Ext <> '.zip') Then
                  Begin
                    EntryDisk := CurrentPath + SR.Name;
                    If SubDir = '' Then
                      EntryArchive := ToolName + '/' + SR.Name
                    Else
                      EntryArchive := ToolName + '/' + SubDir + '/' + SR.Name;
                    Zip.Entries.AddFileEntry(EntryDisk, EntryArchive);
                  End;
              End;
          End;
      Until FindNext(SR) <> 0;
      FindClose(SR);
    End;
End;
Begin
  BaseDir := '';
  If TargetArg <> '' Then
    Begin
      If DirectoryExists(TargetArg) Then
        BaseDir := IncludeTrailingPathDelimiter(ExpandFileName(TargetArg))
      Else
        Begin
          AllTools := DiscoverAllTools;
          FoundIndex := -1;
          For I := 0 To High(AllTools) Do
            Begin
              If (LowerCase(AllTools[I].Name) = LowerCase(TargetArg)) Or
                 (AllTools[I].Name = 'blaise-' + LowerCase(TargetArg)) Or
                 ((LowerCase(TargetArg) = 'vscode') And (AllTools[I].Name =
                 'blaise-vscode')) Then
                Begin
                  FoundIndex := I;
                  Break;
                End;
            End;
          If FoundIndex >= 0 Then
            BaseDir := IncludeTrailingPathDelimiter(AllTools[FoundIndex].DirPath
                       );
        End;
    End;

  If BaseDir = '' Then
    BaseDir := IncludeTrailingPathDelimiter(GetCurrentDir);

  If Not FileExists(BaseDir + 'tool.json') Then
    Begin
      WriteLn('Error: Manifest file tool.json not found in: ' + BaseDir);
      Exit;
    End;

  If Not LoadToolFromDir(BaseDir, True, ToolRecord) Then
    Begin
      WriteLn('Error: Failed to parse tool.json in: ' + BaseDir);
      Exit;
    End;

  ToolName := ToolRecord.Name;
  ToolVersion := ToolRecord.Version;
  If ToolVersion = '' Then ToolVersion := '1.0.0';

  If ToolRecord.PackScript <> '' Then
    Begin
      WriteLn('Executing tool pack script (' + ToolRecord.PackScript + ')...');
      RunToolScript(BaseDir, ToolRecord.PackScript, Dummy, False);
      Exit;
    End;

  DistDir := BaseDir + 'dist' + DirectorySeparator;
  ForceDir(DistDir);
  ZipFile := DistDir + ToolName + '-' + ToolVersion + '.zip';
  If FileExists(ZipFile) Then DeleteFile(ZipFile);

  WriteLn('Assembling release artifact: ' + ExtractFileName(ZipFile) + ' ...');
  Zip := TZipper.Create;
  Try
    Zip.FileName := ZipFile;
    AddDirToZip(BaseDir, '');
    Zip.ZipAllFiles;
  Finally
    Zip.Free;
End;

If Not FileExists(ZipFile) Then
  Begin
    WriteLn('Error: Failed to create tool archive: ' + ZipFile);
    Exit;
  End;

HashStr := FileSHA256(ZipFile);
ChecksumFile := ZipFile + '.sha256';
WriteStringToFile(ChecksumFile, HashStr + ' *' + ExtractFileName(ZipFile) +
LineEnding);

FileSizeKB := 0.0;
FS := TFileStream.Create(ZipFile, fmOpenRead Or fmShareDenyNone);
Try
  FileSizeKB := FS.Size / 1024.0;
Finally
  FS.Free;
End;

WriteLn('');
WriteLn('============================================================');
WriteLn('  [BlaiseVue Tool Packager]');
WriteLn('============================================================');
WriteLn('  Tool:        ' + ToolName + ' @ v' + ToolVersion);
WriteLn('  Type:        ' + ToolOriginLabel(ToolRecord.Origin));
WriteLn('  Archive:     dist/' + ExtractFileName(ZipFile));
WriteLn('  Size:        ' + FloatToStrF(FileSizeKB, ffFixed, 8, 2) + ' KB');
WriteLn('  SHA-256:     ' + HashStr);
WriteLn('  Checksum:    dist/' + ExtractFileName(ChecksumFile));
WriteLn('============================================================');
WriteLn('Tool successfully assembled and verified!');
WriteLn('');
End;

Procedure ResolveToolExecCommand(Const ToolRecord: TBVTool; out ExePath,
                                 RunnerCmd: String);

Var 
  Ext, PyExe, PyVer, IfpcExe, IfpcVer, DummyDesc: string;
Begin
  ExePath := '';
  RunnerCmd := '';

  // 1. Explicit bin declared in tool.json
  If ToolRecord.BinPath <> '' Then
    Begin
      If FileExists(IncludeTrailingPathDelimiter(ToolRecord.DirPath) +
         ToolRecord.BinPath) Then
        ExePath := IncludeTrailingPathDelimiter(ToolRecord.DirPath) + ToolRecord
                   .BinPath
      Else If FileExists(ToolRecord.BinPath) Then
             ExePath := ToolRecord.BinPath;
    End;

  // 2. Auto-detection heuristics
  If ExePath = '' Then
    Begin
      If FileExists(IncludeTrailingPathDelimiter(ToolRecord.DirPath) +
         ToolRecord.Name + '.exe') Then
        ExePath := IncludeTrailingPathDelimiter(ToolRecord.DirPath) + ToolRecord
                   .Name + '.exe'
      Else If FileExists(IncludeTrailingPathDelimiter(ToolRecord.DirPath) +
              ToolRecord.Name) Then
             ExePath := IncludeTrailingPathDelimiter(ToolRecord.DirPath) +
                        ToolRecord.Name
      Else If FileExists(IncludeTrailingPathDelimiter(ToolRecord.DirPath) +
              'bin' + DirectorySeparator + ToolRecord.Name + '.exe') Then
             ExePath := IncludeTrailingPathDelimiter(ToolRecord.DirPath) + 'bin'
                        + DirectorySeparator + ToolRecord.Name + '.exe'
      Else If FileExists(IncludeTrailingPathDelimiter(ToolRecord.DirPath) +
              'bin' + DirectorySeparator + ToolRecord.Name) Then
             ExePath := IncludeTrailingPathDelimiter(ToolRecord.DirPath) + 'bin'
                        + DirectorySeparator + ToolRecord.Name
      Else If FileExists(IncludeTrailingPathDelimiter(ToolRecord.DirPath) +
              'run.py') Then
             ExePath := IncludeTrailingPathDelimiter(ToolRecord.DirPath) +
                        'run.py'
      Else If FileExists(IncludeTrailingPathDelimiter(ToolRecord.DirPath) +
              'main.py') Then
             ExePath := IncludeTrailingPathDelimiter(ToolRecord.DirPath) +
                        'main.py'
      Else If FileExists(IncludeTrailingPathDelimiter(ToolRecord.DirPath) +
              'run.pas') Then
             ExePath := IncludeTrailingPathDelimiter(ToolRecord.DirPath) +
                        'run.pas'
      Else If FileExists(IncludeTrailingPathDelimiter(ToolRecord.DirPath) +
              'cli.js') Then
             ExePath := IncludeTrailingPathDelimiter(ToolRecord.DirPath) +
                        'cli.js'
      Else If FileExists(IncludeTrailingPathDelimiter(ToolRecord.DirPath) +
              'index.js') Then
             ExePath := IncludeTrailingPathDelimiter(ToolRecord.DirPath) +
                        'index.js';
    End;

  If ExePath = '' Then Exit;

  Ext := LowerCase(ExtractFileExt(ExePath));
  If Ext = '.py' Then
    Begin
      If FindPythonExecutable(PyExe, PyVer, DummyDesc) Then
        RunnerCmd := PyExe
      Else
        RunnerCmd := 'python';
    End
  Else If Ext = '.pas' Then
         Begin
           If FindInstantFPCExecutable(IfpcExe, IfpcVer, DummyDesc) Then
             RunnerCmd := IfpcExe
           Else
             RunnerCmd := 'instantfpc';
         End
  Else If Ext = '.js' Then
         RunnerCmd := 'node';
End;

Function ExecuteToolWithArgs(Const ToolRecord: TBVTool; Const WorkDir: String;
                             Const ExplicitArgs: Array Of String): Integer;

Var 
  ExePath, RunnerCmd, FullArgs, Arg, FullCmdLine, OldDir: string;
  I: Integer;
Begin
  ResolveToolExecCommand(ToolRecord, ExePath, RunnerCmd);
  If ExePath = '' Then
    Begin
      WriteLn('Error: No executable or main entry script detected for tool "' +
              ToolRecord.Name + '".');
      WriteLn('Hint: Specify a "bin" or "main" property in ' +
              IncludeTrailingPathDelimiter(ToolRecord.DirPath) + 'tool.json.');
      Exit(1);
    End;

  FullArgs := '';
  For I := 0 To High(ExplicitArgs) Do
    Begin
      Arg := ExplicitArgs[I];
      If Pos(' ', Arg) > 0 Then
        Arg := '"' + Arg + '"';
      If FullArgs = '' Then
        FullArgs := Arg
      Else
        FullArgs := FullArgs + ' ' + Arg;
    End;

  If RunnerCmd <> '' Then
    Begin
      If FullArgs <> '' Then
        FullCmdLine := RunnerCmd + ' "' + ExePath + '" ' + FullArgs
      Else
        FullCmdLine := RunnerCmd + ' "' + ExePath + '"';
    End
  Else
    Begin
      If FullArgs <> '' Then
        FullCmdLine := '"' + ExePath + '" ' + FullArgs
      Else
        FullCmdLine := '"' + ExePath + '"';
    End;

  OldDir := GetCurrentDir;
  Try
    If (WorkDir <> '') And DirectoryExists(WorkDir) Then
      SetCurrentDir(WorkDir);
    {$IFDEF WINDOWS}
    Result := ExecuteProcess('cmd', '/c ' + FullCmdLine);
    {$ELSE}
    Result := ExecuteProcess('/bin/sh', '-c "' + StringReplace(FullCmdLine, '"',
              '\"', [rfReplaceAll]) + '"');
    {$ENDIF}
  Finally
    SetCurrentDir(OldDir);
End;
End;

Procedure ExecuteToolInstance(Const ToolRecord: TBVTool; StartParamIdx: Integer)
;

Var 
  ArgsArr: array Of string;
  I, Cnt, ExitCode: Integer;
Begin
  Cnt := 0;
  If StartParamIdx <= ParamCount Then
    Begin
      SetLength(ArgsArr, ParamCount - StartParamIdx + 1);
      For I := StartParamIdx To ParamCount Do
        Begin
          ArgsArr[Cnt] := ParamStr(I);
          Inc(Cnt);
        End;
    End
  Else
    SetLength(ArgsArr, 0);

  ExitCode := ExecuteToolWithArgs(ToolRecord, '', ArgsArr);
  If ExitCode <> 0 Then
    Halt(ExitCode);
End;




{ Executes an installed developer tool CLI or script (bv tool run <name> [args...]). }
Procedure CmdToolRun(Const TargetNameArg: String);

Var 
  TargetLower: string;
  AllTools: TBVToolArray;
  FoundIndex, I: Integer;
Begin
  TargetLower := LowerCase(Trim(TargetNameArg));
  If TargetLower = '' Then
    Begin
      WriteLn('Error: Tool name is required.');
      WriteLn('Usage: bv tool run <tool-name> [arguments...]');
      Exit;
    End;

  AllTools := DiscoverAllTools;
  FoundIndex := -1;
  For I := 0 To High(AllTools) Do
    Begin
      If (LowerCase(AllTools[I].Name) = TargetLower) Or
         (LowerCase(AllTools[I].Name) = 'blaise-' + TargetLower) Or
         ('blaise-' + LowerCase(AllTools[I].Name) = TargetLower) Then
        Begin
          FoundIndex := I;
          Break;
        End;
    End;

  If FoundIndex < 0 Then
    Begin
      WriteLn('Error: Developer tool "' + TargetNameArg + '" is not installed.')
      ;
      WriteLn(


     'Hint: Run "bv tool list" to inspect installed tools, or "bv tool install '
              + TargetNameArg + '" to download it.');
      Exit;
    End;

  ExecuteToolInstance(AllTools[FoundIndex], 4);
End;

Function FindInstalledToolByAlias(Const AliasName: String; out FoundTool:
                                  TBVTool): Boolean;

Var 
  AllToolsList: TBVToolArray;
  I, MatchedIdx, J: Integer;
  ToolNameLower, CmdLower, TargetJson, ManifestContent, AliasVal: string;
  JsonData: TJSONData;
  JsonObj: TJSONObject;
  AliasesArr: TJSONArray;
Begin
  Result := False;
  CmdLower := LowerCase(Trim(AliasName));
  If CmdLower = '' Then Exit;

  AllToolsList := DiscoverAllTools;
  MatchedIdx := -1;

  For I := 0 To High(AllToolsList) Do
    Begin
      ToolNameLower := LowerCase(AllToolsList[I].Name);




// 1. Direct name match or prefixed (e.g. tool "blaise-horse", user typed "horse")
      If (ToolNameLower = CmdLower) Or
         (ToolNameLower = 'blaise-' + CmdLower) Or
         ('blaise-' + ToolNameLower = CmdLower) Then
        Begin
          MatchedIdx := I;
          Break;
        End;

      // 2. Check tool.json for "command", "alias", or "aliases"
      TargetJson := IncludeTrailingPathDelimiter(AllToolsList[I].DirPath) +
                    'tool.json';
      If FileExists(TargetJson) Then
        Begin
          Try
            ManifestContent := ReadFileToString(TargetJson);
            If ManifestContent <> '' Then
              Begin
                JsonData := GetJSON(ManifestContent);
                Try
                  If JsonData is TJSONObject Then
                    Begin
                      JsonObj := TJSONObject(JsonData);
                      If JsonObj.Find('command') <> Nil Then
                        Begin
                          AliasVal := LowerCase(JsonObj.Get('command', ''));
                          If AliasVal = CmdLower Then
                            Begin
                              MatchedIdx := I;
                              Break;
                            End;
                        End;
                      If JsonObj.Find('alias') <> Nil Then
                        Begin
                          AliasVal := LowerCase(JsonObj.Get('alias', ''));
                          If AliasVal = CmdLower Then
                            Begin
                              MatchedIdx := I;
                              Break;
                            End;
                        End;
                      If JsonObj.Find('aliases') <> Nil Then
                        Begin
                          If JsonObj.Types['aliases'] = jtArray Then
                            Begin
                              AliasesArr := JsonObj.Arrays['aliases'];
                              For J := 0 To AliasesArr.Count - 1 Do
                                Begin
                                  If LowerCase(AliasesArr.Strings[J]) = CmdLower
                                    Then
                                    Begin
                                      MatchedIdx := I;
                                      Break;
                                    End;
                                End;
                              If MatchedIdx >= 0 Then Break;
                            End;
                        End;
                    End;
                Finally
                  JsonData.Free;
              End;
        End;
    Except
      // Ignore JSON parsing errors for faulty external tools
End;
End;
End;

If MatchedIdx >= 0 Then
  Begin
    FoundTool := AllToolsList[MatchedIdx];
    Result := True;
  End;
End;




{ Dynamically resolves and dispatches commands to installed developer tools (e.g. "bv horse" -> blaise-horse).
  Supports exact name, "blaise-" prefix, and aliases declared in tool.json ("command" or "aliases"). }
Function TryDispatchExternalTool(Const ACmd: String; StartParamIdx: Integer):


                                                                         Boolean
;

Var 
  FoundTool: TBVTool;
Begin
  Result := FindInstalledToolByAlias(ACmd, FoundTool);
  If Result Then
    ExecuteToolInstance(FoundTool, StartParamIdx);
End;




{ Initializes an external backend tool inside WorkDir by invoking its "init" command dynamically.
  Returns 0 on success, 1 if the tool is not installed, or >1 / <0 on tool execution error. }
Function InitExternalBackendTool(Const BackendName, WorkDir: String; out
                                 FoundToolName: String): Integer;

Var 
  ExtTool: TBVTool;
Begin
  FoundToolName := '';
  If Not FindInstalledToolByAlias(BackendName, ExtTool) Then
    Exit(1);
  FoundToolName := ExtTool.Name;
  WriteLn('  [*] Initializing external backend "', ExtTool.Name,
          '" via "init"...');
  Result := ExecuteToolWithArgs(ExtTool, WorkDir, ['init']);
  If Result = 1 Then Result := 2;
  // Keep 1 reserved for "tool not found"
End;




{ Creates a new tool project scaffold with tool.json and lifecycle scripts (bv tool init). }
Procedure CmdToolInit(Const NameArg: String; IsLocal: Boolean = False);

Var 
  ToolName, ToolDir, ManifestFile, ReadmeFile: string;
  RunScript, StatusScript, InstallScript, UpdateScript, RemoveScript: string;
Begin
  ToolName := LowerCase(Trim(NameArg));
  If ToolName = '' Then
    Begin
      WriteLn('Error: Tool name is required.');
      WriteLn('Usage: bv tool init <tool-name> [--local]');
      Exit;
    End;

  If IsLocal Then
    ToolDir := IncludeTrailingPathDelimiter(GetCurrentDir) + ToolName +
               DirectorySeparator
  Else
    ToolDir := GetGlobalToolsPath + ToolName + DirectorySeparator;

  If DirectoryExists(ToolDir) Then
    Begin
      WriteLn('Error: Directory already exists: ' + ToolDir);
      Exit;
    End;

  ForceDir(ToolDir);
  ManifestFile := ToolDir + 'tool.json';
  WriteStringToFile(ManifestFile,
                    '{' + LineEnding +
                    '  "name": "' + ToolName + '",' + LineEnding +
                    '  "version": "0.1.0",' + LineEnding +
                    '  "category": "Developer Tool",' + LineEnding +
                    '  "description": "Custom developer tool for BlaiseVue",' +
                    LineEnding +
                    '  "author": "Developer",' + LineEnding +
                    '  "license": "MIT",' + LineEnding +
                    '  "type": "third-party",' + LineEnding +
                    '  "bin": "run.py",' + LineEnding +
                    '  "scripts": {' + LineEnding +
                    '    "status": "status.py",' + LineEnding +
                    '    "install": "install.py",' + LineEnding +
                    '    "update": "update.py",' + LineEnding +
                    '    "remove": "remove.py"' + LineEnding +
                    '  }' + LineEnding +
                    '}' + LineEnding);

  ReadmeFile := ToolDir + 'README.md';
  WriteStringToFile(ReadmeFile,
                    '# ' + ToolName + LineEnding + LineEnding +
                    'Custom developer tool for BlaiseVue.' + LineEnding +
                    LineEnding +
                    '## Usage' + LineEnding +
                    '- Check status: `bv tool list`' + LineEnding +
                    '- Inspect details: `bv tool info ' + ToolName + '`' +
                    LineEnding +
                    '- Run tool CLI: `bv tool run ' + ToolName + ' [args...]`' +
                    LineEnding +
                    '- Package release: `bv tool pack ' + ToolName + '`' +
                    LineEnding);

  RunScript := ToolDir + 'run.py';
  WriteStringToFile(RunScript,
                    '#!/usr/bin/env python3' + LineEnding +
                    'import sys' + LineEnding + LineEnding +
                    'print(f"[{' + '''' + ToolName + '''' +
                    '}] Tool CLI running...")' + LineEnding +
                    'if len(sys.argv) > 1:' + LineEnding +
                    '    print("Arguments:", sys.argv[1:])' + LineEnding);

  StatusScript := ToolDir + 'status.py';
  WriteStringToFile(StatusScript,
                    '#!/usr/bin/env python3' + LineEnding +
                    'print("Active (v0.1.0)")' + LineEnding);

  InstallScript := ToolDir + 'install.py';
  WriteStringToFile(InstallScript,
                    '#!/usr/bin/env python3' + LineEnding +
                    'print("Setting up ' + ToolName + '...")' + LineEnding +
                    'print("Installed successfully.")' + LineEnding);

  UpdateScript := ToolDir + 'update.py';
  WriteStringToFile(UpdateScript,
                    '#!/usr/bin/env python3' + LineEnding +
                    'print("Updating ' + ToolName + '...")' + LineEnding);

  RemoveScript := ToolDir + 'remove.py';
  WriteStringToFile(RemoveScript,
                    '#!/usr/bin/env python3' + LineEnding +
                    'print("Cleaning up ' + ToolName + '...")' + LineEnding);

  WriteLn('');
  WriteLn('============================================================');
  WriteLn('  [Tool Scaffold Initialized]');
  WriteLn('============================================================');
  WriteLn('  Tool:        ' + ToolName + ' (v0.1.0)');
  WriteLn('  Location:    ' + ToolDir);
  WriteLn('  Type:        [Third-Party]');
  WriteLn('  Manifest:    tool.json');
  WriteLn('  Entry Bin:   run.py (bv tool run ' + ToolName + ')');
  WriteLn('============================================================');
  WriteLn('To test your tool immediately, run:');
  WriteLn('  bv tool list');
  WriteLn('  bv tool run ' + ToolName);
  WriteLn('  bv tool info ' + ToolName);
  WriteLn('');
End;

{ Unified developer tool manager (bv tool). }
Procedure CmdTool(Const Action: String = ''; Const Target: String = ''; Const
                  ExtraArg: String = '');

Var 
  SubCmd: string;
Begin
  SubCmd := LowerCase(Trim(Action));
  If (SubCmd = '') Or (SubCmd = 'list') Or (SubCmd = 'ls') Then
    CmdToolList
  Else If (SubCmd = 'search') Or (SubCmd = 'find') Then
         CmdToolSearch(Target)
  Else If (SubCmd = 'info') Or (SubCmd = 'show') Or (SubCmd = 'view') Then
         CmdToolInfo(Target)
  Else If (SubCmd = 'install') Or (SubCmd = 'i') Or (SubCmd = 'add') Then
         CmdToolInstall(Target)
  Else If (SubCmd = 'outdated') Or (SubCmd = 'check') Then
         CmdToolOutdated
  Else If (SubCmd = 'update') Or (SubCmd = 'up') Or (SubCmd = 'upgrade') Then
         CmdToolUpdate(Target)
  Else If (SubCmd = 'remove') Or (SubCmd = 'rm') Or (SubCmd = 'uninstall') Then
         CmdToolRemove(Target)
  Else If (SubCmd = 'pack') Or (SubCmd = 'package') Or (SubCmd = 'pkg') Then
         CmdToolPack(Target)
  Else If (SubCmd = 'init') Or (SubCmd = 'create') Or (SubCmd = 'new') Then
         CmdToolInit(Target, SameText(ExtraArg, '--local') or SameText(ParamStr(
                                                                       4),
         '--local'))
  Else If (SubCmd = 'run') Or (SubCmd = 'exec') Then
         CmdToolRun(Target)
  Else
    Begin
      WriteLn('Unknown subcommand: bv tool ' + SubCmd);
      WriteLn(


'Usage: bv tool <list|search|info|install|run|update|outdated|remove|pack|init> [params]'
      );
    End;
End;




{ Ensures Android Gradle compatibility with Java 17 LTS and configures signingConfig for local release testing. }
Function EnsureAndroidGradleCompatibility(Const AAndroidDir: String): Boolean;

Var 
  BuildGradlePath, AppBuildGradlePath, CapBuildGradlePath, KeystoreExamplePath,
  GitIgnorePath: string;
  LocalPropsPath, SdkPath, EscapedSdkPath: string;
  Content: string;
  Updated: Boolean;
Begin
  Result := False;
  If (AAndroidDir = '') Or Not DirectoryExists(AAndroidDir) Then Exit;

  // 0. Auto-generate local.properties with sdk.dir
  LocalPropsPath := AAndroidDir + DirectorySeparator + 'local.properties';
  If Not FileExists(LocalPropsPath) Then
    Begin
      SdkPath := FindAndroidSdkPath;
      If SdkPath <> '' Then
        Begin
          EscapedSdkPath := StringReplace(SdkPath, '\', '\\', [rfReplaceAll]);
          EscapedSdkPath := StringReplace(EscapedSdkPath, ':', '\:', [
                            rfReplaceAll]);
          WriteStringToFile(LocalPropsPath, 'sdk.dir=' + EscapedSdkPath + #13#10
          );
          Result := True;
        End;
    End;

  // 1. Root build.gradle
  BuildGradlePath := AAndroidDir + DirectorySeparator + 'build.gradle';
  If FileExists(BuildGradlePath) Then
    Begin
      Content := ReadFileToString(BuildGradlePath);
      Updated := False;
      If Pos('VERSION_21', Content) > 0 Then
        Begin
          Content := StringReplace(Content, 'VERSION_21', 'VERSION_17', [
                     rfReplaceAll]);
          Updated := True;
        End;
      If Pos('subprojects', Content) = 0 Then
        Begin
          Content := Content + #13#10 +
                     'subprojects {' + #13#10 +
                     '    afterEvaluate { project ->' + #13#10 +
                     '        if (project.hasProperty("android")) {' + #13#10 +
                     '            android {' + #13#10 +
                     '                compileOptions {' + #13#10 +



                '                    sourceCompatibility JavaVersion.VERSION_17'
                     + #13#10 +



                '                    targetCompatibility JavaVersion.VERSION_17'
                     + #13#10 +
                     '                }' + #13#10 +
                     '            }' + #13#10 +
                     '        }' + #13#10 +



'        if (project.plugins.hasPlugin("org.jetbrains.kotlin.android") || project.plugins.hasPlugin("kotlin-android")) {'
                     + #13#10 +
                     '            kotlin {' + #13#10 +
                     '                jvmToolchain(17)' + #13#10 +
                     '            }' + #13#10 +
                     '        }' + #13#10 +
                     '    }' + #13#10 +
                     '}' + #13#10;
          Updated := True;
        End;
      If Updated Then
        Begin
          WriteStringToFile(BuildGradlePath, Content);
          Result := True;
        End;
    End;

  // 2. app/build.gradle
  AppBuildGradlePath := AAndroidDir + DirectorySeparator + 'app' +
                        DirectorySeparator + 'build.gradle';
  If FileExists(AppBuildGradlePath) Then
    Begin
      Content := ReadFileToString(AppBuildGradlePath);
      Updated := False;
      If Pos('VERSION_21', Content) > 0 Then
        Begin
          Content := StringReplace(Content, 'VERSION_21', 'VERSION_17', [
                     rfReplaceAll]);
          Updated := True;
        End;

      // Ensure signingConfigs with keystore.properties fallback
      If (Pos('signingConfigs', Content) = 0) Or (Pos('keystore.properties',
         Content) = 0) Then
        Begin
          If Pos('signingConfig signingConfigs.debug', Content) > 0 Then
            Begin
              Content := StringReplace(Content,
                         'signingConfig signingConfigs.debug',



                     'if (rootProject.file(''keystore.properties'').exists()) {'
                         + #13#10 +
                         '                signingConfig signingConfigs.release'
                         + #13#10 +
                         '            } else {' + #13#10 +
                         '                signingConfig signingConfigs.debug' +
                         #13#10 +
                         '            }', []);
              Updated := True;
            End;

          If (Pos('signingConfigs {', Content) = 0) And (Pos('buildTypes {',
             Content) > 0) Then
            Begin
              Content := StringReplace(Content, 'buildTypes {',
                         'signingConfigs {' + #13#10 +
                         '        release {' + #13#10 +



         '            if (rootProject.file(''keystore.properties'').exists()) {'
                         + #13#10 +



                     '                def keystoreProperties = new Properties()'
                         + #13#10 +



'                keystoreProperties.load(new FileInputStream(rootProject.file(''keystore.properties'')))'
                         + #13#10 +



             '                storeFile file(keystoreProperties[''storeFile''])'
                         + #13#10 +



           '                storePassword keystoreProperties[''storePassword'']'
                         + #13#10 +



                     '                keyAlias keystoreProperties[''keyAlias'']'
                         + #13#10 +



               '                keyPassword keystoreProperties[''keyPassword'']'
                         + #13#10 +
                         '            }' + #13#10 +
                         '        }' + #13#10 +
                         '    }' + #13#10 +
                         '    buildTypes {', []);
              Updated := True;
            End;
        End;

      If Updated Then
        Begin
          WriteStringToFile(AppBuildGradlePath, Content);
          Result := True;
        End;
    End;

  // 3. app/capacitor.build.gradle
  CapBuildGradlePath := AAndroidDir + DirectorySeparator + 'app' +
                        DirectorySeparator + 'capacitor.build.gradle';
  If FileExists(CapBuildGradlePath) Then
    Begin
      Content := ReadFileToString(CapBuildGradlePath);
      If Pos('VERSION_21', Content) > 0 Then
        Begin
          Content := StringReplace(Content, 'VERSION_21', 'VERSION_17', [
                     rfReplaceAll]);
          WriteStringToFile(CapBuildGradlePath, Content);
          Result := True;
        End;
    End;

  // 4. Ensure keystore.properties.example template exists
  KeystoreExamplePath := AAndroidDir + DirectorySeparator +
                         'keystore.properties.example';
  If Not FileExists(KeystoreExamplePath) Then
    Begin
      WriteStringToFile(KeystoreExamplePath,
                        '# BlaiseVue Production Android Keystore Configuration'
                        + #13#10 +



'# Copy this file to keystore.properties and fill in your production credentials.'
                        + #13#10 +



   '# NEVER commit keystore.properties or your private .jks / .keystore to Git!'
                        + #13#10 +
                        '#' + #13#10 +
                        '# storeFile=my-release-key.jks' + #13#10 +
                        '# storePassword=YourStorePassword' + #13#10 +
                        '# keyAlias=my-key-alias' + #13#10 +
                        '# keyPassword=YourKeyPassword' + #13#10);
    End;

  // 5. Ensure .gitignore protects keystore secrets
  GitIgnorePath := AAndroidDir + DirectorySeparator + '.gitignore';
  If FileExists(GitIgnorePath) Then
    Begin
      Content := ReadFileToString(GitIgnorePath);
      If Pos('keystore.properties', Content) = 0 Then
        Begin
          Content := Content + #13#10 +
                     '# Keystore & Production Secrets' + #13#10 +
                     'keystore.properties' + #13#10 +
                     '*.jks' + #13#10 +
                     '*.keystore' + #13#10;
          WriteStringToFile(GitIgnorePath, Content);
        End;
    End;
End;




{ Mobile application compiler and device orchestrator targeting Android and iOS (bv capacitor). }
Procedure CmdCapacitor(Const SubCmd: String; Const Arg1: String = ''; Const Arg2
                       : String = '');

Var 
  MobileDir, BinDir, AndroidDir, IOSDir: string;
  CapConfigFile, MobileCapConfigFile: string;
  ActualAppName, ActualAppId, ConfigContent, ReadmeFile, ReadmeContent: string;
  ExistingConfig, CleanName, TargetPlatform, SelectedAVD, EmulatorAction: string
  ;
  RequestedCapVersion, CapTag, CapVerDisplay: string;
  PkgJsonFile, PkgContent, CurrentCapVer, LatestCapVer, ExtraPkgs: string;
  VersionsDir, ItemPath, UserChoice, VersionCacheDir: string;
  ChoiceIdx, Count: Integer;
  SizeBytes: Int64;
  SR: TSearchRec;
  IsRelease, IsAllTargets, UseEmulator, IsBundle, IsCheckOnly, IsFreshEmulator,
  IsNoBuild, IsForceInit, NeedsAndroidRecreate: Boolean;
  GradleText: string;
  AvdList: TStringList;
  i: Integer;
{ Locates the Android SDK emulator executable on the host system. }
Function FindAndroidEmulator: string;

Var 
  EmuExe, EmuSrc, DummyList: string;
  DummyCount: Integer;
Begin
  If FindAndroidEmulatorInfo(EmuExe, EmuSrc, DummyCount, DummyList) And (EmuExe
     <> '') Then
    Result := EmuExe
  Else
    Result := 'emulator' + {$IFDEF WINDOWS}'.exe'{$ELSE}''{$ENDIF};
End;

Function FindAndroidADB: string;

Var 
  AdbExe, AdbVer, AdbSrc: string;
Begin
  If FindAndroidADBInfo(AdbExe, AdbVer, AdbSrc) And (AdbExe <> '') Then
    Result := AdbExe
  Else
    Result := 'adb' + {$IFDEF WINDOWS}'.exe'{$ELSE}''{$ENDIF};
End;

Function GetInstalledAVDs: TStringList;

Var 
  EmulatorExe, CmdOutput, Line: string;
  RawList: TStringList;
  j: Integer;
  RunSuccess: Boolean;
Begin
  Result := TStringList.Create;
  EmulatorExe := FindAndroidEmulator;
  CmdOutput := '';
    {$IFDEF WINDOWS}

  RunSuccess := RunCommand('cmd.exe', ['/c', '"' + EmulatorExe + '" -list-avds']
                , CmdOutput);
    {$ELSE}

  RunSuccess := RunCommand(EmulatorExe, ['-list-avds'], CmdOutput);
    {$ENDIF}

  If RunSuccess Then
    Begin
      RawList := TStringList.Create;
      Try

        RawList.Text := CmdOutput;
        For j := 0 To RawList.Count - 1 Do
          Begin
            Line := Trim(RawList[j]);
            If (Line <> '') And (Pos('INFO', Line) <> 1) And (Pos('WARNING',
               Line) <> 1) And (Pos('ERROR', Line) <> 1) Then
              Result.Add(Line);
          End;

      Finally

        RawList.Free;
    End;
End;
End;

{ Launches an Android Virtual Device (AVD) emulator in the background. }
Function StartEmulator(Const SpecificAVD: String = ''): Boolean;

Var 
  EmulatorExe, TargetAVD: string;
  List: TStringList;
Begin
  Result := False;
  EmulatorExe := FindAndroidEmulator;
  TargetAVD := SpecificAVD;
  If TargetAVD = '' Then
    Begin
      List := GetInstalledAVDs;
      Try

        If List.Count > 0 Then
          TargetAVD := List[0]
        Else
          Begin
            WriteLn('  [ERROR] No Android Virtual Device (AVD) found.');
            WriteLn(


 '          Open Android Studio > Virtual Device Manager to create an emulator.'
            );
            Exit(False);
          End;

      Finally

        List.Free;
    End;
End;

WriteLn('  [+] Starting Android Emulator: ' + TargetAVD + ' ...');
    {$IFDEF WINDOWS}

ExecuteProcess('cmd', '/c set "PATH=' + ExtractFileDir(FindAndroidADB) +
';%PATH%" && start "" "' + EmulatorExe + '" -avd ' + TargetAVD +
' -no-snapshot-load');

    {$ELSE}

ExecuteProcess('/bin/sh', '-c "export PATH=\"' + ExtractFileDir(FindAndroidADB)
+ ':$PATH\" && ' + EmulatorExe + ' -avd ' + TargetAVD + ' >/dev/null 2>&1 &"');
    {$ENDIF}

Result := True;
End;

Procedure KillAndroidEmulator;

Var 
  AdbExe, OutText: string;
Begin
  WriteLn('  [+] Stopping Android Emulator instances...');
  AdbExe := FindAndroidADB;
  ExecCmdCapture('"' + AdbExe + '" -e emu kill 2>&1', OutText);
  Sleep(500);
    {$IFDEF WINDOWS}
  ExecCmdCapture(


               'taskkill /F /IM qemu-system-x86_64.exe /IM emulator.exe /T 2>&1'
                 , OutText);
    {$ELSE}
  ExecCmdCapture('pkill -9 -f "qemu-system|emulator" 2>&1', OutText);
    {$ENDIF}
  WriteLn('  [v] Android Emulator processes stopped.');
End;

  { Parses an individual command line option flag or positional parameter. }
Procedure ParseArg(Const A: String);

Var 
  S: string;
Begin
  S := LowerCase(A);
  If S = '' Then Exit;
  If (S = '--release') Or (S = '-r') Or (S = 'release') Then
    IsRelease := True
  Else If (S = '--bundle') Or (S = '--aab') Or (S = 'bundle') Or (S = 'aab')
         Then
         Begin
           IsBundle := True;
           IsRelease := True;
         End
  Else If (S = '--debug') Or (S = '-d') Or (S = 'debug') Then
         IsRelease := False
  Else If (S = 'android') Or (S = '--android') Or (S = '--target=android') Then
         TargetPlatform := 'android'
  Else If (S = 'ios') Or (S = '--ios') Or (S = '--target=ios') Then
         TargetPlatform := 'ios'
  Else If (S = 'all') Or (S = '--all') Or (S = '--target=all') Then
         IsAllTargets := True
  Else If (S = '--emulator') Or (S = '-e') Or (S = 'emulator') Then
         UseEmulator := True
  Else If S = '--fresh' Then
         IsFreshEmulator := True
  Else If (S = '--no-build') Then
         IsNoBuild := True
  Else If (S = '-f') Or (S = '--force') Then
         IsForceInit := True
  Else If (SubCmd = 'emulator') And (EmulatorAction = '') Then
         EmulatorAction := S
  Else If (UseEmulator Or (SubCmd = 'emulator')) And (SelectedAVD = '') And (
          Copy(S, 1, 1) <> '-') Then
         SelectedAVD := A
  Else If (ActualAppName = '') And (SubCmd = 'init') And (Copy(S, 1, 1) <> '-')
         Then
         ActualAppName := A
  Else If (ActualAppId = '') And (SubCmd = 'init') And (Copy(S, 1, 1) <> '-')
         Then
         ActualAppId := A
  Else If (SubCmd = 'upgrade') Or (SubCmd = 'migrate') Then
         Begin
           If (S = '--check') Or (S = '-c') Or (S = 'check') Then
             IsCheckOnly := True
           Else If (RequestedCapVersion = '') And (Copy(S, 1, 1) <> '-') Then
                  RequestedCapVersion := A;
         End;
End;




{ Fast regex/substring extractor for JSON properties without full parser overhead. }
Function ExtractJsonField(Const Content, Prop: String): string;

Var 
  P, Q, StartVal, EndVal: Integer;
Begin
  Result := '';
  P := Pos('"' + Prop + '"', Content);
  If P <= 0 Then Exit;
  Q := PosEx(':', Content, P);
  If Q <= 0 Then Exit;
  StartVal := PosEx('"', Content, Q);
  If StartVal <= 0 Then Exit;
  EndVal := PosEx('"', Content, StartVal + 1);
  If EndVal <= 0 Then Exit;
  Result := Copy(Content, StartVal + 1, EndVal - StartVal - 1);
End;

{ Compiles native binary artifacts for a specified platform target. }
Function BuildSingleTarget(Const ATarget: String; ARelease: Boolean; ABundle:
                           Boolean = False): Boolean;

Var 
  TBinDir, SourceApk, TargetApk, AltApk, SourceAab, TargetAab: string;
  BestJavaHome, BestJavaVer, BestJavaSource, JavaPrefix, SdkPath: string;
Begin
  Result := False;
  TBinDir := BinDir + DirectorySeparator + ATarget;
  ForceDir(TBinDir);
  If ATarget = 'android' Then
    Begin
      If Not DirectoryExists(AndroidDir) Then
        Begin
          WriteLn('  [ERROR] Android native project not found at: ' + AndroidDir
          );
          WriteLn('          Run "bv capacitor init" first.');
          Exit(False);
        End;

      EnsureAndroidGradleCompatibility(AndroidDir);

      If ABundle Then
        WriteLn(


'  [+] Compiling Android App Bundle (AAB) for Google Play (Gradle bundleRelease)...'
        )
      Else If ARelease Then
             WriteLn(


       '  [+] Compiling Android APK in RELEASE mode (Gradle assembleRelease)...'
             )
      Else
        WriteLn(


           '  [+] Compiling Android APK in DEBUG mode (Gradle assembleDebug)...'
        );

      JavaPrefix := '';
      SdkPath := FindAndroidSdkPath;
      If SdkPath <> '' Then
        Begin
        {$IFDEF WINDOWS}
          JavaPrefix := 'set "ANDROID_HOME=' + SdkPath + '" && ';
        {$ELSE}
          JavaPrefix := 'export ANDROID_HOME="' + SdkPath + '" && ';
        {$ENDIF}
        End;
      If FindBestJavaHome(BestJavaHome, BestJavaVer, BestJavaSource) And (
         BestJavaHome <> '') Then
        Begin
        {$IFDEF WINDOWS}
          JavaPrefix := 'set "JAVA_HOME=' + BestJavaHome + '" && set "PATH=' +
                        BestJavaHome + '\bin;%PATH%" && ';
        {$ELSE}
          JavaPrefix := 'export JAVA_HOME="' + BestJavaHome +
                        '" && export PATH="' + BestJavaHome + '/bin:$PATH" && ';
        {$ENDIF}
        End;

      {$IFDEF WINDOWS}
      If ABundle Then
        ExecuteProcess('cmd', '/c ' + JavaPrefix + 'cd /d "' + AndroidDir +
                       '" && gradlew.bat bundleRelease')
      Else If ARelease Then
             ExecuteProcess('cmd', '/c ' + JavaPrefix + 'cd /d "' + AndroidDir +
                            '" && gradlew.bat assembleRelease')
      Else
        ExecuteProcess('cmd', '/c ' + JavaPrefix + 'cd /d "' + AndroidDir +
                       '" && gradlew.bat assembleDebug');
      {$ELSE}
      If ABundle Then
        ExecuteProcess('/bin/sh', '-c "' + JavaPrefix + 'cd ''' + AndroidDir +
                       ''' && ./gradlew bundleRelease"')
      Else If ARelease Then
             ExecuteProcess('/bin/sh', '-c "' + JavaPrefix + 'cd ''' +
                            AndroidDir + ''' && ./gradlew assembleRelease"')
      Else
        ExecuteProcess('/bin/sh', '-c "' + JavaPrefix + 'cd ''' + AndroidDir +
                       ''' && ./gradlew assembleDebug"');
      {$ENDIF}

      If ABundle Then
        Begin
          SourceAab := AndroidDir + DirectorySeparator + 'app' +
                       DirectorySeparator + 'build' + DirectorySeparator +
                       'outputs' + DirectorySeparator + 'bundle' +
                       DirectorySeparator + 'release' + DirectorySeparator +
                       'app-release.aab';
          TargetAab := TBinDir + DirectorySeparator + CleanName + '-release.aab'
          ;
          If FileExists(SourceAab) Then
            Begin
              CopyFile(SourceAab, TargetAab);
              Result := True;
              WriteLn(


     '  [SUCCESS] Google Play Android App Bundle generated: mobile/bin/android/'
                      + ExtractFileName(TargetAab));
              WriteLn(


    '  [INFO] Target: Google Play Console (Production / Internal Testing track)'
              );
              WriteLn(


                     '  [TIP] Upload bundle at: https://play.google.com/console'
              );
            End
          Else
            WriteLn('  [WARNING] Expected AAB was not found at: ' + SourceAab);
        End
      Else If ARelease Then
             Begin
               SourceApk := AndroidDir + DirectorySeparator + 'app' +
                            DirectorySeparator + 'build' + DirectorySeparator +
                            'outputs' + DirectorySeparator + 'apk' +
                            DirectorySeparator + 'release' + DirectorySeparator
                            + 'app-release.apk';
               AltApk := AndroidDir + DirectorySeparator + 'app' +
                         DirectorySeparator + 'build' + DirectorySeparator +
                         'outputs' + DirectorySeparator + 'apk' +
                         DirectorySeparator + 'release' + DirectorySeparator +
                         'app-release-unsigned.apk';
               TargetApk := TBinDir + DirectorySeparator + CleanName +
                            '-release.apk';
             End

      Else
        Begin
          SourceApk := AndroidDir + DirectorySeparator + 'app' +
                       DirectorySeparator + 'build' + DirectorySeparator +
                       'outputs' + DirectorySeparator + 'apk' +
                       DirectorySeparator + 'debug' + DirectorySeparator +
                       'app-debug.apk';
          AltApk := '';
          TargetApk := TBinDir + DirectorySeparator + CleanName + '-debug.apk';
        End;

      If Not ABundle Then
        Begin
          If Not FileExists(SourceApk) And (AltApk <> '') And FileExists(AltApk)
            Then
            SourceApk := AltApk;
          If FileExists(SourceApk) Then
            Begin
              CopyFile(SourceApk, TargetApk);
              Result := True;
              If ARelease Then
                WriteLn(


             '  [SUCCESS] Mobile Android package generated: mobile/bin/android/'
                        + ExtractFileName(TargetApk))
              Else
                Begin
                  WriteLn(


             '  [SUCCESS] Mobile Android package generated: mobile/bin/android/'
                          + ExtractFileName(TargetApk));
                  WriteLn(


'  [TIP] To install on your connected device: adb install -r "mobile/bin/android/'
                          + ExtractFileName(TargetApk) + '"');
                End;
            End
          Else
            WriteLn('  [WARNING] Expected APK was not found at: ' + SourceApk);
        End;
    End

  Else If ATarget = 'ios' Then
         Begin
      {$IFDEF DARWIN}

           WriteLn('  [+] Building iOS native package...');
           ExecuteProcess('/bin/sh', '-c "npx cap build ios"');
           Result := True;
           WriteLn('  [SUCCESS] iOS project built successfully in mobile/ios.');

      {$ELSE}

           WriteLn('  [i] Target platform is iOS.');
           WriteLn(


          '  [INFO] iOS native compilation requires macOS with Xcode installed.'
           );
           WriteLn(


'         Assets are synchronized and ready. On macOS, run "bv capacitor open ios" or "bv capacitor build ios".'
           );
           Result := True;
      {$ENDIF}
         End;
End;

Procedure RunTarget(Const ATarget: String);

Var 
  TargetApk, TBinDir, AdbExe, AdbOutput, AdbTarget: string;
  BootStatus, InstallOutput, LaunchOutput: string;
  BootAttempts, InstallAttempts: Integer;
  InstallSuccess: Boolean;
Begin
  If ATarget = 'android' Then
    Begin
      If DirectoryExists(AndroidDir) Then
        EnsureAndroidGradleCompatibility(AndroidDir);
      TBinDir := BinDir + DirectorySeparator + 'android';
      If IsRelease Then
        TargetApk := TBinDir + DirectorySeparator + CleanName + '-release.apk'
      Else
        TargetApk := TBinDir + DirectorySeparator + CleanName + '-debug.apk';
      If Not FileExists(TargetApk) Then
        Begin
          WriteLn('Target binary not found. Compiling first...');
          BuildSingleTarget('android', IsRelease);
        End;

      AdbExe := FindAndroidADB;
      AdbTarget := '';
      If UseEmulator Then
        Begin
          If IsFreshEmulator Then
            Begin
              WriteLn(


       '  [+] Fresh emulator requested (--fresh). Resetting active instances...'
              );
              KillAndroidEmulator;
              Sleep(1000);
            End;

          AdbTarget := '-e ';
          AdbOutput := '';
          ExecCmdCapture('"' + AdbExe + '" devices', AdbOutput);
          If Pos('emulator-', AdbOutput) = 0 Then
            Begin
              WriteLn(


               '  [+] No active emulator detected in ADB. Launching emulator...'
              );
              StartEmulator(SelectedAVD);
              WriteLn(


                '  [+] Waiting for emulator to boot (adb -e wait-for-device)...'
              );

          {$IFDEF WINDOWS}
              ExecuteProcess('cmd', '/c ' + AdbExe + ' -e wait-for-device');
          {$ELSE}
              ExecuteProcess('/bin/sh', '-c "' + AdbExe + ' -e wait-for-device"'
              );
          {$ENDIF}
            End
          Else
            Begin
              WriteLn(


    '  [i] Connected to active Android Emulator session in ADB (emulator-5554).'
              );
              WriteLn(


'      (Tip: If emulator window is hidden or stuck, run with --fresh to force restart)'
              );
            End;

          WriteLn(


        '  [+] Waiting for Android OS to finish booting (sys.boot_completed)...'
          );
          BootAttempts := 0;
          Repeat
            BootStatus := '';
            ExecCmdCapture('"' + AdbExe +
                           '" -e shell getprop sys.boot_completed', BootStatus);
            If Pos('1', Trim(BootStatus)) = 1 Then Break;
            Sleep(2000);
            Inc(BootAttempts);
          Until BootAttempts >= 45;
          Sleep(1500);

          WriteLn(


                '  [+] Waiting for Package Manager service (pm path android)...'
          );
          BootAttempts := 0;
          Repeat
            BootStatus := '';
            ExecCmdCapture('"' + AdbExe + '" -e shell pm path android',
                           BootStatus);
            If Pos('package:', BootStatus) > 0 Then Break;
            Sleep(1500);
            Inc(BootAttempts);
          Until BootAttempts >= 20;
          Sleep(1000);
        End

      Else
        Begin
          AdbOutput := '';
          ExecCmdCapture('"' + AdbExe + '" devices', AdbOutput);
          If (Pos('emulator-', AdbOutput) > 0) And (Pos(#10, Trim(AdbOutput)) >
             0) Then
            AdbTarget := '-d ';
        End;

      If FileExists(TargetApk) Then
        Begin
          If UseEmulator Then
            WriteLn('  [+] Installing APK on Android Emulator via ADB: ' +
                    ExtractFileName(TargetApk))
          Else
            WriteLn('  [+] Installing APK on Android device via ADB: ' +
                    ExtractFileName(TargetApk));

          InstallSuccess := False;
          InstallAttempts := 0;
          Repeat
            Inc(InstallAttempts);
            InstallOutput := '';
            ExecCmdCapture('"' + AdbExe + '" ' + AdbTarget + 'install -r "' +
                           TargetApk + '" 2>&1', InstallOutput);
            If Pos('Success', InstallOutput) > 0 Then
              Begin
                InstallSuccess := True;
                Break;
              End;
            WriteLn('  [!] ADB install attempt ', InstallAttempts, ' notice: ',
                    Trim(InstallOutput));
            If InstallAttempts < 3 Then
              Begin
                WriteLn('  [*] Retrying installation in 2 seconds (attempt ',
                        InstallAttempts + 1, ' of 3)...');
                Sleep(2000);
              End;
          Until InstallAttempts >= 3;

          If InstallSuccess Then
            Begin
              WriteLn('  [SUCCESS] APK installed successfully!');
              WriteLn('  [+] Launching application activity: ' + ActualAppId +
                      '/.MainActivity ...');
              LaunchOutput := '';
              ExecCmdCapture('"' + AdbExe + '" ' + AdbTarget +
                             'shell am start -n ' + ActualAppId +
                             '/.MainActivity', LaunchOutput);
              If (Pos('Error', LaunchOutput) > 0) Or (Pos('Exception',
                 LaunchOutput) > 0) Then
                WriteLn('  [!] Activity launch notice: ', Trim(LaunchOutput))
              Else
                WriteLn('  [SUCCESS] Application started on device/emulator!');
            End
          Else
            Begin
              WriteLn('  [ERROR] Failed to install APK after 3 attempts.');
              WriteLn('          Error details: ', Trim(InstallOutput));
            End;
        End
      Else
        Begin
          If Not HasCommand('node') Then
            Begin
              PrintNodeRequiredError('launch the mobile app via Capacitor CLI');
              Exit;
            End;
          WriteLn('Launching via Capacitor CLI runner...');
        {$IFDEF WINDOWS}
          ExecuteProcess('cmd', '/c npx cap run android');
        {$ELSE}
          ExecuteProcess('/bin/sh', '-c "npx cap run android"');
        {$ENDIF}
        End;
    End

  Else If ATarget = 'ios' Then
         Begin
      {$IFDEF DARWIN}

           ExecuteProcess('/bin/sh', '-c "npx cap run ios"');

      {$ELSE}

           WriteLn(


          '[INFO] Running on iOS simulator or device requires macOS with Xcode.'
           );

      {$ENDIF}
         End;
End;

Procedure OpenTarget(Const ATarget: String);
Begin
  If ATarget = 'ios' Then
    Begin
      WriteLn('Opening Xcode for ' + IOSDir + '...');
      CmdRunBuild;

      {$IFDEF WINDOWS}

      WriteLn('[INFO] Xcode is only available on macOS.');

      {$ELSE}
      ExecuteProcess('/bin/sh', '-c "npx cap sync ios && npx cap open ios"');
      {$ENDIF}
    End
  Else
    Begin
      WriteLn('Opening Android Studio for ' + AndroidDir + '...');
      CmdRunBuild;
      {$IFDEF WINDOWS}
      ExecuteProcess('cmd', '/c npx cap sync android && npx cap open android');
      {$ELSE}
      ExecuteProcess('/bin/sh',
                     '-c "npx cap sync android && npx cap open android"');
      {$ENDIF}
    End;
End;
Begin
  WriteLn('=== BlaiseVue v' + GetCliVersion + ' Capacitor Engine ===');
  IsRelease := False;
  IsBundle := False;
  IsAllTargets := False;
  UseEmulator := False;
  IsCheckOnly := False;
  IsFreshEmulator := False;
  IsNoBuild := False;
  IsForceInit := False;
  NeedsAndroidRecreate := False;
  TargetPlatform := '';
  SelectedAVD := '';
  EmulatorAction := '';
  ActualAppName := '';
  ActualAppId := '';
  RequestedCapVersion := '';

  i := 3;
  While i <= ParamCount Do
    Begin
      If (LowerCase(ParamStr(i)) = '--version') Or (LowerCase(ParamStr(i)) =
         '-v') Or
         (LowerCase(ParamStr(i)) = '--target') Or (LowerCase(ParamStr(i)) = '-t'
         ) Then
        Begin
          If i < ParamCount Then
            Begin
              Inc(i);
              RequestedCapVersion := ParamStr(i);
            End;
        End
      Else If Copy(LowerCase(ParamStr(i)), 1, 10) = '--version=' Then
             RequestedCapVersion := Trim(Copy(ParamStr(i), 11, MaxInt))
      Else If Copy(LowerCase(ParamStr(i)), 1, 9) = '--target=' Then
             RequestedCapVersion := Trim(Copy(ParamStr(i), 10, MaxInt))
      Else If Copy(LowerCase(ParamStr(i)), 1, 3) = '-v=' Then
             RequestedCapVersion := Trim(Copy(ParamStr(i), 4, MaxInt))
      Else If Copy(LowerCase(ParamStr(i)), 1, 3) = '-t=' Then
             RequestedCapVersion := Trim(Copy(ParamStr(i), 4, MaxInt))
      Else If (LowerCase(ParamStr(i)) = '--check') Or (LowerCase(ParamStr(i)) =
              '-c') Or (LowerCase(ParamStr(i)) = 'check') Then
             IsCheckOnly := True
      Else
        ParseArg(ParamStr(i));
      Inc(i);
    End;

  If (SubCmd <> 'emulator') And (SubCmd <> 'kill') And (SubCmd <> 'versions')
     And (SubCmd <> 'version') And
     (SubCmd <> 'remove-version') And (SubCmd <> 'delete-version') And (SubCmd
     <> 'rm-version') Then
    RequireBlaiseVueProject('bv capacitor ' + SubCmd);

  MobileDir := GetCurrentDir + DirectorySeparator + 'mobile';
  BinDir := MobileDir + DirectorySeparator + 'bin';
  CapConfigFile := GetCurrentDir + DirectorySeparator + 'capacitor.config.json';
  MobileCapConfigFile := MobileDir + DirectorySeparator +
                         'capacitor.config.json';
  If DirectoryExists(MobileDir + DirectorySeparator + 'android') Then
    AndroidDir := MobileDir + DirectorySeparator + 'android'

  Else If DirectoryExists(GetCurrentDir + DirectorySeparator + 'android') Then
         AndroidDir := GetCurrentDir + DirectorySeparator + 'android'

  Else
    AndroidDir := MobileDir + DirectorySeparator + 'android';

  If DirectoryExists(MobileDir + DirectorySeparator + 'ios') Then
    IOSDir := MobileDir + DirectorySeparator + 'ios'

  Else If DirectoryExists(GetCurrentDir + DirectorySeparator + 'ios') Then
         IOSDir := GetCurrentDir + DirectorySeparator + 'ios'

  Else
    IOSDir := MobileDir + DirectorySeparator + 'ios';

  If FileExists(CapConfigFile) Then
    ExistingConfig := ReadFileToString(CapConfigFile)

  Else If FileExists(MobileCapConfigFile) Then
         ExistingConfig := ReadFileToString(MobileCapConfigFile)

  Else
    ExistingConfig := '';

  If ExistingConfig <> '' Then
    Begin
      If ActualAppName = '' Then ActualAppName := ExtractJsonField(
                                                  ExistingConfig, 'appName');
      If ActualAppId = '' Then ActualAppId := ExtractJsonField(ExistingConfig,
                                              'appId');
    End;

  PkgJsonFile := GetCurrentDir + DirectorySeparator + 'package.json';
  If FileExists(PkgJsonFile) Then
    PkgContent := ReadFileToString(PkgJsonFile)
  Else
    PkgContent := '';

  // Smart migration for projects cloned from demo-app template
  If (LowerCase(ExtractFileName(GetCurrentDir)) <> 'demo-app') And
     ((PkgContent = '') Or (ExtractJsonField(PkgContent, 'name') <> 'demo-app'))
    Then
    Begin
