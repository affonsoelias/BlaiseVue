Function FindInstantFPCExecutable(out IfpcExe, IfpcVer, SourceDesc: String):


                                                                         Boolean
;

Var 
  OutStr, Cand, FirstLine: string;
  FpcExe, FpcVer, FpcSrc: string;
Begin
  IfpcExe := '';
  IfpcVer := '';
  SourceDesc := '';
  Result := False;

  // 1. Try system PATH (instantfpc -h returns exit code 0)
  If ExecCmdCapture('instantfpc -h', OutStr) And (Pos('instantfpc', LowerCase(
     OutStr)) > 0) Then
    Begin
      IfpcExe := 'instantfpc';
      FirstLine := Trim(Copy(OutStr, 1, Pos(#10, OutStr + #10) - 1));
      If Pos('instantfpc ', FirstLine) > 0 Then
        IfpcVer := Trim(Copy(FirstLine, Pos('instantfpc ', FirstLine) + 11,
                   Length(FirstLine)))
      Else
        IfpcVer := '1.3';
      SourceDesc := 'system PATH';
      Result := True;
      Exit;
    End;

  // 2. Check in same folder as FPC executable (e.g. in Lazarus FPC bin dir)
  If FindFPCExecutable(FpcExe, FpcVer, FpcSrc) And (FpcExe <> '') And (FpcExe <>
     'fpc') Then
    Begin
      Cand := ExtractFilePath(FpcExe) + 'instantfpc' + {$IFDEF WINDOWS}'.exe'
              {$ELSE}''{$ENDIF};
      If FileExists(Cand) Then
        Begin
          IfpcExe := Cand;
          If ExecCmdCapture('"' + Cand + '" -h', OutStr) And (Pos('instantfpc',
             LowerCase(OutStr)) > 0) Then
            Begin
              FirstLine := Trim(Copy(OutStr, 1, Pos(#10, OutStr + #10) - 1));
              If Pos('instantfpc ', FirstLine) > 0 Then
                IfpcVer := Trim(Copy(FirstLine, Pos('instantfpc ', FirstLine) +
                           11, Length(FirstLine)))
              Else
                IfpcVer := '1.3';
            End
          Else
            IfpcVer := '1.3';
          SourceDesc := 'Lazarus FPC folder (' + ExtractFilePath(Cand) + ')';
          Result := True;
          Exit;
        End;
    End;

  // 3. Fallback standard Lazarus locations
  {$IFDEF WINDOWS}
  Cand := 'C:\lazarus\fpc\3.2.2\bin\x86_64-win64\instantfpc.exe';
  If FileExists(Cand) Then
    Begin
      IfpcExe := Cand;
      IfpcVer := '1.3';
      SourceDesc := 'Lazarus IDE (C:\lazarus\fpc\3.2.2)';
      Result := True;
      Exit;
    End;

  Cand := 'C:\lazarus\fpc\3.2.0\bin\x86_64-win64\instantfpc.exe';
  If FileExists(Cand) Then
    Begin
      IfpcExe := Cand;
      IfpcVer := '1.3';
      SourceDesc := 'Lazarus IDE (C:\lazarus\fpc\3.2.0)';
      Result := True;
      Exit;
    End;

  Cand := 'D:\lazarus\fpc\3.2.2\bin\x86_64-win64\instantfpc.exe';
  If FileExists(Cand) Then
    Begin
      IfpcExe := Cand;
      IfpcVer := '1.3';
      SourceDesc := 'Lazarus IDE (D:\lazarus\fpc\3.2.2)';
      Result := True;
      Exit;
    End;
  {$ELSE}
  Cand := '/usr/bin/instantfpc';
  If FileExists(Cand) Then
    Begin
      IfpcExe := Cand;
      IfpcVer := '1.3';
      SourceDesc := '/usr/bin/instantfpc';
      Result := True;
      Exit;
    End;

  Cand := '/usr/local/bin/instantfpc';
  If FileExists(Cand) Then
    Begin
      IfpcExe := Cand;
      IfpcVer := '1.3';
      SourceDesc := '/usr/local/bin/instantfpc';
      Result := True;
      Exit;
    End;

  Cand := '/opt/homebrew/bin/instantfpc';
  If FileExists(Cand) Then
    Begin
