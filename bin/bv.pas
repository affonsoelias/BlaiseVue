{ Injects window.__BV_FRAMEWORK_VERSION__ and window.__BV_APP_VERSION__ before </head> so BVDevTools/BVCompiler read them on startup }

Function InjectFrameworkVersionTag(Const Html: String): string;

Var 
  VerScript, AppVer: string;
  PkgObj: TJSONObject;
Begin
  If (Pos('__BV_FRAMEWORK_VERSION__', Html) > 0) And
     (Pos('__BV_APP_VERSION__', Html) > 0) Then
    Begin
      Result := Html;
      Exit;
    End;
  AppVer := '0.1.0';
  PkgObj := Nil;
  If LoadPackageJson(PkgObj) Then
    Try
      AppVer := Trim(GetJsonString(PkgObj, 'version', '0.1.0'));
      If AppVer = '' Then
        AppVer := '0.1.0';
    Finally
      PkgObj.Free;
    End;
  AppVer := StringReplace(AppVer, '"', '', [rfReplaceAll]);
  VerScript := '  <script>window.__BV_FRAMEWORK_VERSION__ = "' +
               GetCliVersion + '"; window.__BV_APP_VERSION__ = "' +
               AppVer + '";</script>' + #10;
  If Pos('</head>', LowerCase(Html)) > 0 Then
    Result := StringReplace(Html, '</head>', VerScript + '</head>', [
                            rfIgnoreCase])
  Else
    Result := VerScript + Html;
End;

{ Execution cycle: Transpile .bv -> Pascal -> JS and setup public assets }

Procedure CmdBuild;

Var 
  SR: TSearchRec;
  BVFiles, UnitNames, CSSFiles, ConfigThemes: TStringList;
  i: Integer;
  FileName, UnitName, TagName, GenPath, DistPath, PublicPath, GeneratedCode,
  Pas2jsCmd, CSSTags, JSTags, DefTheme, ThemeId, IndexHTML: string;
  Parsed: TBVParsed;
  IsApp: Boolean;
  JSFiles: TStringList;
  DelSafeGenPath, DelSafeFuFlag: string;
Begin
  RequireBlaiseVueProject('bv build');
  GenPath := GetCurrentDir + DirectorySeparator + 'generated' +
             DirectorySeparator;
  DistPath := GetCurrentDir + DirectorySeparator + 'dist' + DirectorySeparator;
  PublicPath := GetCurrentDir + DirectorySeparator + 'public' +
                DirectorySeparator;
  If Not DirectoryExists(GetCurrentDir + DirectorySeparator + 'src') Then
    Begin
      WriteLn(


          'ERROR: "src/" folder not found. Are you in a BlaiseVue project root?'
      );
      Halt(1);
    End;
  SyncProjectVersionUnit(GenPath);

  ForceDir(GenPath);
  ForceDir(DistPath + 'js');
  BVFiles := TStringList.Create;
  UnitNames := TStringList.Create;
  ConfigThemes := TStringList.Create;
  Try
    GetProjectThemesConfig(DefTheme, ConfigThemes);

    // Recursively scan .bv files in src/

    WriteLn('=== BlaiseVue Development Build (Debug Mode) ===');
    WriteLn('  Info: Injecting debug features (BVDevTools)');
    WriteLn('  Cache: Injecting timestamp to prevent browser caching');
    WriteLn('');

    // 1. Get app.bv first

    If FileExists(GetCurrentDir + DirectorySeparator + 'src' +
       DirectorySeparator + 'app.bv') Then
      BVFiles.Add(GetCurrentDir + DirectorySeparator + 'src' +
                  DirectorySeparator + 'app.bv');

    // 2. Scan src and lib recursively using the established helper

    ScanDirForBV(GetCurrentDir + DirectorySeparator + 'src' + DirectorySeparator
                 + 'components', BVFiles);
    ScanDirForBV(GetCurrentDir + DirectorySeparator + 'src' + DirectorySeparator
                 + 'views', BVFiles);

    // Scan installed packages/libraries in lib/ recursively

    CSSFiles := TStringList.Create;
    JSFiles := TStringList.Create;
    ScanDirForBV(GetCurrentDir + DirectorySeparator + 'lib', BVFiles);
    ScanDirForCSS(GetCurrentDir + DirectorySeparator + 'lib', CSSFiles);
    ScanDirForJS(GetCurrentDir + DirectorySeparator + 'lib', JSFiles);
    If BVFiles.Count = 0 Then
      Begin
        WriteLn('No .bv files found in src/ or lib/');
        Halt(1);
      End;

    WriteLn('[1/3] Processing ', BVFiles.Count, ' .bv file(s) ...');
    WriteLn('');
    CompileDelSafeSharedModules(GetCurrentDir);

    // First pass: identify all units (requires complete list for app.bv)

    For i := 0 To BVFiles.Count - 1 Do
      Begin
        FileName := ExtractFileName(BVFiles[i]);
        FileName := ChangeFileExt(FileName, '');
        If LowerCase(FileName) = 'app' Then
          UnitName := 'uApp'

        Else
          UnitName := 'u' + FileName;

        UnitNames.Add(UnitName);
      End;

    // Second pass: parse Single File Components and generate code

    For i := 0 To BVFiles.Count - 1 Do
      Begin
        FileName := ExtractFileName(BVFiles[i]);
        IsApp := (LowerCase(ChangeFileExt(FileName, '')) = 'app');
        UnitName := UnitNames[i];
        TagName := PascalToKebab(ChangeFileExt(FileName, ''));

        // Apenas views (src/views/) ganham sufixo -page. 

        // Files in src/components/ and lib/ preserve natural unit names.

        IsApp := (LowerCase(ChangeFileExt(FileName, '')) = 'app');



        // Check whether file is located in components or lib by path

        If (Not IsApp) And (Pos('src' + DirectorySeparator + 'views', BVFiles[i]
           ) > 0) Then
          TagName := TagName + '-page';

        WriteLn('  ', FileName, ' -> ', UnitName, '.pas');
        ParseBVFile(BVFiles[i], Parsed);
        ProcessDelSafeComponentScript(BVFiles[i], UnitName, ChangeFileExt(
                                     FileName, ''), Parsed);
        If IsApp Then
          GeneratedCode := GenerateAppUnit(Parsed, UnitNames)

        Else
          GeneratedCode := GenerateComponentUnit(UnitName, TagName, FileName,
                           Parsed);

        WriteStringToFile(GenPath + UnitName + '.pas', GeneratedCode);
      End;

    // Generate main entry point (main.pas)

    GeneratedCode := GenerateMainProgram;
    WriteStringToFile(GenPath + 'main.pas', GeneratedCode);
    WriteLn('  main.pas (gerado)');
    WriteLn('');

    // [2/3] Calling pas2js

    WriteLn('[2/3] Compiling with pas2js ...');
    WriteLn('');
    DelSafeGenPath := GetCurrentDir + DirectorySeparator + '.blaisevue' +
                     DirectorySeparator + 'generated';
    If DirectoryExists(DelSafeGenPath) Then
      DelSafeFuFlag := ' -Fu"' + DelSafeGenPath + '"'
    Else
      DelSafeFuFlag := '';

    Pas2jsCmd := '"' + GetPas2JSPath + '" @app.cfg -Fu"' + GetCorePath +
                 '" -Fu"' + GetPas2JSLibPath + '"' + DelSafeFuFlag +
                 BuildExtraPascalFuFlags(GetCurrentDir, True) + ' generated' +
                 DirectorySeparator + 'main.pas -o' + DistPath + 'js' +
                 DirectorySeparator + 'main.js';
    WriteLn('  > ', Pas2jsCmd);
    WriteLn('');

    {$IFDEF WINDOWS}
    i := ExecuteProcess(GetPas2JSPath, '@app.cfg -Fu"' + GetCorePath + '" -Fu"'
         + GetPas2JSLibPath + '"' + DelSafeFuFlag +
         BuildExtraPascalFuFlags(GetCurrentDir, True) + ' generated' +
         DirectorySeparator + 'main.pas -o' +
         DistPath + 'js' + DirectorySeparator + 'main.js');
    {$ELSE}
    i := ExecuteProcess(GetPas2JSPath, '@app.cfg -Fu' + GetCorePath + ' -Fu' +
         GetPas2JSLibPath + DelSafeFuFlag +
         BuildExtraPascalFuFlags(GetCurrentDir, False) + ' generated/main.pas -o'
         + DistPath + 'js/main.js');
    {$ENDIF}

    If i <> 0 Then
      Begin
        WriteLn('');
        WriteLn('ERROR: pas2js returned code ', i);
        Halt(1);
      End;

    // [3/3] Copying public/ to dist/

    WriteLn('[3/3] Copying public files ...');
    WriteLn('');
    If FileExists(PublicPath + 'index.html') Then
      Begin
        IndexHTML := ReadFileToString(PublicPath + 'index.html');
        TagName := IntToStr(DateTimeToUnix(Now));



        // Inject real cache buster into asset placeholders

        IndexHTML := StringReplace(IndexHTML, '__CACHE_BUST__', TagName, [
                     rfReplaceAll]);



        // Collect and copy package CSS assets

        CSSTags := '';
        If CSSFiles.Count > 0 Then
          Begin
            ForceDir(DistPath + 'css' + DirectorySeparator + 'lib');
            For i := 0 To CSSFiles.Count - 1 Do
              Begin
                FileName := ExtractFileName(CSSFiles[i]);
                If IsThemeCSSFile(CSSFiles[i], ThemeId) Then
                  Begin
                    If (ConfigThemes.Count > 0) And (ConfigThemes.IndexOf(
                       ThemeId) < 0) Then
                      Continue;
                    // Skip unconfigured theme
                  End;
                Try
                  WriteStringToFile(DistPath + 'css' + DirectorySeparator +
                                    'lib' + DirectorySeparator + FileName,
                                    ReadFileToString(CSSFiles[i]));
                Except
                  WriteLn('  WARNING: Could not update ', FileName,
                          ' (locked). Skipping.');
              End;
            If Not IsThemeCSSFile(CSSFiles[i], ThemeId) Then
              CSSTags := CSSTags + '  <link rel="stylesheet" href="css/lib/' +
                         FileName + '?v=' + TagName + '">' + #10;
          End;
      End;

    // Collect and copy package JS bundles

    JSTags := '';
    If JSFiles.Count > 0 Then
      Begin
        ForceDir(DistPath + 'js' + DirectorySeparator + 'lib');
        For i := 0 To JSFiles.Count - 1 Do
          Begin
            FileName := ExtractFileName(JSFiles[i]);
            WriteStringToFile(DistPath + 'js' + DirectorySeparator + 'lib' +
                              DirectorySeparator + FileName, ReadFileToString(
                              JSFiles[i]));
            JSTags := JSTags + '  <script src="js/lib/' + FileName + '?v=' +
                      TagName + '"></script>' + #10;
          End;
      End;

    // Inject library CSS at end of <head> and scripts before rtl.js

    If CSSTags <> '' Then
      IndexHTML := StringReplace(IndexHTML, '</head>', CSSTags + '</head>', [
                   rfIgnoreCase]);

    If JSTags <> '' Then
      Begin
        // Inject library JS before framework runtime to ensure availability

        If Pos('js/rtl.js', IndexHTML) > 0 Then
          IndexHTML := StringReplace(IndexHTML, '<script src="js/rtl.js', JSTags
                       + '    <script src="js/rtl.js', [rfIgnoreCase])

        Else
          IndexHTML := StringReplace(IndexHTML, '</head>', JSTags + '</head>', [
                       rfIgnoreCase]);
      End;



    // Fallback: if user did not include __CACHE_BUST__, inject v= into main.js

    If Pos('main.js?v=', IndexHTML) = 0 Then
      IndexHTML := StringReplace(IndexHTML, 'main.js', 'main.js?v=' + TagName, [
                   rfReplaceAll]);

    If Pos('rtl.js?v=', IndexHTML) = 0 Then
      IndexHTML := StringReplace(IndexHTML, 'rtl.js', 'rtl.js?v=' + TagName, [
                   rfReplaceAll]);

    IndexHTML := InjectFrameworkVersionTag(IndexHTML);
    WriteStringToFile(DistPath + 'index.html', IndexHTML);
    WriteLn('  index.html -> dist/ (cache bust v=' + TagName + ')');
End;

// Recursively copy remaining public/ assets to dist/

If DirectoryExists(PublicPath) Then
  Begin
    WriteLn('  Copying assets from /public to /dist...');

    CopyDir(PublicPath, DistPath, ['index.html']);
    // Skip index.html as it was already processed
  End;

// Copy installed libraries from lib/ to dist/lib

If DirectoryExists(GetCurrentDir + DirectorySeparator + 'lib') Then
  Begin
    WriteLn('  Copying installed libraries from /lib to /dist/lib...');
    CopyDir(GetCurrentDir + DirectorySeparator + 'lib', DistPath + 'lib', []);
  End;

CopyWasmArtifactsToDist(GetCurrentDir, DistPath);

// Copies rtl.js to dist/js/ using automatic SDK lookup

FileName := GetRTLPath;
If FileName <> '' Then
  Begin
    WriteStringToFile(DistPath + 'js' + DirectorySeparator + 'rtl.js',

                      ReadFileToString(FileName));

    WriteLn('  rtl.js -> dist/js/ (from SDK)');
  End

Else
  Begin
    WriteLn('  WARNING: rtl.js not found in SDK.');
    WriteLn('  Look for rtl.js and place it in the root or SDK folder: ',
            GetSDKPath);
  End;




// BlaiseVue 3.0: Generates component documentation automatically into dist/docs/

CmdDoc(False);
WriteLn('');
WriteLn('=== Build completed successfully! ===');
WriteLn('');
WriteLn('Open dist/index.html in your browser to see the result.');

Finally

  BVFiles.Free;
  UnitNames.Free;
  ConfigThemes.Free;
End;
End;

