{ Recursively renders project files and directories as a structured tree with BlaiseVue annotations. }
Procedure RenderProjectTree(Const TargetDir: String; Const Prefix: String; Var
                            TotalDirs, TotalFiles: Integer; ShowAll: Boolean;
                            Depth: Integer = 1; MaxDepth: Integer = 3);

Var 
  SR: TSearchRec;
  D: string;
  DirList, FileList: TStringList;
  i: Integer;
  ItemName, LowName, FullItemPath, Ext, Annotation, Branch, SubPrefix: string;
  IsLast: Boolean;
Begin
  If Not DirectoryExists(TargetDir) Then Exit;
  D := IncludeTrailingPathDelimiter(TargetDir);

  DirList := TStringList.Create;
  FileList := TStringList.Create;
  Try
    If FindFirst(D + '*', faAnyFile, SR) = 0 Then
      Begin
        Repeat
          If (SR.Name <> '.') And (SR.Name <> '..') Then
            Begin
              ItemName := SR.Name;
              LowName := LowerCase(ItemName);
              If (SR.Attr And faDirectory) <> 0 Then
                Begin
                  If Not ShowAll Then
                    Begin
                      If (LowName = 'node_modules') Or (LowName = '.git') Or (
                         LowName = '.vscode') Or
                         (LowName = '.idea') Or (LowName = 'dist') Or (LowName =
                         'generated') Or
                         (LowName = '.blaisevue') Or (LowName = '.history') Or (
                         LowName = '__pycache__') Or
                         (LowName = 'packages') Or (LowName = 'backup') Or (
                         LowName = 'units') Or
                         (LowName = 'bin') Or (LowName = '.gradle') Or (LowName
                         = 'gradle') Or
                         (LowName = 'assets') Or (LowName = 'fonts') Or
                         ((LowName = 'android') And (Pos('mobile', LowerCase(D))
                         > 0)) Or
                         ((LowName = 'ios') And (Pos('mobile', LowerCase(D)) > 0
                         )) Then
                        Continue;
                    End;
                  DirList.Add(ItemName);
                End
              Else
                Begin
                  If Not ShowAll Then
                    Begin
                      Ext := LowerCase(ExtractFileExt(ItemName));
                      If (LowName = '.ds_store') Or (LowName = 'thumbs.db') Or (
                         LowName = 'package-lock.json') Or
                         (Ext = '.o') Or (Ext = '.ppu') Or (Ext = '.obj') Or (
                         Ext = '.dcu') Or
                         (Ext = '.tmp') Or (Ext = '.bak') Or (Ext = '.lps') Or (
                         Ext = '.exe') Then
                        Continue;
                    End;
                  FileList.Add(ItemName);
                End;
            End;
        Until FindNext(SR) <> 0;
        FindClose(SR);
      End;

    DirList.Sort;
    FileList.Sort;

    // Render directories first
    For i := 0 To DirList.Count - 1 Do
      Begin
        ItemName := DirList[i];
        FullItemPath := D + ItemName;
        Inc(TotalDirs);
        IsLast := (i = DirList.Count - 1) And (FileList.Count = 0);
        If IsLast Then
          Begin
            Branch := '\-- ';
            SubPrefix := Prefix + '    ';
          End
        Else
          Begin
            Branch := '+-- ';
            SubPrefix := Prefix + '|   ';
          End;

        Annotation := '';
        If ItemName = 'src' Then Annotation := ' (Frontend Source)'
        Else If ItemName = 'components' Then Annotation := ' (UI Components)'
        Else If ItemName = 'views' Then Annotation := ' (Route Views)'
        Else If ItemName = 'services' Then Annotation := ' (Domain Services)'
        Else If ItemName = 'tests' Then Annotation := ' (Test Suites)'
        Else If ItemName = 'shared' Then Annotation := 


                                                      ' (Shared DelSafe Modules)'
        Else If ItemName = 'server-mormot' Then Annotation := 


                                                           ' (mORMot 2 Backend)'
        Else If ItemName = 'server-zephyr' Then Annotation := 


                                                      ' (Zephyr DelSafe Backend)'
        Else If Copy(ItemName, 1, 7) = 'server-' Then
               Begin
                 Annotation := Copy(ItemName, 8, MaxInt);
                 If Annotation <> '' Then
                   Annotation := ' (' + UpperCase(Annotation[1]) + Copy(
                                 Annotation, 2, MaxInt) + ' External Backend)'
                 Else
                   Annotation := ' (External Backend)';
               End
        Else If ItemName = 'server' Then Annotation := ' (Legacy Backend)'
        Else If ItemName = 'mobile' Then Annotation := ' (Capacitor Mobile)'
        Else If ItemName = 'desktop' Then Annotation := ' (Lazarus Desktop)'
        Else If ItemName = 'public' Then Annotation := ' (Static Assets)'
        Else If ItemName = 'lib' Then Annotation := ' (Installed Libraries)'
        Else If ItemName = 'dist' Then Annotation := ' (Compiled Distribution)'
        Else If ItemName = 'generated' Then Annotation := ' (Transpiled Output)'
        ;

        WriteLn(Prefix + Branch + '[DIR]  ' + ItemName + '/' + Annotation);
        If (Depth < MaxDepth) Or ShowAll Then
          RenderProjectTree(FullItemPath, SubPrefix, TotalDirs, TotalFiles,
                            ShowAll, Depth + 1, MaxDepth);
      End;

    // Render files
    For i := 0 To FileList.Count - 1 Do
      Begin
        ItemName := FileList[i];
        Inc(TotalFiles);
        IsLast := (i = FileList.Count - 1);
        If IsLast Then
          Branch := '\-- '
        Else
          Branch := '+-- ';

        Annotation := '';
        Ext := LowerCase(ExtractFileExt(ItemName));
        If Ext = '.bv' Then
          Begin
            If ItemName = 'app.bv' Then Annotation := ' (Root SFC App)'
            Else If Pos('components', LowerCase(D)) > 0 Then Annotation := 


                                                                  ' (Component)'
            Else If Pos('views', LowerCase(D)) > 0 Then Annotation := 


                                                                 ' (Route View)'
            Else Annotation := ' (SFC Template)';
          End
        Else If Ext = '.pas' Then
               Begin
                 If Pos('.test.pas', LowerCase(ItemName)) > 0 Then Annotation :=


                                                                 ' (Test Suite)'
                 Else If Pos('services', LowerCase(D)) > 0 Then Annotation := 


                                                             ' (Domain Service)'
                 Else If Pos('models', LowerCase(D)) > 0 Then Annotation := 


                                                                  ' (ORM Model)'
                 Else If ItemName = 'webui.pas' Then Annotation := 


                                                               ' (WebUI Bridge)'
                 Else Annotation := ' (Pascal Unit)';
               End
        Else If ItemName = 'app.cfg' Then Annotation := 


                                                     ' (Compiler Configuration)'
        Else If ItemName = 'package.json' Then Annotation := 


                                                           ' (Project Manifest)'
        Else If ItemName = '.env' Then Annotation := 


                                                  ' (Environment Configuration)'
        Else If Ext = '.lpr' Then Annotation := ' (Lazarus Program Source)'
        Else If Ext = '.lpi' Then Annotation := ' (Lazarus Project Info)'
        Else If ItemName = 'capacitor.config.json' Then Annotation := 


                                                       ' (Mobile Configuration)'
        Else If (ItemName = 'Dockerfile') Or (ItemName = 'docker-compose.yml')
               Then Annotation := ' (Docker Container)'
        Else If ItemName = 'index.html' Then Annotation := ' (HTML Entrypoint)';

        WriteLn(Prefix + Branch + '[FILE] ' + ItemName + Annotation);
      End;
  Finally
    DirList.Free;
    FileList.Free;
End;
End;

{ Displays structured project files tree with BlaiseVue domain categorization. }
Procedure CmdFiles(Const TargetArg: String = ''; ShowAll: Boolean = False);

Var 
  ProjectRoot, StartDir, DisplayName: string;
  TotalDirs, TotalFiles: Integer;
Begin
  ProjectRoot := RequireBlaiseVueProject('bv files');
  If (TargetArg <> '') And (TargetArg <> '--all') And (TargetArg <> '-a') Then
    Begin
      If (Length(TargetArg) > 1) And ((TargetArg[1] = '/') Or (TargetArg[1] =
         '\') Or (TargetArg[2] = ':')) Then
        StartDir := TargetArg
      Else
        StartDir := ProjectRoot + DirectorySeparator + TargetArg;

      If Not DirectoryExists(StartDir) Then
        Begin
          WriteLn('  [ERROR] Directory not found in project: ' + TargetArg);
          Exit;
        End;
      DisplayName := ExtractFileName(ExcludeTrailingPathDelimiter(StartDir));
    End
  Else
    Begin
      StartDir := ProjectRoot;
      DisplayName := ExtractFileName(ExcludeTrailingPathDelimiter(ProjectRoot));
    End;

  TotalDirs := 0;
  TotalFiles := 0;
  WriteLn('');
  WriteLn('  Project Files: ' + DisplayName + ' (' + StartDir + ')');
  WriteLn('  ============================================================');
  WriteLn('  [DIR]  ' + DisplayName + '/');
  RenderProjectTree(StartDir, '  ', TotalDirs, TotalFiles, ShowAll);
  WriteLn('  ============================================================');
  WriteLn('  Summary: ' + IntToStr(TotalDirs) + ' directories, ' + IntToStr(


                                                                      TotalFiles
  ) + ' files');
  If Not ShowAll Then
    WriteLn('  (Tip: run "files --all" to show build and system directories)');
  WriteLn('');
End;




{ Computes a fast hash/timestamp fingerprint for file change detection during builds. }
Function GetFileHash(Const FileName: String): string;

Var 
  S: string;
  Output: TStringList;
Begin
  // On Windows, use certutil for a fast MD5 hash

  Output := TStringList.Create;
  Try

    If RunCommand('certutil', ['-hashfile', FileName, 'MD5'], S) Then
      Begin
        Output.Text := S;
        If Output.Count > 1 Then
          Begin
            Result := Trim(Output[1]);
            // The second line contains the hash

            Result := StringReplace(Result, ' ', '', [rfReplaceAll]);
            Result := LowerCase(Result);

            Result := Copy(Result, 1, 8);
            // Uses only 8 chars
          End

        Else
          Result := IntToStr(DateTimeToUnix(Now));
      End

    Else
      Result := IntToStr(DateTimeToUnix(Now));

  Finally

    Output.Free;
End;
End;

