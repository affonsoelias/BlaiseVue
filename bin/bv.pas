// =====================================================================

Procedure CmdRemoveMobile(ForceFlag: Boolean);

Var 
  MobileDir, CapConfigFile, BinMobileDir: string;
  Ans: string;
  DeletedAny: Boolean;
Begin
  MobileDir := GetCurrentDir + DirectorySeparator + 'mobile';
  CapConfigFile := GetCurrentDir + DirectorySeparator + 'capacitor.config.json';
  BinMobileDir := GetCurrentDir + DirectorySeparator + 'bin' +
                  DirectorySeparator + 'mobile';
  If Not DirectoryExists(MobileDir) And Not FileExists(CapConfigFile) And Not
     DirectoryExists(BinMobileDir) Then
    Begin
      WriteLn(


'Mobile platform not found in current project (mobile/ directory does not exist).'
      );
      Exit;
    End;

  If Not ForceFlag Then
    Begin
      Write(


'Are you sure you want to remove the Mobile platform (mobile/ directory and capacitor.config.json)? [y/N]: '
      );
      ReadLn(Ans);
      Ans := LowerCase(Trim(Ans));
      If (Ans <> 's') And (Ans <> 'y') And (Ans <> 'sim') And (Ans <> 'yes')
        Then
        Begin
          WriteLn('Operation cancelled.');
          Exit;
        End;
    End;

  DeletedAny := False;
  If DirectoryExists(MobileDir) Then
    Begin
      WriteLn('  [-] Deleting mobile/ directory ...');
      DeleteDir(MobileDir);
      DeletedAny := True;
    End;

  If FileExists(CapConfigFile) Then
    Begin
      WriteLn('  [-] Deleting capacitor.config.json ...');
      DeleteFile(CapConfigFile);
      DeletedAny := True;
    End;

  If DirectoryExists(BinMobileDir) Then
    Begin
      WriteLn('  [-] Deleting binaries in bin/mobile/ ...');
      DeleteDir(BinMobileDir);
      DeletedAny := True;
    End;

  If DeletedAny Then
    Begin
      WriteLn('  [SUCCESS] Mobile platform removed successfully!');
      WriteLn('  [INFO] To re-enable it in the future, simply run:');
      WriteLn('         bv capacitor init');
    End;
End;




