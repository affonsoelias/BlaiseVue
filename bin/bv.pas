Function FindMormot2Path: string;

Var 
  Candidate: string;
  ConfigFile: string;



{ Verifies that the Synopse mORMot 2 framework distribution is present and valid. }
Function IsValidMormot(Const Dir: String): Boolean;

Var 
  P: string;
Begin
  Result := False;
  P := ExcludeTrailingPathDelimiter(Dir);
  If (P <> '') And DirectoryExists(P) Then
    Begin
      If DirectoryExists(P + DirectorySeparator + 'src') And

         FileExists(P + DirectorySeparator + 'src' + DirectorySeparator + 'core'
         + DirectorySeparator + 'mormot.core.base.pas') Then
        Result := True;
    End;
End;
Begin
  Result := '';




// 1. Project or server configuration file: server-mormot/mormot.path, server/mormot.path, or mormot.path
  ConfigFile := ResolveMormotServerDir(GetCurrentDir, False) +
                DirectorySeparator + 'mormot.path';
  If Not FileExists(ConfigFile) Then
    ConfigFile := GetCurrentDir + DirectorySeparator + 'server' +
                  DirectorySeparator + 'mormot.path';
  If FileExists(ConfigFile) Then
    Begin
      Candidate := Trim(ReadFileToString(ConfigFile));
      If (LowerCase(Candidate) = 'bundled') Or (LowerCase(Candidate) = 'default'
         ) Then
        Candidate := ''
      Else If DirectoryExists(GetGlobalVersionsPath('mormot') + Candidate) Then
             Candidate := GetGlobalVersionsPath('mormot') + Candidate;
      If (Candidate <> '') And IsValidMormot(Candidate) Then
        Exit(ExcludeTrailingPathDelimiter(Candidate));
    End;

  ConfigFile := GetCurrentDir + DirectorySeparator + 'mormot.path';
  If FileExists(ConfigFile) Then
    Begin
      Candidate := Trim(ReadFileToString(ConfigFile));
      If (LowerCase(Candidate) = 'bundled') Or (LowerCase(Candidate) = 'default'
         ) Then
        Candidate := ''
      Else If DirectoryExists(GetGlobalVersionsPath('mormot') + Candidate) Then
             Candidate := GetGlobalVersionsPath('mormot') + Candidate;
      If (Candidate <> '') And IsValidMormot(Candidate) Then
        Exit(ExcludeTrailingPathDelimiter(Candidate));
    End;

  // 2. Environment variable MORMOT2_PATH
  Candidate := GetEnvironmentVariable('MORMOT2_PATH');
  If IsValidMormot(Candidate) Then
    Exit(ExcludeTrailingPathDelimiter(Candidate));

  // 3. Embedded vendor in BlaiseVue SDK: vendor/mormot2 (or host SDK when delegated)
  Candidate := GetSDKPath + 'vendor' + DirectorySeparator + 'mormot2';
  If IsValidMormot(Candidate) Then
    Exit(ExcludeTrailingPathDelimiter(Candidate));

  If GetHostSDKPath <> GetSDKPath Then
    Begin
      Candidate := GetHostSDKPath + 'vendor' + DirectorySeparator + 'mormot2';
      If IsValidMormot(Candidate) Then
        Exit(ExcludeTrailingPathDelimiter(Candidate));
    End;




// 4. Relative to current project or workspace: vendor/mormot2 or ../vendor/mormot2
  Candidate := GetCurrentDir + DirectorySeparator + 'vendor' +
               DirectorySeparator + 'mormot2';
  If IsValidMormot(Candidate) Then
    Exit(ExcludeTrailingPathDelimiter(Candidate));

  Candidate := ExpandFileName(GetCurrentDir + DirectorySeparator + '..' +
               DirectorySeparator + 'vendor' + DirectorySeparator + 'mormot2');
  If IsValidMormot(Candidate) Then
    Exit(ExcludeTrailingPathDelimiter(Candidate));

  Candidate := ExpandFileName(GetCurrentDir + DirectorySeparator + '..' +
               DirectorySeparator + '..' + DirectorySeparator + 'vendor' +
               DirectorySeparator + 'mormot2');
  If IsValidMormot(Candidate) Then
    Exit(ExcludeTrailingPathDelimiter(Candidate));

  // 5. User global version: ~/.blaisevue/versions/mormot/latest
  Candidate := GetGlobalVersionsPath('mormot') + 'latest';
  If IsValidMormot(Candidate) Then
    Exit(ExcludeTrailingPathDelimiter(Candidate));

  // 5. User local installation path on Windows (fallback)

  Candidate := 'C:\ComponenteLazarus\mORMot2';
  If IsValidMormot(Candidate) Then
    Exit(Candidate);

  // 6. Relative paths to workspace or BlaiseVue SDK

  Candidate := ExpandFileName(GetCurrentDir + DirectorySeparator + '..' +
               DirectorySeparator + 'mORMot2');
  If IsValidMormot(Candidate) Then
    Exit(Candidate);

  Candidate := ExpandFileName(GetSDKPath + '..' + DirectorySeparator + 'mORMot2'
               );
  If IsValidMormot(Candidate) Then
    Exit(Candidate);

  // 5. Alternate drive paths on Windows

  Candidate := 'C:\mORMot2';
  If IsValidMormot(Candidate) Then
    Exit(Candidate);

  Candidate := 'D:\ComponenteLazarus\mORMot2';
  If IsValidMormot(Candidate) Then
    Exit(Candidate);

  Candidate := 'D:\mORMot2';
  If IsValidMormot(Candidate) Then
    Exit(Candidate);

  // 6. Common Unix locations

  Candidate := '/opt/mormot2';
  If IsValidMormot(Candidate) Then
    Exit(Candidate);

  Candidate := '/usr/local/share/mormot2';
  If IsValidMormot(Candidate) Then
    Exit(Candidate);

  Candidate := ExpandFileName('~/mORMot2');
  If IsValidMormot(Candidate) Then
    Exit(Candidate);
End;

