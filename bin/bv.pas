        // Customize title in index.html if it was copied
        If FileExists(Base + 'public' + DirectorySeparator + 'index.html') Then
          Begin
            Content := ReadFileToString(Base + 'public' + DirectorySeparator +
                       'index.html');
            Content := StringReplace(Content,
                       '<title>BlaiseVue Demo 2.0</title>', '<title>' +
                       RealProjectName + '</title>', [rfReplaceAll]);
