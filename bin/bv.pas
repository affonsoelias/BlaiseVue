                      Begin
                        CurP := ParamStr(i);
                        If (CurP = '--global') Or (CurP = '-g') Then IsGlobalArg
                          := True
                        Else If PkgNameArg = '' Then PkgNameArg := CurP;
                      End;
                    If PkgNameArg = '' Then
                      Begin
                        WriteLn(


          'Usage: bv lib install [<repo>:]<package[@version]|url> [--global|-g]'
