Function ExecProcessCaptureExit(Const ExePath: String; Const Params: Array Of
                                String; out StdOutAndErr: String): Integer;

Var 
  P: TProcess;
  Buf: array[0..4095] Of Byte;
  BytesRead: LongInt;
  Mem: TMemoryStream;
  I: Integer;
Begin
  Result := -1;
  StdOutAndErr := '';
  P := TProcess.Create(Nil);
  Mem := TMemoryStream.Create;
  Try
    P.Executable := ExePath;
    For I := 0 To High(Params) Do
      P.Parameters.Add(Params[I]);
    P.Options := [poUsePipes, poStderrToOutPut];
    P.Execute;
    While P.Running Do
      Begin
        If P.Output.NumBytesAvailable > 0 Then
          Begin
            BytesRead := P.Output.Read(Buf[0], SizeOf(Buf));
            If BytesRead > 0 Then Mem.Write(Buf[0], BytesRead);
          End
        Else
          Sleep(10);
      End;
    Repeat
      BytesRead := P.Output.Read(Buf[0], SizeOf(Buf));
      If BytesRead > 0 Then Mem.Write(Buf[0], BytesRead);
    Until BytesRead <= 0;
    If Mem.Size > 0 Then
      Begin
        SetLength(StdOutAndErr, Mem.Size);
        Mem.Position := 0;
        Mem.Read(StdOutAndErr[1], Mem.Size);
      End;
    Result := P.ExitStatus;
  Finally
    Mem.Free;
    P.Free;
End;
End;

Function ExecProcessCaptureExitInDir(Const ExePath, WorkDir: String; Const
                                     Params: Array Of String; out StdOutAndErr:
                                     String): Integer;

Var 
  P: TProcess;
  Buf: array[0..4095] Of Byte;
  BytesRead: LongInt;
  Mem: TMemoryStream;
  I: Integer;
Begin
  Result := -1;
  StdOutAndErr := '';
  P := TProcess.Create(Nil);
  Mem := TMemoryStream.Create;
  Try
    P.Executable := ExePath;
    If WorkDir <> '' Then
      P.CurrentDirectory := WorkDir;
    For I := 0 To High(Params) Do
      P.Parameters.Add(Params[I]);
    P.Options := [poUsePipes, poStderrToOutPut];
    P.Execute;
    While P.Running Do
      Begin
        If P.Output.NumBytesAvailable > 0 Then
          Begin
            BytesRead := P.Output.Read(Buf[0], SizeOf(Buf));
            If BytesRead > 0 Then Mem.Write(Buf[0], BytesRead);
          End
        Else
          Sleep(10);
      End;
    Repeat
      BytesRead := P.Output.Read(Buf[0], SizeOf(Buf));
      If BytesRead > 0 Then Mem.Write(Buf[0], BytesRead);
    Until BytesRead <= 0;
    If Mem.Size > 0 Then
      Begin
        SetLength(StdOutAndErr, Mem.Size);
        Mem.Position := 0;
        Mem.Read(StdOutAndErr[1], Mem.Size);
