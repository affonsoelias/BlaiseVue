  ForceDir(TargetDir);
  Content := GetTemplate('TPL_UNIT_TEST_PAS', 'unit_test.pas');
  If Content = '' Then Content := GetTemplate('TPL_TEST_PAS', 'test.pas');
  If Content = '' Then
