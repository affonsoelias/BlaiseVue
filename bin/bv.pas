Function ExtractScriptAttr(Const TagHeader, AttrName: String): string;

Var 
  LowTag, KeyDouble, KeySingle, Rest: string;
  P, PEnd: Integer;
  Q: Char;
Begin
  Result := '';
  LowTag := LowerCase(TagHeader);
  KeyDouble := LowerCase(AttrName) + '="';
  KeySingle := LowerCase(AttrName) + '=''';
  Q := '"';
  P := Pos(KeyDouble, LowTag);
  If P = 0 Then
    Begin
      P := Pos(KeySingle, LowTag);
      Q := '''';
    End;
  If P > 0 Then
    Begin
      Rest := Copy(TagHeader, P + Length(KeyDouble), Length(TagHeader));
      PEnd := Pos(Q, Rest);
      If PEnd > 0 Then
        Result := Trim(Copy(Rest, 1, PEnd - 1));
    End;
End;




{ Main Parser: Orchestrates the separation of <template>, <script>, and <style> sections }
Procedure ParseBVFile(Const FileName: String; out Parsed: TBVParsed);

Var 
  Lines: TStringList;
  i: Integer;
  Line, Trimmed: string;
  Section: Integer;
  // 0=none, 1=template, 2=script, 3=style
  ScriptBlock: string;
Begin
  Parsed.Template := '';
  Parsed.Style := '';
  Parsed.ScriptUses := '';
  Parsed.ScriptLang := '';
  Parsed.ScriptTarget := '';
  Parsed.ScriptStartLine := 0;
  Parsed.RawScriptBlock := '';
  Parsed.DelSafeLogicUnit := '';
  Parsed.WasmModuleName := '';
  SetLength(Parsed.WasmExports, 0);
  Parsed.MethodsCode := '';
  Parsed.BeforeEachCode := '';
  Parsed.CreatedCode := '';
  Parsed.MountedCode := '';
  Parsed.WatchCode := '';
  Parsed.ComputedCode := '';

  Parsed.UpdatedCode := '';
  // Lifecycle hook: updated

  Parsed.ProvideCode := '';
  // Dependency injection: provide

  Parsed.InjectCode := '';
  // Dependency injection: inject

  Parsed.HasRouter := False;
  SetLength(Parsed.DataFields, 0);
  SetLength(Parsed.Routes, 0);
  Lines := TStringList.Create;
  Try

    Lines.LoadFromFile(FileName);
    Section := 0;
    ScriptBlock := '';
    For i := 0 To Lines.Count - 1 Do
      Begin
        Line := Lines[i];
        Trimmed := Trim(Line);

        // Section opening detection

        If Pos('<template>', LowerCase(Trimmed)) = 1 Then
          Begin
            Section := 1;
            Continue;
          End;

        If Pos('<script', LowerCase(Trimmed)) = 1 Then
          Begin
            Section := 2;
            Parsed.ScriptStartLine := i + 1;
            Parsed.ScriptUses := ExtractScriptAttr(Trimmed, 'uses');
            Parsed.ScriptLang := LowerCase(ExtractScriptAttr(Trimmed, 'lang'));
            Parsed.ScriptTarget := LowerCase(ExtractScriptAttr(Trimmed, 'target'
                                   ));
            Continue;
          End;

        If Pos('<style', LowerCase(Trimmed)) = 1 Then
          Begin
            Section := 3;
            Continue;
          End;

        // Section closing detection

        If Pos('</template>', LowerCase(Trimmed)) = 1 Then
          Begin
            Section := 0;
            Continue;
          End;
        If Pos('</script>', LowerCase(Trimmed)) = 1 Then
          Begin
            Section := 0;
            Continue;
          End;
        If Pos('</style>', LowerCase(Trimmed)) = 1 Then
          Begin
            Section := 0;
            Continue;
          End;

        // Accumulate content per section

        Case Section Of 

          1: Parsed.Template := Parsed.Template + Line + #10;
          2: ScriptBlock := ScriptBlock + Line + #10;
          3: Parsed.Style := Parsed.Style + Line + #10;
        End;
      End;

    Parsed.RawScriptBlock := ScriptBlock;

    // Now parse ScriptBlock into sub-sections: data, router, methods

    ParseScriptBlock(ScriptBlock, Parsed);

  Finally

    Lines.Free;
End;
End;




{ Parses the <script> section of a .bv Single File Component, extracting props, data fields, router configurations, methods, computed properties, watchers, and lifecycle hooks into a TBVParsed record. }
Procedure ParseScriptBlock(Const Block: String; Var Parsed: TBVParsed);

Var 
  Lines: TStringList;
  i: Integer;
  Trimmed: string;
  SubSection: Integer;



// 0=none, 1=data, 2=router, 3=methods, 4=beforeEach, 5=created, 6=mounted, 7=watch
  InRoutes, InQuotes: Boolean;
  P, P2, j: Integer;
  DF: TDataField;
  RE: TRouteEntry;
  S: string;
Begin
  Lines := TStringList.Create;
  Try

    Lines.Text := Block;
    SubSection := 0;
    InRoutes := False;
    For i := 0 To Lines.Count - 1 Do
      Begin
        Trimmed := Trim(Lines[i]);
        If Trimmed = '' Then Continue;

        // Detection of comments at top level within script

        If (Trimmed[1] = '{') Or (Copy(Trimmed, 1, 2) = '//') Then
          Begin



         // If a comment is followed by a known block name, don't capture it yet




         // or just skip adding to current SubSection if it's likely a separator

            If SubSection <> 0 Then
              Begin
                // Check next lines to see if we are switching




      // For now, if we are in 3 (Methods) or similar, we might want to keep it.




// But for 5 (Created), we usually don't want trailing comments from the next block.
              End;
          End;

        // Sub-section detection

        If Trimmed = 'data:' Then
          Begin
            SubSection := 1;
            Continue;
          End;
        If Trimmed = 'props:' Then
          Begin
            SubSection := 12;
            Continue;
          End;
        If Trimmed = 'router:' Then
          Begin
            SubSection := 2;
            Parsed.HasRouter := True;
            Continue;
          End;
        If Trimmed = 'methods:' Then
          Begin
            SubSection := 3;
            Continue;
          End;
        If Trimmed = 'provide:' Then
          Begin
            SubSection := 9;
            Continue;
          End;
        If Trimmed = 'inject:' Then
          Begin
            SubSection := 10;
            Continue;
          End;
        If Trimmed = 'created:' Then
          Begin
            SubSection := 5;
            Continue;
          End;
        If Trimmed = 'mounted:' Then
          Begin
            SubSection := 6;
            Continue;
          End;
        If Trimmed = 'updated:' Then
          Begin
            SubSection := 11;
            Continue;
          End;
        If Trimmed = 'watch:' Then
          Begin
            SubSection := 7;
            Continue;
          End;
        If Trimmed = 'computed:' Then
          Begin
            SubSection := 8;
            Continue;
          End;
        If Trimmed = 'routes:' Then
          Begin
            InRoutes := True;
            Continue;
          End;
        Case SubSection Of 

          1, 12: // DATA or PROPS
                 Begin
                   // Skips comments

                   If (Trimmed = '') Or (Trimmed[1] = '{') Or (Copy(Trimmed, 1,
                      2) = '//') Then Continue;
                   P := Pos(':', Trimmed);
                   If P > 0 Then
                     Begin
                       DF.Name := Trim(Copy(Trimmed, 1, P - 1));
                       DF.IsProp := (SubSection = 12);

                       // After ":" is "type = value;"

                       Trimmed := Trim(Copy(Trimmed, P + 1, Length(Trimmed)));

                       // Remove trailing semicolon

                       If (Length(Trimmed) > 0) And (Trimmed[Length(Trimmed)] =
                          ';') Then
                         Trimmed := Copy(Trimmed, 1, Length(Trimmed) - 1);

                       P2 := Pos('=', Trimmed);
                       If P2 > 0 Then
                         Begin
                           DF.FieldType := Trim(Copy(Trimmed, 1, P2 - 1));
                           DF.DefaultValue := Trim(Copy(Trimmed, P2 + 1, Length(
                                              Trimmed)));
                         End

                       Else
                         Begin
                           DF.FieldType := Trim(Trimmed);
                           DF.DefaultValue := '';
                         End;

                       SetLength(Parsed.DataFields, Length(Parsed.DataFields) +
                       1);
                       Parsed.DataFields[High(Parsed.DataFields)] := DF;
                     End;
                 End;

          2: // ROUTER: routes and configuration
             Begin
               If InRoutes Then
                 Begin
                   // format: '/path' : 'component-name';
                   P := 0;
                   InQuotes := False;
                   For j := 1 To Length(Trimmed) Do
                     Begin
                       If Trimmed[j] = '''' Then InQuotes := Not InQuotes

                       Else If (Trimmed[j] = ':') And Not InQuotes Then
                              Begin
                                P := j;
                                Break;
                              End;
                     End;

                   If P > 0 Then
                     Begin
                       RE.Path := Trim(Copy(Trimmed, 1, P - 1));
                       RE.Component := Trim(Copy(Trimmed, P + 1, Length(Trimmed)
                                       ));

                       // Remove quotes and trailing semicolon

                       RE.Path := StringReplace(RE.Path, '''', '', [rfReplaceAll
                                  ]);
                       RE.Component := StringReplace(RE.Component, '''', '', [
                                       rfReplaceAll]);
                       RE.Component := StringReplace(RE.Component, ';', '', [
                                       rfReplaceAll]);
                       RE.Path := Trim(RE.Path);
                       RE.Component := Trim(RE.Component);
                       SetLength(Parsed.Routes, Length(Parsed.Routes) + 1);
                       Parsed.Routes[High(Parsed.Routes)] := RE;
                     End;
                 End;
             End;

          3: // METHODS: raw Pascal code
             Begin
               Parsed.MethodsCode := Parsed.MethodsCode + Lines[i] + #10;
             End;

          4: // BEFOREEACH: raw Pascal code
             Begin
               Parsed.BeforeEachCode := Parsed.BeforeEachCode + Lines[i] + #10;
             End;

          5: // CREATED
             Begin
               Parsed.CreatedCode := Parsed.CreatedCode + Lines[i] + #10;
             End;

          6: // MOUNTED
             Begin
               Parsed.MountedCode := Parsed.MountedCode + Lines[i] + #10;
             End;

          7: // WATCH
             Begin
               Parsed.WatchCode := Parsed.WatchCode + Lines[i] + #10;
             End;

          8: // COMPUTED
             Begin
               Parsed.ComputedCode := Parsed.ComputedCode + Lines[i] + #10;
             End;

          9: // PROVIDE
             Begin
               Parsed.ProvideCode := Parsed.ProvideCode + Lines[i] + #10;
             End;

          10: // INJECT
              Begin
                Parsed.InjectCode := Parsed.InjectCode + Lines[i] + #10;
              End;

          11: // UPDATED
              Begin
                Parsed.UpdatedCode := Parsed.UpdatedCode + Lines[i] + #10;
              End;
        End;
      End;

  Finally

    Lines.Free;
End;
End;

// =====================================================================
//  COMPONENT MEMBER & SUB-BLOCK CODE GENERATORS
// =====================================================================



{
  This subsystem compiles individual sections of a Single File Component
  (.bv) into their corresponding Object Pascal representations:
  - CleanPascalProps:       Sanitizes props & identifiers for Pascal syntax
  - GenerateDataCode:       Generates data(): TJSObject reactive state factory
  - GeneratePropsCode:      Generates declared component props array
  - GenerateMethodsCode:    Extracts and compiles methods & event handlers
  - GenerateComputedCode:   Generates reactive computed getters with caching
  - GenerateWatchCode:      Generates reactive watchers
  - GenerateLifecycleCode:  Generates lifecycle hooks (created, mounted, etc.)
  - GenerateProvideCode:    Generates dependency injection provide blocks
  - GenerateInjectCode:     Generates dependency injection inject blocks
  - GenerateTemplateString: Compiles HTML template into escaped Pascal string
  - GenerateStyleInjection: Compiles scoped/global CSS for runtime DOM injection
}




{ Returns the position after a comment that starts at I, or inside asm after a JS comment or JS string; returns I when none starts there. Apostrophes in these must not toggle the Pascal string state. }
Function SkipNonCode(Const S: String; I: Integer; InAsm: Boolean): Integer;

Var 
  Q: Char;
Begin
  Result := I;
  If (I < Length(S)) And (S[I] = '/') And (S[I + 1] = '/') Then
    Begin
      Result := I + 2;
      While (Result <= Length(S)) And Not (S[Result] In [#10, #13]) Do
        Inc(Result);
    End
  Else If InAsm Then
         Begin
           If (I < Length(S)) And (S[I] = '/') And (S[I + 1] = '*') Then
             Begin
               Result := PosEx('*/', S, I + 2);
               If Result = 0 Then Result := Length(S) + 1
               Else Result := Result + 2;
             End
           Else If S[I] In ['''', '"', '`'] Then
                  Begin
                    Q := S[I];
                    Result := I + 1;
                    While (Result <= Length(S)) And (S[Result] <> Q) And Not ((Q
                          <> '`') And (S[Result] In [#10, #13])) Do
                      Begin
                        If S[Result] = '\' Then Inc(Result);
                        Inc(Result);
                      End;
                    If (Result <= Length(S)) And (S[Result] = Q) Then Inc(Result
                      );
                  End;
         End
  Else If S[I] = '{' Then
         Begin
           Result := PosEx('}', S, I + 1);
           If Result = 0 Then Result := Length(S) + 1
           Else Inc(Result);
         End
  Else If (I < Length(S)) And (S[I] = '(') And (S[I + 1] = '*') Then
         Begin
           Result := PosEx('*)', S, I + 2);
           If Result = 0 Then Result := Length(S) + 1
           Else Result := Result + 2;
         End;
End;

Function NormalizeTypedThisFieldType(Const FT: String): string;

Var 
  L: string;
Begin
  L := LowerCase(Trim(FT));
  If L = 'string' Then Result := 'string'
  Else If (L = 'integer') Or (L = 'int32') Or (L = 'int64') Or (L = 'longint')
          Or (L = 'uint32') Then Result := 'Integer'
  Else If (L = 'double') Or (L = 'real') Or (L = 'float') Or (L = 'float32')
          Or (L = 'float64') Or (L = 'number') Or (L = 'extended') Then
         Result := 'Double'
  Else If (L = 'boolean') Or (L = 'bool') Then Result := 'Boolean'
  Else Result := '';
End;

Function IsPascalReservedForField(Const Ident: String): Boolean;

Const 
  KW: array[0..47] Of string = (
                                'and', 'array', 'as', 'asm', 'begin', 'case',
                                'class', 'const',
                                'constructor', 'destructor', 'div', 'do',
                                'downto', 'else', 'end',
                                'except', 'exit', 'exports', 'file',
                                'finalization', 'finally', 'for',
                                'function', 'goto', 'if', 'implementation', 'in'
                                , 'inherited',
                                'initialization', 'inline', 'interface', 'is',
                                'label', 'mod', 'nil',
                                'not', 'object', 'of', 'or', 'packed',
                                'procedure', 'program',
                                'property', 'raise', 'record', 'repeat',
                                'result', 'type'
                               );

Var 
  L: string;
  K: Integer;
Begin
  L := LowerCase(Trim(Ident));
  If L = '' Then Exit(True);
  For K := Low(KW) To High(KW) Do
    If L = KW[K] Then Exit(True);
  If (L = 'self') Or (L = 'set') Or (L = 'shl') Or (L = 'shr') Or
     (L = 'string') Or (L = 'then') Or (L = 'to') Or (L = 'try') Or
     (L = 'unit') Or (L = 'until') Or (L = 'uses') Or (L = 'var') Or
     (L = 'while') Or (L = 'with') Or (L = 'xor') Or (L = 'true') Or (L =
     'false') Then
    Exit(True);
  Result := Not (L[1] In ['a'..'z', '_']);
End;

Function HasTypedThisField(Const Fields: Array Of TDataField; Const Ident:
                           String): Boolean;

Var 
  i: Integer;
Begin
  Result := False;
  If IsPascalReservedForField(Ident) Then Exit(False);
  For i := 0 To High(Fields) Do
    Begin
      If (Fields[i].Name = Ident) And (NormalizeTypedThisFieldType(Fields[i].
         FieldType) <> '') Then
        Exit(True);
    End;
End;

Function GenerateComponentThisType(Const Fields: Array Of TDataField): string;

Var 
  i: Integer;
  FT, Body: string;
  Seen: TStringList;
Begin
  Result := '';
  Body := '';
  Seen := TStringList.Create;
  Try
    For i := 0 To High(Fields) Do
      Begin
        If (Fields[i].Name = '') Or IsPascalReservedForField(Fields[i].Name) Or
           (Seen.IndexOf(Fields[i].Name) >= 0) Then Continue;
        FT := NormalizeTypedThisFieldType(Fields[i].FieldType);
        If FT <> '' Then
          Begin
            Seen.Add(Fields[i].Name);
            Body := Body + '    ' + Fields[i].Name + ': ' + FT + ';' + #10;
          End;
      End;
  Finally
    Seen.Free;
End;
If Body <> '' Then
  Result := 
            'type' + #10 +
            '  TComponentThis = class external name ''Object'' (TJSObject)' + #10 +
            Body +
            '  end;' + #10#10;
End;

Function CleanPascalPropsTyped(Const S: String; Const Fields: Array Of
                               TDataField): string;

Var 
  i, j, k, closeP, parenLevel: Integer;
  Identifier, args, repStr: string;
  Res: string;
  InQuote, InAsm, inQ: Boolean;
Begin
  Res := S;
  InQuote := False;
  InAsm := False;
  i := 1;
  While i <= Length(Res) - 4 Do
    Begin
      If Not InQuote Then
        Begin
          k := SkipNonCode(Res, i, InAsm);
          If k > i Then
            Begin
              i := k;
              Continue;
            End;
        End;
      If Res[i] = '''' Then InQuote := Not InQuote;
      If Not InQuote Then
        Begin
          If (i <= Length(Res)-2) And (LowerCase(Copy(Res, i, 3)) = 'asm') And (
             (i=1) Or (Not (Res[i-1] In ['a'..'z', 'A'..'Z', '0'..'9', '_'])))
            Then
            Begin
              k := i + 3;
              If (k > Length(Res)) Or (Res[k] <= ' ') Or (Res[k] = ';') Then
                InAsm := True;
            End;

          If (i <= Length(Res)-2) And (LowerCase(Copy(Res, i, 3)) = 'end') And (
             (i=1) Or (Not (Res[i-1] In ['a'..'z', 'A'..'Z', '0'..'9', '_'])))
             And (InAsm) Then
            Begin
              k := i+3;
              While (k <= Length(Res)) And (Res[k] <= ' ') Do
                Inc(k);
              If (k <= Length(Res)) And (Res[k] = ';') Then InAsm := False;
            End;
        End;

      If (Not InQuote) And (Not InAsm) And (i <= Length(Res) - 5) And (Copy(Res,
         i, 5) = 'this.') Then
        Begin
          j := i + 5;
          While (j <= Length(Res)) And (Res[j] In ['a'..'z', 'A'..'Z', '0'..'9',
                '_', '$']) Do
            Inc(j);
          Identifier := Copy(Res, i + 5, j - (i + 5));
          k := j;
          While (k <= Length(Res)) And (Res[k] = ' ') Do
            Inc(k);
          If (k <= Length(Res)) And (Res[k] = '(') Then
            Begin
              closeP := k + 1;
              inQ := False;
              parenLevel := 1;
              While (closeP <= Length(Res)) And (parenLevel > 0) Do
                Begin
                  If Res[closeP] = '''' Then inQ := Not inQ;
                  If Not inQ Then
                    Begin
                      If Res[closeP] = '(' Then Inc(parenLevel)

                      Else If Res[closeP] = ')' Then Dec(parenLevel);
                    End;

                  If parenLevel > 0 Then Inc(closeP);
                End;

              If parenLevel = 0 Then
                Begin
                  args := Trim(Copy(Res, k + 1, closeP - k - 1));
                  Delete(Res, i, (closeP + 1) - i);
                  If args = '' Then
                    Begin
                      repStr := 'CallMethod(_this, ''' + Identifier + ''')';
                    End

                  Else
                    Begin
                      repStr := 'CallMethod(_this, ''' + Identifier + ''', [' +
                                args + '])';
                    End;

                  Insert(repStr, Res, i);
                  i := i + Length(repStr);
                End

              Else
                Begin
                  Delete(Res, i, j - i);
                  If HasTypedThisField(Fields, Identifier) Then
                    repStr := 'TComponentThis(_this).' + Identifier
                  Else
                    repStr := 'TJSObject(_this)[''' + Identifier + ''']';
                  Insert(repStr, Res, i);
                  i := i + Length(repStr);
                End;
            End

          Else
            Begin
              Delete(Res, i, j - i);
              If HasTypedThisField(Fields, Identifier) Then
                repStr := 'TComponentThis(_this).' + Identifier
              Else
                repStr := 'TJSObject(_this)[''' + Identifier + ''']';
              Insert(repStr, Res, i);
              i := i + Length(repStr);
            End;
        End

      Else If (Not InQuote) And (Not InAsm) And (Copy(Res, i, 4) = 'this') And (
              (i = 1) Or (Not (Res[i-1] In ['a'..'z', 'A'..'Z', '0'..'9', '_']))
              ) And Not (Res[i+4] In ['a'..'z', 'A'..'Z', '0'..'9', '_', '.',
              '$']) Then
             Begin
               Delete(Res, i, 4);
               Insert('_this', Res, i);
               i := i + 5;
             End

      Else
        Inc(i);
    End;

  Result := Res;
End;




{ Preprocesses template expressions and Pascal identifiers to ensure type-safe member access (e.g. converting "state.prop" and "this.prop" accesses) while preserving inline string literals, comments and asm ... end blocks. }
Function CleanPascalProps(Const S: String): string;

Var 
  EmptyFields: array Of TDataField;
Begin
  SetLength(EmptyFields, 0);
  Result := CleanPascalPropsTyped(S, EmptyFields);
End;

Function NormalizeFieldLiteral(Const RawVal: String): string;

Var 
  T: string;
Begin
  T := Trim(RawVal);
  If Trim(T) = '[]' Then Exit('TJSArray.new');
  If Trim(T) = '{}' Then Exit('TJSObject.new');
  If (Length(T) >= 2) And (T[1] = '"') And (T[Length(T)] = '"') Then
    Exit('''' + StringReplace(Copy(T, 2, Length(T) - 2), '''', '''''', [
    rfReplaceAll]) + '''');
  If LowerCase(T) = 'true' Then Exit('True');
  If LowerCase(T) = 'false' Then Exit('False');
  Result := T;
End;




{ Generates the data(): TJSObject reactive state factory method for a component from its parsed data fields. }
Function GenerateDataCode(Const Fields: Array Of TDataField): string;

Var 
  i: Integer;
  Val, LType: string;
Begin
  If Length(Fields) = 0 Then
    Begin
      Result := '';
      Exit;
    End;

  Result := 

            '  comp[''data''] := function(): TJSObject' + #10 +

            '  var d: TJSObject;' + #10 +

            '  begin' + #10 +

            '    d := TJSObject.new;' + #10;

  For i := 0 To High(Fields) Do
    Begin
      If Fields[i].IsProp Then Continue;
      // Props don't go into initial data return

      Val := Trim(Fields[i].DefaultValue);
      LType := LowerCase(Trim(Fields[i].FieldType));
      If Val = '' Then
        Begin
          If LType = 'string' Then
            Val := ''''''

          Else If (LType = 'integer') Or (LType = 'int32') Or (LType = 'int64')
                  Or (LType = 'uint32') Then
                 Val := '0'

          Else If (LType = 'double') Or (LType = 'float32') Or (LType =
                  'float64') Or (LType = 'real') Then
                 Val := '0.0'

          Else If (LType = 'boolean') Or (LType = 'bool') Then
                 Val := 'False'

          Else
            Val := '''''';
        End

      Else
        Val := NormalizeFieldLiteral(Val);

      Result := Result + '    d[''' + Fields[i].Name + '''] := ' + Val + ';' + #10;
    End;

  Result := Result +

            '    Result := d;' + #10 +

            '  end;' + #10;
End;




{ Generates the declared props array and property accessors for component parameter binding. }
Function GeneratePropsCode(Const Fields: Array Of TDataField): string;

Var 
  i: Integer;
  First: Boolean;
  Val: string;
Begin
  Result := '';
  First := True;
  For i := 0 To High(Fields) Do
    Begin
      If Fields[i].IsProp Then
        Begin
          If First Then
            Begin
              Result := '  comp[''props''] := TJSArray.new;' + #10 +
                        '  comp[''defaultProps''] := TJSObject.new;' + #10;

              First := False;
            End;

          Result := Result + '  TJSArray(comp[''props'']).push(''' + Fields[i].
                    Name + ''');' + #10;
          If Fields[i].DefaultValue <> '' Then
            Begin
              Val := NormalizeFieldLiteral(Fields[i].DefaultValue);
              Result := Result + '  TJSObject(comp[''defaultProps''])[''' +
                        Fields[i].Name + '''] := ' + Val + ';' + #10;
            End;
        End;
    End;
End;




{ Finds the next routine header in a methods, computed or watch section. Only a keyword
  outside every begin..end block counts, so the same word inside a body, an asm block,
  a string or a comment does not start a new member. }
Function FindMemberStart(Const S, Keyword1: String; Const Keyword2: String = '')
: Integer;

Var 
  i, j, n, Depth: Integer;
  InAsm: Boolean;
  Quote: Char;
  Word: string;
Begin
  Result := 0;
  n := Length(S);
  i := 1;
  Depth := 0;
  InAsm := False;
  While i <= n Do
    Begin
      If (S[i] = '''') Or (InAsm And (S[i] In ['"', '`'])) Then
        Begin
          Quote := S[i];
          Inc(i);
          While (i <= n) And (S[i] <> Quote) And ((Quote = '`') Or Not (S[i] In
                [#10, #13])) Do
            Begin
              If InAsm And (S[i] = '\') Then Inc(i);
              Inc(i);
            End;
          Inc(i);
          Continue;
        End;
      If (S[i] = '/') And (i < n) And (S[i + 1] = '/') Then
        Begin
          While (i <= n) And Not (S[i] In [#10, #13]) Do
            Inc(i);
          Continue;
        End;
      If InAsm And (S[i] = '/') And (i < n) And (S[i + 1] = '*') Then
        Begin
          j := PosEx('*/', S, i + 2);
          If j = 0 Then Exit;
          i := j + 2;
          Continue;
        End;
      If (Not InAsm) And (S[i] = '{') Then
        Begin
          j := PosEx('}', S, i + 1);
          If j = 0 Then Exit;
          i := j + 1;
          Continue;
        End;
      If (Not InAsm) And (S[i] = '(') And (i < n) And (S[i + 1] = '*') Then
        Begin
          j := PosEx('*)', S, i + 2);
          If j = 0 Then Exit;
          i := j + 2;
          Continue;
        End;
      If S[i] In ['a'..'z', 'A'..'Z', '_'] Then
        Begin
          j := i;
          While (j <= n) And (S[j] In ['a'..'z', 'A'..'Z', '0'..'9', '_']) Do
            Inc(j);
          Word := LowerCase(Copy(S, i, j - i));
          If InAsm Then
            Begin
              If (Word = 'end') And ((i = 1) Or (S[i - 1] <> '.')) Then
                Begin
                  InAsm := False;
                  Dec(Depth);
                End;
            End
          Else If (Word = 'begin') Or (Word = 'case') Or (Word = 'try') Or (Word
                  = 'record') Then
                 Inc(Depth)
          Else If Word = 'asm' Then
                 Begin
                   Inc(Depth);
                   InAsm := True;
                 End
          Else If Word = 'end' Then
                 Begin
                   If Depth > 0 Then Dec(Depth);
                 End
          Else If (Depth = 0) And ((Word = Keyword1) Or (Word = Keyword2)) And (
                  j <= n) And (S[j] In [' ', #9, #10, #13]) Then
                 Exit(i);
          i := j;
          Continue;
        End;
      Inc(i);
    End;
End;




{ Extracts and compiles Pascal procedures and functions declared in the <script> block, binding them to the component instance dispatch table. }
Function GenerateMethodsCodeTyped(Const RawCode: String; Const Fields: Array Of
                                  TDataField): string;

Var 
  Parts, SubParts: TStringList;
  i, p, pParen, pClose: Integer;
  Sig, Body, Name, Params, Block, ReturnType: string;
  IsFunction: Boolean;
Begin
  Result := '';
  If Trim(RawCode) = '' Then Exit;
  Parts := TStringList.Create;
  SubParts := TStringList.Create;
  Try

    // Split by 'procedure ' and 'function '

    Block := RawCode;
    p := FindMemberStart(Block, 'procedure', 'function');
    While p > 0 Do
      Begin
        IsFunction := LowerCase(Copy(Block, p, 8)) = 'function';
        If IsFunction Then Block := Copy(Block, p + 9, Length(Block))

        Else Block := Copy(Block, p + 10, Length(Block));
        // After 'procedure '



        // Find end of signature (first semicolon outside parentheses)

        pParen := Pos('(', Block);
        If (pParen > 0) And (pParen < Pos(';', Block)) Then
          Begin
            pClose := Pos(')', Block);
            If pClose > 0 Then
              Begin
                p := pClose + 1;
                While (p <= Length(Block)) And (Block[p] <> ';') Do
                  Inc(p);
              End

            Else
              p := Pos(';', Block);
          End

        Else
          p := Pos(';', Block);

        If p = 0 Then Break;
        Sig := Trim(Copy(Block, 1, p - 1));






 // Finds the body end (delimited by the next procedure or the end of the block)

        Body := Copy(Block, p + 1, Length(Block));
        p := FindMemberStart(Body, 'procedure', 'function');
        If p > 0 Then Body := Copy(Body, 1, p - 1);



        // Splits the return type off a function signature

        ReturnType := 'JSValue';
        If IsFunction Then
          Begin
            p := LastDelimiter(':)', Sig);
            If (p > 0) And (Sig[p] = ':') Then
              Begin
                ReturnType := Trim(Copy(Sig, p + 1, Length(Sig)));
                Sig := Trim(Copy(Sig, 1, p - 1));
              End;
          End;

        // Extracts name and parameters from the signature

        p := Pos('(', Sig);
        If p > 0 Then
          Begin
            Name := Trim(Copy(Sig, 1, p - 1));
            Params := Copy(Sig, p, Length(Sig));
          End

        Else
          Begin
            Name := Trim(Sig);
            Params := '';
          End;



        // Strips Pascal keywords from the JS property name

        Name := StringReplace(Name, 'procedure ', '', [rfReplaceAll,
                rfIgnoreCase]);
        Name := StringReplace(Name, 'function ', '', [rfReplaceAll, rfIgnoreCase
                ]);
        Name := Trim(Name);
        If (Params = '') Or (Trim(Params) = '()') Then Params := 


                                                            '(_this: TJSObject)'

        Else Params := '(_this: TJSObject; ' + Copy(Params, 2, Length(Params));
        If IsFunction Then
          Result := Result + '  m[''' + Name + '''] := function' + Params + ': '
                    + ReturnType + #10 +

                    CleanPascalPropsTyped(Body, Fields) + #10

        Else
          Result := Result + '  m[''' + Name + '''] := procedure' + Params + #10
                    +

                    CleanPascalPropsTyped(Body, Fields) + #10;



        p := FindMemberStart(Block, 'procedure', 'function');
      End;

  Finally

    Parts.Free;
    SubParts.Free;
End;
End;

Function GenerateMethodsCode(Const RawCode: String): string;

Var 
  EmptyFields: array Of TDataField;
Begin
  SetLength(EmptyFields, 0);
  Result := GenerateMethodsCodeTyped(RawCode, EmptyFields);
End;




{ Transforms the HTML <template> into an escaped, multiline Pascal string literal constant for runtime DOM mounting. }
Function GenerateTemplateString(Const Template: String): string;

Var 
  Lines: TStringList;
  i: Integer;
  L: string;
Begin
  Lines := TStringList.Create;
  Try

    Lines.Text := Template;
    Result := '';
    For i := 0 To Lines.Count - 1 Do
      Begin
        L := EscapeQuotes(Lines[i]);
        If i = 0 Then
          Result := '    ''' + L + ''''

        Else
          Result := Result + ' +' + #10 + '    ''' + L + '''';
      End;

    // Remove trailing empty line artifacts

    If Result = '' Then
      Result := '    ''''';

  Finally

    Lines.Free;
End;
End;




{ Compiles <style> tag content into a client-side stylesheet injector for scoped and global component styling. }
Function GenerateStyleInjection(Const Style: String): string;

Var 
  CleanCSS: string;
Begin
  If Trim(Style) = '' Then
    Begin
      Result := '';
      Exit;
    End;

  // Clean CSS: remove line breaks and escape quotes for JS

  CleanCSS := StringReplace(Trim(Style), #13, '', [rfReplaceAll]);
  CleanCSS := StringReplace(CleanCSS, #10, ' ', [rfReplaceAll]);

  // Pascal uses doubled single quotes for strings

  CleanCSS := StringReplace(CleanCSS, '''', '''''', [rfReplaceAll]);



  Result := 

            '  _styleEl := TJSHTMLElement(document.createElement(''style''));' +
            #10 +

            '  _styleEl.textContent := ''' + CleanCSS + ''';' + #10 +

            '  document.head.appendChild(_styleEl);' + #10;
End;




{ Emits lifecycle hook registration code (created, mounted, updated, destroyed) for component lifecycle management. }
Function GenerateLifecycleCodeTyped(Const Key, RawCode: String; Const Fields:
                                    Array Of TDataField): string;

Var 
  CleanCode: string;
  pBegin: Integer;
Begin
  If Trim(RawCode) = '' Then
    Begin
      Result := '';
      Exit;
    End;



  // If it already has begin/end or variables, just wrap it. 




// We use CleanPascalProps to ensure it matches Pascal standards for the Unit generation.

  Result := '  comp[''' + Key + '''] := procedure(_this: TJSObject)' + #10;
  CleanCode := CleanPascalPropsTyped(RawCode, Fields);
  pBegin := Pos('begin', LowerCase(CleanCode));
  If (pBegin > 0) Or (Pos('var', LowerCase(CleanCode)) > 0) Then
    Begin
      If pBegin > 0 Then
        Begin
          Insert(#10 + '      asm if (!_this) _this = this; end;' + #10,
                 CleanCode, pBegin + 5);
        End;

      Result := Result + CleanCode + #10 + '    ;' + #10;
    End

  Else
    Result := Result + '    begin' + #10 +
              '      asm if (!_this) _this = this; end;' + #10 + CleanCode + #10
              + '    end;' + #10;
End;

Function GenerateLifecycleCode(Const Key, RawCode: String): string;

Var 
  EmptyFields: array Of TDataField;
Begin
  SetLength(EmptyFields, 0);
  Result := GenerateLifecycleCodeTyped(Key, RawCode, EmptyFields);
End;




{ Generates reactive state watcher callbacks that trigger on specific data mutations. }
Function GenerateWatchCode(Const RawCode: String): string;

Var 
  Parts, SubParts: TStringList;
  i, p, p2: Integer;
  Sig, Body, Name, Params, Block: string;
Begin
  Result := '';
  If Trim(RawCode) = '' Then Exit;
  Result := '  comp[''watch''] := TJSObject.new;' + #10;
  Parts := TStringList.Create;
  Try

    Block := RawCode;
    p := FindMemberStart(Block, 'procedure');
    While p > 0 Do
      Begin
        Block := Copy(Block, p + 10, Length(Block));
        p := Pos(';', Block);
        If p = 0 Then Break;
        Sig := Trim(Copy(Block, 1, p - 1));
        Body := Copy(Block, p + 1, Length(Block));
        p2 := FindMemberStart(Body, 'procedure');
        If p2 > 0 Then Body := Copy(Body, 1, p2 - 1);
        p2 := Pos('(', Sig);
        If p2 > 0 Then
          Begin
            Name := Trim(Copy(Sig, 1, p2 - 1));
            Params := Copy(Sig, p2, Length(Sig));
          End

        Else
          Begin
            Name := Sig;
            Params := '';
          End;



        If Params = '' Then Params := '(_this: TJSObject)'

        Else Params := '(_this: TJSObject; ' + Copy(Params, 2, Length(Params));



        Result := Result + '  TJSObject(comp[''watch''])[''' + Name +
                  '''] := procedure' + Params + #10 +

                  CleanPascalProps(Body) + #10 +

                  ';' + #10;



        p := FindMemberStart(Block, 'procedure');
      End;

  Finally

    Parts.Free;
End;
End;




{ Generates reactive computed properties with automatic dependency tracking and result caching. }
Function GenerateComputedCodeTyped(Const RawCode: String; Const Fields: Array Of
                                   TDataField): string;

Var 
  p: Integer;
  Name, Block, Body: string;
Begin
  Result := '';
  If Trim(RawCode) = '' Then Exit;
  Result := '  comp[''computed''] := TJSObject.new;' + #10;
  Block := RawCode;
  p := FindMemberStart(Block, 'function');
  While p > 0 Do
    Begin
      Block := Copy(Block, p + 9, Length(Block));
      p := Pos(':', Block);
      If p = 0 Then Break;
      Name := Trim(Copy(Block, 1, p - 1));
      p := Pos(';', Block);
      If p = 0 Then Break;
      Body := Copy(Block, p + 1, Length(Block));
      p := FindMemberStart(Body, 'function');
      If p > 0 Then Body := Copy(Body, 1, p - 1);



      Result := Result + '  TJSObject(comp[''computed''])[''' + Name +
                '''] := function(_this: TJSObject): JSValue' + #10 +

                CleanPascalPropsTyped(Body, Fields) + #10 +

                ';' + #10;



      p := FindMemberStart(Block, 'function');
    End;
End;

Function GenerateComputedCode(Const RawCode: String): string;

Var 
  EmptyFields: array Of TDataField;
Begin
  SetLength(EmptyFields, 0);
  Result := GenerateComputedCodeTyped(RawCode, EmptyFields);
End;




{ Generates dependency injection "provide" descriptors for hierarchical state sharing. }
Function GenerateProvideCode(Const RawCode: String): string;

Var 
  CleanCode: string;
Begin
  If Trim(RawCode) = '' Then
    Begin
      Result := '';
      Exit;
    End;
  CleanCode := CleanPascalProps(RawCode);



  // If it already has structured begin/end (rare in .bv), just wrap it

  If (Pos('begin', LowerCase(CleanCode)) > 0) And (Pos('result', LowerCase(
     CleanCode)) > 0) Then
    Begin
      Result := '  comp[''provide''] := function(_this: TJSObject): TJSObject' +
                #10 +

                CleanCode + #10 + ';' + #10;
    End

  Else
    Begin
      // Common case: list of procedures or assignments

      Result := '  comp[''provide''] := function(_this: TJSObject): TJSObject' +
                #10 +

                '    ' + CleanCode + #10 +

                '    begin' + #10 +

                '       Result := TJSObject.new;' + #10 +

                '    end;' + #10 + ';' + #10;
    End;
End;




{ Generates dependency injection "inject" descriptors to resolve parent-provided services. }
Function GenerateInjectCode(Const RawCode: String): string;

Var 
  SL: TStringList;
  i: Integer;
Begin
  If Trim(RawCode) = '' Then
    Begin
      Result := '';
      Exit;
    End;
  SL := TStringList.Create;
  Try

    SL.CommaText := StringReplace(RawCode, ';', ',', [rfReplaceAll]);
    Result := '  comp[''inject''] := TJSArray.new;' + #10;
    For i := 0 To SL.Count - 1 Do
      If Trim(SL[i]) <> '' Then
        Result := Result + '  TJSArray(comp[''inject'']).push(''' + Trim(SL[i])
                  + ''');' + #10;

  Finally

    SL.Free;
End;
End;

