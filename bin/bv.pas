      WriteStringToFile(UnitPath, UnitContent);
      WriteLn('  [+] Synchronized Pascal unit: uAppVersion.pas (v' + AppVersion
              + ')');
    End;
End;

Var 
  CachedCliVersion: string = '';
{ Returns the current SemVer version string of the BlaiseVue CLI. }
Function GetCliVersion: string;

Const 
  BV_COMPILED_VERSION = {$I %BV_BUILD_VERSION%};

Var 
  CurP, SdkDir, PkgPath, Content, BuiltVer: string;
  PObj: TJSONObject;
Begin
  If CachedCliVersion <> '' Then
    Begin
      Result := CachedCliVersion;
      Exit;
    End;

  BuiltVer := Trim(BV_COMPILED_VERSION);
  If (Length(BuiltVer) > 1) And ((BuiltVer[1] = 'v') Or (BuiltVer[1] = 'V')) Then
    Delete(BuiltVer, 1, 1);

  PkgPath := GetCurrentDir + DirectorySeparator + 'package.json';
  If FileExists(PkgPath) Then
    Begin
      Try
        Content := ReadFileToString(PkgPath);
        PObj := TJSONObject(TJSONParser.Create(Content).Parse);
        Try
          If GetJsonString(PObj, 'name', '') = 'blaisevue' Then
            Begin
              Result := GetJsonString(PObj, 'version', IfThen(BuiltVer <> '', BuiltVer, '0.1.1'));
              CachedCliVersion := Result;
              Exit;
            End;
        Finally
          PObj.Free;
        End;
      Except
      End;
    End;

  If BuiltVer <> '' Then
    Begin
      Result := BuiltVer;
      CachedCliVersion := Result;
      Exit;
    End;

  Result := '0.1.1';
  PkgPath := GetSDKPath + 'package.json';
If Not FileExists(PkgPath) Then
  Begin
    SdkDir := ExtractFilePath(ParamStr(0));
    CurP := ExcludeTrailingPathDelimiter(SdkDir);
    PkgPath := ExtractFilePath(CurP) + 'package.json';
  End;
If FileExists(PkgPath) Then
  Begin
    Try
      Content := ReadFileToString(PkgPath);
      PObj := TJSONObject(TJSONParser.Create(Content).Parse);
      Try
        Result := GetJsonString(PObj, 'version', Result);
        CachedCliVersion := Result;
        Exit;
      Finally
        PObj.Free;
  End;
Except
End;
End;

CachedCliVersion := Result;
End;

{ Returns the major.minor version string of the BlaiseVue CLI (e.g. "0.1"). }
Function GetCliMajorMinor: string;

Var 
  FullVer: string;
  Dot1, Dot2: Integer;
Begin
  FullVer := GetCliVersion;
  Dot1 := Pos('.', FullVer);
  If Dot1 > 0 Then
    Begin
      Dot2 := PosEx('.', FullVer, Dot1 + 1);
      If Dot2 > 0 Then
        Result := Copy(FullVer, 1, Dot2 - 1)
      Else
        Result := FullVer;
    End
  Else
    Result := FullVer;
End;

{ Updates the "version" property of a package.json file on disk. }
Procedure UpdateJsonFileVersion(Const FilePath, NewVer: String);

Var 
  Content: string;
  Obj: TJSONObject;
Begin
  If Not FileExists(FilePath) Then Exit;
  Try
    Content := ReadFileToString(FilePath);
    Obj := TJSONObject(TJSONParser.Create(Content).Parse);
    Try
      SetJsonString(Obj, 'version', NewVer);
      WriteStringToFile(FilePath, Obj.FormatJSON([], 2));
      WriteLn('  [+] Synchronized: ' + FilePath + ' (v' + NewVer + ')');
    Finally
      Obj.Free;
End;
Except
  on E: Exception Do
        WriteLn('  [!] Notice: could not update ' + FilePath + ': ' + E.Message)
  ;
End;
End;




{ Synchronizes SemVer version strings across all official core packages in packages/core/. }
Procedure SyncMonorepoVersions(Const TargetVer: String);

Var 
  RootDir, TargetFile, CoreDir: string;
  SR: TSearchRec;
  BuildDate: string;
Begin
  RootDir := GetCurrentDir;
  If Not (DirectoryExists(RootDir + DirectorySeparator + 'core') And
     DirectoryExists(RootDir + DirectorySeparator + 'packages')) Then
    Begin
      If DirectoryExists(ExtractFilePath(RootDir) + 'core') And DirectoryExists(
         ExtractFilePath(RootDir) + 'packages') Then
        RootDir := ExcludeTrailingPathDelimiter(ExtractFilePath(RootDir))
      Else
        Begin
          RootDir := ExtractFilePath(ParamStr(0));
          RootDir := ExcludeTrailingPathDelimiter(RootDir);
          RootDir := ExcludeTrailingPathDelimiter(ExtractFilePath(RootDir));
        End;
    End;

  If Not (DirectoryExists(RootDir + DirectorySeparator + 'core') And
     DirectoryExists(RootDir + DirectorySeparator + 'packages')) Then
    Exit;

  BuildDate := FormatDateTime('yyyy-mm-dd', Now);
  TargetFile := RootDir + DirectorySeparator + 'package.json';
  UpdateJsonFileVersion(TargetFile, TargetVer);
  TargetFile := RootDir + DirectorySeparator + 'core' + DirectorySeparator +
                'uAppVersion.pas';
  If FileExists(TargetFile) Or DirectoryExists(RootDir + DirectorySeparator +
     'core') Then
    Begin
      WriteStringToFile(TargetFile,
                        'unit uAppVersion;' + #10#10 +
                        '{$mode objfpc}{$H+}' + #10#10 +
                        'interface' + #10#10 +
                        'const' + #10 +
                        '  APP_NAME = ''blaisevue'';' + #10 +
                        '  APP_VERSION = ''' + TargetVer + ''';' + #10 +
                        '  APP_AUTHOR = ''BlaiseVue Core Team'';' + #10 +



'  APP_LICENSE = ''GPL-2.0-only AND LGPL-2.1-only WITH Static-linking-exception'';'
                        + #10 +
                        '  APP_BUILD_DATE = ''' + BuildDate + ''';' + #10#10 +
                        'implementation' + #10#10 +
                        'end.' + #10);
      WriteLn('  [+] Synchronized: ' + TargetFile + ' (v' + TargetVer + ')');
    End;

  TargetFile := RootDir + DirectorySeparator + 'demo-app' + DirectorySeparator +
                'package.json';
  UpdateJsonFileVersion(TargetFile, TargetVer);
  TargetFile := RootDir + DirectorySeparator + 'demo-app' + DirectorySeparator +
                'src' + DirectorySeparator + 'uAppVersion.pas';
  If FileExists(TargetFile) Or DirectoryExists(RootDir + DirectorySeparator +
     'demo-app' + DirectorySeparator + 'src') Then
    Begin
      WriteStringToFile(TargetFile,
                        'unit uAppVersion;' + #10#10 +
                        '{$mode objfpc}{$H+}' + #10#10 +
                        'interface' + #10#10 +
                        'const' + #10 +
                        '  APP_NAME = ''blaisevue-demo-app'';' + #10 +
                        '  APP_VERSION = ''' + TargetVer + ''';' + #10 +
                        '  APP_AUTHOR = ''BlaiseVue Core Team'';' + #10 +
                        '  APP_LICENSE = ''MIT'';' + #10 +
                        '  APP_BUILD_DATE = ''' + BuildDate + ''';' + #10#10 +
                        'implementation' + #10#10 +
                        'end.' + #10);
      WriteLn('  [+] Synchronized: ' + TargetFile + ' (v' + TargetVer + ')');
    End;

  TargetFile := RootDir + DirectorySeparator + 'packages' + DirectorySeparator +
                'tools' + DirectorySeparator + 'blaise-vscode' +
                DirectorySeparator + 'package.json';
  If Not FileExists(TargetFile) Then
    TargetFile := RootDir + DirectorySeparator + 'packages' + DirectorySeparator
                  + 'tools' + DirectorySeparator + 'vscode-extension' +
                  DirectorySeparator + 'package.json';
  UpdateJsonFileVersion(TargetFile, TargetVer);
  TargetFile := RootDir + DirectorySeparator + 'packages' + DirectorySeparator +
                'tools' + DirectorySeparator + 'blaise-devtools' +
                DirectorySeparator + 'manifest.json';
  If Not FileExists(TargetFile) Then
    TargetFile := RootDir + DirectorySeparator + 'packages' + DirectorySeparator
                  + 'tools' + DirectorySeparator + 'devtools-extension' +
                  DirectorySeparator + 'manifest.json';
  UpdateJsonFileVersion(TargetFile, TargetVer);
  TargetFile := RootDir + DirectorySeparator + 'packages' + DirectorySeparator +
                'tools' + DirectorySeparator + 'blaise-vscode' +
                DirectorySeparator + 'tool.json';
  If FileExists(TargetFile) Then UpdateJsonFileVersion(TargetFile, TargetVer);
  TargetFile := RootDir + DirectorySeparator + 'packages' + DirectorySeparator +
                'tools' + DirectorySeparator + 'blaise-lazarus' +
                DirectorySeparator + 'tool.json';
  If FileExists(TargetFile) Then UpdateJsonFileVersion(TargetFile, TargetVer);
  TargetFile := RootDir + DirectorySeparator + 'packages' + DirectorySeparator +
                'tools' + DirectorySeparator + 'blaise-devtools' +
                DirectorySeparator + 'tool.json';
  If FileExists(TargetFile) Then UpdateJsonFileVersion(TargetFile, TargetVer);
  CoreDir := RootDir + DirectorySeparator + 'packages' + DirectorySeparator +
             'core' + DirectorySeparator;
  If DirectoryExists(CoreDir) And (FindFirst(CoreDir + '*', faDirectory, SR) = 0
     ) Then
    Begin
      Repeat
        If (SR.Name <> '.') And (SR.Name <> '..') And ((SR.Attr And faDirectory)
           <> 0) Then
          Begin
            TargetFile := CoreDir + SR.Name + DirectorySeparator +
                          'package.json';
            If FileExists(TargetFile) Then
              UpdateJsonFileVersion(TargetFile, TargetVer);
          End;
      Until FindNext(SR) <> 0;
      FindClose(SR);
    End;

  CachedCliVersion := TargetVer;
End;




{ Calculates the next SemVer version string according to the requested bump type (major, minor, patch). }
Function BumpSemVer(Const CurrentVer, BumpType: String): string;

Var 
  Parts: TStringList;
  Major, Minor, Patch: Integer;
  PatchStr: string;
  i: Integer;
Begin
  Major := 1;
  Minor := 0;
  Patch := 0;
  Parts := TStringList.Create;
  Try
    Parts.Delimiter := '.';
    Parts.StrictDelimiter := True;
    Parts.DelimitedText := CurrentVer;
    If Parts.Count >= 1 Then Major := StrToIntDef(Parts[0], 1);
    If Parts.Count >= 2 Then Minor := StrToIntDef(Parts[1], 0);
    If Parts.Count >= 3 Then
      Begin
        PatchStr := Parts[2];
        For i := 1 To Length(PatchStr) Do
          If Not (PatchStr[i] In ['0'..'9']) Then
            Begin
              PatchStr := Copy(PatchStr, 1, i - 1);
              Break;
            End;
        Patch := StrToIntDef(PatchStr, 0);
      End;
  Finally
    Parts.Free;
End;

If BumpType = 'major' Then
  Begin
    Inc(Major);
    Minor := 0;
    Patch := 0;
  End
Else If BumpType = 'minor' Then
       Begin
         Inc(Minor);
         Patch := 0;
       End
Else
  Begin
    Inc(Patch);
  End;

Result := IntToStr(Major) + '.' + IntToStr(Minor) + '.' + IntToStr(Patch);
End;




