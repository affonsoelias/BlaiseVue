             );
             WriteLn(


         '  pas2js remove-version [v]  Removes a cached Pas2JS compiler version'
             );
             WriteLn('');
             WriteLn('  # === Multi-Version SDK Management ===');
             WriteLn(


'  versions                   Displays global dashboard of active, bundled and cached versions'
             );
