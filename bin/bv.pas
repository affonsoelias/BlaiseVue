{ Returns True if the CLI is running inside the framework demo-app workspace. }
Function IsFrameworkCoreDemoApp: Boolean;

Var 
  CurDir, ParentDir: string;
Begin
  Result := False;
  CurDir := ExcludeTrailingPathDelimiter(GetCurrentDir);

  // 1. Inside demo-app child directory of BlaiseVue framework
  If SameText(ExtractFileName(CurDir), 'demo-app') Then
    Begin
      ParentDir := ExtractFilePath(CurDir);
      If FileExists(ParentDir + 'bin' + DirectorySeparator + 'bv.pas') Or
         FileExists(ParentDir + 'core' + DirectorySeparator + 'BVCompiler.pas')
         Or
         FileExists(ParentDir + 'packages' + DirectorySeparator + 'core' +
         DirectorySeparator + 'blaise-charts' + DirectorySeparator +
         'BVChart.bv') Or
         FileExists(ParentDir + 'packages' + DirectorySeparator +
         'blaise-charts' + DirectorySeparator + 'BVChart.bv') Then
        Begin
          Result := True;
          Exit;
        End;
    End;

  // 2. In root BlaiseVue repository
  If FileExists('bin' + DirectorySeparator + 'bv.pas') And DirectoryExists(
     'demo-app') Then
    Begin
      Result := True;
      Exit;
    End;
End;

{ Interactive project license configuration tool (bv license). }
Procedure CmdLicense;

Var 
  SubCmd, LicType, AuthorArg, YearArg: string;
  CanonId, LicTitle, LicBody: string;
  PkgJson: TJSONObject;
  AppName, AppVer, AppAuth, CurLic, LicFileContent: string;
  Lines: TStringList;
  i, MaxPreview: Integer;
Begin
  SubCmd := '';
  LicType := '';
  AuthorArg := '';
  YearArg := '';
  If ParamCount >= 2 Then
    SubCmd := LowerCase(Trim(ParamStr(2)));

  i := 3;
  While i <= ParamCount Do
    Begin
      If (LowerCase(ParamStr(i)) = '--author') Or (LowerCase(ParamStr(i)) = '-a'
         ) Then
        Begin
          If i + 1 <= ParamCount Then
            Begin
              AuthorArg := ParamStr(i + 1);
              Inc(i);
            End;
        End
      Else If Copy(LowerCase(ParamStr(i)), 1, 9) = '--author=' Then
             AuthorArg := Copy(ParamStr(i), 10, MaxInt)
      Else If (LowerCase(ParamStr(i)) = '--year') Or (LowerCase(ParamStr(i)) =
              '-y') Then
             Begin
               If i + 1 <= ParamCount Then
                 Begin
                   YearArg := ParamStr(i + 1);
                   Inc(i);
                 End;
             End
      Else If Copy(LowerCase(ParamStr(i)), 1, 7) = '--year=' Then
             YearArg := Copy(ParamStr(i), 8, MaxInt)
      Else If LicType = '' Then
             LicType := ParamStr(i);
      Inc(i);
    End;

  If (SubCmd = 'help') Or (SubCmd = '--help') Or (SubCmd = '-h') Then
    Begin
      WriteLn('');
      WriteLn('  BlaiseVue License Suite');
      WriteLn('  =======================');
      WriteLn('  Usage:');
      WriteLn(


     '    bv license list                  List all supported license templates'
      );
      WriteLn(


'    bv license show                  Display current project license and LICENSE preview'
      );
      WriteLn(


'    bv license set <type> [options]  Apply license to project and update package.json'
      );
      WriteLn(


    '    bv license <type> [options]      Shorthand for "bv license set <type>"'
      );
      WriteLn('');
      WriteLn('  Options:');
      WriteLn('    --author, -a <name>  Author name or organization');
      WriteLn('    --year, -y <year>    Copyright year (default: current year)')
      ;
      WriteLn('');
      WriteLn(


'  Supported types: mit, apache-2.0, lgpl-3.0, gpl-3.0, bsd-3, commercial, unlicense'
      );
      WriteLn('');
      Exit;
    End;

  If SubCmd = 'list' Then
    Begin
      WriteLn('');
      WriteLn('  Available BlaiseVue License Templates:');
      WriteLn('  --------------------------------------');
      WriteLn(


     '  mit          - MIT License (Permissive, open-source community standard)'
      );
      WriteLn(


   '  apache-2.0   - Apache License 2.0 (Permissive with explicit patent grant)'
      );
      WriteLn(


'  lgpl-2.1     - Modified GNU LGPL v2.1 with Static Linking Exception (Lazarus/FPC/BlaiseVue Core)'
      );
      WriteLn(


'  lgpl-3.0     - GNU Lesser General Public License v3.0 (Pascal library standard)'
      );
      WriteLn(


'  gpl-2.0      - GNU General Public License v2.0 (Standard GPL v2, BlaiseCLI tool)'
      );
      WriteLn(


            '  gpl-3.0      - GNU General Public License v3.0 (Strong copyleft)'
      );
      WriteLn(


    '  bsd-3        - BSD 3-Clause License (Permissive with attribution clause)'
      );
      WriteLn('  commercial   - Commercial / Proprietary (All rights reserved)')
      ;
      WriteLn('  unlicense    - The Unlicense (Public Domain dedication)');
      WriteLn('');
      Exit;
    End;

  If (SubCmd = 'show') Or (SubCmd = '') Then
    Begin
      CurLic := 'None';
      If LoadPackageJson(PkgJson) Then
        Begin
          CurLic := GetJsonString(PkgJson, 'license', 'None');
          PkgJson.Free;
        End;
      WriteLn('');
      WriteLn('  Project License Status');
      WriteLn('  ----------------------');
      WriteLn('  Identifier:   ' + CurLic);
      If FileExists('LICENSE') Then
        Begin
          WriteLn('  LICENSE File: Found in project root');
          WriteLn('');
          WriteLn('--- LICENSE Header Preview ---');
          LicFileContent := ReadFileToString('LICENSE');
          Lines := TStringList.Create;
          Try
            Lines.Text := LicFileContent;
            MaxPreview := Lines.Count - 1;
            If MaxPreview > 8 Then MaxPreview := 8;
            For i := 0 To MaxPreview Do
              WriteLn('  ', Lines[i]);
          Finally
            Lines.Free;
        End;
      WriteLn('------------------------------');
    End
  Else
    WriteLn(


'  LICENSE File: Not found in project root (run "bv license set <type>" to generate)'
    );
  WriteLn('');
  Exit;
End;

If SubCmd = 'set' Then
  Begin
    If LicType = '' Then
      Begin
        WriteLn('ERROR: License type is required. Example: bv license set mit');
        WriteLn('Run "bv license list" to view supported license templates.');
        Halt(1);
      End;
  End
Else
  Begin
    LicType := SubCmd;
  End;

AppName := ExtractFileName(ExcludeTrailingPathDelimiter(GetCurrentDir));
AppVer := '1.0.0';
AppAuth := AuthorArg;
If LoadPackageJson(PkgJson) Then
  Begin
    AppName := GetJsonString(PkgJson, 'name', AppName);
    AppVer := GetJsonString(PkgJson, 'version', AppVer);
    If AppAuth = '' Then
      AppAuth := GetJsonString(PkgJson, 'author', '');
  End;

If AppAuth = '' Then
  Begin
    AppAuth := GetEnvironmentVariable('USERNAME');
    If AppAuth = '' Then AppAuth := GetEnvironmentVariable('USER');
    If AppAuth = '' Then AppAuth := 'BlaiseVue Developer';
  End;

If Not GetLicenseDetails(LicType, CanonId, LicTitle, LicBody, AppAuth, YearArg)
  Then
  Begin
    WriteLn('ERROR: Unrecognized license type "' + LicType + '".');
    WriteLn('Run "bv license list" to view supported license templates.');
    If PkgJson <> Nil Then PkgJson.Free;
    Halt(1);
  End;

WriteStringToFile(GetCurrentDir + DirectorySeparator + 'LICENSE', LicBody);
WriteLn('  [+] Created LICENSE file (' + LicTitle + ')');
If PkgJson = Nil Then
  PkgJson := TJSONObject.Create;

SetJsonString(PkgJson, 'license', CanonId);
If AuthorArg <> '' Then
  SetJsonString(PkgJson, 'author', AuthorArg)
Else If GetJsonString(PkgJson, 'author', '') = '' Then
       SetJsonString(PkgJson, 'author', AppAuth);

SavePackageJson(PkgJson);
WriteLn('  [+] Updated package.json (license: "' + CanonId + '", author: "' +
        AppAuth + '")');
PkgJson.Free;
SyncAppVersionUnit(AppName, AppVer, AppAuth, CanonId);
WriteLn('  [+] License applied successfully: ' + CanonId);
End;




{ Interactive SemVer version bumping and metadata synchronization suite (bv meta). }
Procedure CmdMeta;

Var 
  SubCmd, FieldArg, ValueArg: string;
  PkgJson: TJSONObject;
  NameVal, VerVal, AuthVal, LicVal, DescVal, OldVer, NewVer: string;
  i: Integer;
Begin
  SubCmd := '';
  FieldArg := '';
  ValueArg := '';
  If ParamCount >= 2 Then
    SubCmd := LowerCase(Trim(ParamStr(2)));
  If ParamCount >= 3 Then
    FieldArg := LowerCase(Trim(ParamStr(3)));
  If ParamCount >= 4 Then
    Begin
      ValueArg := ParamStr(4);
      For i := 5 To ParamCount Do
        ValueArg := ValueArg + ' ' + ParamStr(i);
    End;

  If (SubCmd = '') Or (SubCmd = 'show') Then
    Begin
      If Not LoadPackageJson(PkgJson) Then
        Begin
          WriteLn('No package.json found in current directory.');
          WriteLn('Run "bv meta init" to initialize project metadata.');
          Exit;
        End;
      Try
        NameVal := GetJsonString(PkgJson, 'name', 'unnamed');
        VerVal := GetJsonString(PkgJson, 'version', '1.0.0');
        AuthVal := GetJsonString(PkgJson, 'author', 'Not specified');
        LicVal := GetJsonString(PkgJson, 'license', 'UNLICENSED');
        DescVal := GetJsonString(PkgJson, 'description', '');
        WriteLn('');
        WriteLn('  BlaiseVue Project Metadata');
        WriteLn('  ==========================');
        WriteLn('  Name:        ' + NameVal);
        WriteLn('  Version:     ' + VerVal);
        WriteLn('  Author:      ' + AuthVal);
        WriteLn('  License:     ' + LicVal);
        If DescVal <> '' Then
          WriteLn('  Description: ' + DescVal);
        If FileExists(GetCurrentDir + DirectorySeparator + 'src' +
           DirectorySeparator + 'uAppVersion.pas') Then
          WriteLn('  Pascal Unit: src/uAppVersion.pas (synchronized)')
        Else
          WriteLn('  Pascal Unit: None (run "bv meta init" to generate)');
        WriteLn('');
      Finally
        PkgJson.Free;
    End;
  Exit;
End;

If SubCmd = 'sync' Then
  Begin
    If Not LoadPackageJson(PkgJson) Then
      Begin
        WriteLn('ERROR: package.json not found in current directory.');
        Halt(1);
      End;
    Try
      VerVal := GetJsonString(PkgJson, 'version', '0.1.0');
      NameVal := GetJsonString(PkgJson, 'name', 'blaisevue');
      AuthVal := GetJsonString(PkgJson, 'author', 'BlaiseVue Core Team');
      LicVal := GetJsonString(PkgJson, 'license', 'MIT');
      WriteLn('');
      WriteLn('  BlaiseVue Monorepo & Project Version Synchronization');
      WriteLn('  ====================================================');
      WriteLn('  Source of Truth (package.json): v' + VerVal);
      WriteLn('');
      SyncAppVersionUnit(NameVal, VerVal, AuthVal, LicVal);
      SyncMonorepoVersions(VerVal);
      WriteLn('');
      WriteLn('  [SUCCESS] Single Source of Truth synchronization completed (v'
              + VerVal + ').');
      WriteLn('');
    Finally
      PkgJson.Free;
  End;
Exit;
End;

If SubCmd = 'init' Then
  Begin
    If Not LoadPackageJson(PkgJson) Then
      PkgJson := TJSONObject.Create;
    Try
      NameVal := GetJsonString(PkgJson, 'name', ExtractFileName(
                 ExcludeTrailingPathDelimiter(GetCurrentDir)));
      VerVal := GetJsonString(PkgJson, 'version', '1.0.0');
      AuthVal := GetJsonString(PkgJson, 'author', 'BlaiseVue Developer');
      LicVal := GetJsonString(PkgJson, 'license', 'MIT');
      DescVal := GetJsonString(PkgJson, 'description', 'BlaiseVue Application');
      SetJsonString(PkgJson, 'name', NameVal);
      SetJsonString(PkgJson, 'version', VerVal);
      SetJsonString(PkgJson, 'author', AuthVal);
      SetJsonString(PkgJson, 'license', LicVal);
      SetJsonString(PkgJson, 'description', DescVal);
      SavePackageJson(PkgJson);
      WriteLn('  [+] Initialized package.json metadata');
      SyncAppVersionUnit(NameVal, VerVal, AuthVal, LicVal);
    Finally
      PkgJson.Free;
  End;
Exit;
End;

If SubCmd = 'get' Then
  Begin
    If FieldArg = '' Then
      Begin
        WriteLn('Usage: bv meta get <name|version|author|license|description>');
        Halt(1);
      End;
    If Not LoadPackageJson(PkgJson) Then
      Begin
        WriteLn('ERROR: package.json not found in current directory.');
        Halt(1);
      End;
    Try
      WriteLn(GetJsonString(PkgJson, FieldArg, ''));
    Finally
      PkgJson.Free;
  End;
Exit;
End;

If SubCmd = 'set' Then
  Begin
    If (FieldArg = '') Or (ValueArg = '') Then
      Begin
        WriteLn(


          'Usage: bv meta set <name|version|author|license|description> <value>'
        );
        Halt(1);
      End;
    If Not LoadPackageJson(PkgJson) Then
      PkgJson := TJSONObject.Create;
    Try
      SetJsonString(PkgJson, FieldArg, ValueArg);
      SavePackageJson(PkgJson);
      WriteLn('  [+] Updated "' + FieldArg + '" to "' + ValueArg +
              '" in package.json');
      NameVal := GetJsonString(PkgJson, 'name', ExtractFileName(
                 ExcludeTrailingPathDelimiter(GetCurrentDir)));
      VerVal := GetJsonString(PkgJson, 'version', '1.0.0');
      AuthVal := GetJsonString(PkgJson, 'author', '');
      LicVal := GetJsonString(PkgJson, 'license', 'MIT');
      SyncAppVersionUnit(NameVal, VerVal, AuthVal, LicVal);
    Finally
      PkgJson.Free;
  End;
Exit;
End;

If SubCmd = 'bump' Then
  Begin
    If (FieldArg <> 'patch') And (FieldArg <> 'minor') And (FieldArg <> 'major')
      Then
      Begin
        WriteLn('Usage: bv meta bump <patch|minor|major>');
        Halt(1);
      End;
    If Not LoadPackageJson(PkgJson) Then
      Begin
        WriteLn('ERROR: package.json not found in current directory.');
        Halt(1);
      End;
    Try
      OldVer := GetJsonString(PkgJson, 'version', '1.0.0');
      NewVer := BumpSemVer(OldVer, FieldArg);
      SetJsonString(PkgJson, 'version', NewVer);
      SavePackageJson(PkgJson);
      WriteLn('  [+] Version bumped: ' + OldVer + ' -> ' + NewVer + ' (' +
              FieldArg + ')');
      NameVal := GetJsonString(PkgJson, 'name', ExtractFileName(
                 ExcludeTrailingPathDelimiter(GetCurrentDir)));
      AuthVal := GetJsonString(PkgJson, 'author', '');
      LicVal := GetJsonString(PkgJson, 'license', 'MIT');
      SyncAppVersionUnit(NameVal, NewVer, AuthVal, LicVal);
      SyncMonorepoVersions(NewVer);
    Finally
      PkgJson.Free;
  End;
Exit;
End;

WriteLn('Unknown meta subcommand: "' + SubCmd + '".');
WriteLn(


'Usage: bv meta [show|init|get <field>|set <field> <val>|bump <patch|minor|major>|sync]'
);
Halt(1);
End;

{ Lists all configured unit search paths in blaisevue.json (bv path list). }
Procedure CmdPathList;

Var 
  AppCfgPath, Line, CleanLine, PathVal, PkgName: string;
  Lines: TStringList;
  CoreList, Pas2jsList, CustomList, JsonPasList, JsonDelsList: TStringList;
  i: Integer;
Begin
  AppCfgPath := GetCurrentDir + DirectorySeparator + 'app.cfg';
  If Not FileExists(AppCfgPath) Then
    Begin
      WriteLn('ERROR: app.cfg not found in current directory.');
      WriteLn('Ensure you are in the root of a BlaiseVue application.');
      Halt(1);
    End;

  Lines := TStringList.Create;
  CoreList := TStringList.Create;
  Pas2jsList := TStringList.Create;
  CustomList := TStringList.Create;
  Try
    Lines.LoadFromFile(AppCfgPath);
    For i := 0 To Lines.Count - 1 Do
      Begin
        Line := Trim(Lines[i]);
        If StartsText('-Fu', Line) Then
          Begin
            CleanLine := Copy(Line, 4, Length(Line) - 3);
            If (Length(CleanLine) >= 2) And (CleanLine[1] = '"') And (CleanLine[
               Length(CleanLine)] = '"') Then
              PathVal := Copy(CleanLine, 2, Length(CleanLine) - 2)
            Else
              PathVal := CleanLine;

            If (PathVal = 'generated') Or (PathVal = 'core') Or (PathVal =
               'common') Or
               (PathVal = 'src/services') Or (PathVal = 'src\services') Or (
               PathVal = 'src') Then
              CoreList.Add(PathVal)
            Else If (Pos('pas2js', LowerCase(PathVal)) > 0) Or (Pos('packages',
                    LowerCase(PathVal)) > 0) Then
                   Pas2jsList.Add(PathVal)
            Else
              CustomList.Add(PathVal);
          End;
      End;

    WriteLn('');
    WriteLn('  BlaiseVue Compiler Search Paths (app.cfg)');
    WriteLn('  =========================================');
    WriteLn('');
    WriteLn('  [Framework & Core Paths]');
    If CoreList.Count = 0 Then
      WriteLn('    (none)')
    Else
      For i := 0 To CoreList.Count - 1 Do
        WriteLn('    - ' + CoreList[i]);
    WriteLn('');
    WriteLn('  [Pas2JS Built-in Packages]');
    If Pas2jsList.Count = 0 Then
      WriteLn(


         '    (none - use "bv path add pas2js:<pkg>" to link official packages)'
      )
    Else
      Begin
        For i := 0 To Pas2jsList.Count - 1 Do
          Begin
            PkgName := ExtractFileName(ExcludeTrailingPathDelimiter(Pas2jsList[i
                       ]));
            If PkgName = 'src' Then
              PkgName := ExtractFileName(ExcludeTrailingPathDelimiter(
                         ExtractFilePath(ExcludeTrailingPathDelimiter(Pas2jsList
                         [i]))));
            WriteLn('    - pas2js:' + PadRight(PkgName, 16) + ' -> ' +
            Pas2jsList[i]);
          End;
      End;
    WriteLn('');
    WriteLn('  [Custom & Legacy Unit Paths]');
    If CustomList.Count = 0 Then
      WriteLn('    (none - use "bv path add <folder>" to link legacy units)')
    Else
      For i := 0 To CustomList.Count - 1 Do
        WriteLn('    - ' + CustomList[i]);

    JsonPasList := TStringList.Create;
    JsonDelsList := TStringList.Create;
    Try
      ResolvePascalSearchPaths(GetCurrentDir, JsonPasList);
      ResolveJsonSearchPaths(GetCurrentDir, 'delsafe', JsonDelsList, False);
      If (JsonPasList.Count > 0) Or (JsonDelsList.Count > 0) Then
        Begin
          WriteLn('');
          WriteLn('  [JSON Configured Paths (blaisevue.json / package.json)]');
          For i := 0 To JsonPasList.Count - 1 Do
            WriteLn('    - pascal: ' + JsonPasList[i]);
          For i := 0 To JsonDelsList.Count - 1 Do
            WriteLn('    - delsafe: ' + JsonDelsList[i]);
        End;
    Finally
      JsonPasList.Free;
      JsonDelsList.Free;
    End;
    WriteLn('');

  Finally
    Lines.Free;
    CoreList.Free;
    Pas2jsList.Free;
    CustomList.Free;
End;
End;

{ Appends a custom unit search path to blaisevue.json (bv path add). }
Procedure CmdPathAdd(Const Target: String);

Var 
  AppCfgPath, CleanTarget, ResolvedPath, FinalPath, FormattedLine, PkgNameOnly:


                                                                          string
  ;
  Lines: TStringList;
  IsPas2jsPkg: Boolean;
  i: Integer;
Begin
  If Target = '' Then
    Begin
      WriteLn('Usage: bv path add <folder|pas2js:package>');
      Halt(1);
    End;

  AppCfgPath := GetCurrentDir + DirectorySeparator + 'app.cfg';
  If Not FileExists(AppCfgPath) Then
    Begin
      WriteLn('ERROR: app.cfg not found in current directory.');
      Halt(1);
    End;

  CleanTarget := Trim(Target);
  IsPas2jsPkg := False;
  ResolvedPath := '';
  If StartsText('pas2js:', CleanTarget) Or ResolvePas2JSPackagePath(CleanTarget,
     ResolvedPath) Then
    Begin
      If Not ResolvePas2JSPackagePath(CleanTarget, ResolvedPath) Then
        Begin
          WriteLn('ERROR: Pas2JS package "' + CleanTarget +
                  '" not found in distribution.');
          WriteLn('Run "bv path available" to view all installable packages.');
          Halt(1);
        End;
      IsPas2jsPkg := True;
    End;

  If IsPas2jsPkg Then
    Begin
      FinalPath := ExtractRelativePath(GetCurrentDir + DirectorySeparator,
                   ResolvedPath);
      If FinalPath = '' Then FinalPath := ResolvedPath;
    End
  Else
    Begin
      If DirectoryExists(CleanTarget) Then
        FinalPath := CleanTarget
      Else If DirectoryExists(GetCurrentDir + DirectorySeparator + CleanTarget)
             Then
             FinalPath := CleanTarget
      Else
        Begin
          WriteLn('ERROR: Directory does not exist: "' + CleanTarget + '"');
          Halt(1);
        End;
    End;

  FinalPath := StringReplace(FinalPath, '\', '/', [rfReplaceAll]);
  If Pos(' ', FinalPath) > 0 Then
    FormattedLine := '-Fu"' + FinalPath + '"'
  Else
    FormattedLine := '-Fu' + FinalPath;

  Lines := TStringList.Create;
  Try
    Lines.LoadFromFile(AppCfgPath);
    For i := 0 To Lines.Count - 1 Do
      Begin
        If (Lines[i] = FormattedLine) Or (Lines[i] = '-Fu' + FinalPath) Or (
           Lines[i] = '-Fu"' + FinalPath + '"') Then
          Begin
            WriteLn('  Search path already present in app.cfg: ' + FinalPath);
            Exit;
          End;
      End;

    Lines.Add(FormattedLine);
    Lines.SaveToFile(AppCfgPath);
    WriteLn('');
    WriteLn('  [+] Search path added to app.cfg:');
    WriteLn('      ' + FormattedLine);
    If IsPas2jsPkg Then
      Begin
        PkgNameOnly := CleanTarget;
        If StartsText('pas2js:', PkgNameOnly) Then
          PkgNameOnly := Copy(PkgNameOnly, 8, Length(PkgNameOnly) - 7);
        WriteLn('      Package:     pas2js:' + PkgNameOnly);
        WriteLn('      Description: ' + GetPas2JSPackageDescription(PkgNameOnly)
        );
      End;
    WriteLn('  Units located in this path are now accessible in uses clauses.');
    WriteLn('');
  Finally
    Lines.Free;
End;
End;

{ Removes a unit search path from blaisevue.json (bv path remove). }
Procedure CmdPathRemove(Const Target: String);

Var 
  AppCfgPath, CleanTarget, NormTarget, Line, CleanLine, PathVal: string;
  Lines: TStringList;
  i: Integer;
  RemovedCount: Integer;
Begin
  If Target = '' Then
    Begin
      WriteLn('Usage: bv path remove <folder|pas2js:package>');
      Halt(1);
    End;

  AppCfgPath := GetCurrentDir + DirectorySeparator + 'app.cfg';
  If Not FileExists(AppCfgPath) Then
    Begin
      WriteLn('ERROR: app.cfg not found in current directory.');
      Halt(1);
    End;

  CleanTarget := Trim(Target);
  If StartsText('pas2js:', CleanTarget) Then
    CleanTarget := Copy(CleanTarget, 8, Length(CleanTarget) - 7);
  NormTarget := StringReplace(CleanTarget, '\', '/', [rfReplaceAll]);
  Lines := TStringList.Create;
  RemovedCount := 0;
  Try
    Lines.LoadFromFile(AppCfgPath);
    For i := Lines.Count - 1 Downto 0 Do
      Begin
        Line := Trim(Lines[i]);
        If StartsText('-Fu', Line) Then
          Begin
            CleanLine := Copy(Line, 4, Length(Line) - 3);
            If (Length(CleanLine) >= 2) And (CleanLine[1] = '"') And (CleanLine[
               Length(CleanLine)] = '"') Then
              PathVal := Copy(CleanLine, 2, Length(CleanLine) - 2)
            Else
              PathVal := CleanLine;

            PathVal := StringReplace(PathVal, '\', '/', [rfReplaceAll]);
            If (PathVal = NormTarget) Or (Pos('/' + NormTarget + '/', PathVal) >
               0) Or
               (EndsText('/' + NormTarget, PathVal)) Or (EndsText('/' +
               NormTarget + '/src', PathVal)) Then
              Begin
                Lines.Delete(i);
                Inc(RemovedCount);
                WriteLn('  [-] Removed from app.cfg: ' + Line);
              End;
          End;
      End;

    If RemovedCount > 0 Then
      Begin
        Lines.SaveToFile(AppCfgPath);
        WriteLn('');
        WriteLn('  [SUCCESS] Successfully removed ' + IntToStr(RemovedCount) +
        ' search path(s) from app.cfg.');
        WriteLn('');
      End
    Else
      Begin
        WriteLn('Notice: No matching search path found in app.cfg for "' +
                Target + '".');
        WriteLn('Run "bv path list" to see all currently active search paths.');
      End;
  Finally
    Lines.Free;
End;
End;




{ Lists all unit search paths available across the framework SDK (bv path available). }
Procedure CmdPathAvailable;

Var 
  Packages: TStringList;
  AppCfgContent, AppCfgPath, PkgName, Status, Desc: string;
  i: Integer;
Begin
  Packages := ListAvailablePas2JSPackages;
  AppCfgPath := GetCurrentDir + DirectorySeparator + 'app.cfg';
  If FileExists(AppCfgPath) Then
    AppCfgContent := LowerCase(ReadFileToString(AppCfgPath))
  Else
    AppCfgContent := '';

  Try
    WriteLn('');
    WriteLn('  Available Pas2JS Built-in Packages & Libraries');
    WriteLn('  ==============================================');
    WriteLn('  Use "bv path add pas2js:<package>" to link into your project.');
    WriteLn('');
    For i := 0 To Packages.Count - 1 Do
      Begin
        PkgName := Packages[i];
        Desc := GetPas2JSPackageDescription(PkgName);
        If (AppCfgContent <> '') And (Pos('/' + LowerCase(PkgName),
           AppCfgContent) > 0) Then
          Status := ' [active]'
        Else
          Status := '';

        WriteLn('  * pas2js:' + PadRight(PkgName, 16) + Status);
        WriteLn('    ' + Desc);
        WriteLn('');
      End;
  Finally
    Packages.Free;
End;
End;

{ Unit search path command dispatcher (bv path). }
Procedure CmdPath;

Var 
  SubCmd, TargetArg: string;
Begin
  RequireBlaiseVueProject('bv path');
  SubCmd := '';
  TargetArg := '';
  If ParamCount >= 2 Then SubCmd := LowerCase(ParamStr(2));
  If ParamCount >= 3 Then TargetArg := ParamStr(3);
  If (SubCmd = '') Or (SubCmd = 'list') Or (SubCmd = 'ls') Or (SubCmd = 'show')
    Then
    Begin
      CmdPathList;
      Exit;
    End;

  If (SubCmd = 'add') Or (SubCmd = 'link') Or (SubCmd = 'use') Then
    Begin
      If TargetArg = '' Then
        Begin
          WriteLn('Usage: bv path add <folder|pas2js:package>');
          Halt(1);
        End;
      CmdPathAdd(TargetArg);
      Exit;
    End;

  If (SubCmd = 'remove') Or (SubCmd = 'rm') Or (SubCmd = 'del') Or (SubCmd =
     'unlink') Then
    Begin
      If TargetArg = '' Then
        Begin
          WriteLn('Usage: bv path remove <folder|pas2js:package>');
          Halt(1);
        End;
      CmdPathRemove(TargetArg);
      Exit;
    End;

  If (SubCmd = 'available') Or (SubCmd = 'pas2js') Or (SubCmd = 'browse') Or (
     SubCmd = 'catalog') Then
    Begin
      CmdPathAvailable;
      Exit;
    End;

  WriteLn('Unknown path subcommand: "' + SubCmd + '".');
  WriteLn(


       'Usage: bv path [list|add <folder|pas2js:pkg>|remove <target>|available]'
  );
  Halt(1);
End;




{ Returns True if a directory name should be excluded from project compilation scans. }
Function IsIgnoredProjectDir(Const DirName: String): Boolean;

Var 
  LName: string;
Begin
  LName := LowerCase(DirName);
  Result := (LName = 'node_modules') Or
            (LName = '.git') Or
            (LName = 'dist') Or
            (LName = 'units') Or
            (LName = '.bv_backup') Or
            (LName = '.bv-backup') Or
            (LName = 'backup') Or
            (LName = 'lib_cache') Or
            (LName = 'tmp') Or
            (LName = 'temp') Or
            (LName = '.vscode') Or
            (LName = 'android') Or
            (LName = 'assets') Or
            (LName = 'bin') Or
            (LName = '.gradle');
End;




{ Determines if a file is an Object Pascal source file relevant for project compilation. }
Function IsRelevantProjectFile(Const FileName: String; IsRootDir: Boolean):


                                                                         Boolean
;

Var 
  Ext, LName: string;
Begin
  LName := LowerCase(FileName);
  Ext := LowerCase(ExtractFileExt(FileName));

  // 1. Core Pascal and BlaiseVue components in any project folder
  If (Ext = '.bv') Or (Ext = '.pas') Or (Ext = '.pp') Or (Ext = '.inc') Or (Ext
     = '.lpr') Then
    Exit(True);

  // 2. Project configuration & manifests (in root directory only)
  If IsRootDir Then
    Begin
      If (LName = 'app.cfg') Or (LName = 'app.json') Or (LName = 'index.html')
         Or
         (LName = 'package.json') Or (Ext = '.cfg') Then
        Exit(True);
    End;

  Result := False;
End;

{ Recursively discovers all Pascal source units in a project directory. }
Procedure CollectProjectUnits(Const Dir, RelPrefix: String; List: TStringList;
                              IsRootDir: Boolean = False);

Var 
  SR: TSearchRec;
  RelPath, FullPath: string;
Begin
  FullPath := IncludeTrailingPathDelimiter(Dir);
  If FindFirst(FullPath + '*', faAnyFile, SR) = 0 Then
    Begin
      Try
        Repeat
          If (SR.Name <> '.') And (SR.Name <> '..') Then
            Begin
              If (SR.Attr And faDirectory) <> 0 Then
                Begin
                  If Not IsIgnoredProjectDir(SR.Name) Then
                    CollectProjectUnits(FullPath + SR.Name,
                                        RelPrefix + SR.Name + DirectorySeparator
                                        , List, False);
                End
              Else
                Begin
                  If IsRelevantProjectFile(SR.Name, IsRootDir) Then
                    Begin



   // Skip the main project .lpr in root since it is already registered as Unit0
                      If Not (IsRootDir And (ExtractFileExt(SR.Name) = '.lpr'))
                        Then
                        Begin
                          RelPath := RelPrefix + SR.Name;
                          List.Add(RelPath);
                        End;
                    End;
                End;
            End;
        Until FindNext(SR) <> 0;
      Finally
        FindClose(SR);
    End;
End;
End;




{ Synchronizes root Lazarus IDE project files (<CleanName>.lpr and <CleanName>.lpi)
  for any BlaiseVue project directory and removes leftover demo_app.* template files. }
Procedure SyncLazarusProject(Const TargetDir: String; DryRun: Boolean;
                             out LazCreated, LazUpdated: Boolean; out UnitsCount
                             : Integer; out CleanNameOut: String);

Var 
  CurDir, ProjName, CleanName, LprFile, LpiFile, OldLpiContent: string;
  LprContent, LpiContent, RelFile: string;
  UnitsList: TStringList;
  i: Integer;
Begin
  CurDir := ExcludeTrailingPathDelimiter(TargetDir);
  ProjName := ExtractFileName(CurDir);
  CleanName := StringReplace(ProjName, '-', '_', [rfReplaceAll]);
  CleanName := StringReplace(CleanName, ' ', '_', [rfReplaceAll]);
  If CleanName = '' Then CleanName := 'BlaiseVueApp';
  CleanNameOut := CleanName;

  LprFile := CurDir + DirectorySeparator + CleanName + '.lpr';
  LpiFile := CurDir + DirectorySeparator + CleanName + '.lpi';
  LazCreated := (Not FileExists(LprFile)) Or (Not FileExists(LpiFile));
  LazUpdated := False;




// Clean up leftover template files (demo_app.lpi / demo_app.lpr / demo_app.lps) if project is not demo_app
  If LowerCase(CleanName) <> 'demo_app' Then
    Begin
      If FileExists(CurDir + DirectorySeparator + 'demo_app.lpi') Then
        Begin
          If Not DryRun Then DeleteFile(CurDir + DirectorySeparator +
                                        'demo_app.lpi');
          LazUpdated := True;
        End;
      If FileExists(CurDir + DirectorySeparator + 'demo_app.lpr') Then
        Begin
          If Not DryRun Then DeleteFile(CurDir + DirectorySeparator +
                                        'demo_app.lpr');
          LazUpdated := True;
        End;
      If FileExists(CurDir + DirectorySeparator + 'demo_app.lps') Then
        Begin
          If Not DryRun Then DeleteFile(CurDir + DirectorySeparator +
                                        'demo_app.lps');
          LazUpdated := True;
        End;
    End;

  // 1. Create <CleanName>.lpr if missing
  If Not FileExists(LprFile) Then
    Begin
      LprContent := 
                    'program ' + CleanName + ';' + #10 +
                    #10 +
                    '{$mode objfpc}{$H+}' + #10 +
                    #10 +
                    'uses' + #10 +
                    '  {$IFDEF UNIX}' + #10 +
                    '  cthreads,' + #10 +
                    '  {$ENDIF}' + #10 +
                    '  Classes, SysUtils;' + #10 +
                    #10 +
                    '// BlaiseVue Reactive Single File Components (.bv)' + #10 +
                    '// Press F9 in Lazarus IDE to launch the live dev server!'
                    + #10 +
                    'begin' + #10 +
                    '  WriteLn(''BlaiseVue Project: ' + CleanName + ''');' + #10
                    +
                    'end.' + #10;
      If Not DryRun Then
        WriteStringToFile(LprFile, LprContent);
    End;




 // 2. Collect all project files across the whole project (*.bv, *.pas, configs)
  UnitsList := TStringList.Create;
  Try
    CollectProjectUnits(CurDir, '', UnitsList, True);
    UnitsList.Sort;
    UnitsCount := UnitsList.Count;

    // 3. Assemble <CleanName>.lpi
    LpiContent := 
                  '<?xml version="1.0" encoding="UTF-8"?>' + #10 +
                  '<CONFIG>' + #10 +
                  '  <ProjectOptions>' + #10 +
                  '    <Version Value="12"/>' + #10 +
                  '    <General>' + #10 +
                  '      <Flags>' + #10 +
                  '        <MainUnitHasCreateFormStatements Value="False"/>' + #10 +
                  '        <MainUnitHasTitleStatement Value="False"/>' + #10 +
                  '        <Scaled Value="True"/>' + #10 +
                  '      </Flags>' + #10 +
                  '      <SessionStorage Value="InProjectDir"/>' + #10 +
                  '      <Title Value="' + CleanName + '"/>' + #10 +
                  '      <ResourceType Value="res"/>' + #10 +
                  '      <UseXPManifest Value="True"/>' + #10 +
                  '    </General>' + #10 +
                  '    <BuildModes Count="1">' + #10 +
                  '      <Item1 Name="Default" Default="True"/>' + #10 +
                  '    </BuildModes>' + #10 +
                  '    <PublishOptions>' + #10 +
                  '      <Version Value="2"/>' + #10 +
                  '      <UseFileFilters Value="True"/>' + #10 +
                  '    </PublishOptions>' + #10 +
                  '    <RunParams>' + #10 +
                  '      <FormatVersion Value="2"/>' + #10 +
                  '      <Modes ActiveMode="default">' + #10 +
                  '        <Mode Name="default">' + #10 +
                  '          <local>' + #10 +
                  '            <HostApplicationFilename Value="bv.exe"/>' + #10
                  +
                  '            <CommandLineParams Value="dev"/>' + #10 +
                  '          </local>' + #10 +
                  '        </Mode>' + #10 +
                  '      </Modes>' + #10 +
                  '    </RunParams>' + #10 +
                  '    <Units Count="' + IntToStr(UnitsList.Count + 1) + '">' +
                  #10 +
                  '      <Unit0>' + #10 +
                  '        <Filename Value="' + CleanName + '.lpr"/>' + #10 +
                  '        <IsPartOfProject Value="True"/>' + #10 +
                  '      </Unit0>' + #10;

    For i := 0 To UnitsList.Count - 1 Do
      Begin
        RelFile := UnitsList[i];
        LpiContent := LpiContent +
                      '      <Unit' + IntToStr(i + 1) + '>' + #10 +
                      '        <Filename Value="' + RelFile + '"/>' + #10 +
                      '        <IsPartOfProject Value="True"/>' + #10 +
                      '      </Unit' + IntToStr(i + 1) + '>' + #10;
      End;

    LpiContent := LpiContent +
                  '    </Units>' + #10 +
                  '  </ProjectOptions>' + #10 +
                  '  <CompilerOptions>' + #10 +
                  '    <Version Value="11"/>' + #10 +
                  '    <Target>' + #10 +
                  '      <Filename Value="bin/' + CleanName + '"/>' + #10 +
                  '    </Target>' + #10 +
                  '    <SearchPaths>' + #10 +
                  '      <IncludeFiles Value="$(ProjOutDir)"/>' + #10 +



'      <OtherUnitFiles Value="src;src/services;src/components;src/views;server;tests;desktop;generated;lib"/>'
                  + #10 +
                  '      <UnitOutputDirectory Value="generated/units"/>' + #10 +
                  '    </SearchPaths>' + #10 +
                  '    <Other>' + #10 +
                  '      <CustomOptions Value="-dBLAISEVUE"/>' + #10 +
                  '      <ExecuteBefore>' + #10 +
                  '        <Command Value="bv build"/>' + #10 +



             '        <CompileReasons Compile="True" Build="True" Run="False"/>'
                  + #10 +
                  '      </ExecuteBefore>' + #10 +
                  '    </Other>' + #10 +
                  '  </CompilerOptions>' + #10 +
                  '</CONFIG>' + #10;

    If FileExists(LpiFile) Then
      Begin
        OldLpiContent := StringReplace(ReadFileToString(LpiFile), #13#10, #10, [
                         rfReplaceAll]);
        If OldLpiContent <> LpiContent Then
          Begin
            LazUpdated := True;
            If Not DryRun Then
              WriteStringToFile(LpiFile, LpiContent);
          End;
      End
    Else
      Begin
        If Not DryRun Then
          WriteStringToFile(LpiFile, LpiContent);
      End;
  Finally
    UnitsList.Free;
End;
End;

{ Synchronizes server/server.lpi for Full-Stack mORMot 2 backend projects. }
Procedure SyncServerLazarusProject(Const ServerDir: String; DryRun: Boolean;
                                   out ServerLpiCreated, ServerLpiUpdated:
                                   Boolean; out ServerUnitsCount: Integer);

Var 
  CleanServerDir, ServerLpiFile, TplServerLpi, LpiContent, OldContent, UnitsXml,
  RelFile: string;
  UnitsList: TStringList;
  StartPos, EndPos, i: Integer;
Begin
  ServerLpiCreated := False;
  ServerLpiUpdated := False;
  ServerUnitsCount := 0;
  CleanServerDir := ExcludeTrailingPathDelimiter(ServerDir);
  ServerLpiFile := CleanServerDir + DirectorySeparator + 'server.lpi';
  TplServerLpi := GetSDKPath + 'templates' + DirectorySeparator +
                  'fullstack-mormot' + DirectorySeparator + 'server.lpi';

  If Not FileExists(ServerLpiFile) Then
    Begin
      If Not FileExists(TplServerLpi) Then Exit;
      ServerLpiCreated := True;
      LpiContent := ReadFileToString(TplServerLpi);
    End
  Else
    LpiContent := ReadFileToString(ServerLpiFile);

  OldContent := StringReplace(LpiContent, #13#10, #10, [rfReplaceAll]);
  LpiContent := OldContent;

  UnitsList := TStringList.Create;
  Try
    CollectProjectUnits(CleanServerDir, '', UnitsList, False);
    // Remove server.lpr if present (already Unit0)
    For i := UnitsList.Count - 1 Downto 0 Do
      If LowerCase(UnitsList[i]) = 'server.lpr' Then
        UnitsList.Delete(i);
    UnitsList.Sort;
    ServerUnitsCount := UnitsList.Count + 1;

    UnitsXml := 
                '    <Units Count="' + IntToStr(UnitsList.Count + 1) + '">' + #10 +
                '      <Unit0>' + #10 +
                '        <Filename Value="server.lpr"/>' + #10 +
                '        <IsPartOfProject Value="True"/>' + #10 +
                '      </Unit0>' + #10;

    For i := 0 To UnitsList.Count - 1 Do
      Begin
        RelFile := UnitsList[i];
        UnitsXml := UnitsXml +
                    '      <Unit' + IntToStr(i + 1) + '>' + #10 +
                    '        <Filename Value="' + RelFile + '"/>' + #10 +
                    '        <IsPartOfProject Value="True"/>' + #10 +
                    '      </Unit' + IntToStr(i + 1) + '>' + #10;
      End;
    UnitsXml := UnitsXml + '    </Units>';

    StartPos := Pos('    <Units Count="', LpiContent);
    If StartPos = 0 Then StartPos := Pos('<Units Count="', LpiContent);
    EndPos := Pos('</Units>', LpiContent);
    If (StartPos > 0) And (EndPos > StartPos) Then
      Begin
        LpiContent := Copy(LpiContent, 1, StartPos - 1) + UnitsXml + Copy(
                      LpiContent, EndPos + Length('</Units>'), MaxInt);
      End;

    If ServerLpiCreated Or (LpiContent <> OldContent) Then
      Begin
        If Not ServerLpiCreated Then
          ServerLpiUpdated := True;
        If Not DryRun Then
          WriteStringToFile(ServerLpiFile, LpiContent);
      End;
  Finally
    UnitsList.Free;
End;
End;




{ Generates and updates Lazarus IDE project files (.lpi, .lpr) for native IDE integration (bv lazarus). }
Procedure DoLazarusInitOrSync(Const AAction: String = 'init');

Var 
  SubCmd: string;
  CurDir, ProjName, CleanName, LprFile, LpiFile: string;
  LprContent, LpiContent, RelFile: string;
  UnitsList: TStringList;
  i: Integer;
