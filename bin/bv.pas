{ Scaffolds a complete project directory structure with sample pages }

Procedure CmdCreate(Const ProjectName: String);

Var 
  Base, TemplatePath, DownloadedDemoDir, DemoErr: string;
  Content, ArgLow, OldDir, BE, ExtToolName, ServerLabel, Suffix: string;
  IsLib, IsDemo, UseDelSafe, SkipNext, LazCreated, LazUpdated: Boolean;
  LicenseArg, RealProjectName, LazCleanName: string;
  i, k, RC, LazUnitsCount: Integer;
  RequestedBackends: TStringList;
  SR: TSearchRec;

Procedure AddBackendsCsv(Const Csv: String);

Var 
  Parts: TStringList;
  J: Integer;
  Item: string;
Begin
  Parts := TStringList.Create;
  Try
    Parts.Delimiter := ',';
    Parts.StrictDelimiter := True;
    Parts.DelimitedText := Csv;
    For J := 0 To Parts.Count - 1 Do
      Begin
        Item := LowerCase(Trim(Parts[J]));
        If (Item <> '') And (RequestedBackends.IndexOf(Item) < 0) Then
          RequestedBackends.Add(Item);
      End;
  Finally
    Parts.Free;
End;
End;

Begin
  IsLib := False;
  IsDemo := False;
  UseDelSafe := False;
  SkipNext := False;
  LicenseArg := '';
  RealProjectName := '';
  RequestedBackends := TStringList.Create;
  Try
    For i := 2 To ParamCount Do
      Begin
        If SkipNext Then
          Begin
            SkipNext := False;
            Continue;
          End;
        ArgLow := LowerCase(Trim(ParamStr(i)));
        If (ArgLow = '--lib') Or (ArgLow = '-l') Or (ArgLow = '--library') Then
          IsLib := True
        Else If (ArgLow = '--demo') Or (ArgLow = '--template=demo') Then
               IsDemo := True
        Else If (ArgLow = '--template') And (i + 1 <= ParamCount) Then
               Begin
                 If LowerCase(Trim(ParamStr(i + 1))) = 'demo' Then
                   IsDemo := True;
                 SkipNext := True;
               End
        Else If ArgLow = '--delsafe' Then
               UseDelSafe := True
        Else If ArgLow = '--mormot' Then
               AddBackendsCsv('mormot')
        Else If ArgLow = '--horse' Then
               AddBackendsCsv('horse')
        Else If ArgLow = '--zephyr' Then
               Begin
                 AddBackendsCsv('zephyr');
                 UseDelSafe := True;
               End
        Else If (ArgLow = '--backend') And (i + 1 <= ParamCount) Then
               Begin
                 AddBackendsCsv(ParamStr(i + 1));
                 SkipNext := True;
               End
        Else If Copy(ArgLow, 1, 10) = '--backend=' Then
               AddBackendsCsv(Copy(ParamStr(i), 11, MaxInt))
        Else If (ArgLow = '--license') And (i + 1 <= ParamCount) Then
               Begin
                 LicenseArg := LowerCase(Trim(ParamStr(i + 1)));
                 SkipNext := True;
               End
        Else If Copy(ArgLow, 1, 10) = '--license=' Then
               LicenseArg := LowerCase(Trim(Copy(ParamStr(i), 11, MaxInt)))
        Else If (Copy(ParamStr(i), 1, 1) <> '-') And (RealProjectName = '') Then
               RealProjectName := ParamStr(i);
      End;

    If RequestedBackends.IndexOf('zephyr') >= 0 Then
      UseDelSafe := True;

    If RealProjectName = '' Then
      Begin
        WriteLn(


'Usage: bv create <project-name> [--demo] [--delsafe] [--backend=<mormot|zephyr|<tool>>] [--mormot] [--zephyr] [--lib] [--license <mit|apache|lgpl|commercial|none>]'
        );
        Halt(1);
      End;

    If IsLib Then
      Begin
        CmdCreateLib(RealProjectName, LicenseArg);
        Exit;
      End;

    Base := GetCurrentDir + DirectorySeparator + RealProjectName +
            DirectorySeparator;
    TemplatePath := GetSDKPath + 'demo-app' + DirectorySeparator;
    If DirectoryExists(Base) Then
      Begin
        WriteLn('ERROR: Folder "', RealProjectName, '" already exists.');
        Halt(1);
      End;

    If IsDemo Then
      Begin
        If Not DirectoryExists(TemplatePath) Then
          Begin
            If Not TBVUpgrade.EnsureDemoAppTemplate(
                 ExcludeTrailingPathDelimiter(GetSDKPath),
                 TBVUpgrade.GetReleasesRepo, 'main',
                 DownloadedDemoDir, DemoErr) Then
              Begin
                WriteLn('ERROR: demo-app showcase template not found locally and could not be downloaded.');
                If DemoErr <> '' Then WriteLn('       ', DemoErr);
                Halt(1);
              End;
            TemplatePath := IncludeTrailingPathDelimiter(DownloadedDemoDir);
          End;

        WriteLn('Scaffolding BlaiseVue demo showcase project: ', RealProjectName
        );
        CopyDir(TemplatePath, Base, ['.git', '.github', 'node_modules', 'dist',
                'generated', '.blaisevue', 'framework', 'bin', 'units',
                'android', 'backup', 'deploy', '.bv_backup', '.gradle']);

        If DirectoryExists(Base + 'tests' + DirectorySeparator + 'framework')
          Then
          DeleteDir(Base + 'tests' + DirectorySeparator + 'framework');

        // Customize project name in package.json if it was copied
        If FileExists(Base + 'package.json') Then
          Begin
            Content := ReadFileToString(Base + 'package.json');
            Content := StringReplace(Content, '"name": "blaisevue-demo-app"',
                       '"name": "' + RealProjectName + '"', [rfReplaceAll]);
            Content := StringReplace(Content, '"name" : "blaisevue-demo-app"',
                       '"name" : "' + RealProjectName + '"', [rfReplaceAll]);
            Content := StringReplace(Content, '"name": "demo-app"', '"name": "'
                       + RealProjectName + '"', [rfReplaceAll]);
            Content := StringReplace(Content, '"name" : "demo-app"',
                       '"name" : "' + RealProjectName + '"', [rfReplaceAll]);
