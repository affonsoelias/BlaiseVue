                    'program ' + CleanName + ';' + #10 +
                    #10 +
                    '{$mode objfpc}{$H+}' + #10 +
                    #10 +
                    'uses' + #10 +
                    '  {$IFDEF UNIX}' + #10 +
                    '  cthreads,' + #10 +
                    '  {$ENDIF}' + #10 +
                    '  Classes, SysUtils;' + #10 +
                    #10 +
