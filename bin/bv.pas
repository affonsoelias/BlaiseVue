// =====================================================================

//  COMANDO: SERVE (antigo run dev)

// =====================================================================

Procedure CmdRunBuild;

Var 
  GenPath, DistPath, PublicPath: string;
  Hash, IndexHTML: string;
  JSFiles, CSSFiles, ConfigThemes: TStringList;
  JSTags, CSSTags, FileName, DefTheme, ThemeId, DelSafeGenPath, DelSafeFuFlag:


                                                                          string
  ;
  i: Integer;
Begin
  WriteLn('=== BlaiseVue Professional Build (ProductionMode) ===');



  // 1. Transpile

  CmdTranspile;
  GenPath := GetCurrentDir + DirectorySeparator + 'generated' +
             DirectorySeparator;
  DistPath := GetCurrentDir + DirectorySeparator + 'dist' + DirectorySeparator;
  PublicPath := GetCurrentDir + DirectorySeparator + 'public' +
                DirectorySeparator;

  // 2. Clean dist/ directory

  If DirectoryExists(DistPath) Then
    DeleteDir(DistPath);

  ForceDir(DistPath + 'js');
  CopyWasmArtifactsToDist(GetCurrentDir, DistPath);

  // 3. Compiles with pas2js (Production mode: -PRODUCTION defines)

  WriteLn('[2/3] Compiling for production (pas2js)...');

  DelSafeGenPath := GetCurrentDir + DirectorySeparator + '.blaisevue' +
                   DirectorySeparator + 'generated';
  If DirectoryExists(DelSafeGenPath) Then
    DelSafeFuFlag := ' -Fu"' + DelSafeGenPath + '"'
  Else
    DelSafeFuFlag := '';

  {$IFDEF WINDOWS}
  i := ExecuteProcess(GetPas2JSPath, '@app.cfg -Fu"' + GetCorePath + '" -Fu"' +
       GetPas2JSLibPath + '"' + DelSafeFuFlag +
       BuildExtraPascalFuFlags(GetCurrentDir, True) +
       ' -dPRODUCTION generated/main.pas -o' + DistPath + 'js/main.js');
  {$ELSE}
  i := ExecuteProcess(GetPas2JSPath, '@app.cfg -Fu' + GetCorePath + ' -Fu' +
       GetPas2JSLibPath + DelSafeFuFlag +
       BuildExtraPascalFuFlags(GetCurrentDir, False) +
       ' -dPRODUCTION generated/main.pas -o' + DistPath + 'js/main.js');
  {$ENDIF}

  If (i <> 0) Or Not FileExists(DistPath + 'js/main.js') Then
    Begin
      WriteLn('');
      WriteLn('ERROR: pas2js returned code ', i,
              '. The production build was not created.');
      Halt(1);
    End;

  // 4. Hashing

  Hash := GetFileHash(DistPath + 'js/main.js');
  RenameFile(DistPath + 'js/main.js', DistPath + 'js/main.' + Hash + '.js');
  CopyFile(DistPath + 'js/main.' + Hash + '.js', DistPath + 'js/main.js');
  FileName := GetRTLPath;
  If FileName <> '' Then
    WriteStringToFile(DistPath + 'js/rtl.js', ReadFileToString(FileName));

  // 5. Index.html com Hash

  If FileExists(PublicPath + 'index.html') Then
    Begin
      IndexHTML := ReadFileToString(PublicPath + 'index.html');
      IndexHTML := StringReplace(IndexHTML, '__CACHE_BUST__', Hash, [
                   rfReplaceAll]);
      IndexHTML := StringReplace(IndexHTML, 'src="js/main.js', 'src="js/main.' +
                   Hash + '.js', [rfReplaceAll]);
      IndexHTML := StringReplace(IndexHTML, 'src="main.js', 'src="js/main.' +
                   Hash + '.js', [rfReplaceAll]);
      IndexHTML := StringReplace(IndexHTML, 'js/rtl.js', 'js/rtl.js', [
                   rfReplaceAll]);

      // Inject package CSS stylesheets (Production mode)

      CSSFiles := TStringList.Create;
      ScanDirForCSS(GetCurrentDir + DirectorySeparator + 'lib', CSSFiles);
      ConfigThemes := TStringList.Create;
      Try
        GetProjectThemesConfig(DefTheme, ConfigThemes);
        If CSSFiles.Count > 0 Then
          Begin
            CSSTags := '';
            ForceDir(DistPath + 'css' + DirectorySeparator + 'lib');
            For i := 0 To CSSFiles.Count - 1 Do
              Begin
                FileName := ExtractFileName(CSSFiles[i]);
                If IsThemeCSSFile(CSSFiles[i], ThemeId) Then
                  Begin
                    If (ConfigThemes.Count > 0) And (ConfigThemes.IndexOf(
                       ThemeId) < 0) Then
                      Continue;
                  End;
                WriteStringToFile(DistPath + 'css' + DirectorySeparator + 'lib'
                                  + DirectorySeparator + FileName,
                                  ReadFileToString(CSSFiles[i]));
                If Not IsThemeCSSFile(CSSFiles[i], ThemeId) Then
                  CSSTags := CSSTags + '  <link rel="stylesheet" href="css/lib/'
                             + FileName + '">' + #10;
              End;

            CSSFiles.Free;
            If CSSTags <> '' Then
              IndexHTML := StringReplace(IndexHTML, '</head>', CSSTags +
                           '</head>', [rfIgnoreCase]);
          End;
      Finally
        ConfigThemes.Free;
    End;

  // Inject package JS scripts (Production mode)

  JSFiles := TStringList.Create;
  ScanDirForJS(GetCurrentDir + DirectorySeparator + 'lib', JSFiles);
  If JSFiles.Count > 0 Then
    Begin
      JSTags := '';
      ForceDir(DistPath + 'js/lib');
      For i := 0 To JSFiles.Count - 1 Do
        Begin
          FileName := ExtractFileName(JSFiles[i]);
          WriteStringToFile(DistPath + 'js/lib/' + FileName, ReadFileToString(
                            JSFiles[i]));
          JSTags := JSTags + '  <script src="js/lib/' + FileName + '"></script>'
                    + #10;
        End;

      IndexHTML := StringReplace(IndexHTML, '</head>', JSTags + '</head>', [
                   rfIgnoreCase]);
    End;

  IndexHTML := InjectFrameworkVersionTag(IndexHTML);
  WriteStringToFile(DistPath + 'index.html', IndexHTML);
End;

// Copy static assets to production dist/

If DirectoryExists(PublicPath) Then
  Begin
    WriteLn('[3/3] Copying production assets (public/assets/)...');
    CopyDir(PublicPath, DistPath, ['index.html']);
  End;

If DirectoryExists(GetCurrentDir + DirectorySeparator + 'lib') Then
  Begin
    WriteLn('  Copying installed libraries (/lib) to /dist/lib...');
    CopyDir(GetCurrentDir + DirectorySeparator + 'lib', DistPath + 'lib', []);
  End;

// Generates component documentation automatically into dist/docs/

CmdDoc(False);
WriteLn('');
WriteLn('Production build generated in /dist');
WriteLn('Main file: main.' + Hash + '.js');
WriteLn('DevTools disabled via -dPRODUCTION');
End;

{ Runs the local development HTTP server with WebSocket HMR bridge (bv serve). }
Procedure CmdServe;
Begin
  If Not FileExists('dist' + DirectorySeparator + 'index.html') Or
     Not FileExists('dist' + DirectorySeparator + 'js' + DirectorySeparator +
     'main.js') Then
    Begin
      WriteLn(


         '  [INFO] dist/ bundle not found. Running initial development build...'
      );
      CmdBuild;
    End;

  WriteLn('=== BlaiseVue v' + GetCliVersion + ' Dev Server (HMR Enabled) ===')
  ;
  If Not HasCommand('node') Then
    Begin
      PrintNodeRequiredError('run the development server with HMR');
      Exit;
    End;

  If FileExists(GetSDKPath + 'bin' + DirectorySeparator + 'dev-server.js') Then
    Begin
      WriteLn('  HMR WebSocket: ws://localhost:8081');
      WriteLn('  Local HTTP:    http://localhost:8080');
      WriteLn('');

    {$IFDEF WINDOWS}
      ExecuteProcess('cmd', '/c node "' + GetSDKPath + 'bin' +
                     DirectorySeparator + 'dev-server.js"');
    {$ELSE}
      ExecuteProcess('/bin/sh', ['-c', 'exec node "' + GetSDKPath + 'bin' +
                     DirectorySeparator + 'dev-server.js"']);
    {$ENDIF}
    End
  Else
    Begin
      WriteLn('  Local: http://localhost:8080');
      WriteLn('');
    {$IFDEF WINDOWS}
      ExecuteProcess('cmd', '/c npx http-server dist -p 8080 -c-1');
    {$ELSE}
      ExecuteProcess('/bin/sh', ['-c', 'npx http-server dist -p 8080 -c-1']);
    {$ENDIF}
    End;
End;

Procedure CmdStudio;

Var 
  PortArg: string;
  StudioScript: string;
  NoOpen: Boolean;
  i: Integer;
Begin
  WriteLn('=== BlaiseVue Studio v' + GetCliVersion + ' Developer Cockpit ===');
  If Not HasCommand('node') Then
    Begin
      PrintNodeRequiredError('launch BlaiseVue Studio');
      Exit;
    End;

  PortArg := '9000';
  NoOpen := False;
  For i := 2 To ParamCount Do
    Begin
      If (LowerCase(ParamStr(i)) = '--port') And (i < ParamCount) Then
        PortArg := ParamStr(i + 1)

      Else If LowerCase(ParamStr(i)) = '--no-open' Then
             NoOpen := True;
    End;

  StudioScript := GetSDKPath + 'bin' + DirectorySeparator + 'studio-server.js';
  If Not FileExists(StudioScript) Then
    Begin
      WriteLn('Error: studio-server.js not found at: ' + StudioScript);
      Exit;
    End;

  WriteLn('  Dashboard: http://localhost:' + PortArg);
  WriteLn('  WebSocket: ws://localhost:' + PortArg + '/ws');
  WriteLn('');

  {$IFDEF WINDOWS}
  If Not NoOpen Then
    ExecuteProcess('cmd', '/c start http://localhost:' + PortArg);
  ExecuteProcess('cmd', '/c node "' + StudioScript + '" --port ' + PortArg);
  {$ELSE}
  If Not NoOpen Then
    ExecuteProcess('/bin/sh', '-c "xdg-open http://localhost:' + PortArg +
                   ' >/dev/null 2>&1 &"');
  ExecuteProcess('/bin/sh', '-c "node ''' + StudioScript + ''' --port ' +
                 PortArg + '"');
  {$ENDIF}
End;

