Procedure CmdList(Const Kind: String);

Var 
  SR: TSearchRec;
  Path, SearchKind, LKind: string;
  Count: Integer;
  TestList: TStringList;
  i: Integer;
Begin
  Count := 0;
  LKind := LowerCase(Kind);
  If (LKind = 'c') Or (LKind = 'comp') Or (LKind = 'component') Then
    Begin
      Path := GetCurrentDir + DirectorySeparator + 'src' + DirectorySeparator +
              'components' + DirectorySeparator;
      SearchKind := 'Components';
    End

  Else If (LKind = 'v') Or (LKind = 'view') Then
         Begin
           Path := GetCurrentDir + DirectorySeparator + 'src' +
                   DirectorySeparator + 'views' + DirectorySeparator;
           SearchKind := 'Views';
         End
  Else If (LKind = 's') Or (LKind = 'service') Or (LKind = 'services') Then
         Begin
           Path := GetCurrentDir + DirectorySeparator + 'src' +
                   DirectorySeparator + 'services' + DirectorySeparator;
           SearchKind := 'Services';
         End
  Else If (LKind = 'store') Or (LKind = 'stores') Then
         Begin
           Path := GetCurrentDir + DirectorySeparator + 'src' +
                   DirectorySeparator + 'stores' + DirectorySeparator;
           SearchKind := 'Store Slices';
         End
  Else If (LKind = 'fsm') Or (LKind = 'fsms') Or (LKind = 'machine') Or (LKind =
          'machines') Then
         Begin
           Path := GetCurrentDir + DirectorySeparator + 'src' +
                   DirectorySeparator + 'machines' + DirectorySeparator;
           SearchKind := 'Finite State Machines';
         End

  Else If (LKind = 't') Or (LKind = 'test') Then
         Begin
           Path := GetCurrentDir + DirectorySeparator + 'tests' +
                   DirectorySeparator;
           SearchKind := 'Tests';
         End

  Else
    Begin
      WriteLn('Usage: bv list <c|v|s|store|fsm|t|lib>');
      Halt(1);
    End;

  WriteLn('');
  WriteLn('Listing ', SearchKind, ' in: ', Path);
  WriteLn(StringOfChar('-', 40));
  If (LKind = 't') Or (LKind = 'test') Then
    Begin
      TestList := TStringList.Create;
      Try

        ScanDirForTests(Path, TestList);
        For i := 0 To TestList.Count - 1 Do
          Begin
            Inc(Count);
            WriteLn('  [', Count, '] ', ExtractRelativePath(Path, TestList[i]));
          End;

      Finally

        TestList.Free;
    End;
End

Else
  Begin
    If FindFirst(Path + '*', faAnyFile, SR) = 0 Then
      Begin
        Repeat

          If (((LKind = 's') Or (LKind = 'service') Or (LKind = 'services') Or (
             LKind = 'store') Or (LKind = 'stores') Or (LKind = 'fsm') Or (LKind
             = 'fsms') Or (LKind = 'machine') Or (LKind = 'machines')) And (
             ExtractFileExt(SR.Name) = '.pas')) Or (ExtractFileExt(SR.Name) =
             '.bv') Then
            Begin
              Inc(Count);
              WriteLn('  [', Count, '] ', SR.Name);
            End;

        Until FindNext(SR) <> 0;
        FindClose(SR);
      End;
  End;

If Count = 0 Then
  WriteLn('  (No matches found)')

Else
  Begin
    WriteLn(StringOfChar('-', 40));
    WriteLn('Total: ', Count, ' ', SearchKind);
  End;

WriteLn('');
End;

