Procedure ScanDirForBV(Const Path: String; List: TStringList);

Var 
  SR: TSearchRec;
  D: string;
Begin
  If Not DirectoryExists(Path) Then Exit;
  D := IncludeTrailingPathDelimiter(Path);
  If FindFirst(D + '*', faAnyFile, SR) = 0 Then
    Begin
      Repeat

        If (SR.Name <> '.') And (SR.Name <> '..') Then
          Begin
            If (SR.Attr And faDirectory) <> 0 Then
              ScanDirForBV(D + SR.Name, List)

            Else If LowerCase(ExtractFileExt(SR.Name)) = '.bv' Then
                   List.Add(D + SR.Name);
          End;

      Until FindNext(SR) <> 0;
      FindClose(SR);
    End;
End;




{ Executes package post-install and setup lifecycle scripts (install.py, setup.py). }
Function RunSetupScript(Const LibName, Action: String): Boolean;

Var 
  LibPath, ScriptPath, ExecPath: string;
  ExitCode: Integer;
Begin
  Result := False;
  LibPath := GetCurrentDir + DirectorySeparator + 'lib' + DirectorySeparator +
             LibName + DirectorySeparator;
  ScriptPath := LibPath + 'setup.pas';
  If Not FileExists(ScriptPath) Then Exit(True);
  // No script = success (nothing to do)

  WriteLn('Preparing setup script for "' + LibName + '"...');



  {$IFDEF WINDOWS}

  ExecPath := LibPath + 'setup.exe';
  ExitCode := ExecuteProcess('cmd', '/c fpc "' + ScriptPath + '" -o"' + ExecPath
              + '" > nul');

  {$ELSE}

  ExecPath := LibPath + 'setup';
  ExitCode := ExecuteProcess('/bin/sh', '-c "fpc -o''' + ExecPath + ''' ''' +
              ScriptPath + '''"');

  {$ENDIF}

  If (ExitCode <> 0) Or Not FileExists(ExecPath) Then
    Begin
      WriteLn('ERROR: Failed to compile setup script for ' + LibName);
      Exit(False);
    End;

  WriteLn('Executing action: ' + Action);
  ExitCode := ExecuteProcess(ExecPath, Action);



  // Cleanup

  DeleteFile(ExecPath);
  If FileExists(ChangeFileExt(ExecPath, '.o')) Then DeleteFile(ChangeFileExt(
                                                               ExecPath, '.o'));
  If FileExists(ChangeFileExt(ExecPath, '.ppu')) Then DeleteFile(ChangeFileExt(
                                                                 ExecPath,
                                                                 '.ppu'));
  Result := (ExitCode = 0);
End;

{ Launches the interactive package and framework setup wizard (bv setup). }
Procedure CmdSetup(Const LibName: String);

Var 
  Path, Choice: string;
Begin
  Path := GetCurrentDir + DirectorySeparator + 'lib' + DirectorySeparator +
          LibName + DirectorySeparator;
  If Not DirectoryExists(Path) Then
    Begin
      WriteLn('Error: Library "' + LibName + '" not found in /lib.');
      Exit;
    End;

  If Not FileExists(Path + 'setup.pas') Then
    Begin
      WriteLn('The library "' + LibName +
              '" does not have a setup script (setup.pas).');
      Exit;
    End;

  WriteLn('');
  WriteLn('--- Component Setup: ' + LibName + ' ---');
  WriteLn('1. Install (Create folders and configurations)');
  WriteLn('2. Reinstall (Perform updates)');
  WriteLn('3. Delete (Cleanup actions)');
  WriteLn('0. Cancel');
  WriteLn('');
  Write('Select an option: ');
  ReadLn(Choice);
  If Choice = '1' Then RunSetupScript(LibName, 'install')

  Else If Choice = '2' Then RunSetupScript(LibName, 'reinstall')

  Else If Choice = '3' Then
         Begin
           If RunSetupScript(LibName, 'remove') Then
             WriteLn('Cleanup completed.')

           Else
             WriteLn('Cleanup finished with issues.');
         End

  Else WriteLn('Action cancelled.');
End;




{ Resolves the installation folder of an official core package in packages/core/. }
Function GetCorePackageFolder(Const Name: String): string;

Var 
  L: string;
Begin
  L := LowerCase(Trim(Name));
  If StartsText('@', L) Then L := Copy(L, 2, Length(L) - 1);
  If (L = 'themes') Or (L = 'blaise-themes') Then Result := GetPackagesPath +
                                                            'blaise-themes'
  Else If (L = 'icons') Or (L = 'blaise-icons') Then Result := GetPackagesPath +
                                                               'blaise-icons'
  Else If (L = 'ui') Or (L = 'blaise-ui') Then Result := GetPackagesPath +
                                                         'blaise-ui'
  Else If (L = 'mobile') Or (L = 'blaise-ui-mobile') Then Result := 


                                                                 GetPackagesPath
                                                                    +


                                                              'blaise-ui-mobile'
  Else If (L = 'charts') Or (L = 'blaise-charts') Then Result := GetPackagesPath
                                                                 +
                                                                 'blaise-charts'
  Else If (L = 'reports') Or (L = 'blaise-reports') Then Result := 


                                                                 GetPackagesPath
                                                                   +


                                                                'blaise-reports'
  Else If (L = 'studio') Or (L = 'blaise-studio') Then Result := GetPackagesPath
                                                                 +
                                                                 'blaise-studio'
  Else If DirectoryExists(GetPackagesPath + L) Then Result := GetPackagesPath +
                                                              L
  Else Result := '';
End;

{ Reads the version string from a package manifest (package.json). }
Function GetPackageVersionFromFolder(Const FolderPath: String): string;

Var 
  JsonFile, Raw, BaseName, CoreDir: string;
  Parser: TJSONParser;
  Data: TJSONData;
Begin
  Result := '';
  JsonFile := IncludeTrailingPathDelimiter(FolderPath) + 'package.json';
  If FileExists(JsonFile) Then
    Begin
      Raw := ReadFileToString(JsonFile);
      If Trim(Raw) <> '' Then
        Begin
          Try
            Parser := TJSONParser.Create(Raw, True);
            Try
              Data := Parser.Parse;
              If Assigned(Data) And (Data.JSONType = jtObject) Then
                Result := TJSONObject(Data).Get('version', '');
              If Assigned(Data) Then Data.Free;
            Finally
              Parser.Free;
        End;
    Except
End;
End;
End;

If Result = '' Then
  Begin
    BaseName := ExtractFileName(ExcludeTrailingPathDelimiter(FolderPath));
    CoreDir := GetCorePackageFolder(BaseName);
    If (CoreDir <> '') And DirectoryExists(CoreDir) Then
      Begin
        JsonFile := IncludeTrailingPathDelimiter(CoreDir) + 'package.json';
        If FileExists(JsonFile) Then
          Begin
            Raw := ReadFileToString(JsonFile);
            If Trim(Raw) <> '' Then
              Begin
                Try
                  Parser := TJSONParser.Create(Raw, True);
                  Try
                    Data := Parser.Parse;
                    If Assigned(Data) And (Data.JSONType = jtObject) Then
                      Result := TJSONObject(Data).Get('version', '');
                    If Assigned(Data) Then Data.Free;
                  Finally
                    Parser.Free;
              End;
          Except
      End;
  End;
End;
If Result = '' Then
  Result := '0.1.0';
End;
End;
End;




{ Extracts a ZIP archive, stripping redundant single-folder wrapper structures. }
Procedure ExtractZipSmart(Const ZipFile, DestBaseDir, PkgName: String);

Var 
  UnZipper: TUnZipper;
  HasTopFolder: Boolean;
  i, SlashPos: Integer;
  EntryName, FinalDest, TopFolder, Candidate, ExtractedTop: string;
Begin
  ForceDir(DestBaseDir);
  UnZipper := TUnZipper.Create;
  Try
    UnZipper.FileName := ZipFile;
    UnZipper.Examine;
    HasTopFolder := (UnZipper.Entries.Count > 0);
    TopFolder := '';
    For i := 0 To UnZipper.Entries.Count - 1 Do
      Begin
        EntryName := UnZipper.Entries[i].ArchiveFileName;
        SlashPos := Pos('/', EntryName);
        If SlashPos = 0 Then SlashPos := Pos('\', EntryName);
        If SlashPos <= 0 Then
          Begin
            HasTopFolder := False;
            Break;
          End;
        Candidate := Copy(EntryName, 1, SlashPos - 1);
        If TopFolder = '' Then
          TopFolder := Candidate
        Else If Not SameText(TopFolder, Candidate) Then
               Begin
                 HasTopFolder := False;
                 Break;
               End;
      End;

    If HasTopFolder And (TopFolder <> '') Then
      Begin
        UnZipper.OutputPath := DestBaseDir;
        UnZipper.UnZipAllFiles;
        ExtractedTop := IncludeTrailingPathDelimiter(DestBaseDir) + TopFolder;
        FinalDest := IncludeTrailingPathDelimiter(DestBaseDir) + PkgName;
        If (PkgName <> '') And Not SameText(TopFolder, PkgName) And
           DirectoryExists(ExtractedTop) Then
          Begin
            If DirectoryExists(FinalDest) Then DeleteDir(FinalDest);
            RenameFile(ExtractedTop, FinalDest);
          End;
      End
    Else
      Begin
        FinalDest := IncludeTrailingPathDelimiter(DestBaseDir) + PkgName +
                     DirectorySeparator;
        ForceDir(FinalDest);
        UnZipper.OutputPath := FinalDest;
        UnZipper.UnZipAllFiles;
      End;
  Finally
    UnZipper.Free;
End;
End;




{ Returns True if the package name belongs to the official @blaise-ui / @blaise-* namespace. }
Function IsOfficialCorePackage(Const Name: String): Boolean;

Var 
  L: string;
Begin
  L := LowerCase(Trim(Name));
  If StartsText('@', L) Then L := Copy(L, 2, Length(L) - 1);
  Result := (L = 'themes') Or (L = 'blaise-themes') Or
            (L = 'icons') Or (L = 'blaise-icons') Or
            (L = 'ui') Or (L = 'blaise-ui') Or
            (L = 'mobile') Or (L = 'blaise-ui-mobile') Or
            (L = 'charts') Or (L = 'blaise-charts') Or
            (L = 'reports') Or (L = 'blaise-reports') Or
            (L = 'studio') Or (L = 'blaise-studio') Or
            DirectoryExists(GetPackagesPath + L);
End;

{ Checks if a package name is reserved to prevent namespace collision attacks. }
Function IsReservedCorePackageName(Const Name: String): Boolean;

Var 
  L: string;
Begin
  L := LowerCase(Trim(Name));
  Result := IsOfficialCorePackage(L) Or
            StartsText('blaise-', L) Or
            (L = 'core') Or (L = 'sdk') Or (L = 'tools') Or (L = 'pas2js') Or
            (L = 'framework') Or (L = 'std') Or (L = 'runtime');
End;




