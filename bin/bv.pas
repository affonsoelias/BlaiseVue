{ Generates compile-time validated client/server RPC proxies (bv mormot rpc). }
Procedure CmdMormotRPC(Const ProjectRoot: String);

Var 
  CommonDir, ServerDir, GenDir, ServicesFile, ClientProxiesFile, GenProxiesFile,
  AppCfgFile: string;
  AppCfgContent: string;
Begin
  WriteLn('');
  WriteLn(


        '======================================================================'
  );
  WriteLn('  BlaiseVue 4.3 End-to-End Type-Safe Pascal RPC with mORMot 2');
  WriteLn('  (bv mormot rpc)');
  WriteLn(


        '======================================================================'
  );
  WriteLn('  Specification: Compile-Time Verified mORMot 2 SOA Client Proxies');
  WriteLn(


         '  Protocol:      JSON-RPC 2.0 & mORMot SOA Wire Format over HTTP & WS'
  );
  WriteLn('  Validation:    100% Strict Type Safety (No REST String URLs)');
  WriteLn(


        '----------------------------------------------------------------------'
  );
  CommonDir := ProjectRoot + DirectorySeparator + 'common';
  ServerDir := ResolveMormotServerDir(ProjectRoot, False);
  GenDir := ProjectRoot + DirectorySeparator + 'generated';
  ServicesFile := CommonDir + DirectorySeparator + 'Services.pas';
  ClientProxiesFile := CommonDir + DirectorySeparator + 'ClientProxies.pas';
  GenProxiesFile := GenDir + DirectorySeparator + 'ClientProxies.pas';
  AppCfgFile := ProjectRoot + DirectorySeparator + 'app.cfg';

  // 1. Ensure common/ and Services.pas exist

  WriteLn('[1/3] Checking shared service contracts in common/Services.pas...');
  ForceDir(CommonDir);
  ForceDir(GenDir);
  If Not FileExists(ServicesFile) Then
    Begin
      If FileExists(ServerDir + DirectorySeparator + 'Services.pas') Then
        Begin
          WriteStringToFile(ServicesFile, ReadFileToString(ServerDir +
                            DirectorySeparator + 'Services.pas'));
          WriteLn('  [+] Synced service contracts from ', ExtractFileName(
                  ExcludeTrailingPathDelimiter(ServerDir)),
          '/Services.pas to common/Services.pas');
        End

      Else
        Begin
          WriteStringToFile(ServicesFile, GenerateDefaultServicesUnit);
          WriteLn(


            '  [+] Scaffolded standard service contracts in common/Services.pas'
          );
        End;
    End

  Else
    WriteLn('  [+] Service contracts found: common/Services.pas');

  // 2. Generate ClientProxies.pas

  WriteLn(


        '[2/3] Generating strongly typed client proxies in ClientProxies.pas...'
  );
  WriteStringToFile(ClientProxiesFile, GenerateClientProxiesUnit);
  WriteStringToFile(GenProxiesFile, GenerateClientProxiesUnit);
  WriteLn('  [+] Generated common/ClientProxies.pas');
  WriteLn('  [+] Generated generated/ClientProxies.pas');

  // 3. Ensure app.cfg has -Fucommon

  WriteLn('[3/3] Checking project compiler search paths in app.cfg...');
  If FileExists(AppCfgFile) Then
    Begin
      AppCfgContent := ReadFileToString(AppCfgFile);
      If Pos('-Fucommon', AppCfgContent) = 0 Then
        Begin
          AppCfgContent := AppCfgContent + #10 + '-Fucommon' + #10;
          WriteStringToFile(AppCfgFile, AppCfgContent);
          WriteLn('  [+] Appended -Fucommon to app.cfg');
        End

      Else
        WriteLn('  [+] Search path -Fucommon already active in app.cfg');
    End;

  WriteLn('');
  WriteLn(


        '======================================================================'
  );
  WriteLn('  [SUCCESS] End-to-End Type-Safe RPC proxies generated successfully!'
  );
  WriteLn(


        '======================================================================'
  );
  WriteLn('');
  WriteLn('Available Services:');
  WriteLn(


         '  - CustomerService (ICustomerService): GetAll, GetById, Save, Delete'
  );
  WriteLn(


         '  - ProductService  (IProductService):  GetAll, GetById, Save, Delete'
  );
  WriteLn('  - SystemService   (ISystemService):   GetStatus, Ping, Echo');
  WriteLn('');
  WriteLn('Usage in Views or Object Pascal code:');
  WriteLn('  uses Services, ClientProxies;');
  WriteLn('');
  WriteLn('  CustomerService.GetAll(procedure(Items: TCustomerDynArray)');
  WriteLn('  begin');
  WriteLn('    this.customers := Items;');
  WriteLn('  end);');
  WriteLn('');
  WriteLn('Or with Promises (Async/Await):');
  WriteLn('  CustomerService.GetByIdAsync(42).then(procedure(Item: JSValue)');
  WriteLn('  begin');
  WriteLn('    ShowToast(''Customer loaded'');');
  WriteLn('  end);');
  WriteLn('');
End;

{ Checks if a specific TCP port is unallocated and available on localhost. }
Function IsTcpPortAvailable(APort: Word): Boolean;

Var 
  S: TSocket;
  Addr: TInetSockAddr;
  Res: Integer;
Begin
  Result := False;
  S := fpSocket(AF_INET, SOCK_STREAM, 0);
  If S = -1 Then Exit;
  Try
    FillChar(Addr, SizeOf(Addr), 0);
    Addr.sin_family := AF_INET;
    Addr.sin_port := htons(APort);
    Addr.sin_addr.s_addr := 0;
    // INADDR_ANY
    Res := fpBind(S, @Addr, SizeOf(Addr));
    Result := (Res = 0);
  Finally
    CloseSocket(S);
End;
End;

{ Scans localhost for the next free TCP port starting from a base port. }
Function FindNextAvailableTcpPort(StartPort: Word; MaxAttempts: Word = 50): Word
;

Var 
  Candidate: Word;
Begin
  Candidate := StartPort;
  While Candidate < StartPort + MaxAttempts Do
    Begin
      If IsTcpPortAvailable(Candidate) Then
        Exit(Candidate);
      Inc(Candidate);
    End;
  Result := StartPort;
End;




{ Gracefully terminates mORMot 2 server processes, verifies socket release, and falls back to force kill. }
Function KillMormotServer(CheckPort: Word = 0): Boolean;

Var 
  PortReleased: Boolean;
  Attempts: Integer;
Begin
  WriteLn('  [+] Stopping mORMot 2 native server instances...');

  // Step 1: Graceful termination attempt
  {$IFDEF WINDOWS}
  ExecuteProcess('cmd', '/c taskkill /IM server.exe > nul 2>&1');
  {$ELSE}
  ExecuteProcess('/bin/sh', ['-c', 'killall -15 server > /dev/null 2>&1']);
  {$ENDIF}
  Sleep(300);

  // Step 2: Force termination with entire process tree (/T)
  {$IFDEF WINDOWS}
  ExecuteProcess('cmd', '/c taskkill /F /T /IM server.exe > nul 2>&1');
  {$ELSE}
  ExecuteProcess('/bin/sh', ['-c',
                 'pkill -9 -f "server(\.exe)?" > /dev/null 2>&1']);
  {$ENDIF}

  // Step 3: Verify port release if a port was specified or discovered
  PortReleased := True;
  If CheckPort > 0 Then
    Begin
      Attempts := 0;
      While (Attempts < 15) And Not IsTcpPortAvailable(CheckPort) Do
        Begin
          Sleep(150);
          Inc(Attempts);
        End;
      PortReleased := IsTcpPortAvailable(CheckPort);
      If PortReleased Then
        WriteLn('  [v] Port ' + IntToStr(CheckPort) + ' is free and released.')
      Else
        WriteLn('  [!] Notice: Port ' + IntToStr(CheckPort) +
        ' is still occupied by another active service.');
    End;

  WriteLn('  [v] All server.exe processes terminated.');
  Result := PortReleased;
End;




{ Displays mORMot 2 versions, including active in project, bundled, and user-cached versions. }
Procedure CmdMormotVersions;

Var 
  ActivePath, BundledPath, VersionsDir, ItemPath: string;
  SR: TSearchRec;
  Count: Integer;
  SizeBytes: Int64;
  IsBundledActive: Boolean;
Begin
  WriteLn('================================================================');
  WriteLn('  Synopse mORMot 2 Framework Versions & Status');
  WriteLn('================================================================');

  ActivePath := FindMormot2Path;
  BundledPath := ExcludeTrailingPathDelimiter(GetSDKPath + 'vendor' +
                 DirectorySeparator + 'mormot2');
  IsBundledActive := (ActivePath <> '') And (LowerCase(ActivePath) = LowerCase(
                     BundledPath));

  If ActivePath <> '' Then
    Begin
      If IsBundledActive Then
        WriteLn(


       '  [*] Active in Project:   bundled (vendor/mormot2 - Framework Default)'
        )
      Else
        WriteLn('  [*] Active in Project:   ' + ActivePath);
    End
  Else
    WriteLn(


           '  [-] Active in Project:   (not detected / no valid mORMot 2 found)'
    );

  WriteLn('----------------------------------------------------------------');
  WriteLn('  Available Framework Distributions:');

  // Bundled baseline
  If DirectoryExists(BundledPath) Then
    Begin
      If IsBundledActive Then
        WriteLn('    [*] bundled    ' + BundledPath + ' (ACTIVE, Protected)')
      Else
        WriteLn('    [ ] bundled    ' + BundledPath + ' (Protected Baseline)');
    End
  Else
    WriteLn('    [!] bundled    Not found in vendor/mormot2');

  // User versions in ~/.blaisevue/versions/mormot/
  VersionsDir := GetGlobalVersionsPath('mormot');
  Count := 0;
  If FindFirst(VersionsDir + '*', faDirectory, SR) = 0 Then
    Begin
      Try
        Repeat
          If (SR.Name <> '.') And (SR.Name <> '..') And ((SR.Attr And
             faDirectory) <> 0) Then
            Begin
              Inc(Count);
              ItemPath := ExcludeTrailingPathDelimiter(VersionsDir + SR.Name);
              SizeBytes := GetDirSizeBytes(ItemPath);
              If (ActivePath <> '') And (LowerCase(ActivePath) = LowerCase(
                 ItemPath)) Then
                WriteLn('    [*] ' + PadRight(SR.Name, 10) + ' ' + ItemPath +
                ' (ACTIVE | ' + FormatFileSizeMB(SizeBytes) + ')')
              Else
                WriteLn('    [ ] ' + PadRight(SR.Name, 10) + ' ' + ItemPath +
                ' (' + FormatFileSizeMB(SizeBytes) + ')');
            End;
        Until FindNext(SR) <> 0;
      Finally
        FindClose(SR);
    End;
End;

If Count = 0 Then
  WriteLn(


         '    (no user versions installed - run "bv mormot upgrade" to install)'
  );

WriteLn('================================================================');
WriteLn('To switch version in project: bv mormot use <bundled | latest | tag>');
WriteLn('To install/upgrade version:   bv mormot upgrade [tag]');
WriteLn('To remove user version:       bv mormot remove-version [tag]');
WriteLn('================================================================');
End;




{ Sets the active mORMot 2 version for the current project by updating server/mormot.path. }
Procedure CmdMormotUse(TargetVer: String);

Var 
  ProjectRoot, ServerDir, MPathFile, ResolvedPath: string;
Begin
  TargetVer := Trim(TargetVer);
  If TargetVer = '' Then
    Begin
      WriteLn('Usage: bv mormot use <bundled | latest | <tag> | <custom_path>>')
      ;
      Exit;
    End;

  ProjectRoot := RequireBlaiseVueProject('bv mormot use');
  ServerDir := ResolveMormotServerDir(ProjectRoot, False);
  ForceDir(ServerDir);
  MPathFile := ServerDir + DirectorySeparator + 'mormot.path';

  If (LowerCase(TargetVer) = 'bundled') Or (LowerCase(TargetVer) = 'default') Or
     (LowerCase(TargetVer) = 'reset') Then
    Begin
      If FileExists(MPathFile) Then
        DeleteFile(MPathFile);
      WriteLn(


      '  [SUCCESS] Project configured to use bundled mORMot 2 (vendor/mormot2).'
      );
      Exit;
    End;




// Check if target is an installed user version in ~/.blaisevue/versions/mormot/<tag>
  ResolvedPath := GetGlobalVersionsPath('mormot') + TargetVer;
  If DirectoryExists(ResolvedPath) And
     FileExists(ResolvedPath + DirectorySeparator + 'src' + DirectorySeparator +
     'core' + DirectorySeparator + 'mormot.core.base.pas') Then
    Begin
      WriteStringToFile(MPathFile, ResolvedPath);
      WriteLn('  [SUCCESS] Project configured to use mORMot 2 (' + TargetVer +
              '):');
      WriteLn('            ' + ResolvedPath);
      Exit;
    End;

  // Check if target is a valid custom directory path
  If DirectoryExists(TargetVer) And
     FileExists(TargetVer + DirectorySeparator + 'src' + DirectorySeparator +
     'core' + DirectorySeparator + 'mormot.core.base.pas') Then
    Begin
      WriteStringToFile(MPathFile, TargetVer);
      WriteLn('  [SUCCESS] Project configured to use custom mORMot 2:');
      WriteLn('            ' + TargetVer);
      Exit;
    End;

  WriteLn('  [ERROR] Version or path "' + TargetVer +
          '" is not installed or invalid.');
  WriteLn(


'  Run "bv mormot upgrade" to install upstream versions, or check "bv mormot versions".'
  );
End;




{ Upgrades or installs an upstream version of Synopse mORMot 2 into ~/.blaisevue/versions/mormot/<tag>. }
Procedure CmdMormotUpgrade(TargetTag: String);

Var 
  VersionsDir, DestDir, UserChoice, GitCmd, ProjectRoot, DlErr: string;
  GitAvail, HasBasePas: Boolean;
  RemoteOut, Line, TagName: string;
  TagLines, AvailableTags: TStringList;
  i, PosRef, ChoiceIdx, MaxDisp: Integer;
Begin
  VersionsDir := GetGlobalVersionsPath('mormot');
  TargetTag := Trim(TargetTag);
  GitAvail := HasCommand('git');

  If StartsText('--tag=', TargetTag) Then
    TargetTag := Copy(TargetTag, 7, Length(TargetTag))
  Else If StartsText('--version=', TargetTag) Then
         TargetTag := Copy(TargetTag, 11, Length(TargetTag));

  If TargetTag = '' Then
    Begin
      AvailableTags := TStringList.Create;
      Try
        If GitAvail Then
          Begin
            WriteLn('  [*] Querying available releases from Synopse GitHub ...')
            ;
            If ExecCmdCapture(


            'git ls-remote --tags --refs https://github.com/synopse/mORMot2.git'
               , RemoteOut) And (RemoteOut <> '') Then
              Begin
                TagLines := TStringList.Create;
                Try
                  TagLines.Text := RemoteOut;
                  For i := TagLines.Count - 1 Downto 0 Do
                    Begin
                      Line := Trim(TagLines[i]);
                      PosRef := Pos('refs/tags/', Line);
                      If PosRef > 0 Then
                        Begin
                          TagName := Copy(Line, PosRef + 10, Length(Line));
                          If (Pos('stable', LowerCase(TagName)) > 0) Or (Pos(
                             '2.', TagName) = 1) Then
                            Begin
                              If AvailableTags.IndexOf(TagName) < 0 Then
                                AvailableTags.Add(TagName);
                            End;
                        End;
                    End;
                Finally
                  TagLines.Free;
              End;
          End;
    End;

  If AvailableTags.Count = 0 Then
    Begin
      AvailableTags.Add('2.4-stable');
      AvailableTags.Add('2.3.stable');
      AvailableTags.Add('2.2.stable');
      AvailableTags.Add('2.1.stable');
    End;

  MaxDisp := AvailableTags.Count;
  If MaxDisp > 5 Then MaxDisp := 5;

  WriteLn('================================================================');
  WriteLn('  Available Synopse mORMot 2 Upstream Releases');
  WriteLn('================================================================');
  For i := 0 To MaxDisp - 1 Do
    Begin
      If i = 0 Then
        WriteLn('    [' + IntToStr(i + 1) + '] ' + PadRight(AvailableTags[i], 12
        ) + ' (Latest Official Release)')
      Else
        WriteLn('    [' + IntToStr(i + 1) + '] ' + PadRight(AvailableTags[i], 12
        ) + ' (Official Release)');
    End;
  WriteLn('    [L] latest       (Main branch - bleeding edge from GitHub)');
  WriteLn('    [C] Custom       (Specify custom Git tag, branch or commit)');
  WriteLn('================================================================');
  Write('Select version to install/upgrade [1-' + IntToStr(MaxDisp) +
  ', L, C] or [Q]uit: ');
  ReadLn(UserChoice);
  UserChoice := Trim(UserChoice);

  If (UserChoice = '') Or (LowerCase(UserChoice) = 'q') Or (LowerCase(UserChoice
     ) = 'quit') Or (LowerCase(UserChoice) = 'cancel') Then
    Begin
      WriteLn('Operation cancelled.');
      Exit;
    End
  Else If (LowerCase(UserChoice) = 'l') Or (LowerCase(UserChoice) = 'latest') Or
          (LowerCase(UserChoice) = 'main') Then
         Begin
           TargetTag := 'latest';
         End
  Else If (LowerCase(UserChoice) = 'c') Or (LowerCase(UserChoice) = 'custom')
         Then
         Begin
           Write('Enter custom tag or branch: ');
           ReadLn(TargetTag);
           TargetTag := Trim(TargetTag);
           If TargetTag = '' Then Exit;
         End
  Else
    Begin
      ChoiceIdx := StrToIntDef(UserChoice, -1);
      If (ChoiceIdx >= 1) And (ChoiceIdx <= MaxDisp) Then
        TargetTag := AvailableTags[ChoiceIdx - 1]
      Else
        Begin
          WriteLn('Invalid selection.');
          Exit;
        End;
    End;
Finally
  AvailableTags.Free;
End;
End;

DestDir := ExcludeTrailingPathDelimiter(VersionsDir + TargetTag);
GitAvail := HasCommand('git');

WriteLn('  [*] Installing/Updating mORMot 2 (' + TargetTag + ') in:');
WriteLn('      ' + DestDir);

If DirectoryExists(DestDir + DirectorySeparator + '.git') And GitAvail Then
  Begin
    WriteLn('  [*] Updating existing repository via "git pull" ...');
    {$IFDEF WINDOWS}
    ExecuteProcess('cmd', '/c git -C "' + DestDir + '" pull --ff-only');
    {$ELSE}
    ExecuteProcess('/bin/sh', '-c "git -C \"' + DestDir + '\" pull --ff-only"');
    {$ENDIF}
  End
Else
  Begin
    If DirectoryExists(DestDir) Then
      DeleteDir(DestDir);
    ForceDirectories(DestDir);

    If GitAvail Then
      Begin
        If (TargetTag = 'latest') Or (TargetTag = 'main') Or (TargetTag =
           'master') Then
          GitCmd := 


                  'git clone --depth 1 https://github.com/synopse/mORMot2.git "'
                    + DestDir + '"'
        Else
          GitCmd := 'git clone --depth 1 --branch ' + TargetTag +
                    ' https://github.com/synopse/mORMot2.git "' + DestDir + '"';

        WriteLn('  [*] Cloning from https://github.com/synopse/mORMot2.git ...')
        ;
      {$IFDEF WINDOWS}
        ExecuteProcess('cmd', '/c ' + GitCmd);
      {$ELSE}
        ExecuteProcess('/bin/sh', '-c "' + GitCmd + '"');
      {$ENDIF}
      End
    Else
      Begin
        WriteLn('  [*] Git not detected; fetching mORMot 2 archive directly from GitHub...');
        If Not TBVUpgrade.DownloadMormot2Archive(TargetTag, DestDir, DlErr) Then
          Begin
            WriteLn('  [ERROR] Failed to download mORMot 2: ', DlErr);
            WriteLn('          You can clone manually into: ', DestDir);
            Exit;
          End;
      End;
  End;

HasBasePas := FileExists(DestDir + DirectorySeparator + 'src' +
              DirectorySeparator + 'core' + DirectorySeparator +
              'mormot.core.base.pas');
If HasBasePas Then
  Begin
    WriteLn('');
    WriteLn(


        '======================================================================'
    );
    WriteLn('  [SUCCESS] mORMot 2 (' + TargetTag + ') installed successfully!');
    WriteLn('  Location: ' + DestDir);
    WriteLn(


        '======================================================================'
    );

    // If inside a project, offer to activate immediately
    Try
      ProjectRoot := GetCurrentDir;
      If FileExists(ProjectRoot + DirectorySeparator + 'app.cfg') Or
         DirectoryExists(ProjectRoot + DirectorySeparator + 'server-mormot') Or
         DirectoryExists(ProjectRoot + DirectorySeparator + 'server') Then
        Begin
          Write('Do you want to activate version "' + TargetTag +
                '" in the current project now? [y/N]: ');
          ReadLn(UserChoice);
          UserChoice := LowerCase(Trim(UserChoice));
          If (UserChoice = 'y') Or (UserChoice = 'yes') Or (UserChoice = 's') Or
             (UserChoice = 'sim') Then
            CmdMormotUse(TargetTag);
        End;
    Except
      // Ignore
  End;
End
Else
  Begin
    WriteLn('  [ERROR] Could not verify mORMot 2 installation in ' + DestDir);
  End;
End;

{ Removes an installed user version from ~/.blaisevue/versions/mormot/<tag>. }
Procedure CmdMormotRemoveVersion(TargetVer: String; Force: Boolean);

Var 
  VersionsDir, ItemPath, UserChoice, ActivePath: string;
  SR: TSearchRec;
  Names: TStringList;
  i, ChoiceIdx: Integer;
  SizeBytes: Int64;
  IsActiveInProject: Boolean;
Begin
  VersionsDir := GetGlobalVersionsPath('mormot');
  TargetVer := Trim(TargetVer);

  If (LowerCase(TargetVer) = 'bundled') Or (LowerCase(TargetVer) = 'vendor')
    Then
    Begin
      WriteLn(


'  [ERROR] The "bundled" version (vendor/mormot2) is protected and cannot be deleted.'
      );
      Exit;
    End;

  // Interactive selection if empty
  If TargetVer = '' Then
    Begin
      Names := TStringList.Create;
      Try
        If FindFirst(VersionsDir + '*', faDirectory, SR) = 0 Then
          Begin
            Try
              Repeat
                If (SR.Name <> '.') And (SR.Name <> '..') And ((SR.Attr And
                   faDirectory) <> 0) Then
                  Names.Add(SR.Name);
              Until FindNext(SR) <> 0;
            Finally
              FindClose(SR);
          End;
    End;

  If Names.Count = 0 Then
    Begin
      WriteLn('No user versions found in ' + VersionsDir);
      Exit;
    End;

  WriteLn('================================================================');
  WriteLn('  Installed mORMot 2 Versions (' + VersionsDir + ')');
  WriteLn('================================================================');
  For i := 0 To Names.Count - 1 Do
    Begin
      ItemPath := VersionsDir + Names[i];
      SizeBytes := GetDirSizeBytes(ItemPath);
      WriteLn('  [' + IntToStr(i + 1) + '] ' + PadRight(Names[i], 12) + ' (' +
      FormatFileSizeMB(SizeBytes) + ')');
    End;
  WriteLn('================================================================');
  Write('Select a version to remove [1-' + IntToStr(Names.Count) +
  '] or [C]ancel: ');
  ReadLn(UserChoice);
  UserChoice := Trim(UserChoice);
  If (UserChoice = '') Or (LowerCase(UserChoice) = 'c') Or (LowerCase(UserChoice
     ) = 'cancel') Then
    Begin
      WriteLn('Operation cancelled.');
      Exit;
    End;

  ChoiceIdx := StrToIntDef(UserChoice, -1);
  If (ChoiceIdx < 1) Or (ChoiceIdx > Names.Count) Then
    Begin
      WriteLn('Invalid selection.');
      Exit;
    End;

  TargetVer := Names[ChoiceIdx - 1];
Finally
  Names.Free;
End;
End;

ItemPath := ExcludeTrailingPathDelimiter(VersionsDir + TargetVer);
If Not DirectoryExists(ItemPath) Then
  Begin
    WriteLn('[!] mORMot version "' + TargetVer + '" not found in ' + VersionsDir
    );
    Exit;
  End;

// Check if active in current project
ActivePath := FindMormot2Path;
IsActiveInProject := (ActivePath <> '') And (LowerCase(ActivePath) = LowerCase(
                     ItemPath));
If IsActiveInProject Then
  Begin
    WriteLn('  [WARNING] Version "' + TargetVer +
            '" is currently active in this project!');
    WriteLn(


'            If deleted, the project will automatically fall back to "bundled".'
    );
  End;

If Not Force Then
  Begin
    Write('Are you sure you want to permanently delete mORMot version "' +
          TargetVer + '"? [y/N]: ');
    ReadLn(UserChoice);
    UserChoice := LowerCase(Trim(UserChoice));
    If (UserChoice <> 'y') And (UserChoice <> 'yes') And (UserChoice <> 's') And
       (UserChoice <> 'sim') Then
      Begin
        WriteLn('Operation cancelled.');
        Exit;
      End;
  End;

// If was active, reset project config
If IsActiveInProject Then
  Begin
    If FileExists(ResolveMormotServerDir(GetCurrentDir, False) +
       DirectorySeparator + 'mormot.path') Then
      DeleteFile(ResolveMormotServerDir(GetCurrentDir, False) +
      DirectorySeparator + 'mormot.path');
    If FileExists(GetCurrentDir + DirectorySeparator + 'server' +
       DirectorySeparator + 'mormot.path') Then
      DeleteFile(GetCurrentDir + DirectorySeparator + 'server' +
                 DirectorySeparator + 'mormot.path');
  End;

SizeBytes := GetDirSizeBytes(ItemPath);
WriteLn('  [-] Removing ' + ItemPath + ' ...');
DeleteDir(ItemPath);
WriteLn('  [SUCCESS] mORMot 2 version "' + TargetVer +
        '" removed successfully! (' + FormatFileSizeMB(SizeBytes) + ' freed)');
End;

{ Lists active, bundled and cached Pas2JS compiler versions. }
Procedure CmdPas2jsVersions;

Var 
  VersionsDir, ActiveVer, CompilerPath, ItemPath: string;
  SR: TSearchRec;
  SizeBytes: Int64;
  HasUserVersions, IsActive: Boolean;
Begin
  VersionsDir := GetGlobalVersionsPath('pas2js');
  ActiveVer := GetActivePas2JSVersion;
  CompilerPath := GetPas2JSPath;

  WriteLn('================================================================');
  WriteLn('  Pas2JS Compiler Distributions & Status');
  WriteLn('================================================================');
  If ActiveVer = 'bundled' Then
    WriteLn(


        '  [*] Active in Project:   bundled (vendor/pas2js - Framework Default)'
    )
  Else
    WriteLn('  [*] Active in Project:   ' + ActiveVer + ' (.pas2js-version)');

  WriteLn('  [*] Active Executable:   ' + CompilerPath);
  WriteLn('  [*] Active System Units: ' + GetPas2JSLibPath);
  WriteLn('----------------------------------------------------------------');
  WriteLn('  Available Compiler Distributions:');

  // Bundled baseline
  IsActive := (ActiveVer = 'bundled');
  If IsActive Then
    WriteLn('    [*] bundled    ' + GetSDKPath + 'vendor' + DirectorySeparator +
            'pas2js (ACTIVE, Protected)')
  Else
    WriteLn('    [ ] bundled    ' + GetSDKPath + 'vendor' + DirectorySeparator +
            'pas2js (Protected Baseline)');

  // User versions in ~/.blaisevue/versions/pas2js/
  HasUserVersions := False;
  If FindFirst(VersionsDir + '*', faDirectory, SR) = 0 Then
    Begin
      Try
        Repeat
          If (SR.Name <> '.') And (SR.Name <> '..') And ((SR.Attr And
             faDirectory) <> 0) Then
            Begin
              HasUserVersions := True;
              ItemPath := VersionsDir + SR.Name;
              SizeBytes := GetDirSizeBytes(ItemPath);
              IsActive := (LowerCase(ActiveVer) = LowerCase(SR.Name));
              If IsActive Then
                WriteLn('    [*] ' + PadRight(SR.Name, 10) + ' ' + ItemPath +
                ' (ACTIVE | ' + FormatFileSizeMB(SizeBytes) + ')')
              Else
                WriteLn('    [ ] ' + PadRight(SR.Name, 10) + ' ' + ItemPath +
                ' (' + FormatFileSizeMB(SizeBytes) + ')');
            End;
        Until FindNext(SR) <> 0;
      Finally
        FindClose(SR);
    End;
End;

If Not HasUserVersions Then
  WriteLn(


         '    (no user versions installed - run "bv pas2js upgrade" to install)'
  );

WriteLn('================================================================');
WriteLn('To switch version in project: bv pas2js use <bundled | version>');
WriteLn('To install/upgrade version:   bv pas2js upgrade [--version=<ver>]');
WriteLn('To remove user version:       bv pas2js remove-version [version]');
WriteLn('================================================================');
End;

{ Configures the active Pas2JS compiler for the current project. }
Procedure CmdPas2jsUse(TargetVer: String);

Var 
  ProjectRoot, VerFile, UserPath: string;
Begin
  TargetVer := Trim(TargetVer);
  ProjectRoot := RequireBlaiseVueProject('bv pas2js use');
  VerFile := IncludeTrailingPathDelimiter(ProjectRoot) + '.pas2js-version';

  If TargetVer = '' Then
    Begin
      WriteLn('Usage: bv pas2js use <bundled | version>');
      WriteLn('Run "bv pas2js versions" to view available distributions.');
      Exit;
    End;

  If (LowerCase(TargetVer) = 'bundled') Or (LowerCase(TargetVer) = 'vendor') Or
     (LowerCase(TargetVer) = 'default') Then
    Begin
      If FileExists(VerFile) Then
        DeleteFile(VerFile);
      WriteLn(


'  [SUCCESS] Project configured to use bundled Pas2JS compiler (vendor/pas2js).'
      );
      Exit;
    End;

  UserPath := IncludeTrailingPathDelimiter(GetGlobalVersionsPath('pas2js')) +
              TargetVer;
  If Not DirectoryExists(UserPath) And Not DirectoryExists(TargetVer) Then
    Begin
      WriteLn('  [ERROR] Pas2JS version "' + TargetVer + '" is not installed.');
      WriteLn(


 '  Run "bv pas2js upgrade" to install versions, or check "bv pas2js versions".'
      );
      Exit;
    End;

  WriteStringToFile(VerFile, TargetVer);
  WriteLn('  [SUCCESS] Project configured to use Pas2JS compiler (' + TargetVer
          + ').');
  WriteLn('            Active compiler: ' + GetPas2JSPath);
End;




{ Downloads or clones a Pas2JS release into ~/.blaisevue/versions/pas2js/<ver>. }
Procedure CmdPas2jsUpgrade(TargetVer: String);

Var 
  VersionsDir, DestDir, UserChoice, GitCmd, ProjectRoot, DlErr: string;
  GitAvail: Boolean;
  RemoteOut, Line, TagName, DisplayVer: string;
  TagLines, AvailableVersions: TStringList;
  i, PosRef, ChoiceIdx, MaxDisp: Integer;
Begin
  VersionsDir := GetGlobalVersionsPath('pas2js');
  TargetVer := Trim(TargetVer);
  GitAvail := HasCommand('git');

  If StartsText('--version=', TargetVer) Then
    TargetVer := Copy(TargetVer, 11, Length(TargetVer))
  Else If StartsText('--tag=', TargetVer) Then
         TargetVer := Copy(TargetVer, 7, Length(TargetVer));

  // Interactive menu if empty
  If TargetVer = '' Then
    Begin
      AvailableVersions := TStringList.Create;
      Try
        // Attempt dynamic discovery of releases from GitLab
        If GitAvail Then
          Begin
            WriteLn('  [*] Querying available releases from GitLab ...');
            If ExecCmdCapture(


  'git ls-remote --tags --refs https://gitlab.com/freepascal.org/fpc/pas2js.git'
               , RemoteOut) And (RemoteOut <> '') Then
              Begin
                TagLines := TStringList.Create;
                Try
                  TagLines.Text := RemoteOut;
                  For i := TagLines.Count - 1 Downto 0 Do
                    Begin
                      Line := Trim(TagLines[i]);
                      PosRef := Pos('refs/tags/release_', Line);
                      If PosRef > 0 Then
                        Begin
                          TagName := Copy(Line, PosRef + 18, Length(Line));
                          DisplayVer := StringReplace(TagName, '_', '.', [
                                        rfReplaceAll]);
                          If (AvailableVersions.IndexOf(DisplayVer) < 0) And (
                             Pos('rc', LowerCase(DisplayVer)) = 0) Then
                            AvailableVersions.Add(DisplayVer);
                        End;
                    End;
                Finally
                  TagLines.Free;
              End;
          End;
    End;

  // Fallback baseline versions if offline or discovery failed
  If AvailableVersions.Count = 0 Then
    Begin
      AvailableVersions.Add('3.2.0');
      AvailableVersions.Add('3.0.1');
      AvailableVersions.Add('2.2.0');
    End;

  MaxDisp := AvailableVersions.Count;
  If MaxDisp > 5 Then MaxDisp := 5;

  WriteLn('================================================================');
  WriteLn('  Pas2JS Compiler Upgrade & Version Manager');
  WriteLn('================================================================');
  WriteLn('  Select target Pas2JS compiler distribution to install:');
  For i := 0 To MaxDisp - 1 Do
    Begin
      If i = 0 Then
        WriteLn('    [' + IntToStr(i + 1) + '] ' + PadRight(AvailableVersions[i]
                                                            , 8) +
        ' (Latest Official Release)')
      Else
        WriteLn('    [' + IntToStr(i + 1) + '] ' + PadRight(AvailableVersions[i]
                                                            , 8) +
        ' (Stable Release)');
    End;
  WriteLn('    [D] main     (Active Development / GitLab branch)');
  WriteLn('    [C] Custom   (Specify custom version tag or repository)');
  WriteLn('================================================================');
  Write('Select option [1-' + IntToStr(MaxDisp) + ', D, C] or [Q]uit: ');
  ReadLn(UserChoice);
  UserChoice := Trim(UserChoice);

  If (UserChoice = '') Or (LowerCase(UserChoice) = 'q') Or (LowerCase(UserChoice
     ) = 'quit') Or (LowerCase(UserChoice) = 'cancel') Then
    Begin
      WriteLn('Operation cancelled.');
      Exit;
    End
  Else If (LowerCase(UserChoice) = 'd') Or (LowerCase(UserChoice) = 'dev') Or (
          LowerCase(UserChoice) = 'main') Then
         Begin
           TargetVer := 'main';
         End
  Else If (LowerCase(UserChoice) = 'c') Or (LowerCase(UserChoice) = 'custom')
         Then
         Begin
           Write('Enter version tag (e.g. 3.5.0, release_3_2_0, main): ');
           ReadLn(TargetVer);
           TargetVer := Trim(TargetVer);
           If TargetVer = '' Then
             Begin
               WriteLn('Invalid version.');
               Exit;
             End;
         End
  Else
    Begin
      ChoiceIdx := StrToIntDef(UserChoice, -1);
      If (ChoiceIdx >= 1) And (ChoiceIdx <= MaxDisp) Then
        TargetVer := AvailableVersions[ChoiceIdx - 1]
      Else
        Begin
          WriteLn('Invalid selection.');
          Exit;
        End;
    End;
Finally
  AvailableVersions.Free;
End;
End;

DestDir := ExcludeTrailingPathDelimiter(IncludeTrailingPathDelimiter(VersionsDir
           ) + TargetVer);

WriteLn('================================================================');
WriteLn('  Target Distribution: Pas2JS ' + TargetVer);
WriteLn('  Install Destination: ' + DestDir);
WriteLn('================================================================');

If DirectoryExists(DestDir + DirectorySeparator + '.git') And GitAvail Then
  Begin
    WriteLn('  [*] Updating existing repository via "git pull" ...');
    {$IFDEF WINDOWS}
    ExecuteProcess('cmd', '/c git -C "' + DestDir + '" pull --ff-only');
    {$ELSE}
    ExecuteProcess('/bin/sh', '-c "git -C \"' + DestDir + '\" pull --ff-only"');
    {$ENDIF}
  End
Else
  Begin
    If DirectoryExists(DestDir) Then
      DeleteDir(DestDir);
    ForceDirectories(DestDir);

    If GitAvail Then
      Begin
        If (TargetVer = 'main') Or (TargetVer = 'master') Or (TargetVer =
           'latest') Then
          GitCmd := 


        'git clone --depth 1 https://gitlab.com/freepascal.org/fpc/pas2js.git "'
                    + DestDir + '"'
        Else If StartsText('release_', TargetVer) Or StartsText('fixes_',
                TargetVer) Then
               GitCmd := 'git clone --depth 1 --branch ' + TargetVer +
                         ' https://gitlab.com/freepascal.org/fpc/pas2js.git "' +
                         DestDir + '"'
        Else
          GitCmd := 'git clone --depth 1 --branch release_' + StringReplace(
                    TargetVer, '.', '_', [rfReplaceAll]) +
                    ' https://gitlab.com/freepascal.org/fpc/pas2js.git "' +
                    DestDir + '"';

        WriteLn(


       '  [*] Cloning from https://gitlab.com/freepascal.org/fpc/pas2js.git ...'
        );
      {$IFDEF WINDOWS}
        ExecuteProcess('cmd', '/c ' + GitCmd);
      {$ELSE}
        ExecuteProcess('/bin/sh', '-c "' + GitCmd + '"');
      {$ENDIF}
      End
    Else
      Begin
        WriteLn(


   '  [!] Git not detected on PATH. Please install Git or clone manually into: '
                + DestDir);
        Exit;
      End;
  End;

WriteLn('');
WriteLn('======================================================================'
);
WriteLn('  [SUCCESS] Pas2JS compiler (' + TargetVer +
        ') installed successfully!');
WriteLn('  Location: ' + DestDir);
WriteLn('======================================================================'
);

Try
  ProjectRoot := FindBlaiseVueProjectRoot('');
  If ProjectRoot <> '' Then
    Begin
      Write('Do you want to activate version "' + TargetVer +
            '" in the current project now? [y/N]: ');
      ReadLn(UserChoice);
      UserChoice := LowerCase(Trim(UserChoice));
      If (UserChoice = 'y') Or (UserChoice = 'yes') Or (UserChoice = 's') Or (
         UserChoice = 'sim') Then
        CmdPas2jsUse(TargetVer);
    End;
Except
  // Ignore
End;
End;

{ Removes an installed user version from ~/.blaisevue/versions/pas2js/<ver>. }
Procedure CmdPas2jsRemoveVersion(TargetVer: String; Force: Boolean);

Var 
  VersionsDir, ItemPath, UserChoice, ActiveVer, ProjectRoot, VerFile: string;
  SR: TSearchRec;
  Names: TStringList;
  i, ChoiceIdx: Integer;
  SizeBytes: Int64;
  IsActiveInProject: Boolean;
Begin
  VersionsDir := GetGlobalVersionsPath('pas2js');
  TargetVer := Trim(TargetVer);

  If (LowerCase(TargetVer) = 'bundled') Or (LowerCase(TargetVer) = 'vendor')
    Then
    Begin
      WriteLn(


'  [ERROR] The "bundled" version (vendor/pas2js) is protected and cannot be deleted.'
      );
      Exit;
    End;

  If TargetVer = '' Then
    Begin
      Names := TStringList.Create;
      Try
        If FindFirst(VersionsDir + '*', faDirectory, SR) = 0 Then
          Begin
            Try
              Repeat
                If (SR.Name <> '.') And (SR.Name <> '..') And ((SR.Attr And
                   faDirectory) <> 0) Then
                  Names.Add(SR.Name);
              Until FindNext(SR) <> 0;
            Finally
              FindClose(SR);
          End;
    End;

  If Names.Count = 0 Then
    Begin
      WriteLn('No user versions found in ' + VersionsDir);
      Exit;
    End;

  WriteLn('================================================================');
  WriteLn('  Installed Pas2JS Versions (' + VersionsDir + ')');
  WriteLn('================================================================');
  For i := 0 To Names.Count - 1 Do
    Begin
      ItemPath := VersionsDir + Names[i];
      SizeBytes := GetDirSizeBytes(ItemPath);
      WriteLn('  [' + IntToStr(i + 1) + '] ' + PadRight(Names[i], 12) + ' (' +
      FormatFileSizeMB(SizeBytes) + ')');
    End;
  WriteLn('================================================================');
  Write('Select a version to remove [1-' + IntToStr(Names.Count) +
  '] or [C]ancel: ');
  ReadLn(UserChoice);
  UserChoice := Trim(UserChoice);
  If (UserChoice = '') Or (LowerCase(UserChoice) = 'c') Or (LowerCase(UserChoice
     ) = 'cancel') Then
    Begin
      WriteLn('Operation cancelled.');
      Exit;
    End;

  ChoiceIdx := StrToIntDef(UserChoice, -1);
  If (ChoiceIdx < 1) Or (ChoiceIdx > Names.Count) Then
    Begin
      WriteLn('Invalid selection.');
      Exit;
    End;

  TargetVer := Names[ChoiceIdx - 1];
Finally
  Names.Free;
End;
End;

ItemPath := ExcludeTrailingPathDelimiter(VersionsDir + TargetVer);
If Not DirectoryExists(ItemPath) Then
  Begin
    WriteLn('[!] Pas2JS version "' + TargetVer + '" not found in ' + VersionsDir
    );
    Exit;
  End;

ActiveVer := GetActivePas2JSVersion;
IsActiveInProject := (LowerCase(ActiveVer) = LowerCase(TargetVer));
If IsActiveInProject Then
  Begin
    WriteLn('  [WARNING] Version "' + TargetVer +
            '" is currently active in this project!');
    WriteLn(


'            If deleted, the project will automatically fall back to "bundled".'
    );
  End;

If Not Force Then
  Begin
    Write('Are you sure you want to permanently delete Pas2JS version "' +
          TargetVer + '"? [y/N]: ');
    ReadLn(UserChoice);
    UserChoice := LowerCase(Trim(UserChoice));
    If (UserChoice <> 'y') And (UserChoice <> 'yes') And (UserChoice <> 's') And
       (UserChoice <> 'sim') Then
      Begin
        WriteLn('Operation cancelled.');
        Exit;
      End;
  End;

If IsActiveInProject Then
  Begin
    ProjectRoot := FindBlaiseVueProjectRoot('');
    If ProjectRoot <> '' Then
      Begin
        VerFile := IncludeTrailingPathDelimiter(ProjectRoot) + '.pas2js-version'
        ;
        If FileExists(VerFile) Then
          DeleteFile(VerFile);
      End;
  End;

SizeBytes := GetDirSizeBytes(ItemPath);
WriteLn('  [-] Removing ' + ItemPath + ' ...');
DeleteDir(ItemPath);
WriteLn('  [SUCCESS] Pas2JS version "' + TargetVer + '" removed successfully! ('
        + FormatFileSizeMB(SizeBytes) + ' freed)');
End;




{ Central CLI orchestrator for the Pas2JS compiler multi-version manager (bv pas2js). }
Procedure CmdPas2js(Const SubCmd, Arg1, Arg2: String);

Var 
  SC: string;
Begin
  SC := LowerCase(Trim(SubCmd));
  If (SC = 'versions') Or (SC = 'list') Or (SC = 'ls') Then
    CmdPas2jsVersions
  Else If (SC = 'use') Or (SC = 'switch') Or (SC = 'set') Then
         CmdPas2jsUse(Arg1)
  Else If (SC = 'upgrade') Or (SC = 'install') Or (SC = 'update') Or (SC = 'get'
          ) Then
         CmdPas2jsUpgrade(Arg1)
  Else If (SC = 'remove-version') Or (SC = 'delete-version') Or (SC = 'remove')
          Or (SC = 'rm') Then
         CmdPas2jsRemoveVersion(Arg1, (LowerCase(Arg1) = '-y') or (LowerCase(
                                                                   Arg2) = '-y')
                                                                           )
                                                                           Else



                                                                           Begin



                                                                         WriteLn
                                                                               (


'Usage: bv pas2js <versions|upgrade [--version=<v>]|use <v|bundled>|remove-version [v] [-y]>'
                                                                               )
                                                                               ;



                                                                            Halt
                                                                               (


                                                                               1
                                                                               )
                                                                               ;
                                                                             End
  ;
End;




{ Scans ~/.blaisevue/versions/<module> and returns a list of items and total bytes }
Procedure ScanModuleVersions(Const ModuleName: String; OutList: TStringList; Var
                             TotalBytes: Int64);

Var 
  ModDir, ItemPath: string;
  SR: TSearchRec;
  Sz: Int64;
Begin
  ModDir := GetGlobalVersionsPath(ModuleName);
  If FindFirst(ModDir + '*', faDirectory, SR) = 0 Then
    Begin
      Try
        Repeat
          If (SR.Name <> '.') And (SR.Name <> '..') And ((SR.Attr And
             faDirectory) <> 0) Then
            Begin
              ItemPath := ModDir + SR.Name;
              Sz := GetDirSizeBytes(ItemPath);
              TotalBytes := TotalBytes + Sz;
              OutList.Add(ModuleName + '|' + SR.Name + '|' + ItemPath + '|' +
                          IntToStr(Sz));
            End;
        Until FindNext(SR) <> 0;
      Finally
        FindClose(SR);
    End;
End;
End;




{ Displays centralized dashboard of all SDK dependencies across project and system. }
Procedure CmdGlobalVersions;

Var 
  FwVer, CapVer, MormotVer, Pas2jsVer, HorseVer, SdkDir, BranchName: string;
  Root, PkgFile, CapCfg, PkgContent, HPathFile, MPath: string;
  AllItems: TStringList;
  TotalBytes: Int64;
  i: Integer;
  Line, ModName, VerName, ModPath, SzStr: string;
  Parts: TStringList;
  HasHorseTool, HasHorseServer: Boolean;
Begin
  Root := FindBlaiseVueProjectRoot('');
  If Root = '' Then Root := GetCurrentDir;
  SdkDir := ExcludeTrailingPathDelimiter(GetHostSDKPath);

  // 1. Resolve Active Project Versions
  // BlaiseVue Framework
  FwVer := GetActiveFrameworkVersion;
  BranchName := 'channel';
  If DirectoryExists(SdkDir + DirectorySeparator + '.git') Then
    Begin
      ExecCmdCapture('git -C "' + SdkDir + '" rev-parse --abbrev-ref HEAD',
                     BranchName);
      BranchName := Trim(BranchName);
      If BranchName = '' Then BranchName := 'channel';
    End;
  If (FwVer = '') Or (LowerCase(FwVer) = 'channel') Then
    FwVer := 'channel (' + BranchName + ' - v' + GetCliVersion + ')'
  Else
    FwVer := FwVer + ' (.blaisevue-version)';

  // Capacitor
  CapVer := '(not initialized)';
  PkgFile := IncludeTrailingPathDelimiter(Root) + 'package.json';
  CapCfg := IncludeTrailingPathDelimiter(Root) + 'capacitor.config.json';
  If FileExists(PkgFile) And (FileExists(CapCfg) Or DirectoryExists(
     IncludeTrailingPathDelimiter(Root) + 'mobile')) Then
    Begin
      PkgContent := ReadFileToString(PkgFile);
      If Pos('"@capacitor/core": "', PkgContent) > 0 Then
        Begin
          CapVer := Copy(PkgContent, Pos('"@capacitor/core": "', PkgContent) +
                    20, 20);
          If Pos('"', CapVer) > 0 Then CapVer := Copy(CapVer, 1, Pos('"', CapVer
                                                 ) - 1);
        End;
    End;

  // mORMot 2
  MPath := FindMormot2Path;
  If MPath <> '' Then
    Begin
      If Pos('vendor' + DirectorySeparator + 'mormot2', MPath) > 0 Then
        MormotVer := 'bundled (vendor/mormot2)'
      Else
        MormotVer := ExtractFileName(ExcludeTrailingPathDelimiter(MPath)) + ' ('
                     + MPath + ')';
    End
  Else
    MormotVer := '(not initialized)';

  // Pas2JS
  Pas2jsVer := GetActivePas2JSVersion;
  If Pas2jsVer = 'bundled' Then
    Pas2jsVer := 'bundled (vendor/pas2js)'
  Else
    Pas2jsVer := Pas2jsVer + ' (.pas2js-version)';

  // Horse (Optional ecosystem tool: blaise-horse)
  HasHorseTool := DirectoryExists(GetGlobalToolsPath + 'blaise-horse') Or
                  DirectoryExists(GetBuiltinToolsPath + 'blaise-horse');
  HasHorseServer := DirectoryExists(IncludeTrailingPathDelimiter(Root) +
                    'server-horse');
  HorseVer := '';
  If HasHorseServer Then
    Begin
      HPathFile := IncludeTrailingPathDelimiter(Root) + 'server-horse' +
                   DirectorySeparator + 'horse.path';
      If FileExists(HPathFile) Then
        HorseVer := Trim(ReadFileToString(HPathFile))
      Else
        HorseVer := 'local (server-horse/lib/horse)';
    End
  Else If HasHorseTool Then
         Begin
           HorseVer := '(not initialized - run "bv horse init")';
         End;

  WriteLn('================================================================');
  WriteLn('  BlaiseVue SDK & Multi-Version Global Dashboard');
  WriteLn('================================================================');
  WriteLn('  Active Project Dependencies:');
  WriteLn('    * BlaiseVue: ' + FwVer);
  WriteLn('    * Capacitor: ' + CapVer);
  WriteLn('    * mORMot 2:  ' + MormotVer);
  WriteLn('    * Pas2JS:    ' + Pas2jsVer);
  If HasHorseServer Or HasHorseTool Then
    WriteLn('    * Horse:     ' + HorseVer);
  WriteLn('----------------------------------------------------------------');
  WriteLn('  Factory Protected Baselines:');
  WriteLn('    [x] active channel  BlaiseVue Global Git Channel (Protected)');
  WriteLn('    [x] vendor/mormot2  Synopse mORMot 2 Core (Immutable Baseline)');
  WriteLn(


      '    [x] vendor/pas2js   Free Pascal Pas2JS Compiler (Immutable Baseline)'
  );
  WriteLn('----------------------------------------------------------------');
  WriteLn('  Cached User SDK Distributions (~/.blaisevue/versions/):');

  AllItems := TStringList.Create;
  Parts := TStringList.Create;
  TotalBytes := 0;
  Try
    ScanModuleVersions('blaisevue', AllItems, TotalBytes);
    ScanModuleVersions('capacitor', AllItems, TotalBytes);
    ScanModuleVersions('mormot', AllItems, TotalBytes);
    ScanModuleVersions('pas2js', AllItems, TotalBytes);
    ScanModuleVersions('horse', AllItems, TotalBytes);

    If AllItems.Count = 0 Then
      WriteLn('    (no user versions cached on disk)')
    Else
      Begin
        For i := 0 To AllItems.Count - 1 Do
          Begin
            Line := AllItems[i];
            Parts.Clear;
            ExtractStrings(['|'], [], PChar(Line), Parts);
            If Parts.Count >= 4 Then
              Begin
                ModName := Parts[0];
                VerName := Parts[1];
                ModPath := Parts[2];
                SzStr := FormatFileSizeMB(StrToInt64Def(Parts[3], 0));
                WriteLn('    [' + ModName + '] ' + PadRight(VerName, 14) + ' ('
                + SzStr + ') -> ' + ModPath);
              End;
          End;
        WriteLn(


              '----------------------------------------------------------------'
        );
        WriteLn('  Total Disk Usage: ' + FormatFileSizeMB(TotalBytes));
      End;
  Finally
    Parts.Free;
    AllItems.Free;
End;

WriteLn('================================================================');
If HasHorseServer Or HasHorseTool Then
  Begin
    WriteLn(


 'To switch version:   bv <framework|capacitor|mormot|pas2js|horse> use <ver>'
    );
    WriteLn(
'To download version: bv <framework|capacitor|mormot|pas2js|horse> upgrade'
    );
  End
Else
  Begin
    WriteLn(
     'To switch version:   bv <framework|capacitor|mormot|pas2js> use <ver>'
    );
    WriteLn(
     'To download version: bv <framework|capacitor|mormot|pas2js> upgrade'
    );
  End;
WriteLn('To clean versions:   bv versions clean (or bv versions remove)');
WriteLn('================================================================');
End;

{ Interactive cleanup wizard across all cached SDK versions. }
Procedure CmdGlobalVersionsClean(Const Arg: String);

Var 
  AllItems, Parts: TStringList;
  TotalBytes: Int64;
  i, ChoiceIdx: Integer;
  UserChoice, Line, ModName, VerName, ItemPath: string;
  SzBytes: Int64;
Begin
  AllItems := TStringList.Create;
  Parts := TStringList.Create;
  TotalBytes := 0;
  Try
    ScanModuleVersions('blaisevue', AllItems, TotalBytes);
    ScanModuleVersions('capacitor', AllItems, TotalBytes);
    ScanModuleVersions('mormot', AllItems, TotalBytes);
    ScanModuleVersions('pas2js', AllItems, TotalBytes);
    ScanModuleVersions('horse', AllItems, TotalBytes);

    If AllItems.Count = 0 Then
      Begin
        WriteLn('No cached user versions found to clean in ' +
                GetGlobalVersionsPath(''));
        Exit;
      End;

    WriteLn('================================================================');
    WriteLn('  BlaiseVue SDK Multi-Version Disk Cleanup Wizard');
    WriteLn('================================================================');
    WriteLn('  Select a cached user version to permanently remove:');
    WriteLn('');
    For i := 0 To AllItems.Count - 1 Do
      Begin
        Line := AllItems[i];
        Parts.Clear;
        ExtractStrings(['|'], [], PChar(Line), Parts);
        If Parts.Count >= 4 Then
          Begin
            ModName := Parts[0];
            VerName := Parts[1];
            SzBytes := StrToInt64Def(Parts[3], 0);
            WriteLn('  [' + IntToStr(i + 1) + '] [' + PadRight(ModName, 9) +
            '] ' + PadRight(VerName, 12) + ' (' + FormatFileSizeMB(SzBytes) +
            ')');
          End;
      End;
    WriteLn('  [A] Remove ALL cached user versions (' + FormatFileSizeMB(
            TotalBytes) + ')');
    WriteLn('================================================================');
    Write('Select item to remove [1-' + IntToStr(AllItems.Count) +
    ', A, or C to Cancel]: ');
    ReadLn(UserChoice);
    UserChoice := Trim(UserChoice);

    If (UserChoice = '') Or (LowerCase(UserChoice) = 'c') Or (LowerCase(
       UserChoice) = 'cancel') Then
      Begin
        WriteLn('Operation cancelled.');
        Exit;
      End;

    If (LowerCase(UserChoice) = 'a') Or (LowerCase(UserChoice) = 'all') Then
      Begin
        Write(


             'Are you sure you want to permanently delete ALL cached versions ('
              + FormatFileSizeMB(TotalBytes) + ')? [y/N]: ');
        ReadLn(UserChoice);
        UserChoice := LowerCase(Trim(UserChoice));
        If (UserChoice = 'y') Or (UserChoice = 'yes') Or (UserChoice = 's') Or (
           UserChoice = 'sim') Then
          Begin
            For i := 0 To AllItems.Count - 1 Do
              Begin
                Line := AllItems[i];
                Parts.Clear;
                ExtractStrings(['|'], [], PChar(Line), Parts);
                If Parts.Count >= 4 Then
                  Begin
                    ItemPath := Parts[2];
                    If DirectoryExists(ItemPath) Then
                      Begin
                        WriteLn('  [-] Removing ' + ItemPath + ' ...');
                        DeleteDir(ItemPath);
                      End;
                  End;
              End;
            WriteLn(


              '  [SUCCESS] All cached user SDK versions removed successfully! ('
                    + FormatFileSizeMB(TotalBytes) + ' freed)');
          End
        Else
          WriteLn('Operation cancelled.');
        Exit;
      End;

    ChoiceIdx := StrToIntDef(UserChoice, -1);
    If (ChoiceIdx < 1) Or (ChoiceIdx > AllItems.Count) Then
      Begin
        WriteLn('Invalid selection.');
        Exit;
      End;

    Line := AllItems[ChoiceIdx - 1];
    Parts.Clear;
    ExtractStrings(['|'], [], PChar(Line), Parts);
    ModName := Parts[0];
    VerName := Parts[1];
    ItemPath := Parts[2];
    SzBytes := StrToInt64Def(Parts[3], 0);

    Write('Are you sure you want to permanently delete [' + ModName + '] "' +
          VerName + '" (' + FormatFileSizeMB(SzBytes) + ')? [y/N]: ');
    ReadLn(UserChoice);
    UserChoice := LowerCase(Trim(UserChoice));
    If (UserChoice = 'y') Or (UserChoice = 'yes') Or (UserChoice = 's') Or (
       UserChoice = 'sim') Then
      Begin
        WriteLn('  [-] Removing ' + ItemPath + ' ...');
        DeleteDir(ItemPath);
        If (LowerCase(ModName) = 'blaisevue') And
           (LowerCase(GetActiveFrameworkVersion) = LowerCase(VerName)) Then
          Begin
            Line := FindBlaiseVueProjectRoot('');
            If (Line <> '') And FileExists(IncludeTrailingPathDelimiter(Line) +
               '.blaisevue-version') Then
              DeleteFile(IncludeTrailingPathDelimiter(Line) +
                         '.blaisevue-version');
          End;
        WriteLn('  [SUCCESS] Version "' + VerName + '" removed successfully! ('
                + FormatFileSizeMB(SzBytes) + ' freed)');
      End
    Else
      WriteLn('Operation cancelled.');

  Finally
    Parts.Free;
    AllItems.Free;
End;
End;




{ Central CLI orchestrator for the full-stack Synopse mORMot 2 backend engine (bv mormot). }
Procedure CmdServer(Const SubCmd: String; Const Arg1: String = ''; Const Arg2:
                    String = '');

Var 
  ServerDir, BinDir, LibDir, TemplateDir, DbEngineArg, EnvFile, EnvContent:


                                                                          string
  ;
  ProjectRoot, DeployDir, DistDir, ZipFile: string;
  LprFile, TargetExe, MormotPath, FpcCmd, PortArg, ExtraArgs, MormotAutoDir, MormotDlErr: string;
  IsRelease, HasZip, UserSpecifiedPort, IsFresh: Boolean;
  TargetPort, OrigPort: Word;
  EnvLines: TStringList;
  EnvLine: string;
  i: Integer;
  HttpClient: TFPHTTPClient;
  StatusResp: string;
  F: TextFile;
  { Parses an individual command line option flag or positional parameter. }
Procedure ParseArg(Const A: String);

Var 
  S: string;
Begin
  S := LowerCase(A);
  If S = '' Then Exit;
  If (S = '--release') Or (S = '-r') Or (S = 'release') Then
    IsRelease := True
  Else If (S = '--debug') Or (S = '-d') Or (S = 'debug') Then
         IsRelease := False
  Else If (S = '--zip') Or (S = '-z') Or (S = 'zip') Then
         HasZip := True
  Else If (Copy(S, 1, 7) = '--port=') Then
         PortArg := Copy(A, 8, MaxInt)
  Else If (Copy(S, 1, 6) = '--out=') Then
         DeployDir := Copy(A, 7, MaxInt)
  Else If S = '--fresh' Then
         IsFresh := True;
End;
Begin
  If (SubCmd = 'versions') Or (SubCmd = 'version') Or (SubCmd = 'list-versions')
     Or (SubCmd = 'list') Then
    Begin
      CmdMormotVersions;
      Exit;
    End;

  If (SubCmd = 'upgrade') Or (SubCmd = 'install') Then
    Begin
      CmdMormotUpgrade(Arg1);
      Exit;
    End;

  If (SubCmd = 'use') Or (SubCmd = 'select') Or (SubCmd = 'set') Then
    Begin
      CmdMormotUse(Arg1);
      Exit;
    End;

  If (SubCmd = 'remove-version') Or (SubCmd = 'delete-version') Or (SubCmd =
     'rm-version') Then
    Begin
      CmdMormotRemoveVersion(Arg1, (Arg1 = '-y') or (Arg1 = '--yes') or (Arg2 =
                                                                         '-y')
      or (Arg2 = '--yes') or (Arg1 = '-f') or (Arg2 = '-f'));
      Exit;
    End;

  ProjectRoot := RequireBlaiseVueProject('bv mormot ' + SubCmd);

  ServerDir := ResolveMormotServerDir(ProjectRoot, SubCmd = 'init');
  BinDir := ServerDir + DirectorySeparator + 'bin';
  LibDir := ServerDir + DirectorySeparator + 'lib';
  LprFile := ServerDir + DirectorySeparator + 'server.lpr';
  TargetExe := BinDir + DirectorySeparator + 'server' + {$IFDEF WINDOWS}'.exe'
               {$ELSE}''{$ENDIF};
  TemplateDir := GetSDKPath + 'templates' + DirectorySeparator +
                 'fullstack-mormot';
  DeployDir := ProjectRoot + DirectorySeparator + 'deploy';
  IsRelease := False;
  HasZip := False;
  IsFresh := False;
  PortArg := '';
  DbEngineArg := 'sqlite';
  If LowerCase(ParamStr(1)) = 'mormot' Then
    Begin
      For i := 2 To ParamCount Do
        Begin
          If (ParamStr(i) = '--port') Or (ParamStr(i) = '-p') Then
            Begin
              If i + 1 <= ParamCount Then
                PortArg := ParamStr(i + 1);
            End

          Else If (ParamStr(i) = '--out') Or (ParamStr(i) = '-o') Then
                 Begin
                   If i + 1 <= ParamCount Then
                     DeployDir := ParamStr(i + 1);
                 End
          Else If (ParamStr(i) = '--db') Or (ParamStr(i) = '--database') Or (
                  ParamStr(i) = '-d') Then
                 Begin
                   If i + 1 <= ParamCount Then
                     DbEngineArg := LowerCase(Trim(ParamStr(i + 1)));
                 End
          Else If (Copy(ParamStr(i), 1, 5) = '--db=') Then
                 Begin
                   DbEngineArg := LowerCase(Trim(Copy(ParamStr(i), 6, MaxInt)));
                 End

          Else
            ParseArg(ParamStr(i));
        End;
    End;

  ParseArg(Arg1);
  ParseArg(Arg2);
  If (SubCmd = 'remove') Or (SubCmd = 'rm') Or (SubCmd = 'uninstall') Then
    Begin
      CmdRemoveMormot(IsRelease Or (Arg1 = '-y') or (Arg1 = '--yes') or (Arg1 =
                                                                         '-f')
      or (Arg1 = '--force') or (Arg2 = '-y') or (Arg2 = '--yes') or (Arg2 = '-f'
      ) or (Arg2 = '--force'));
      Exit;
    End
  Else If (SubCmd = 'crud') Then
         Begin
           CmdMormotCrud(ProjectRoot);
           Exit;
         End

  Else If (SubCmd = 'auth') Then
         Begin
           CmdMormotAuth(ProjectRoot);
           Exit;
         End

  Else If (SubCmd = 'docs') Or (SubCmd = 'swagger') Or (SubCmd = 'openapi') Then
         Begin
           CmdMormotDocs(ProjectRoot);
           Exit;
         End

  Else If (SubCmd = 'docker') Or (SubCmd = 'container') Then
         Begin
           CmdMormotDocker(ProjectRoot);
           Exit;
         End

  Else If (SubCmd = 'rpc') Or (SubCmd = 'soa') Or (SubCmd = 'proxies') Then
         Begin
           CmdMormotRPC(ProjectRoot);
           Exit;
         End

  Else If (SubCmd = 'init') Then
         Begin
           WriteLn(


    'Initializing BlaiseVue mORMot 2 Native Backend Server in server-mormot/...'
           );
           If Not DirectoryExists(TemplateDir) Then
             Begin
               WriteLn(


                     'Error: Fullstack mORMot template directory not found at: '
                       + TemplateDir);
               Halt(1);
             End;

           ForceDir(ServerDir);
           CopyDir(TemplateDir, ServerDir, ['bin', 'lib']);
           ForceDir(BinDir);
           ForceDir(LibDir);

           // Multi-Database ORM Configuration
           If (DbEngineArg <> 'sqlite') And (DbEngineArg <> 'postgres') And
              (DbEngineArg <> 'postgresql') And (DbEngineArg <> 'mysql') And
              (DbEngineArg <> 'mariadb') And (DbEngineArg <> 'firebird') And
              (DbEngineArg <> 'fb') Then
             Begin
               If DbEngineArg <> '' Then
                 WriteLn('  [!] Notice: Unknown database engine "' + DbEngineArg
                         + '", defaulting to "sqlite"');
               DbEngineArg := 'sqlite';
             End;

           If (DbEngineArg = 'postgresql') Then DbEngineArg := 'postgres';
           If (DbEngineArg = 'mariadb') Then DbEngineArg := 'mysql';
           If (DbEngineArg = 'fb') Then DbEngineArg := 'firebird';
           EnvFile := ServerDir + DirectorySeparator + '.env';
           If Not FileExists(EnvFile) Then
             Begin
               EnvContent := '# BlaiseVue mORMot 2 Database Configuration' + #13#10 +
                             'PORT=8090' + #13#10 +
                             'DATABASE_ENGINE=' + DbEngineArg + #13#10;
               If DbEngineArg = 'postgres' Then
                 EnvContent := EnvContent +


        'DATABASE_URL=postgres://postgres:postgres@localhost:5432/blaisevue_app'
                               + #13#10
               Else If DbEngineArg = 'mysql' Then
                      EnvContent := EnvContent +


               'DATABASE_URL=mysql://root:password@localhost:3306/blaisevue_app'
                                    + #13#10
               Else If DbEngineArg = 'firebird' Then
                      EnvContent := EnvContent +


'DATABASE_URL=firebird://SYSDBA:masterkey@localhost:3050/server-mormot/data.fdb'
                                    + #13#10
               Else
                 EnvContent := EnvContent +
                               'DATABASE_URL=sqlite://server-mormot/data.db' + #13#10;
               WriteStringToFile(EnvFile, EnvContent);
               WriteLn(


                 '  [+] Created server-mormot/.env (PORT=8090, DATABASE_ENGINE='
                       + DbEngineArg + ')');
             End;

           WriteLn('  [+] Pluggable Database Engine Configured: ' + UpperCase(
                   DbEngineArg));
           WriteLn(


'  [+] Full-Stack mORMot 2 server template scaffolded successfully in server-mormot/ !'
           );
           WriteLn('');
           WriteLn('Next steps:');
           WriteLn(


'  1. Run "bv build" (or "bv build --release") to compile your reactive frontend to dist/'
           );
           WriteLn(


'  2. Run "bv mormot build" (or "bv mormot build --release") to compile the native server'
           );
           WriteLn(


'  3. Run "bv mormot run" (or "bv mormot run --release") to launch the server on port 8090'
           );
           WriteLn(


               '  Or open server-mormot/server.lpi in Lazarus IDE and press F9!'
           );
         End

  Else If (SubCmd = 'build') Then
         Begin
           If Not FileExists(LprFile) Then
             Begin
               WriteLn('No server project found in ', ExtractFileName(
                       ExcludeTrailingPathDelimiter(ServerDir)),
               '/. Initializing first...');
               CmdServer('init');
             End;

           MormotPath := FindMormot2Path;
           If MormotPath = '' Then
             Begin
               MormotAutoDir := IncludeTrailingPathDelimiter(GetGlobalVersionsPath('mormot')) + 'latest';
               WriteLn('  [*] Synopse mORMot 2 not found locally; fetching on demand into:');
               WriteLn('      ', MormotAutoDir);
               If TBVUpgrade.DownloadMormot2Archive('latest', MormotAutoDir, MormotDlErr) Then
                 MormotPath := FindMormot2Path
               Else If MormotDlErr <> '' Then
                 WriteLn('  [!] On-demand mORMot 2 download failed: ', MormotDlErr);
             End;

           If MormotPath = '' Then
             Begin
               WriteLn('[!] Error: Synopse mORMot 2 installation not found.');
               WriteLn('    BlaiseVue searched:');
               WriteLn('    - ~/.blaisevue/versions/mormot/latest');
               WriteLn('    - Environment variable MORMOT2_PATH');
               WriteLn('    - C:\ComponenteLazarus\mORMot2');
               WriteLn('    - Local config file server-mormot/mormot.path');
               WriteLn('    - ../mORMot2, /opt/mormot2, ~/mORMot2');
               WriteLn('');
               WriteLn('    To fix:');
               WriteLn('    1. Run "bv mormot upgrade" to install mORMot 2 globally.');
               WriteLn('    2. Or set MORMOT2_PATH / create server-mormot/mormot.path.');
               Halt(1);
             End;

           ForceDir(BinDir);
           ForceDir(LibDir);
           WriteLn('Building BlaiseVue mORMot 2 Native Server...');
           WriteLn('  [+] mORMot 2 Path: ' + MormotPath);
           If IsRelease Then
             WriteLn('  [+] Mode: RELEASE (Optimized -O3, stripped symbols)')

           Else
             WriteLn('  [+] Mode: DEBUG (-O2, debug symbols active)');

           FpcCmd := 'fpc -MObjFPC -Sh ';
           If IsRelease Then
             FpcCmd := FpcCmd + '-O3 -Xs -dRELEASE '

           Else
             FpcCmd := FpcCmd + '-O2 -g -gl -dDEBUG ';

           FpcCmd := FpcCmd +

                     '-Fi"' + MormotPath + DirectorySeparator + 'src" ' +

                     '-Fi"' + MormotPath + DirectorySeparator + 'src' +
                     DirectorySeparator + 'core" ' +

                     '-Fi"' + MormotPath + DirectorySeparator + 'src' +
                     DirectorySeparator + 'net" ' +

                     '-Fu"' + MormotPath + DirectorySeparator + 'src' +
                     DirectorySeparator + 'core" ' +

                     '-Fu"' + MormotPath + DirectorySeparator + 'src' +
                     DirectorySeparator + 'net" ' +

                     '-Fu"' + MormotPath + DirectorySeparator + 'src' +
                     DirectorySeparator + 'app" ' +

                     '-Fu"' + MormotPath + DirectorySeparator + 'src' +
                     DirectorySeparator + 'crypt" ' +

                     '-Fu"' + MormotPath + DirectorySeparator + 'src' +
                     DirectorySeparator + 'db" ' +

                     '-Fu"' + MormotPath + DirectorySeparator + 'src' +
                     DirectorySeparator + 'lib" ' +

                     '-Fu"' + MormotPath + DirectorySeparator + 'src' +
                     DirectorySeparator + 'orm" ' +

                     '-Fu"' + MormotPath + DirectorySeparator + 'src' +
                     DirectorySeparator + 'rest" ' +

                     '-Fu"' + MormotPath + DirectorySeparator + 'src' +
                     DirectorySeparator + 'soa" ' +

                     '-Fu"' + MormotPath + DirectorySeparator + 'src' +
                     DirectorySeparator + 'misc" ';

    {$IFDEF WINDOWS}
           ExecuteProcess('cmd', '/c taskkill /F /IM server.exe > nul 2>&1');
           If DirectoryExists(MormotPath + DirectorySeparator + 'static' +
              DirectorySeparator + 'x86_64-win64') Then
             FpcCmd := FpcCmd + '-Fl"' + MormotPath + DirectorySeparator +
                       'static' + DirectorySeparator + 'x86_64-win64" ';
           FpcCmd := FpcCmd + '-FEbin -FUlib server.lpr';
           ExecuteProcess('cmd', '/c cd /d "' + ServerDir + '" && ' + FpcCmd);
    {$ELSE}
           If DirectoryExists(MormotPath + DirectorySeparator + 'static' +
              DirectorySeparator + 'x86_64-linux') Then
             Begin
               FpcCmd := FpcCmd + '-Fl"' + MormotPath + DirectorySeparator +
                         'static' + DirectorySeparator + 'x86_64-linux" ';
               FpcCmd := FpcCmd + '-Fo"' + MormotPath + DirectorySeparator +
                         'static' + DirectorySeparator + 'x86_64-linux" ';
             End;
           FpcCmd := FpcCmd + '-FEbin -FUlib server.lpr';
           ExecuteProcess('/bin/sh', ['-c', 'cd "' + ServerDir + '" && ' +
                          FpcCmd]);
    {$ENDIF}

           If FileExists(TargetExe) Then
             Begin
               WriteLn(


                    '  [SUCCESS] Native mORMot 2 server compiled successfully: '
                       + TargetExe);
               If IsRelease Then
                 WriteLn(


    '  [TIP] Run "bv mormot run --release" to start the server in release mode.'
                 )
               Else
                 WriteLn(


'  [TIP] Run "bv mormot run" to start the server (or "bv mormot run --release" for release mode).'
                 );
             End
           Else
             Begin
               WriteLn(


         '  [ERROR] Server compilation failed. Check FPC compiler output above.'
               );
               Halt(1);
             End;
         End

  Else If (SubCmd = 'run') Then
         Begin
           If IsRelease Then
             Begin
               WriteLn(


     '  [+] Compiling reactive frontend in RELEASE mode (bv build --release)...'
               );
               ChDir(ProjectRoot);
               CmdRunBuild;
               WriteLn(


  '  [+] Compiling native server in RELEASE mode (bv mormot build --release)...'
               );
               CmdServer('build', '--release');
             End
           Else
             Begin
               If (Not FileExists(ProjectRoot + DirectorySeparator + 'dist' +
                  DirectorySeparator + 'index.html') Or
                  Not FileExists(ProjectRoot + DirectorySeparator + 'dist' +
                  DirectorySeparator + 'js' + DirectorySeparator + 'main.js'))
                  And
                  DirectoryExists(ProjectRoot + DirectorySeparator + 'src') Then
                 Begin
                   WriteLn(


'  [INFO] Frontend dist/ bundle not found. Building frontend before starting mORMot 2 server...'
                   );
                   CmdBuild;
                 End;

               If Not FileExists(TargetExe) Then
                 Begin
                   CmdServer('build');
                 End;
             End;

           If Not FileExists(TargetExe) Then
             Begin
               WriteLn('Error: Server binary not found: ' + TargetExe);
               Halt(1);
             End;

           TargetPort := 8090;
           UserSpecifiedPort := (PortArg <> '');
           If Not UserSpecifiedPort Then
             Begin
               EnvFile := ProjectRoot + DirectorySeparator + '.env';
               If Not FileExists(EnvFile) Then
                 EnvFile := ServerDir + DirectorySeparator + '.env';
               If FileExists(EnvFile) Then
                 Begin
                   EnvLines := TStringList.Create;
                   Try
                     EnvLines.LoadFromFile(EnvFile);
                     For i := 0 To EnvLines.Count - 1 Do
                       Begin
                         EnvLine := Trim(EnvLines[i]);
                         If (EnvLine <> '') And (EnvLine[1] <> '#') And (Pos(
                            'PORT=', UpperCase(EnvLine)) = 1) Then
                           Begin
                             PortArg := Trim(Copy(EnvLine, 6, MaxInt));
                             UserSpecifiedPort := True;
                             Break;
                           End;
                       End;
                   Finally
                     EnvLines.Free;
                 End;
             End;
         End;

  If PortArg <> '' Then
    TargetPort := StrToIntDef(PortArg, 8090);

  If IsFresh Then
    Begin
      WriteLn(


  '  [+] Fresh mORMot server requested (--fresh). Resetting active instances...'
      );
      KillMormotServer(TargetPort);
      Sleep(200);
    End
  Else
    Begin
      {$IFDEF WINDOWS}
      ExecuteProcess('cmd', '/c taskkill /F /IM server.exe > nul 2>&1');
      {$ENDIF}
    End;

  If Not IsTcpPortAvailable(TargetPort) Then
    Begin
      If IsFresh Then
        Begin
          KillMormotServer(TargetPort);
          Sleep(200);
        End;

      If Not IsTcpPortAvailable(TargetPort) Then
        Begin
          If UserSpecifiedPort Then
            Begin
              WriteLn('  [WARNING] Port ' + IntToStr(TargetPort) +
              ' is reported in use or locked by a lingering socket.');
              WriteLn(


         '            Tip: Run "bv mormot kill" or use "bv mormot run --fresh".'
              );
            End
          Else
            Begin
              OrigPort := TargetPort;
              TargetPort := FindNextAvailableTcpPort(TargetPort + 1);
              PortArg := IntToStr(TargetPort);
              WriteLn('  [!] Notice: Default port ' + IntToStr(OrigPort) +
              ' is busy or locked by a lingering socket.');
              WriteLn('  [+] Automatically switched to available port: ' +
                      PortArg);
              WriteLn(


'      (Tip: Run "bv mormot run --fresh" to terminate previous instances and keep port '
                      + IntToStr(OrigPort) + ')');
            End;
        End;
    End;

  ExtraArgs := ' --port ' + IntToStr(TargetPort);
  If IsRelease Then
    WriteLn('Starting BlaiseVue mORMot 2 Native Server [RELEASE MODE]...')
  Else
    WriteLn('Starting BlaiseVue mORMot 2 Native Server [DEBUG MODE]...');
  WriteLn('Executable: ' + TargetExe);
  WriteLn('Port:       ' + IntToStr(TargetPort));
  WriteLn('');

    {$IFDEF WINDOWS}
  ExecuteProcess('cmd', '/c cd /d "' + ServerDir + '" && "bin' +
                 DirectorySeparator + 'server.exe"' + ExtraArgs);
    {$ELSE}
  ExecuteProcess('/bin/sh', ['-c', 'cd "' + ServerDir + '" && exec ./bin/server'
                 + ExtraArgs]);
    {$ENDIF}
End

Else If SubCmd = 'kill' Then
       Begin
         TargetPort := 8090;
         If PortArg <> '' Then
           TargetPort := StrToIntDef(PortArg, 8090)
         Else
           Begin
             EnvFile := ProjectRoot + DirectorySeparator + '.env';
             If Not FileExists(EnvFile) Then
               EnvFile := ServerDir + DirectorySeparator + '.env';
             If FileExists(EnvFile) Then
               Begin
                 EnvLines := TStringList.Create;
                 Try
                   EnvLines.LoadFromFile(EnvFile);
                   For i := 0 To EnvLines.Count - 1 Do
                     Begin
                       EnvLine := Trim(EnvLines[i]);
                       If (EnvLine <> '') And (EnvLine[1] <> '#') And (Pos(
                          'PORT=', UpperCase(EnvLine)) = 1) Then
                         Begin
                           TargetPort := StrToIntDef(Trim(Copy(EnvLine, 6,
                                         MaxInt)), 8090);
                           Break;
                         End;
                     End;
                 Finally
                   EnvLines.Free;
               End;
           End;
       End;
KillMormotServer(TargetPort);
End

Else If (SubCmd = 'status') Then
       Begin
         UserSpecifiedPort := False;
         PortArg := '8090';
         For i := 2 To ParamCount Do
           Begin
             If (ParamStr(i) = '--port') Or (ParamStr(i) = '-p') Then
               Begin
                 If i + 1 <= ParamCount Then
                   Begin
                     PortArg := ParamStr(i + 1);
                     UserSpecifiedPort := True;
                   End;
               End
             Else If Copy(ParamStr(i), 1, 7) = '--port=' Then
                    Begin
                      PortArg := Copy(ParamStr(i), 8, MaxInt);
                      UserSpecifiedPort := True;
                    End;
           End;

         If Not UserSpecifiedPort Then
           Begin
             EnvFile := ProjectRoot + DirectorySeparator + '.env';
             If Not FileExists(EnvFile) Then
               EnvFile := ServerDir + DirectorySeparator + '.env';
             If FileExists(EnvFile) Then
               Begin
                 EnvLines := TStringList.Create;
                 Try
                   EnvLines.LoadFromFile(EnvFile);
                   For i := 0 To EnvLines.Count - 1 Do
                     Begin
                       EnvLine := Trim(EnvLines[i]);
                       If (EnvLine <> '') And (EnvLine[1] <> '#') And (Pos(
                          'PORT=', UpperCase(EnvLine)) = 1) Then
                         Begin
                           PortArg := Trim(Copy(EnvLine, 6, MaxInt));
                           Break;
                         End;
                     End;
                 Finally
                   EnvLines.Free;
               End;
           End;
       End;

WriteLn('Checking BlaiseVue mORMot 2 server status on http://localhost:' +
        PortArg + '/api/status ...');
HttpClient := TFPHTTPClient.Create(Nil);
HttpClient.IOTimeout := 2000;
Try

  Try

    StatusResp := HttpClient.Get('http://localhost:' + PortArg + '/api/status');
    WriteLn('[+] Server is ONLINE!');
    WriteLn(StatusResp);

  Except
    on E: Exception Do
          Begin
            If (PortArg = '8090') And (ParamCount < 3) Then
              Begin
                Try
                  StatusResp := HttpClient.Get(
                                'http://localhost:8091/api/status');
                  WriteLn('[+] Server is ONLINE on fallback port 8091!');
                  WriteLn(StatusResp);
                  Exit;
                Except
              End;
          End;
    WriteLn('[-] Server is OFFLINE or unreachable on port ' + PortArg + ': ' + E
            .Message);
    WriteLn('    Start it using: bv mormot run');
End;
End;

Finally

  HttpClient.Free;
End;
End

Else If (SubCmd = 'deploy') Then
       Begin
         If PortArg = '' Then
           PortArg := '8090';

         WriteLn(


              '================================================================'
         );
         WriteLn('  BlaiseVue + mORMot 2 Production Deployment Packager');
         WriteLn(


              '================================================================'
         );
         WriteLn('');
         If Not FileExists(LprFile) Then
           Begin
             WriteLn('[!] No server project found in ', ExtractFileName(
                     ExcludeTrailingPathDelimiter(ServerDir)),
             '/. Initializing first...');
             CmdServer('init');
           End;

         // 1. Build frontend in production mode

         WriteLn('[1/4] Compiling reactive frontend (bv build --release)...');
         ChDir(ProjectRoot);
         CmdRunBuild;
         DistDir := ProjectRoot + DirectorySeparator + 'dist';
         If Not DirectoryExists(DistDir) Then
           Begin
             WriteLn(


             '[ERROR] Frontend production build failed. dist/ folder not found.'
             );
             Halt(1);
           End;

         WriteLn('  [+] Frontend compiled with production hashes in dist/');
         WriteLn('');

         // 2. Build native backend in RELEASE mode

         WriteLn(


         '[2/4] Compiling native mORMot 2 server (bv mormot build --release)...'
         );
         CmdServer('build', '--release');
         If Not FileExists(TargetExe) Then
           Begin
             WriteLn('[ERROR] Server compilation failed: ' + TargetExe);
             Halt(1);
           End;

         WriteLn('  [+] Native server binary built in: ' + TargetExe);
         WriteLn('');

         // 3. Assemble deployment directory

         WriteLn('[3/4] Assembling standalone deployment package in: ' +
                 DeployDir);
         If DirectoryExists(DeployDir) Then
           DeleteDir(DeployDir);

         ForceDir(DeployDir);
         ForceDir(DeployDir + DirectorySeparator + 'dist');

         // Copy server binary

         CopyFile(TargetExe, DeployDir + DirectorySeparator + ExtractFileName(
                  TargetExe));

         // Copy dist/ contents

         CopyDir(DistDir, DeployDir + DirectorySeparator + 'dist', []);

         // Create start.bat (Windows)

         AssignFile(F, DeployDir + DirectorySeparator + 'start.bat');
         Rewrite(F);
         WriteLn(F, '@echo off');
         WriteLn(F, 'title BlaiseVue Server (Port ' + PortArg + ')');
         WriteLn(F, 'echo ====================================================')
         ;
         WriteLn(F, 'echo  Starting BlaiseVue mORMot 2 Native Server...');
         WriteLn(F, 'echo  Port: ' + PortArg);
         WriteLn(F, 'echo  Hosting API and Static Frontend from ./dist');
         WriteLn(F, 'echo ====================================================')
         ;
         WriteLn(F, ExtractFileName(TargetExe) + ' --port ' + PortArg);
         WriteLn(F, 'if errorlevel 1 pause');
         CloseFile(F);

         // Create start.sh (Linux/macOS)

         AssignFile(F, DeployDir + DirectorySeparator + 'start.sh');
         Rewrite(F);
         WriteLn(F, '#!/bin/sh');
         WriteLn(F,
                 'echo "===================================================="');
         WriteLn(F, 'echo " Starting BlaiseVue mORMot 2 Native Server..."');
         WriteLn(F, 'echo " Port: ' + PortArg + '"');
         WriteLn(F, 'echo " Hosting API and Static Frontend from ./dist"');
         WriteLn(F,
                 'echo "===================================================="');
         WriteLn(F, 'chmod +x ./' + ExtractFileName(TargetExe));
         WriteLn(F, './' + ExtractFileName(TargetExe) + ' --port ' + PortArg);
         CloseFile(F);

         // Create README.txt

         AssignFile(F, DeployDir + DirectorySeparator + 'README.txt');
         Rewrite(F);
         WriteLn(F, 'BlaiseVue Full-Stack Standalone Deployment Package');
         WriteLn(F, '==================================================');
         WriteLn(F, '');
         WriteLn(F,


'This deployment directory is 100% self-contained and ready to copy to your server.'
         );
         WriteLn(F,


 'No Node.js, npm, or Free Pascal installation required on the production host!'
         );
         WriteLn(F, '');
         WriteLn(F, 'How to run on the server:');
         WriteLn(F, '  Windows: Double-click start.bat (or run "' +
                 ExtractFileName(TargetExe) + ' --port ' + PortArg + '")');
         WriteLn(F, '  Linux:   Run "./start.sh" (or "./' + ExtractFileName(
                 TargetExe) + ' --port ' + PortArg + '")');
         WriteLn(F, '');
         WriteLn(F, 'Files:');
         WriteLn(F, '  - ' + ExtractFileName(TargetExe) +
         ' : Native mORMot 2 backend executable');
         WriteLn(F, '  - dist/            : Compiled reactive SPA frontend');
         WriteLn(F, '  - start.bat        : Windows startup script');
         WriteLn(F, '  - start.sh         : Linux startup script');
         CloseFile(F);
         WriteLn('  [+] Deployment directory assembled successfully!');
         WriteLn('');

         // 4. Create ZIP archive if requested

         If HasZip Then
           Begin
             ZipFile := ProjectRoot + DirectorySeparator + 'deploy.zip';
             If FileExists(ZipFile) Then
               DeleteFile(ZipFile);

             WriteLn('[4/4] Packaging standalone archive: ' + ZipFile);

      {$IFDEF WINDOWS}

             ExecuteProcess('cmd',


                  '/c powershell -NoProfile -Command "Compress-Archive -Path '''
                            + DeployDir + '\*'' -DestinationPath ''' + ZipFile +
                            ''' -Force"');

      {$ELSE}

             ExecuteProcess('/bin/sh', '-c "cd ''' + DeployDir +
                            ''' && zip -r ''' + ZipFile + ''' ."');

      {$ENDIF}

             If FileExists(ZipFile) Then
               WriteLn('  [SUCCESS] Archive created: ' + ZipFile)

             Else
               WriteLn(


'  [!] Notice: ZIP packaging skipped (zip utility not found). The deploy/ directory is ready.'
               );
           End

         Else
           Begin
             WriteLn('[4/4] Deployment directory ready: ' + DeployDir);
             WriteLn(


'      Tip: Run "bv mormot deploy --zip" to automatically generate a deploy.zip archive.'
             );
           End;

         WriteLn('');
         WriteLn(


              '================================================================'
         );
         WriteLn('  [SUCCESS] Application ready for production deployment!');
         WriteLn('  Just copy "' + ExtractFileName(DeployDir) +
         '" to your server and run start.bat (or ./start.sh)');
         WriteLn(


              '================================================================'
         );
       End

Else
  Begin
    WriteLn(


'Usage: bv mormot <init|build [--release]|run [--release] [--port <p>]|status [--port <p>]|deploy [--zip] [--port <p>]|crud <Model> [field:type...]|auth|docs|docker|remove [-y]>'
    );
    WriteLn(


          '  init                  Scaffolds mORMot 2 backend server in server/'
    );
    WriteLn('  build [--release]     Compiles native server with Free Pascal');
    WriteLn(


   '  run [--release] [--port <port>] Launches native server (debug or release)'
    );
    WriteLn(


  '  status [--port <p>]   Queries running server health endpoint (/api/status)'
    );
    WriteLn(


'  deploy [--zip]        Packages standalone production bundle (deploy/ and deploy.zip)'
    );
    WriteLn(


'  crud <Model> [f:t...] Scaffolds full-stack ORM model, REST API & reactive DataGrid'
    );
    WriteLn(


  '  remove [-y]           Safely deletes server/ directory and mORMot binaries'
    );
  End;
End;

