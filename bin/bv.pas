{ Processes a single 512-bit (64-byte) block with the SHA-256 compression function. }
Procedure SHA256Transform(Var State: Array Of Cardinal; Const Block: Array Of
                          Byte);

Var 
  W: array[0..63] Of Cardinal;
  a, b, c, d, e, f, g, h, T1, T2: Cardinal;
  i: Integer;
Begin
  For i := 0 To 15 Do
    W[i] := (Cardinal(Block[i*4]) shl 24) Or (Cardinal(Block[i*4+1]) shl 16) Or
            (Cardinal(Block[i*4+2]) shl 8)  Or Cardinal(Block[i*4+3]);
  For i := 16 To 63 Do
    W[i] := Gamma1_32(W[i - 2]) + W[i - 7] + Gamma0_32(W[i - 15]) + W[i - 16];

  a := State[0];
  b := State[1];
  c := State[2];
  d := State[3];
  e := State[4];
  f := State[5];
  g := State[6];
  h := State[7];
  For i := 0 To 63 Do
    Begin
      T1 := h + Sigma1_32(e) + Ch32(e, f, g) + K256[i] + W[i];
      T2 := Sigma0_32(a) + Maj32(a, b, c);
      h := g;
      g := f;
      f := e;
      e := d + T1;
      d := c;
      c := b;
      b := a;
      a := T1 + T2;
    End;

  Inc(State[0], a);
  Inc(State[1], b);
  Inc(State[2], c);
  Inc(State[3], d);
  Inc(State[4], e);
  Inc(State[5], f);
  Inc(State[6], g);
  Inc(State[7], h);
End;




{ Initializes a SHA-256 cryptographic hashing context with standard initial constants. }
Procedure SHA256Init(Var Ctx: TSHA256Context);
Begin
  Ctx.State[0] := $6a09e667;
  Ctx.State[1] := $bb67ae85;
  Ctx.State[2] := $3c6ef372;
  Ctx.State[3] := $a54ff53a;
  Ctx.State[4] := $510e527f;
  Ctx.State[5] := $9b05688c;
  Ctx.State[6] := $1f83d9ab;
  Ctx.State[7] := $5be0cd19;
  Ctx.Count := 0;
  FillChar(Ctx.Buffer, SizeOf(Ctx.Buffer), 0);
End;

{ Feeds a byte buffer into the active SHA-256 cryptographic hashing context. }
Procedure SHA256Update(Var Ctx: TSHA256Context; Const Data; Len: Cardinal);

Var 
  BufferIndex, BufferLeft: Cardinal;
  P: PByte;
Begin
  P := PByte(@Data);
  BufferIndex := Cardinal(Ctx.Count And 63);
  Inc(Ctx.Count, Len);
  BufferLeft := 64 - BufferIndex;
  If Len >= BufferLeft Then
    Begin
      Move(P^, Ctx.Buffer[BufferIndex], BufferLeft);
      SHA256Transform(Ctx.State, Ctx.Buffer);
      Inc(P, BufferLeft);
      Dec(Len, BufferLeft);
      While Len >= 64 Do
        Begin
          Move(P^, Ctx.Buffer[0], 64);
          SHA256Transform(Ctx.State, Ctx.Buffer);
          Inc(P, 64);
          Dec(Len, 64);
        End;
      BufferIndex := 0;
    End;
  If Len > 0 Then
    Move(P^, Ctx.Buffer[BufferIndex], Len);
End;




{ Finalizes the SHA-256 context and returns the resulting 64-character lowercase hexadecimal hash. }
Function SHA256FinalHex(Var Ctx: TSHA256Context): string;

Var 
  BitLen: QWord;
  PadLen: Cardinal;
  Pad: array[0..63] Of Byte;
  i: Integer;
  BEBits: array[0..7] Of Byte;
Begin
  BitLen := Ctx.Count * 8;
  FillChar(Pad, SizeOf(Pad), 0);
  Pad[0] := $80;
  If (Ctx.Count And 63) < 56 Then
    PadLen := 56 - (Ctx.Count And 63)
  Else
    PadLen := 120 - (Ctx.Count And 63);

  For i := 0 To 7 Do
    BEBits[i] := Byte((BitLen shr ((7 - i) * 8)) And $FF);

  SHA256Update(Ctx, Pad, PadLen);
  SHA256Update(Ctx, BEBits, 8);
  Result := '';
  For i := 0 To 7 Do
    Result := Result + IntToHex(Ctx.State[i], 8);
  Result := LowerCase(Result);
End;

{ Computes the cryptographic SHA-256 checksum of a file on disk. }
Function FileSHA256(Const FileName: String): string;

Var 
  FS: TFileStream;
  Ctx: TSHA256Context;
  Buf: array[0..8191] Of Byte;
  ReadBytes: Integer;
Begin
  Result := '';
  If Not FileExists(FileName) Then Exit;
  SHA256Init(Ctx);
  FS := TFileStream.Create(FileName, fmOpenRead Or fmShareDenyNone);
  Try
    While True Do
      Begin
        ReadBytes := FS.Read(Buf, SizeOf(Buf));
        If ReadBytes <= 0 Then Break;
        SHA256Update(Ctx, Buf, ReadBytes);
      End;
    Result := SHA256FinalHex(Ctx);
  Finally
    FS.Free;
End;
End;

