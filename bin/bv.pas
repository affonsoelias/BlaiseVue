Function LoadPackageJson(out JsonObj: TJSONObject): Boolean;

Var 
  Parser: TJSONParser;
  Raw: string;
  Data: TJSONData;
Begin
  Result := False;
  JsonObj := Nil;
  If Not FileExists('package.json') Then Exit;
  Raw := ReadFileToString('package.json');
  If Trim(Raw) = '' Then Exit;
  Try
    Parser := TJSONParser.Create(Raw, True);
    Try
      Data := Parser.Parse;
      If (Data <> Nil) And (Data is TJSONObject) Then
        Begin
          JsonObj := TJSONObject(Data);
          Result := True;
        End
      Else If Data <> Nil Then
             Data.Free;
    Finally
      Parser.Free;
End;
Except
  Result := False;
End;
End;

{ Persists a modified TJSONObject configuration back to package.json. }
Procedure SavePackageJson(JsonObj: TJSONObject);

Var 
  Formatted: string;
Begin
  If JsonObj = Nil Then Exit;
  Formatted := JsonObj.FormatJSON;
  WriteStringToFile('package.json', Formatted + #10);
End;




{ Helper to retrieve a string value from a TJSONObject with a fallback default. }
Function GetJsonString(Obj: TJSONObject; Const PropName, DefaultVal: String):


                                                                          string
;

Var 
  Item: TJSONData;
Begin
  Result := DefaultVal;
  If Obj = Nil Then Exit;
  Item := Obj.Find(PropName);
  If (Item <> Nil) And (Item.JSONType = jtString) Then
    Result := Item.AsString;
End;

{ Helper to insert or update a string value in a TJSONObject. }
Procedure SetJsonString(Obj: TJSONObject; Const PropName, Val: String);

Var 
  Idx: Integer;
Begin
  If Obj = Nil Then Exit;
  Idx := Obj.IndexOfName(PropName);
  If Idx >= 0 Then
    Obj.Strings[PropName] := Val
  Else
    Obj.Add(PropName, Val);
End;




{ Generates or updates src/uAppVersion.pas, synchronizing version, author, and license constants. }
