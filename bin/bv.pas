    Begin
      WriteLn('  [-] Deleting binaries in bin/', FolderLabel, '/ ...');
      DeleteDir(BinServerDir);
      DeletedAny := True;
    End;

  If DirectoryExists(DeployServerDir) Then
    Begin
      WriteLn('  [-] Deleting deploy artifacts in deploy/', FolderLabel, '/ ...'
