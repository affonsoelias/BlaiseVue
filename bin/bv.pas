             WriteLn(


'  capacitor remove-version [ver] Interactively removes a cached Capacitor version'
             );
             WriteLn(


            '  capacitor sync             Syncs dist/ with native mobile assets'
             );
             WriteLn(


 '  capacitor remove [-y]      Safely deletes mobile/ and capacitor.config.json'
             );
             WriteLn(


'  capacitor build android    Builds native Android Debug/Release APK in mobile/bin/android/'
             );
             WriteLn(


    '  capacitor emulator list    Lists installed Android Virtual Devices (AVD)'
