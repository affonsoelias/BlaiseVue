  Begin
    WriteLn('[ERROR] Frontend production build failed. dist/ folder not found.')
    ;
    Halt(1);
  End;
WriteLn('  [+] Frontend compiled with production hashes in dist/');
WriteLn('');

// 2. Build Zephyr native backend in RELEASE mode
