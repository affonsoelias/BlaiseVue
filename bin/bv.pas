Function ToPascalCase(Const S: String): string;

Var 
  i: Integer;
  NextUpper: Boolean;
  C: Char;
Begin
  Result := '';
  NextUpper := True;
  For i := 1 To Length(S) Do
    Begin
      C := S[i];
      If (C = '-') Or (C = '_') Or (C = ' ') Or (C = '.') Then
        NextUpper := True
      Else
        Begin
          If NextUpper Then
            Begin
              Result := Result + UpCase(C);
              NextUpper := False;
            End
          Else
            Result := Result + C;
        End;
    End;
  If (Copy(Result, 1, 2) = 'Bv') And (Length(Result) > 2) And (Result[3] >= 'A')
     And (Result[3] <= 'Z') Then
    Result := 'BV' + Copy(Result, 3, MaxInt);
  If Result = '' Then Result := 'CustomComponent';
End;

{ Converts arbitrary text into a lowercase kebab-case slug. }
Function ToKebabCase(Const S: String): string;

Var 
  i: Integer;
  C: Char;
Begin
  Result := '';
  For i := 1 To Length(S) Do
    Begin
      C := S[i];
      If (C >= 'A') And (C <= 'Z') Then
        Begin
          If (i > 1) And (Result[Length(Result)] <> '-') Then
            Result := Result + '-';
          Result := Result + LowerCase(C);
        End
      Else If (C = '_') Or (C = ' ') Or (C = '.') Then
             Begin
               If (Result <> '') And (Result[Length(Result)] <> '-') Then
                 Result := Result + '-';
             End
      Else
        Result := Result + C;
    End;
  If Result = '' Then Result := 'custom-component';
End;

{ Scaffolds a dedicated external component library project }
Procedure CmdCreateLib(Const LibName: String; Const SelectedLicense: String);

Var 
  Base, PascalName, KebabName, TagName: string;
  LicenseId, LicenseTitle, LicenseBody, InputChoice: string;
  NormalizedLic: string;
  PkgJson, BvComp, PasUnit, CssStyle, DemoHtml, DemoApp, UnitTest, Readme:


                                                                          string
  ;
Begin
  If IsReservedCorePackageName(LibName) Then
    Begin
      WriteLn('ERROR: Cannot create library with reserved name "' + LibName +
              '".');
      WriteLn(


'Names starting with "blaise-" and core names (ui, themes, icons, charts, reports, studio, mobile, core, sdk, tools) are reserved for official BlaiseVue framework components.'
      );
      WriteLn('Please choose another name (e.g. "my-' + LibName + '").');
      Halt(1);
    End;

  Base := GetCurrentDir + DirectorySeparator + LibName + DirectorySeparator;
  If DirectoryExists(Base) Then
    Begin
      WriteLn('ERROR: Folder "', LibName, '" already exists.');
      Halt(1);
    End;

  NormalizedLic := LowerCase(Trim(SelectedLicense));
  If NormalizedLic <> '' Then
    Begin
      If (NormalizedLic = 'mit') Then
        Begin
          LicenseId := 'MIT';
          LicenseTitle := 'MIT License';
        End
      Else If (NormalizedLic = 'apache') Or (NormalizedLic = 'apache-2.0') Or (
              NormalizedLic = 'apache2') Then
             Begin
               LicenseId := 'Apache-2.0';
               LicenseTitle := 'Apache License 2.0';
             End
      Else If (NormalizedLic = 'lgpl') Or (NormalizedLic = 'lgpl-3.0') Or (
              NormalizedLic = 'lgpl3') Then
             Begin
               LicenseId := 'LGPL-3.0';
               LicenseTitle := 'GNU Lesser General Public License v3.0';
             End
      Else If (NormalizedLic = 'commercial') Or (NormalizedLic = 'proprietary')
             Then
             Begin
               LicenseId := 'Commercial';
               LicenseTitle := 'Commercial / Proprietary License';
             End
      Else If (NormalizedLic = 'none') Or (NormalizedLic = 'unlicensed') Or (
              NormalizedLic = 'unlicense') Then
             Begin
               LicenseId := 'UNLICENSED';
               LicenseTitle := 'None (Unlicensed)';
             End
      Else
        Begin
          LicenseId := 'MIT';
          LicenseTitle := 'MIT License';
        End;
    End
  Else
    Begin
      WriteLn('');
      WriteLn('Select license for library "' + LibName + '":');
      WriteLn(


         '  1) MIT (Permissive, recommended for open-source community packages)'
      );
      WriteLn('  2) Apache 2.0 (Permissive with patent grant protection)');
      WriteLn('  3) GNU LGPL v3 (Traditional Pascal library copyleft standard)')
      ;
      WriteLn('  4) Commercial / Proprietary (All rights reserved)');
      WriteLn('  5) None');
      Write('Enter choice [1-5] (default 1): ');
      InputChoice := '';
      Try
        ReadLn(InputChoice);
      Except
        InputChoice := '1';
    End;
  InputChoice := Trim(InputChoice);
  If (InputChoice = '1') Or (InputChoice = '') Then
    Begin
      LicenseId := 'MIT';
      LicenseTitle := 'MIT License';
    End
  Else If InputChoice = '2' Then
         Begin
           LicenseId := 'Apache-2.0';
           LicenseTitle := 'Apache License 2.0';
         End
  Else If InputChoice = '3' Then
         Begin
           LicenseId := 'LGPL-3.0';
           LicenseTitle := 'GNU Lesser General Public License v3.0';
         End
  Else If InputChoice = '4' Then
         Begin
           LicenseId := 'Commercial';
           LicenseTitle := 'Commercial / Proprietary License';
         End
  Else If InputChoice = '5' Then
         Begin
           LicenseId := 'UNLICENSED';
