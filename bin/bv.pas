{ Resolves a pas2js:<pkg> or <pkg> name to its compiled unit source directory }
Function ResolvePas2JSPackagePath(Const PkgName: String; out ResolvedPath:
                                  String): Boolean;

Var 
  CleanName, BaseDir, Cand: string;
Begin
  Result := False;
  ResolvedPath := '';
  CleanName := Trim(PkgName);
  If StartsText('pas2js:', CleanName) Then
    CleanName := Copy(CleanName, 8, Length(CleanName) - 7);

  BaseDir := GetPas2JSPackagesRoot + CleanName;
  If DirectoryExists(BaseDir) Then
    Begin
      Cand := BaseDir + DirectorySeparator + 'src';
      If DirectoryExists(Cand) Then
        ResolvedPath := Cand
      Else
        ResolvedPath := BaseDir;
      Result := True;
    End;
End;




{ Scans packages/ and returns a sorted stringlist of all available Pas2JS packages }
Function ListAvailablePas2JSPackages: TStringList;

Var 
  SR: TSearchRec;
  PkgRoot: string;
Begin
  Result := TStringList.Create;
  PkgRoot := GetPas2JSPackagesRoot;
  If DirectoryExists(PkgRoot) And (FindFirst(PkgRoot + '*', faDirectory, SR) = 0
     ) Then
    Begin
      Repeat
        If (SR.Name <> '.') And (SR.Name <> '..') And ((SR.Attr And faDirectory)
           <> 0) Then
          Begin
            Result.Add(SR.Name);
          End;
      Until FindNext(SR) <> 0;
      FindClose(SR);
    End;
  Result.Sort;
End;

{ Returns the filesystem path to the compiled Pas2JS runtime library (rtl.js). }
Function GetRTLPath: string;

Var 
  Base, SDK, OSFolder: string;
Begin
  SDK := GetSDKPath;
  Base := GetPas2JSRoot;

  {$IFDEF WINDOWS}

  OSFolder := 'pas2js-win64-x86_64-3.2.0';

  {$ELSE}

    {$IFDEF LINUX}

  OSFolder := 'pas2js-linux-x86_64-3.2.0';

    {$ELSE}

  OSFolder := 'pas2js-darwin-x86_64-3.2.0';

    {$ENDIF}

  {$ENDIF}



  // 1. Prioritize the platform-specific RTL bundled with the transpiler

  If FileExists(Base + OSFolder + DirectorySeparator + 'packages' +
     DirectorySeparator + 'rtl' + DirectorySeparator + 'src' +
     DirectorySeparator + 'rtl.js') Then
    Exit(Base + OSFolder + DirectorySeparator + 'packages' + DirectorySeparator
         + 'rtl' + DirectorySeparator + 'src' + DirectorySeparator + 'rtl.js');



  // 2. Fallback to the Pas2JS bin folder

  If FileExists(Base + OSFolder + DirectorySeparator + 'bin' +
     DirectorySeparator + 'rtl.js') Then
    Exit(Base + OSFolder + DirectorySeparator + 'bin' + DirectorySeparator +
         'rtl.js');






// 3. Last fallback: check the SDK root if a standalone version was placed there

  If FileExists(SDK + 'rtl.js') Then Exit(SDK + 'rtl.js');
  Result := '';
End;

{ Checks whether a system command/executable is available on the PATH }

Function HasCommand(Const ACmd: String): Boolean;

Var 
  OutStr: string;
Begin
  OutStr := '';

  {$IFDEF WINDOWS}

  Result := RunCommand('cmd.exe', ['/c', 'where ' + ACmd], OutStr);
  If Not Result Then
    Result := RunCommand('cmd.exe', ['/c', ACmd + ' --version'], OutStr);

  {$ELSE}

  Result := RunCommand('which', [ACmd], OutStr);
  If Not Result Then
    Result := RunCommand(ACmd, ['--version'], OutStr);

  {$ENDIF}
End;

