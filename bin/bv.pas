                     'var' + #10 +

                     '  Wrapper: TWrapper;' + #10#10 +

                     'begin' + #10 +

                     '  Register_u' + NormName + ';' + #10#10 +

                     '  Describe(''View: ' + NormName + ''', procedure' + #10 +

                     '    begin' + #10 +




       '       It(''deve inicializar a view e renderizar sem erros'', procedure'
