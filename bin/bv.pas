If DirectoryExists(DeployDir) Then DeleteDir(DeployDir);
ForceDir(DeployDir);
ForceDir(DeployDir + DirectorySeparator + 'dist');

BinName := ExtractFileName(OutBin);
CopyFile(OutBin, DeployDir + DirectorySeparator + BinName);
CopyDir(DistDir, DeployDir + DirectorySeparator + 'dist', []);
