             );
             WriteLn(


                  '  reset [--bare] [--force]   Resets project to a clean slate'
             );
             WriteLn('');
             WriteLn('  # === Compiler (Pas2JS) ===');
             WriteLn(


'  pas2js versions            Lists active, bundled and user Pas2JS compiler versions'
             );
