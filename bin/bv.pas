             CmdWasm(LowerCase(ParamStr(2)));
         End

  Else If (Cmd = 'tool') Or (Cmd = 'tools') Or (Cmd = 'vsix') Then
         Begin
           If Cmd = 'vsix' Then
             CmdTool('pack', 'blaise-vscode')

           Else If ParamCount >= 4 Then
                  CmdTool(LowerCase(ParamStr(2)), ParamStr(3), ParamStr(4))

           Else If ParamCount >= 3 Then
                  CmdTool(LowerCase(ParamStr(2)), ParamStr(3))

           Else If ParamCount >= 2 Then
                  CmdTool(LowerCase(ParamStr(2)))

           Else
             CmdTool('list');
         End

  Else If (Cmd = 'capacitor') Or (Cmd = 'mobile') Then
         Begin
           If ParamCount < 2 Then
             Begin
               WriteLn(


'Usage: bv capacitor <init [name] [id] [--version=<v>]|upgrade [--check]|versions|remove-version|sync [target]|build [target] [--release]|run [target] [--emulator [name]]|open [target]|emulator <list|start|run>>'
               );
               WriteLn('       Targets: android | ios | all (default: android)')
               ;
               WriteLn(


 '       Note: "bv mobile" is supported as an alias for all capacitor commands.'
               );
               Halt(1);
             End;

           If Cmd = 'mobile' Then
             CmdMobile(LowerCase(ParamStr(2)), ParamStr(3), ParamStr(4))
           Else
             CmdCapacitor(LowerCase(ParamStr(2)), ParamStr(3), ParamStr(4));
         End

  Else If Cmd = 'desktop' Then
         Begin
           If ParamCount < 2 Then
             Begin
               WriteLn(


'Usage: bv desktop <init [name]|sync|build [target] [--release]|run [target] [--release]>'
               );
               WriteLn(


              '       Targets: windows | linux | macos | all (default: host OS)'
               );
               Halt(1);
             End;

           CmdDesktop(LowerCase(ParamStr(2)), ParamStr(3), ParamStr(4));
         End

  Else If Cmd = 'studio' Then
         Begin
           CmdStudio;
         End

  Else If Cmd = 'clear' Then
         Begin
           ClearScreen(False);
         End

  Else If Cmd = 'files' Then
         Begin
           If (ParamCount >= 2) And ((LowerCase(ParamStr(2)) = '--all') Or (
              LowerCase(ParamStr(2)) = '-a')) Then
             CmdFiles('', True)
           Else If (ParamCount >= 3) And ((LowerCase(ParamStr(3)) = '--all') Or
                   (LowerCase(ParamStr(3)) = '-a')) Then
                  CmdFiles(ParamStr(2), True)
           Else If ParamCount >= 2 Then
                  CmdFiles(ParamStr(2), False)
           Else
             CmdFiles('', False);
         End

  Else If Cmd = 'zephyr' Then
         Begin
           If ParamCount < 2 Then
             Begin
               WriteLn(


'Usage: bv zephyr <init|build [--target=c|pascal] [--release|--debug]|run [--port <p>]|deploy [--zip] [--port <p>]|status|remove [-y]>'
               );
               Halt(1);
             End;
           CmdZephyr(LowerCase(ParamStr(2)), ParamStr(3), ParamStr(4));
         End

  Else If Cmd = 'mormot' Then
         Begin
           If ParamCount < 2 Then
             Begin
               WriteLn(


'Usage: bv mormot <init|build [--release]|run [--release] [--port <p>]|status [--port <p>]|deploy [--zip] [--port <p>]|crud <Model> [field:type...]|auth|docs|docker|remove [-y]>'
               );
               Halt(1);
             End;

           CmdServer(LowerCase(ParamStr(2)), ParamStr(3), ParamStr(4));
         End

  Else If (Cmd = 'framework') Or (Cmd = 'fw') Then
         Begin
           If ParamCount < 2 Then
             Begin
               WriteLn(
'Usage: bv framework <versions|upgrade [--version=<v>]|use <v|channel>|remove-version [v] [-y]>'
               );
               Halt(1);
             End;
           CmdFramework(LowerCase(ParamStr(2)), ParamStr(3), ParamStr(4));
         End

  Else If (Cmd = 'pas2js') Or (Cmd = 'compiler') Then
         Begin
           If ParamCount < 2 Then
             Begin
               WriteLn(


'Usage: bv pas2js <versions|upgrade [--version=<v>]|use <v|bundled>|remove-version [v] [-y]>'
               );
               Halt(1);
             End;
           CmdPas2js(LowerCase(ParamStr(2)), ParamStr(3), ParamStr(4));
         End

  Else If (Cmd = 'versions') Or (Cmd = 'sdk') Or (Cmd = 'sdks') Then
         Begin
           If (ParamCount >= 2) And ((LowerCase(ParamStr(2)) = 'clean') Or (
              LowerCase(ParamStr(2)) = 'prune') Or (LowerCase(ParamStr(2)) =
              'remove') Or (LowerCase(ParamStr(2)) = 'rm')) Then
             CmdGlobalVersionsClean(ParamStr(3))
           Else
             CmdGlobalVersions;
         End

  Else If (Cmd = 'format') Or (Cmd = 'fmt') Then
         Begin
           CmdFormat(ParamStr(2), (LowerCase(ParamStr(2)) = '--check') or (


                                                                       LowerCase
                                                                           (


                                                                        ParamStr
                                                                           (3)) 
                                                            = '--check'));
         End

  Else If Cmd = 'license' Then
         Begin
           CmdLicense;
         End

  Else If Cmd = 'meta' Then
         Begin
           CmdMeta;
         End

  Else If (Cmd = 'path') Or (Cmd = 'paths') Or (Cmd = 'unit-path') Then
         Begin
           CmdPath;
         End
  Else If (Cmd = 'lazarus') Or (Cmd = 'laz') Or (Cmd = 'lpi') Then
         Begin
           CmdLazarus;
         End
  Else If Cmd = 'reset' Then
         Begin
           CmdReset;
         End
  Else If (Cmd = 'update') Or (Cmd = 'upgrade') Then
         Begin
           CmdUpdate;
         End
  Else If (Cmd = 'doctor') Or (Cmd = 'doc-env') Then
         Begin
           CmdDoctor;
         End
  Else If (Cmd = 'self-update') Or (Cmd = 'selfupdate') Or (Cmd = 'upgrade-cli')
         Then
         Begin
           CmdSelfUpdate;
         End
  Else If (Cmd = 'channel') Or (Cmd = 'branch') Then
         Begin
           CmdChannel;
         End
  Else If (Cmd = 'rollback') Or (Cmd = 'revert-cli') Then
         Begin
           CmdRollback;
         End
  Else If Cmd = 'enter' Then
         Begin
           CmdEnter;
         End
  Else If Cmd = 'use' Then
         Begin
           If ParamCount < 2 Then
             Begin
               WriteLn('Usage: bv use <project-name>');
               WriteLn(


 'Switches to a registered BlaiseVue project and opens the interactive cockpit.'
               );
               WriteLn('Run "bv project list" to see registered projects.');
               Halt(1);
             End;
           CmdUse(ParamStr(2));
         End
  Else If (Cmd = 'project') Or (Cmd = 'p') Then
         Begin
           CmdProject;
         End
  Else If (Cmd = 'repo') Or (Cmd = 'repository') Then
         Begin
           CmdRepo;
         End
  Else If (Cmd = 'rename') Or (Cmd = 'ren') Or (Cmd = 'mv') Then
         Begin
           If ParamCount < 3 Then
             Begin
               WriteLn(


                'Usage: bv rename <c|v|s|store|fsm|project> <OldName> [NewName]'
               );
               WriteLn(


          'Types: component (c), view (v), service (s), store, fsm, project (p)'
               );
               WriteLn('Examples:');
               WriteLn('  bv rename s CalculadoraFrete CalculoLogistica');
               WriteLn('  bv rename c ProductCard ItemCard');
               WriteLn('  bv rename v OrderHistory MyOrders');
               WriteLn('  bv rename store Cart ShoppingCart');
               WriteLn('  bv rename fsm OrderFlow CheckoutFlow');
               WriteLn('  bv rename project meu-novo-app');
               Halt(1);
             End;
           TypeArg := LowerCase(ParamStr(2));
           If (TypeArg = 'p') Or (TypeArg = 'project') Or (TypeArg = 'proj')
             Then
             Begin
               CmdRenameProject(ParamStr(3), DummyRenamed);
             End
           Else
             Begin
               If ParamCount < 4 Then
                 Begin
                   WriteLn(


                        'Usage: bv rename <c|v|s|store|fsm> <OldName> <NewName>'
                   );
                   Halt(1);
                 End;
               NameArg := ParamStr(3);
               If (TypeArg = 's') Or (TypeArg = 'service') Or (TypeArg = 'unit')
                 Then
                 CmdRenameService(NameArg, ParamStr(4))
               Else If (TypeArg = 'c') Or (TypeArg = 'comp') Or (TypeArg =
                       'component') Then
                      CmdRenameComponent(NameArg, ParamStr(4))
               Else If (TypeArg = 'v') Or (TypeArg = 'view') Then
                      CmdRenameView(NameArg, ParamStr(4))
               Else If (TypeArg = 'store') Or (TypeArg = 'stores') Then
                      CmdRenameStore(NameArg, ParamStr(4))
               Else If (TypeArg = 'fsm') Or (TypeArg = 'fsms') Or (TypeArg =
                       'machine') Or (TypeArg = 'machines') Then
                      CmdRenameFSM(NameArg, ParamStr(4))
               Else
                 Begin
                   WriteLn('Unknown type: ', ParamStr(2),


'. Use "service" (s), "component" (c), "view" (v), "store", "fsm" or "project" (p).'
                   );
                   Halt(1);
                 End;
             End;
         End
  Else
    Begin
      If TryDispatchExternalTool(Cmd, 2) Then
        Halt(0);

      WriteLn('Unknown command: ', Cmd);
      WriteLn('Use "bv" without arguments for help.');
      Halt(1);
    End;
End.
