{ Registers a new CRUD model in the server models unit. }
Procedure UpdateServerModels(Const ModelsFile, ModelName: String; Const Fields:
                             TCrudFieldArray);

Var 
  Content, NewRecord: string;
  PosImpl: Integer;
  i: Integer;
Begin
  If Not FileExists(ModelsFile) Then Exit;
  Content := ReadFileToString(ModelsFile);
  If Pos('T' + ModelName + ' = record', Content) > 0 Then
    Begin
      WriteLn('  [-] T' + ModelName +
              ' is already declared in server/ServerModels.pas (skipping)');
      Exit;
    End;

  NewRecord := '';
  For i := 0 To High(Fields) Do
    Begin
      If (Fields[i].Kind = cfkDetail) And (Fields[i].TargetModel <> '') And
         (Pos('T' + Fields[i].TargetModel + ' = record', Content) = 0) Then
        Begin
          NewRecord := NewRecord +
                       '  { Shared ' + Fields[i].TargetModel +
                       ' Record (Relational Master-Detail Child) }' + #13#10 +
                       '  T' + Fields[i].TargetModel + ' = record' + #13#10 +
                       '    ID: Integer;' + #13#10 +
                       '    ' + ModelName + 'ID: Integer;' + #13#10 +
                       '    Description: RawUtf8;' + #13#10 +
                       '    Quantity: Integer;' + #13#10 +
                       '    UnitPrice: Double;' + #13#10 +
                       '    Total: Double;' + #13#10 +
                       '    CreatedAt: RawUtf8;' + #13#10 +
                       '  end;' + #13#10 +
                       '  T' + Fields[i].TargetModel + 'DynArray = array of T' +
                       Fields[i].TargetModel + ';' + #13#10#13#10;
          WriteLn('  [+] Auto-scaffolded relational child record T' + Fields[i].
                  TargetModel + ' in server/ServerModels.pas');
        End;
    End;

  NewRecord := NewRecord +
               '  { Shared ' + ModelName + ' Record }' + #13#10 +

               '  T' + ModelName + ' = record' + #13#10 +

               '    ID: Integer;' + #13#10;

  For i := 0 To High(Fields) Do
    NewRecord := NewRecord + '    ' + Fields[i].PascalName + ': ' + Fields[i].
                 PascalType + ';' + #13#10;

  NewRecord := NewRecord +

               '    CreatedAt: RawUtf8;' + #13#10 +

               '  end;' + #13#10 +

               '  T' + ModelName + 'DynArray = array of T' + ModelName + ';' + #13#10#13#10;

  PosImpl := Pos('implementation', Content);
  If PosImpl > 0 Then
    Content := Copy(Content, 1, PosImpl - 1) + NewRecord + Copy(Content, PosImpl
               , MaxInt)

  Else
    Content := Content + #13#10 + NewRecord;

  WriteStringToFile(ModelsFile, Content);
  WriteLn('  [+] Registered T' + ModelName +
          ' record & DTO in server/ServerModels.pas');
End;




{ Registers REST endpoints and ORM collections in the mORMot 2 server application. }
Procedure UpdateServerApp(Const ServerAppFile, ModelName, PluralName: String);

Var 
  Content: string;
  PosMarker: Integer;
  CrudUnit, PluralLower: string;
Begin
  If Not FileExists(ServerAppFile) Then Exit;
  Content := ReadFileToString(ServerAppFile);
  CrudUnit := 'Crud' + ModelName;
  PluralLower := LowerCase(PluralName);

  // 1. In uses: add Crud<ModelName>

  If Pos(CrudUnit, Content) = 0 Then
    Begin
      If Pos('ServerModels;', Content) > 0 Then
        Content := StringReplace(Content, 'ServerModels;', 'ServerModels, ' +
                   CrudUnit + ';', [])

      Else If Pos('ServerModels,', Content) > 0 Then
             Content := StringReplace(Content, 'ServerModels,', 'ServerModels, '
                        + CrudUnit + ',', []);
    End;

  // 2. In private fields: add FCrud<ModelName>

  If Pos('FCrud' + ModelName + ':', Content) = 0 Then
    Begin
      PosMarker := Pos('FItems: TBlaiseItemDynArray;', Content);
      If PosMarker > 0 Then
        Begin
          Insert('    FCrud' + ModelName + ': TCrud' + ModelName + 'Service;' +
                 #13#10,

                 Content, PosMarker + Length('FItems: TBlaiseItemDynArray;' + #13#10));
        End;
    End;

  // 3. In constructor Create: instantiate FCrud<ModelName>

  If Pos('FCrud' + ModelName + ' :=', Content) = 0 Then
    Begin
      PosMarker := Pos('FServer := TWebSocketServer.Create', Content);
      If PosMarker > 0 Then
        Begin
          Insert('  FCrud' + ModelName + ' := TCrud' + ModelName +
                 'Service.Create;' + #13#10 +

                 '  FCrud' + ModelName + '.OnBroadcast := BroadcastEvent;' + #13#10 + '  ',

                 Content, PosMarker);
        End;
    End;

  // 4. In destructor Destroy: free FCrud<ModelName>

  If Pos('FCrud' + ModelName + '.Free;', Content) = 0 Then
    Begin
      PosMarker := Pos('FServer.Free;', Content);
      If PosMarker > 0 Then
        Begin
          Insert('  FCrud' + ModelName + '.Free;' + #13#10 + '  ', Content,
                 PosMarker);
        End;
    End;

  // 5. In DoRequest: handle REST routing

  If Pos('FCrud' + ModelName + '.HandleRequest', Content) = 0 Then
    Begin
      PosMarker := Pos('// 5. Static File Server', Content);
      If PosMarker > 0 Then
        Begin
          Insert('  // ' + ModelName + ' CRUD REST API: /api/' + PluralLower + #13#10 +

                 '  if FCrud' + ModelName +
                 '.HandleRequest(Ctxt, CleanUrl, Result) then' + #13#10 +

                 '    Exit;' + #13#10#13#10,

                 Content, PosMarker);
        End;
    End;

  WriteStringToFile(ServerAppFile, Content);
  WriteLn('  [+] Integrated TCrud' + ModelName +
          'Service into server/ServerApp.pas');
End;

{ Injects routes for a newly scaffolded CRUD view into src/App.pas. }
Procedure UpdateAppRoutes(Const AppFile, ModelName, PluralName: String);

Const 

  Q = #39;

Var 
  Content, RouteLine, NavLine, DrawerLine: string;
  PluralLower, KebabName: string;
  PosMarker: Integer;
Begin
  If Not FileExists(AppFile) Then Exit;
  Content := ReadFileToString(AppFile);
  PluralLower := LowerCase(PluralName);
  KebabName := PascalToKebab(ModelName + 'View');

  // 1. Add route in router: routes:

  RouteLine := Q + '/' + PluralLower + Q + ': ' + Q + KebabName + '-page' + Q +
               ';';
  If Pos(Q + '/' + PluralLower + Q, Content) = 0 Then
    Begin
      PosMarker := Pos('routes:', Content);
      If PosMarker > 0 Then
        Begin
          Insert(#13#10 + '      ' + RouteLine, Content, PosMarker + Length(
                 'routes:'));
        End;
    End;

  // 2. Add link to navbar <div class="nav-links">

  NavLine := '<a href="#/' + PluralLower + '">📦 ' + PluralName + '</a>';
  If Pos('href="#/' + PluralLower + '"', Content) = 0 Then
    Begin
      PosMarker := Pos('<div class="nav-links">', Content);
      If PosMarker > 0 Then
        Begin
          Insert(#13#10 + '        ' + NavLine, Content, PosMarker + Length(
                 '<div class="nav-links">'));
        End;
    End;

  // 3. Add link to drawer <div class="drawer-nav"> if drawer exists

  DrawerLine := '<a href="#/' + PluralLower +
                '" class="drawer-link" @click="closeDrawer">📦 ' + PluralName
                + '</a>';
  If (Pos('<div class="drawer-nav">', Content) > 0) And (Pos('href="#/' +
     PluralLower + '" class="drawer-link"', Content) = 0) Then
    Begin
      PosMarker := Pos('<div class="drawer-nav">', Content);
      Insert(#13#10 + '        ' + DrawerLine, Content, PosMarker + Length(
             '<div class="drawer-nav">'));
    End;

  WriteStringToFile(AppFile, Content);
  WriteLn('  [+] Registered route /' + PluralLower +
          ' & navigation in src/app.bv');
End;




{ Generates complete full-stack master-detail CRUD models with ORM persistence (bv mormot crud). }
Procedure CmdMormotCrud(Const ProjectRoot: String);

Var 
  ServerDir, ModelsFile, ServerAppFile, CrudFile, ViewsDir, ViewFile, AppFile:


                                                                          string
  ;
  ModelName, PluralName: string;
  Fields: TCrudFieldArray;
  FieldCount: Integer;
  i: Integer;
  Spec: string;
Begin
  If (ParamCount < 3) Or (Trim(ParamStr(3)) = '') Or (ParamStr(3) = '--help') Or
     (ParamStr(3) = '-h') Then
    Begin
      WriteLn('');
      WriteLn('  BlaiseVue Full-Stack CRUD & ORM Generator (bv mormot crud)');
      WriteLn('  ==========================================================');
      WriteLn('  Usage:');
      WriteLn('    bv mormot crud <ModelName> [field:type...]');
      WriteLn('');
      WriteLn('  Arguments:');
      WriteLn(


'    <ModelName>     Pascal model name in PascalCase (e.g. Product, Customer, Order)'
      );
      WriteLn('    [field:type...] Field definitions in name:type format');
      WriteLn('');
      WriteLn('  Supported Field Types:');
      WriteLn(


        '    string          Text / RawUtf8 (e.g. name:string, category:string)'
      );
      WriteLn(


          '    integer         Whole numbers (e.g. stock:integer, quantity:int)'
      );
      WriteLn(


'    currency        Floating point / decimal (e.g. price:currency, total:double)'
      );
      WriteLn(


          '    boolean         Boolean flag (e.g. active:boolean, enabled:bool)'
      );
      WriteLn(


       '    date            ISO Date string (e.g. dueDate:date, createdAt:date)'
      );
      WriteLn(


     '    FK(Model)       Foreign key relationship (e.g. customer:FK(Customer))'
      );
      WriteLn(


'    Detail(Model)   Master-detail relational collection (e.g. items:Detail(OrderItem))'
      );
      WriteLn('');
      WriteLn('  Examples:');
      WriteLn(


'    bv mormot crud Product name:string price:currency stock:integer category:string'
      );
      WriteLn(


'    bv mormot crud Customer name:string email:string phone:string active:boolean'
      );
      WriteLn(


'    bv mormot crud Task title:string priority:integer done:boolean dueDate:date'
      );
      WriteLn(


'    bv mormot crud Order customer:FK(Customer) total:currency items:Detail(OrderItem)'
      );
      WriteLn('');
      Halt(0);
    End;

  ModelName := CapitalizeWord(Trim(ParamStr(3)));
  PluralName := Pluralize(ModelName);

  // Parse field definitions

  FieldCount := 0;
  SetLength(Fields, 0);
  For i := 4 To ParamCount Do
    Begin
      Spec := Trim(ParamStr(i));
      If Spec = '' Then Continue;
      If (Copy(Spec, 1, 2) = '--') Or (Copy(Spec, 1, 1) = '-') Then Continue;

      // Skip if field is id (id is always primary key)

      If (LowerCase(Spec) = 'id') Or (LowerCase(Spec) = 'id:int') Or (LowerCase(
         Spec) = 'id:integer') Then
        Continue;

      Inc(FieldCount);
      SetLength(Fields, FieldCount);
      Fields[FieldCount - 1] := ParseCrudField(Spec, FieldCount - 1, ModelName);
    End;

  // If no fields provided, supply standard defaults

  If FieldCount = 0 Then
    Begin
      SetLength(Fields, 4);
      Fields[0] := ParseCrudField('name:string', 0, ModelName);
      Fields[1] := ParseCrudField('category:string', 1, ModelName);
      Fields[2] := ParseCrudField('price:currency', 2, ModelName);
      Fields[3] := ParseCrudField('active:boolean', 3, ModelName);
      FieldCount := 4;
    End;

  WriteLn('');
  WriteLn(


        '======================================================================'
  );
  WriteLn('  BlaiseVue Full-Stack CRUD & ORM Generator: ' + ModelName);
  WriteLn(


        '======================================================================'
  );
  WriteLn('  Model:    ' + ModelName + ' (T' + ModelName + ')');
  WriteLn('  Plural:   ' + PluralName + ' (/api/' + LowerCase(PluralName) + ')')
  ;
  WriteLn('  Fields:   ' + IntToStr(FieldCount) + ' field(s)');
  For i := 0 To High(Fields) Do
    WriteLn('    - ' + Fields[i].Name + ': ' + Fields[i].PascalType + ' (' +
            Fields[i].BvType + ')');

  WriteLn(


        '----------------------------------------------------------------------'
  );
  ServerDir := ResolveMormotServerDir(ProjectRoot, False);
  ModelsFile := ServerDir + DirectorySeparator + 'ServerModels.pas';
  ServerAppFile := ServerDir + DirectorySeparator + 'ServerApp.pas';
  CrudFile := ServerDir + DirectorySeparator + 'Crud' + ModelName + '.pas';
  ViewsDir := ProjectRoot + DirectorySeparator + 'src' + DirectorySeparator +
              'views';
  ViewFile := ViewsDir + DirectorySeparator + ModelName + 'View.bv';
  AppFile := ProjectRoot + DirectorySeparator + 'src' + DirectorySeparator +
             'app.bv';

  // 1. Ensure mORMot server directory exists

  WriteLn('[1/5] Checking mORMot 2 backend server in ', ExtractFileName(
          ExcludeTrailingPathDelimiter(ServerDir)), '/...');
  If Not DirectoryExists(ServerDir) Or Not FileExists(ModelsFile) Or Not
     FileExists(ServerAppFile) Then
    Begin
      WriteLn('  [!] ', ExtractFileName(ExcludeTrailingPathDelimiter(ServerDir))
      , '/ not found. Initializing backend scaffolding first...');
      CmdServer('init');
    End

  Else
    WriteLn('  [+] Backend server project found in ', ExtractFileName(
            ExcludeTrailingPathDelimiter(ServerDir)), '/');

  // 2. Update ServerModels.pas

  WriteLn('[2/5] Registering T' + ModelName +
          ' record & DTO in server/ServerModels.pas...');
  UpdateServerModels(ModelsFile, ModelName, Fields);

  // 3. Generate Crud<ModelName>.pas

  WriteLn(


         '[3/5] Generating high-throughput mORMot 2 CRUD service in server/Crud'
          + ModelName + '.pas...');
  WriteStringToFile(CrudFile, GenerateCrudPascalUnit(ModelName, PluralName,
                    Fields));
  WriteLn('  [+] Created server/Crud' + ModelName + '.pas');

  // 4. Update ServerApp.pas

  WriteLn('[4/5] Wiring Crud' + ModelName +
          ' endpoints and WebSockets into server/ServerApp.pas...');
  UpdateServerApp(ServerAppFile, ModelName, PluralName);

  // 5. Generate <ModelName>View.bv & Update app.bv

  WriteLn('[5/5] Generating reactive Single File Component & routes...');
  ForceDir(ViewsDir);
  WriteStringToFile(ViewFile, GenerateCrudBVView(ModelName, PluralName, Fields))
  ;
  WriteLn('  [+] Created src/views/' + ModelName + 'View.bv');
  UpdateAppRoutes(AppFile, ModelName, PluralName);
  WriteLn('');
  WriteLn(


        '======================================================================'
  );
  WriteLn('  [SUCCESS] Full-Stack CRUD for ' + ModelName +
          ' generated successfully!');
  WriteLn(


        '======================================================================'
  );
  WriteLn('');
  WriteLn('Generated Artifacts:');
  WriteLn('  Backend:');
  WriteLn('    - server/ServerModels.pas   : T' + ModelName +
          ' record & DTO contracts');
  WriteLn('    - server/Crud' + ModelName +
          '.pas: High-performance mORMot 2 CRUD service');
  WriteLn('    - server/ServerApp.pas      : Wired /api/' + LowerCase(PluralName
  ) + ' endpoints & WebSockets');
  WriteLn('  Frontend:');
  WriteLn('    - src/views/' + ModelName +
          'View.bv : Reactive CRUD Single File Component');
  WriteLn('    - src/app.bv                   : Registered route "/' + LowerCase
          (PluralName) + '" & nav links');
  WriteLn('');
  WriteLn('Next steps:');
  WriteLn(


 '  1. Compile native server:    bv mormot build (or bv mormot build --release)'
  );
  WriteLn('  2. Compile reactive app:     bv run build (or bv build)');
  WriteLn(


     '  3. Start full-stack server:  bv mormot run (or bv mormot run --release)'
  );
  WriteLn('');
End;




