Procedure ProbeDelSafeBackends(Const DelsafecExe: String; out HasGcc, HasClang:
                               Boolean; out GccVer, ClangVer: String);
Var
  RawOut, LineStr, LowLine, Section, AfterColon, LastTok, SubStr: string;
  Lines: TStringList;
  I, ColonPos, SpPos, ClangPos: Integer;
Begin
  HasGcc := False;
  HasClang := False;
  GccVer := '';
  ClangVer := '';
  If (DelsafecExe = '') Or (Not FileExists(DelsafecExe)) Then Exit;

  ExecProcessCaptureExit(DelsafecExe, ['--doctor'], RawOut);
  If Trim(RawOut) = '' Then Exit;

  Lines := TStringList.Create;
  Try
    Lines.Text := RawOut;
    Section := '';
    For I := 0 To Lines.Count - 1 Do
      Begin
        LineStr := Trim(Lines[I]);
        If LineStr = '' Then Continue;
        LowLine := LowerCase(LineStr);
        If Pos('[ok]', LowLine) = 1 Then
          Begin
            If Pos('c compiler', LowLine) > 0 Then
              Begin
                HasGcc := True;
                Section := 'gcc';
              End
            Else If Pos('clang compiler', LowLine) > 0 Then
              Begin
                HasClang := True;
                Section := 'clang';
              End
            Else
              Section := '';
          End
        Else If LineStr[1] = '[' Then
          Section := ''
        Else If (Section <> '') And (Pos('version', LowLine) = 1) Then
          Begin
            ColonPos := Pos(':', LineStr);
            If ColonPos > 0 Then
              Begin
                AfterColon := Trim(Copy(LineStr, ColonPos + 1, MaxInt));
                If Section = 'gcc' Then
                  Begin
                    LastTok := AfterColon;
                    SpPos := LastDelimiter(' ', AfterColon);
                    If SpPos > 0 Then
                      LastTok := Trim(Copy(AfterColon, SpPos + 1, MaxInt));
                    If (LastTok <> '') And (LastTok[1] >= '0') And (LastTok[1] <= '9') Then
                      GccVer := LastTok
                    Else
                      GccVer := Copy(AfterColon, 1, 24);
                  End
                Else If Section = 'clang' Then
                  Begin
                    ClangPos := Pos('clang version ', LowerCase(AfterColon));
                    If ClangPos > 0 Then
                      Begin
                        SubStr := Trim(Copy(AfterColon, ClangPos + 14, MaxInt));
                        SpPos := Pos(' ', SubStr);
                        If SpPos > 1 Then
                          ClangVer := Copy(SubStr, 1, SpPos - 1)
                        Else
                          ClangVer := SubStr;
                      End
                    Else
                      ClangVer := Copy(AfterColon, 1, 24);
                  End;
              End;
          End;
      End;
  Finally
    Lines.Free;
  End;
End;

Procedure InspectProjectDelSafeUsage(Const ProjRoot: String; out BvDelSafeCount,
                                     DelsModuleCount, DelsTestCount,
                                     ExtraSearchPathsCount: Integer);

  Function ShouldSkipDir(Const DirName: String): Boolean;
  Var
    L: string;
  Begin
    L := LowerCase(DirName);
    Result := (L = '.git') Or (L = 'node_modules') Or (L = 'dist') Or
              (L = 'generated') Or (L = '.blaisevue') Or (L = 'vendor') Or
              (L = 'backup') Or (L = 'bin') Or (L = 'deploy');
  End;

  Procedure ScanTree(Const DirPath: String; Const CountBv, CountDels,
                     CountTestDels: Boolean);
  Var
    SR: TSearchRec;
    D, LowName, Ext, LowText: string;
    IsTestDels: Boolean;
  Begin
    If Not DirectoryExists(DirPath) Then Exit;
    D := IncludeTrailingPathDelimiter(DirPath);
    If FindFirst(D + '*', faAnyFile, SR) = 0 Then
      Begin
        Try
          Repeat
            If (SR.Name <> '.') And (SR.Name <> '..') Then
              Begin
                If (SR.Attr And faDirectory) <> 0 Then
                  Begin
                    If Not ShouldSkipDir(SR.Name) Then
                      ScanTree(D + SR.Name, CountBv, CountDels, CountTestDels);
                  End
                Else
                  Begin
                    LowName := LowerCase(SR.Name);
                    Ext := LowerCase(ExtractFileExt(SR.Name));
                    If CountBv And (Ext = '.bv') Then
                      Begin
                        LowText := LowerCase(ReadFileToString(D + SR.Name));
                        If (Pos('lang="delsafe"', LowText) > 0) Or
                           (Pos('lang=''delsafe''', LowText) > 0) Then
                          Inc(BvDelSafeCount);
                      End
                    Else If Ext = '.dels' Then
                      Begin
                        IsTestDels := (Length(LowName) > 10) And
                                      (Copy(LowName, Length(LowName) - 9, 10) = '.test.dels');
                        If IsTestDels And CountTestDels Then
                          Inc(DelsTestCount)
                        Else If (Not IsTestDels) And CountDels Then
                          Inc(DelsModuleCount);
                      End;
                  End;
              End;
          Until FindNext(SR) <> 0;
        Finally
          FindClose(SR);
        End;
      End;
  End;

Var
  SearchPaths: TStringList;
  DefaultServicesDir, SrcDirLow, PLow: string;
  I: Integer;
Begin
  BvDelSafeCount := 0;
  DelsModuleCount := 0;
  DelsTestCount := 0;
  ExtraSearchPathsCount := 0;
  If ProjRoot = '' Then Exit;

  ScanTree(IncludeTrailingPathDelimiter(ProjRoot) + 'src', True, True, False);
  ScanTree(IncludeTrailingPathDelimiter(ProjRoot) + 'tests', False, False, True);

  SearchPaths := TStringList.Create;
  Try
    ResolveDelSafeSearchPaths(ProjRoot, SearchPaths);
    DefaultServicesDir := LowerCase(ExcludeTrailingPathDelimiter(ExpandFileName(
      IncludeTrailingPathDelimiter(ProjRoot) + 'src' + DirectorySeparator + 'services')));
    SrcDirLow := LowerCase(ExcludeTrailingPathDelimiter(ExpandFileName(
      IncludeTrailingPathDelimiter(ProjRoot) + 'src')));
    For I := 0 To SearchPaths.Count - 1 Do
      Begin
        PLow := LowerCase(ExcludeTrailingPathDelimiter(ExpandFileName(SearchPaths[I])));
        If PLow <> DefaultServicesDir Then
          Inc(ExtraSearchPathsCount);
        If (PLow <> SrcDirLow) And (Pos(SrcDirLow + DirectorySeparator, PLow) <> 1) Then
          ScanTree(SearchPaths[I], False, True, False);
      End;
  Finally
    SearchPaths.Free;
  End;
End;

Procedure PrintDelSafeJsonDiagnostics(Const RawOut, ContextLabel: String);

Var 
  PStart, PEnd, I: Integer;
  JsonSlice, Code, Msg, FFile, Hint: string;
  FLine, FCol: Integer;
  JData: TJSONData;
  Arr: TJSONArray;
  Obj: TJSONObject;
Begin
  PStart := Pos('[', RawOut);
  PEnd := LastDelimiter(']', RawOut);
  If (PStart > 0) And (PEnd > PStart) Then
    Begin
      JsonSlice := Copy(RawOut, PStart, PEnd - PStart + 1);
      Try
        JData := GetJSON(JsonSlice);
        Try
          If (JData <> Nil) And (JData.JSONType = jtArray) Then
            Begin
              Arr := TJSONArray(JData);
              If Arr.Count > 0 Then
                Begin
                  For I := 0 To Arr.Count - 1 Do
                    Begin
                      If Arr.Items[I].JSONType = jtObject Then
                        Begin
                          Obj := TJSONObject(Arr.Items[I]);
                          Code := GetJsonString(Obj, 'code', 'ERR');
                          Msg := GetJsonString(Obj, 'message',
                                 'DelSafe compilation error');
                          FFile := GetJsonString(Obj, 'file', ContextLabel);
                          Hint := GetJsonString(Obj, 'hint', '');
                          FLine := Obj.Get('line', 0);
                          FCol := Obj.Get('col', 0);
                          If FLine = 0 Then
                            Begin
                              PStart := Pos(' at ', Msg);
                              If PStart > 0 Then
                                Begin
                                  JsonSlice := Copy(Msg, PStart + 4, 24);
                                  PEnd := Pos(']:', JsonSlice);
                                  If PEnd > 0 Then JsonSlice := Copy(JsonSlice,
                                                                1, PEnd - 1);
                                  PStart := Pos(':', JsonSlice);
                                  If PStart > 0 Then
                                    Begin
                                      FLine := StrToIntDef(Trim(Copy(JsonSlice,
                                               1, PStart - 1)), 0);
                                      FCol := StrToIntDef(Trim(Copy(JsonSlice,
                                              PStart + 1, 10)), 0);
                                    End;
                                End;
                            End;
                          WriteLn('  [DelSafe ', Code, '] ', FFile, ':', FLine,
                                  ':', FCol, ' - ', Msg);
                          If Hint <> '' Then
                            WriteLn('    Hint: ', Hint);
                        End;
                    End;
                  Exit;
                End;
            End;
        Finally
          If JData <> Nil Then JData.Free;
    End;
Except
  // Fall through to raw output
End;
End;
WriteLn('ERROR: DelSafe compilation failed for ', ContextLabel, ':');
WriteLn(RawOut);
End;

Procedure ScanDirForDels(Const DirPath: String; List: TStringList);

Var 
  SR: TSearchRec;
  D: string;
Begin
  If Not DirectoryExists(DirPath) Then Exit;
  D := IncludeTrailingPathDelimiter(DirPath);
  If FindFirst(D + '*', faAnyFile, SR) = 0 Then
    Begin
      Repeat
        If (SR.Name <> '.') And (SR.Name <> '..') Then
          Begin
            If (SR.Attr And faDirectory) <> 0 Then
              ScanDirForDels(D + SR.Name, List)
            Else If LowerCase(ExtractFileExt(SR.Name)) = '.dels' Then
                   List.Add(D + SR.Name);
          End;
      Until FindNext(SR) <> 0;
      FindClose(SR);
    End;
End;

Procedure ResolveJsonSearchPaths(Const ProjectRoot, LangKey: String; OutPaths:
                                 TStringList; Const IncludeDefaultServices:
                                 Boolean);

Procedure AddIfDirExists(Const RawDir: String);

Var 
  D, Norm: string;
  I: Integer;
  Dup: Boolean;
Begin
  D := Trim(RawDir);
  If D = '' Then Exit;
  D := StringReplace(D, '/', DirectorySeparator, [rfReplaceAll]);
  D := StringReplace(D, '\', DirectorySeparator, [rfReplaceAll]);
  If (Length(D) >= 2) And (D[2] = ':') Then
    Norm := ExcludeTrailingPathDelimiter(D)
  Else If (Length(D) >= 1) And (D[1] = DirectorySeparator) Then
         Norm := ExcludeTrailingPathDelimiter(D)
  Else
    Norm := ExcludeTrailingPathDelimiter(ExpandFileName(
            IncludeTrailingPathDelimiter(ProjectRoot) + D));
  If Not DirectoryExists(Norm) Then Exit;
  Dup := False;
  For I := 0 To OutPaths.Count - 1 Do
    If LowerCase(OutPaths[I]) = LowerCase(Norm) Then
      Begin
        Dup := True;
        Break;
      End;
  If Not Dup Then OutPaths.Add(Norm);
End;

Procedure ReadLangPathsFromJson(Const JsonPath: String; Const NestedKey:
                                String);

Var 
  RawJson: string;
  JData: TJSONData;
  RootObj, CurObj, PathsObj: TJSONObject;
  Arr: TJSONArray;
  I: Integer;
Begin
  If Not FileExists(JsonPath) Then Exit;
  Try
    RawJson := ReadFileToString(JsonPath);
    If RawJson = '' Then Exit;
    JData := GetJSON(RawJson);
    Try
      If (JData <> Nil) And (JData.JSONType = jtObject) Then
        Begin
          RootObj := TJSONObject(JData);
          CurObj := RootObj;
          If NestedKey <> '' Then
            Begin
              If Not RootObj.Find(NestedKey, CurObj) Then CurObj := Nil;
            End;
          If (CurObj <> Nil) And CurObj.Find('paths', PathsObj) Then
            Begin
              If PathsObj.Find(LangKey, Arr) Then
                For I := 0 To Arr.Count - 1 Do
                  AddIfDirExists(Arr.Strings[I]);
            End;
        End;
    Finally
      If JData <> Nil Then JData.Free;
End;
Except
End;
End;

Begin
  OutPaths.Clear;
  If IncludeDefaultServices Then
    AddIfDirExists('src/services');

  // Optional user-configured search paths from blaisevue.json or package.json
  ReadLangPathsFromJson(IncludeTrailingPathDelimiter(ProjectRoot) +
  'blaisevue.json', '');
  ReadLangPathsFromJson(IncludeTrailingPathDelimiter(ProjectRoot) +
  'package.json', 'blaisevue');
End;

Procedure ResolveDelSafeSearchPaths(Const ProjectRoot: String; OutPaths:
                                   TStringList);
