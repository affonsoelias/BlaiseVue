                   CapTag := '@' + RequestedCapVersion;
                 CapVerDisplay := RequestedCapVersion;
               End;
           End
         Else
           Begin
             CapTag := '@latest';
             CapVerDisplay := 'latest stable (@latest)';
           End;

         ExtraPkgs := '';
         If DirectoryExists(IOSDir) Or (Pos('@capacitor/ios', PkgContent) > 0)
           Then
           ExtraPkgs := ' @capacitor/ios' + CapTag;

         // 2. npm install dependencies
         WriteLn('  [1/4] Updating Capacitor packages to ' + CapVerDisplay +
                 '...');
    {$IFDEF WINDOWS}
         ExecuteProcess('cmd', '/c npm install @capacitor/core' + CapTag +
                        ' @capacitor/cli' + CapTag + ' @capacitor/android' +
                        CapTag + ExtraPkgs + ' --save-dev');
    {$ELSE}
         ExecuteProcess('/bin/sh', '-c "npm install @capacitor/core' + CapTag +
                        ' @capacitor/cli' + CapTag + ' @capacitor/android' +
                        CapTag + ExtraPkgs + ' --save-dev"');
    {$ENDIF}

         // 3. npx cap migrate
         WriteLn(


    '  [2/4] Executing native Capacitor platform migration (npx cap migrate)...'
         );
    {$IFDEF WINDOWS}
         ExecuteProcess('cmd', '/c npx cap migrate --noprompt');
    {$ELSE}
         ExecuteProcess('/bin/sh', '-c "npx cap migrate --noprompt"');
    {$ENDIF}

         // 4. Universal Self-Healing on Android Gradle
         WriteLn(


     '  [3/4] Running Universal Self-Healing on native Android configuration...'
         );
         If DirectoryExists(AndroidDir) Then
           Begin
             If EnsureAndroidGradleCompatibility(AndroidDir) Then
               WriteLn(


'        [+] Preserved Java 17 LTS, JVM toolchain & keystore signing configurations.'
               )
             Else
               WriteLn('        [OK] Android Gradle configuration is optimal.');
           End;

         // 5. Capacitor Sync
         WriteLn(


                '  [4/4] Synchronizing build artifacts with native platforms...'
         );
         CmdCapacitor('sync', TargetPlatform);

         // Cache version entry in ~/.blaisevue/versions/capacitor/
         VersionCacheDir := GetGlobalVersionsPath('capacitor') + 'v' + Copy(
                            CapVerDisplay, 1, 2);
         If (Length(VersionCacheDir) > 0) And (VersionCacheDir[Length(
            VersionCacheDir)] In [' ', '.']) Then
           Delete(VersionCacheDir, Length(VersionCacheDir), 1);
         ForceDirectories(VersionCacheDir);
         WriteStringToFile(VersionCacheDir + DirectorySeparator + 'version.info'
                           ,
                           'version=' + CapVerDisplay + LineEnding +
                           'updated=' + DateTimeToStr(Now) + LineEnding +
         'installed_via=bv capacitor upgrade' + LineEnding);

         WriteLn('');
         WriteLn(


        '======================================================================'
         );
         WriteLn('  [v] Capacitor upgraded successfully to ' + CapVerDisplay +
                 '!');
         WriteLn(


        '======================================================================'
         );
         WriteLn(


          'Run "bv capacitor build android" to compile the upgraded native APK.'
         );
       End

Else If (SubCmd = 'sync') Then
       Begin
         WriteLn('Synchronizing BlaiseVue dist/ with native Mobile platform...')
         ;
         CmdRunBuild;
         If IsAllTargets Or (TargetPlatform = 'all') Then
           Begin
      {$IFDEF WINDOWS}
             ExecuteProcess('cmd', '/c npx cap sync');
      {$ELSE}
             ExecuteProcess('/bin/sh', '-c "npx cap sync"');
      {$ENDIF}
           End
         Else
           Begin
      {$IFDEF WINDOWS}
             ExecuteProcess('cmd', '/c npx cap sync ' + TargetPlatform);
      {$ELSE}
             ExecuteProcess('/bin/sh', '-c "npx cap sync ' + TargetPlatform +
                            '"');
      {$ENDIF}
           End;

         If DirectoryExists(AndroidDir) Then
           Begin
             If EnsureAndroidGradleCompatibility(AndroidDir) Then
               WriteLn(


'  [+] Synchronized Android Gradle compatibility (Java 17 LTS / Release signing).'
               );
           End;

         WriteLn('Mobile assets synchronized successfully!');
       End

Else If (SubCmd = 'build') Then
       Begin
         WriteLn('Building native Mobile application with Capacitor...');
         CmdCapacitor('sync', TargetPlatform);
         If IsAllTargets Or (TargetPlatform = 'all') Then
           Begin
             WriteLn(


        'Building native Mobile application for ALL platforms (android, ios)...'
             );
             BuildSingleTarget('android', IsRelease, IsBundle);
             BuildSingleTarget('ios', IsRelease);
           End

         Else
           Begin
             BuildSingleTarget(TargetPlatform, IsRelease, IsBundle);
           End;
       End

Else If (SubCmd = 'run') Then
       Begin
         If Not IsNoBuild Then
           Begin
             WriteLn('Building and synchronizing native Mobile application...');
             CmdCapacitor('sync', TargetPlatform);
             BuildSingleTarget(TargetPlatform, IsRelease, IsBundle);
           End;
         RunTarget(TargetPlatform);
       End

Else If (SubCmd = 'open') Then
       Begin
         OpenTarget(TargetPlatform);
       End

Else If (SubCmd = 'emulator') Then
       Begin
         If (EmulatorAction = 'list') Or (EmulatorAction = 'ls') Or (
            EmulatorAction = '') Then
           Begin
             WriteLn('Installed Android Virtual Devices (AVD):');
             AvdList := GetInstalledAVDs;
             Try

               If AvdList.Count = 0 Then
                 Begin
                   WriteLn('  [!] No AVD emulators found.');
                   WriteLn(


'      Create one in Android Studio: Tools > Device Manager > Create Virtual Device'
                   );
                 End

               Else
                 Begin
                   For i := 0 To AvdList.Count - 1 Do
                     WriteLn('  [' + IntToStr(i + 1) + '] ' + AvdList[i]);

                   WriteLn('');
                   WriteLn('To start an emulator: bv capacitor emulator start '
                           + AvdList[0]);
                   WriteLn(


                     'To build and run:     bv capacitor run android --emulator'
                   );
                 End;

             Finally

               AvdList.Free;
           End;
       End

Else If (EmulatorAction = 'start') Or (EmulatorAction = 'open') Then
       Begin
         StartEmulator(SelectedAVD);
       End

Else If (EmulatorAction = 'run') Then
       Begin
         UseEmulator := True;
         RunTarget('android');
       End

Else If EmulatorAction = 'kill' Then
       Begin
         KillAndroidEmulator;
       End

Else
  Begin
    WriteLn('Usage: bv capacitor emulator <list|start [name]|run [name]|kill>');
  End;
End

Else
  Begin
    WriteLn(


'Usage: bv capacitor <init [name] [id] [--version=<v>]|upgrade [--check]|versions|remove-version|sync [target]|build [target] [--release]|run [target] [--emulator [name]]|open [target]|emulator <list|start|run>>'
    );
    WriteLn('       Targets: android | ios | all (default: android)');
    WriteLn(


 '       Note: "bv mobile" is supported as an alias for all capacitor commands.'
    );
  End;
End;

{ Backward-compatible alias for "bv capacitor" }
Procedure CmdMobile(Const SubCmd: String; Const Arg1: String = ''; Const Arg2:
                    String = '');
Begin
  WriteLn(


'  [HINT] "bv mobile" is an alias for "bv capacitor". Using "bv capacitor" going forward.'
  );
  CmdCapacitor(SubCmd, Arg1, Arg2);
End;




{ Native desktop application compiler using ultra-lightweight WebUI (bv desktop). }
Procedure CmdDesktop(Const SubCmd: String; Const Arg1: String = ''; Const Arg2:
                     String = '');

Var 
  DesktopDir, AssetsDir, BinDir, UnitsDir: string;
  HostPlatform, TargetPlatform, AltPlatformName, ExeDir: string;
  CleanName, DisplayName: string;
  LprFile, LpiFile, WebUIFile, BridgeFile, ReadmeFile: string;
  LprContent, LpiContent, WebUIContent, BridgeContent, ReadmeContent: string;
  i: Integer;
  SearchRec: TSearchRec;
  FoundLpr: string;
  TargetExe, TargetBin, TargetExt: string;
  IsRelease, IsAllTargets, RootHasLpi: Boolean;
  { Parses an individual command line option flag or positional parameter. }
Procedure ParseArg(Const A: String);

Var 
  S: string;
Begin
  S := LowerCase(A);
  If S = '' Then Exit;
  If (S = '--release') Or (S = '-r') Or (S = 'release') Then
    IsRelease := True
  Else If (S = '--debug') Or (S = '-d') Or (S = 'debug') Then
         IsRelease := False
  Else If (S = 'windows') Or (S = 'win') Or (S = 'win64') Or (S = '--windows')
          Or (S = '--target=windows') Then
         TargetPlatform := 'windows'
  Else If (S = 'linux') Or (S = 'linux64') Or (S = '--linux') Or (S =
          '--target=linux') Then
         TargetPlatform := 'linux'
  Else If (S = 'macos') Or (S = 'mac') Or (S = 'darwin') Or (S = '--macos') Or (
          S = '--target=macos') Or (S = '--target=darwin') Then
         TargetPlatform := 'macos'
  Else If (S = 'all') Or (S = '--all') Or (S = '--target=all') Then
         IsAllTargets := True
  Else If (DisplayName = '') And (SubCmd = 'init') And (Copy(S, 1, 1) <> '-')
         Then
         DisplayName := A;
End;

{ Compiles native binary artifacts for a specified platform target. }
Function BuildSingleTarget(Const ATarget: String; ARelease: Boolean): Boolean;

Var 
  TBin, TUnits: string;
  TExt, TExe: string;
  FpcCmd: string;
  IsNative: Boolean;
Begin
  Result := False;
  TBin := BinDir + DirectorySeparator + ATarget;
  TUnits := UnitsDir + DirectorySeparator + ATarget;
  ForceDir(TBin);
  ForceDir(TUnits);
  If ATarget = 'windows' Then
    TExt := '.exe'
  Else
    TExt := '';
  TExe := TBin + DirectorySeparator + CleanName + TExt;
  IsNative := (ATarget = HostPlatform);
  If ARelease Then
    WriteLn('  [+] Compiling ' + FoundLpr + ' in RELEASE mode for ' + ATarget +
            ' (GUI Application - No Console Window)...')

  Else
    WriteLn('  [+] Compiling ' + FoundLpr + ' in DEBUG mode for ' + ATarget +
            ' (Console Window Active for Diagnostics)...');

  FpcCmd := 'fpc ';
  If ARelease Then
    Begin
      FpcCmd := FpcCmd + '-O3 -Xs -dRELEASE ';
      If ATarget = 'windows' Then
        FpcCmd := FpcCmd + '-WG ';
    End

  Else
    Begin
      FpcCmd := FpcCmd + '-O2 -g -gl -dDEBUG ';
    End;

  If Not IsNative Then
    Begin
      If ATarget = 'windows' Then
        FpcCmd := FpcCmd + '-Twin64 -Px86_64 '
      Else If ATarget = 'linux' Then
             FpcCmd := FpcCmd + '-Tlinux -Px86_64 '
      Else If ATarget = 'macos' Then
             FpcCmd := FpcCmd + '-Tdarwin -Px86_64 ';
    End;

    {$IFDEF WINDOWS}

  FpcCmd := FpcCmd + '-FEbin\' + ATarget + ' -FUunits\' + ATarget + ' ' +
            FoundLpr;
  ExecuteProcess('cmd', '/c cd /d "' + DesktopDir + '" && ' + FpcCmd);

    {$ELSE}

  FpcCmd := FpcCmd + '-FEbin/' + ATarget + ' -FUunits/' + ATarget + ' ' +
            FoundLpr;
  ExecuteProcess('/bin/sh', ['-c', 'cd "' + DesktopDir + '" && ' + FpcCmd]);

    {$ENDIF}

  If FileExists(TExe) Then
    Begin
      Result := True;
      If ARelease Then
        WriteLn(


        '  [SUCCESS] Release native GUI binary built (no console): desktop/bin/'
                + ATarget + '/' + CleanName + TExt)
      Else
        Begin
          WriteLn('  [SUCCESS] Debug native binary built: desktop/bin/' +
                  ATarget + '/' + CleanName + TExt);
          WriteLn('  [TIP] For end users, run "bv desktop build ' + ATarget +


               ' --release" to compile a clean GUI application without console.'
          );
        End;
    End

  Else
    Begin
      WriteLn('  [WARNING] Binary not generated at expected location: ' + TExe);
      If Not IsNative Then
        Begin
          WriteLn('  [INFO] Note: Cross-compiling for ' + ATarget + ' from ' +
                  HostPlatform + ' requires FPC target units.');
          WriteLn('         You can compile natively on ' + ATarget +
                  ' (or WSL/Docker for Linux) using "bv desktop build".');
        End;
    End;
End;
