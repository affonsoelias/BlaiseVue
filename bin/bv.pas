Procedure CmdRemoveComponent(Const CompName: String);

Var 
  BVPath, PasPath, TestPath, GenPath: string;
Begin
  RequireBlaiseVueProject('bv remove c');
  BVPath := GetCurrentDir + DirectorySeparator + 'src' + DirectorySeparator +
            'components' + DirectorySeparator + CompName + '.bv';
  PasPath := GetCurrentDir + DirectorySeparator + 'generated' +
             DirectorySeparator + 'u' + CompName + '.pas';
  TestPath := GetCurrentDir + DirectorySeparator + 'tests' + DirectorySeparator
              + 'components' + DirectorySeparator + CompName + '.test.pas';
  GenPath := GetCurrentDir + DirectorySeparator + 'generated' +
             DirectorySeparator + 'tests' + DirectorySeparator + CompName +
             '.test.js';
  If FileExists(BVPath) Then
    Begin
      DeleteFile(BVPath);
      WriteLn('Removed: src/components/', CompName, '.bv');
    End

  Else
    WriteLn('File not found: src/components/', CompName, '.bv');

  If FileExists(PasPath) Then
    Begin
      DeleteFile(PasPath);
      WriteLn('Removed: generated/u', CompName, '.pas');
    End;

  If FileExists(TestPath) Then
    Begin
      DeleteFile(TestPath);
      WriteLn('Removed associated test: tests/components/', CompName,
              '.test.pas');
    End;

  If FileExists(GenPath) Then
    DeleteFile(GenPath);

  WriteLn('Component "', CompName, '" removed.');
End;

