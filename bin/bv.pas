                     rfReplaceAll]);
        End;

      WriteStringToFile(TargetPath, Content);
      WriteLn('Smart Detection: Found view src/views/', NormName, '.bv');
      WriteLn('Test created: tests/views/', NormName, '.test.pas');
      Exit;
    End;

  // 3. Is it an existing service in src/services/?
  ServicePas := GetCurrentDir + DirectorySeparator + 'src' + DirectorySeparator
                + 'services' + DirectorySeparator + 'u' + NormName + '.pas';
  If Not FileExists(ServicePas) Then
    ServicePas := GetCurrentDir + DirectorySeparator + 'src' +
                  DirectorySeparator + 'services' + DirectorySeparator +
                  NormName + '.pas';

  If FileExists(ServicePas) Then
    Begin
      TargetDir := GetCurrentDir + DirectorySeparator + 'tests' +
                   DirectorySeparator + 'services' + DirectorySeparator;
      TargetPath := TargetDir + NormName + '.test.pas';
      If FileExists(TargetPath) Then
        Begin
          WriteLn('ERROR: Service test "', NormName,
                  '.test.pas" already exists in tests/services/!');
          Halt(1);
        End;
      ForceDir(TargetDir);
      Content := GetTemplate('TPL_SERVICE_TEST_PAS', 'service_test.pas');
      If Content = '' Then
        Begin
          Content := 
                     'program ' + LowerCase(NormName) + '_unit_test;' + #10#10 +
                     '{$mode objfpc}' + #10#10 +
                     'uses JS, Web, BVTestUtils, u' + NormName + ';' + #10#10 +
                     'var' + #10 +
                     '  Service: T' + NormName + ';' + #10#10 +
                     'begin' + #10 +
                     '  Describe(''Service: ' + NormName +
                     ' (Domain Service)'', procedure' + #10 +
                     '    begin' + #10 +



     '       It(''deve instanciar o servico e executar com sucesso'', procedure'
                     + #10 +
                     '         begin' + #10 +
                     '            Service := T' + NormName + '.Create;' + #10 +
                     '            try' + #10 +



  '              Expect(Service.Execute(''teste'')).ToBe(''Processed: teste'');'
                     + #10 +
                     '            finally' + #10 +
                     '              Service.Free;' + #10 +
                     '            end;' + #10 +
                     '         end);' + #10#10 +



            '       It(''deve executar a funcao helper com sucesso'', procedure'
                     + #10 +
                     '         begin' + #10 +
                     '            Expect(' + NormName + 'Helper(10)).ToBe(20);'
                     + #10 +
                     '         end);' + #10 +
                     '    end);' + #10 +
                     'end.' + #10;
        End
      Else
        Begin
          Content := StringReplace(Content, '{{TEST_NAME}}', LowerCase(NormName)
                     + '_unit', [rfReplaceAll]);
          Content := StringReplace(Content, '{{SERVICE_NAME}}', NormName, [
                     rfReplaceAll]);
        End;

      WriteStringToFile(TargetPath, Content);
      WriteLn('Smart Detection: Found service src/services/u', NormName, '.pas')
      ;
      WriteLn('Test created: tests/services/', NormName, '.test.pas');
      Exit;
    End;



  // 3b. Is it an existing DelSafe service in src/services/?
  ServiceDels := GetCurrentDir + DirectorySeparator + 'src' + DirectorySeparator
                 + 'services' + DirectorySeparator + NormName + '.dels';
  If FileExists(ServiceDels) Then
    Begin
      TargetDir := GetCurrentDir + DirectorySeparator + 'tests' +
