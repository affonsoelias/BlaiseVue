{ Returns the path to the global registered projects database (~/.blaisevue/projects.json). }
Function GetProjectsConfigPath: string;

Var 
  HomeDir, BaseDir: string;
Begin
  {$IFDEF MSWINDOWS}
  HomeDir := GetEnvironmentVariable('USERPROFILE');
  If HomeDir = '' Then HomeDir := GetEnvironmentVariable('APPDATA');
  {$ELSE}
  HomeDir := GetEnvironmentVariable('HOME');
  {$ENDIF}
  If HomeDir = '' Then HomeDir := GetCurrentDir;
  BaseDir := IncludeTrailingPathDelimiter(HomeDir) + '.blaisevue';
  ForceDir(BaseDir);
  Result := BaseDir + DirectorySeparator + 'projects.json';
End;

{ Saves the global project registry JSON document. }
Procedure SaveProjectsRegistry(RootObj: TJSONObject);

Var 
  ConfigFile, JsonStr: string;
Begin
  ConfigFile := GetProjectsConfigPath;
  JsonStr := RootObj.FormatJSON;
  WriteStringToFile(ConfigFile, JsonStr);
End;

{ Loads the global project registry JSON document. }
Function LoadProjectsRegistry(out RootObj: TJSONObject): Boolean;

Var 
  ConfigFile, Raw, PName, PPath: string;
  Parser: TJSONParser;
  Data: TJSONData;
  ProjectsArr: TJSONArray;
  i: Integer;
  Modified: Boolean;
Begin
  Result := False;
  RootObj := Nil;
  ConfigFile := GetProjectsConfigPath;
  If (Not FileExists(ConfigFile)) Or (Trim(ReadFileToString(ConfigFile)) = '')
    Then
    Begin
      RootObj := TJSONObject.Create;
      RootObj.Add('active', '');
      RootObj.Add('projects', TJSONArray.Create);
      Exit(True);
    End;

  Raw := ReadFileToString(ConfigFile);
  Try
    Parser := TJSONParser.Create(Raw, True);
    Try
      Data := Parser.Parse;
      If (Data <> Nil) And (Data is TJSONObject) Then
        Begin
          RootObj := TJSONObject(Data);
          If RootObj.Find('projects') = Nil Then
            RootObj.Add('projects', TJSONArray.Create);
          Result := True;
        End
      Else
        Begin
          If Data <> Nil Then Data.Free;
          RootObj := TJSONObject.Create;
          RootObj.Add('active', '');
          RootObj.Add('projects', TJSONArray.Create);
          Result := True;
        End;
    Finally
      Parser.Free;
End;
Except
  RootObj := TJSONObject.Create;
  RootObj.Add('active', '');
  RootObj.Add('projects', TJSONArray.Create);
  Result := True;
End;

// Automatically filter and purge framework demo-app if present
If (RootObj <> Nil) And (RootObj.Find('projects') <> Nil) And (RootObj.Find(
   'projects') is TJSONArray) Then
  Begin
    ProjectsArr := RootObj.Arrays['projects'];
    Modified := False;
    For i := ProjectsArr.Count - 1 Downto 0 Do
      Begin
        If ProjectsArr[i] is TJSONObject Then
          Begin
            PName := LowerCase(GetJsonString(TJSONObject(ProjectsArr[i]), 'name'
                     , ''));
            PPath := LowerCase(GetJsonString(TJSONObject(ProjectsArr[i]), 'path'
                     , ''));
            If (PName = 'demo-app') Or (PName = 'blaisevue-demo-app') Or
               (ExtractFileName(ExcludeTrailingPathDelimiter(PPath)) =
               'demo-app') Then
              Begin
                ProjectsArr.Delete(i);
                Modified := True;
              End;
          End;
      End;

    If (LowerCase(GetJsonString(RootObj, 'active', '')) = 'demo-app') Or
       (LowerCase(GetJsonString(RootObj, 'active', '')) = 'blaisevue-demo-app')
      Then
      Begin
        If ProjectsArr.Count > 0 Then
          RootObj.Strings['active'] := GetJsonString(TJSONObject(ProjectsArr[0])
                                       , 'name', '')
        Else
          RootObj.Strings['active'] := '';
        Modified := True;
      End;

    If Modified Then
      SaveProjectsRegistry(RootObj);
  End;
End;

{ Resolves the project name from a directory configuration or folder name. }
Function GetProjectNameFromDir(Const ADir: String): string;

Var 
  TargetDir, Raw, Val, DirName: string;
  Parser: TJSONParser;
  Data: TJSONData;
  Obj: TJSONObject;
Begin
  TargetDir := IncludeTrailingPathDelimiter(ExpandFileName(ADir));
  DirName := ExtractFileName(ExcludeTrailingPathDelimiter(TargetDir));
  Result := DirName;
  If FileExists(TargetDir + 'package.json') Then
    Begin
      Raw := ReadFileToString(TargetDir + 'package.json');
      If Trim(Raw) <> '' Then
        Begin
          Try
            Parser := TJSONParser.Create(Raw, True);
            Try
              Data := Parser.Parse;
              If (Data <> Nil) And (Data is TJSONObject) Then
                Begin
                  Obj := TJSONObject(Data);
                  Val := Trim(GetJsonString(Obj, 'name', ''));
                  If Val <> '' Then
                    Begin
                      If (SameText(Val, 'blaisevue-demo-app') Or SameText(Val,
                         'demo-app')) And
                         (Not SameText(DirName, 'demo-app')) Then
                        Result := DirName
                      Else
                        Result := Val;
                    End;
                End;
              If Data <> Nil Then Data.Free;
            Finally
              Parser.Free;
        End;
    Except
End;
End;
End;
End;

{ Resolves the project version from package.json or metadata files. }
Function GetProjectVersionFromDir(Const ADir: String): string;

Var 
  TargetDir, Raw, Val: string;
  Parser: TJSONParser;
  Data: TJSONData;
  Obj: TJSONObject;
Begin
  TargetDir := IncludeTrailingPathDelimiter(ExpandFileName(ADir));
  Result := '1.0.0';
  If FileExists(TargetDir + 'package.json') Then
    Begin
      Raw := ReadFileToString(TargetDir + 'package.json');
      If Trim(Raw) <> '' Then
        Begin
          Try
            Parser := TJSONParser.Create(Raw, True);
            Try
              Data := Parser.Parse;
              If (Data <> Nil) And (Data is TJSONObject) Then
                Begin
                  Obj := TJSONObject(Data);
                  Val := GetJsonString(Obj, 'version', '');
                  If Val <> '' Then
                    Result := Val;
                End;
              If Data <> Nil Then Data.Free;
            Finally
              Parser.Free;
        End;
    Except
End;
End;
End;
End;

{ Locates a registered project by name in the global registry. }
Function FindRegisteredProject(Const ProjName: String; out ProjPath, ProjVer:
                               String): Boolean;

Var 
  RootObj, ProjObj: TJSONObject;
  ProjectsArr: TJSONArray;
  ProjData: TJSONData;
  i: Integer;
  PName: string;
Begin
  Result := False;
  ProjPath := '';
  ProjVer := '';
  If Not LoadProjectsRegistry(RootObj) Then Exit;
  Try
    ProjectsArr := RootObj.Arrays['projects'];
    For i := 0 To ProjectsArr.Count - 1 Do
      Begin
        ProjData := ProjectsArr[i];
        If ProjData is TJSONObject Then
          Begin
            ProjObj := TJSONObject(ProjData);
            PName := GetJsonString(ProjObj, 'name', '');
            If SameText(PName, ProjName) Then
              Begin
                ProjPath := GetJsonString(ProjObj, 'path', '');
                ProjVer := GetJsonString(ProjObj, 'version', '1.0.0');
                Result := True;
                Exit;
              End;
          End;
      End;
  Finally
    RootObj.Free;
End;
End;




{ Registers the current project into the global workspace registry (bv project add). }
Procedure CmdProjectAdd;

Var 
  RootObj, ProjObj: TJSONObject;
  ProjectsArr: TJSONArray;
  ProjData: TJSONData;
  CurDir, ProjName, ProjVer, NormCurDir, NormExisting: string;
  i, FoundIdx: Integer;
Begin
  If IsFrameworkCoreDemoApp Then
    Begin
      WriteLn('');
      WriteLn(


      '========================================================================'
      );
      WriteLn(


      '  [ERROR] Cannot register the internal framework repository or demo-app.'
      );
      WriteLn('  Create and register your own standalone application with:');
      WriteLn('    bv create <project-name>');
      WriteLn(


      '========================================================================'
      );
      WriteLn('');
      Exit;
    End;

  CurDir := FindBlaiseVueProjectRoot('');
  If CurDir = '' Then
    Begin
      WriteLn('');
      WriteLn(


      '========================================================================'
      );
      WriteLn(


'  [ERROR] Cannot register current directory: not a recognized BlaiseVue project.'
      );
      WriteLn('  Directory: ', GetCurrentDir);
      WriteLn(


         '  Ensure you are inside a project with app.cfg, package.json, or src/'
      );
      WriteLn(


      '========================================================================'
      );
      WriteLn('');
      Exit;
    End;
  NormCurDir := LowerCase(CurDir);
  ProjName := GetProjectNameFromDir(CurDir);
  ProjVer := GetProjectVersionFromDir(CurDir);
  If SameText(ProjName, 'demo-app') Or SameText(ProjName, 'blaisevue-demo-app')
    Then
    Begin
      WriteLn('');
      WriteLn(


      '========================================================================'
      );
      WriteLn(


      '  [ERROR] Cannot register the internal framework repository or demo-app.'
      );
      WriteLn('  Create and register your own standalone application with:');
      WriteLn('    bv create <project-name>');
      WriteLn(


      '========================================================================'
      );
      WriteLn('');
      Exit;
    End;

  If Not LoadProjectsRegistry(RootObj) Then Exit;
  Try
    ProjectsArr := RootObj.Arrays['projects'];
    FoundIdx := -1;
    For i := 0 To ProjectsArr.Count - 1 Do
      Begin
        ProjData := ProjectsArr[i];
        If ProjData is TJSONObject Then
          Begin
            NormExisting := LowerCase(ExcludeTrailingPathDelimiter(GetJsonString
                            (TJSONObject(ProjData), 'path', '')));
            If (NormExisting = NormCurDir) Or (LowerCase(GetJsonString(
               TJSONObject(ProjData), 'name', '')) = LowerCase(ProjName)) Then
              Begin
                FoundIdx := i;
                Break;
              End;
          End;
      End;

    If FoundIdx >= 0 Then
      Begin
        ProjObj := TJSONObject(ProjectsArr[FoundIdx]);
        ProjObj.Strings['name'] := ProjName;
        ProjObj.Strings['path'] := CurDir;
        ProjObj.Strings['version'] := ProjVer;
        ProjObj.Strings['lastUsed'] := FormatDateTime('yyyy-mm-dd hh:nn:ss', Now
                                       );
      End
    Else
      Begin
        ProjObj := TJSONObject.Create;
        ProjObj.Add('name', ProjName);
        ProjObj.Add('path', CurDir);
        ProjObj.Add('version', ProjVer);
        ProjObj.Add('lastUsed', FormatDateTime('yyyy-mm-dd hh:nn:ss', Now));
        ProjectsArr.Add(ProjObj);
      End;

    RootObj.Strings['active'] := ProjName;
    SaveProjectsRegistry(RootObj);
    WriteLn('');
    WriteLn('  [SUCCESS] Project "', ProjName,
            '" successfully registered in BlaiseVue registry!');
    WriteLn('  Path:    ', CurDir);
    WriteLn('  Version: v', ProjVer);
    WriteLn('');
    WriteLn('  You can now enter this project from anywhere using:');
    WriteLn('    bv use ', ProjName);
    WriteLn('');
  Finally
    RootObj.Free;
End;
End;




{ Lists all registered projects with their active status and paths (bv project list). }
Procedure CmdProjectList;

Var 
  RootObj, ProjObj: TJSONObject;
  ProjectsArr: TJSONArray;
  ProjData: TJSONData;
  ActiveName, PName, PPath, PVer, Marker: string;
  i, ValidCount: Integer;
Begin
  If Not LoadProjectsRegistry(RootObj) Then Exit;
  Try
    ActiveName := GetJsonString(RootObj, 'active', '');
    ProjectsArr := RootObj.Arrays['projects'];
    WriteLn('');
    WriteLn('  Registered BlaiseVue Projects:');
    WriteLn('  ' + StringOfChar('-', 76));
    ValidCount := 0;
    For i := 0 To ProjectsArr.Count - 1 Do
      Begin
        ProjData := ProjectsArr[i];
        If ProjData is TJSONObject Then
          Begin
            ProjObj := TJSONObject(ProjData);
            PName := GetJsonString(ProjObj, 'name', 'unnamed');
            PPath := GetJsonString(ProjObj, 'path', '');
            PVer := GetJsonString(ProjObj, 'version', '1.0.0');
            If SameText(PName, 'demo-app') Or SameText(PName,
               'blaisevue-demo-app') Or
               SameText(ExtractFileName(ExcludeTrailingPathDelimiter(PPath)),
               'demo-app') Then
              Continue;

            Inc(ValidCount);
            If SameText(PName, ActiveName) Then
              Marker := '* '
            Else
              Marker := '  ';

            WriteLn('  ', Marker, PadRight(PName, 20), PadRight('v' + PVer, 10),
            PPath);
          End;
      End;

    If ValidCount = 0 Then
      Begin
        WriteLn('  No user projects registered yet.');
        WriteLn(


'  To register a project: navigate to its folder, run "bv enter" and "project add"'
        );
      End;

    WriteLn('  ' + StringOfChar('-', 76));
    WriteLn('  Total: ', ValidCount, ' project(s) registered (* active)');
    WriteLn('');
  Finally
    RootObj.Free;
End;
End;




{ Displays detailed information about the currently active project (bv project current). }
Procedure CmdProjectCurrent;

Var 
  RootObj, ProjObj: TJSONObject;
  ProjectsArr: TJSONArray;
  ProjData: TJSONData;
  ActiveName, PName, PPath, PVer: string;
  i: Integer;
  Found: Boolean;
Begin
  If Not LoadProjectsRegistry(RootObj) Then Exit;
  Try
    ActiveName := GetJsonString(RootObj, 'active', '');
    If ActiveName = '' Then
      Begin
        WriteLn('No active project set in registry.');
        Exit;
      End;

    ProjectsArr := RootObj.Arrays['projects'];
    Found := False;
    For i := 0 To ProjectsArr.Count - 1 Do
      Begin
        ProjData := ProjectsArr[i];
        If ProjData is TJSONObject Then
          Begin
            ProjObj := TJSONObject(ProjData);
            PName := GetJsonString(ProjObj, 'name', '');
            If SameText(PName, ActiveName) Then
              Begin
                PPath := GetJsonString(ProjObj, 'path', '');
                PVer := GetJsonString(ProjObj, 'version', '1.0.0');
                WriteLn('');
                WriteLn('  Active Project: ', PName);
                WriteLn('  Version:        v', PVer);
                WriteLn('  Directory:      ', PPath);
                If DirectoryExists(PPath) Then
                  WriteLn('  Status:         OK (folder exists on disk)')
                Else
                  WriteLn(


                         '  Status:         WARNING (folder not found on disk!)'
                  );
                WriteLn('');
                Found := True;
                Break;
              End;
          End;
      End;

    If Not Found Then
      WriteLn('Active project "', ActiveName, '" not found in registry details.'
      );
  Finally
    RootObj.Free;
End;
End;




{ Unregisters a project from the global workspace registry (bv project remove). }
Procedure CmdProjectRemove(Const ProjName: String);

Var 
  RootObj, ProjObj: TJSONObject;
  ProjectsArr: TJSONArray;
  ProjData: TJSONData;
  i, DeleteIdx: Integer;
  ActiveName: string;
Begin
  If Not LoadProjectsRegistry(RootObj) Then Exit;
  Try
    ProjectsArr := RootObj.Arrays['projects'];
    DeleteIdx := -1;
    For i := 0 To ProjectsArr.Count - 1 Do
      Begin
        ProjData := ProjectsArr[i];
        If ProjData is TJSONObject Then
          Begin
            ProjObj := TJSONObject(ProjData);
            If SameText(GetJsonString(ProjObj, 'name', ''), ProjName) Then
              Begin
                DeleteIdx := i;
                Break;
              End;
          End;
      End;

    If DeleteIdx >= 0 Then
      Begin
        ProjectsArr.Delete(DeleteIdx);
        ActiveName := GetJsonString(RootObj, 'active', '');
        If SameText(ActiveName, ProjName) Then
          Begin
            If ProjectsArr.Count > 0 Then
              RootObj.Strings['active'] := GetJsonString(TJSONObject(ProjectsArr
                                           [0]), 'name', '')
            Else
              RootObj.Strings['active'] := '';
          End;
        SaveProjectsRegistry(RootObj);
        WriteLn('Project "', ProjName,
                '" unregistered from BlaiseVue registry (files intact).');
      End
    Else
      Begin
        WriteLn('Project "', ProjName, '" not found in registry.');
        WriteLn('Run "project list" to see registered projects.');
      End;
  Finally
    RootObj.Free;
End;
End;




{ Renames a project in its configuration, folders, and global registry (bv rename p). }
Procedure CmdRenameProject(Const NewProjectName: String; out RenamedName: String
);

Var 
  CurDir, CurName, AppVer, AppAuth, AppLic: string;
  PkgJson, RootObj, ProjObj: TJSONObject;
  ProjectsArr: TJSONArray;
  ProjData: TJSONData;
  AppBvPath, HtmlPath, AppContent, HtmlContent: string;
  i: Integer;
Begin
  RenamedName := '';
  If Not IsValidBlaiseVueProject Then
    Begin
      WriteLn(


  '[ERROR] "bv rename project" can only be executed inside a BlaiseVue project.'
      );
      Exit;
    End;

  If IsFrameworkCoreDemoApp Then
    Begin
      WriteLn('');
      WriteLn(


      '========================================================================'
      );
      WriteLn('  [ERROR] SAFETY GUARD ACTIVE: OPERATION REFUSED!');
      WriteLn(


       '  The framework repository and its official demo-app cannot be renamed.'
      );
      WriteLn(


      '========================================================================'
      );
      WriteLn('');
      Exit;
    End;

  CurDir := ExcludeTrailingPathDelimiter(GetCurrentDir);
  CurName := GetProjectNameFromDir(CurDir);
  If SameText(CurName, NewProjectName) Then
    Begin
      If LoadPackageJson(PkgJson) Then
        Begin
          Try
            If GetJsonString(PkgJson, 'name', '') <> NewProjectName Then
              Begin
                PkgJson.Strings['name'] := NewProjectName;
                WriteStringToFile('package.json', PkgJson.FormatJSON);
                WriteLn('Synced "name": "', NewProjectName, '" in package.json.'
                );
              End;
          Finally
            PkgJson.Free;
        End;
    End;
  WriteLn('Project is already named "', NewProjectName, '".');
  RenamedName := NewProjectName;
  Exit;
End;

AppVer := '1.0.0';
AppAuth := 'BlaiseVue Developer';
AppLic := 'MIT';

// 1. Update package.json
If LoadPackageJson(PkgJson) Then
  Begin
    Try
      AppVer := GetJsonString(PkgJson, 'version', AppVer);
      AppAuth := GetJsonString(PkgJson, 'author', AppAuth);
      AppLic := GetJsonString(PkgJson, 'license', AppLic);
      PkgJson.Strings['name'] := NewProjectName;
      WriteStringToFile('package.json', PkgJson.FormatJSON);
    Finally
      PkgJson.Free;
  End;
End;

// 2. Sync uAppVersion.pas
SyncAppVersionUnit(NewProjectName, AppVer, AppAuth, AppLic);

// 3. Update src/app.bv
AppBvPath := CurDir + DirectorySeparator + 'src' + DirectorySeparator + 'app.bv'
;
If FileExists(AppBvPath) Then
  Begin
    AppContent := ReadFileToString(AppBvPath);
    If Pos('appTitle: string = ''' + CurName + ''';', AppContent) > 0 Then
      Begin
        AppContent := StringReplace(AppContent, 'appTitle: string = ''' +
                      CurName + ''';', 'appTitle: string = ''' + NewProjectName
                      + ''';', [rfReplaceAll]);
        WriteStringToFile(AppBvPath, AppContent);
      End;
  End;

// 4. Update public/index.html
HtmlPath := CurDir + DirectorySeparator + 'public' + DirectorySeparator +
            'index.html';
If FileExists(HtmlPath) Then
  Begin
    HtmlContent := ReadFileToString(HtmlPath);
    If Pos('<title>' + CurName + '</title>', HtmlContent) > 0 Then
      Begin
        HtmlContent := StringReplace(HtmlContent, '<title>' + CurName +
                       '</title>', '<title>' + NewProjectName + '</title>', [
                       rfReplaceAll]);
        WriteStringToFile(HtmlPath, HtmlContent);
      End;
  End;

// 5. Update Global Registry (~/.blaisevue/projects.json)
If LoadProjectsRegistry(RootObj) Then
  Begin
    Try
      ProjectsArr := RootObj.Arrays['projects'];
      For i := 0 To ProjectsArr.Count - 1 Do
        Begin
          ProjData := ProjectsArr[i];
          If ProjData is TJSONObject Then
            Begin
              ProjObj := TJSONObject(ProjData);
              If SameText(GetJsonString(ProjObj, 'path', ''), CurDir) Or
                 SameText(GetJsonString(ProjObj, 'name', ''), CurName) Then
                Begin
                  ProjObj.Strings['name'] := NewProjectName;
                  ProjObj.Strings['lastUsed'] := FormatDateTime(
                                                 'yyyy-mm-dd hh:nn:ss', Now);
                  Break;
                End;
            End;
        End;
      If SameText(GetJsonString(RootObj, 'active', ''), CurName) Then
        RootObj.Strings['active'] := NewProjectName;
      SaveProjectsRegistry(RootObj);
    Finally
      RootObj.Free;
  End;
End;

RenamedName := NewProjectName;
WriteLn('');
WriteLn('  [SUCCESS] Project renamed from "', CurName, '" to "', NewProjectName,
        '"!');
WriteLn(


   '  Updated: package.json, src/app.bv, src/uAppVersion.pas, public/index.html'
);
WriteLn('  Updated project registry entry.');
WriteLn('');
End;

{ Global project registry command dispatcher (bv project). }
Procedure CmdProject;

Var 
  SubCmd: string;
Begin
  If ParamCount < 2 Then
    Begin
      WriteLn('Usage: bv project <add|list|current|use|remove>');
      WriteLn('Commands:');
      WriteLn(


          '  bv project add            Registers current directory as a project'
      );
      WriteLn(


          '  bv project list           Lists all registered projects (* active)'
      );
      WriteLn('  bv project current        Shows active project details');
      WriteLn(


             '  bv project use <name>     Sets active project and opens cockpit'
      );
      WriteLn('  bv project remove <name>  Unregisters a project');
      Halt(1);
    End;
  SubCmd := LowerCase(ParamStr(2));
  If SubCmd = 'add' Then
    CmdProjectAdd
  Else If (SubCmd = 'list') Or (SubCmd = 'ls') Then
         CmdProjectList
  Else If (SubCmd = 'current') Or (SubCmd = 'cur') Then
         CmdProjectCurrent
  Else If SubCmd = 'use' Then
         Begin
           If ParamCount < 3 Then
             Begin
               WriteLn('Usage: bv project use <name>');
               Halt(1);
             End;
           CmdUse(ParamStr(3));
         End
  Else If (SubCmd = 'remove') Or (SubCmd = 'rm') Or (SubCmd = 'del') Then
         Begin
           If ParamCount < 3 Then
             Begin
               WriteLn('Usage: bv project remove <name>');
               Halt(1);
             End;
           CmdProjectRemove(ParamStr(3));
         End
  Else
    Begin
      WriteLn('Unknown project subcommand: ', SubCmd);
      WriteLn('Use "bv project" for help.');
      Halt(1);
    End;
End;

// =====================================================================
//  PACKAGE REPOSITORIES & ECOSYSTEM REGISTRY (bv repo)
// =====================================================================

Function GetReposConfigPath: string;
Begin
  Result := GetUserBlaiseVueDir + DirectorySeparator + 'repos.json';
End;

{ Loads the multi-repository package catalog registry from disk. }
Function LoadReposRegistry(out RootObj: TJSONObject): Boolean;

Var 
  ConfigFile, Raw: string;
  Parser: TJSONParser;
  Data: TJSONData;
  DefaultRepo: TJSONObject;
  ReposArr: TJSONArray;
Begin
  Result := False;
  RootObj := Nil;
  ConfigFile := GetReposConfigPath;
  If (Not FileExists(ConfigFile)) Or (Trim(ReadFileToString(ConfigFile)) = '')
    Then
    Begin
      RootObj := TJSONObject.Create;
      ReposArr := TJSONArray.Create;
      DefaultRepo := TJSONObject.Create;
      DefaultRepo.Add('name', 'official');
      DefaultRepo.Add('url',
                      'https://github.com/affonsoelias/blaisevue-ecosystem');
      DefaultRepo.Add('type', 'ecosystem');
      DefaultRepo.Add('default', True);
      ReposArr.Add(DefaultRepo);
      RootObj.Add('repositories', ReposArr);
      WriteStringToFile(ConfigFile, RootObj.FormatJSON);
      Exit(True);
    End;

  Raw := ReadFileToString(ConfigFile);
  Parser := TJSONParser.Create(Raw, True);
  Try
    Try
      Data := Parser.Parse;
      If Assigned(Data) And (Data.JSONType = jtObject) Then
        Begin
          RootObj := TJSONObject(Data);
          Result := True;
        End
      Else If Assigned(Data) Then
             Data.Free;
    Except
      RootObj := Nil;
      Result := False;
End;
Finally
  Parser.Free;
End;
End;

{ Persists the multi-repository package catalog registry to disk. }
Procedure SaveReposRegistry(RootObj: TJSONObject);

Var 
  ConfigFile: string;
Begin
  If Not Assigned(RootObj) Then Exit;
  ConfigFile := GetReposConfigPath;
  WriteStringToFile(ConfigFile, RootObj.FormatJSON);
End;




{ Lists all registered package repositories and their priority order (bv repo list). }
Procedure CmdRepoList;

Var 
  RootObj, RepoObj: TJSONObject;
  ReposArr: TJSONArray;
  i: Integer;
  RName, RUrl, RType: string;
  IsDef: Boolean;
Begin
  If Not LoadReposRegistry(RootObj) Then
    Begin
      WriteLn('Error loading repositories registry at: ', GetReposConfigPath);
      Exit;
    End;
  Try
    WriteLn('=== BlaiseVue Package Repositories ===');
    WriteLn('Config: ' + GetReposConfigPath);
    WriteLn('');
    ReposArr := RootObj.Get('repositories', TJSONArray(Nil));
    If (Not Assigned(ReposArr)) Or (ReposArr.Count = 0) Then
      Begin
        WriteLn('  No repositories registered.');
        Exit;
      End;

    For i := 0 To ReposArr.Count - 1 Do
      Begin
        If ReposArr.Types[i] = jtObject Then
          Begin
            RepoObj := TJSONObject(ReposArr.Objects[i]);
            RName := RepoObj.Get('name', '');
            RUrl := RepoObj.Get('url', '');
            RType := RepoObj.Get('type', 'ecosystem');
            IsDef := RepoObj.Get('default', False);
            If IsDef Then
              WriteLn('  * ' + RName + ' (default)')
            Else
              WriteLn('    ' + RName);
            WriteLn('      URL:  ' + RUrl);
            WriteLn('      Type: ' + RType);
            WriteLn('');
          End;
      End;
    WriteLn('Total: ' + IntToStr(ReposArr.Count) +
    ' configured repository(ies).');
  Finally
    RootObj.Free;
End;
End;

{ Registers a new package repository URL (bv repo add). }
Procedure CmdRepoAdd(Const Name, URL: String);

Var 
  RootObj, NewRepo, Existing: TJSONObject;
  ReposArr: TJSONArray;
  i: Integer;
  CleanName, CleanURL: string;
Begin
  CleanName := LowerCase(Trim(Name));
  CleanURL := Trim(URL);
  If (CleanName = '') Or (CleanURL = '') Then
    Begin
      WriteLn('Usage: bv repo add <name> <url>');
      WriteLn(


        'Example: bv repo add community https://github.com/user/blaise-packages'
      );
      Exit;
    End;

  If Not LoadReposRegistry(RootObj) Then
    RootObj := TJSONObject.Create;

  Try
    ReposArr := RootObj.Get('repositories', TJSONArray(Nil));
    If Not Assigned(ReposArr) Then
      Begin
        ReposArr := TJSONArray.Create;
        RootObj.Add('repositories', ReposArr);
      End;

    For i := 0 To ReposArr.Count - 1 Do
      Begin
        If ReposArr.Types[i] = jtObject Then
          Begin
            Existing := TJSONObject(ReposArr.Objects[i]);
            If LowerCase(Existing.Get('name', '')) = CleanName Then
              Begin
                WriteLn('Notice: Repository "' + CleanName +
                        '" already exists with URL: ' + Existing.Get('url', ''))
                ;
                Existing.Delete('url');
                Existing.Add('url', CleanURL);
                SaveReposRegistry(RootObj);
                WriteLn('[SUCCESS] Repository "' + CleanName +
                        '" updated with new URL: ' + CleanURL);
                Exit;
              End;
          End;
      End;

    NewRepo := TJSONObject.Create;
    NewRepo.Add('name', CleanName);
    NewRepo.Add('url', CleanURL);
    NewRepo.Add('type', 'ecosystem');
    NewRepo.Add('default', False);
    ReposArr.Add(NewRepo);
    SaveReposRegistry(RootObj);
    WriteLn('[SUCCESS] Repository "' + CleanName + '" added successfully!');
    WriteLn('          URL: ' + CleanURL);
  Finally
    RootObj.Free;
End;
End;

{ Removes a package repository from the ecosystem (bv repo remove). }
Procedure CmdRepoRemove(Const Name: String);

Var 
  RootObj, RepoObj: TJSONObject;
  ReposArr: TJSONArray;
  i: Integer;
  CleanName: string;
  Found: Boolean;
Begin
  CleanName := LowerCase(Trim(Name));
  If CleanName = '' Then
    Begin
      WriteLn('Usage: bv repo remove <name>');
      Exit;
    End;

  If Not LoadReposRegistry(RootObj) Then
    Begin
      WriteLn('Error loading repositories registry.');
      Exit;
    End;

  Try
    ReposArr := RootObj.Get('repositories', TJSONArray(Nil));
    If Not Assigned(ReposArr) Then Exit;
    Found := False;
    For i := ReposArr.Count - 1 Downto 0 Do
      Begin
        If ReposArr.Types[i] = jtObject Then
          Begin
            RepoObj := TJSONObject(ReposArr.Objects[i]);
            If LowerCase(RepoObj.Get('name', '')) = CleanName Then
              Begin
                ReposArr.Delete(i);
                Found := True;
              End;
          End;
      End;

    If Found Then
      Begin
        SaveReposRegistry(RootObj);
        WriteLn('[SUCCESS] Repository "' + CleanName + '" removed successfully!'
        );
      End
    Else
      WriteLn('Repository "' + CleanName + '" not found.');
  Finally
    RootObj.Free;
End;
End;




{ Designates a repository as the default package publishing target (bv repo default). }
Procedure CmdRepoDefault(Const Name: String);

Var 
  RootObj, RepoObj: TJSONObject;
  ReposArr: TJSONArray;
  i: Integer;
  CleanName: string;
  Found: Boolean;
Begin
  CleanName := LowerCase(Trim(Name));
  If CleanName = '' Then
    Begin
      WriteLn('Usage: bv repo default <name>');
      Exit;
    End;

  If Not LoadReposRegistry(RootObj) Then Exit;
  Try
    ReposArr := RootObj.Get('repositories', TJSONArray(Nil));
    If Not Assigned(ReposArr) Then Exit;
    Found := False;
    For i := 0 To ReposArr.Count - 1 Do
      Begin
        If ReposArr.Types[i] = jtObject Then
          Begin
            RepoObj := TJSONObject(ReposArr.Objects[i]);
            If LowerCase(RepoObj.Get('name', '')) = CleanName Then
              Begin
                RepoObj.Delete('default');
                RepoObj.Add('default', True);
                Found := True;
              End
            Else
              Begin
                RepoObj.Delete('default');
                RepoObj.Add('default', False);
              End;
          End;
      End;

    If Found Then
      Begin
        SaveReposRegistry(RootObj);
        WriteLn('[SUCCESS] Repository "' + CleanName + '" set as default!');
      End
    Else
      WriteLn('Repository "' + CleanName + '" not found.');
  Finally
    RootObj.Free;
End;
End;




{ Synchronizes package catalogs from all registered repositories (bv repo sync). }
Procedure CmdRepoSync;

Var 
  RootObj, RepoObj: TJSONObject;
  ReposArr: TJSONArray;
  i: Integer;
  RName, RUrl, RawUrl, CacheDir, CacheFile: string;
  Client: TFPHTTPClient;
  Resp: string;
  CatParser: TJSONParser;
  CatData: TJSONData;
  PkgObj, ToolsObj: TJSONObject;
  PkgCount, ToolCount: Integer;
Begin
  If Not LoadReposRegistry(RootObj) Then Exit;
  CacheDir := ExtractFileDir(GetReposConfigPath) + DirectorySeparator + 'cache';
  ForceDir(CacheDir);
  WriteLn('=== Synchronizing BlaiseVue Repositories Catalog ===');
  Try
    ReposArr := RootObj.Get('repositories', TJSONArray(Nil));
    If Not Assigned(ReposArr) Then Exit;
    For i := 0 To ReposArr.Count - 1 Do
      Begin
        If ReposArr.Types[i] = jtObject Then
          Begin
            RepoObj := TJSONObject(ReposArr.Objects[i]);
            RName := RepoObj.Get('name', '');
            RUrl := RepoObj.Get('url', '');
            RawUrl := RUrl;
            If Pos('github.com/', RawUrl) > 0 Then
              Begin
                RawUrl := StringReplace(RawUrl, 'github.com/',
                          'raw.githubusercontent.com/', []);
                If Copy(RawUrl, Length(RawUrl) - 3, 4) = '.git' Then
                  Delete(RawUrl, Length(RawUrl) - 3, 4);
                RawUrl := RawUrl + '/main/ecosystem.json';
              End;

            Write('  [+] Synchronizing "' + RName + '" ... ');
            Client := TFPHTTPClient.Create(Nil);
            Try
              Try
                Client.AllowRedirect := True;
                Resp := Client.Get(RawUrl);
                CacheFile := CacheDir + DirectorySeparator + RName +
                             '-ecosystem.json';
                WriteStringToFile(CacheFile, Resp);
                PkgCount := 0;
                ToolCount := 0;
                CatParser := TJSONParser.Create(Resp, True);
                Try
                  CatData := CatParser.Parse;
                  If Assigned(CatData) And (CatData.JSONType = jtObject) Then
                    Begin
                      PkgObj := TJSONObject(CatData).Get('packages', TJSONObject
                                (Nil));
                      If Assigned(PkgObj) Then PkgCount := PkgObj.Count;
                      ToolsObj := TJSONObject(CatData).Get('tools', TJSONObject(
                                  Nil));
                      If Assigned(ToolsObj) Then ToolCount := ToolsObj.Count;
                    End;
                  If Assigned(CatData) Then CatData.Free;
                Finally
                  CatParser.Free;
          End;

        If ToolCount > 0 Then
          WriteLn('OK (' + IntToStr(PkgCount) + ' package(s), ' + IntToStr(


                                                                       ToolCount
          ) + ' tool(s) available)')
        Else
          WriteLn('OK (' + IntToStr(PkgCount) + ' package(s) available)');
      Except
        on E: Exception Do
              WriteLn('FAILED (' + E.Message + ')');
End;
Finally
  Client.Free;
End;
End;
End;
WriteLn('Synchronization completed successfully!');
Finally
  RootObj.Free;
End;
End;

{ Multi-repository package catalog dispatcher (bv repo). }
Procedure CmdRepo;

Var 
  SubCmd: string;
  Idx: Integer;
Begin
  If SameText(ParamStr(1), 'lib') Then
    Idx := 3
  Else
    Idx := 2;

  If ParamCount < Idx Then
    Begin
      CmdRepoList;
      Exit;
    End;

  SubCmd := LowerCase(ParamStr(Idx));
  If (SubCmd = 'list') Or (SubCmd = 'ls') Then
    CmdRepoList
  Else If SubCmd = 'add' Then
         CmdRepoAdd(ParamStr(Idx + 1), ParamStr(Idx + 2))
  Else If (SubCmd = 'remove') Or (SubCmd = 'rm') Or (SubCmd = 'del') Then
         CmdRepoRemove(ParamStr(Idx + 1))
  Else If (SubCmd = 'default') Or (SubCmd = 'use') Then
         CmdRepoDefault(ParamStr(Idx + 1))
  Else If (SubCmd = 'sync') Or (SubCmd = 'update') Then
         CmdRepoSync
  Else If (SubCmd = 'search') Or (SubCmd = 'find') Then
         CmdLibSearch(ParamStr(Idx + 1))
  Else
    Begin
      WriteLn('Unknown command: bv repo ' + SubCmd);
      WriteLn('Available subcommands:');
      WriteLn('  bv repo list               List registered repositories');
      WriteLn('  bv repo add <name> <url>   Register a new repository');
      WriteLn('  bv repo remove <name>      Remove a repository');
      WriteLn('  bv repo default <name>     Set the default repository');
      WriteLn('  bv repo sync               Update package catalog');
      WriteLn('  bv repo search <term>      Search packages across repositories'
      );
      Halt(1);
    End;
End;

{ Tokenizes an interactive command string into arguments. }
Procedure SplitTokens(Const S: String; Tokens: TStringList);

Var 
  i: Integer;
  Cur: string;
  InQuote: Boolean;
Begin
  Tokens.Clear;
  Cur := '';
  InQuote := False;
  For i := 1 To Length(S) Do
    Begin
      If S[i] = '"' Then
        InQuote := Not InQuote
      Else If (S[i] = ' ') And Not InQuote Then
             Begin
               If Cur <> '' Then
                 Begin
                   Tokens.Add(Cur);
                   Cur := '';
                 End;
             End
      Else
        Cur := Cur + S[i];
    End;
  If Cur <> '' Then
    Tokens.Add(Cur);
End;

{ Clears pending keyboard characters from the console input buffer. }
Procedure ClearInputBuffer;
Begin
  Try
    {$IFDEF UNIX}
    TCFlush(0, TCIFLUSH);
    {$ENDIF}
    {$IFDEF WINDOWS}
    FlushConsoleInputBuffer(GetStdHandle(STD_INPUT_HANDLE));
    {$ENDIF}
    TextRec(Input).BufPos := 0;
    TextRec(Input).BufEnd := 0;
  Except
End;
End;

{ Runs an external executable within the interactive developer cockpit shell. }
Procedure ExecInCockpit(Const ExePath, WorkingDir, Args: String);
Begin
  Try
    {$IFDEF WINDOWS}
    ExecuteProcess('cmd', '/c cd /d "' + WorkingDir + '" && "' + ExePath + '" '
                   + Args);
    {$ELSE}
    ExecuteProcess('/bin/sh', ['-c', 'cd "' + WorkingDir + '" && exec "' +
                   ExePath + '" ' + Args]);
    {$ENDIF}
  Except
    on E: Exception Do
          Begin



   // Catch Ctrl+C interruptions cleanly without terminating the Cockpit session
          End;
End;
Try
  TextRec(Input).BufPos := 0;
  TextRec(Input).BufEnd := 0;
Except
End;
End;

{ Executes an arbitrary shell command within the developer cockpit. }
Procedure ExecShellCmd(Const WorkingDir, CmdLine: String);
Begin
  Try
    {$IFDEF WINDOWS}
    ExecuteProcess('cmd', '/c cd /d "' + WorkingDir + '" && ' + CmdLine);
    {$ELSE}
    ExecuteProcess('/bin/sh', ['-c', 'cd "' + WorkingDir + '" && ' + CmdLine]);
    {$ENDIF}
  Except
    on E: Exception Do
          Begin



   // Catch Ctrl+C interruptions cleanly without terminating the Cockpit session
          End;
End;
Try
  TextRec(Input).BufPos := 0;
  TextRec(Input).BufEnd := 0;
Except
End;
End;

{$IFDEF WINDOWS}
Function CockpitConsoleCtrlHandler(dwCtrlType: DWORD): BOOL;
stdcall;
Begin
  Case dwCtrlType Of 
    CTRL_C_EVENT, CTRL_BREAK_EVENT:
                                    Begin



                                    // Intercept Ctrl+C / Ctrl+Break in Cockpit:



        // Return TRUE so Windows DOES NOT terminate bv.exe (the Cockpit shell).



// Child processes (dev-server, mormot, etc.) still receive the signal and exit cleanly.
                                      WriteLn('');
                                      ClearInputBuffer;
                                      Result := True;
                                      Exit;
                                    End;
    CTRL_CLOSE_EVENT, CTRL_LOGOFF_EVENT, CTRL_SHUTDOWN_EVENT:
                                                              Begin
                                                                Result := False;
                                                                Exit;
                                                              End;
  End;
  Result := False;
End;
{$ENDIF}

{$IFDEF UNIX}
Procedure CockpitSigIntHandler(Sig: LongInt);
cdecl;
Begin
  // Intercept SIGINT/SIGQUIT in Cockpit on Linux/Unix:
  // Do NOT terminate bv (the Cockpit shell).



// Child processes (dev-server, mormot, etc.) still receive the signal and exit cleanly.
  WriteLn('');
  ClearInputBuffer;
End;
{$ENDIF}

