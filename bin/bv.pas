    End;

  WriteLn(


     'Executing end-to-end user journeys (Routing, Forms, Themes, Hydration)...'
  );

  {$IFDEF WINDOWS}
  ExecuteProcess('cmd',


               '/c npx vitest run --testNamePattern="E2E|Integration|Hydration"'
  );
  {$ELSE}
  ExecuteProcess('/bin/sh',


           '-c "npx vitest run --testNamePattern=\"E2E|Integration|Hydration\""'
  );
  {$ENDIF}
End;

