If SubCmd = 'build' Then Exit;

ParamsList := TStringList.Create;
SavedCwd := GetCurrentDir;
Try
  If PortStr <> '' Then
    Begin
      ParamsList.Add('--port');
      ParamsList.Add(PortStr);
    End;
  If DirectoryExists(ProjectRoot + DirectorySeparator + 'dist') Then
    Begin
      ParamsList.Add('--dist');
      ParamsList.Add(ProjectRoot + DirectorySeparator + 'dist');
    End;
  SetCurrentDir(ServerDir);
  WriteLn('Starting Zephyr server: ', OutBin);
  ExecuteProcess(OutBin, ParamsList.ToStringArray);
Finally
  SetCurrentDir(SavedCwd);
  ParamsList.Free;
End;
Exit;
End;

If SubCmd = 'deploy' Then
  Begin
    If PortStr = '' Then
      Begin
        EnvFile := IncludeTrailingPathDelimiter(ServerDir) + '.env';
        If FileExists(EnvFile) Then
          Begin
            EnvLines := TStringList.Create;
            Try
              EnvLines.LoadFromFile(EnvFile);
              For i := 0 To EnvLines.Count - 1 Do
                Begin
                  EnvLine := Trim(EnvLines[i]);
                  If (EnvLine <> '') And (EnvLine[1] <> '#') And (Pos('PORT=',
                     UpperCase(EnvLine)) = 1) Then
                    Begin
                      PortStr := Trim(Copy(EnvLine, 6, MaxInt));
                      Break;
                    End;
                End;
            Finally
              EnvLines.Free;
          End;
      End;
  End;
If PortStr = '' Then PortStr := '8091';
If DeployDir = '' Then
  DeployDir := ProjectRoot + DirectorySeparator + 'deploy' + DirectorySeparator
               + ServerLabel;

