{ Returns all subcommands valid for a given parent command. }
Function GetCockpitSubcommands(Const MainCmd: String): TStringList;

Var 
  Cmd: string;
Begin
  Result := TStringList.Create;
  Result.Sorted := True;
  Result.Duplicates := dupIgnore;
  Cmd := LowerCase(MainCmd);

  If Cmd = 'mormot' Then
    Begin
      Result.Add('run');
      Result.Add('build');
      Result.Add('crud');
      Result.Add('auth');
      Result.Add('docs');
      Result.Add('swagger');
      Result.Add('docker');
      Result.Add('rpc');
      Result.Add('status');
      Result.Add('kill');
      Result.Add('init');
      Result.Add('deploy');
      Result.Add('upgrade');
      Result.Add('versions');
      Result.Add('use');
      Result.Add('remove-version');
      Result.Add('remove');
    End
  Else If Cmd = 'zephyr' Then
         Begin
           Result.Add('init');
