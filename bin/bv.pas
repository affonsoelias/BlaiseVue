            'Usage: bv <g|new|generate> <c|v|s|t> <Name> [--delsafe] [--no-test]'
               );
               WriteLn('Aliases: bv g, bv new, bv generate');
               WriteLn('Types: component (c), view (v), service (s), test (t)');
               WriteLn('');
               WriteLn('Examples:');
               WriteLn(


'  bv g c UserCard          # Scaffolds component and test in tests/components/'
               );
               WriteLn(


    '  bv g v Dashboard         # Scaffolds route view and test in tests/views/'
