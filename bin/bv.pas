// =====================================================================

//  COMMAND: REMOVE TEST

// =====================================================================

Procedure CmdRemoveTest(Const TestName: String);

Var 
  CleanName, TargetFile: string;
  FoundAny: Boolean;
  AllTests: TStringList;
  i: Integer;
Begin
  RequireBlaiseVueProject('bv remove t');
  CleanName := ExtractFileName(StringReplace(TestName, '/', DirectorySeparator,
               [rfReplaceAll]));
  CleanName := StringReplace(CleanName, '.test.pas', '', [rfIgnoreCase]);
  CleanName := StringReplace(CleanName, '.test', '', [rfIgnoreCase]);
  CleanName := StringReplace(CleanName, '.pas', '', [rfIgnoreCase]);
  FoundAny := False;
  AllTests := TStringList.Create;
  Try
    ScanDirForTests(GetCurrentDir + DirectorySeparator + 'tests', AllTests);
    For i := 0 To AllTests.Count - 1 Do
      Begin
        If LowerCase(ExtractFileName(AllTests[i])) = LowerCase(CleanName +
           '.test.pas') Then
          Begin
            DeleteFile(AllTests[i]);
            WriteLn('Removed: ', ExtractRelativePath(GetCurrentDir +
                    DirectorySeparator, AllTests[i]));
            TargetFile := GetCurrentDir + DirectorySeparator + 'generated' +
                          DirectorySeparator + 'tests' + DirectorySeparator +
                          CleanName + '.test.js';
            If FileExists(TargetFile) Then DeleteFile(TargetFile);
            FoundAny := True;
          End;
      End;
  Finally
    AllTests.Free;
End;

If FoundAny Then
  WriteLn('Test "', CleanName, '" removed.')
Else
  WriteLn('Test not found for: ', CleanName);
End;

