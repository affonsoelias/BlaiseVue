// =====================================================================
//  COMMAND: REMOVE FINITE STATE MACHINE
// =====================================================================

Procedure CmdRemoveFSM(Const FSMName: String);

Var 
  NormName, TargetPath, TestPath: string;
Begin
  RequireBlaiseVueProject('bv remove fsm');
  NormName := FSMName;
  If (Length(NormName) > 1) And ((NormName[1] = 'u') Or (NormName[1] = 'U')) And
     (NormName[2] In ['A'..'Z']) Then
    NormName := Copy(NormName, 2, Length(NormName) - 1);
  If (Length(NormName) > 7) And (LowerCase(Copy(NormName, Length(NormName) - 6,
     7)) = 'machine') Then
    NormName := Copy(NormName, 1, Length(NormName) - 7);

  TargetPath := GetCurrentDir + DirectorySeparator + 'src' + DirectorySeparator
                + 'machines' + DirectorySeparator + 'u' + NormName +
                'Machine.pas';
  If FileExists(TargetPath) Then
    Begin
      DeleteFile(TargetPath);
      WriteLn('Removed: src/machines/u', NormName, 'Machine.pas');
    End
  Else
    WriteLn('FSM not found: src/machines/u', NormName, 'Machine.pas');

  TestPath := GetCurrentDir + DirectorySeparator + 'tests' + DirectorySeparator
              + 'machines' + DirectorySeparator + NormName + 'Machine.test.pas';
  If FileExists(TestPath) Then
    Begin
      DeleteFile(TestPath);
      WriteLn('Removed associated test: ', ExtractRelativePath(GetCurrentDir +
              DirectorySeparator, TestPath));
    End;

  WriteLn('Finite state machine "', NormName, '" removed.');
End;

// =====================================================================

//  COMMAND: NEW TEST (Smart Detection)

// =====================================================================

Procedure CmdNewTest(Const TestName: String; Const UseDelSafe: Boolean = False);

Var 
  CleanName, NormName, TargetPath, TargetDir, Content: string;
  CompBV, ViewBV, ServicePas, ServiceDels: string;
  CompTag, ViewTag, ViewKebab: string;
  IsExplicitPath: Boolean;
Begin
  CleanName := StringReplace(TestName, '/', DirectorySeparator, [rfReplaceAll]);
  CleanName := StringReplace(CleanName, '', DirectorySeparator, [rfReplaceAll]);




// Check if user passed an explicit directory, e.g. "framework/MyTest", "unit/MyTest", "services/MyTest"

  RequireBlaiseVueProject('bv g t');
  IsExplicitPath := (Pos(DirectorySeparator, CleanName) > 0);
  If IsExplicitPath Then
    Begin
      TargetDir := GetCurrentDir + DirectorySeparator + 'tests' +
                   DirectorySeparator + ExtractFilePath(CleanName);
      NormName := ExtractFileName(CleanName);
      If UseDelSafe Then
        Begin
          TargetPath := TargetDir + NormName + '.test.dels';
          If FileExists(TargetPath) Then
            Begin
              WriteLn('ERROR: Test "', CleanName, '.test.dels" already exists!')
              ;
              Halt(1);
            End;
          ForceDir(TargetDir);
          Content := 'module ' + LowerCase(NormName) + '_test;' + #10#10 +
                     'program Main;' + #10 +
                     'begin' + #10 +
                     '  Assert(1 + 1 = 2);' + #10 +
                     '  PrintLn("PASS: ' + NormName + '");' + #10 +
                     'end ' + LowerCase(NormName) + '_test.' + #10;
          WriteStringToFile(TargetPath, Content);
          WriteLn('Test created: tests/', CleanName, '.test.dels');
          Exit;
        End;
      TargetPath := TargetDir + NormName + '.test.pas';
      If FileExists(TargetPath) Then
        Begin
          WriteLn('ERROR: Test "', CleanName, '.test.pas" already exists!');
          Halt(1);
        End;

      ForceDir(TargetDir);
      Content := GetTemplate('TPL_UNIT_TEST_PAS', 'unit_test.pas');
      If Content = '' Then Content := GetTemplate('TPL_TEST_PAS', 'test.pas');
      If Content = '' Then
        Begin
          Content := 

                     'program ' + LowerCase(NormName) + '_test;' + #10#10 +

                     '{$mode objfpc}' + #10#10 +

                     'uses JS, Web, BVTestUtils;' + #10#10 +

                     'var' + #10 +

                     '  Wrapper: TWrapper;' + #10#10 +

                     'begin' + #10 +

                     '  Describe(''' + NormName + ''', procedure' + #10 +

                     '    begin' + #10 +




                    '       It(''deve executar o teste com sucesso'', procedure'
                     + #10 +

                     '         begin' + #10 +

                     '            Expect(True).ToBe(True);' + #10 +

                     '         end);' + #10 +

                     '    end);' + #10 +

                     'end.' + #10;
        End

      Else
        Content := StringReplace(Content, '{{TEST_NAME}}', NormName, [
                   rfReplaceAll]);

      WriteStringToFile(TargetPath, Content);
      WriteLn('Test created: tests/', CleanName, '.test.pas');
      Exit;
    End;

  // No explicit path passed: Smart Detection!

  NormName := CleanName;
  CompBV := GetCurrentDir + DirectorySeparator + 'src' + DirectorySeparator +
            'components' + DirectorySeparator + NormName + '.bv';
  ViewBV := GetCurrentDir + DirectorySeparator + 'src' + DirectorySeparator +
            'views' + DirectorySeparator + NormName + '.bv';

  // 1. Is it an existing component in src/components/?

  If FileExists(CompBV) Then
    Begin
      TargetDir := GetCurrentDir + DirectorySeparator + 'tests' +
                   DirectorySeparator + 'components' + DirectorySeparator;
      TargetPath := TargetDir + NormName + '.test.pas';
      If FileExists(TargetPath) Then
        Begin
          WriteLn('ERROR: Component test "', NormName,
                  '.test.pas" already exists in tests/components/!');
          Halt(1);
        End;

      ForceDir(TargetDir);
      CompTag := PascalToKebab(NormName);
      Content := GetTemplate('TPL_COMPONENT_TEST_PAS', 'component_test.pas');
      If Content = '' Then
        Begin
          Content := 

                     'program ' + LowerCase(NormName) + '_test;' + #10#10 +

                     '{$mode objfpc}' + #10#10 +

                     'uses JS, Web, BVTestUtils, u' + NormName + ';' + #10#10 +

                     'var' + #10 +

                     '  Wrapper: TWrapper;' + #10#10 +

                     'begin' + #10 +

                     '  Register_u' + NormName + ';' + #10#10 +

                     '  Describe(''Component: ' + NormName + ''', procedure' + #10 +

                     '    begin' + #10 +




            '       It(''deve montar o componente no DOM sem erros'', procedure'
                     + #10 +

                     '         begin' + #10 +

                     '            Wrapper := Mount(''' + CompTag + ''');' + #10
                     +

                     '            Expect(Wrapper.Element <> nil).ToBe(True);' +
                     #10 +

                     '         end);' + #10 +

                     '    end);' + #10 +

                     'end.' + #10;
        End

      Else
        Begin
          Content := StringReplace(Content, '{{TEST_NAME}}', LowerCase(NormName)
                     , [rfReplaceAll]);
          Content := StringReplace(Content, '{{COMP_NAME}}', NormName, [
                     rfReplaceAll]);
          Content := StringReplace(Content, '{{COMP_TAG}}', CompTag, [
                     rfReplaceAll]);
        End;

      WriteStringToFile(TargetPath, Content);
      WriteLn('Smart Detection: Found component src/components/', NormName,
              '.bv');
      WriteLn('Test created: tests/components/', NormName, '.test.pas');
      Exit;
    End;

  // 2. Is it an existing view in src/views/?

  If FileExists(ViewBV) Then
    Begin
      TargetDir := GetCurrentDir + DirectorySeparator + 'tests' +
                   DirectorySeparator + 'views' + DirectorySeparator;
      TargetPath := TargetDir + NormName + '.test.pas';
      If FileExists(TargetPath) Then
        Begin
