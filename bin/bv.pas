Function LevenshteinDistance(Const S1, S2: String): Integer;

Var 
  Len1, Len2, i, j, Cost: Integer;
  D: array Of array Of Integer;
Begin
  Len1 := Length(S1);
  Len2 := Length(S2);
  SetLength(D, Len1 + 1, Len2 + 1);
  For i := 0 To Len1 Do
    D[i, 0] := i;
  For j := 0 To Len2 Do
    D[0, j] := j;
  For i := 1 To Len1 Do
    Begin
      For j := 1 To Len2 Do
        Begin
          If LowerCase(S1[i]) = LowerCase(S2[j]) Then
            Cost := 0

          Else
            Cost := 1;

          D[i, j] := D[i - 1, j] + 1;
          If D[i, j - 1] + 1 < D[i, j] Then D[i, j] := D[i, j - 1] + 1;
          If D[i - 1, j - 1] + Cost < D[i, j] Then D[i, j] := D[i - 1, j - 1] +
                                                              Cost;
        End;
    End;

  Result := D[Len1, Len2];
End;




{ Finds the closest matching candidate string for a target identifier using Levenshtein distance for compiler typo hints. }
Function FindClosestMatch(Const Target: String; Candidates: TStringList): string
;

Var 
  i, MinDist, Dist, MaxAllowed: Integer;
  BestMatch: string;
Begin
  Result := '';
  If Candidates.Count = 0 Then Exit;
  MinDist := 999;
  BestMatch := '';
  MaxAllowed := 2;
  If Length(Target) >= 7 Then MaxAllowed := 3;
  For i := 0 To Candidates.Count - 1 Do
    Begin
      Dist := LevenshteinDistance(Target, Candidates[i]);
      If Dist < MinDist Then
        Begin
          MinDist := Dist;
          BestMatch := Candidates[i];
        End;
    End;

  If (MinDist > 0) And (MinDist <= MaxAllowed) Then
    Result := BestMatch;
End;

{ Checks whether an identifier is an ECMAScript / JavaScript reserved keyword. }
Function IsJSReservedWord(Const W: String): Boolean;

Var 
  L: string;
Begin
  L := LowerCase(W);

  Result := (L = 'true') Or (L = 'false') Or (L = 'null') Or (L = 'undefined')
            Or

            (L = 'this') Or (L = 'typeof') Or (L = 'instanceof') Or (L = 'in')
            Or

            (L = 'new') Or (L = 'function') Or (L = 'return') Or (L = 'var') Or

            (L = 'let') Or (L = 'const') Or (L = 'if') Or (L = 'else') Or

            (L = 'try') Or (L = 'catch') Or (L = 'finally') Or (L = 'for') Or

            (L = 'while') Or (L = 'do') Or (L = 'switch') Or (L = 'case') Or

            (L = 'break') Or (L = 'continue') Or (L = 'default') Or (L = 'void')
            Or

            (L = 'delete') Or (L = 'yield') Or (L = 'await') Or (L = 'async');
End;




{ Extracts declared procedure and function names from a Pascal code fragment for symbol table validation. }
Procedure ExtractPascalRoutines(Const Code: String; Names: TStringList);

Var 
  LowerCode: string;
  p, pEnd, len, tIdx: Integer;
  Word: string;
  Tokens: array[0..1] Of string = ('procedure ', 'function ');
Begin
  If Trim(Code) = '' Then Exit;
  LowerCode := LowerCase(Code);
  len := Length(LowerCode);
  For tIdx := 0 To 1 Do
    Begin
      p := Pos(Tokens[tIdx], LowerCode);
      While p > 0 Do
        Begin
          p := p + Length(Tokens[tIdx]);
          While (p <= len) And (Code[p] <= ' ') Do
            Inc(p);
          pEnd := p;
          While (pEnd <= len) And (Code[pEnd] In ['a'..'z', 'A'..'Z', '0'..'9',
                '_', '$']) Do
            Inc(pEnd);
          If pEnd > p Then
            Begin
              Word := Copy(Code, p, pEnd - p);
              If (Names.IndexOf(Word) < 0) Then
                Names.Add(Word);
            End;

          p := PosEx(Tokens[tIdx], LowerCode, pEnd);
        End;
    End;
End;




{ Parses an AST expression to extract root variable identifiers for template scope verification. }
Procedure ExtractRootIdentifiers(Const Expr: String; Identifiers: TStringList);

Var 
  i, Len, Start, j: Integer;
  Ch, Quote: Char;
  Word, PrevToken: string;
  IsMember, IsObjectKey: Boolean;
Begin
  Len := Length(Expr);
  i := 1;
  PrevToken := '';
  While i <= Len Do
    Begin
      Ch := Expr[i];
      If Ch <= ' ' Then
        Begin
          Inc(i);
          Continue;
        End;

      // Skip string literals: '...', "...", `...`

      If (Ch = '''') Or (Ch = '"') Or (Ch = '`') Then
        Begin
          Quote := Ch;
          Inc(i);
          While (i <= Len) And (Expr[i] <> Quote) Do
            Begin
              If (Expr[i] = '\') And (i < Len) Then Inc(i);
              Inc(i);
            End;

          Inc(i);
          PrevToken := 'STR';
          Continue;
        End;

      // Skip numbers

      If (Ch In ['0'..'9']) Or ((Ch = '.') And (i < Len) And (Expr[i + 1] In [
         '0'..'9'])) Then
        Begin
          While (i <= Len) And (Expr[i] In ['0'..'9', '.', 'e', 'E']) Do
            Inc(i);
          PrevToken := 'NUM';
          Continue;
        End;

      // Dot accessor (member access)

      If Ch = '.' Then
        Begin
          PrevToken := '.';
          Inc(i);
          Continue;
        End;

      // Identifiers: [a-zA-Z_$][a-zA-Z0-9_$]*

      If (Ch In ['a'..'z', 'A'..'Z', '_', '$']) Then
        Begin
          Start := i;
          While (i <= Len) And (Expr[i] In ['a'..'z', 'A'..'Z', '0'..'9', '_',
                '$']) Do
            Inc(i);
          Word := Copy(Expr, Start, i - Start);
          IsMember := (PrevToken = '.');

          // Check if object key in { key: value }

          j := i;
          While (j <= Len) And (Expr[j] <= ' ') Do
            Inc(j);
          IsObjectKey := (j <= Len) And (Expr[j] = ':') And ((PrevToken = '{')
                         Or (PrevToken = ','));
          If (Not IsMember) And (Not IsObjectKey) And (Not IsJSReservedWord(Word
             )) Then
            Begin
              If Identifiers.IndexOf(Word) < 0 Then
                Identifiers.Add(Word);
            End;

          PrevToken := Word;
          Continue;
        End;

      PrevToken := Ch;
      Inc(i);
    End;
End;




{ Determines whether a symbol exists in a symbol table using case-insensitive comparison. }
Function HasSymbolCaseInsensitive(Const Symbol: String; Symbols: TStringList):


                                                                         Boolean
;

Var 
  i: Integer;
  LS: string;
Begin
  LS := LowerCase(Symbol);
  For i := 0 To Symbols.Count - 1 Do
    Begin
      If LowerCase(Symbols[i]) = LS Then
        Begin
          Result := True;
          Exit;
        End;
    End;

  Result := False;
End;




{ Statically verifies template directives (b-model, b-for, b-if, @click) against declared component Pascal state and methods, emitting compile-time diagnostics with typo suggestions. }
Function ValidateComponentTemplate(Const BVFilePath: String; Const Parsed:
                                   TBVParsed; Const StrictMode: Boolean = False)
: Integer;

Var 
  Symbols: TStringList;
  RootIds: TStringList;
  Tpl: string;
  i, pStart, pEnd, InIdx: Integer;
  Expr, Id, Sugg, AttrVal, BaseName: string;
  WarningCount: Integer;
  BForPos, QuoteEnd: Integer;
  QuoteChar: Char;
  IterStr: string;
Begin
  WarningCount := 0;
  BaseName := ExtractFileName(BVFilePath);
  Symbols := TStringList.Create;
  RootIds := TStringList.Create;
  Try

    // 1. Collect declared data fields and props

    For i := 0 To High(Parsed.DataFields) Do
      If Symbols.IndexOf(Parsed.DataFields[i].Name) < 0 Then
        Symbols.Add(Parsed.DataFields[i].Name);

    // 2. Collect methods and computed routines

    ExtractPascalRoutines(Parsed.MethodsCode, Symbols);
    ExtractPascalRoutines(Parsed.ComputedCode, Symbols);

    For i := 0 To High(Parsed.WasmExports) Do
      If (Parsed.WasmExports[i].Name <> '') And (Symbols.IndexOf(Parsed.
         WasmExports[i].Name) < 0) Then
        Symbols.Add(Parsed.WasmExports[i].Name);

    // 3. Collect inject symbols

    If Parsed.InjectCode <> '' Then
      Begin
        Expr := StringReplace(Parsed.InjectCode, ';', ',', [rfReplaceAll]);
        Expr := StringReplace(Expr, '''', '', [rfReplaceAll]);
        RootIds.CommaText := Expr;
        For i := 0 To RootIds.Count - 1 Do
          If (Trim(RootIds[i]) <> '') And (Symbols.IndexOf(Trim(RootIds[i])) < 0
             ) Then
            Symbols.Add(Trim(RootIds[i]));

        RootIds.Clear;
      End;

    // 4. Register global built-ins

    Symbols.Add('$t');
    Symbols.Add('$i18n');
    Symbols.Add('$setLocale');
    Symbols.Add('$theme');
    Symbols.Add('$auth');
    Symbols.Add('$rpc');
    Symbols.Add('$ws');
    Symbols.Add('$api');
    Symbols.Add('$mobile');
    Symbols.Add('$desktop');
    Symbols.Add('$wasm');
    Symbols.Add('$ionic');
    Symbols.Add('$store');
    Symbols.Add('$blaisex');
    Symbols.Add('Router');
    Symbols.Add('$router');
    Symbols.Add('$route');
    Symbols.Add('$v');
    Symbols.Add('$errors');
    Symbols.Add('$validate');
    Symbols.Add('$event');
    Symbols.Add('$refs');
    Symbols.Add('$slots');
    Symbols.Add('$attrs');
    Symbols.Add('$index');
    Symbols.Add('$emit');
    Symbols.Add('item');
    Symbols.Add('idx');
    Symbols.Add('index');
    Symbols.Add('p');
    Symbols.Add('col');
    Symbols.Add('row');
    Symbols.Add('tab');
    Symbols.Add('opt');
    Symbols.Add('key');
    Symbols.Add('val');
    Symbols.Add('value');
    Symbols.Add('entry');
    Symbols.Add('true');
    Symbols.Add('false');
    Symbols.Add('null');
    Symbols.Add('undefined');
    Symbols.Add('this');
    Symbols.Add('window');
    Symbols.Add('Math');
    Symbols.Add('Date');
    Symbols.Add('String');
    Symbols.Add('Number');
    Symbols.Add('Boolean');
    Symbols.Add('Array');
    Symbols.Add('Object');
    Symbols.Add('JSON');
    Symbols.Add('console');
    Symbols.Add('parseInt');
    Symbols.Add('parseFloat');
    Symbols.Add('encodeURIComponent');
    Symbols.Add('decodeURIComponent');




 // 5. Detect template b-for and scoped slots to register local loop identifiers

    Tpl := Parsed.Template;
    BForPos := Pos('b-for="', Tpl);
    If BForPos = 0 Then BForPos := Pos('b-for=''', Tpl);
    While BForPos > 0 Do
      Begin
        QuoteChar := Tpl[BForPos + 6];
        QuoteEnd := PosEx(QuoteChar, Tpl, BForPos + 7);
        If QuoteEnd > 0 Then
          Begin
            AttrVal := Copy(Tpl, BForPos + 7, QuoteEnd - (BForPos + 7));
            InIdx := Pos(' in ', AttrVal);
            If InIdx > 0 Then
              Begin
                IterStr := Trim(Copy(AttrVal, 1, InIdx - 1));
                IterStr := StringReplace(IterStr, '(', '', [rfReplaceAll]);
                IterStr := StringReplace(IterStr, ')', '', [rfReplaceAll]);
                IterStr := StringReplace(IterStr, ' ', '', [rfReplaceAll]);
                RootIds.CommaText := IterStr;
                For i := 0 To RootIds.Count - 1 Do
                  If (Trim(RootIds[i]) <> '') And (Symbols.IndexOf(Trim(RootIds[
                     i])) < 0) Then
                    Symbols.Add(Trim(RootIds[i]));

                RootIds.Clear;
              End;
          End;

        BForPos := PosEx('b-for=', Tpl, BForPos + 7);
      End;

    // Detect slot-scope / v-slot variables

    pStart := Pos('slot-scope="', Tpl);
    While pStart > 0 Do
      Begin
        pEnd := PosEx('"', Tpl, pStart + 12);
        If pEnd > 0 Then
          Begin
            AttrVal := Trim(Copy(Tpl, pStart + 12, pEnd - (pStart + 12)));
            If (AttrVal <> '') And (Symbols.IndexOf(AttrVal) < 0) Then
              Symbols.Add(AttrVal);
          End;

        pStart := PosEx('slot-scope="', Tpl, pStart + 12);
      End;

    // 6. Scan Interpolations: {{ ... }}

    pStart := Pos('{{', Tpl);
    While pStart > 0 Do
      Begin
        pEnd := PosEx('}}', Tpl, pStart + 2);
        If pEnd > 0 Then
          Begin
            Expr := Trim(Copy(Tpl, pStart + 2, pEnd - (pStart + 2)));
            RootIds.Clear;
            ExtractRootIdentifiers(Expr, RootIds);
            For i := 0 To RootIds.Count - 1 Do
              Begin
                Id := RootIds[i];
                If Not HasSymbolCaseInsensitive(Id, Symbols) Then
                  Begin
                    Inc(WarningCount);
                    Sugg := FindClosestMatch(Id, Symbols);
                    If (Sugg <> '') And (LowerCase(Sugg) <> LowerCase(Id)) Then
                      WriteLn('  [Template AST] Warning: Unknown property ''',
                              Id, ''' in ', BaseName, ' (expr: ''', Expr,
                              '''). Did you mean ''', Sugg, '''?')

                    Else
                      WriteLn('  [Template AST] Warning: Unknown property ''',
                              Id, ''' in ', BaseName, ' (expr: ''', Expr,


                 '''). Verify declaration in data, props, computed, or methods.'
                      );
                  End;
              End;

            pStart := PosEx('{{', Tpl, pEnd + 2);
          End

        Else
          Break;
      End;




// 7. Scan Dynamic Directives: :prop="...", @event="...", b-model="...", b-if="...", b-show="..."

    For i := 1 To Length(Tpl) - 5 Do
      Begin
        If (i > 1) And (Tpl[i - 1] > ' ') And (Tpl[i - 1] <> '<') Then Continue;
        If ((Tpl[i] = ':') Or (Tpl[i] = '@') Or

           ((i <= Length(Tpl) - 7) And (Copy(Tpl, i, 7) = 'b-model')) Or

           ((i <= Length(Tpl) - 7) And (Copy(Tpl, i, 7) = 'v-model')) Or

           ((i <= Length(Tpl) - 9) And (Copy(Tpl, i, 9) = 'b-else-if')) Or

           ((i <= Length(Tpl) - 9) And (Copy(Tpl, i, 9) = 'v-else-if')) Or

           ((i <= Length(Tpl) - 4) And (Copy(Tpl, i, 4) = 'b-if')) Or

           ((i <= Length(Tpl) - 4) And (Copy(Tpl, i, 4) = 'v-if')) Or

           ((i <= Length(Tpl) - 6) And (Copy(Tpl, i, 6) = 'b-show')) Or

           ((i <= Length(Tpl) - 6) And (Copy(Tpl, i, 6) = 'v-show')) Or

           ((i <= Length(Tpl) - 7) And (Copy(Tpl, i, 7) = 'b-bind:')) Or

           ((i <= Length(Tpl) - 7) And (Copy(Tpl, i, 7) = 'v-bind:')) Or

           ((i <= Length(Tpl) - 10) And (Copy(Tpl, i, 10) = 'b-validate')) Or

           ((i <= Length(Tpl) - 10) And (Copy(Tpl, i, 10) = 'v-validate')) Or

           ((i <= Length(Tpl) - 7) And (Copy(Tpl, i, 7) = 'b-field'))) Then
          Begin
            pStart := i;
            While (pStart <= Length(Tpl)) And (Tpl[pStart] <> '=') And (Tpl[
                  pStart] <> '>') And (Tpl[pStart] > ' ') Do
              Inc(pStart);
            If (pStart <= Length(Tpl)) And (Tpl[pStart] = '=') And (pStart <
               Length(Tpl)) Then
              Begin
                QuoteChar := Tpl[pStart + 1];
                If (QuoteChar = '"') Or (QuoteChar = '''') Then
                  Begin
                    QuoteEnd := PosEx(QuoteChar, Tpl, pStart + 2);
                    If QuoteEnd > pStart + 2 Then
                      Begin
                        Expr := Trim(Copy(Tpl, pStart + 2, QuoteEnd - (pStart +
                                2)));
                        RootIds.Clear;
                        ExtractRootIdentifiers(Expr, RootIds);
                        For pEnd := 0 To RootIds.Count - 1 Do
                          Begin
                            Id := RootIds[pEnd];
                            If Not HasSymbolCaseInsensitive(Id, Symbols) Then
                              Begin
                                Inc(WarningCount);
                                Sugg := FindClosestMatch(Id, Symbols);
                                If (Sugg <> '') And (LowerCase(Sugg) <>
                                   LowerCase(Id)) Then
                                  WriteLn(


                                 '  [Template AST] Warning: Unknown property '''
                                          , Id, ''' in ', BaseName, ' (expr: '''
                                          , Expr, '''). Did you mean ''', Sugg,
                                          '''?')

                                Else
                                  WriteLn(


                                 '  [Template AST] Warning: Unknown property '''
                                          , Id, ''' in ', BaseName, ' (expr: '''
                                          , Expr,


                 '''). Verify declaration in data, props, computed, or methods.'
                                  );
                              End;
                          End;
                      End;
                  End;
              End;
          End;
      End;

    If StrictMode And (WarningCount > 0) Then
      Begin
        WriteLn('ERROR: Template AST verification failed with ', WarningCount,
                ' warning(s) in strict mode.');
        Halt(1);
      End;

    Result := WarningCount;

  Finally

    Symbols.Free;
    RootIds.Free;
End;
End;




{ Executes static verification of Single File Component templates and scripts (bv check). }



{ Executes static verification of Single File Component templates and scripts (bv check [--strict] [file]). }
Procedure CmdCheck(Const TargetFile: String);

Var 
  BVFiles: TStringList;
  Parsed: TBVParsed;
  i, TotalWarnings, FileWarnings: Integer;
  EffectiveFile, ArgLow: string;
  StrictMode: Boolean;
Begin
  StrictMode := False;
  EffectiveFile := '';
  If (TargetFile <> '') And (LowerCase(Trim(TargetFile)) <> '--strict') Then
    EffectiveFile := TargetFile;
  For i := 2 To ParamCount Do
    Begin
      ArgLow := LowerCase(Trim(ParamStr(i)));
      If ArgLow = '--strict' Then
        StrictMode := True
      Else If (EffectiveFile = '') And (Copy(ParamStr(i), 1, 1) <> '-') Then
             EffectiveFile := ParamStr(i);
    End;

  If (EffectiveFile = '') Or (Not FileExists(EffectiveFile)) Then
    RequireBlaiseVueProject('bv check');

  WriteLn('=== BlaiseVue Template AST Checker & Type-Verification ===');
  WriteLn('');
  BVFiles := TStringList.Create;
  Try

    If (EffectiveFile <> '') And FileExists(EffectiveFile) Then
      Begin
        BVFiles.Add(EffectiveFile);
      End

    Else
      Begin
        If FileExists(GetCurrentDir + DirectorySeparator + 'src' +
           DirectorySeparator + 'app.bv') Then
          BVFiles.Add(GetCurrentDir + DirectorySeparator + 'src' +
                      DirectorySeparator + 'app.bv');

        ScanDirForBV(GetCurrentDir + DirectorySeparator + 'src' +
                     DirectorySeparator + 'components', BVFiles);
        ScanDirForBV(GetCurrentDir + DirectorySeparator + 'src' +
                     DirectorySeparator + 'views', BVFiles);
        ScanDirForBV(GetCurrentDir + DirectorySeparator + 'lib', BVFiles);
      End;

    If BVFiles.Count = 0 Then
      Begin
        WriteLn('No .bv files found to verify.');
        Exit;
      End;

    WriteLn('Checking ', BVFiles.Count, ' component(s)...');
    WriteLn('');
    TotalWarnings := 0;
    For i := 0 To BVFiles.Count - 1 Do
      Begin
        ParseBVFile(BVFiles[i], Parsed);
        FileWarnings := ValidateComponentTemplate(BVFiles[i], Parsed, StrictMode
                        );
        TotalWarnings := TotalWarnings + FileWarnings;
        If FileWarnings = 0 Then
          WriteLn('  [v] ', ExtractFileName(BVFiles[i]), ' (0 warnings)');
      End;

    WriteLn('');
    If TotalWarnings = 0 Then
      WriteLn('Result: All ', BVFiles.Count,
              ' component(s) passed AST type-verification with 0 errors.')

    Else
      WriteLn('Result: Verification completed with ', TotalWarnings,
              ' template warning(s).');
  Finally
    BVFiles.Free;
End;
End;




{ Reformats a .bv Single File Component with standardized Pascal indentation and clean HTML tags. }
Function FormatBVContent(Const AContent: String): string;

Var 
  InLines, OutLines: TStringList;
  i: Integer;
  Line, Trimmed, LowTrim: string;
  Section: Integer;
  // 0=none, 1=template, 2=script, 3=style
  TmplIndent: Integer;
  InMethodBody: Boolean;
  StyleIndent: Integer;
  LastEmpty: Boolean;



{ Validates that all HTML opening tags have matching closing tags in the template. }
Function CountUnclosedTags(Const S: String): Integer;

Var 
  P, TagStart, TagEnd: Integer;
  Tag: string;
  Balance: Integer;
  InQuotes: Boolean;
  QuoteChar: Char;
Begin
  Balance := 0;
  P := 1;
  While P <= Length(S) Do
    Begin
      If (S[P] = '<') And (P < Length(S)) Then
        Begin
          If Copy(S, P, 4) = '<!--' Then
            Begin
              P := Pos('-->', S);
              If P = 0 Then P := Length(S) + 1
              Else Inc(P, 3);
              Continue;
            End;

          TagStart := P;
          InQuotes := False;
          QuoteChar := #0;
          Inc(P);
          While (P <= Length(S)) Do
            Begin
              If S[P] In ['"', ''''] Then
                Begin
                  If Not InQuotes Then
                    Begin
                      InQuotes := True;
                      QuoteChar := S[P];
                    End
                  Else If S[P] = QuoteChar Then InQuotes := False;
                End
              Else If (S[P] = '>') And Not InQuotes Then Break;
              Inc(P);
            End;
          TagEnd := P;
          Tag := Copy(S, TagStart, TagEnd - TagStart + 1);
          If (Length(Tag) >= 2) Then
            Begin
              If Copy(Tag, 1, 2) = '</' Then
                Dec(Balance)
              Else If (Copy(Tag, Length(Tag) - 1, 2) = '/>') Or
                      (Copy(LowerCase(Tag), 1, 3) = '<br') Or
                      (Copy(LowerCase(Tag), 1, 3) = '<hr') Or
                      (Copy(LowerCase(Tag), 1, 4) = '<img') Or
                      (Copy(LowerCase(Tag), 1, 6) = '<input') Or
                      ((Copy(LowerCase(Tag), 1, 5) = '<slot') And (Pos('</slot>'
                      , LowerCase(S)) = 0)) Then
                     // self closing or void
              Else
                Inc(Balance);
            End;
        End;
      Inc(P);
    End;
  Result := Balance;
End;
Begin
  InLines := TStringList.Create;
  OutLines := TStringList.Create;
  Try
    InLines.Text := AContent;
    Section := 0;
    TmplIndent := 1;
    InMethodBody := False;
    StyleIndent := 1;
    LastEmpty := False;
    For i := 0 To InLines.Count - 1 Do
      Begin
        Line := InLines[i];
        Trimmed := Trim(Line);
        LowTrim := LowerCase(Trimmed);
        If Trimmed = '' Then
          Begin
            If Not LastEmpty And (OutLines.Count > 0) Then
              Begin
                OutLines.Add('');
                LastEmpty := True;
              End;
            Continue;
          End;
        LastEmpty := False;
        If Pos('<template', LowTrim) = 1 Then
          Begin
            Section := 1;
            TmplIndent := 1;
            OutLines.Add(Trimmed);
          End
        Else If Pos('</template>', LowTrim) = 1 Then
               Begin
                 Section := 0;
                 OutLines.Add('</template>');
                 OutLines.Add('');
                 LastEmpty := True;
               End
        Else If Pos('<script', LowTrim) = 1 Then
               Begin
                 Section := 2;
                 InMethodBody := False;
                 OutLines.Add(Trimmed);
               End
        Else If Pos('</script>', LowTrim) = 1 Then
               Begin
                 Section := 0;
                 OutLines.Add('</script>');
                 OutLines.Add('');
                 LastEmpty := True;
               End
        Else If Pos('<style', LowTrim) = 1 Then
               Begin
                 Section := 3;
                 StyleIndent := 1;
                 OutLines.Add(Trimmed);
               End
        Else If Pos('</style>', LowTrim) = 1 Then
               Begin
                 Section := 0;
                 OutLines.Add('</style>');
               End
        Else
          Begin
            Case Section Of 
              1: // Template
                 Begin
                   If Copy(Trimmed, 1, 2) = '</' Then
                     Begin
                       If TmplIndent > 1 Then Dec(TmplIndent);
                       OutLines.Add(StringOfChar(' ', TmplIndent * 2) + Trimmed)
                       ;
                     End
                   Else
                     Begin
                       OutLines.Add(StringOfChar(' ', TmplIndent * 2) + Trimmed)
                       ;
                       Inc(TmplIndent, CountUnclosedTags(Trimmed));
                       If TmplIndent < 1 Then TmplIndent := 1;
                     End;
                 End;

              2: // Script
                 Begin
                   If (LowTrim = 'props:') Or (LowTrim = 'data:') Or (LowTrim =
                      'computed:') Or
                      (LowTrim = 'watch:') Or (LowTrim = 'methods:') Or (LowTrim
                      = 'created:') Or
                      (LowTrim = 'mounted:') Or (LowTrim = 'updated:') Or (
                      LowTrim = 'unmounted:') Or
                      (LowTrim = 'provide:') Or (LowTrim = 'inject:') Or (
                      LowTrim = 'routes:') Then
                     Begin
                       InMethodBody := False;
                       OutLines.Add('  ' + Trimmed);
                     End
                   Else If (Pos('procedure ', LowTrim) = 1) Or (Pos('function ',
                           LowTrim) = 1) Then
                          Begin
                            InMethodBody := False;
                            OutLines.Add('    ' + Trimmed);
                          End
                   Else If (LowTrim = 'var') Or (LowTrim = 'const') Then
                          Begin
                            InMethodBody := False;
                            OutLines.Add('    ' + Trimmed);
                          End
                   Else If (LowTrim = 'begin') Then
                          Begin
                            OutLines.Add('    begin');
                            InMethodBody := True;
                          End
                   Else If (LowTrim = 'end;') Or (LowTrim = 'end') Then
                          Begin
                            InMethodBody := False;
                            OutLines.Add('    ' + Trimmed);
                          End
                   Else If InMethodBody Then
                          Begin
                            OutLines.Add('      ' + Trimmed);
                          End
                   Else
                     Begin
                       OutLines.Add('    ' + Trimmed);
                     End;
                 End;

              3: // Style
                 Begin
                   If (Pos('{', Trimmed) > 0) And (Pos('}', Trimmed) > 0) Then
                     Begin
                       OutLines.Add('  ' + Trimmed);
                     End
                   Else If Pos('{', Trimmed) > 0 Then
                          Begin
                            OutLines.Add('  ' + Trimmed);
                            StyleIndent := 2;
                          End
                   Else If Pos('}', Trimmed) = 1 Then
                          Begin
                            OutLines.Add('  }');
                            StyleIndent := 1;
                          End
                   Else
                     Begin
                       OutLines.Add(StringOfChar(' ', StyleIndent * 2) + Trimmed
                       );
                     End;
                 End;

              Else
                OutLines.Add(Trimmed);
            End;
          End;
      End;

    Result := OutLines.Text;
  Finally
    InLines.Free;
    OutLines.Free;
End;
End;




{ Formats .bv components across the project with uniform styling rules (bv format). }
Procedure CmdFormat(Const TargetFile: String; CheckOnly: Boolean = False);

Var 
  BVFiles: TStringList;
  i, FormattedCount: Integer;
  FilePath, OrigContent, FormattedContent: string;
Begin
  If (LowerCase(TargetFile) = '--help') Or (LowerCase(TargetFile) = '-h') Or (
     LowerCase(TargetFile) = 'help') Then
    Begin
      WriteLn('Usage: bv format [file_or_dir] [--check]');
      WriteLn('');
      WriteLn('Options:');
      WriteLn(


'  [file_or_dir]   Target .bv component file or directory (defaults to src/ and lib/)'
      );
      WriteLn(


        '  --check         Verify if files are formatted without modifying them'
      );
      WriteLn('  -h, --help      Show this help message');
      Exit;
    End;

  BVFiles := TStringList.Create;
  Try
    If (TargetFile <> '') And (TargetFile <> '--check') Then
      Begin
        If FileExists(TargetFile) Then
          BVFiles.Add(TargetFile)
        Else If DirectoryExists(TargetFile) Then
               ScanDirForBV(TargetFile, BVFiles)
        Else
          Begin
            WriteLn('  [ERROR] File or directory not found: ' + TargetFile);
            Halt(1);
          End;
      End
    Else
      Begin
        If FileExists(GetCurrentDir + DirectorySeparator + 'src' +
           DirectorySeparator + 'app.bv') Then
          BVFiles.Add(GetCurrentDir + DirectorySeparator + 'src' +
                      DirectorySeparator + 'app.bv');
        ScanDirForBV(GetCurrentDir + DirectorySeparator + 'src' +
                     DirectorySeparator + 'components', BVFiles);
        ScanDirForBV(GetCurrentDir + DirectorySeparator + 'src' +
                     DirectorySeparator + 'views', BVFiles);
        ScanDirForBV(GetCurrentDir + DirectorySeparator + 'lib', BVFiles);
      End;

    If BVFiles.Count = 0 Then
      Begin
        WriteLn('  [INFO] No .bv components found to format.');
        Exit;
      End;

    FormattedCount := 0;
    WriteLn('  [FORMAT] Processing ' + IntToStr(BVFiles.Count) +
    ' component(s)...');
    For i := 0 To BVFiles.Count - 1 Do
      Begin
        FilePath := BVFiles[i];
        OrigContent := ReadFileToString(FilePath);
        FormattedContent := FormatBVContent(OrigContent);
        If OrigContent <> FormattedContent Then
          Begin
            Inc(FormattedCount);
            If CheckOnly Then
              WriteLn('    [!] Needs formatting: ' + FilePath)
            Else
              Begin
                WriteStringToFile(FilePath, FormattedContent);
                WriteLn('    [*] Formatted: ' + FilePath);
              End;
          End;
      End;

    If CheckOnly Then
      Begin
        If FormattedCount > 0 Then
          Begin
            WriteLn('  [FAIL] ' + IntToStr(FormattedCount) +
            ' file(s) need formatting.');
            Halt(1);
          End
        Else
          WriteLn('  [OK] All files are properly formatted.');
      End
    Else
      Begin
        WriteLn('  [SUCCESS] Formatted ' + IntToStr(FormattedCount) + ' of ' +
        IntToStr(BVFiles.Count) + ' file(s).');
      End;
  Finally
    BVFiles.Free;
End;
End;

