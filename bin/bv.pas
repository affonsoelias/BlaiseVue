Procedure CmdRenameService(Const OldName, NewName: String);

Var 
  OldNorm, NewNorm, ServicePath, OldFile, NewFile, Content: string;
  TestPath, OldTest, NewTest, TestContent: string;
  GenOldPas, GenOldJs: string;
Begin
  OldNorm := OldName;
  If (Length(OldNorm) > 1) And ((OldNorm[1] = 'u') Or (OldNorm[1] = 'U')) And (
     OldNorm[2] In ['A'..'Z']) Then
    OldNorm := Copy(OldNorm, 2, Length(OldNorm) - 1);

  NewNorm := NewName;
  If (Length(NewNorm) > 1) And ((NewNorm[1] = 'u') Or (NewNorm[1] = 'U')) And (
     NewNorm[2] In ['A'..'Z']) Then
    NewNorm := Copy(NewNorm, 2, Length(NewNorm) - 1);

  ServicePath := GetCurrentDir + DirectorySeparator + 'src' + DirectorySeparator
                 + 'services' + DirectorySeparator;
  OldFile := ServicePath + 'u' + OldNorm + '.pas';
  NewFile := ServicePath + 'u' + NewNorm + '.pas';
  If Not FileExists(OldFile) Then
    Begin
      WriteLn('[ERROR] Service "u', OldNorm, '.pas" not found in src/services/')
      ;
      Exit;
    End;

  If FileExists(NewFile) Then
    Begin
      WriteLn('[ERROR] Destination service "u', NewNorm, '.pas" already exists!'
      );
      Exit;
    End;

  Content := ReadFileToString(OldFile);
  Content := StringReplace(Content, 'unit u' + OldNorm + ';', 'unit u' + NewNorm
             + ';', [rfIgnoreCase]);
  Content := StringReplace(Content, 'T' + OldNorm + ' ', 'T' + NewNorm + ' ', [
             rfReplaceAll]);
  Content := StringReplace(Content, 'T' + OldNorm + '.', 'T' + NewNorm + '.', [
             rfReplaceAll]);
  Content := StringReplace(Content, 'T' + OldNorm + '=', 'T' + NewNorm + '=', [
             rfReplaceAll]);
  Content := StringReplace(Content, 'T' + OldNorm + ':', 'T' + NewNorm + ':', [
             rfReplaceAll]);
  Content := StringReplace(Content, 'T' + OldNorm + ';', 'T' + NewNorm + ';', [
             rfReplaceAll]);
  Content := StringReplace(Content, 'T' + OldNorm + ')', 'T' + NewNorm + ')', [
             rfReplaceAll]);
  Content := StringReplace(Content, OldNorm + 'Helper', NewNorm + 'Helper', [
             rfReplaceAll]);
  WriteStringToFile(NewFile, Content);
  DeleteFile(OldFile);
  WriteLn('Service renamed: src/services/u', OldNorm, '.pas -> src/services/u',
          NewNorm, '.pas');

  // Associated Test
  TestPath := GetCurrentDir + DirectorySeparator + 'tests' + DirectorySeparator
              + 'services' + DirectorySeparator;
  OldTest := TestPath + OldNorm + '.test.pas';
  NewTest := TestPath + NewNorm + '.test.pas';
  If Not FileExists(OldTest) And FileExists(GetCurrentDir + DirectorySeparator +
     'tests' + DirectorySeparator + 'unit' + DirectorySeparator + OldNorm +
     '.test.pas') Then
    Begin
      TestPath := GetCurrentDir + DirectorySeparator + 'tests' +
                  DirectorySeparator + 'unit' + DirectorySeparator;
      OldTest := TestPath + OldNorm + '.test.pas';
      NewTest := GetCurrentDir + DirectorySeparator + 'tests' +
                 DirectorySeparator + 'services' + DirectorySeparator + NewNorm
                 + '.test.pas';
      ForceDir(GetCurrentDir + DirectorySeparator + 'tests' + DirectorySeparator
               + 'services');
    End;

  If FileExists(OldTest) Then
    Begin
      TestContent := ReadFileToString(OldTest);
      TestContent := StringReplace(TestContent, 'program ' + LowerCase(OldNorm)
                     + '_unit_test;', 'program ' + LowerCase(NewNorm) +
                     '_unit_test;', [rfIgnoreCase]);
      TestContent := StringReplace(TestContent, 'u' + OldNorm, 'u' + NewNorm, [
                     rfReplaceAll]);
      TestContent := StringReplace(TestContent, 'T' + OldNorm, 'T' + NewNorm, [
                     rfReplaceAll]);
      TestContent := StringReplace(TestContent, 'Unit: ' + OldNorm, 'Service: '
                     + NewNorm, [rfReplaceAll]);
      TestContent := StringReplace(TestContent, 'Service: ' + OldNorm,
                     'Service: ' + NewNorm, [rfReplaceAll]);
      TestContent := StringReplace(TestContent, OldNorm + 'Helper', NewNorm +
                     'Helper', [rfReplaceAll]);
      WriteStringToFile(NewTest, TestContent);
      DeleteFile(OldTest);
      WriteLn('Test renamed: ', ExtractRelativePath(GetCurrentDir +
              DirectorySeparator, OldTest), ' -> tests/services/', NewNorm,
      '.test.pas');
    End;

  // Clean stale generated artifacts
  GenOldPas := GetCurrentDir + DirectorySeparator + 'generated' +
               DirectorySeparator + 'u' + OldNorm + '.pas';
  If FileExists(GenOldPas) Then DeleteFile(GenOldPas);
  GenOldJs := GetCurrentDir + DirectorySeparator + 'generated' +
              DirectorySeparator + 'tests' + DirectorySeparator + 'services' +
              DirectorySeparator + OldNorm + '.test.js';
  If FileExists(GenOldJs) Then DeleteFile(GenOldJs);
  GenOldJs := GetCurrentDir + DirectorySeparator + 'generated' +
              DirectorySeparator + 'tests' + DirectorySeparator + 'unit' +
              DirectorySeparator + OldNorm + '.test.js';
  If FileExists(GenOldJs) Then DeleteFile(GenOldJs);
End;




{ Renames a .bv component across all project usages and template references (bv rename c). }
Procedure CmdRenameComponent(Const OldName, NewName: String);

Var 
  CompPath, OldFile, NewFile: string;
  OldTag, NewTag: string;
  TestPath, OldTest, NewTest, TestContent: string;
  GenOldPas, GenOldJs: string;
Begin
  CompPath := GetCurrentDir + DirectorySeparator + 'src' + DirectorySeparator +
              'components' + DirectorySeparator;
  OldFile := CompPath + OldName + '.bv';
  NewFile := CompPath + NewName + '.bv';
  If Not FileExists(OldFile) Then
    Begin
      WriteLn('[ERROR] Component "', OldName,
              '.bv" not found in src/components/');
      Exit;
    End;

  If FileExists(NewFile) Then
    Begin
      WriteLn('[ERROR] Destination component "', NewName, '.bv" already exists!'
      );
      Exit;
    End;

  WriteStringToFile(NewFile, ReadFileToString(OldFile));
  DeleteFile(OldFile);
  WriteLn('Component renamed: src/components/', OldName,
          '.bv -> src/components/', NewName, '.bv');
  OldTag := PascalToKebab(OldName);
  NewTag := PascalToKebab(NewName);
  WriteLn('HTML tag updated: <', OldTag, '> -> <', NewTag, '>');

  // Associated Test
  TestPath := GetCurrentDir + DirectorySeparator + 'tests' + DirectorySeparator
              + 'components' + DirectorySeparator;
  OldTest := TestPath + OldName + '.test.pas';
  NewTest := TestPath + NewName + '.test.pas';
  If FileExists(OldTest) Then
    Begin
      TestContent := ReadFileToString(OldTest);
      TestContent := StringReplace(TestContent, 'program ' + LowerCase(OldName)
                     + '_test;', 'program ' + LowerCase(NewName) + '_test;', [
                     rfIgnoreCase]);
      TestContent := StringReplace(TestContent, 'u' + OldName, 'u' + NewName, [
                     rfReplaceAll]);
      TestContent := StringReplace(TestContent, 'Register_u' + OldName,
                     'Register_u' + NewName, [rfReplaceAll]);
      TestContent := StringReplace(TestContent, 'Component: ' + OldName,
                     'Component: ' + NewName, [rfReplaceAll]);
      TestContent := StringReplace(TestContent, '''' + OldTag + '''', '''' +
                     NewTag + '''', [rfReplaceAll]);
      WriteStringToFile(NewTest, TestContent);
      DeleteFile(OldTest);
      WriteLn('Test renamed: tests/components/', OldName,
              '.test.pas -> tests/components/', NewName, '.test.pas');
    End;

  // Clean stale generated artifacts
  GenOldPas := GetCurrentDir + DirectorySeparator + 'generated' +
               DirectorySeparator + 'u' + OldName + '.pas';
  If FileExists(GenOldPas) Then DeleteFile(GenOldPas);
  GenOldJs := GetCurrentDir + DirectorySeparator + 'generated' +
              DirectorySeparator + 'tests' + DirectorySeparator + 'components' +
              DirectorySeparator + OldName + '.test.js';
  If FileExists(GenOldJs) Then DeleteFile(GenOldJs);
End;

{ Renames an SPA view and updates its route in App.pas (bv rename v). }
Procedure CmdRenameView(Const OldName, NewName: String);

Var 
  ViewPath, OldFile, NewFile: string;
  OldTag, NewTag, OldKebab, NewKebab: string;
  TestPath, OldTest, NewTest, TestContent: string;
  AppBvPath, AppContent: string;
  GenOldPas, GenOldJs: string;
Begin
  ViewPath := GetCurrentDir + DirectorySeparator + 'src' + DirectorySeparator +
              'views' + DirectorySeparator;
  OldFile := ViewPath + OldName + '.bv';
  NewFile := ViewPath + NewName + '.bv';
  If Not FileExists(OldFile) Then
    Begin
      WriteLn('[ERROR] View "', OldName, '.bv" not found in src/views/');
      Exit;
    End;

  If FileExists(NewFile) Then
    Begin
      WriteLn('[ERROR] Destination view "', NewName, '.bv" already exists!');
      Exit;
    End;

  WriteStringToFile(NewFile, ReadFileToString(OldFile));
  DeleteFile(OldFile);
  WriteLn('View renamed: src/views/', OldName, '.bv -> src/views/', NewName,
          '.bv');
  OldKebab := PascalToKebab(OldName);
  NewKebab := PascalToKebab(NewName);
  OldTag := OldKebab + '-page';
  NewTag := NewKebab + '-page';

  // Associated Test
  TestPath := GetCurrentDir + DirectorySeparator + 'tests' + DirectorySeparator
              + 'views' + DirectorySeparator;
  OldTest := TestPath + OldName + '.test.pas';
  NewTest := TestPath + NewName + '.test.pas';
  If FileExists(OldTest) Then
    Begin
      TestContent := ReadFileToString(OldTest);
      TestContent := StringReplace(TestContent, 'program ' + LowerCase(OldName)
                     + '_view_test;', 'program ' + LowerCase(NewName) +
                     '_view_test;', [rfIgnoreCase]);
      TestContent := StringReplace(TestContent, 'u' + OldName, 'u' + NewName, [
                     rfReplaceAll]);
      TestContent := StringReplace(TestContent, 'Register_u' + OldName,
                     'Register_u' + NewName, [rfReplaceAll]);
      TestContent := StringReplace(TestContent, 'View: ' + OldName, 'View: ' +
                     NewName, [rfReplaceAll]);
      TestContent := StringReplace(TestContent, '''' + OldTag + '''', '''' +
                     NewTag + '''', [rfReplaceAll]);
      WriteStringToFile(NewTest, TestContent);
      DeleteFile(OldTest);
      WriteLn('Test renamed: tests/views/', OldName, '.test.pas -> tests/views/'
              , NewName, '.test.pas');
    End;

  // Auto-update router in src/app.bv
  AppBvPath := GetCurrentDir + DirectorySeparator + 'src' + DirectorySeparator +
               'app.bv';
  If FileExists(AppBvPath) Then
    Begin
      AppContent := ReadFileToString(AppBvPath);
      If Pos(OldTag, AppContent) > 0 Then
        Begin
          AppContent := StringReplace(AppContent, '''' + OldTag + '''', '''' +
                        NewTag + '''', [rfReplaceAll]);
          WriteStringToFile(AppBvPath, AppContent);
          WriteLn('Router updated in src/app.bv: ''', OldTag, ''' -> ''', NewTag
                  , '''');
        End;
    End;

  // Clean stale generated artifacts
  GenOldPas := GetCurrentDir + DirectorySeparator + 'generated' +
               DirectorySeparator + 'u' + OldName + '.pas';
  If FileExists(GenOldPas) Then DeleteFile(GenOldPas);
  GenOldJs := GetCurrentDir + DirectorySeparator + 'generated' +
              DirectorySeparator + 'tests' + DirectorySeparator + 'views' +
              DirectorySeparator + OldName + '.test.js';
  If FileExists(GenOldJs) Then DeleteFile(GenOldJs);
End;




{ Renames a BlaiseX store slice across src/stores/ and tests/stores/ (bv rename store). }
Procedure CmdRenameStore(Const OldName, NewName: String);

Var 
  OldNorm, NewNorm, OldLower, NewLower: string;
  StorePath, OldFile, NewFile, Content: string;
  TestPath, OldTest, NewTest, TestContent: string;
  GenOldPas, GenOldJs: string;
Begin
  RequireBlaiseVueProject('bv rename store');

  OldNorm := OldName;
  If (Length(OldNorm) > 1) And ((OldNorm[1] = 'u') Or (OldNorm[1] = 'U')) And (
     OldNorm[2] In ['A'..'Z']) Then
    OldNorm := Copy(OldNorm, 2, Length(OldNorm) - 1);
  If (Length(OldNorm) > 5) And (LowerCase(Copy(OldNorm, Length(OldNorm) - 4, 5))
     = 'store') Then
    OldNorm := Copy(OldNorm, 1, Length(OldNorm) - 5);

  NewNorm := NewName;
  If (Length(NewNorm) > 1) And ((NewNorm[1] = 'u') Or (NewNorm[1] = 'U')) And (
     NewNorm[2] In ['A'..'Z']) Then
    NewNorm := Copy(NewNorm, 2, Length(NewNorm) - 1);
  If (Length(NewNorm) > 5) And (LowerCase(Copy(NewNorm, Length(NewNorm) - 4, 5))
     = 'store') Then
    NewNorm := Copy(NewNorm, 1, Length(NewNorm) - 5);

  OldLower := LowerCase(OldNorm);
  NewLower := LowerCase(NewNorm);

  StorePath := GetCurrentDir + DirectorySeparator + 'src' + DirectorySeparator +
               'stores' + DirectorySeparator;
  OldFile := StorePath + 'u' + OldNorm + 'Store.pas';
  NewFile := StorePath + 'u' + NewNorm + 'Store.pas';

  If Not FileExists(OldFile) Then
    Begin
      WriteLn('[ERROR] Store "u', OldNorm, 'Store.pas" not found in src/stores/'
      );
      Exit;
    End;

  If FileExists(NewFile) Then
    Begin
      WriteLn('[ERROR] Destination store "u', NewNorm,
              'Store.pas" already exists!');
      Exit;
    End;

  Content := ReadFileToString(OldFile);
  Content := StringReplace(Content, 'unit u' + OldNorm + 'Store;', 'unit u' +
             NewNorm + 'Store;', [rfIgnoreCase]);
  Content := StringReplace(Content, 'Init' + OldNorm + 'Store', 'Init' + NewNorm
             + 'Store', [rfReplaceAll]);
  Content := StringReplace(Content, 'DefineStore(''' + OldLower + '''',
             'DefineStore(''' + NewLower + '''', [rfReplaceAll]);
  Content := StringReplace(Content, '''' + OldLower + '''', '''' + NewLower +
             '''', [rfReplaceAll]);
  Content := StringReplace(Content, OldNorm + ' store slice', NewNorm +
             ' store slice', [rfReplaceAll]);
  Content := StringReplace(Content, OldNorm + ' Store', NewNorm + ' Store', [
             rfReplaceAll]);
  WriteStringToFile(NewFile, Content);
  DeleteFile(OldFile);
  WriteLn('Store renamed: src/stores/u', OldNorm, 'Store.pas -> src/stores/u',
          NewNorm, 'Store.pas');

  // Associated Test
  TestPath := GetCurrentDir + DirectorySeparator + 'tests' + DirectorySeparator
              + 'stores' + DirectorySeparator;
  OldTest := TestPath + OldNorm + 'Store.test.pas';
  NewTest := TestPath + NewNorm + 'Store.test.pas';
  If FileExists(OldTest) Then
    Begin
      TestContent := ReadFileToString(OldTest);
      TestContent := StringReplace(TestContent, 'program ' + OldLower +
                     '_store_test;', 'program ' + NewLower + '_store_test;', [
                     rfIgnoreCase]);
      TestContent := StringReplace(TestContent, 'u' + OldNorm + 'Store', 'u' +
                     NewNorm + 'Store', [rfReplaceAll]);
      TestContent := StringReplace(TestContent, 'Store Slice: ' + OldNorm,
                     'Store Slice: ' + NewNorm, [rfReplaceAll]);
      TestContent := StringReplace(TestContent, 'GetStore(''' + OldLower + ''')'
                     , 'GetStore(''' + NewLower + ''')', [rfReplaceAll]);
      WriteStringToFile(NewTest, TestContent);
      DeleteFile(OldTest);
      WriteLn('Test renamed: tests/stores/', OldNorm,
              'Store.test.pas -> tests/stores/', NewNorm, 'Store.test.pas');
    End;

  // Clean stale generated artifacts
  GenOldPas := GetCurrentDir + DirectorySeparator + 'generated' +
               DirectorySeparator + 'stores' + DirectorySeparator + 'u' +
               OldNorm + 'Store.pas';
  If FileExists(GenOldPas) Then DeleteFile(GenOldPas);
  GenOldJs := GetCurrentDir + DirectorySeparator + 'generated' +
              DirectorySeparator + 'tests' + DirectorySeparator + 'stores' +
              DirectorySeparator + OldNorm + 'Store.test.js';
  If FileExists(GenOldJs) Then DeleteFile(GenOldJs);
End;




{ Renames a finite state machine across src/machines/ and tests/machines/ (bv rename fsm). }
Procedure CmdRenameFSM(Const OldName, NewName: String);

Var 
  OldNorm, NewNorm, OldLower, NewLower: string;
  FSMPath, OldFile, NewFile, Content: string;
  TestPath, OldTest, NewTest, TestContent: string;
  GenOldPas, GenOldJs: string;
Begin
  RequireBlaiseVueProject('bv rename fsm');

  OldNorm := OldName;
  If (Length(OldNorm) > 1) And ((OldNorm[1] = 'u') Or (OldNorm[1] = 'U')) And (
     OldNorm[2] In ['A'..'Z']) Then
    OldNorm := Copy(OldNorm, 2, Length(OldNorm) - 1);
  If (Length(OldNorm) > 7) And (LowerCase(Copy(OldNorm, Length(OldNorm) - 6, 7))
     = 'machine') Then
    OldNorm := Copy(OldNorm, 1, Length(OldNorm) - 7);
  If (Length(OldNorm) > 3) And (LowerCase(Copy(OldNorm, Length(OldNorm) - 2, 3))
     = 'fsm') Then
    OldNorm := Copy(OldNorm, 1, Length(OldNorm) - 3);

  NewNorm := NewName;
  If (Length(NewNorm) > 1) And ((NewNorm[1] = 'u') Or (NewNorm[1] = 'U')) And (
     NewNorm[2] In ['A'..'Z']) Then
    NewNorm := Copy(NewNorm, 2, Length(NewNorm) - 1);
  If (Length(NewNorm) > 7) And (LowerCase(Copy(NewNorm, Length(NewNorm) - 6, 7))
     = 'machine') Then
    NewNorm := Copy(NewNorm, 1, Length(NewNorm) - 7);
  If (Length(NewNorm) > 3) And (LowerCase(Copy(NewNorm, Length(NewNorm) - 2, 3))
     = 'fsm') Then
    NewNorm := Copy(NewNorm, 1, Length(NewNorm) - 3);

  OldLower := LowerCase(OldNorm);
  NewLower := LowerCase(NewNorm);

  FSMPath := GetCurrentDir + DirectorySeparator + 'src' + DirectorySeparator +
             'machines' + DirectorySeparator;
  OldFile := FSMPath + 'u' + OldNorm + 'Machine.pas';
  NewFile := FSMPath + 'u' + NewNorm + 'Machine.pas';

  If Not FileExists(OldFile) Then
    Begin
      WriteLn('[ERROR] Finite State Machine "u', OldNorm,
              'Machine.pas" not found in src/machines/');
      Exit;
    End;

  If FileExists(NewFile) Then
    Begin
      WriteLn('[ERROR] Destination FSM "u', NewNorm,
              'Machine.pas" already exists!');
      Exit;
    End;

  Content := ReadFileToString(OldFile);
  Content := StringReplace(Content, 'unit u' + OldNorm + 'Machine;', 'unit u' +
             NewNorm + 'Machine;', [rfIgnoreCase]);
  Content := StringReplace(Content, 'Create' + OldNorm + 'Machine', 'Create' +
             NewNorm + 'Machine', [rfReplaceAll]);
  Content := StringReplace(Content, 'TBVStateMachine.Create(''' + OldLower +
             'Machine'')', 'TBVStateMachine.Create(''' + NewLower + 'Machine'')'
             , [rfReplaceAll]);
  Content := StringReplace(Content, 'TBVStateMachine.Create(''' + OldNorm +
             ''')', 'TBVStateMachine.Create(''' + NewNorm + ''')', [rfReplaceAll
             ]);
  Content := StringReplace(Content, '''' + OldLower + 'Machine''', '''' +
             NewLower + 'Machine''', [rfReplaceAll]);
  Content := StringReplace(Content, OldNorm + ' finite state machine', NewNorm +
             ' finite state machine', [rfReplaceAll]);
  WriteStringToFile(NewFile, Content);
  DeleteFile(OldFile);
  WriteLn('FSM renamed: src/machines/u', OldNorm,
          'Machine.pas -> src/machines/u', NewNorm, 'Machine.pas');

  // Associated Test
  TestPath := GetCurrentDir + DirectorySeparator + 'tests' + DirectorySeparator
              + 'machines' + DirectorySeparator;
  OldTest := TestPath + OldNorm + 'Machine.test.pas';
  NewTest := TestPath + NewNorm + 'Machine.test.pas';
  If FileExists(OldTest) Then
    Begin
      TestContent := ReadFileToString(OldTest);
      TestContent := StringReplace(TestContent, 'program ' + OldLower +
                     '_machine_test;', 'program ' + NewLower + '_machine_test;',
                     [rfIgnoreCase]);
      TestContent := StringReplace(TestContent, 'u' + OldNorm + 'Machine', 'u' +
                     NewNorm + 'Machine', [rfReplaceAll]);
      TestContent := StringReplace(TestContent, 'Create' + OldNorm + 'Machine',
                     'Create' + NewNorm + 'Machine', [rfReplaceAll]);
      TestContent := StringReplace(TestContent, 'Finite State Machine: ' +
                     OldNorm, 'Finite State Machine: ' + NewNorm, [rfReplaceAll]
                     );
      WriteStringToFile(NewTest, TestContent);
      DeleteFile(OldTest);
      WriteLn('Test renamed: tests/machines/', OldNorm,
              'Machine.test.pas -> tests/machines/', NewNorm, 'Machine.test.pas'
      );
    End;

  // Clean stale generated artifacts
  GenOldPas := GetCurrentDir + DirectorySeparator + 'generated' +
               DirectorySeparator + 'machines' + DirectorySeparator + 'u' +
               OldNorm + 'Machine.pas';
  If FileExists(GenOldPas) Then DeleteFile(GenOldPas);
  GenOldJs := GetCurrentDir + DirectorySeparator + 'generated' +
              DirectorySeparator + 'tests' + DirectorySeparator + 'machines' +
              DirectorySeparator + OldNorm + 'Machine.test.js';
  If FileExists(GenOldJs) Then DeleteFile(GenOldJs);
End;




