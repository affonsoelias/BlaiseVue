{
  This subsystem orchestrates the complete Pascal compilation artifacts by
  assembling the sub-blocks produced by the Member Generators above:
  - GenerateComponentUnit: Assembles a complete, standalone Pascal unit
                           (unit U<Name>; interface ... implementation ...)
                           for each Single File Component (.bv)
  - GenerateAppUnit:       Assembles the application root unit (App.pas),
                           registering all component tags, router, and root state
  - GenerateMainProgram:   Assembles the main application entry point (program MyApp;)
}

{ Generates a Pascal unit from a standard .bv component }

Function GenerateComponentUnit(Const UnitName, TagName, BVFileName: String;
                               Const Parsed: TBVParsed): string;

Var 
  UsesLine, TypedThisCode: string;
Begin
  UsesLine := 


'JS, Web, BVComponents, BVReactivity, BVStore, BVFSM, SysUtils, BVPascalDX, BVDataSet'
  ;
  If Parsed.HasRouter Then
    UsesLine := UsesLine + ', BVRouting';

  If Parsed.WasmModuleName <> '' Then
    UsesLine := UsesLine + ', BVWasm';

  If Parsed.DelSafeLogicUnit <> '' Then
    UsesLine := UsesLine + ', uDelSafeRuntime, ' + Parsed.DelSafeLogicUnit;

  If Parsed.ScriptUses <> '' Then
    UsesLine := UsesLine + ', ' + Parsed.ScriptUses;

  TypedThisCode := GenerateComponentThisType(Parsed.DataFields);

  Result := 

            'unit ' + UnitName + ';' + #10 +

            #10 +

            '{$mode objfpc}' + #10 +
            '{$modeswitch externalclass}' + #10 +
            '{$COPERATORS ON}' + #10 +

            #10 +

            'interface' + #10 +

            #10 +

            'uses ' + UsesLine + ';' + #10 +

            #10 +

            'procedure Register_' + UnitName + ';' + #10 +

            #10 +

            'implementation' + #10 +

            #10 +

            TypedThisCode +

            'procedure Register_' + UnitName + ';' + #10 +

            'var' + #10 +

            '  comp: TJSObject;' + #10 +

            '  m: TJSObject;' + #10 +

            '  _styleEl: TJSHTMLElement;' + #10 +

            'begin' + #10 +

            GenerateStyleInjection(Parsed.Style) +

            '  comp := TJSObject.new;' + #10 +

            '  comp[''template''] :=' + #10 +

            GenerateTemplateString(Parsed.Template) + ';' + #10 +

            #10 +

            GenerateDataCode(Parsed.DataFields) + #10 +

            GeneratePropsCode(Parsed.DataFields) + #10 +

            '  m := TJSObject.new;' + #10 +

            GenerateMethodsCodeTyped(Parsed.MethodsCode, Parsed.DataFields) +

            '  comp[''methods''] := m;' + #10 +

            #10 +

            GenerateLifecycleCodeTyped('created', Parsed.CreatedCode, Parsed.
            DataFields) +

            GenerateLifecycleCodeTyped('mounted', Parsed.MountedCode, Parsed.
            DataFields) +

            GenerateLifecycleCodeTyped('updated', Parsed.UpdatedCode, Parsed.
            DataFields) +

            GenerateWatchCode(Parsed.WatchCode) +

            GenerateComputedCodeTyped(Parsed.ComputedCode, Parsed.DataFields) +

            GenerateProvideCode(Parsed.ProvideCode) +

            GenerateInjectCode(Parsed.InjectCode) +

            '  RegisterComponent(''' + TagName + ''', comp);' + #10;

  If TagName = 'bv-data-grid' Then
    Result := Result + '  RegisterComponent(''bv-datagrid'', comp);' + #10;

  If TagName = 'bv-virtual-scroll' Then
    Result := Result + '  RegisterComponent(''bv-virtualscroll'', comp);' + #10;

  If TagName = 'bv-virtualscroll' Then
    Result := Result + '  RegisterComponent(''bv-virtual-scroll'', comp);' + #10
  ;

  If TagName = 'data-set-view-page' Then
    Result := Result + '  RegisterComponent(''dataset-view-page'', comp);' + #10
  ;

  If TagName = 'dataset-view-page' Then
    Result := Result + '  RegisterComponent(''data-set-view-page'', comp);' + #10;

  Result := Result +

            'end;' + #10 +

            #10 +

            'end.' + #10;
End;




{ Generates the root application unit (app.bv) which handles global state and routing }

Function GenerateAppUnit(Const Parsed: TBVParsed; Const AllUnits: TStringList):


                                                                          string
;

Var 
  UsesLine, RouteCode, DataCode, Val, TypedThisCode: string;
  UniqueUnits: TStringList;
  i: Integer;
Begin
  UniqueUnits := TStringList.Create;
  Try

    UsesLine := 


'JS, Web, BlaiseVue, BVComponents, BVStore, BVFSM, BVCompiler, BVDevTools, BVPascalDX, BVDataSet'
    ;
    If Parsed.HasRouter Then
      UsesLine := UsesLine + ', BVRouting';

    If Parsed.DelSafeLogicUnit <> '' Then
      UsesLine := UsesLine + ', uDelSafeRuntime, ' + Parsed.DelSafeLogicUnit;

    If Parsed.ScriptUses <> '' Then
      UsesLine := UsesLine + ', ' + Parsed.ScriptUses;

    // Automatically import all compiled component units for auto-registration

    For i := 0 To AllUnits.Count - 1 Do
      Begin
        If (AllUnits[i] <> 'uApp') And (UniqueUnits.IndexOf(AllUnits[i]) < 0)
          Then
          Begin
            UniqueUnits.Add(AllUnits[i]);
            UsesLine := UsesLine + ', ' + AllUnits[i];
          End;
      End;

    // Data fields

    DataCode := '';
    If Length(Parsed.DataFields) > 0 Then
      Begin
        DataCode := '  data := TJSObject.new;' + #10;
        For i := 0 To High(Parsed.DataFields) Do
          Begin
            Val := Parsed.DataFields[i].DefaultValue;
            If Trim(Val) = '[]' Then Val := 'TJSArray.new'

            Else If Trim(Val) = '{}' Then Val := 'TJSObject.new';

            DataCode := DataCode + '  data[''' + Parsed.DataFields[i].Name +
                        '''] := ' +

                        Val + ';' + #10;
          End;
      End

    Else
      DataCode := '  data := TJSObject.new;' + #10;

    // Router setup

    RouteCode := '';
    If Parsed.HasRouter And (Length(Parsed.Routes) > 0) Then
      Begin
        RouteCode := 

                     '  routerOpts := TJSObject.new;' + #10 +

                     '  routesArr := TJSArray.new;' + #10 + #10;

        For i := 0 To High(Parsed.Routes) Do
          RouteCode := RouteCode +

                       '  r := TJSObject.new;' + #10 +

                       '  r[''path''] := ''' + Parsed.Routes[i].Path + ''';' + #10 +

                       '  r[''component''] := ''' + Parsed.Routes[i].Component +
                       ''';' + #10 +

                       '  routesArr.push(r);' + #10 + #10;

        RouteCode := RouteCode +

                     '  routerOpts[''routes''] := routesArr;' + #10 +

                     '  router := TBVRouter.Create(routerOpts);' + #10;
      End;

    TypedThisCode := GenerateComponentThisType(Parsed.DataFields);

    Result := 

              'unit uApp;' + #10 +

              #10 +

              '{$mode objfpc}' + #10 +
              '{$modeswitch externalclass}' + #10 +
              '{$COPERATORS ON}' + #10 +

              #10 +

              'interface' + #10 +

              #10 +

              'uses ' + UsesLine + ';' + #10 +

              #10 +

              'procedure Init_App;' + #10 +

              #10 +

              'implementation' + #10 +

              #10 +

              TypedThisCode +

              'procedure Init_App;' + #10 +

              'var' + #10 +

              '  data, methods, opts: TJSObject;' + #10 +

              '  app: TBlaiseVue;' + #10 +

              '  comp: TJSObject;' + #10 +

              '  m: TJSObject;' + #10 +

              '  _styleEl: TJSHTMLElement;' + #10;

    If Parsed.HasRouter Then
      Result := Result +

                '  routerOpts: TJSObject;' + #10 +

                '  routesArr: TJSArray;' + #10 +

                '  r: TJSObject;' + #10 +

                '  router: TBVRouter;' + #10;

    Result := Result +

              'begin' + #10 +

              '  asm console.log("[Init] Initing App..."); end;' + #10 +

              '  asm' + #10 +

              '    window.onerror = function(msg, url, line, col, error) {' + #10 +




'      document.body.innerHTML = ''<div style="background:red; color:white; padding:20px; font-family:monospace; position:fixed; top:0; left:0; width:100%; height:100%; z-index:10000;">'''
              + #10 +

              '        + ''<h1>[BlaiseVue] ERROR</h1>''' + #10 +

              '        + ''<p><b>Msg:</b> '' + msg + ''</p>''' + #10 +




    '        + ''<p><b>Line:</b> '' + line + '' <b>Col:</b> '' + col + ''</p>'''
              + #10 +




'        + ''<p><b>Stack:</b><br><pre>'' + (error ? error.stack : ''N/A'') + ''</pre></p></div>'';'
              + #10 +

              '    };' + #10 +

              '  end;' + #10 +

              '  asm console.log("[Init] Injecting Styles..."); end;' + #10 +

              GenerateStyleInjection(Parsed.Style);

    // Register components

    For i := 0 To UniqueUnits.Count - 1 Do
      Begin
        Result := Result + '  asm console.log("[Init] Registering ' +
                  UniqueUnits[i] + '..."); end;' + #10 +

                  '  ' + 'Register_' + UniqueUnits[i] + ';' + #10;
      End;

    Result := Result + #10;

    // Root template (register as invisible component and set innerHTML)

    Result := Result + #10;

    // Root template (registers as invisible component and sets innerHTML)

    Result := Result +

              '  asm console.log("[Init] Setting #app template..."); end;' + #10
              +

              '  TJSHTMLElement(document.querySelector(''#app'')).innerHTML :='
              + #10 +

              GenerateTemplateString(Parsed.Template) + ';' + #10 + #10;

    // Data

    Result := Result + DataCode + #10;

    // Methods

    Result := Result + '  methods := TJSObject.new;' + #10 +

              '  m := methods;' + #10 +

              GenerateMethodsCodeTyped(Parsed.MethodsCode, Parsed.DataFields) + #10;

    // Options (Lifecycle, Watch & Computed)

    Result := Result + '  opts := TJSObject.new;' + #10 +

              '  comp := opts;' + #10 +

              GenerateLifecycleCodeTyped('created', Parsed.CreatedCode,
              Parsed.DataFields) +

              GenerateLifecycleCodeTyped('mounted', Parsed.MountedCode,
              Parsed.DataFields) +

              GenerateLifecycleCodeTyped('updated', Parsed.UpdatedCode,
              Parsed.DataFields);

    Result := Result +

              GenerateWatchCode(Parsed.WatchCode) +

              GenerateComputedCodeTyped(Parsed.ComputedCode, Parsed.DataFields) +

              GenerateProvideCode(Parsed.ProvideCode) +

              GenerateInjectCode(Parsed.InjectCode);

    // Router

    If RouteCode <> '' Then
      Result := Result + RouteCode + #10;

    // Instantiate application

    Result := Result +

              '  app := TBlaiseVue.Create(''#app'', data, methods, opts);' + #10
    ;

    If Parsed.HasRouter Then
      Result := Result +

                '  app.UseRouter(router);' + #10

    Else
      // Without router: compile root template directly

      Result := Result +




'  Compile(TJSHTMLElement(document.querySelector(''#app'')), app.Data, methods);'
                + #10;

    Result := Result +

              'end;' + #10 +

              #10 +

              'end.' + #10;

  Finally

    UniqueUnits.Free;
End;
End;

{ Generates the main entry point program (main.pas) }

Function GenerateMainProgram: string;
Begin
  Result := 

            'program main;' + #10 +

            #10 +

            '{$mode objfpc}' + #10 +

            #10 +

            'uses uApp;' + #10 +

            #10 +

            'begin' + #10 +

            '  Init_App;' + #10 +

