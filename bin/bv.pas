//  ENTERPRISE THEME MANAGER & BUILD-TIME FILTERING SUITE (bv theme)
// =====================================================================




{ Checks whether the @blaise-themes package or themes folder is installed in the project. }
Function IsThemeLibraryInstalled: Boolean;
Begin
  Result := DirectoryExists(GetCurrentDir + DirectorySeparator + 'lib' +
            DirectorySeparator + 'themes') Or
            DirectoryExists(GetCurrentDir + DirectorySeparator + 'lib' +
            DirectorySeparator + 'blaise-themes') Or
            DirectoryExists(GetPackagesPath + 'blaise-themes');
End;




{ Collects available Bootswatch and custom theme names from installed libraries or SDK packages. }
Procedure GetAvailableThemesList(List: TStringList);

Var 
  SR: TSearchRec;
  ScanPath: string;
Begin
  List.Clear;
  ScanPath := GetCurrentDir + DirectorySeparator + 'lib' + DirectorySeparator +
              'themes';
  If Not DirectoryExists(ScanPath) Then
    ScanPath := GetCurrentDir + DirectorySeparator + 'lib' + DirectorySeparator
                + 'blaise-themes' + DirectorySeparator + 'themes';
  If Not DirectoryExists(ScanPath) Then
    ScanPath := GetPackagesPath + 'blaise-themes' + DirectorySeparator +
                'themes';

  If DirectoryExists(ScanPath) And (FindFirst(ScanPath + DirectorySeparator +
     '*.min.css', faAnyFile, SR) = 0) Then
    Begin
      Repeat
        List.Add(LowerCase(StringReplace(SR.Name, '.min.css', '', [rfIgnoreCase]
        )));
      Until FindNext(SR) <> 0;
      FindClose(SR);
    End;

  If List.Count = 0 Then
    Begin
      List.Add('cosmo');
      List.Add('cyborg');
      List.Add('darkly');
      List.Add('flatly');
      List.Add('lux');
      List.Add('pulse');
      List.Add('solar');
      List.Add('vapor');
      List.Add('zephyr');
    End;
End;




{ Reads the default theme and configured themes array from package.json. Returns True if "themes" is explicitly configured. }
Function GetProjectThemesConfig(out DefaultTheme: String; ConfiguredThemes:
                                TStringList): Boolean;

Var 
  JsonObj: TJSONObject;
  ThemesData, ThemeData: TJSONData;
  ThemesArr: TJSONArray;
  i: Integer;
Begin
  Result := False;
  DefaultTheme := 'flatly';
  ConfiguredThemes.Clear;
  If Not LoadPackageJson(JsonObj) Then Exit;
  Try
    ThemeData := JsonObj.Find('theme');
    If (ThemeData <> Nil) And (ThemeData.JSONType = jtString) Then
      DefaultTheme := LowerCase(Trim(ThemeData.AsString));

    ThemesData := JsonObj.Find('themes');
    If (ThemesData <> Nil) And (ThemesData is TJSONArray) Then
      Begin
        ThemesArr := TJSONArray(ThemesData);
        For i := 0 To ThemesArr.Count - 1 Do
          Begin
            If ThemesArr.Items[i].JSONType = jtString Then
              ConfiguredThemes.Add(LowerCase(Trim(ThemesArr.Strings[i])));
          End;
        Result := True;
      End;
  Finally
    JsonObj.Free;
End;
End;

{ Identifies whether a CSS file path represents a Bootswatch theme stylesheet. }
Function IsThemeCSSFile(Const FilePath: String; out ThemeName: String): Boolean;

Var 
  BaseName: string;
Begin
  Result := False;
  ThemeName := '';
  BaseName := LowerCase(ExtractFileName(FilePath));
  If EndsText('.min.css', BaseName) Then
    Begin
      ThemeName := Copy(BaseName, 1, Length(BaseName) - 8);
      If (ThemeName = 'cosmo') Or (ThemeName = 'cyborg') Or (ThemeName =
         'darkly') Or
         (ThemeName = 'flatly') Or (ThemeName = 'lux') Or (ThemeName = 'pulse')
         Or
         (ThemeName = 'solar') Or (ThemeName = 'vapor') Or (ThemeName = 'zephyr'
         ) Or
         (Pos('themes', LowerCase(FilePath)) > 0) Then
        Result := True;
    End;
End;

{ Displays available Bootswatch and project-configured themes (bv theme list). }
Procedure CmdThemeList;
Begin
  CmdTheme('list');
End;




{ Applies a selected theme to index.html and project configuration (bv theme use). }
Procedure CmdThemeUse(Const ThemeName: String);

Var 
  IndexPath, Content, CleanName, NewLink: string;
  PStart, PEnd: Integer;
Begin
  CleanName := LowerCase(Trim(ThemeName));
  IndexPath := GetCurrentDir + DirectorySeparator + 'public' +
               DirectorySeparator + 'index.html';
  If Not FileExists(IndexPath) Then
    IndexPath := GetCurrentDir + DirectorySeparator + 'index.html';

  If Not FileExists(IndexPath) Then Exit;

  Content := ReadFileToString(IndexPath);
  NewLink := '<link id="bv-theme" rel="stylesheet" href="lib/themes/' +
             CleanName + '.min.css">';

  PStart := Pos('id="bv-theme"', Content);
  If PStart = 0 Then
    PStart := Pos('id=''bv-theme''', Content);

  If PStart > 0 Then
    Begin
      While (PStart > 1) And (Content[PStart] <> '<') Do
        Dec(PStart);
      PEnd := PStart;
      While (PEnd <= Length(Content)) And (Content[PEnd] <> '>') Do
        Inc(PEnd);
      Delete(Content, PStart, PEnd - PStart + 1);
      Insert(NewLink, Content, PStart);
    End
  Else
    Begin
      PStart := Pos('</head>', Content);
      If PStart = 0 Then
        PStart := Pos('</HEAD>', Content);

      If PStart > 0 Then
        Insert('    ' + NewLink + #10, Content, PStart)
      Else
        Content := Content + #10 + NewLink;
    End;

  WriteStringToFile(IndexPath, Content);
End;




{ Central controller for project theme configuration, package.json persistence, and build optimization. }
Procedure CmdTheme(Const SubCmd: String; Const ThemeArg: String);

Var 
  CleanCmd, CleanTheme, DefaultTheme: string;
  AvailThemes, ConfigThemes: TStringList;
  JsonObj: TJSONObject;
  ThemesArr: TJSONArray;
  ThemesData: TJSONData;
  i, FoundIdx: Integer;
  HasConfig: Boolean;
Begin
  RequireBlaiseVueProject('bv theme');
  CleanCmd := LowerCase(Trim(SubCmd));
  CleanTheme := LowerCase(Trim(ThemeArg));

  If Not IsThemeLibraryInstalled Then
    Begin
      WriteLn('');
      WriteLn(


         '  [!] Error: @blaise-themes library is not installed in this project.'
      );
      WriteLn(


           '      Run "bv lib install @blaise-themes" to install theme support.'
      );
      WriteLn('');
      Halt(1);
    End;

  AvailThemes := TStringList.Create;
  ConfigThemes := TStringList.Create;
  Try
    GetAvailableThemesList(AvailThemes);
    HasConfig := GetProjectThemesConfig(DefaultTheme, ConfigThemes);

    If (CleanCmd = '') Or (CleanCmd = 'list') Or (CleanCmd = 'status') Or (
       CleanCmd = 'show') Then
      Begin
        WriteLn('');
        WriteLn(


        '======================================================================'
        );
        WriteLn('  BlaiseVue Theme Manager');
        WriteLn(


        '======================================================================'
        );
        WriteLn('  Active Default Theme: "', DefaultTheme, '"');
        WriteLn('');
        If HasConfig And (ConfigThemes.Count > 0) Then
          Begin
            WriteLn(


        '  Configured Project Themes in package.json (Optimized build enabled):'
            );
            For i := 0 To ConfigThemes.Count - 1 Do
              WriteLn('    [v] ', ConfigThemes[i]);
          End
        Else
          Begin
            WriteLn('  Configured Project Themes:');
            WriteLn(


    '    [All supported - Full compatibility mode (all library themes bundled)]'
            );
          End;
        WriteLn('');
        WriteLn('  Available Catalog Themes in @blaise-themes:');
        WriteLn('    ' + StringReplace(AvailThemes.CommaText, ',', ', ', [
                rfReplaceAll]));
        WriteLn('');
        WriteLn('  Commands:');
        WriteLn(


     '    bv theme add <name>     - Add theme to project bundle in package.json'
        );
        WriteLn(


'    bv theme remove <name>  - Remove theme from project bundle in package.json'
        );
        WriteLn(


  '    bv theme use <name>     - Set active default theme and update index.html'
        );
        WriteLn(


  '    bv theme reset          - Bundle all themes (default compatibility mode)'
        );
        WriteLn(


        '======================================================================'
        );
        WriteLn('');
      End
    Else If CleanCmd = 'add' Then
           Begin
             If CleanTheme = '' Then
               Begin
                 WriteLn('Usage: bv theme add <theme-name>');
                 Halt(1);
               End;
             If AvailThemes.IndexOf(CleanTheme) < 0 Then
               Begin
                 WriteLn('  [!] Error: Unknown theme "', CleanTheme, '".');
                 WriteLn('      Available themes: ' + StringReplace(AvailThemes.
                         CommaText, ',', ', ', [rfReplaceAll]));
                 Halt(1);
               End;

             If Not LoadPackageJson(JsonObj) Then
               Begin
                 WriteLn(


                '  [!] Error: Could not read package.json in current directory.'
                 );
                 Halt(1);
               End;
             Try
               ThemesData := JsonObj.Find('themes');
               If (ThemesData = Nil) Or Not (ThemesData is TJSONArray) Then
                 Begin
                   If ThemesData <> Nil Then JsonObj.Delete(JsonObj.IndexOfName(
                                                            'themes'));
                   ThemesArr := TJSONArray.Create;
                   JsonObj.Add('themes', ThemesArr);
                   If (DefaultTheme <> '') And (DefaultTheme <> CleanTheme) Then
                     ThemesArr.Add(DefaultTheme);
                 End
               Else
                 ThemesArr := TJSONArray(ThemesData);

               FoundIdx := -1;
               For i := 0 To ThemesArr.Count - 1 Do
                 Begin
                   If LowerCase(ThemesArr.Strings[i]) = CleanTheme Then
                     Begin
                       FoundIdx := i;
                       Break;
                     End;
                 End;

               If FoundIdx >= 0 Then
                 WriteLn('  [*] Theme "', CleanTheme,
                         '" is already configured in package.json.')
               Else
                 Begin
                   ThemesArr.Add(CleanTheme);
                   SavePackageJson(JsonObj);
                   WriteLn('  [+] Added theme "', CleanTheme,
                           '" to themes in package.json.');
                 End;
             Finally
               JsonObj.Free;
           End;
End
Else If (CleanCmd = 'remove') Or (CleanCmd = 'rm') Or (CleanCmd = 'del') Then
       Begin
         If CleanTheme = '' Then
           Begin
             WriteLn('Usage: bv theme remove <theme-name>');
             Halt(1);
           End;
         If Not LoadPackageJson(JsonObj) Then
           Begin
             WriteLn(


                '  [!] Error: Could not read package.json in current directory.'
             );
             Halt(1);
           End;
         Try
           ThemesData := JsonObj.Find('themes');
           If (ThemesData = Nil) Or Not (ThemesData is TJSONArray) Then
             Begin
               WriteLn(


'  [*] No themes array configured in package.json (all themes currently enabled).'
               );
               Exit;
             End;
           ThemesArr := TJSONArray(ThemesData);
           FoundIdx := -1;
           For i := 0 To ThemesArr.Count - 1 Do
             Begin
               If LowerCase(ThemesArr.Strings[i]) = CleanTheme Then
                 Begin
                   FoundIdx := i;
                   Break;
                 End;
             End;
           If FoundIdx >= 0 Then
             Begin
               ThemesArr.Delete(FoundIdx);
               SavePackageJson(JsonObj);
               WriteLn('  [-] Removed theme "', CleanTheme,
                       '" from package.json.');
             End
           Else
             WriteLn('  [*] Theme "', CleanTheme,
                     '" was not present in package.json.');
         Finally
           JsonObj.Free;
       End;
End
Else If (CleanCmd = 'use') Or (CleanCmd = 'set') Then
       Begin
         If CleanTheme = '' Then
           Begin
             WriteLn('Usage: bv theme use <theme-name>');
             Halt(1);
           End;
         If AvailThemes.IndexOf(CleanTheme) < 0 Then
           Begin
             WriteLn('  [!] Error: Unknown theme "', CleanTheme, '".');
             WriteLn('      Available themes: ' + StringReplace(AvailThemes.
                     CommaText, ',', ', ', [rfReplaceAll]));
             Halt(1);
           End;
         If Not LoadPackageJson(JsonObj) Then
           Begin
             WriteLn(


                '  [!] Error: Could not read package.json in current directory.'
             );
             Halt(1);
           End;
         Try
           SetJsonString(JsonObj, 'theme', CleanTheme);
           ThemesData := JsonObj.Find('themes');
           If (ThemesData <> Nil) And (ThemesData is TJSONArray) Then
             Begin
               ThemesArr := TJSONArray(ThemesData);
               FoundIdx := -1;
               For i := 0 To ThemesArr.Count - 1 Do
                 Begin
                   If LowerCase(ThemesArr.Strings[i]) = CleanTheme Then
                     Begin
                       FoundIdx := i;
                       Break;
                     End;
                 End;
               If FoundIdx < 0 Then
                 ThemesArr.Add(CleanTheme);
             End;
           SavePackageJson(JsonObj);
           WriteLn('  [*] Set default theme to "', CleanTheme,
                   '" in package.json.');
         Finally
           JsonObj.Free;
       End;
CmdThemeUse(CleanTheme);
End
Else If CleanCmd = 'reset' Then
       Begin
         If Not LoadPackageJson(JsonObj) Then
           Begin
             WriteLn(


                '  [!] Error: Could not read package.json in current directory.'
             );
             Halt(1);
           End;
         Try
           FoundIdx := JsonObj.IndexOfName('themes');
           If FoundIdx >= 0 Then JsonObj.Delete(FoundIdx);
           SavePackageJson(JsonObj);
           WriteLn('  [!] Theme configuration reset in package.json.');
           WriteLn(


       '      All library themes will be bundled on build (compatibility mode).'
           );
         Finally
           JsonObj.Free;
       End;
End
Else
  Begin
    WriteLn('Unknown theme command: ', CleanCmd);
    WriteLn('Usage: bv theme <list|add <name>|remove <name>|use <name>|reset>');
    Halt(1);
  End;
Finally
  AvailThemes.Free;
  ConfigThemes.Free;
End;
End;




{ Discovers all CSS stylesheet assets in installed packages for injection into index.html. }
Procedure ScanDirForCSS(Const Path: String; List: TStringList);

Var 
  SR: TSearchRec;
Begin
  If Not DirectoryExists(Path) Then Exit;
  If FindFirst(Path + DirectorySeparator + '*', faAnyFile, SR) = 0 Then
    Begin
      Repeat

        If (SR.Name <> '.') And (SR.Name <> '..') Then
          Begin
            If (SR.Attr And faDirectory) <> 0 Then
              Begin
                If LowerCase(SR.Name) <> 'themes' Then
                  ScanDirForCSS(Path + DirectorySeparator + SR.Name, List);
              End

            Else If ExtractFileExt(SR.Name) = '.css' Then
                   List.Add(Path + DirectorySeparator + SR.Name);
          End;

      Until FindNext(SR) <> 0;
      FindClose(SR);
    End;
End;




{ Discovers all JS script bundles in installed packages for injection into index.html. }
Procedure ScanDirForJS(Const Path: String; List: TStringList);

Var 
  SR: TSearchRec;
Begin
  If Not DirectoryExists(Path) Then Exit;
  If FindFirst(Path + DirectorySeparator + '*', faAnyFile, SR) = 0 Then
    Begin
      Repeat

        If (SR.Name <> '.') And (SR.Name <> '..') Then
          Begin
            If (SR.Attr And faDirectory) <> 0 Then
              ScanDirForJS(Path + DirectorySeparator + SR.Name, List)

            Else If ExtractFileExt(SR.Name) = '.js' Then
                   List.Add(Path + DirectorySeparator + SR.Name);
          End;

      Until FindNext(SR) <> 0;
      FindClose(SR);
    End;
End;




{ Deletes a view component and removes its associated route from App.pas (bv remove view). }
Procedure CmdRemoveView(Const ViewName: String);

Var 
  BVPath, PasPath, TestPath, GenPath: string;
Begin
  RequireBlaiseVueProject('bv remove v');
  BVPath := GetCurrentDir + DirectorySeparator + 'src' + DirectorySeparator +
            'views' + DirectorySeparator + ViewName + '.bv';
  PasPath := GetCurrentDir + DirectorySeparator + 'generated' +
             DirectorySeparator + 'u' + ViewName + '.pas';
  TestPath := GetCurrentDir + DirectorySeparator + 'tests' + DirectorySeparator
              + 'views' + DirectorySeparator + ViewName + '.test.pas';
  GenPath := GetCurrentDir + DirectorySeparator + 'generated' +
             DirectorySeparator + 'tests' + DirectorySeparator + ViewName +
             '.test.js';
  If FileExists(BVPath) Then
    Begin
      DeleteFile(BVPath);
      WriteLn('Removed: src/views/', ViewName, '.bv');
    End;

  If FileExists(PasPath) Then
    DeleteFile(PasPath);

  If FileExists(TestPath) Then
    Begin
      DeleteFile(TestPath);
      WriteLn('Removed associated test: tests/views/', ViewName, '.test.pas');
    End;

  If FileExists(GenPath) Then
    DeleteFile(GenPath);

  WriteLn('View "', ViewName, '" removed.');
End;

