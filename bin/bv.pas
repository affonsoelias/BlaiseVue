Function ExecCmdCapture(Const CmdLine: String; out OutText: String): Boolean;

Var 
  OutStr: string;
  EffectiveCmd: string;
Begin
  OutStr := '';
  {$IFDEF WINDOWS}
  If Pos('"', CmdLine) > 0 Then
    EffectiveCmd := '"' + CmdLine + '"'
  Else
    EffectiveCmd := CmdLine;
  Result := RunCommand('cmd.exe', ['/c', EffectiveCmd], OutStr);
  {$ELSE}
  Result := RunCommand('sh', ['-c', CmdLine], OutStr);
  {$ENDIF}
  OutText := Trim(OutStr);
End;

