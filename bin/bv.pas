           End

           // Project subcommands inside shell (in-process for state tracking)
    Else If (CmdName = 'project') Or (CmdName = 'p') Then
           Begin
             If Tokens.Count < 2 Then
               CmdProjectList
             Else
               Begin
                 If LowerCase(Tokens[1]) = 'add' Then
                   CmdProjectAdd
                 Else If (LowerCase(Tokens[1]) = 'list') Or (LowerCase(Tokens[1]
                         ) = 'ls') Then
                        CmdProjectList
                 Else If (LowerCase(Tokens[1]) = 'current') Or (LowerCase(Tokens
                         [1]) = 'cur') Then
                        CmdProjectCurrent
                 Else If (LowerCase(Tokens[1]) = 'remove') Or (LowerCase(Tokens[
                         1]) = 'rm') Or (LowerCase(Tokens[1]) = 'del') Then
                        Begin
                          If Tokens.Count < 3 Then
                            WriteLn('Usage: project remove <name>')
                          Else
                            CmdProjectRemove(Tokens[2]);
                        End
                 Else If LowerCase(Tokens[1]) = 'use' Then
                        Begin
                          If Tokens.Count < 3 Then
                            WriteLn('Usage: use <name>')
                          Else
                            Begin
                              If FindRegisteredProject(Tokens[2], FoundPath,
                                 FoundVer) Then
                                Begin
                                  If DirectoryExists(FoundPath) Then
                                    Begin
                                      ChDir(FoundPath);
                                      ActiveName := Tokens[2];
                                      ActivePath := FoundPath;
                                      WriteLn('Switched active project to "',
                                              ActiveName, '" (', ActivePath, ')'
                                      );
                                    End
                                  Else
                                    WriteLn('[ERROR] Directory for "', Tokens[2]
                                            , '" not found: ', FoundPath);
                                End
                              Else
                                WriteLn('[ERROR] Project "', Tokens[2],


                                  '" not found in registry. Run "project list".'
                                );
                            End;
                        End
                 Else
                   WriteLn(


'Unknown project subcommand. Use "project add", "project list", or "project remove <name>".'
                   );
               End;
           End

           // Direct switch via `use <name>` (in-process for state tracking)
    Else If CmdName = 'use' Then
           Begin
             If Tokens.Count < 2 Then
               WriteLn('Usage: use <project-name>')
             Else
               Begin
                 If FindRegisteredProject(Tokens[1], FoundPath, FoundVer) Then
                   Begin
                     If DirectoryExists(FoundPath) Then
                       Begin
                         ChDir(FoundPath);
                         ActiveName := Tokens[1];
                         ActivePath := FoundPath;
                         WriteLn('');
                         WriteLn('  Switched active project to "' + ActiveName +
                                 '"');
                         WriteLn('  Directory: ' + ActivePath);
                         WriteLn('');
                       End
                     Else
                       WriteLn('[ERROR] Directory for "', Tokens[1],
                               '" not found: ', FoundPath);
                   End
                 Else
                   Begin
                     WriteLn('[ERROR] Project "', Tokens[1],
                             '" not found in registry.');
                     WriteLn('Run "project list" to see registered projects.');
                   End;
               End;
           End

           // `rename`
    Else If (CmdName = 'rename') Or (CmdName = 'ren') Or (CmdName = 'mv') Then
           Begin
             If (Tokens.Count >= 3) And ((LowerCase(Tokens[1]) = 'p') Or (
                LowerCase(Tokens[1]) = 'project') Or (LowerCase(Tokens[1]) =
                'proj')) Then
               Begin
                 CmdRenameProject(Tokens[2], DummyName);
                 If DummyName <> '' Then
                   ActiveName := DummyName;
               End
             Else
               ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `mormot` backend commands
    Else If CmdName = 'mormot' Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `zephyr` backend commands
    Else If CmdName = 'zephyr' Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `pas2js` compiler commands
    Else If (CmdName = 'pas2js') Or (CmdName = 'compiler') Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `versions` global dashboard
    Else If (CmdName = 'versions') Or (CmdName = 'sdk') Or (CmdName = 'sdks')
           Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `dev`
    Else If CmdName = 'dev' Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `build`
    Else If CmdName = 'build' Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `preview`
    Else If CmdName = 'preview' Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `test`
    Else If CmdName = 'test' Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `clean`
    Else If CmdName = 'clean' Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, 'clean');
           End

           // `check`
    Else If CmdName = 'check' Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `new` / `generate` / `g`
    Else If (CmdName = 'new') Or (CmdName = 'generate') Or (CmdName = 'g') Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `remove` / `rm`
    Else If (CmdName = 'remove') Or (CmdName = 'rm') Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `list`
    Else If (CmdName = 'list') Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `capacitor` & `mobile`
    Else If (CmdName = 'capacitor') Or (CmdName = 'mobile') Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `desktop`
    Else If CmdName = 'desktop' Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `studio`
    Else If CmdName = 'studio' Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `theme`
    Else If CmdName = 'theme' Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `lib`
    Else If CmdName = 'lib' Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `meta`
    Else If CmdName = 'meta' Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `license`
    Else If CmdName = 'license' Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `reset`
    Else If CmdName = 'reset' Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `update` / `upgrade`
    Else If (CmdName = 'update') Or (CmdName = 'upgrade') Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `doctor`
    Else If (CmdName = 'doctor') Or (CmdName = 'doc-env') Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `self-update` / `upgrade-cli`
    Else If (CmdName = 'self-update') Or (CmdName = 'selfupdate') Or (CmdName =
            'upgrade-cli') Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `channel` / `branch`
    Else If (CmdName = 'channel') Or (CmdName = 'branch') Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `doc`
    Else If CmdName = 'doc' Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `ssg`
    Else If CmdName = 'ssg' Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End

           // `wasm`
    Else If CmdName = 'wasm' Then
           Begin
             ExecInCockpit(BvExePath, ActivePath, InputLine);
           End




// Fallback: execute as a system shell command (e.g. git status, npm install, dir, ls)
    Else
      Begin
        If FindClosestCockpitCommand(CmdName, Suggestion) And (Not HasCommand(
           CmdName)) And
           (CmdName <> 'dir') And (CmdName <> 'ls') And (CmdName <> 'cat') And (
           CmdName <> 'type') And
           (CmdName <> 'cd') And (CmdName <> 'mkdir') And (CmdName <> 'rmdir')
           And (CmdName <> 'copy') And
           (CmdName <> 'cp') And (CmdName <> 'mv') And (CmdName <> 'del') And (
           CmdName <> 'rm') Then
          Begin
            WriteLn('');
            WriteLn('  [?] Unrecognized command: ''' + CmdName + '''');
            WriteLn('   Did you mean: ''' + Suggestion + '''?');
            If Tokens.Count > 1 Then
              Begin
                RestOfLine := '';
                For i := 1 To Tokens.Count - 1 Do
                  RestOfLine := RestOfLine + ' ' + Tokens[i];
                WriteLn('   Try: ' + Suggestion + RestOfLine);
              End
            Else
              WriteLn('   Try: ' + Suggestion);
            WriteLn('');
          End
        Else
          Begin
            ExecShellCmd(ActivePath, InputLine);
          End;
      End;
End;
Finally
  Tokens.Free;
    {$IFDEF WINDOWS}
  SetConsoleCtrlHandler(@CockpitConsoleCtrlHandler, False);
    {$ENDIF}
    {$IFDEF UNIX}
  fpSignal(SIGINT, OldSigIntHandler);
  fpSignal(SIGQUIT, OldSigQuitHandler);
    {$ENDIF}
End;
End;

Procedure CmdEnter;

Var 
  CurDir, ProjName, ProjVer: string;
Begin
  CurDir := RequireBlaiseVueProject('bv enter');
  ProjName := GetProjectNameFromDir(CurDir);
  ProjVer := GetProjectVersionFromDir(CurDir);
  RunCockpitShell(ProjName, CurDir);
End;




{ Switches the active project context in the developer cockpit (use <project>). }
Procedure CmdUse(Const ProjName: String);

Var 
  ProjPath, ProjVer: string;
  RootObj: TJSONObject;
Begin
  If Not FindRegisteredProject(ProjName, ProjPath, ProjVer) Then
    Begin
      WriteLn('');
      WriteLn(


      '========================================================================'
      );
      WriteLn('  [ERROR] Project "', ProjName,
              '" is not registered in BlaiseVue registry.');
      WriteLn('');
      WriteLn('  To register a project:');
      WriteLn('    1. Open its folder in terminal');
      WriteLn('    2. Run "bv enter"');
      WriteLn('    3. Run "project add"');
      WriteLn('');
      WriteLn('  Run "bv project list" to see registered projects.');
      WriteLn(


      '========================================================================'
      );
      WriteLn('');
      Halt(1);
    End;

  If Not DirectoryExists(ProjPath) Then
    Begin
      WriteLn('');
      WriteLn(


      '========================================================================'
      );
      WriteLn('  [ERROR] Registered path for "', ProjName,
              '" does not exist on disk:');
      WriteLn('  ', ProjPath);
      WriteLn(


      '========================================================================'
      );
      WriteLn('');
      Halt(1);
    End;

  ChDir(ProjPath);

  // Update active project in registry
  If LoadProjectsRegistry(RootObj) Then
    Begin
      Try
        RootObj.Strings['active'] := ProjName;
        SaveProjectsRegistry(RootObj);
      Finally
        RootObj.Free;
    End;
End;

RunCockpitShell(ProjName, ProjPath);
End;

// =====================================================================
//  COMMAND: UPDATE / UPGRADE (bv update)
// =====================================================================



{ Surgically and non-destructively synchronizes existing BlaiseVue projects
  with the latest framework infrastructure, signal handlers, port failovers,
  runtime scripts and RTL assets without ever touching user custom code or folders. }

Procedure CmdUpdate;

Var 
  BaseDir, ServerDir, ServerLprFile, AppCfgFile, PkgFile, DistJsDir, RtlDest,
  RtlSrc: string;
  BackupDir, CurTimestamp, ProjName, ProjVer, LprContent, PkgContent,
  LazCleanName: string;
  DryRun, OnlyServer, OnlyFrontend, NoBackup, Force: Boolean;
  HasServer, HasFrontend, ServerUpdated, PkgUpdated, RtlUpdated: Boolean;
  LazCreated, LazUpdated, ServerLpiCreated, ServerLpiUpdated: Boolean;
  i, BackupCount, LazUnitsCount, ServerUnitsCount: Integer;
  UsesPos, VarPos, BeginPos, PosMarker, MainPortPos, MainBeginPos, p: Integer;



{ Creates a timestamped backup copy of a file before performing destructive mutations. }
Procedure CreateFileBackup(Const RelFilePath: String);

Var 
  Src, Dst: string;
Begin
  If DryRun Or NoBackup Then Exit;
  Src := BaseDir + RelFilePath;
  If Not FileExists(Src) Then Exit;
  Dst := BackupDir + RelFilePath;
  ForceDirectories(ExtractFilePath(Dst));
  CopyFile(Src, Dst);
  Inc(BackupCount);
  WriteLn('  [BACKUP] Saved snapshot: .bv_backup' + DirectorySeparator +
          'update_' + CurTimestamp + DirectorySeparator + RelFilePath);
End;
Begin
  DryRun := False;
  OnlyServer := False;
  OnlyFrontend := False;
  NoBackup := False;
  Force := False;
  For i := 2 To ParamCount Do
    Begin
      If (ParamStr(i) = '--dry-run') Or (ParamStr(i) = '-d') Then
        DryRun := True
      Else If ParamStr(i) = '--server' Then
             OnlyServer := True
      Else If ParamStr(i) = '--frontend' Then
             OnlyFrontend := True
      Else If ParamStr(i) = '--no-backup' Then
             NoBackup := True
      Else If (ParamStr(i) = '--force') Or (ParamStr(i) = '-f') Then
             Force := True
      Else If (ParamStr(i) = '--help') Or (ParamStr(i) = '-h') Then
             Begin
               WriteLn('');
               WriteLn('  BlaiseVue Infrastructure Updater');
               WriteLn('  Usage: bv update [options]');
               WriteLn('  Alias: bv upgrade [options]');
               WriteLn('');
               WriteLn('  Options:');
               WriteLn(


               '    --dry-run       Simulate update without modifying any files'
               );
               WriteLn(


                 '    --server        Update only backend/server infrastructure'
               );
               WriteLn('    --frontend      Update only frontend infrastructure'
               );
               WriteLn(


                   '    --no-backup     Skip creating automatic backup snapshot'
               );
               WriteLn(


       '    --force         Force re-patching and rebuilding even if up-to-date'
               );
               WriteLn('    -h, --help      Show this help message');
               WriteLn('');
               Halt(0);
             End;
    End;

  BaseDir := IncludeTrailingPathDelimiter(GetCurrentDir);
  ServerDir := IncludeTrailingPathDelimiter(ResolveMormotServerDir(
               ExcludeTrailingPathDelimiter(BaseDir), False));
  ServerLprFile := ServerDir + 'server.lpr';
  AppCfgFile := ServerDir + 'app.cfg';
  PkgFile := BaseDir + 'package.json';
  DistJsDir := BaseDir + 'dist' + DirectorySeparator + 'js' + DirectorySeparator
  ;
  HasServer := DirectoryExists(ServerDir) And FileExists(ServerLprFile);
  HasFrontend := FileExists(PkgFile) Or DirectoryExists(BaseDir + 'src');
  If Not HasServer And Not HasFrontend Then
    Begin
      WriteLn('');
      WriteLn(


      '========================================================================'
      );
      WriteLn(


            '  [ERROR] "bv update" must be executed inside a BlaiseVue project.'
      );
      WriteLn('  Current directory: ', BaseDir);
      WriteLn('  No server-mormot/server.lpr or package.json found.');
      WriteLn(


      '========================================================================'
      );
      WriteLn('');
      Halt(1);
    End;

  ProjName := GetProjectNameFromDir(ExcludeTrailingPathDelimiter(BaseDir));
  ProjVer := GetProjectVersionFromDir(ExcludeTrailingPathDelimiter(BaseDir));
  WriteLn('');
  WriteLn(


        '======================================================================'
  );
  WriteLn('  BlaiseVue Project Infrastructure Updater (bv update)');
  WriteLn(


        '======================================================================'
  );
  WriteLn('  Project:       ', ProjName, ' (v', ProjVer, ')');
  WriteLn('  Directory:     ', BaseDir);
  If DryRun Then
    WriteLn('  Mode:          DRY-RUN (Simulation - no changes will be made)')
  Else
    WriteLn('  Mode:          LIVE UPDATE');
  WriteLn(


         '  Safety Rule:   User custom directories & files (kernel/, packages/,'
  );
  WriteLn('                 models/, controllers/, etc.) are NEVER touched.');
  WriteLn(


        '======================================================================'
  );
  WriteLn('');
  CurTimestamp := FormatDateTime('yyyymmdd_hhnnss', Now);
  BackupDir := BaseDir + '.bv_backup' + DirectorySeparator + 'update_' +
               CurTimestamp + DirectorySeparator;
  BackupCount := 0;
  ServerUpdated := False;
  PkgUpdated := False;
  RtlUpdated := False;
  LazCreated := False;
  LazUpdated := False;
  ServerLpiCreated := False;
  ServerLpiUpdated := False;
  LazUnitsCount := 0;
  ServerUnitsCount := 0;
  LazCleanName := '';

  // -------------------------------------------------------------------
  // 1. Backend Server Infrastructure
  // -------------------------------------------------------------------
  If HasServer And (Not OnlyFrontend) Then
    Begin
      WriteLn('[1/4] Inspecting server infrastructure in server/server.lpr...');
      LprContent := ReadFileToString(ServerLprFile);

      // 1.1: Ensure windows unit is in uses clause
      If (Pos('windows,', LprContent) = 0) And (Pos('windows;', LprContent) = 0)
        Then
        Begin
          UsesPos := Pos('uses', LprContent);
          If UsesPos > 0 Then
            Begin
              Insert(#10 + '  {$ifdef OSWINDOWS}' + #10 + '  windows,' + #10 +
                     '  {$endif OSWINDOWS}', LprContent, UsesPos + 4);
              ServerUpdated := True;
            End;
        End;

      // 1.2: Ensure .env variables are declared
      If Pos('EnvLines: TStringList;', LprContent) = 0 Then
        Begin
          VarPos := Pos('var', LprContent);
          If VarPos > 0 Then
            Begin
              Insert(#10 + '  EnvPath, EnvLine, EnvKey, EnvVal: string;' + #10 +
                     '  EnvLines: TStringList;' + #10 + '  eqPos: Integer;',
                     LprContent, VarPos + 3);
              ServerUpdated := True;
            End;
        End;

      // 1.3: Locate main program block using 'Port :='
      MainPortPos := Pos('Port :=', LprContent);
      MainBeginPos := 0;
      If MainPortPos > 0 Then
        Begin
          For p := MainPortPos Downto 6 Do
            Begin
              If Copy(LprContent, p - 4, 5) = 'begin' Then
                Begin
                  MainBeginPos := p - 4;
                  Break;
                End;
            End;
        End;

      // 1.4: Ensure ConsoleCtrlHandler with clean ExitProcess(0)
      If Pos('function ConsoleCtrlHandler', LprContent) = 0 Then
        Begin
          If MainBeginPos > 0 Then
            Begin
              Insert(
                     '{$ifdef OSWINDOWS}' + #10 +



                'function ConsoleCtrlHandler(dwCtrlType: DWORD): BOOL; stdcall;'
                     + #10 +
                     'begin' + #10 +
                     '  case dwCtrlType of' + #10 +



    '    CTRL_C_EVENT, CTRL_BREAK_EVENT, CTRL_CLOSE_EVENT, CTRL_SHUTDOWN_EVENT:'
                     + #10 +
                     '    begin' + #10 +
                     '      WriteLn('''');' + #10 +



'      WriteLn(''[+] Signal received (Ctrl+C). Gracefully closing mORMot 2 server...'');'
                     + #10 +
                     '      if Assigned(App) then' + #10 +
                     '      begin' + #10 +
                     '        try' + #10 +
                     '          App.Free;' + #10 +
                     '          App := nil;' + #10 +
                     '        except' + #10 +
                     '        end;' + #10 +
                     '      end;' + #10 +



      '      WriteLn(''[+] mORMot 2 server stopped cleanly. Ports released.'');'
                     + #10 +
                     '      ExitProcess(0);' + #10 +
                     '      Result := True;' + #10 +
                     '      Exit;' + #10 +
                     '    end;' + #10 +
                     '  end;' + #10 +
                     '  Result := False;' + #10 +
                     'end;' + #10 +
                     '{$endif OSWINDOWS}' + #10#10, LprContent, MainBeginPos);
              ServerUpdated := True;
            End;
        End
      Else If Pos('ExitProcess(0)', LprContent) = 0 Then
             Begin
               If Pos('App.Free;', LprContent) > 0 Then
                 Begin
                   LprContent := StringReplace(LprContent,
                                 'FreeAndNil(App);',
                                 'try App.Free; App := nil; except end;' + #10 +
                                 '      ExitProcess(0); Result := True; Exit;',
                                 [rfReplaceAll]);
                   ServerUpdated := True;
                 End;
             End;




// 1.5: Ensure SetConsoleCtrlHandler call in main program block right before Port :=
      If Pos('SetConsoleCtrlHandler(@ConsoleCtrlHandler', LprContent) = 0 Then
        Begin
          MainPortPos := Pos('Port :=', LprContent);
          If MainPortPos > 0 Then
            Begin
              Insert('{$ifdef OSWINDOWS}' + #10 +
                     '  SetConsoleCtrlHandler(@ConsoleCtrlHandler, True);' + #10
                     +
                     '  {$endif OSWINDOWS}' + #10 + '  ', LprContent,
                     MainPortPos);
              ServerUpdated := True;
            End;
        End;

      // 1.5: Ensure .env PORT support
      If Pos('EnvLines.LoadFromFile(EnvPath);', LprContent) = 0 Then
        Begin
          PosMarker := Pos('Port := ''8090'';', LprContent);
          If PosMarker > 0 Then
            Begin
              PosMarker := PosMarker + Length('Port := ''8090'';');
              Insert(#10#10 +
                     '  // Read .env configuration if present' + #10 +
                     '  EnvPath := ExtractFilePath(ParamStr(0)) + ''.env'';' + #10 +
                     '  if not FileExists(EnvPath) then' + #10 +



'    EnvPath := ExtractFilePath(ParamStr(0)) + ''..'' + DirectorySeparator + ''.env'';'
                     + #10 +



                    '  if not FileExists(EnvPath) and FileExists(''.env'') then'
                     + #10 +
                     '    EnvPath := ExpandFileName(''.env'');' + #10 +



'  if not FileExists(EnvPath) and FileExists(''..'' + DirectorySeparator + ''.env'') then'
                     + #10 +



        '    EnvPath := ExpandFileName(''..'' + DirectorySeparator + ''.env'');'
                     + #10#10 +
                     '  if FileExists(EnvPath) then' + #10 +
                     '  begin' + #10 +
                     '    EnvLines := TStringList.Create;' + #10 +
                     '    try' + #10 +
                     '      EnvLines.LoadFromFile(EnvPath);' + #10 +
                     '      for i := 0 to EnvLines.Count - 1 do' + #10 +
                     '      begin' + #10 +
                     '        EnvLine := Trim(EnvLines[i]);' + #10 +



            '        if (EnvLine = '''') or (EnvLine[1] = ''#'') then Continue;'
                     + #10 +
                     '        eqPos := Pos(''='', EnvLine);' + #10 +
                     '        if eqPos > 1 then' + #10 +
                     '        begin' + #10 +



             '          EnvKey := UpperCase(Trim(Copy(EnvLine, 1, eqPos - 1)));'
                     + #10 +



                   '          EnvVal := Trim(Copy(EnvLine, eqPos + 1, MaxInt));'
                     + #10 +
                     '          if EnvKey = ''PORT'' then' + #10 +
                     '            Port := EnvVal;' + #10 +
                     '        end;' + #10 +
                     '      end;' + #10 +
                     '    finally' + #10 +
                     '      EnvLines.Free;' + #10 +
                     '    end;' + #10 +
                     '  end;', LprContent, PosMarker);
              ServerUpdated := True;
            End;
        End;

      If ServerUpdated Then
        Begin
          WriteLn('  [+] ', ExtractFileName(ExcludeTrailingPathDelimiter(
                  ServerDir)),
          '/server.lpr updates identified (clean signals + .env reader).');
          If Not DryRun Then
            Begin
              CreateFileBackup(ExtractFileName(ExcludeTrailingPathDelimiter(
                               ServerDir)) + DirectorySeparator + 'server.lpr');
              WriteStringToFile(ServerLprFile, LprContent);
              WriteLn('  [+] Updated ', ExtractFileName(
                      ExcludeTrailingPathDelimiter(ServerDir)),
              '/server.lpr successfully.');
            End
          Else
            WriteLn('  [*] [DRY-RUN] Would update ', ExtractFileName(
                    ExcludeTrailingPathDelimiter(ServerDir)), '/server.lpr');
        End
      Else
        Begin
          WriteLn('  [OK] ', ExtractFileName(ExcludeTrailingPathDelimiter(
                  ServerDir)),
          '/server.lpr is already up to date with the latest features.');
        End;

      // 1.6: Synchronize server.lpi for Lazarus IDE
      SyncServerLazarusProject(ServerDir, DryRun, ServerLpiCreated,
                               ServerLpiUpdated, ServerUnitsCount);
      If ServerLpiCreated Then
        Begin
          If Not DryRun Then
            WriteLn('  [+] Created ', ExtractFileName(
                    ExcludeTrailingPathDelimiter(ServerDir)), '/server.lpi (',
            ServerUnitsCount, ' server units indexed).')
          Else
            WriteLn('  [*] [DRY-RUN] Would create ', ExtractFileName(
                    ExcludeTrailingPathDelimiter(ServerDir)), '/server.lpi (',
            ServerUnitsCount, ' server units indexed).');
        End
      Else If ServerLpiUpdated Then
             Begin
               If Not DryRun Then
                 WriteLn('  [+] Synchronized ', ExtractFileName(
                         ExcludeTrailingPathDelimiter(ServerDir)),
                 '/server.lpi (', ServerUnitsCount, ' server units indexed).')
               Else
                 WriteLn('  [*] [DRY-RUN] Would synchronize ', ExtractFileName(
                         ExcludeTrailingPathDelimiter(ServerDir)),
                 '/server.lpi (', ServerUnitsCount, ' server units indexed).');
             End
      Else
        WriteLn('  [OK] ', ExtractFileName(ExcludeTrailingPathDelimiter(
                ServerDir)), '/server.lpi is up to date (', ServerUnitsCount,
        ' server units indexed).');

      // Check if server binary should be rebuilt
      If (ServerUpdated Or Force) And (Not DryRun) Then
        Begin
          WriteLn(


            '  [BUILD] Recompiling server binary with updated infrastructure...'
          );
          CmdServer('build');
        End
      Else If ServerUpdated And DryRun Then
             Begin
               WriteLn('  [*] [DRY-RUN] Would recompile ', ExtractFileName(
                       ExcludeTrailingPathDelimiter(ServerDir)),
               '/bin/server.exe');
             End;
    End;

  // -------------------------------------------------------------------
  // 2. Frontend Infrastructure
  // -------------------------------------------------------------------
  If HasFrontend And (Not OnlyServer) Then
    Begin
      WriteLn('[2/4] Inspecting frontend infrastructure...');

      // 2.1: package.json scripts
      If FileExists(PkgFile) Then
        Begin
          PkgContent := ReadFileToString(PkgFile);
          If Pos('"dev": "bv serve"', PkgContent) > 0 Then
            Begin
              PkgContent := StringReplace(PkgContent, '"dev": "bv serve"',
                            '"dev": "bv dev"', [rfReplaceAll]);
              PkgUpdated := True;
            End;
          If Pos('"dev": "bv run dev"', PkgContent) > 0 Then
            Begin
              PkgContent := StringReplace(PkgContent, '"dev": "bv run dev"',
                            '"dev": "bv dev"', [rfReplaceAll]);
              PkgUpdated := True;
            End;
          If Pos('"dev" : "bv run dev"', PkgContent) > 0 Then
            Begin
              PkgContent := StringReplace(PkgContent, '"dev" : "bv run dev"',
                            '"dev" : "bv dev"', [rfReplaceAll]);
              PkgUpdated := True;
            End;
          If Pos('"build": "bv run build"', PkgContent) > 0 Then
            Begin
              PkgContent := StringReplace(PkgContent, '"build": "bv run build"',
                            '"build": "bv build --release"', [rfReplaceAll]);
              PkgUpdated := True;
            End;
          If Pos('"build" : "bv run build"', PkgContent) > 0 Then
            Begin
              PkgContent := StringReplace(PkgContent, '"build" : "bv run build"'
                            , '"build" : "bv build --release"', [rfReplaceAll]);
              PkgUpdated := True;
            End;
          If Pos('    "server": "bv server",' + #10, PkgContent) > 0 Then
            Begin
              PkgContent := StringReplace(PkgContent,
                            '    "server": "bv server",' + #10, '', [
                            rfReplaceAll]);
              PkgUpdated := True;
            End;
          If Pos('    "server" : "bv server",' + #10, PkgContent) > 0 Then
            Begin
              PkgContent := StringReplace(PkgContent,
                            '    "server" : "bv server",' + #10, '', [
                            rfReplaceAll]);
              PkgUpdated := True;
            End;
          If Pos('    "server": "bv server",' + #13#10, PkgContent) > 0 Then
            Begin
              PkgContent := StringReplace(PkgContent,
                            '    "server": "bv server",' + #13#10, '', [
                            rfReplaceAll]);
              PkgUpdated := True;
            End;
          If Pos('    "server" : "bv server",' + #13#10, PkgContent) > 0 Then
            Begin
              PkgContent := StringReplace(PkgContent,
                            '    "server" : "bv server",' + #13#10, '', [
                            rfReplaceAll]);
              PkgUpdated := True;
            End;

          If PkgUpdated Then
            Begin
              If Not DryRun Then
                Begin
                  CreateFileBackup('package.json');
                  WriteStringToFile(PkgFile, PkgContent);
                  WriteLn(


'  [+] Synchronized package.json scripts ("dev": "bv dev", "build": "bv build --release").'
                  );
                End
              Else
                WriteLn('  [*] [DRY-RUN] Would update package.json scripts');
            End
          Else
            WriteLn('  [OK] package.json scripts are up to date.');
        End;

      // 2.2: RTL JavaScript runtime asset
      RtlSrc := GetRTLPath;
      RtlDest := DistJsDir + 'rtl.js';
      If FileExists(RtlSrc) And DirectoryExists(DistJsDir) Then
        Begin
          If (Not FileExists(RtlDest)) Or Force Then
            Begin
              If Not DryRun Then
                Begin
                  CreateFileBackup('dist' + DirectorySeparator + 'js' +
                                   DirectorySeparator + 'rtl.js');
                  CopyFile(RtlSrc, RtlDest);
                  RtlUpdated := True;
                  WriteLn('  [+] Synchronized dist/js/rtl.js runtime asset.');
                End
              Else
                WriteLn('  [*] [DRY-RUN] Would synchronize dist/js/rtl.js');
            End
          Else
            WriteLn('  [OK] dist/js/rtl.js is present.');
        End;
    End;

  // -------------------------------------------------------------------
  // 3. Lazarus IDE Project Files (.lpi / .lpr)
  // -------------------------------------------------------------------
  If Not OnlyServer Then
    Begin
      WriteLn('[3/4] Inspecting Lazarus IDE project files...');
      SyncLazarusProject(ExcludeTrailingPathDelimiter(BaseDir), DryRun,
      LazCreated, LazUpdated, LazUnitsCount, LazCleanName);
      If LazCreated Then
        Begin
          If Not DryRun Then
            WriteLn('  [+] Created ', LazCleanName, '.lpr and ', LazCleanName,
                    '.lpi (', LazUnitsCount, ' units indexed).')
          Else
            WriteLn('  [*] [DRY-RUN] Would create ', LazCleanName, '.lpr and ',
                    LazCleanName, '.lpi (', LazUnitsCount, ' units indexed).');
        End
      Else If LazUpdated Then
             Begin
               If Not DryRun Then
                 WriteLn('  [+] Synchronized ', LazCleanName, '.lpi (',
                         LazUnitsCount, ' units indexed).')
               Else
                 WriteLn('  [*] [DRY-RUN] Would synchronize ', LazCleanName,
                         '.lpi (', LazUnitsCount, ' units indexed).');
             End
      Else
        WriteLn('  [OK] ', LazCleanName, '.lpi and ', LazCleanName,
                '.lpr are already up to date (', LazUnitsCount,
                ' units indexed).');
    End;

  // 3.5: Mobile Android Gradle self-healing
  If DirectoryExists(BaseDir + 'mobile' + DirectorySeparator + 'android') Then
    Begin
      If EnsureAndroidGradleCompatibility(BaseDir + 'mobile' +
         DirectorySeparator + 'android') Then
        WriteLn(


'  [+] Auto-repaired Mobile Android Gradle configuration (Java 17 LTS / Release signing).'
        )
      Else
        WriteLn('  [OK] Mobile Android Gradle configuration is up to date.');
    End
  Else If DirectoryExists(BaseDir + 'android') Then
         Begin
           If EnsureAndroidGradleCompatibility(BaseDir + 'android') Then
             WriteLn(


'  [+] Auto-repaired Android Gradle configuration (Java 17 LTS / Release signing).'
             )
           Else
             WriteLn('  [OK] Android Gradle configuration is up to date.');
         End;

  // -------------------------------------------------------------------
  // 4. Registry & Non-destructive Safety Summary
  // -------------------------------------------------------------------
  WriteLn('[4/4] Finalizing project registry and safety check...');
  If Not DryRun Then
    Begin
      CmdProjectAdd;
    End;

  WriteLn('');
  WriteLn(


        '======================================================================'
  );
  WriteLn('  BlaiseVue Update Summary');
  WriteLn(


        '======================================================================'
  );
  WriteLn('  Project:       ', ProjName, ' (v', ProjVer, ')');
  If HasServer Then
    Begin
      If ServerUpdated Then
        WriteLn('  Server:        UPDATED (server.lpr + recompiled binary)')
      Else If ServerLpiCreated Or ServerLpiUpdated Then
             WriteLn('  Server:        UPDATED (server/server.lpi synchronized)'
             )
      Else
        WriteLn('  Server:        ALREADY UP TO DATE');
    End
  Else
    WriteLn('  Server:        N/A (frontend-only project)');

  If HasFrontend Then
    Begin
      If PkgUpdated Or RtlUpdated Then
        WriteLn('  Frontend:      UPDATED (scripts and/or runtime assets)')
      Else
        WriteLn('  Frontend:      ALREADY UP TO DATE');
    End;

  If Not OnlyServer Then
    Begin
      If LazCreated Then
        WriteLn('  Lazarus IDE:   CREATED (', LazCleanName, '.lpi, ',
                LazCleanName, '.lpr)')
      Else If LazUpdated Then
             WriteLn('  Lazarus IDE:   SYNCHRONIZED (', LazCleanName, '.lpi)')
      Else
        WriteLn('  Lazarus IDE:   ALREADY UP TO DATE (', LazCleanName, '.lpi)');
    End;

  WriteLn(


       '  Safety Rule:   100% PRESERVED - All user custom directories and files'
  );
  WriteLn(


  '                 (kernel/, packages/, models/, src/, etc.) were NOT touched.'
  );
  If (Not DryRun) And (Not NoBackup) And (BackupCount > 0) Then
    WriteLn('  Backup:        Saved to .bv_backup/update_', CurTimestamp, '/')
  Else If DryRun Then
         WriteLn('  Backup:        None (dry-run mode)')
  Else
    WriteLn('  Backup:        No modified files required backup');

  WriteLn(


        '======================================================================'
  );
  WriteLn('');
End;

// =====================================================================
//  ENVIRONMENT UTILITIES & FRAMEWORK DIAGNOSTICS (bv doctor)
// =====================================================================

Procedure CmdDoctor;

Var 
  SDKDir, OSName, GitVer, FpcExe, FpcVer, FpcSource, Pas2Path, Pas2Ver: string;
  NodeVer, NpmVer, MormotPath, BranchName, ShortHash, RemoteUrl, DockerVer:


                                                                          string
  ;
  PyExe, PyVer, PySource, IfpcExe, IfpcVer, IfpcSource: string;
  JavaHome, JavaVer, JavaSource, AdbExe, AdbVer, AdbSource: string;
  EmuExe, EmuSource, AvdListStr, CapVer, AndroidSdkPath, DummyStr: string;
  HasGit, HasFpc, HasPas2, HasMormot, HasNode, HasLazarus, HasPython, HasIfpc:


                                                                         Boolean
  ;
  HasJava, HasAdb, HasEmulator: Boolean;
  MajorJava, AvdCount: Integer;
  AllTools: TBVToolArray;
  BuiltInCount, UserCount, ToolIdx: Integer;
  AllHealthy: Boolean;
  ProjRoot, ProjName, VerFile, ReqPas2, UserPas2Dir, ReqFw, UserFwDir: string;
  HasServerDir, HasZephyrDir, HasMobile: Boolean;
  MormotDir, ZephyrServerDir, ZephyrDelsafec, MormotConf, ReqMormot,
  UserMormotDir, MormotLabel, ZephyrLabel: string;
  PkgFile, PkgContent, ReqCapVer, CapCorePath, InstalledCapVer: string;
  ExtSR: TSearchRec;
  ExtDirLow, ExtSuffix, ExtLabel: string;
  ExtToolRec: TBVTool;
  FoundExtAny: Boolean;
  ProjectNotices: TStringList;
  NoticeIdx: Integer;
  HasDelsafec, HasDelSafeGcc, HasDelSafeClang, HasZephyrSdk, HasFallbackActive:
                                                                         Boolean
  ;
  DelsafecExe, DelsafecVer, DelsafecSource, DelSafeGccVer, DelSafeClangVer,
  DelSafeBackendsStr, ZephyrSdkDir, DelSafeSummary: string;
  BvDelSafeCount, DelsModuleCount, DelsTestCount, ExtraDelSafePathsCount:
                                                                         Integer
  ;
Begin
  SDKDir := ExcludeTrailingPathDelimiter(GetSDKPath);
  AllHealthy := True;
  HasFallbackActive := False;
  HasDelsafec := False;
  HasDelSafeGcc := False;
  HasDelSafeClang := False;
  HasZephyrSdk := False;
  DelsafecExe := '';
  DelsafecVer := '';
  DelsafecSource := '';
  DelSafeGccVer := '';
  DelSafeClangVer := '';
  ProjectNotices := TStringList.Create;
  Try

  {$IFDEF WINDOWS}
    OSName := 'Windows (x86_64)';
  {$ELSE}
    {$IFDEF LINUX}
    OSName := 'Linux (x86_64)';
    {$ELSE}
    OSName := 'macOS (Darwin)';
    {$ENDIF}
  {$ENDIF}

    // Probe Git branch and commit if in repo
    BranchName := TBVUpgrade.GetConfiguredChannel;
    ShortHash := '';
    RemoteUrl := '';
    If DirectoryExists(SDKDir + DirectorySeparator + '.git') Then
      Begin
        ExecCmdCapture('git -C "' + SDKDir + '" rev-parse --abbrev-ref HEAD',
                       BranchName);
        BranchName := Trim(BranchName);
        If BranchName = '' Then BranchName := TBVUpgrade.GetConfiguredChannel;
        ExecCmdCapture('git -C "' + SDKDir + '" rev-parse --short HEAD',
                       ShortHash);
        ExecCmdCapture('git -C "' + SDKDir + '" remote get-url origin',
                       RemoteUrl);
      End;

    WriteLn('');
    WriteLn(


        '======================================================================'
    );
    WriteLn('  BlaiseVue Doctor - Environment Diagnostics');
    WriteLn(


        '======================================================================'
    );
    WriteLn('  Operating System:     ', OSName);
    WriteLn('  SDK Directory:        ', SDKDir);
    If ShortHash <> '' Then
      WriteLn('  Install Mode:         Git Source (branch: ', BranchName, ', commit: ',
              ShortHash, ')')
    Else
      WriteLn('  Install Mode:         Standalone Binary (channel: ', BranchName, ')');
    If RemoteUrl <> '' Then
      WriteLn('  Remote Origin:        ', RemoteUrl);
    WriteLn('');

    // 1. Core Tooling
    WriteLn('[1] Core Framework Tooling:');

    // Git
    HasGit := ExecCmdCapture('git --version', GitVer) And (Pos('git version',
              GitVer) > 0);
    If HasGit Then
      WriteLn('  [v] Git CLI:              ', GitVer, ' detected in PATH')
    Else If DirectoryExists(SDKDir + DirectorySeparator + '.git') Then
      Begin
        AllHealthy := False;
        WriteLn('  [X] Git CLI:              Not detected in PATH!');
        WriteLn('      -> Required in Git source clones for "bv self-update --from-source".');
        WriteLn('      -> Install from: https://git-scm.com/');
      End
    Else
      WriteLn('  [!] Git CLI:              Not detected (Optional for binary releases; needed only for --from-source)');

    // FPC
    HasFpc := FindFPCExecutable(FpcExe, FpcVer, FpcSource);
    If HasFpc Then
      WriteLn('  [v] Free Pascal (FPC):    v', FpcVer, ' (', FpcSource, ')')
    Else
      Begin
        AllHealthy := False;
        WriteLn('  [X] Free Pascal (FPC):    Not detected!');
        WriteLn('      -> Required to compile mORMot backend and CLI.');
        WriteLn(


'      -> Install Lazarus IDE (which bundles FPC): https://www.lazarus-ide.org/'
        );
      End;

    // InstantFPC (Pascal Scripting Engine)
    HasIfpc := FindInstantFPCExecutable(IfpcExe, IfpcVer, IfpcSource);
    If HasIfpc Then
      WriteLn('  [v] InstantFPC:           v', IfpcVer, ' (', IfpcSource, ')')
    Else
      WriteLn(


'  [!] InstantFPC:           Not detected (Optional: Pascal script runner for tools)'
      );

    // Lazarus IDE
    HasLazarus := False;
  {$IFDEF WINDOWS}
    HasLazarus := FileExists('C:\lazarus\lazarus.exe') Or FileExists(
                  'C:\lazarus\lazbuild.exe') Or HasCommand('lazbuild');
  {$ELSE}
    HasLazarus := HasCommand('lazarus-ide') Or HasCommand('lazbuild') Or
                  DirectoryExists('/usr/lib/lazarus') Or DirectoryExists(
                  '/Applications/Lazarus');
  {$ENDIF}
    If HasLazarus Then
      WriteLn(


        '  [v] Lazarus IDE:          Detected (Full F9 and Desktop app support)'
      )
    Else
      WriteLn(


'  [!] Lazarus IDE:          Not found (Optional, recommended for Desktop apps)'
      );

    // Pas2JS (Bundled)
    Pas2Path := GetPas2JSPath;
    HasPas2 := FileExists(Pas2Path);
    If HasPas2 Then
      Begin
        Pas2Ver := '3.2.0';
        If ExecCmdCapture('"' + Pas2Path + '" -iV', Pas2Ver) Then Pas2Ver := 


                                                                            Trim
                                                                             (


                                                                         Pas2Ver
                                                                             );
        WriteLn('  [v] Pas2JS (Bundled):     v', Pas2Ver, ' verified at ',
                ExtractRelativePath(SDKDir + DirectorySeparator, Pas2Path));
      End
    Else
      Begin
        AllHealthy := False;
        WriteLn('  [X] Pas2JS (Bundled):     Binary not found in SDK at:');
        WriteLn('      ', Pas2Path);
      End;

    // mORMot 2 (On-demand / Bundled)
    MormotPath := FindMormot2Path;
    HasMormot := (MormotPath <> '') And DirectoryExists(MormotPath);
    If HasMormot Then
      WriteLn('  [v] Synopse mORMot 2:     Verified at ', ExtractRelativePath(
              SDKDir + DirectorySeparator, MormotPath))
    Else
      WriteLn('  [!] Synopse mORMot 2:     Not installed (fetched on demand via "bv mormot upgrade" or "bv mormot run")');

    // DelSafe Compiler (Optional)
    HasDelsafec := FindDelsafecInfo(DelsafecExe, DelsafecVer, DelsafecSource);
    If HasDelsafec Then
      Begin
        If DelsafecVer = 'detected' Then
          WriteLn('  [v] DelSafe Compiler:     detected (', DelsafecSource,
                  ', optional)')
        Else
          WriteLn('  [v] DelSafe Compiler:     v', DelsafecVer, ' (',
                  DelsafecSource, ', optional)');

        ProbeDelSafeBackends(DelsafecExe, HasDelSafeGcc, HasDelSafeClang,
                             DelSafeGccVer, DelSafeClangVer);
        DelSafeBackendsStr := '';
        If HasDelSafeGcc Then
          DelSafeBackendsStr := IfThen(DelSafeGccVer <> '', 'C (GCC ' +
                                       DelSafeGccVer + ')', 'C (GCC)');
        If HasDelSafeClang Then
          Begin
            If DelSafeBackendsStr <> '' Then
              DelSafeBackendsStr := DelSafeBackendsStr + ', ';
            DelSafeBackendsStr := DelSafeBackendsStr +
                                  IfThen(DelSafeClangVer <> '', 'WASM (Clang ' +
                                         DelSafeClangVer + ')', 'WASM (Clang)');
          End;
        If HasFpc Then
          Begin
            If DelSafeBackendsStr <> '' Then
              DelSafeBackendsStr := DelSafeBackendsStr + ', ';
            DelSafeBackendsStr := DelSafeBackendsStr + 'Pascal (FPC)';
          End;

        If HasDelSafeGcc Then
          WriteLn('  [v] DelSafe Backends:     ', DelSafeBackendsStr)
        Else
          Begin
            WriteLn(
'  [!] DelSafe Backends:     C compiler (GCC) not detected (needed for .test.dels & bv zephyr --target=c)'
            );
            If DelSafeBackendsStr <> '' Then
              WriteLn('      -> Available:         ', DelSafeBackendsStr,
                      ' (run "delsafec --doctor" for details)');
          End;
      End
    Else
      Begin
        WriteLn(
'  [!] DelSafe Compiler:     Not detected (Optional: needed only for --delsafe, .dels & Zephyr)'
        );
        WriteLn(
'      -> Install from: https://github.com/affonsoelias/delsafe (or set DELSAFEC_PATH)'
        );
      End;

    // Zephyr SDK (Bundled)
    ZephyrSdkDir := IncludeTrailingPathDelimiter(SDKDir) + 'vendor' +
                    DirectorySeparator + 'zephyr';
    HasZephyrSdk := FileExists(ZephyrSdkDir + DirectorySeparator + 'src' +
                    DirectorySeparator + 'zephyr.dels');
    If HasZephyrSdk Then
      WriteLn('  [v] Zephyr SDK (Bundled): Verified at ', ExtractRelativePath(
              SDKDir + DirectorySeparator, ZephyrSdkDir))
    Else
      WriteLn(
'  [!] Zephyr SDK (Bundled): Not found in vendor/zephyr (Optional: native DelSafe backend)'
      );

    WriteLn('');
    WriteLn('[2] Ecosystem & Testing Tools:');

    // Python 3
    HasPython := FindPythonExecutable(PyExe, PyVer, PySource);
    If HasPython Then
      WriteLn('  [v] Python 3:             v', PyVer, ' (', PySource,
              ', recommended for tool packages)')
    Else
      Begin
        WriteLn(


'  [!] Python 3:             Not detected in PATH (Recommended for tool packages)'
        );
        WriteLn('      -> Download from: https://www.python.org/');
      End;

    // Node & npm
    HasNode := ExecCmdCapture('node -v', NodeVer) And (Pos('v', NodeVer) = 1);
    If HasNode Then
      Begin
        ExecCmdCapture('npm -v', NpmVer);
        WriteLn('  [v] Node.js & npm:        Node ', NodeVer, ' and npm v',
                NpmVer, ' detected in PATH');
      End
    Else
      Begin
        WriteLn(


'  [!] Node.js:              Not detected in PATH (Optional, needed for "npm test" and HMR)'
        );
        WriteLn('      -> Download: https://nodejs.org');
      End;

    // Docker
    If ExecCmdCapture('docker --version', DockerVer) And (Pos('Docker version',
       DockerVer) > 0) Then
      WriteLn('  [v] Docker CLI:           ', DockerVer,
              ' detected (bv mormot docker)')
    Else
      WriteLn(


'  [!] Docker CLI:           Not detected (Optional: production micro-containers)'
      );

    // Developer Tools Ecosystem
    AllTools := DiscoverAllTools;
    BuiltInCount := 0;
    UserCount := 0;
    For ToolIdx := 0 To High(AllTools) Do
      If AllTools[ToolIdx].IsCustom Then
        Inc(UserCount)
      Else
        Inc(BuiltInCount);

    If Length(AllTools) > 0 Then
      WriteLn('  [v] Developer Tools:      ', Length(AllTools),
      ' tools active (', BuiltInCount, ' built-in, ', UserCount,
      ' user tools in ~/.blaisevue/tools)')
    Else
      WriteLn(


        '  [-] Developer Tools:      0 tools active (manage via "bv tool list")'
      );

    WriteLn('');
    WriteLn('[3] Mobile & Cross-Platform Tooling (Android / Capacitor):');

    // Java Runtime (JDK)
    HasJava := FindBestJavaHome(JavaHome, JavaVer, JavaSource);
    If HasJava Then
      Begin
        MajorJava := ParseJavaVersionMajor(JavaVer, DummyStr);
        If (MajorJava >= 17) And (MajorJava <= 21) Then
          WriteLn('  [v] Java Runtime (JDK):   v', JavaVer, ' (', JavaSource,
                  ' - LTS compatible)')
        Else
          WriteLn('  [!] Java Runtime (JDK):   v', JavaVer, ' (', JavaSource,
                  ' - Warning: Java 17 or 21 LTS recommended for Gradle)');
      End
    Else
      WriteLn(


'  [!] Java Runtime (JDK):   Not detected (Required for Android Gradle builds - install Java 17 LTS)'
      );

    // Android SDK
    AndroidSdkPath := FindAndroidSdkPath;
    If AndroidSdkPath <> '' Then
      WriteLn('  [v] Android SDK:          Detected at ', AndroidSdkPath)
    Else
      WriteLn(


 '  [!] Android SDK:          Not detected in standard paths (set ANDROID_HOME)'
      );

    // ADB
    HasAdb := FindAndroidADBInfo(AdbExe, AdbVer, AdbSource);
    If HasAdb Then
      WriteLn('  [v] Android Debug Bridge: v', AdbVer, ' (', AdbSource, ')')
    Else
      WriteLn(


'  [!] Android Debug Bridge: Not detected (Optional: required for USB/emulator run)'
      );

    // Android Emulator & AVDs
    HasEmulator := FindAndroidEmulatorInfo(EmuExe, EmuSource, AvdCount,
                   AvdListStr);
    If HasEmulator Then
      Begin
        If AvdCount > 0 Then
          WriteLn('  [v] Android Emulator:     Detected (', AvdCount, ' AVD: ',
                  AvdListStr, ')')
        Else
          WriteLn(


'  [!] Android Emulator:     Detected, but 0 AVDs created (create an AVD in Android Studio Device Manager)'
          );
      End
    Else
      WriteLn('  [!] Android Emulator:     Not detected in Android SDK');

    // Capacitor CLI & Runtime
    CapVer := '';
    If ExecCmdCapture('npx --no-install cap --version 2>&1', CapVer) And (CapVer
       <> '') And (Pos('error', LowerCase(CapVer)) = 0) And (Pos('not found',
       LowerCase(CapVer)) = 0) Then
      Begin
        CapVer := Trim(CapVer);
        If Copy(CapVer, 1, 2) = '8.' Then
          WriteLn('  [v] Capacitor Runtime:    v', CapVer,


      ' (v8 LTS active - run "bv capacitor upgrade --check" to inspect updates)'
          )
        Else If Copy(CapVer, 1, 2) = '7.' Then
               WriteLn('  [!] Capacitor Runtime:    v', CapVer,


                ' (v7 Legacy - run "bv capacitor upgrade" to migrate to latest)'
               )
        Else If Copy(CapVer, 1, 2) = '6.' Then
               WriteLn('  [!] Capacitor Runtime:    v', CapVer,


                ' (v6 Legacy - run "bv capacitor upgrade" to migrate to latest)'
               )
        Else
          WriteLn('  [v] Capacitor Runtime:    v', CapVer,
                  ' (installed in project)');
      End
    Else If ExecCmdCapture('cap --version 2>&1', CapVer) And (CapVer <> '') And
            (Pos('error', LowerCase(CapVer)) = 0) Then
           WriteLn('  [v] Capacitor CLI:        v', Trim(CapVer),
           ' (global PATH)')
    Else
      WriteLn(


'  [!] Capacitor CLI:        Not detected (scaffold mobile project via bv capacitor init)'
      );

    // 4. Active Project Alignment
    WriteLn('');
    ProjRoot := FindBlaiseVueProjectRoot('');
    If ProjRoot <> '' Then
      Begin
        ProjName := ExtractFileName(ExcludeTrailingPathDelimiter(ProjRoot));
        If SameText(ProjName, 'BlaiseVue') And DirectoryExists(ProjRoot +
           DirectorySeparator + 'core') Then
          ProjName := ProjName + ' (Framework Core)';
        WriteLn('[4] Active Project Alignment (' + ProjName + '):');

        // A0. BlaiseVue Framework Version
        ReqFw := GetActiveFrameworkVersion;
        If (ReqFw = '') Or (LowerCase(ReqFw) = 'channel') Then
          Begin
            WriteLn('  [v] BlaiseVue Framework:  v' + GetCliVersion +
                    ' (tracking global channel: ' + BranchName + ')');
          End
        Else
          Begin
            UserFwDir := IncludeTrailingPathDelimiter(GetGlobalVersionsPath(
                         'blaisevue')) + ReqFw;
            If DirectoryExists(UserFwDir) And
               FileExists(GetFrameworkVersionBinaryPath(UserFwDir)) Then
              WriteLn('  [v] BlaiseVue Framework:  v' + ReqFw +
                      ' (active in .blaisevue-version, cached)')
            Else If DirectoryExists(UserFwDir) Then
              Begin
                WriteLn('  [!] BlaiseVue Framework:  v' + ReqFw +
                        ' cached, but CLI binary is not compiled yet!');
                WriteLn(
                      '      -> Run to compile:    bv framework upgrade --version='
                        + ReqFw);
                ProjectNotices.Add('BlaiseVue v' + ReqFw +
                  ' cached binary missing -> Run: bv framework upgrade --version='
                  + ReqFw);
              End
            Else
              Begin
                WriteLn('  [!] BlaiseVue Framework:  v' + ReqFw +
                        ' requested in .blaisevue-version, but NOT installed!');
                WriteLn('      -> Active fallback:   v' + GetCliVersion +
                        ' (global channel: ' + BranchName + ')');
                WriteLn(
                      '      -> Run to install:    bv framework upgrade --version='
                        + ReqFw);
                HasFallbackActive := True;
                ProjectNotices.Add('BlaiseVue framework v' + ReqFw +
                  ' is missing -> Run: bv framework upgrade --version=' + ReqFw);
              End;
          End;

        // A. Pas2JS Compiler
        VerFile := IncludeTrailingPathDelimiter(ProjRoot) + '.pas2js-version';
        ReqPas2 := '';
        If FileExists(VerFile) Then
          ReqPas2 := Trim(ReadFileToString(VerFile));

        If (ReqPas2 = '') Or (LowerCase(ReqPas2) = 'bundled') Or (LowerCase(
           ReqPas2) = 'vendor') Or (LowerCase(ReqPas2) = 'default') Then
          Begin
            WriteLn('  [v] Pas2JS Compiler:      v' + Pas2Ver +
                    ' (using factory baseline at vendor/pas2js)');
          End
        Else
          Begin
            UserPas2Dir := IncludeTrailingPathDelimiter(GetGlobalVersionsPath(
                           'pas2js')) + ReqPas2;
            If DirectoryExists(UserPas2Dir) Then
              WriteLn('  [v] Pas2JS Compiler:      v' + ReqPas2 +


       ' (active in .pas2js-version, installed in ~/.blaisevue/versions/pas2js/'
                      + ReqPas2 + ')')
            Else
              Begin
                WriteLn('  [!] Pas2JS Compiler:      v' + ReqPas2 +
                        ' requested in .pas2js-version, but NOT installed!');
                WriteLn('      -> Active fallback:   v' + Pas2Ver +
                        ' (factory baseline at vendor/pas2js)');
                WriteLn(


                      '      -> Run to install:    bv pas2js upgrade --version='
                        + ReqPas2);
                HasFallbackActive := True;
                ProjectNotices.Add('Pas2JS compiler v' + ReqPas2 +


                              ' is missing -> Run: bv pas2js upgrade --version='
                                   + ReqPas2);
              End;
          End;

        // A2. DelSafe Language (Frontend / Services / Tests)
        InspectProjectDelSafeUsage(ProjRoot, BvDelSafeCount, DelsModuleCount,
                                   DelsTestCount, ExtraDelSafePathsCount);
        If (BvDelSafeCount + DelsModuleCount + DelsTestCount) = 0 Then
          Begin
            If ExtraDelSafePathsCount > 0 Then
              WriteLn('  [v] DelSafe Language:     Configured (',
                      ExtraDelSafePathsCount,
                      ' search path(s), 0 files yet)')
            Else
              WriteLn(
'  [-] DelSafe Language:     Not used in this project (optional, use --delsafe to enable)'
              );
          End
        Else
          Begin
            DelSafeSummary := '';
            If BvDelSafeCount > 0 Then
              DelSafeSummary := IntToStr(BvDelSafeCount) + ' .bv';
            If DelsModuleCount > 0 Then
              Begin
                If DelSafeSummary <> '' Then
                  DelSafeSummary := DelSafeSummary + ', ';
                DelSafeSummary := DelSafeSummary + IntToStr(DelsModuleCount) +
                                  ' .dels';
              End;
            If DelsTestCount > 0 Then
              Begin
                If DelSafeSummary <> '' Then
                  DelSafeSummary := DelSafeSummary + ', ';
                DelSafeSummary := DelSafeSummary + IntToStr(DelsTestCount) +
                                  ' .test.dels';
              End;
            If ExtraDelSafePathsCount > 0 Then
              DelSafeSummary := DelSafeSummary + ', +' +
                                IntToStr(ExtraDelSafePathsCount) +
                                ' custom path(s)';

            If HasDelsafec Then
              Begin
                If (DelsTestCount > 0) And (Not HasDelSafeGcc) Then
                  Begin
                    WriteLn('  [!] DelSafe Language:     Active (',
                            DelSafeSummary, ') - GCC missing for .test.dels');
                    WriteLn(
'      -> Run "delsafec --doctor" to inspect C compiler setup (GCC/MSYS2)'
                    );
                    ProjectNotices.Add('Project has ' + IntToStr(DelsTestCount)
                      + ' .test.dels file(s) but GCC (C backend) was not detected -> Run: delsafec --doctor'
                    );
                  End
                Else
                  WriteLn('  [v] DelSafe Language:     Active (',
                          DelSafeSummary, '; delsafec ',
                          IfThen(DelsafecVer = 'detected', 'detected', 'v' +
                                 DelsafecVer), ')');
              End
            Else
              Begin
                WriteLn('  [!] DelSafe Language:     Used in project (',
                        DelSafeSummary, '), but "delsafec" was NOT found!');
                WriteLn(
'      -> Install DelSafe (https://github.com/affonsoelias/delsafe) and add to PATH or set DELSAFEC_PATH'
                );
                ProjectNotices.Add('Project uses DelSafe (' + DelSafeSummary +
                  ') but delsafec compiler is missing -> Install DelSafe or set DELSAFEC_PATH'
                );
              End;
          End;

        // B. mORMot 2 Backend
        MormotDir := ResolveMormotServerDir(ProjRoot, False);
        MormotLabel := ExtractFileName(ExcludeTrailingPathDelimiter(MormotDir));
        HasServerDir := DirectoryExists(MormotDir);
        If Not HasServerDir Then
          Begin
            WriteLn(


  '  [-] mORMot 2 Backend:     Not initialized (optional, run "bv mormot init")'
            );
          End
        Else
          Begin
            MormotConf := MormotDir + DirectorySeparator + 'mormot.path';
            If Not FileExists(MormotConf) Then
              MormotConf := IncludeTrailingPathDelimiter(ProjRoot) +
                            'mormot.path';
            If Not FileExists(MormotConf) Then
              MormotConf := IncludeTrailingPathDelimiter(ProjRoot) +
                            '.mormot-version';

            ReqMormot := '';
            If FileExists(MormotConf) Then
              ReqMormot := Trim(ReadFileToString(MormotConf));

            If (ReqMormot = '') Or (LowerCase(ReqMormot) = 'bundled') Or (
               LowerCase(ReqMormot) = 'default') Or (LowerCase(ReqMormot) =
               'vendor') Then
              Begin
                If MormotLabel = 'server' Then
                  WriteLn(


    '  [v] mORMot 2 Backend:     server/ (legacy path) + bundled vendor/mormot2'
                  )
                Else
                  WriteLn(


           '  [v] mORMot 2 Backend:     server-mormot/ + bundled vendor/mormot2'
                  );
              End
            Else
              Begin
                UserMormotDir := IncludeTrailingPathDelimiter(
                                 GetGlobalVersionsPath('mormot')) + ReqMormot;
                If DirectoryExists(UserMormotDir) Or (DirectoryExists(ReqMormot)
                   And (Pos('src', ReqMormot) > 0)) Then
                  Begin
                    WriteLn('  [v] mORMot 2 Backend:     ' + MormotLabel + '/ ('
                            + ReqMormot + ' via mormot.path)');
                  End
                Else
                  Begin
                    WriteLn('  [!] mORMot 2 Backend:     "' + ReqMormot +
                            '" requested in ' + MormotLabel +
                            '/mormot.path, but NOT found!');
                    WriteLn(


      '      -> Active fallback:   bundled (factory baseline at vendor/mormot2)'
                    );
                    WriteLn(


                          '      -> Run to install:    bv mormot upgrade --tag='
                            + ReqMormot);
                    HasFallbackActive := True;
                    ProjectNotices.Add('mORMot 2 framework "' + ReqMormot +


                                 '" is missing -> Run: bv mormot upgrade --tag='
                                       + ReqMormot);
                  End;
              End;
          End;

        // B2. Zephyr Native DelSafe Backend
        ZephyrServerDir := ResolveZephyrServerDir(ProjRoot, False);
        ZephyrLabel := ExtractFileName(ExcludeTrailingPathDelimiter(
                       ZephyrServerDir));
        HasZephyrDir := DirectoryExists(ZephyrServerDir);
        If Not HasZephyrDir Then
          Begin
            WriteLn(


  '  [-] Zephyr Backend:       Not initialized (optional, run "bv zephyr init")'
            );
          End
        Else
          Begin
            If HasDelsafec Then
              Begin
                If Not HasZephyrSdk Then
                  Begin
                    WriteLn('  [!] Zephyr Backend:       ' + ZephyrLabel +
                            '/ detected, but vendor/zephyr SDK is missing!');
                    ProjectNotices.Add('Zephyr backend exists in ' +
                      ZephyrLabel + '/ but bundled vendor/zephyr SDK is missing'
                    );
                  End
                Else If Not HasDelSafeGcc Then
                  Begin
                    WriteLn('  [!] Zephyr Backend:       ' + ZephyrLabel +
                            '/ (delsafec ' + IfThen(DelsafecVer = 'detected',
                            'detected', 'v' + DelsafecVer) +
                            ', GCC missing for default --target=c; use --target=pascal)'
                    );
                    ProjectNotices.Add('Zephyr backend in ' + ZephyrLabel +
                      '/ needs GCC for default --target=c (or build with --target=pascal)'
                    );
                  End
                Else
                  WriteLn('  [v] Zephyr Backend:       ' + ZephyrLabel +
                          '/ (delsafec ' + IfThen(DelsafecVer = 'detected',
                          'detected', 'v' + DelsafecVer) +
                          IfThen(FileExists(ZephyrServerDir + DirectorySeparator
                          + 'delsafe.json'), '', ', missing delsafe.json') +
                          ', default port 8091)');
              End
            Else
              Begin
                WriteLn('  [!] Zephyr Backend:       ' + ZephyrLabel +
                        '/ detected, but "delsafec" compiler was NOT found!');
                WriteLn(
'      -> Install DelSafe (https://github.com/affonsoelias/delsafe) or set DELSAFEC_PATH'
                );
                ProjectNotices.Add('Zephyr backend exists in ' + ZephyrLabel +
                  '/ but delsafec compiler is missing -> Install DelSafe or set DELSAFEC_PATH'
                );
              End;
          End;

        // C. Capacitor Mobile
        HasMobile := DirectoryExists(IncludeTrailingPathDelimiter(ProjRoot) +
                     'mobile') Or
                     FileExists(IncludeTrailingPathDelimiter(ProjRoot) +
                     'capacitor.config.json');
        If Not HasMobile Then
          Begin
            WriteLn(


'  [-] Capacitor Mobile:     Not initialized in this project (optional, run "bv capacitor init")'
            );
          End
        Else
          Begin
            ReqCapVer := '';
            PkgFile := IncludeTrailingPathDelimiter(ProjRoot) + 'package.json';
            If FileExists(PkgFile) Then
              Begin
                PkgContent := ReadFileToString(PkgFile);
                If Pos('"@capacitor/core": "', PkgContent) > 0 Then
                  Begin
                    ReqCapVer := Copy(PkgContent, Pos('"@capacitor/core": "',
                                 PkgContent) + 20, 20);
                    If Pos('"', ReqCapVer) > 0 Then ReqCapVer := Copy(ReqCapVer,
                                                                 1, Pos('"',
                                                                 ReqCapVer) - 1)
                    ;
                  End;
              End;

            CapCorePath := IncludeTrailingPathDelimiter(ProjRoot) +
                           'node_modules' + DirectorySeparator + '@capacitor' +
                           DirectorySeparator + 'core';
            If Not DirectoryExists(CapCorePath) Then
              CapCorePath := IncludeTrailingPathDelimiter(ProjRoot) + 'mobile' +
                             DirectorySeparator + 'node_modules' +
                             DirectorySeparator + '@capacitor' +
                             DirectorySeparator + 'core';

            If DirectoryExists(CapCorePath) Then
              Begin
                InstalledCapVer := GetPackageVersionFromFolder(CapCorePath);
                If InstalledCapVer = '' Then InstalledCapVer := ReqCapVer;
                If InstalledCapVer = '' Then InstalledCapVer := 'installed';
                WriteLn('  [v] Capacitor Mobile:     v' + InstalledCapVer +
                        ' (installed in node_modules, ready)');
              End
            Else
              Begin
                If ReqCapVer <> '' Then
                  WriteLn('  [!] Capacitor Mobile:     v' + ReqCapVer +


      ' requested in package.json, but node_modules/@capacitor/core is missing!'
                  )
                Else
                  WriteLn(


'  [!] Capacitor Mobile:     Configured, but node_modules/@capacitor/core is missing!'
                  );
                WriteLn('      -> Run to install:    npm install');
                ProjectNotices.Add(


                'Capacitor packages missing in node_modules -> Run: npm install'
                );
              End;
          End;

        // D. External Pluggable Backends (dynamic server-<name>/ scan)
        FoundExtAny := False;
        If FindFirst(IncludeTrailingPathDelimiter(ProjRoot) + 'server-*',
           faDirectory, ExtSR) = 0 Then
          Begin
            Try
              Repeat
                If (ExtSR.Attr And faDirectory) <> 0 Then
                  Begin
                    ExtDirLow := LowerCase(ExtSR.Name);
                    If (ExtDirLow <> 'server-mormot') And (ExtDirLow <>
                       'server-zephyr') Then
                      Begin
                        ExtSuffix := Copy(ExtDirLow, 8, MaxInt);
                        If ExtSuffix <> '' Then
                          Begin
                            FoundExtAny := True;
                            ExtLabel := UpperCase(ExtSuffix[1]) + Copy(ExtSuffix
                                        , 2, MaxInt);
                            If FindInstalledToolByAlias(ExtSuffix, ExtToolRec)
                              Then
                              WriteLn('  [v] ' + PadRight(ExtLabel + ' Backend:'
                                      , 22) + ExtSR.Name + '/ detected (' +
                              ExtToolRec.Name + ' tool active)')
                            Else
                              Begin
                                WriteLn('  [!] ' + PadRight(ExtLabel +
                                        ' Backend:', 22) + ExtSR.Name +
                                '/ detected, but tool "' + ExtSuffix +
                                '" is NOT installed!');
                                WriteLn(


                           '      -> Run to install:    bv tool install blaise-'
                                        + ExtSuffix);
                                ProjectNotices.Add('External backend tool for '
                                                   + ExtSR.Name +


                                  '/ is missing -> Run: bv tool install blaise-'
                                                   + ExtSuffix);
                              End;
                          End;
                      End;
                  End;
              Until FindNext(ExtSR) <> 0;
            Finally
              FindClose(ExtSR);
          End;
      End;
    If Not FoundExtAny Then
      WriteLn(


'  [-] External Backends:    None initialized (e.g. "bv <tool> init" -> server-<name>/)'
      );
End
Else
  Begin
    WriteLn('[4] Active Project Alignment:');
    WriteLn('  [-] No active BlaiseVue project detected in current directory.');
    WriteLn('      Run "bv doctor" inside a project to inspect project-specific'
    );
    WriteLn('      SDK versions, dependencies, and fallback baseline status.');
  End;

If ProjectNotices.Count > 0 Then
  Begin
    WriteLn('');
    WriteLn(


        '----------------------------------------------------------------------'
    );
    WriteLn('  [!] Project Dependency Notice:');
    If HasFallbackActive Then
      Begin
        WriteLn(


     '      The project specifies SDK/tool versions not cached on this machine.'
        );
        WriteLn(


'      Safe factory fallback baselines are currently active to prevent build breakage.'
        );
        WriteLn(


           '      To align your environment with exact project pinned versions:'
        );
      End
    Else
      Begin
        WriteLn(
'      The active project requires compilers, tools, or packages missing on this machine.'
        );
        WriteLn('      To resolve:');
      End;
    For NoticeIdx := 0 To ProjectNotices.Count - 1 Do
      WriteLn('        * ' + ProjectNotices[NoticeIdx]);
    WriteLn(


        '----------------------------------------------------------------------'
    );
  End;

WriteLn('');
WriteLn('======================================================================'
);
If AllHealthy And (ProjectNotices.Count = 0) Then
  WriteLn(


'  [v] Diagnostics complete: Your environment & project are 100% healthy and ready!'
  )
Else If AllHealthy And (ProjectNotices.Count > 0) Then
       Begin
         If HasFallbackActive Then
           Begin
             WriteLn(


'  [!] Diagnostics complete: Environment is healthy, but project has missing pinned versions.'
             );
             WriteLn('      Safe factory fallback baselines are currently active.');
           End
         Else
           WriteLn(
'  [!] Diagnostics complete: Environment is healthy, but active project has missing tools/dependencies.'
           );
       End
Else
  WriteLn('  [!] Issues found with required tools listed above with [X].');
WriteLn('======================================================================'
);
WriteLn('');
Finally
  ProjectNotices.Free;
End;
End;

// =====================================================================
//  FRAMEWORK BINARY & GIT AUTO-UPDATER (bv self-update)
// =====================================================================

Procedure CmdSelfUpdate(Const ChannelOverride: String = '');

Var 
  SDKDir, CurBranch, TargetBranch, GitVer, GitStatusOut, FilteredStatus, LineStr
  , FetchOut: string;
  DiffOut, BehindOut, AheadOut, CheckoutOut, PullOut, FpcExe, FpcVer, FpcSource:
                                                                          string;
  BinDir, CompCmd, CompOut, TargetBv, TargetNew, TargetBak, DummyOut: string;
  DiffList: TStringList;
  CheckOnly, ForceUpdate, NeedRecompile, HadLocalBinMod, SwitchedBranch:
                                                                         Boolean;
  Opts: TBVUpgradeOptions;
  Arg, LowArg, NormChan: string;
  i: Integer;
Begin
  SDKDir := ExcludeTrailingPathDelimiter(GetSDKPath);
  BinDir := SDKDir + DirectorySeparator + 'bin';
  TBVUpgrade.CleanupStaleOldBinary(BinDir);

  FillChar(Opts, SizeOf(Opts), 0);
  Opts.Channel := Trim(ChannelOverride);

  // 1. Parse arguments
  CheckOnly := False;
  ForceUpdate := False;
  For i := 2 To ParamCount Do
    Begin
      Arg := ParamStr(i);
      LowArg := LowerCase(Trim(Arg));
      If (LowArg = '--check') Or (LowArg = '-c') Then
        Begin
          CheckOnly := True;
          Opts.CheckOnly := True;
        End
      Else If (LowArg = '--force') Or (LowArg = '-f') Then
        Begin
          ForceUpdate := True;
          Opts.Force := True;
        End
      Else If LowArg = '--dry-run' Then
             Opts.DryRun := True
      Else If LowArg = '--nightly' Then
             Opts.Nightly := True
      Else If LowArg = '--binary' Then
             Opts.BinaryMode := True
      Else If LowArg = '--from-source' Then
             Opts.FromSource := True
      Else If LowArg = '--rollback' Then
             Opts.Rollback := True
      Else If LowArg = '--allow-unsigned' Then
             Opts.AllowUnsigned := True
      Else If Copy(LowArg, 1, 10) = '--channel=' Then
             Opts.Channel := Trim(Copy(Arg, 11, MaxInt))
      Else If Copy(LowArg, 1, 9) = '--branch=' Then
             Opts.Channel := Trim(Copy(Arg, 10, MaxInt))
      Else If Copy(LowArg, 1, 10) = '--version=' Then
             Opts.TargetVersion := Trim(Copy(Arg, 11, MaxInt))
      Else If (LowArg = '-h') Or (LowArg = '--help') Then
        Begin
          WriteLn('');
          WriteLn('  BlaiseVue Framework Updater (Binary Releases & Git Source)');
          WriteLn('  Usage: bv self-update [options]');
          WriteLn('  Alias: bv upgrade-cli [options]');
          WriteLn('');
          WriteLn('  Options:');
          WriteLn('    --check, -c          Check for updates without applying');
          WriteLn('    --dry-run            Preview update steps without modifying files');
          WriteLn('    --force, -f          Force update/recompilation even if up to date');
          WriteLn('    --channel=<name>     Use channel: stable (main) or nightly (develop)');
          WriteLn('    --nightly            Shortcut for --channel=nightly');
          WriteLn('    --version=<tag>      Target a specific release tag (e.g. v0.1.0)');
          WriteLn('    --binary             Download prebuilt GitHub Release binary (default outside Git)');
          WriteLn('    --from-source        Force Git pull + local FPC build (contributors)');
          WriteLn('    --rollback           Restore previous CLI & SDK backup');
          WriteLn('    --allow-unsigned     Bypass SHA-256 checksum enforcement (unsafe)');
          WriteLn('    -h, --help           Show this help message');
          WriteLn('');
          Halt(0);
        End;
    End;

  If Opts.Rollback Then
    Begin
      CmdRollback;
      Exit;
    End;

  // Use prebuilt binary releases by default on standalone installs or when --binary is requested
  If Opts.BinaryMode Or
     ((Not Opts.FromSource) And
      (Not DirectoryExists(SDKDir + DirectorySeparator + '.git'))) Then
    Begin
      If Opts.Channel <> '' Then
        Begin
          NormChan := TBVUpgrade.NormalizeChannelName(Opts.Channel);
          If NormChan = '' Then
            Begin
              WriteLn('  [ERROR] Unknown channel: "', Opts.Channel,
                      '". Choose "stable" (main) or "nightly" (develop).');
              Halt(1);
            End;
          Opts.Channel := NormChan;
        End;
      TBVUpgrade.HandleBinaryUpgrade(SDKDir, GetOwnExecutablePath, GetCliVersion, Opts);
      Exit;
    End;

  // Source-mode update (Git clone)
  If Not (ExecCmdCapture('git --version', GitVer) And (Pos('git version', GitVer) > 0)) Then
    Begin
      WriteLn('');
      WriteLn('========================================================================');
      WriteLn('  [ERROR] Git was not detected on PATH for --from-source update.');
      WriteLn('  Tip: Run "bv self-update --binary" to download prebuilt binaries without Git.');
      WriteLn('========================================================================');
      WriteLn('');
      Halt(1);
    End;

  // Map channel aliases onto the single trunk branch 'main'
  ExecCmdCapture('git -C "' + SDKDir + '" rev-parse --abbrev-ref HEAD', CurBranch);
  CurBranch := Trim(CurBranch);
  TargetBranch := LowerCase(Trim(Opts.Channel));
  If (TargetBranch = '') Or (TargetBranch = 'stable') Or (TargetBranch = 'main') Then
    TargetBranch := 'main'
  Else If (TargetBranch = 'nightly') Or (TargetBranch = 'develop') Or (TargetBranch = 'dev') Then
    Begin
      WriteLn('  [INFO] BlaiseVue uses the unified "main" trunk; syncing from "main".');
      TargetBranch := 'main';
    End
  Else
    Begin
      WriteLn('  [ERROR] Unknown channel: "', Opts.Channel,
              '". Choose "stable" (main) or "nightly" (develop).');
      Halt(1);
    End;

  WriteLn('');
  WriteLn('======================================================================');
  WriteLn('  BlaiseVue Source Auto-Updater (bv self-update --from-source)');
  WriteLn('======================================================================');
  WriteLn('  SDK Directory:    ', SDKDir);
  WriteLn('  Current Branch:   ', CurBranch);
  WriteLn('  Target Branch:    ', TargetBranch);
  If CheckOnly Then
    WriteLn('  Mode:             CHECK ONLY (--check)')
  Else If Opts.DryRun Then
    WriteLn('  Mode:             DRY RUN (--dry-run)')
  Else
    WriteLn('  Mode:             SYNC & REBUILD');
  WriteLn('======================================================================');
  WriteLn('');

  If Opts.DryRun Then
    Begin
      WriteLn('  [DRY-RUN] Source update plan:');
      WriteLn('    1. git -C "', SDKDir, '" fetch origin');
      WriteLn('    2. git -C "', SDKDir, '" pull origin ', TargetBranch);
      WriteLn('    3. Backup ', BinDir, ' binary -> bv.bak and recompile bv.pas');
      Exit;
    End;

// Safety check for dirty workspace (ignoring compiled CLI binary & logs)
  ExecCmdCapture('git -C "' + SDKDir + '" status --porcelain', GitStatusOut);
  FilteredStatus := '';
  HadLocalBinMod := False;
  DiffList := TStringList.Create;
  Try
    DiffList.Text := GitStatusOut;
    For i := 0 To DiffList.Count - 1 Do
      Begin
        LineStr := StringReplace(Trim(DiffList[i]), '\', '/', [rfReplaceAll]);
        If LineStr = '' Then Continue;
        If (Copy(LineStr, 1, 2) = '??') Or (Copy(LineStr, 1, 2) = '!!') Then
          Continue;
        If (Pos('bin/bv.o', LineStr) > 0) Or
           (Pos('bin/bv.exe', LineStr) > 0) Or
           ((Pos('bin/bv', LineStr) > 0) And (Pos('bin/bv.pas', LineStr) = 0) And
            (Pos('bin/uBVUpgrade', LineStr) = 0)) Or
           (Pos('bin/bv_old', LineStr) > 0) Or
           (Pos('compile_log.txt', LineStr) > 0) Or
           (Pos('compile_err.txt', LineStr) > 0) Then
          Begin
            HadLocalBinMod := True;
            Continue;
          End;
        If FilteredStatus <> '' Then FilteredStatus := FilteredStatus + LineEnding;
        FilteredStatus := FilteredStatus + DiffList[i];
      End;
  Finally
    DiffList.Free;
  End;
  GitStatusOut := FilteredStatus;
  If (Trim(GitStatusOut) <> '') And (Not CheckOnly) Then
    Begin
      If ForceUpdate Then
        Begin
          WriteLn('  [INFO] Local uncommitted changes detected (--force resetting)...');
          ExecCmdCapture('git -C "' + SDKDir + '" checkout -- .', DummyOut);
          HadLocalBinMod := True;
        End
      Else
        Begin
          WriteLn('  [WARNING] You have uncommitted local changes in BlaiseVue:');
          WriteLn(GitStatusOut);
          WriteLn('  Run "git stash" or commit first, or use "bv self-update --force".');
          Halt(1);
        End;
    End
  Else If (Trim(GitStatusOut) <> '') And CheckOnly Then
    WriteLn('  [INFO] Local workspace has uncommitted changes.');

  WriteLn('  Connecting to GitHub (affonsoelias/BlaiseVue)...');
  ExecCmdCapture('git -C "' + SDKDir + '" fetch origin', FetchOut);

  BehindOut := '0';
  AheadOut := '0';
  ExecCmdCapture('git -C "' + SDKDir + '" rev-list --count HEAD..origin/' +
                 TargetBranch, BehindOut);
  ExecCmdCapture('git -C "' + SDKDir + '" rev-list --count origin/' + TargetBranch
                 + '..HEAD', AheadOut);
  BehindOut := Trim(BehindOut);
  AheadOut := Trim(AheadOut);
  If TargetBranch = CurBranch Then
    Begin
      If ((BehindOut = '0') Or (BehindOut = '')) And (Not ForceUpdate) Then
        Begin
          WriteLn('  [v] BlaiseVue source is already up to date with origin/', TargetBranch, '.');
          If (AheadOut <> '0') And (AheadOut <> '') Then
            WriteLn('      (Local branch has ' + AheadOut + ' unpushed commit' +
                    IfThen(AheadOut <> '1', 's', '') + ' ahead of origin/' + TargetBranch + ')');
          WriteLn('======================================================================');
          WriteLn('');
          Exit;
        End;
      ExecCmdCapture('git -C "' + SDKDir + '" diff --name-only HEAD...origin/' +
                     TargetBranch, DiffOut);
    End
  Else
    ExecCmdCapture('git -C "' + SDKDir + '" diff --name-only HEAD origin/' +
                   TargetBranch, DiffOut);

  If (BehindOut <> '0') And (BehindOut <> '') Then
    WriteLn('  [+] New commits found on GitHub: ', BehindOut);

  WriteLn('  [+] Modified files on GitHub:');
  DiffList := TStringList.Create;
  Try
    DiffList.Text := DiffOut;
    For i := 0 To DiffList.Count - 1 Do
      If Trim(DiffList[i]) <> '' Then
        WriteLn('      * ' + Trim(DiffList[i]));
  Finally
    DiffList.Free;
  End;

  If CheckOnly Then
    Begin
      WriteLn('');
      WriteLn('  [TIP] Run "bv self-update --from-source" to apply changes.');
      WriteLn('======================================================================');
      WriteLn('');
      Exit;
    End;

  SwitchedBranch := (TargetBranch <> CurBranch);
  {$IFDEF WINDOWS}
  TargetBv := BinDir + DirectorySeparator + 'bv.exe';
  ExecCmdCapture('cmd.exe /c cd /d "' + BinDir +
                 '" && if exist bv.exe copy /y bv.exe bv.bak.exe > nul 2>&1', DummyOut);
  {$ELSE}
  TargetBv := BinDir + DirectorySeparator + 'bv';
  ExecCmdCapture('cd ''' + BinDir +
                 ''' && if [ -f bv ]; then cp -f bv bv.bak 2>/dev/null; fi', DummyOut);
  {$ENDIF}

  If SwitchedBranch Then
    Begin
      WriteLn('  [+] Switching branch: ' + CurBranch + ' -> ' + TargetBranch + '...');
      ExecCmdCapture('git -C "' + SDKDir + '" checkout ' + TargetBranch, CheckoutOut);
    End;

  If ForceUpdate Then
    Begin
      WriteLn('  [+] Force synchronizing files (git reset --hard origin/' + TargetBranch + ')...');
      ExecCmdCapture('git -C "' + SDKDir + '" reset --hard origin/' + TargetBranch, PullOut);
    End
  Else
    Begin
      WriteLn('  [+] Synchronizing files (git pull origin ' + TargetBranch + ')...');
      ExecCmdCapture('git -C "' + SDKDir + '" pull origin ' + TargetBranch, PullOut);
      If (Pos('error:', LowerCase(PullOut)) > 0) Or (Pos('erro:', LowerCase(PullOut)) > 0) Or
         (Pos('abortando', LowerCase(PullOut)) > 0) Or (Pos('aborting', LowerCase(PullOut)) > 0) Then
        Begin
          WriteLn('  [ERROR] Git pull failed with conflicts:');
          WriteLn('  ' + Trim(PullOut));
          WriteLn('  Run "bv self-update --force" to overwrite conflicts.');
          Halt(1);
        End;
    End;

  {$IFDEF WINDOWS}
  ExecCmdCapture('cmd.exe /c cd /d "' + BinDir +
    '" && if not exist bv.exe if exist bv.bak.exe copy /y bv.bak.exe bv.exe > nul 2>&1', DummyOut);
  {$ELSE}
  ExecCmdCapture('cd ''' + BinDir +
    ''' && if [ ! -f bv ] && [ -f bv.bak ]; then cp -f bv.bak bv && chmod +x bv 2>/dev/null; fi', DummyOut);
  {$ENDIF}

  NeedRecompile := ForceUpdate Or SwitchedBranch Or (Not FileExists(TargetBv)) Or
                   (Pos('bin/bv.pas', DiffOut) > 0) Or
                   (Pos('bin\bv.pas', DiffOut) > 0) Or
                   (Pos('uBVUpgrade.pas', DiffOut) > 0) Or HadLocalBinMod;
  If NeedRecompile Then
    Begin
      WriteLn('  [BUILD] CLI source updated. Recompiling with Free Pascal...');
      If Not FindFPCExecutable(FpcExe, FpcVer, FpcSource) Then
        Begin
          WriteLn('  [WARNING] FPC not found to automatically recompile CLI.');
          WriteLn('            Install Lazarus/FPC and run "bv doctor" to verify.');
          Exit;
        End;

      {$IFDEF WINDOWS}
      TargetNew := BinDir + DirectorySeparator + 'bv_new.exe';
      TargetBv := BinDir + DirectorySeparator + 'bv.exe';
      TargetBak := BinDir + DirectorySeparator + 'bv.bak.exe';
      ExecCmdCapture('cmd.exe /c cd /d "' + BinDir + '" && del /f /q bv_new.exe > nul 2>&1', DummyOut);
      CompCmd := 'cmd.exe /c cd /d "' + BinDir + '" && "' + FpcExe + '" -MObjFPC -Sh -O2 -obv_new.exe bv.pas';
      ExecCmdCapture(CompCmd, CompOut);
      {$ELSE}
      TargetNew := BinDir + DirectorySeparator + 'bv_new';
      TargetBv := BinDir + DirectorySeparator + 'bv';
      TargetBak := BinDir + DirectorySeparator + 'bv.bak';
      ExecCmdCapture('cd ''' + BinDir + ''' && rm -f bv_new 2>/dev/null', DummyOut);
      CompCmd := 'cd ''' + BinDir + ''' && ''' + FpcExe + ''' -MObjFPC -Sh -O2 -obv_new bv.pas && chmod +x bv_new';
      ExecCmdCapture(CompCmd, CompOut);
      {$ENDIF}

      If FileExists(TargetNew) Then
        Begin
          {$IFDEF WINDOWS}
          ExecCmdCapture('cmd.exe /c cd /d "' + BinDir +
            '" && if exist bv.exe (del /f /q bv_old.exe > nul 2>&1 & move /y bv.exe bv_old.exe > nul 2>&1 & copy /y bv_old.exe bv.bak.exe > nul 2>&1) & move /y bv_new.exe bv.exe > nul 2>&1',
            DummyOut);
          {$ELSE}
          ExecCmdCapture('cd ''' + BinDir +
            ''' && if [ -f bv ]; then cp -f bv bv.bak 2>/dev/null; fi && mv -f bv_new bv && chmod +x bv',
            DummyOut);
          {$ENDIF}
          WriteLn('  [SUCCESS] Binary ', ExtractFileName(TargetBv), ' recompiled and updated!');
          WriteLn('  [BACKUP]  Previous binary preserved at ', ExtractFileName(TargetBak));
        End
      Else
        Begin
          WriteLn('  [ERROR] CLI recompilation failed:');
          WriteLn(CompOut);
          {$IFDEF WINDOWS}
          ExecCmdCapture('cmd.exe /c cd /d "' + BinDir + '" && del /f /q bv_new.exe > nul 2>&1', DummyOut);
          If Not FileExists(TargetBv) And FileExists(TargetBak) Then
            ExecCmdCapture('cmd.exe /c cd /d "' + BinDir + '" && copy /y bv.bak.exe bv.exe > nul 2>&1', DummyOut);
          {$ELSE}
          ExecCmdCapture('cd ''' + BinDir + ''' && rm -f bv_new 2>/dev/null', DummyOut);
          If Not FileExists(TargetBv) And FileExists(TargetBak) Then
            ExecCmdCapture('cd ''' + BinDir + ''' && cp -f bv.bak bv && chmod +x bv 2>/dev/null', DummyOut);
          {$ENDIF}
          WriteLn('  [SAFETY] Existing binary preserved intact.');
          Halt(1);
        End;
    End;

  WriteLn('');
  WriteLn('======================================================================');
  WriteLn('  [v] BlaiseVue source updated cleanly on "', TargetBranch, '"!');
  WriteLn('======================================================================');
  WriteLn('');
End;

// =====================================================================
//  FRAMEWORK CHANNEL MANAGER (bv channel)
// =====================================================================

Procedure CmdChannel;

Var 
  SDKDir, SubCmd, ArgVal, NormChan, CurChan, SourceLabel, ConfigPath, ErrMsg, ModeStr: string;
  ApplyNow: Boolean;
  i: Integer;
Begin
  SDKDir := ExcludeTrailingPathDelimiter(GetSDKPath);
  SubCmd := '';
  ArgVal := '';
  ApplyNow := False;

  For i := 2 To ParamCount Do
    Begin
      If (LowerCase(ParamStr(i)) = '--apply') Or (LowerCase(ParamStr(i)) = '--update') Then
        ApplyNow := True
      Else If SubCmd = '' Then
        SubCmd := LowerCase(Trim(ParamStr(i)))
      Else If ArgVal = '' Then
        ArgVal := Trim(ParamStr(i));
    End;

  If (SubCmd = '-h') Or (SubCmd = '--help') Or (SubCmd = 'help') Then
    Begin
      WriteLn('');
      WriteLn('  Usage: bv channel [stable | nightly | show | use <name> | set <name>] [--apply]');
      WriteLn('');
      WriteLn('  Channels:');
      WriteLn('    stable   (alias: main)            Official tagged GitHub Releases (v*.*.*)');
      WriteLn('    nightly  (aliases: develop, dev)  Rolling pre-release builds from main');
      WriteLn('');
      WriteLn('  Options:');
      WriteLn('    --apply, --update   Run "bv self-update" immediately after switching channel');
      WriteLn('    BLAISEVUE_CHANNEL   Environment variable to temporarily override channel');
      WriteLn('');
      Exit;
    End;

  If (SubCmd = '') Or (SubCmd = 'show') Or (SubCmd = 'list') Or (SubCmd = 'status') Then
    Begin
      CurChan := TBVUpgrade.GetConfiguredChannel(SourceLabel);
      ConfigPath := TBVUpgrade.GetConfigFilePath;
      If ConfigPath = '' Then ConfigPath := '~/.blaisevue/config.json';
      If DirectoryExists(SDKDir + DirectorySeparator + '.git') Then
        ModeStr := 'Git Source Clone (supports --from-source or --binary)'
      Else
        ModeStr := 'Standalone Binary (GitHub Releases)';

      WriteLn('');
      WriteLn('======================================================================');
      WriteLn('  BlaiseVue Release Channel Configuration');
      WriteLn('======================================================================');
      WriteLn('  Install Mode   : ', ModeStr);
      WriteLn('  SDK Directory  : ', SDKDir);
      WriteLn('  Active Channel : ', CurChan, ' (source: ', SourceLabel, ')');
      WriteLn('  Config File    : ', ConfigPath);
      WriteLn('');
      WriteLn('  Available Channels:');
      If CurChan = 'stable' Then
        WriteLn('    * stable   [ACTIVE] Official SemVer releases (v*.*.*)  [alias: main]')
      Else
        WriteLn('      stable            Official SemVer releases (v*.*.*)  [alias: main]');
      If CurChan = 'nightly' Then
        WriteLn('    * nightly  [ACTIVE] Rolling pre-releases from main     [aliases: develop, dev]')
      Else
        WriteLn('      nightly           Rolling pre-releases from main     [aliases: develop, dev]');
      WriteLn('');
      WriteLn('  To switch channels:');
      WriteLn('    bv channel use nightly   # Switch to nightly pre-releases');
      WriteLn('    bv channel use stable    # Switch to stable releases');
      WriteLn('======================================================================');
      WriteLn('');
      Exit;
    End;

  If (SubCmd = 'use') Or (SubCmd = 'switch') Or (SubCmd = 'set') Then
    Begin
      If ArgVal = '' Then
        Begin
          WriteLn('Usage: bv channel use <stable|nightly|main|develop>');
          Halt(1);
        End;
    End
  Else
    ArgVal := SubCmd;

  NormChan := TBVUpgrade.NormalizeChannelName(ArgVal);
  If NormChan = '' Then
    Begin
      WriteLn('  [ERROR] Invalid channel: "', ArgVal,
              '". Choose "stable" (main) or "nightly" (develop).');
      Halt(1);
    End;

  If Not TBVUpgrade.SetConfiguredChannel(NormChan, ErrMsg) Then
    Begin
      WriteLn('  [ERROR] ', ErrMsg);
      Halt(1);
    End;

  ConfigPath := TBVUpgrade.GetConfigFilePath;
  WriteLn('');
  WriteLn('  [SUCCESS] Active release channel set to: ', NormChan);
  If Not SameText(Trim(ArgVal), NormChan) Then
    WriteLn('            (Normalized alias "', ArgVal, '" -> "', NormChan, '")');
  If ConfigPath <> '' Then
    WriteLn('            Saved configuration to: ', ConfigPath);

  If ApplyNow Then
    CmdSelfUpdate(NormChan)
  Else
    WriteLn('  Run "bv self-update" to update from the ', NormChan, ' channel.');
  WriteLn('');
End;

// =====================================================================
//  FRAMEWORK BINARY ROLLBACK (bv rollback)
// =====================================================================

Procedure CmdRollback;

Var 
  SDKDir: string;
  DryRun: Boolean;
  i: Integer;
Begin
  SDKDir := ExcludeTrailingPathDelimiter(GetSDKPath);
  DryRun := False;
  For i := 2 To ParamCount Do
    If LowerCase(Trim(ParamStr(i))) = '--dry-run' Then
      DryRun := True;

  If Not TBVUpgrade.HandleBinaryRollback(SDKDir, DryRun) Then
    Halt(1);
End;

// =====================================================================
//  FRAMEWORK MULTI-VERSION MANAGER & AUTO-DELEGATION (bv framework)
// =====================================================================

Function NormalizeFrameworkVersionName(Const RawVer: String): string;

Var 
  S: string;
Begin
  S := Trim(RawVer);
  If (Length(S) >= 2) And ((S[1] = 'v') Or (S[1] = 'V')) And
     (S[2] >= '0') And (S[2] <= '9') Then
    Delete(S, 1, 1);
  Result := S;
End;

Function GetActiveFrameworkVersion: string;

Var 
  ProjDir, VerFile, Raw: string;
Begin
  Result := 'channel';
  ProjDir := FindBlaiseVueProjectRoot('');
  If ProjDir = '' Then Exit;
  VerFile := IncludeTrailingPathDelimiter(ProjDir) + '.blaisevue-version';
  If FileExists(VerFile) Then
    Begin
      Raw := Trim(ReadFileToString(VerFile));
      If (Raw = '') Or (LowerCase(Raw) = 'channel') Or
         (LowerCase(Raw) = 'default') Or (LowerCase(Raw) = 'bundled') Then
        Result := 'channel'
      Else
        Result := NormalizeFrameworkVersionName(Raw);
    End;
End;

Function GetFrameworkVersionBinaryPath(Const VerDir: String): string;
Begin
  Result := IncludeTrailingPathDelimiter(VerDir) + 'bin' + DirectorySeparator +
            {$IFDEF WINDOWS}'bv.exe'{$ELSE}'bv'{$ENDIF};
End;

Function CompileFrameworkVersionBinary(Const VerDir: String; out ErrLog: String
                                       ): Boolean;

Var 
  FpcExe, FpcVer, FpcSource, BinDir, SrcPas, TargetNew, TargetBin, TargetBak:
                                                                          string
  ;
  RC: Integer;
Begin
  Result := False;
  ErrLog := '';
  If Not FindFPCExecutable(FpcExe, FpcVer, FpcSource) Then
    Begin
      ErrLog := 'Free Pascal Compiler (fpc) was not detected on this machine.';
      Exit;
    End;

  BinDir := IncludeTrailingPathDelimiter(VerDir) + 'bin';
  SrcPas := BinDir + DirectorySeparator + 'bv.pas';
  If Not FileExists(SrcPas) Then
    Begin
      ErrLog := 'CLI source file not found: ' + SrcPas;
      Exit;
    End;

  TargetNew := BinDir + DirectorySeparator +
               {$IFDEF WINDOWS}'bv_new.exe'{$ELSE}'bv_new'{$ENDIF};
  TargetBin := GetFrameworkVersionBinaryPath(VerDir);
  TargetBak := BinDir + DirectorySeparator +
               {$IFDEF WINDOWS}'bv.bak.exe'{$ELSE}'bv.bak'{$ENDIF};

  If FileExists(TargetNew) Then
    DeleteFile(TargetNew);

  RC := ExecProcessCaptureExitInDir(FpcExe, BinDir,
          ['-MObjFPC', '-Sh', '-O2', '-o' + ExtractFileName(TargetNew),
           'bv.pas'], ErrLog);
  If (RC = 0) And FileExists(TargetNew) Then
    Begin
      {$IFDEF UNIX}
      FpChmod(TargetNew, &755);
      {$ENDIF}
      If FileExists(TargetBin) Then
        Begin
          CopyFile(TargetBin, TargetBak);
          DeleteFile(TargetBin);
        End;
      If RenameFile(TargetNew, TargetBin) Then
        Begin
          {$IFDEF UNIX}
          FpChmod(TargetBin, &755);
          {$ENDIF}
          Result := True;
        End
      Else
        Begin
          ErrLog := ErrLog + LineEnding + 'Failed to move compiled binary into '
                    + TargetBin;
          If FileExists(TargetNew) Then DeleteFile(TargetNew);
        End;
    End
  Else
    Begin
      If FileExists(TargetNew) Then DeleteFile(TargetNew);
    End;
End;

Procedure TryDelegatePinnedFrameworkVersion;

Var 
  FirstArg, PinnedVer, VersionsDir, VerDir, TargetBin, ErrLog, EnvEntry,
  HostBranch: string;
  P: TProcess;
  I: Integer;
Begin
  If Trim(GetEnvironmentVariable('BV_DELEGATED_VERSION')) <> '' Then Exit;

  If ParamCount >= 1 Then
    Begin
      FirstArg := LowerCase(Trim(ParamStr(1)));
      If (FirstArg = 'framework') Or (FirstArg = 'fw') Or
         (FirstArg = 'versions') Or (FirstArg = 'sdk') Or (FirstArg = 'sdks') Or
         (FirstArg = 'channel') Or (FirstArg = 'branch') Or
         (FirstArg = 'self-update') Or (FirstArg = 'selfupdate') Or
         (FirstArg = 'upgrade-cli') Or (FirstArg = 'rollback') Or
         (FirstArg = 'revert-cli') Or (FirstArg = 'doctor') Or
         (FirstArg = 'doc-env') Or (FirstArg = 'create') Or
         (FirstArg = 'project') Or (FirstArg = 'p') Or (FirstArg = 'use') Then
        Exit;
    End;

  PinnedVer := GetActiveFrameworkVersion;
  If (PinnedVer = '') Or (LowerCase(PinnedVer) = 'channel') Then Exit;

  VersionsDir := GetGlobalVersionsPath('blaisevue');
  VerDir := ExcludeTrailingPathDelimiter(VersionsDir + PinnedVer);
  If Not DirectoryExists(VerDir) Then
    Begin
      If DirectoryExists(ExcludeTrailingPathDelimiter(VersionsDir + 'v' +
         PinnedVer)) Then
        VerDir := ExcludeTrailingPathDelimiter(VersionsDir + 'v' + PinnedVer)
      Else
        Begin
          HostBranch := 'channel';
          If DirectoryExists(ExcludeTrailingPathDelimiter(GetHostSDKPath) +
             DirectorySeparator + '.git') Then
            Begin
              ExecCmdCapture('git -C "' + ExcludeTrailingPathDelimiter(
                             GetHostSDKPath) +
                             '" rev-parse --abbrev-ref HEAD', HostBranch);
              HostBranch := Trim(HostBranch);
              If HostBranch = '' Then HostBranch := 'channel';
            End;
          WriteLn('  [!] Project pins BlaiseVue v' + PinnedVer +
                  ' (.blaisevue-version), but it is NOT installed.');
          WriteLn('      -> Active fallback: global channel (' + HostBranch +
                  ' - v' + GetCliVersion + ')');
          WriteLn('      -> Run to install:  bv framework upgrade --version=' +
                  PinnedVer);
          WriteLn('');
          Exit;
        End;
    End;

  TargetBin := GetFrameworkVersionBinaryPath(VerDir);
  If Not FileExists(TargetBin) Then
    Begin
      If FileExists(IncludeTrailingPathDelimiter(VerDir) + 'bin' +
         DirectorySeparator + 'bv.pas') Then
        Begin
          WriteLn('  [BUILD] Compiling cached BlaiseVue ' + PinnedVer +
                  ' CLI locally with Free Pascal...');
          If Not CompileFrameworkVersionBinary(VerDir, ErrLog) Then
            Begin
              WriteLn('  [!] Failed to compile cached BlaiseVue ' + PinnedVer +
                      ':');
              WriteLn(ErrLog);
              WriteLn('      -> Active fallback: global channel (v' +
                      GetCliVersion + ')');
              WriteLn('');
              Exit;
            End;
        End
      Else
        Begin
          WriteLn('  [!] Cached BlaiseVue ' + PinnedVer +
                  ' is missing bin/bv.pas -> using active channel.');
          Exit;
        End;
    End;

  P := TProcess.Create(Nil);
  Try
    P.Executable := TargetBin;
    For I := 1 To ParamCount Do
      P.Parameters.Add(ParamStr(I));
    P.Options := [poWaitOnExit];
    For I := 1 To GetEnvironmentVariableCount Do
      Begin
        EnvEntry := GetEnvironmentString(I);
        If (Pos('BV_DELEGATED_VERSION=', UpperCase(EnvEntry)) <> 1) And
           (Pos('BV_HOST_SDK=', UpperCase(EnvEntry)) <> 1) Then
          P.Environment.Add(EnvEntry);
      End;
    P.Environment.Add('BV_DELEGATED_VERSION=' + PinnedVer);
    P.Environment.Add('BV_HOST_SDK=' + ExcludeTrailingPathDelimiter(
                      GetHostSDKPath));
    P.Execute;
    Halt(P.ExitStatus);
  Finally
    P.Free;
  End;
End;

Procedure CmdFrameworkVersions;

Var 
  VersionsDir, ActiveVer, SdkDir, BranchName, ItemPath, BinPath, StatusStr:
                                                                          string;
  SR: TSearchRec;
  SizeBytes: Int64;
  HasUserVersions, IsActive: Boolean;
Begin
  VersionsDir := GetGlobalVersionsPath('blaisevue');
  ActiveVer := GetActiveFrameworkVersion;
  SdkDir := ExcludeTrailingPathDelimiter(GetHostSDKPath);
  BranchName := TBVUpgrade.GetConfiguredChannel;
  If DirectoryExists(SdkDir + DirectorySeparator + '.git') Then
    Begin
      ExecCmdCapture('git -C "' + SdkDir + '" rev-parse --abbrev-ref HEAD',
                     BranchName);
      BranchName := Trim(BranchName);
      If BranchName = '' Then BranchName := TBVUpgrade.GetConfiguredChannel;
    End;

  WriteLn('================================================================');
  WriteLn('  BlaiseVue Framework Versions & Channel Status');
  WriteLn('================================================================');
  If (ActiveVer = '') Or (LowerCase(ActiveVer) = 'channel') Then
    WriteLn('  [*] Active in Project:   channel (' + BranchName + ' - v' +
            GetCliVersion + ')')
  Else
    WriteLn('  [*] Active in Project:   ' + ActiveVer + ' (.blaisevue-version)');
  WriteLn('  [*] Host SDK Location:   ' + SdkDir);
  WriteLn('----------------------------------------------------------------');
  WriteLn('  Available Framework Distributions:');

  IsActive := (ActiveVer = '') Or (LowerCase(ActiveVer) = 'channel');
  If IsActive Then
    WriteLn('    [*] channel    ' + SdkDir + ' (ACTIVE: ' + BranchName +
            ', Protected)')
  Else
    WriteLn('    [ ] channel    ' + SdkDir + ' (Global Channel: ' +
            BranchName + ', Protected)');

  HasUserVersions := False;
  If FindFirst(VersionsDir + '*', faDirectory, SR) = 0 Then
    Begin
      Try
        Repeat
          If (SR.Name <> '.') And (SR.Name <> '..') And
             ((SR.Attr And faDirectory) <> 0) And
             (Pos('.tmp', LowerCase(SR.Name)) <> Length(SR.Name) - 3) Then
            Begin
              HasUserVersions := True;
              ItemPath := VersionsDir + SR.Name;
              SizeBytes := GetDirSizeBytes(ItemPath);
              BinPath := GetFrameworkVersionBinaryPath(ItemPath);
              StatusStr := IfThen(FileExists(BinPath), 'ready', 'needs build');
              IsActive := (LowerCase(ActiveVer) = LowerCase(SR.Name));
              If IsActive Then
                WriteLn('    [*] ' + PadRight(SR.Name, 10) + ' ' + ItemPath +
                        ' (ACTIVE | ' + StatusStr + ' | ' +
                        FormatFileSizeMB(SizeBytes) + ')')
              Else
                WriteLn('    [ ] ' + PadRight(SR.Name, 10) + ' ' + ItemPath +
                        ' (' + StatusStr + ' | ' + FormatFileSizeMB(SizeBytes) +
                        ')');
            End;
        Until FindNext(SR) <> 0;
      Finally
        FindClose(SR);
      End;
    End;

  If Not HasUserVersions Then
    WriteLn(
'    (no cached versions installed - run "bv framework upgrade" to install)'
    );

  WriteLn('================================================================');
  WriteLn('To switch version in project: bv framework use <ver | channel>');
  WriteLn('To install/compile version:   bv framework upgrade [--version=<v>]');
  WriteLn('To remove cached version:     bv framework remove-version [ver]');
  WriteLn('================================================================');
End;

Procedure CmdFrameworkUse(TargetVer: String);

Var 
  ProjectRoot, VerFile, NormVer, UserPath, BinPath, ErrLog: string;
Begin
  TargetVer := Trim(TargetVer);
  ProjectRoot := RequireBlaiseVueProject('bv framework use');
  VerFile := IncludeTrailingPathDelimiter(ProjectRoot) + '.blaisevue-version';

  If TargetVer = '' Then
    Begin
      WriteLn('Usage: bv framework use <version | channel>');
      WriteLn('Run "bv framework versions" to view available distributions.');
      Exit;
    End;

  If (LowerCase(TargetVer) = 'channel') Or (LowerCase(TargetVer) = 'default') Or
     (LowerCase(TargetVer) = 'bundled') Then
    Begin
      If FileExists(VerFile) Then
        DeleteFile(VerFile);
      WriteLn(
'  [SUCCESS] Project configured to track active global channel (bv channel).'
      );
      Exit;
    End;

  NormVer := NormalizeFrameworkVersionName(TargetVer);
  UserPath := ExcludeTrailingPathDelimiter(GetGlobalVersionsPath('blaisevue') +
              NormVer);
  If Not DirectoryExists(UserPath) Then
    Begin
      If DirectoryExists(ExcludeTrailingPathDelimiter(GetGlobalVersionsPath(
         'blaisevue') + TargetVer)) Then
        Begin
          NormVer := TargetVer;
          UserPath := ExcludeTrailingPathDelimiter(GetGlobalVersionsPath(
                      'blaisevue') + TargetVer);
        End
      Else
        Begin
          WriteLn('  [ERROR] BlaiseVue version "' + NormVer +
                  '" is not installed.');
          WriteLn('  Run "bv framework upgrade --version=' + NormVer +
                  '" to install and compile it locally.');
          Exit;
        End;
    End;

  BinPath := GetFrameworkVersionBinaryPath(UserPath);
  If (Not FileExists(BinPath)) And FileExists(IncludeTrailingPathDelimiter(
     UserPath) + 'bin' + DirectorySeparator + 'bv.pas') Then
    Begin
      WriteLn('  [BUILD] Compiling cached BlaiseVue ' + NormVer +
              ' CLI locally with Free Pascal...');
      If Not CompileFrameworkVersionBinary(UserPath, ErrLog) Then
        Begin
          WriteLn('  [ERROR] Failed to compile BlaiseVue ' + NormVer + ':');
          WriteLn(ErrLog);
          Halt(1);
        End;
    End;

  WriteStringToFile(VerFile, NormVer);
  WriteLn('  [SUCCESS] Project pinned to BlaiseVue ' + NormVer +
          ' (.blaisevue-version).');
  WriteLn('            Cached CLI: ' + BinPath);
End;

Procedure CmdFrameworkUpgrade(TargetVer: String);

  Function TrySparseCloneRef(Const Repo, RefName, OutDir: String; out LogOut:
                             String): Boolean;
  Var
    RC1, RC2: Integer;
    L1, L2: string;
  Begin
    Result := False;
    If DirectoryExists(OutDir) Then DeleteDir(OutDir);
    RC1 := ExecProcessCaptureExit('git', ['clone', '--depth', '1', '--branch',
             RefName, '--filter=blob:none', '--sparse', Repo, OutDir], L1);
    If RC1 = 0 Then
      Begin
        RC2 := ExecProcessCaptureExitInDir('git', OutDir,
                 ['sparse-checkout', 'set', 'bin', 'core', 'packages/core',
                  'templates', 'vendor/zephyr'], L2);
        LogOut := L1 + LineEnding + L2;
        If RC2 = 0 Then Exit(True);
      End;

    // Fallback for older Git versions without --filter=blob:none / --sparse
    If DirectoryExists(OutDir) Then DeleteDir(OutDir);
    RC1 := ExecProcessCaptureExit('git', ['clone', '--depth', '1', '--branch',
             RefName, Repo, OutDir], L1);
    LogOut := L1;
    If RC1 = 0 Then
      Begin
        If DirectoryExists(OutDir + DirectorySeparator + 'vendor' +
           DirectorySeparator + 'pas2js') Then
          DeleteDir(OutDir + DirectorySeparator + 'vendor' + DirectorySeparator +
                    'pas2js');
        If DirectoryExists(OutDir + DirectorySeparator + 'vendor' +
           DirectorySeparator + 'mormot2') Then
          DeleteDir(OutDir + DirectorySeparator + 'vendor' + DirectorySeparator +
                    'mormot2');
        If DirectoryExists(OutDir + DirectorySeparator + 'demo-app') Then
          DeleteDir(OutDir + DirectorySeparator + 'demo-app');
        If DirectoryExists(OutDir + DirectorySeparator + 'doc') Then
          DeleteDir(OutDir + DirectorySeparator + 'doc');
        If DirectoryExists(OutDir + DirectorySeparator + 'tests') Then
          DeleteDir(OutDir + DirectorySeparator + 'tests');
        Exit(True);
      End;
  End;

Var 
  VersionsDir, SdkDir, RepoUrl, RepoSlug, NormVer, StageDir, DestDir, UserChoice,
  RemoteOut, Line, TagName, RawRef, CloneLog, ErrLog, FpcExe, FpcVer, FpcSource
  , ProjectRoot, BinFile, InstalledTag, BinDlErr, ArgP, LowP: string;
  TagLines, AvailableTags: TStringList;
  I, PosRef, ChoiceIdx, MaxDisp: Integer;
  GitAvail, CloneOk, FromSource, AllowUnsigned, InstalledByBinary: Boolean;
  SizeBytes: Int64;
Begin
  VersionsDir := GetGlobalVersionsPath('blaisevue');
  TargetVer := Trim(TargetVer);
  GitAvail := HasCommand('git');
  RepoSlug := TBVUpgrade.GetReleasesRepo;
  FromSource := False;
  AllowUnsigned := False;

  For I := 3 To ParamCount Do
    Begin
      ArgP := ParamStr(I);
      LowP := LowerCase(Trim(ArgP));
      If LowP = '--from-source' Then
        FromSource := True
      Else If LowP = '--allow-unsigned' Then
        AllowUnsigned := True
      Else If (TargetVer = '') And StartsText('--version=', LowP) Then
        TargetVer := Trim(Copy(ArgP, 11, MaxInt))
      Else If (TargetVer = '') And StartsText('--tag=', LowP) Then
        TargetVer := Trim(Copy(ArgP, 7, MaxInt));
    End;

  If StartsText('--version=', TargetVer) Then
    TargetVer := Copy(TargetVer, 11, Length(TargetVer))
  Else If StartsText('--tag=', TargetVer) Then
    TargetVer := Copy(TargetVer, 7, Length(TargetVer))
  Else If (LowerCase(TargetVer) = '--from-source') Or
          (LowerCase(TargetVer) = '--allow-unsigned') Then
    TargetVer := '';

  SdkDir := ExcludeTrailingPathDelimiter(GetHostSDKPath);
  RepoUrl := '';
  If DirectoryExists(SdkDir + DirectorySeparator + '.git') And GitAvail Then
    Begin
      ExecCmdCapture('git -C "' + SdkDir + '" remote get-url origin', RepoUrl);
      RepoUrl := Trim(RepoUrl);
      If (Pos('fatal:', LowerCase(RepoUrl)) > 0) Or
         (Pos('error:', LowerCase(RepoUrl)) > 0) Then
        RepoUrl := '';
    End;
  If RepoUrl = '' Then
    RepoUrl := 'https://github.com/' + RepoSlug + '.git';

  // Interactive menu if empty
  If TargetVer = '' Then
    Begin
      AvailableTags := TStringList.Create;
      Try
        WriteLn('  [*] Querying available releases from GitHub ...');
        If Not FromSource Then
          TBVUpgrade.FetchAvailableReleaseTags(RepoSlug, AvailableTags, BinDlErr);

        If (AvailableTags.Count = 0) And GitAvail Then
          If ExecCmdCapture('git ls-remote --tags --refs "' + RepoUrl + '"',
             RemoteOut) And (RemoteOut <> '') Then
            Begin
              TagLines := TStringList.Create;
              Try
                TagLines.Text := RemoteOut;
                For I := TagLines.Count - 1 Downto 0 Do
                  Begin
                    Line := Trim(TagLines[I]);
                    PosRef := Pos('refs/tags/', Line);
                    If PosRef > 0 Then
                      Begin
                        TagName := Trim(Copy(Line, PosRef + 10, Length(Line)));
                        If (TagName <> '') And (AvailableTags.IndexOf(TagName) < 0)
                          Then
                          AvailableTags.Add(TagName);
                      End;
                  End;
              Finally
                TagLines.Free;
              End;
            End;

        MaxDisp := AvailableTags.Count;
        If MaxDisp > 8 Then MaxDisp := 8;

        WriteLn('================================================================');
        WriteLn('  BlaiseVue Framework Version Manager');
        WriteLn('================================================================');
        WriteLn('  Repository: ', RepoSlug);
        WriteLn('');
        If MaxDisp > 0 Then
          Begin
            WriteLn('  Published Releases:');
            For I := 0 To MaxDisp - 1 Do
              Begin
                If I = 0 Then
                  WriteLn('    [' + IntToStr(I + 1) + '] ' +
                          PadRight(AvailableTags[I], 14) + ' (Latest Release)')
                Else
                  WriteLn('    [' + IntToStr(I + 1) + '] ' +
                          PadRight(AvailableTags[I], 14));
              End;
          End
        Else
          WriteLn('  (No release tags published yet on GitHub)');
        WriteLn('    [S] stable     (Latest official release / main)');
        WriteLn('    [N] nightly    (Latest rolling pre-release from main)');
        WriteLn('    [C] Custom     (Specify custom tag or branch)');
        WriteLn('================================================================');
        If MaxDisp > 0 Then
          Write('Select option [1-' + IntToStr(MaxDisp) +
                ', S, N, C] or [Q]uit: ')
        Else
          Write('Select option [S, N, C] or [Q]uit: ');
        ReadLn(UserChoice);
        UserChoice := Trim(UserChoice);

        If (UserChoice = '') Or (LowerCase(UserChoice) = 'q') Or
           (LowerCase(UserChoice) = 'quit') Or
           (LowerCase(UserChoice) = 'cancel') Then
          Begin
            WriteLn('Operation cancelled.');
            Exit;
          End
        Else If (LowerCase(UserChoice) = 's') Or (LowerCase(UserChoice) = 'm') Or
                (LowerCase(UserChoice) = 'stable') Or
                (LowerCase(UserChoice) = 'main') Then
               TargetVer := 'stable'
        Else If (LowerCase(UserChoice) = 'n') Or (LowerCase(UserChoice) = 'd') Or
                (LowerCase(UserChoice) = 'nightly') Or
                (LowerCase(UserChoice) = 'dev') Or
                (LowerCase(UserChoice) = 'develop') Then
               TargetVer := 'nightly'
        Else If (LowerCase(UserChoice) = 'c') Or
                (LowerCase(UserChoice) = 'custom') Then
               Begin
                 Write('Enter tag or channel (e.g. v0.1.0, stable, nightly): ');
                 ReadLn(TargetVer);
                 TargetVer := Trim(TargetVer);
                 If TargetVer = '' Then
                   Begin
                     WriteLn('Invalid version.');
                     Exit;
                   End;
               End
        Else
          Begin
            ChoiceIdx := StrToIntDef(UserChoice, -1);
            If (ChoiceIdx >= 1) And (ChoiceIdx <= MaxDisp) Then
              TargetVer := AvailableTags[ChoiceIdx - 1]
            Else
              Begin
                WriteLn('Invalid selection.');
                Exit;
              End;
          End;
      Finally
        AvailableTags.Free;
      End;
    End;

  NormVer := NormalizeFrameworkVersionName(TargetVer);
  If (LowerCase(NormVer) = 'channel') Or (LowerCase(NormVer) = 'default') Or
     (LowerCase(NormVer) = 'bundled') Then
    Begin
      WriteLn(
'  [INFO] "channel" tracks your active channel (bv channel). Use "bv framework use channel" in a project.'
      );
      Exit;
    End;
  If (LowerCase(NormVer) = 'develop') Or (LowerCase(NormVer) = 'dev') Then
    NormVer := 'nightly';

  DestDir := ExcludeTrailingPathDelimiter(VersionsDir + NormVer);
  InstalledByBinary := False;

  // Prefer prebuilt release download unless --from-source was explicitly requested
  If Not FromSource Then
    Begin
      WriteLn('================================================================');
      WriteLn('  Target Framework:  BlaiseVue ' + NormVer + ' (ref: ' + TargetVer + ')');
      WriteLn('  Install Location:  ' + DestDir);
      WriteLn('  Strategy:          Prebuilt GitHub Release (SHA-256 verified)');
      WriteLn('================================================================');

      If TBVUpgrade.DownloadFrameworkVersionBinary(RepoSlug, TargetVer, DestDir,
           AllowUnsigned, InstalledTag, BinDlErr) Then
        InstalledByBinary := True
      Else
        Begin
          WriteLn('  [INFO] Prebuilt release unavailable (', BinDlErr, ').');
          If (Not GitAvail) Or (Not FindFPCExecutable(FpcExe, FpcVer, FpcSource)) Then
            Begin
              WriteLn('  [ERROR] Could not install BlaiseVue ', NormVer,
                      ' without Git + Free Pascal fallback.');
              Halt(1);
            End;
          WriteLn('  [*] Falling back to source build with Git + Free Pascal...');
        End;
    End;

  If Not InstalledByBinary Then
    Begin
      If Not GitAvail Then
        Begin
          WriteLn('  [ERROR] Git was not detected in PATH (required for --from-source).');
          WriteLn('          Install Git from: https://git-scm.com/');
          Halt(1);
        End;

      If Not FindFPCExecutable(FpcExe, FpcVer, FpcSource) Then
        Begin
          WriteLn('  [ERROR] Free Pascal Compiler (FPC) is required for --from-source builds.');
          WriteLn('          Install Lazarus/FPC and run "bv doctor" to verify.');
          Halt(1);
        End;

      StageDir := ExcludeTrailingPathDelimiter(VersionsDir + NormVer + '.tmp');
      WriteLn('================================================================');
      WriteLn('  Target Framework:  BlaiseVue ' + NormVer + ' (ref: ' + TargetVer + ')');
      WriteLn('  Install Location:  ' + DestDir);
      WriteLn('  Build Strategy:    Lean sparse checkout + local FPC (' + FpcVer + ')');
      WriteLn('================================================================');

      WriteLn('  [*] Fetching lean framework sources from GitHub ...');
      CloneOk := False;
      RawRef := TargetVer;
      If SameText(RawRef, 'stable') Then RawRef := 'main'
      Else If SameText(RawRef, 'nightly') Or SameText(RawRef, 'develop') Or SameText(RawRef, 'dev') Then RawRef := 'main';

      If (Length(RawRef) > 0) And (RawRef[1] >= '0') And (RawRef[1] <= '9') Then
        Begin
          CloneOk := TrySparseCloneRef(RepoUrl, 'v' + NormVer, StageDir, CloneLog);
          If Not CloneOk Then
            CloneOk := TrySparseCloneRef(RepoUrl, NormVer, StageDir, CloneLog);
        End
      Else
        CloneOk := TrySparseCloneRef(RepoUrl, RawRef, StageDir, CloneLog);

      If Not CloneOk Then
        Begin
          If DirectoryExists(StageDir) Then DeleteDir(StageDir);
          WriteLn('  [ERROR] Failed to clone BlaiseVue ref "' + RawRef + '" from ' + RepoUrl);
          If Trim(CloneLog) <> '' Then WriteLn(CloneLog);
          Halt(1);
        End;

      BinFile := IncludeTrailingPathDelimiter(StageDir) + 'bin' + DirectorySeparator + 'bv';
      If FileExists(BinFile) Then DeleteFile(BinFile);
      BinFile := IncludeTrailingPathDelimiter(StageDir) + 'bin' + DirectorySeparator + 'bv.exe';
      If FileExists(BinFile) Then DeleteFile(BinFile);
      BinFile := IncludeTrailingPathDelimiter(StageDir) + 'bin' + DirectorySeparator + 'bv.o';
      If FileExists(BinFile) Then DeleteFile(BinFile);

      WriteLn('  [+] Compiling native CLI locally with Free Pascal (' + FpcVer + ') ...');
      If Not CompileFrameworkVersionBinary(StageDir, ErrLog) Then
        Begin
          If DirectoryExists(StageDir) Then DeleteDir(StageDir);
          WriteLn('  [ERROR] Local compilation of BlaiseVue ' + NormVer + ' failed:');
          WriteLn(ErrLog);
          If DirectoryExists(DestDir) Then
            WriteLn('  [SAFETY] Existing cached version at ' + DestDir + ' was preserved intact.');
          Halt(1);
        End;

      If DirectoryExists(DestDir) Then
        DeleteDir(DestDir);
      If Not RenameFile(StageDir, DestDir) Then
        Begin
          WriteLn('  [ERROR] Failed to promote ' + StageDir + ' -> ' + DestDir);
          Halt(1);
        End;
    End;

  SizeBytes := GetDirSizeBytes(DestDir);
  WriteLn('');
  WriteLn('================================================================');
  If InstalledByBinary Then
    WriteLn('  [SUCCESS] BlaiseVue ' + NormVer + ' (' + InstalledTag + ') installed!')
  Else
    WriteLn('  [SUCCESS] BlaiseVue ' + NormVer + ' installed and compiled locally!');
  WriteLn('  Location:  ' + DestDir + ' (' + FormatFileSizeMB(SizeBytes) + ')');
  WriteLn('  CLI Bin:   ' + GetFrameworkVersionBinaryPath(DestDir));
  WriteLn('================================================================');

  Try
    ProjectRoot := FindBlaiseVueProjectRoot('');
    If ProjectRoot <> '' Then
      Begin
        Write('Do you want to activate BlaiseVue "' + NormVer +
              '" in the current project now? [y/N]: ');
        ReadLn(UserChoice);
        UserChoice := LowerCase(Trim(UserChoice));
        If (UserChoice = 'y') Or (UserChoice = 'yes') Or (UserChoice = 's') Or (
           UserChoice = 'sim') Then
          CmdFrameworkUse(NormVer);
      End;
  Except
    // Ignore non-interactive EOF
  End;
End;

Procedure CmdFrameworkRemoveVersion(TargetVer: String; Force: Boolean);

Var 
  VersionsDir, ItemPath, UserChoice, ActiveVer, ProjectRoot, VerFile, NormVer:
                                                                          string
  ;
  SR: TSearchRec;
  Names: TStringList;
  I, ChoiceIdx: Integer;
  SizeBytes: Int64;
  IsActiveInProject: Boolean;
Begin
  VersionsDir := GetGlobalVersionsPath('blaisevue');
  TargetVer := Trim(TargetVer);
  If (LowerCase(TargetVer) = '-y') Or (LowerCase(TargetVer) = '--yes') Then
    Begin
      TargetVer := '';
      Force := True;
    End;

  If (LowerCase(TargetVer) = 'channel') Or (LowerCase(TargetVer) = 'default') Or
     (LowerCase(TargetVer) = 'bundled') Then
    Begin
      WriteLn(
'  [ERROR] The global "channel" installation is protected and cannot be deleted.'
      );
      Exit;
    End;

  If TargetVer = '' Then
    Begin
      Names := TStringList.Create;
      Try
        If FindFirst(VersionsDir + '*', faDirectory, SR) = 0 Then
          Begin
            Try
              Repeat
                If (SR.Name <> '.') And (SR.Name <> '..') And
                   ((SR.Attr And faDirectory) <> 0) And
                   (Pos('.tmp', LowerCase(SR.Name)) <> Length(SR.Name) - 3)
                  Then
                  Names.Add(SR.Name);
              Until FindNext(SR) <> 0;
            Finally
              FindClose(SR);
            End;
          End;

        If Names.Count = 0 Then
          Begin
            WriteLn('No cached BlaiseVue versions found in ' + VersionsDir);
            Exit;
          End;

        WriteLn('================================================================');
        WriteLn('  Cached BlaiseVue Versions (' + VersionsDir + ')');
        WriteLn('================================================================');
        For I := 0 To Names.Count - 1 Do
          Begin
            ItemPath := VersionsDir + Names[I];
            SizeBytes := GetDirSizeBytes(ItemPath);
            WriteLn('  [' + IntToStr(I + 1) + '] ' + PadRight(Names[I], 14) +
                    ' (' + FormatFileSizeMB(SizeBytes) + ')');
          End;
        WriteLn('================================================================');
        Write('Select a version to remove [1-' + IntToStr(Names.Count) +
              '] or [C]ancel: ');
        ReadLn(UserChoice);
        UserChoice := Trim(UserChoice);
        If (UserChoice = '') Or (LowerCase(UserChoice) = 'c') Or
           (LowerCase(UserChoice) = 'cancel') Then
          Begin
            WriteLn('Operation cancelled.');
            Exit;
          End;

        ChoiceIdx := StrToIntDef(UserChoice, -1);
        If (ChoiceIdx < 1) Or (ChoiceIdx > Names.Count) Then
          Begin
            WriteLn('Invalid selection.');
            Exit;
          End;
        TargetVer := Names[ChoiceIdx - 1];
      Finally
        Names.Free;
      End;
    End;

  NormVer := NormalizeFrameworkVersionName(TargetVer);
  ItemPath := ExcludeTrailingPathDelimiter(VersionsDir + NormVer);
  If Not DirectoryExists(ItemPath) Then
    Begin
      If DirectoryExists(ExcludeTrailingPathDelimiter(VersionsDir + TargetVer))
        Then
        Begin
          NormVer := TargetVer;
          ItemPath := ExcludeTrailingPathDelimiter(VersionsDir + TargetVer);
        End
      Else
        Begin
          WriteLn('[!] BlaiseVue version "' + NormVer + '" not found in ' +
                  VersionsDir);
          Exit;
        End;
    End;

  ActiveVer := GetActiveFrameworkVersion;
  IsActiveInProject := (LowerCase(ActiveVer) = LowerCase(NormVer));
  If IsActiveInProject Then
    Begin
      WriteLn('  [WARNING] Version "' + NormVer +
              '" is currently active in this project!');
      WriteLn(
'            If deleted, the project will fall back to your global channel.'
      );
    End;

  If Not Force Then
    Begin
      Write('Are you sure you want to permanently delete BlaiseVue version "' +
            NormVer + '"? [y/N]: ');
      ReadLn(UserChoice);
      UserChoice := LowerCase(Trim(UserChoice));
      If (UserChoice <> 'y') And (UserChoice <> 'yes') And (UserChoice <> 's')
         And (UserChoice <> 'sim') Then
        Begin
          WriteLn('Operation cancelled.');
          Exit;
        End;
    End;

  If IsActiveInProject Then
    Begin
      ProjectRoot := FindBlaiseVueProjectRoot('');
      If ProjectRoot <> '' Then
        Begin
          VerFile := IncludeTrailingPathDelimiter(ProjectRoot) +
                     '.blaisevue-version';
          If FileExists(VerFile) Then
            DeleteFile(VerFile);
        End;
    End;

  SizeBytes := GetDirSizeBytes(ItemPath);
  WriteLn('  [-] Removing ' + ItemPath + ' ...');
  DeleteDir(ItemPath);
  WriteLn('  [SUCCESS] BlaiseVue version "' + NormVer +
          '" removed successfully! (' + FormatFileSizeMB(SizeBytes) +
          ' freed)');
End;

Procedure CmdFramework(Const SubCmd, Arg1, Arg2: String);

Var 
  SC, TargetArg: string;
  ForceArg: Boolean;
Begin
  SC := LowerCase(Trim(SubCmd));
  If (SC = 'versions') Or (SC = 'list') Or (SC = 'ls') Then
    CmdFrameworkVersions
  Else If (SC = 'use') Or (SC = 'switch') Or (SC = 'set') Then
         CmdFrameworkUse(Arg1)
  Else If (SC = 'upgrade') Or (SC = 'install') Or (SC = 'update') Or
          (SC = 'get') Then
         Begin
           TargetArg := Trim(Arg1);
           If ((LowerCase(TargetArg) = '--version') Or
               (LowerCase(TargetArg) = '--tag')) And (Trim(Arg2) <> '') Then
             TargetArg := Trim(Arg2);
           CmdFrameworkUpgrade(TargetArg);
         End
  Else If (SC = 'remove-version') Or (SC = 'delete-version') Or
          (SC = 'remove') Or (SC = 'rm') Then
         Begin
           ForceArg := (LowerCase(Trim(Arg1)) = '-y') Or
                       (LowerCase(Trim(Arg1)) = '--yes') Or
                       (LowerCase(Trim(Arg2)) = '-y') Or
                       (LowerCase(Trim(Arg2)) = '--yes');
           CmdFrameworkRemoveVersion(Arg1, ForceArg);
         End
  Else
    Begin
      WriteLn(
'Usage: bv framework <versions|upgrade [--version=<v>]|use <v|channel>|remove-version [v] [-y]>'
      );
      Halt(1);
    End;
End;

Procedure CmdZephyr(Const SubCmd: String; Const Arg1: String = ''; Const Arg2:
                    String = '');

Var 
  ProjectRoot, ZephyrDir, ZephyrSrcDir, ServerDir, ServerLabel, BinDir,
  SrcFile, OutBin, EnvFile, BinServerDir, DeployServerDir, SavedCwd: string;
  DelsafecExe, TargetMode, PortStr, RawOut, Ans, CurA, ZephyrIncFwd, OutRelFwd:

                                                                          string
  ;
  DeployDir, ZipFile, DistDir, BinName, EnvLine, StartBat, StartSh, ReadmeTxt:
                                                                          string
  ;
  EnvLines, SearchPaths, ArgsList: TStringList;
  IsRelease, ForceFlag, HasZip, DeletedAny: Boolean;
  i, RC: Integer;
  ParamsList: TStringList;
Begin
  ZephyrDir := IncludeTrailingPathDelimiter(GetSDKPath) + 'vendor' +
               DirectorySeparator + 'zephyr';
  ZephyrSrcDir := IncludeTrailingPathDelimiter(ZephyrDir) + 'src';
  DelsafecExe := FindDelsafecPath;

  TargetMode := 'c';
  IsRelease := True;
  ForceFlag := False;
  HasZip := False;
  PortStr := '';
  DeployDir := '';
  If LowerCase(ParamStr(1)) = 'zephyr' Then
    Begin
      For i := 3 To ParamCount Do
        Begin
          CurA := LowerCase(ParamStr(i));
          If CurA = '--target=pascal' Then TargetMode := 'pascal'
          Else If CurA = '--target=c' Then TargetMode := 'c'
          Else If (CurA = '--debug') Or (CurA = '-d') Then IsRelease := False
          Else If (CurA = '--release') Or (CurA = '-r') Then IsRelease := True
          Else If (CurA = '-y') Or (CurA = '--yes') Or (CurA = '-f') Or (CurA =
                  '--force') Then ForceFlag := True
          Else If (CurA = '--zip') Or (CurA = '-z') Then HasZip := True
          Else If Pos('--port=', CurA) = 1 Then PortStr := Copy(ParamStr(i), 8,
                                                           MaxInt)
          Else If ((CurA = '--port') Or (CurA = '-p')) And (i + 1 <= ParamCount)
                 Then PortStr := ParamStr(i + 1)
          Else If Pos('--out=', CurA) = 1 Then DeployDir := Copy(ParamStr(i), 7,
                                                            MaxInt)
          Else If ((CurA = '--out') Or (CurA = '-o')) And (i + 1 <= ParamCount)
                 Then DeployDir := ParamStr(i + 1);
        End;
    End;
  If (LowerCase(Arg1) = '-y') Or (LowerCase(Arg1) = '--yes') Or (LowerCase(Arg1)
     = '-f') Or (LowerCase(Arg1) = '--force') Or
     (LowerCase(Arg2) = '-y') Or (LowerCase(Arg2) = '--yes') Or (LowerCase(Arg2)
     = '-f') Or (LowerCase(Arg2) = '--force') Then
    ForceFlag := True;
  If (LowerCase(Arg1) = '--zip') Or (LowerCase(Arg1) = '-z') Or (LowerCase(Arg2)
     = '--zip') Or (LowerCase(Arg2) = '-z') Then
    HasZip := True;

  If SubCmd = 'status' Then
    Begin
      ProjectRoot := FindBlaiseVueProjectRoot('');
      If ProjectRoot = '' Then ProjectRoot := GetCurrentDir;
      ServerDir := ResolveZephyrServerDir(ProjectRoot, False);
      BinDir := IncludeTrailingPathDelimiter(ServerDir) + 'bin';
      SrcFile := IncludeTrailingPathDelimiter(ServerDir) + 'zephyr_server.dels';
    {$IFDEF WINDOWS}
      OutBin := IncludeTrailingPathDelimiter(BinDir) + 'zephyr_server.exe';
    {$ELSE}
      OutBin := IncludeTrailingPathDelimiter(BinDir) + 'zephyr_server';
    {$ENDIF}
      WriteLn('=== BlaiseVue Zephyr Engine Status ===');
      WriteLn('  Zephyr SDK:    ', ZephyrDir, ' (exists=', BoolToStr(
              DirectoryExists(ZephyrSrcDir), True), ')');
      WriteLn('  delsafec CLI:   ', IfThen(DelsafecExe <> '', DelsafecExe,
              '<NOT FOUND>'));
      WriteLn('  Server Dir:    ', ServerDir, ' (exists=', BoolToStr(
              DirectoryExists(ServerDir), True), ')');
      WriteLn('  Server Entry:  ', SrcFile, ' (exists=', BoolToStr(FileExists(
              SrcFile), True), ')');
      WriteLn('  Server Binary: ', OutBin, ' (exists=', BoolToStr(FileExists(
              OutBin), True), ')');
      WriteLn('  Default Port:  8091');
      Exit;
    End;

  ProjectRoot := RequireBlaiseVueProject('bv zephyr ' + SubCmd);
  ServerDir := ResolveZephyrServerDir(ProjectRoot, SubCmd = 'init');
  ServerLabel := ExtractFileName(ExcludeTrailingPathDelimiter(ServerDir));
  BinDir := IncludeTrailingPathDelimiter(ServerDir) + 'bin';
  SrcFile := IncludeTrailingPathDelimiter(ServerDir) + 'zephyr_server.dels';
  {$IFDEF WINDOWS}
  OutBin := IncludeTrailingPathDelimiter(BinDir) + 'zephyr_server.exe';
  OutRelFwd := 'bin/zephyr_server.exe';
  {$ELSE}
  OutBin := IncludeTrailingPathDelimiter(BinDir) + 'zephyr_server';
  OutRelFwd := 'bin/zephyr_server';
  {$ENDIF}

  If (SubCmd = 'remove') Or (SubCmd = 'rm') Or (SubCmd = 'uninstall') Then
    Begin
      BinServerDir := ProjectRoot + DirectorySeparator + 'bin' +
                      DirectorySeparator + ServerLabel;
      DeployServerDir := ProjectRoot + DirectorySeparator + 'deploy' +
                         DirectorySeparator + ServerLabel;
      If (Not DirectoryExists(ServerDir)) And (Not DirectoryExists(BinServerDir)
         ) And (Not DirectoryExists(DeployServerDir)) Then
        Begin
          WriteLn('Zephyr backend not found in current project (', ServerLabel,
                  '/ directory does not exist).');
          Exit;
        End;
      If Not ForceFlag Then
        Begin
          Write('Are you sure you want to remove the Zephyr backend (',
                ServerLabel, '/ directory)? [y/N]: ');
          ReadLn(Ans);
          Ans := LowerCase(Trim(Ans));
          If (Ans <> 's') And (Ans <> 'y') And (Ans <> 'sim') And (Ans <> 'yes')
            Then
            Begin
              WriteLn('Operation cancelled.');
              Exit;
            End;
        End;

      {$IFDEF WINDOWS}
      ExecuteProcess('cmd', '/c taskkill /F /IM zephyr_server.exe > nul 2>&1');
      {$ENDIF}

      DeletedAny := False;
      If DirectoryExists(ServerDir) Then
        Begin
          WriteLn('  [-] Deleting ', ServerLabel, '/ directory ...');
          DeleteDir(ServerDir);
          DeletedAny := True;
        End;
      If DirectoryExists(BinServerDir) Then
        Begin
          WriteLn('  [-] Deleting binaries in bin/', ServerLabel, '/ ...');
          DeleteDir(BinServerDir);
          DeletedAny := True;
        End;
      If DirectoryExists(DeployServerDir) Then
        Begin
          WriteLn('  [-] Deleting deploy artifacts in deploy/', ServerLabel,
                  '/ ...');
          DeleteDir(DeployServerDir);
          DeletedAny := True;
        End;
      If DeletedAny Then
        Begin
          WriteLn('  [SUCCESS] Zephyr backend removed successfully!');
