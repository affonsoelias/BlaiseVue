            '' + #13#10 +

            '# Expose default HTTP/WebSocket port' + #13#10 +

            'EXPOSE 8090' + #13#10 +

            'ENV PORT=8090' + #13#10 +

            '' + #13#10 +

            '# Healthcheck monitoring endpoint' + #13#10 +




       'HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \'
