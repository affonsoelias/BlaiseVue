             );
             WriteLn(


  '  theme [list]               Displays active and available Bootswatch themes'
             );
             WriteLn(


'  theme use <name>           Sets active default theme in package.json & index.html'
             );
             WriteLn(


              '  theme add <name>           Adds a theme for optimized bundling'
             );
             WriteLn(


                '  theme remove <name>        Removes a theme from package.json'
             );
             WriteLn(


        '  theme reset                Resets theme filters (bundles all themes)'
             );
             WriteLn(


             '  tool <list|search|...>     Manages development tools & packages'
             );
             WriteLn('');
             WriteLn('  # === Project Configuration & Search Paths ===');
             WriteLn(


