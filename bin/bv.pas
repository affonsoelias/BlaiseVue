  Begin
    WriteLn('ERROR: "delsafec" compiler not found in PATH or DELSAFEC_PATH.');
    Halt(1);
  End;
ForceDir(ServerDir);
ForceDir(BinDir);
WriteLn('[2/4] Compiling native Zephyr server (', UpperCase(TargetMode),
' RELEASE)...');
ArgsList := TStringList.Create;
SearchPaths := TStringList.Create;
Try
  ArgsList.Add(SrcFile);
  ArgsList.Add('-I');
  ArgsList.Add(ZephyrSrcDir);
  ArgsList.Add('-I');
  ArgsList.Add(ServerDir);
  ResolveDelSafeSearchPaths(ProjectRoot, SearchPaths);
  For i := 0 To SearchPaths.Count - 1 Do
    Begin
      ArgsList.Add('-I');
      ArgsList.Add(SearchPaths[i]);
    End;
  ArgsList.Add('--target=' + TargetMode);
  ArgsList.Add('--release');
  ArgsList.Add('-o');
  ArgsList.Add(OutBin);
  RC := ExecProcessCaptureExit(DelsafecExe, ArgsList.ToStringArray, RawOut);
Finally
  SearchPaths.Free;
  ArgsList.Free;
End;
WriteLn(RawOut);
