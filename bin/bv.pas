{ Finds the closest valid Cockpit command using Levenshtein distance and prefix matching. }
Function FindClosestCockpitCommand(Const WrongCmd: String; out Suggestion:
                                   String): Boolean;

Var 
  MainCmds: TStringList;
  i, Dist, MinDist: Integer;
  Candidate, LowerWrong: string;
Begin
  Result := False;
  Suggestion := '';
  LowerWrong := LowerCase(Trim(WrongCmd));
  If LowerWrong = '' Then Exit;

  MainCmds := GetCockpitMainCommands;
  Try
    MinDist := 999;
    For i := 0 To MainCmds.Count - 1 Do
      Begin
        Candidate := MainCmds[i];
        // Check prefix match first (e.g. "morm" -> "mormot")
        If (Length(LowerWrong) >= 3) And (Pos(LowerWrong, Candidate) = 1) Then
          Begin
            Suggestion := Candidate;
            Result := True;
            Exit;
          End;

        Dist := LevenshteinDistance(LowerWrong, Candidate);
        If (Dist <= 2) And (Dist < MinDist) Then
          Begin
            MinDist := Dist;
            Suggestion := Candidate;
            Result := True;
          End;
      End;
  Finally
    MainCmds.Free;
End;
End;




{ Finds the closest valid subcommand using Levenshtein distance and prefix matching. }
Function FindClosestSubcommand(Const MainCmd, WrongSub: String; out Suggestion:
                               String): Boolean;

Var 
  SubList: TStringList;
  i, Dist, MinDist: Integer;
  Candidate, LowerWrong: string;
Begin
  Result := False;
  Suggestion := '';
  LowerWrong := LowerCase(Trim(WrongSub));
  If LowerWrong = '' Then Exit;

  SubList := GetCockpitSubcommands(MainCmd);
  Try
    MinDist := 999;
    For i := 0 To SubList.Count - 1 Do
      Begin
        Candidate := SubList[i];
        If (Length(LowerWrong) >= 2) And (Pos(LowerWrong, Candidate) = 1) Then
          Begin
            Suggestion := Candidate;
            Result := True;
            Exit;
          End;

        Dist := LevenshteinDistance(LowerWrong, Candidate);
        If (Dist <= 2) And (Dist < MinDist) Then
          Begin
            MinDist := Dist;
            Suggestion := Candidate;
            Result := True;
          End;
      End;
  Finally
    SubList.Free;
End;
End;




{ Resolves autocompletion candidates for a given input buffer.
  Returns True if completions are available.
  If SingleMatch is found, FullMatch contains the completed string.
  If multiple matches exist, Candidates contains the options. }
Function GetCockpitCompletions(Const InputBuf: String; out FullMatch: String;
                               out Candidates: TStringList): Boolean;

Var 
  Tokens, MainCmds, SubCmds: TStringList;
  MainCmd, SubToken, Candidate: string;
  HasTrailingSpace: Boolean;
  i: Integer;
Begin
  Result := False;
  FullMatch := '';
  Candidates := TStringList.Create;
  Candidates.Sorted := True;
  Candidates.Duplicates := dupIgnore;

  HasTrailingSpace := (Length(InputBuf) > 0) And (InputBuf[Length(InputBuf)] =
                      ' ');
  Tokens := TStringList.Create;
  Try
    SplitTokens(InputBuf, Tokens);

    // Case 1: Empty input -> return all main commands
    If Tokens.Count = 0 Then
      Begin
        MainCmds := GetCockpitMainCommands;
        Try
          Candidates.Assign(MainCmds);
        Finally
          MainCmds.Free;
      End;
    Result := Candidates.Count > 0;
    Exit;
End;

// Case 2: Exactly 1 token and NO trailing space -> complete main command
If (Tokens.Count = 1) And (Not HasTrailingSpace) Then
  Begin
    MainCmd := LowerCase(Tokens[0]);
    MainCmds := GetCockpitMainCommands;
    Try
      For i := 0 To MainCmds.Count - 1 Do
        Begin
          Candidate := MainCmds[i];
          If Pos(MainCmd, Candidate) = 1 Then
            Candidates.Add(Candidate);
        End;
    Finally
      MainCmds.Free;
  End;

If Candidates.Count = 1 Then
  FullMatch := Candidates[0] + ' ';
Result := Candidates.Count > 0;
Exit;
End;




// Case 3: Main command entered + trailing space or subtoken -> complete subcommands
MainCmd := LowerCase(Tokens[0]);
SubCmds := GetCockpitSubcommands(MainCmd);
Try
  If SubCmds.Count = 0 Then Exit;
  // Main command has no subcommands

  If HasTrailingSpace And (Tokens.Count = 1) Then
    Begin
      // User typed "mormot " -> list all subcommands
      Candidates.Assign(SubCmds);
    End
  Else If Tokens.Count >= 2 Then
         Begin
           // User typed "mormot r" -> filter subcommands starting with "r"
           SubToken := LowerCase(Tokens[1]);
           For i := 0 To SubCmds.Count - 1 Do
             Begin
               Candidate := SubCmds[i];
               If Pos(SubToken, Candidate) = 1 Then
                 Candidates.Add(Candidate);
             End;
           If Candidates.Count = 1 Then
             FullMatch := Tokens[0] + ' ' + Candidates[0] + ' ';
         End;
Finally
  SubCmds.Free;
End;

Result := Candidates.Count > 0;
Finally
  Tokens.Free;
End;
End;

Var 
  CockpitHistory: TStringList = nil;

{$IFDEF WINDOWS}
Function CockpitReadInteractive(Const Prompt: String; out S: String): Boolean;

Var 
  hIn: THandle;
  Mode, OldMode: DWORD;
  IR: INPUT_RECORD;
  Count: DWORD;
  Buf, FullMatch: string;
  Candidates: TStringList;
  VK: Word;
  Ch: AnsiChar;
  i, HistIdx, ColWidth, ItemsPerLine: Integer;
Begin
  S := '';
  Buf := '';
  Result := False;
  If Prompt <> '' Then
    Begin
      Write(Prompt);
      Flush(Output);
    End;

  hIn := GetStdHandle(STD_INPUT_HANDLE);
  If (hIn = 0) Or (hIn = INVALID_HANDLE_VALUE) Or (Not GetConsoleMode(hIn,
     OldMode)) Then
    Begin
      // Fallback if redirected or non-interactive pipe
      If Eof Then Exit(False);
      Try
        ReadLn(S);
        Result := True;
      Except
        Result := False;
    End;
  Exit;
End;

// Disable line buffering and automatic echo to intercept Tab, Arrows, etc.
Mode := OldMode And (Not (ENABLE_LINE_INPUT Or ENABLE_ECHO_INPUT));
SetConsoleMode(hIn, Mode);
Try
  If CockpitHistory = Nil Then
    Begin
      CockpitHistory := TStringList.Create;
      CockpitHistory.Duplicates := dupIgnore;
    End;
  HistIdx := CockpitHistory.Count;

  While True Do
    Begin
      Count := 0;
      If Not ReadConsoleInput(hIn, IR, 1, Count) Then Break;
      If (Count = 1) And (IR.EventType = KEY_EVENT) And (IR.Event.KeyEvent.
         bKeyDown) Then
        Begin
          VK := IR.Event.KeyEvent.wVirtualKeyCode;
          Ch := IR.Event.KeyEvent.AsciiChar;

          // Enter
          If (VK = VK_RETURN) Or (Ch = #13) Or (Ch = #10) Then
            Begin
              WriteLn('');
              S := Trim(Buf);
              If S <> '' Then
                Begin
                  If (CockpitHistory.Count = 0) Or (CockpitHistory[
                     CockpitHistory.Count - 1] <> S) Then
                    CockpitHistory.Add(S);
                End;
              Result := True;
              Break;
            End

            // Tab Autocompletion
          Else If (VK = VK_TAB) Or (Ch = #9) Then
                 Begin
                   If GetCockpitCompletions(Buf, FullMatch, Candidates) Then
                     Begin
                       Try
                         If FullMatch <> '' Then
                           Begin
                             // Single unique completion
                             Write(#13 + Prompt + StringOfChar(' ', Length(Buf))
                             + #13 + Prompt + FullMatch);
                             Flush(Output);
                             Buf := FullMatch;
                           End
                         Else If Candidates.Count > 1 Then
                                Begin



                               // Multiple completions -> display formatted grid
                                  WriteLn('');
                                  ColWidth := 16;
                                  ItemsPerLine := 4;
                                  For i := 0 To Candidates.Count - 1 Do
                                    Begin
                                      If (i Mod ItemsPerLine = 0) Then
                                        Write('  ');
                                      Write(PadRight(Candidates[i], ColWidth));
                                      If (i Mod ItemsPerLine = ItemsPerLine - 1)
                                         Or (i = Candidates.Count - 1) Then
                                        WriteLn('');
                                    End;
                                  Write(Prompt + Buf);
                                  Flush(Output);
                                End;
                       Finally
                         Candidates.Free;
                     End;
                 End;
        End

        // Up Arrow (Navigate history backwards)
      Else If VK = VK_UP Then
             Begin
               If (CockpitHistory.Count > 0) And (HistIdx > 0) Then
                 Begin
                   Dec(HistIdx);
                   Write(#13 + Prompt + StringOfChar(' ', Length(Buf)) + #13 +
                   Prompt + CockpitHistory[HistIdx]);
                   Flush(Output);
                   Buf := CockpitHistory[HistIdx];
                 End;
             End

             // Down Arrow (Navigate history forwards)
      Else If VK = VK_DOWN Then
             Begin
               If HistIdx < CockpitHistory.Count - 1 Then
                 Begin
                   Inc(HistIdx);
                   Write(#13 + Prompt + StringOfChar(' ', Length(Buf)) + #13 +
                   Prompt + CockpitHistory[HistIdx]);
                   Flush(Output);
                   Buf := CockpitHistory[HistIdx];
                 End
               Else If HistIdx = CockpitHistory.Count - 1 Then
                      Begin
                        HistIdx := CockpitHistory.Count;
                        Write(#13 + Prompt + StringOfChar(' ', Length(Buf)) + #13 + Prompt);
                        Flush(Output);
                        Buf := '';
                      End;
             End

             // Backspace
      Else If (VK = VK_BACK) Or (Ch = #8) Then
             Begin
               If Length(Buf) > 0 Then
                 Begin
                   SetLength(Buf, Length(Buf) - 1);
                   Write(#8' '#8);
                   Flush(Output);
                 End;
             End

             // Escape (clear line)
      Else If VK = VK_ESCAPE Then
             Begin
               Write(#13 + Prompt + StringOfChar(' ', Length(Buf)) + #13 +
               Prompt);
               Flush(Output);
               Buf := '';
               HistIdx := CockpitHistory.Count;
             End

             // Ctrl+C (Interrupt line)
      Else If (Ch = #3) Or ((VK = Ord('C')) And ((IR.Event.KeyEvent.
              dwControlKeyState And (LEFT_CTRL_PRESSED Or RIGHT_CTRL_PRESSED))
              <> 0)) Then
             Begin
               WriteLn('^C');
               Write(Prompt);
               Flush(Output);
               Buf := '';
               HistIdx := CockpitHistory.Count;
             End

             // Standard Printable Characters
      Else If (Ch >= ' ') And (Ch <= #126) Then
             Begin
               Buf := Buf + Ch;
               Write(Ch);
               Flush(Output);
             End;
    End;
End;
Finally
  SetConsoleMode(hIn, OldMode);
End;
End;
{$ENDIF}

{$IFDEF UNIX}
Function CockpitReadInteractive(Const Prompt: String; out S: String): Boolean;

Var 
  OldTerm, NewTerm: TermIOS;
  Ch, NextCh, DirCh: Char;
  Buf, FullMatch: string;
  Candidates: TStringList;
  HistIdx, i, ColWidth, ItemsPerLine: Integer;
Begin
  S := '';
  Buf := '';
  Result := False;
  If Prompt <> '' Then
    Begin
      Write(Prompt);
      Flush(Output);
    End;

  If isatty(0) = 0 Then
    Begin
      // Fallback if redirected or non-interactive pipe
      If Eof Then Exit(False);
      Try
        ReadLn(S);
        Result := True;
      Except
        Result := False;
    End;
  Exit;
End;

TCGetAttr(0, OldTerm);
NewTerm := OldTerm;
NewTerm.c_lflag := NewTerm.c_lflag And (Not (ICANON Or ECHO));
NewTerm.c_cc[VMIN] := 1;
NewTerm.c_cc[VTIME] := 0;
TCSetAttr(0, TCSANOW, NewTerm);
Try
  If CockpitHistory = Nil Then
    Begin
      CockpitHistory := TStringList.Create;
      CockpitHistory.Duplicates := dupIgnore;
    End;
  HistIdx := CockpitHistory.Count;

  While True Do
    Begin
      Ch := #0;
      If fpRead(0, Ch, 1) <= 0 Then Break;

      // Enter
      If (Ch = #10) Or (Ch = #13) Then
        Begin
          WriteLn('');
          S := Trim(Buf);
          If S <> '' Then
            Begin
              If (CockpitHistory.Count = 0) Or (CockpitHistory[CockpitHistory.
                 Count - 1] <> S) Then
                CockpitHistory.Add(S);
            End;
          Result := True;
          Break;
        End

        // Tab Autocompletion
      Else If Ch = #9 Then
             Begin
               If GetCockpitCompletions(Buf, FullMatch, Candidates) Then
                 Begin
                   Try
                     If FullMatch <> '' Then
                       Begin
                         Write(#13 + Prompt + StringOfChar(' ', Length(Buf)) + #13 + Prompt + FullMatch);
                         Flush(Output);
                         Buf := FullMatch;
                       End
                     Else If Candidates.Count > 1 Then
                            Begin
                              WriteLn('');
                              ColWidth := 16;
                              ItemsPerLine := 4;
                              For i := 0 To Candidates.Count - 1 Do
                                Begin
                                  If (i Mod ItemsPerLine = 0) Then
                                    Write('  ');
                                  Write(PadRight(Candidates[i], ColWidth));
                                  If (i Mod ItemsPerLine = ItemsPerLine - 1) Or
                                     (i = Candidates.Count - 1) Then
                                    WriteLn('');
                                End;
                              Write(Prompt + Buf);
                              Flush(Output);
                            End;
                   Finally
                     Candidates.Free;
                 End;
             End;
    End

    // Backspace
    Else If (Ch = #127) Or (Ch = #8) Then
           Begin
             If Length(Buf) > 0 Then
               Begin
                 SetLength(Buf, Length(Buf) - 1);
                 Write(#8' '#8);
                 Flush(Output);
               End;
           End

           // ANSI Escape Sequences (Arrow Keys)
    Else If Ch = #27 Then
           Begin
             NextCh := #0;
             If fpRead(0, NextCh, 1) > 0 Then
               Begin
                 If NextCh = '[' Then
                   Begin
                     DirCh := #0;
                     If fpRead(0, DirCh, 1) > 0 Then
                       Begin
                         // Up Arrow: ESC [ A
                         If DirCh = 'A' Then
                           Begin
                             If (CockpitHistory.Count > 0) And (HistIdx > 0)
                               Then
                               Begin
                                 Dec(HistIdx);
                                 Write(#13 + Prompt + StringOfChar(' ', Length(
                                       Buf)) + #13 + Prompt + CockpitHistory[
                                 HistIdx]);
                                 Flush(Output);
                                 Buf := CockpitHistory[HistIdx];
                               End;
                           End
                           // Down Arrow: ESC [ B
                         Else If DirCh = 'B' Then
                                Begin
                                  If HistIdx < CockpitHistory.Count - 1 Then
                                    Begin
                                      Inc(HistIdx);
                                      Write(#13 + Prompt + StringOfChar(' ',
                                            Length(Buf)) + #13 + Prompt +
                                      CockpitHistory[HistIdx]);
                                      Flush(Output);
                                      Buf := CockpitHistory[HistIdx];
                                    End
                                  Else If HistIdx = CockpitHistory.Count - 1
                                         Then
                                         Begin
                                           HistIdx := CockpitHistory.Count;
                                           Write(#13 + Prompt + StringOfChar(' '
                                                 , Length(Buf)) + #13 + Prompt);
                                           Flush(Output);
                                           Buf := '';
                                         End;
                                End;
                       End;
                   End;
               End;
           End

           // Ctrl+C
    Else If Ch = #3 Then
           Begin
             WriteLn('^C');
             Write(Prompt);
             Flush(Output);
             Buf := '';
             HistIdx := CockpitHistory.Count;
           End

           // Standard Printable Characters
    Else If Ch >= ' ' Then
           Begin
             Buf := Buf + Ch;
             Write(Ch);
             Flush(Output);
           End;
End;
Finally
  TCSetAttr(0, TCSANOW, OldTerm);
End;
End;
{$ENDIF}

Function CockpitReadLine(Const Prompt: String; out S: String): Boolean;
Begin
  Result := CockpitReadInteractive(Prompt, S);
End;

Function CockpitReadLine(out S: String): Boolean;
Begin
  Result := CockpitReadInteractive('', S);
End;

Procedure RunCockpitShell(Const InitialName, InitialPath: String);

Var 
  ActiveName, ActivePath, InputLine, CmdName, DummyName: string;
  Tokens, SubCmdList: TStringList;
  FoundPath, FoundVer, SummaryHelp, Suggestion, SubSuggestion, RestOfLine:


                                                                          string
  ;
  i: Integer;
  BvExePath: string;
  {$IFDEF UNIX}
  OldSigIntHandler: signalhandler;
  OldSigQuitHandler: signalhandler;
  {$ENDIF}
Begin
  {$IFDEF WINDOWS}
  SetConsoleCtrlHandler(@CockpitConsoleCtrlHandler, True);
  {$ENDIF}
  {$IFDEF UNIX}
  OldSigIntHandler := fpSignal(SIGINT, @CockpitSigIntHandler);
  OldSigQuitHandler := fpSignal(SIGQUIT, @CockpitSigIntHandler);
  {$ENDIF}
  ActiveName := InitialName;
  ActivePath := InitialPath;
  BvExePath := GetOwnExecutablePath;
  WriteLn('');
  WriteLn(


      '========================================================================'
  );
  WriteLn('  [BlaiseVue Interactive Cockpit]');
  WriteLn('  Active Project: ' + ActiveName + ' (' + ActivePath + ')');
  WriteLn('  Full-Stack Pascal & Reactive CLI Environment');
  WriteLn('  Type "help" for command list, or "exit" to quit.');
  WriteLn(


      '========================================================================'
  );
  WriteLn('');
  ClearInputBuffer;
  Tokens := TStringList.Create;
  Try
    While True Do
      Begin
        InputLine := '';
        If Not CockpitReadLine('[bv: ' + ActiveName + '] > ', InputLine) Then
          Begin
            WriteLn('');
            Break;
          End;
        InputLine := Trim(InputLine);
        If InputLine = '' Then Continue;

        // Handle typing 'bv' alone in Cockpit: show Cockpit help!
        If (LowerCase(InputLine) = 'bv') Then
          InputLine := 'help'
                       // Strip leading 'bv ' if typed out of habit
        Else If (Length(InputLine) >= 3) And (LowerCase(Copy(InputLine, 1, 3)) =
                'bv ') Then
               InputLine := Trim(Copy(InputLine, 4, Length(InputLine)));

        SplitTokens(InputLine, Tokens);
        If Tokens.Count = 0 Then Continue;

        // Also strip 'bv' if it was tokenized: e.g. 'bv' 'dev' -> 'dev'
        If (Tokens.Count > 1) And (LowerCase(Tokens[0]) = 'bv') Then
          Tokens.Delete(0);

        CmdName := LowerCase(Tokens[0]);

        // Phase 3: Subcommand Helper for incomplete parent commands
        If (Tokens.Count = 1) And (CmdName <> 'exit') And (CmdName <> 'quit')
           And (CmdName <> 'q') And
           (CmdName <> 'clear') And (CmdName <> 'files') And (CmdName <> 'enter'
           ) And (CmdName <> 'help') And
           (CmdName <> 'dev') And (CmdName <> 'build') And (CmdName <> 'preview'
           ) And (CmdName <> 'test') And
           (CmdName <> 'clean') And (CmdName <> 'check') And (CmdName <> 'ssg')
           And (CmdName <> 'doctor') And
           (CmdName <> 'self-update') And (CmdName <> 'reset') And (CmdName <>
           'update') And (CmdName <> 'upgrade') Then
          Begin
            SummaryHelp := GetCockpitSubcommandSummary(CmdName);
            If SummaryHelp <> '' Then
              Begin
                WriteLn('');
                WriteLn(SummaryHelp);
                WriteLn('');
                Continue;
              End;
          End;

        // Phase 4: Subcommand typo detection (e.g. "mormot buid")
        If (Tokens.Count >= 2) And (Copy(Tokens[1], 1, 1) <> '-') Then
          Begin
            SubCmdList := GetCockpitSubcommands(CmdName);
            Try
              If (SubCmdList.Count > 0) And (SubCmdList.IndexOf(LowerCase(Tokens
                 [1])) < 0) Then
                Begin
                  If FindClosestSubcommand(CmdName, Tokens[1], SubSuggestion)
                    Then
                    Begin
                      WriteLn('');
                      WriteLn('  [?] Unrecognized subcommand: ''' + Tokens[1] +
                              ''' for ''' + CmdName + '''');
                      WriteLn('   Did you mean: ''' + CmdName + ' ' +
                              SubSuggestion + '''?');
                      WriteLn('');
                      Continue;
                    End;
                End;
            Finally
              SubCmdList.Free;
          End;
      End;

    // Exit / Quit
    If (CmdName = 'exit') Or (CmdName = 'quit') Or (CmdName = 'q') Then
      Begin
        WriteLn('Exiting BlaiseVue Cockpit. Goodbye!');
        Break;
      End

      // Clear screen
    Else If CmdName = 'clear' Then
           Begin
             ClearScreen(True, ActiveName, ActivePath);
           End

           // Project files tree
    Else If CmdName = 'files' Then
           Begin
             If (Tokens.Count >= 2) And ((LowerCase(Tokens[1]) = '--all') Or (
                LowerCase(Tokens[1]) = '-a')) Then
               CmdFiles('', True)
             Else If (Tokens.Count >= 3) And ((LowerCase(Tokens[2]) = '--all')
                     Or (LowerCase(Tokens[2]) = '-a')) Then
                    CmdFiles(Tokens[1], True)
             Else If Tokens.Count >= 2 Then
                    CmdFiles(Tokens[1], False)
             Else
               CmdFiles('', False);
           End

           // Enter (already inside)
    Else If CmdName = 'enter' Then
           Begin
             WriteLn(


                'You are already inside the BlaiseVue Cockpit! Active project: '
                     + ActiveName);
             WriteLn('To switch projects, use: use <project-name>');
             WriteLn('To exit, use: exit');
           End

           // Help
    Else If (CmdName = 'help') Or (CmdName = '?') Or (CmdName = '--help') Or (
            CmdName = '-h') Then
           Begin
             WriteLn('');
             WriteLn('  BlaiseVue Interactive Cockpit v' + GetCliVersion +
                     ' (Active Project: ' + ActiveName + ')');
             WriteLn(


                '  ============================================================'
             );
             WriteLn(


'  Type any command directly without repeating "bv". Use [TAB] for autocomplete.'
             );
             WriteLn('');
             WriteLn('  # === Scaffolding & Generators ===');
             WriteLn(


'  g c <Name>                 Scaffolds a component (.bv) & test in tests/components/ (alias: new c)'
             );
