Function BuildExtraPascalFuFlags(Const ProjectRoot: String; Const Quoted:
                                 Boolean): string;

Var 
  Paths: TStringList;
  I: Integer;
Begin
  Result := '';
  Paths := TStringList.Create;
  Try
    ResolvePascalSearchPaths(ProjectRoot, Paths);
    For I := 0 To Paths.Count - 1 Do
      If Quoted Then
        Result := Result + ' -Fu"' + Paths[I] + '"'
      Else
        Result := Result + ' -Fu' + Paths[I];
  Finally
    Paths.Free;
  End;
End;

Function FindDelSafeModuleFile(Const ProjectRoot, ModName: String): string;

Var 
  SearchPaths: TStringList;
  I: Integer;
  Cand1, Cand2: string;
Begin
  Result := '';
  SearchPaths := TStringList.Create;
  Try
    ResolveDelSafeSearchPaths(ProjectRoot, SearchPaths);
    For I := 0 To SearchPaths.Count - 1 Do
      Begin
        Cand1 := IncludeTrailingPathDelimiter(SearchPaths[I]) + ModName +
                 '.dels';
        Cand2 := IncludeTrailingPathDelimiter(SearchPaths[I]) + LowerCase(
                 ModName) + '.dels';
        If FileExists(Cand1) Then Exit(Cand1);
        If FileExists(Cand2) Then Exit(Cand2);
      End;
  Finally
    SearchPaths.Free;
End;
End;

Procedure AppendPascalServiceWrappers(Const ProjectRoot, UnitName: String; Var
                                      OutMethodsPas: String);

Var 
  PasPath, RawPas, Line, LowLine, SigPart, FuncName, RawParams, PasParams,
  CallArgs, RetPart: string;
  Lines, Groups, Ids, PasPaths: TStringList;
  I, J, K, InIntf, POpen, PClose, PColon, PSemi, TypeDepth: Integer;
  IsFunc, InImpl, InTypeSection: Boolean;
Begin
  PasPath := IncludeTrailingPathDelimiter(ProjectRoot) + 'src' +
             DirectorySeparator + 'services' + DirectorySeparator + UnitName +
             '.pas';
  If Not FileExists(PasPath) Then
    PasPath := IncludeTrailingPathDelimiter(ProjectRoot) + 'src' +
               DirectorySeparator + UnitName + '.pas';
  If Not FileExists(PasPath) Then
    Begin
      PasPaths := TStringList.Create;
      Try
        ResolvePascalSearchPaths(ProjectRoot, PasPaths);
        For I := 0 To PasPaths.Count - 1 Do
          If FileExists(IncludeTrailingPathDelimiter(PasPaths[I]) + UnitName +
             '.pas') Then
            Begin
              PasPath := IncludeTrailingPathDelimiter(PasPaths[I]) + UnitName +
                         '.pas';
              Break;
            End;
      Finally
        PasPaths.Free;
      End;
    End;
  If Not FileExists(PasPath) Then Exit;

  RawPas := ReadFileToString(PasPath);
  Lines := TStringList.Create;
  Groups := TStringList.Create;
  Ids := TStringList.Create;
  Try
    Lines.Text := RawPas;
    InIntf := 0;
    InImpl := False;
    InTypeSection := False;
    TypeDepth := 0;
    For I := 0 To Lines.Count - 1 Do
      Begin
        Line := Trim(Lines[I]);
        LowLine := LowerCase(Line);
        If LowLine = 'interface' Then
          Begin
            InIntf := 1;
            Continue;
          End;
        If (LowLine = 'implementation') Or (Pos('implementation ', LowLine) = 1)
          Then
          Begin
            InImpl := True;
            Break;
          End;
        If InIntf = 0 Then Continue;

        If (LowLine = 'type') Or (LowLine = 'const') Or (LowLine = 'var') Then
          Begin
            InTypeSection := (LowLine = 'type');
            Continue;
          End;
        If InTypeSection Then
          Begin
            If (Pos('= class', LowLine) > 0) Or (Pos('= record', LowLine) > 0)
               Or (Pos('= interface', LowLine) > 0) Then
              Inc(TypeDepth)
            Else If (LowLine = 'end;') And (TypeDepth > 0) Then
                   Dec(TypeDepth);
            If TypeDepth > 0 Then Continue;
            If (Pos('function ', LowLine) = 1) Or (Pos('procedure ', LowLine) =
               1) Then
              InTypeSection := False
            Else
              Continue;
          End;

        IsFunc := False;
        If Pos('function ', LowLine) = 1 Then IsFunc := True
        Else If Pos('procedure ', LowLine) = 1 Then IsFunc := False
        Else Continue;


       // Ignore class/method forward qualifiers or procedural type declarations
        If IsFunc Then SigPart := Trim(Copy(Line, 10, MaxInt))
        Else SigPart := Trim(Copy(Line, 11, MaxInt));
        If Pos('.', SigPart) > 0 Then Continue;

        POpen := Pos('(', SigPart);
        PClose := Pos(')', SigPart);
        PSemi := Pos(';', SigPart);
        If POpen > 0 Then
          FuncName := Trim(Copy(SigPart, 1, POpen - 1))
        Else
          Begin
            PColon := Pos(':', SigPart);
            If (IsFunc) And (PColon > 0) Then
              FuncName := Trim(Copy(SigPart, 1, PColon - 1))
            Else If PSemi > 0 Then
                   FuncName := Trim(Copy(SigPart, 1, PSemi - 1))
            Else
              FuncName := Trim(SigPart);
          End;
        If (FuncName = '') Or (Pos(' ', FuncName) > 0) Then Continue;

        RawParams := '';
        If (POpen > 0) And (PClose > POpen) Then
          RawParams := Copy(SigPart, POpen + 1, PClose - POpen - 1);

        PasParams := '';
        CallArgs := '';
        If Trim(RawParams) <> '' Then
          Begin
            Groups.Delimiter := ';';
            Groups.StrictDelimiter := True;
            Groups.DelimitedText := RawParams;
            For J := 0 To Groups.Count - 1 Do
              Begin
                RetPart := Trim(Groups[J]);
                If RetPart = '' Then Continue;
                PColon := Pos(':', RetPart);
                If PColon <= 0 Then Continue;
                Line := Trim(Copy(RetPart, 1, PColon - 1));
                LowLine := Trim(Copy(RetPart, PColon + 1, MaxInt));
                Line := Trim(StringReplace(Line, 'const ', '', [rfIgnoreCase]));
                Line := Trim(StringReplace(Line, 'var ', '', [rfIgnoreCase]));
                Line := Trim(StringReplace(Line, 'out ', '', [rfIgnoreCase]));
                Ids.Delimiter := ',';
                Ids.StrictDelimiter := True;
                Ids.DelimitedText := Line;
                For K := 0 To Ids.Count - 1 Do
                  Begin
                    Line := Trim(Ids[K]);
                    If Line = '' Then Continue;
                    If PasParams <> '' Then PasParams := PasParams + '; ';
                    PasParams := PasParams + Line + ': ' + LowLine;
                    If CallArgs <> '' Then CallArgs := CallArgs + ', ';
                    CallArgs := CallArgs + Line;
                  End;
              End;
          End;

        If PasParams <> '' Then PasParams := '(' + PasParams + ')';
        If IsFunc Then
          OutMethodsPas := OutMethodsPas +
                           '  function ' + FuncName + PasParams + ': JSValue;' +
                           #10 +
                           '  begin' + #10 +
                           '    Result := ' + UnitName + '.' + FuncName + '(' +
                           CallArgs + ');' + #10 +
                           '  end;' + #10
        Else
          OutMethodsPas := OutMethodsPas +
                           '  procedure ' + FuncName + PasParams + ';' + #10 +
                           '  begin' + #10 +
                           '    ' + UnitName + '.' + FuncName + '(' + CallArgs +
                           ');' + #10 +
                           '  end;' + #10;
      End;
  Finally
    Lines.Free;
    Groups.Free;
    Ids.Free;
End;
End;

Procedure CompileDelSafeSharedModules(Const ProjectRoot: String);

Var 
  GenDir, DelsafecExe, FileSrc, BaseName, HashFile, CurHash, OldHash,
  OutPas, RawOut, IncKey: string;
  SearchPaths, Files, ParamsList: TStringList;
  I, J, RC: Integer;
Begin
  SearchPaths := TStringList.Create;
  Files := TStringList.Create;
  Try
    ResolveDelSafeSearchPaths(ProjectRoot, SearchPaths);
    If SearchPaths.Count = 0 Then Exit;

    For I := 0 To SearchPaths.Count - 1 Do
      ScanDirForDels(SearchPaths[I], Files);

    // Exclude *.test.dels files (handled by bv test)
    For I := Files.Count - 1 Downto 0 Do
      If Pos('.test.dels', LowerCase(ExtractFileName(Files[I]))) > 0 Then
        Files.Delete(I);

    If Files.Count = 0 Then Exit;

    DelsafecExe := FindDelsafecPath;
    If DelsafecExe = '' Then
      Begin
        WriteLn(
'ERROR: Found DelSafe service modules (.dels), but "delsafec" compiler was not found in PATH or DELSAFEC_PATH.'
        );
        Halt(1);
      End;

    GenDir := IncludeTrailingPathDelimiter(ProjectRoot) + '.blaisevue' +
              DirectorySeparator + 'generated';
    ForceDir(GenDir);
    IncKey := SearchPaths.CommaText;

    For I := 0 To Files.Count - 1 Do
      Begin
        FileSrc := Files[I];
        BaseName := ChangeFileExt(ExtractFileName(FileSrc), '');
        CurHash := ComputeTextHash(ReadFileToString(FileSrc) + '|' + IncKey);
        HashFile := IncludeTrailingPathDelimiter(GenDir) + BaseName + '.hash';
        OutPas := IncludeTrailingPathDelimiter(GenDir) + BaseName + '.pas';
        OldHash := '';
        If FileExists(HashFile) Then OldHash := Trim(ReadFileToString(HashFile))
        ;

        If (CurHash = OldHash) And FileExists(OutPas) And FileExists(
           IncludeTrailingPathDelimiter(GenDir) + 'uDelSafeRuntime.pas') Then
          Begin
            WriteLn('  [delsafe service cache] ', BaseName, '.dels (up to date)')
            ;
            Continue;
          End;

        WriteLn('  [delsafe service] ', BaseName,
                '.dels -> .blaisevue/generated/', BaseName, '.pas');
        ParamsList := TStringList.Create;
        Try
          ParamsList.Add('emit');
          ParamsList.Add('pascal');
          ParamsList.Add(FileSrc);
          ParamsList.Add('--unit');
          ParamsList.Add('--shared-runtime');
          ParamsList.Add('--out-dir=' + GenDir);
          For J := 0 To SearchPaths.Count - 1 Do
            Begin
              ParamsList.Add('-I');
              ParamsList.Add(SearchPaths[J]);
            End;
          ParamsList.Add('--emit-json-diag');
          ParamsList.Add('--silent');
          RC := ExecProcessCaptureExit(DelsafecExe, ParamsList.ToStringArray,
                RawOut);
        Finally
          ParamsList.Free;
      End;
    If RC <> 0 Then
      Begin
        PrintDelSafeJsonDiagnostics(RawOut, FileSrc);
        Halt(1);
      End;
    WriteStringToFile(HashFile, CurHash);
End;
Finally
  Files.Free;
  SearchPaths.Free;
End;
End;

Function MapDelSafeParamTypeToPascal(Const ATyp: String): string;

Var 
  L: string;
Begin
  L := LowerCase(Trim(ATyp));
  If (L = 'int32') Or (L = 'int64') Or (L = 'uint32') Or (L = 'integer') Then
    Result := 'Integer'
  Else If (L = 'float32') Or (L = 'float64') Or (L = 'double') Then Result := 


                                                                        'Double'
  Else If (L = 'bool') Or (L = 'boolean') Then Result := 'Boolean'
  Else If L = 'string' Then Result := 'string'
  Else If L = 'char' Then Result := 'Char'
  Else Result := 'JSValue';
End;

Function ConvertDelSafeParamsToPascal(Const RawParams: String; out PasParams,
                                     CallArgs: String; out ParamCountOut:
                                     Integer): Boolean;

Var 
  Groups, Ids: TStringList;
  I, J, ColonPos: Integer;
  G, LeftPart, TypPart, PasTyp, PName: string;
Begin
  Result := True;
  PasParams := '';
  CallArgs := '';
  ParamCountOut := 0;
  If Trim(RawParams) = '' Then Exit;

  Groups := TStringList.Create;
  Ids := TStringList.Create;
  Try
    Groups.Delimiter := ';';
    Groups.StrictDelimiter := True;
    Groups.DelimitedText := RawParams;
    For I := 0 To Groups.Count - 1 Do
      Begin
        G := Trim(Groups[I]);
        If G = '' Then Continue;
        ColonPos := Pos(':', G);
        If ColonPos > 0 Then
          Begin
            LeftPart := Trim(Copy(G, 1, ColonPos - 1));
            TypPart := Trim(Copy(G, ColonPos + 1, Length(G)));
            LeftPart := Trim(StringReplace(LeftPart, 'mut borrow ', '', [
                        rfReplaceAll, rfIgnoreCase]));
            LeftPart := Trim(StringReplace(LeftPart, 'borrow ', '', [
                        rfReplaceAll, rfIgnoreCase]));
            LeftPart := Trim(StringReplace(LeftPart, 'move ', '', [rfReplaceAll,
                        rfIgnoreCase]));
            PasTyp := MapDelSafeParamTypeToPascal(TypPart);

            Ids.Delimiter := ',';
            Ids.StrictDelimiter := True;
            Ids.DelimitedText := LeftPart;
            For J := 0 To Ids.Count - 1 Do
              Begin
                PName := Trim(Ids[J]);
                If PName = '' Then Continue;
                If PasParams <> '' Then PasParams := PasParams + '; ';
                PasParams := PasParams + PName + ': ' + PasTyp;
                If CallArgs <> '' Then CallArgs := CallArgs + ', ';
                CallArgs := CallArgs + PName;
                Inc(ParamCountOut);
              End;
          End;
      End;
  Finally
    Groups.Free;
    Ids.Free;
End;
End;

Procedure BuildDelSafeSourceAndWrappers(
                                       Const LogicModName, BVFilePath: String;
                                       Const Parsed: TBVParsed;
                                       IsWasmMode: Boolean;
                                       out DelsSource: String;
                                       out LineOffset: Integer;
                                       out OutMethodsPas: String;
                                       out OutComputedPas: String
);

Var 
  RawLines, UsesParts: TStringList;
  I, SubSec, HeaderLines, POpen, PClose, PRet, Arity: Integer;
  Line, Trimmed, LowTrim, SigLine, NamePart, RawParamStr, PasParams, CallArgs,
  WrapperSig, CallStmt, RetType: string;
  FwdDecls, ImportsPart, HeaderLine, BodyBlock: string;
  IsFunc, HasInterfaceAlready: Boolean;
  ProjectRoot, SharedDir, UItem: string;
Begin
  OutMethodsPas := '';
  OutComputedPas := '';
  ImportsPart := '';
  FwdDecls := '';
  BodyBlock := '';

  ProjectRoot := GetCurrentDir;
  If (Not IsWasmMode) And (Trim(Parsed.ScriptUses) <> '') Then
    Begin
      UsesParts := TStringList.Create;
      Try
        UsesParts.CommaText := Parsed.ScriptUses;
        For I := 0 To UsesParts.Count - 1 Do
          Begin
            UItem := Trim(UsesParts[I]);
            If UItem <> '' Then
              Begin
                If (FindDelSafeModuleFile(ProjectRoot, UItem) <> '') Or
                   FileExists(IncludeTrailingPathDelimiter(ProjectRoot) +
                   '.blaisevue' + DirectorySeparator + 'generated' +
                   DirectorySeparator + UItem + '.pas') Then
                  ImportsPart := ImportsPart + ' import ' + UItem + ';'
                Else
                  AppendPascalServiceWrappers(ProjectRoot, UItem, OutMethodsPas)
                ;
              End;
          End;
      Finally
        UsesParts.Free;
    End;
End;

HasInterfaceAlready := (Pos(#10'interface', #10 + LowerCase(Parsed.
                       RawScriptBlock)) > 0) And
                       (Pos(#10'implementation', #10 + LowerCase(Parsed.
                       RawScriptBlock)) > 0);

RawLines := TStringList.Create;
Try
  RawLines.Text := Parsed.RawScriptBlock;
  SubSec := 0;
  // 0=top-level, 1=data, 2=props, 3=methods, 4=computed, 5=other
  For I := 0 To RawLines.Count - 1 Do
    Begin
      Line := RawLines[I];
      Trimmed := Trim(Line);
      LowTrim := LowerCase(Trimmed);

      If LowTrim = 'data:' Then
        Begin
          SubSec := 1;
          BodyBlock := BodyBlock + #10;
          Continue;
        End;
      If LowTrim = 'props:' Then
        Begin
          SubSec := 2;
          BodyBlock := BodyBlock + #10;
          Continue;
        End;
      If LowTrim = 'methods:' Then
        Begin
          SubSec := 3;
          BodyBlock := BodyBlock + #10;
          Continue;
        End;
      If LowTrim = 'computed:' Then
        Begin
          SubSec := 4;
          BodyBlock := BodyBlock + #10;
          Continue;
        End;
      If (LowTrim = 'created:') Or (LowTrim = 'mounted:') Or (LowTrim =
         'updated:') Or (LowTrim = 'watch:') Or (LowTrim = 'router:') Or
         (LowTrim = 'routes:') Or (LowTrim = 'provide:') Or (LowTrim = 'inject:'
         ) Then
        Begin
          SubSec := 5;
          BodyBlock := BodyBlock + #10;
          Continue;
        End;

      If (SubSec = 1) Or (SubSec = 2) Or (SubSec = 5) Then
        Begin



     // Blank out declarative UI sections so line numbers remain faithful to .bv
          BodyBlock := BodyBlock + #10;
          Continue;
        End;

      BodyBlock := BodyBlock + Line + #10;




// Detect top-level routine headers inside raw script for interface forward decl + wrapper generation
      If (Pos('function ', LowTrim) = 1) Or (Pos('procedure ', LowTrim) = 1)
        Then
        Begin
          IsFunc := (Pos('function ', LowTrim) = 1);
          SigLine := Trimmed;
          If IsFunc Then
            SigLine := Trim(Copy(SigLine, 10, Length(SigLine)))
          Else
            SigLine := Trim(Copy(SigLine, 11, Length(SigLine)));

          If (Length(SigLine) >= 3) And (LowerCase(Copy(SigLine, Length(SigLine)
             - 2, 3)) = ' is') Then
            SigLine := Trim(Copy(SigLine, 1, Length(SigLine) - 3))
          Else If LowerCase(SigLine) = 'is' Then
                 SigLine := '';

          If SigLine <> '' Then
            Begin
              If IsFunc Then
                FwdDecls := FwdDecls + ' function ' + SigLine + ';'
              Else
                FwdDecls := FwdDecls + ' procedure ' + SigLine + ';';
            End;

          If Not IsWasmMode Then
            Begin
              POpen := Pos('(', SigLine);
              If POpen > 0 Then
                Begin
                  NamePart := Trim(Copy(SigLine, 1, POpen - 1));
                  PClose := Pos(')', SigLine);
                  If PClose > POpen Then
                    RawParamStr := Copy(SigLine, POpen + 1, PClose - POpen - 1)
                  Else
                    RawParamStr := '';
                End
              Else
                Begin
                  PRet := Pos(' return ', LowerCase(SigLine));
                  If PRet > 0 Then
                    NamePart := Trim(Copy(SigLine, 1, PRet - 1))
                  Else
                    NamePart := Trim(StringReplace(SigLine, ';', '', [
                                rfReplaceAll]));
                  RawParamStr := '';
                End;

              NamePart := Trim(StringReplace(NamePart, ';', '', [rfReplaceAll]))
              ;
              If (NamePart <> '') And (Pos('<', NamePart) = 0) Then
                Begin
                  ConvertDelSafeParamsToPascal(RawParamStr, PasParams, CallArgs,
                                              Arity);
                  If Arity = 0 Then WrapperSig := NamePart
                  Else WrapperSig := NamePart + '(' + PasParams + ')';

                  If IsFunc Then
                    Begin
                      PRet := Pos(' return ', LowerCase(SigLine));
                      If PRet > 0 Then
                        RetType := MapDelSafeParamTypeToPascal(Trim(StringReplace
                                   (
                                   Copy(SigLine, PRet + 8, Length(SigLine)), ';'
                                   ,
                                   '', [rfReplaceAll])))
                      Else
                        RetType := 'JSValue';
                      CallStmt := LogicModName + '.' + NamePart + '(' + CallArgs
                                  +
                                  ')';
                      If SubSec = 4 Then
                        OutComputedPas := OutComputedPas +
                                          '  function ' + NamePart + ': ' +
                                          RetType
                                          + ';' + #10 +
                                          '  begin' + #10 +
                                          '    Result := ' + CallStmt + ';' + #10 +
                                          '  end;' + #10
                      Else
                        OutMethodsPas := OutMethodsPas +
                                         '  function ' + WrapperSig + ': ' +
                                         RetType
                                         + ';' + #10 +
                                         '  begin' + #10 +
                                         '    Result := ' + CallStmt + ';' + #10
                                         +
                                         '  end;' + #10;
                    End
                  Else
                    Begin
                      CallStmt := LogicModName + '.' + NamePart + '(' + CallArgs
                                  + ');';
                      OutMethodsPas := OutMethodsPas +
                                       '  procedure ' + WrapperSig + ';' + #10 +
                                       '  begin' + #10 +
                                       '    ' + CallStmt + #10 +
                                       '  end;' + #10;
                    End;
                End;
            End;
        End;
    End;
Finally
  RawLines.Free;
End;

If HasInterfaceAlready Then
  HeaderLine := 'module ' + LogicModName + ';' + ImportsPart
Else
  HeaderLine := 'module ' + LogicModName + ';' + ImportsPart + ' interface' +
                FwdDecls + ' implementation';

DelsSource := HeaderLine + #10 + BodyBlock;
If Not HasInterfaceAlready Then
  DelsSource := DelsSource + 'end ' + LogicModName + '.' + #10;

HeaderLines := 1;
If Parsed.ScriptStartLine > HeaderLines Then
  LineOffset := Parsed.ScriptStartLine - HeaderLines
Else
  LineOffset := 0;
End;

Procedure ProcessDelSafeComponentScript(Const BVFilePath, UnitName, BaseCompName:
                                       String; Var Parsed: TBVParsed);

Var 
  DelsafecExe, ProjectRoot, TmpDir, GenDir, WasmDir: string;
  LogicModName, DelsSource, TmpDelsFile, HashFile, CurHash, OldHash, OutPas,
  OutWasm, OutManifest, RawOut: string;
  MethodsPas, ComputedPas, ManifestJson, PasParams, WasmPushLines, ArgName:
                                                                          string
  ;
  LineOffset, RC, I, J: Integer;
  SearchPaths, ParamsList: TStringList;
  JData: TJSONData;
  RootObj, ExpObj, PObj: TJSONObject;
  ExportsArr, ParamsArr: TJSONArray;
  Meta: TWasmExportMeta;
  IsProc: Boolean;
Begin
  If Parsed.ScriptLang <> 'delsafe' Then Exit;

  DelsafecExe := FindDelsafecPath;
  If DelsafecExe = '' Then
    Begin
      WriteLn('ERROR: ', ExtractFileName(BVFilePath),
      ' uses <script lang="delsafe">, but "delsafec" compiler was not found.');
      Halt(1);
    End;

  ProjectRoot := GetCurrentDir;
  TmpDir := IncludeTrailingPathDelimiter(ProjectRoot) + '.blaisevue' +
            DirectorySeparator + 'tmp';
  GenDir := IncludeTrailingPathDelimiter(ProjectRoot) + '.blaisevue' +
            DirectorySeparator + 'generated';
  WasmDir := IncludeTrailingPathDelimiter(ProjectRoot) + '.blaisevue' +
             DirectorySeparator + 'wasm';
  ForceDir(TmpDir);
  ForceDir(GenDir);

  If Parsed.ScriptTarget = 'wasm' Then
    Begin
      ForceDir(WasmDir);
      LogicModName := BaseCompName + '_wasm';
      BuildDelSafeSourceAndWrappers(LogicModName, BVFilePath, Parsed, True,
                                   DelsSource, LineOffset, MethodsPas,
                                   ComputedPas);

      TmpDelsFile := IncludeTrailingPathDelimiter(TmpDir) + LogicModName +
                     '.dels';
      OutWasm := IncludeTrailingPathDelimiter(WasmDir) + BaseCompName + '.wasm';
      OutManifest := OutWasm + '.json';
      HashFile := IncludeTrailingPathDelimiter(WasmDir) + BaseCompName +
                  '.wasm.hash';

      CurHash := ComputeTextHash(DelsSource + '|Offset:' + IntToStr(LineOffset))
      ;
      OldHash := '';
      If FileExists(HashFile) Then OldHash := Trim(ReadFileToString(HashFile));

      If (CurHash = OldHash) And FileExists(OutWasm) And FileExists(OutManifest)
        Then
        Begin
          WriteLn('  [delsafe wasm cache] ', ExtractFileName(BVFilePath),
          ' (up to date)');
        End
      Else
        Begin
          WriteStringToFile(TmpDelsFile, DelsSource);
          WriteLn('  [delsafe wasm] ', ExtractFileName(BVFilePath),
          ' -> .blaisevue/wasm/', BaseCompName, '.wasm');
          RC := ExecProcessCaptureExit(DelsafecExe, [
                'emit', 'wasm', TmpDelsFile,
                '-o', OutWasm,
                '--manifest',
                '--source-file=' + BVFilePath,
                '--line-offset=' + IntToStr(LineOffset),
                '--emit-json-diag', '--silent'
                ], RawOut);
          If RC <> 0 Then
            Begin
              PrintDelSafeJsonDiagnostics(RawOut, BVFilePath);
              Halt(1);
            End;
          WriteStringToFile(HashFile, CurHash);
        End;

      Parsed.WasmModuleName := BaseCompName;
      Parsed.MethodsCode := '';
      Parsed.ComputedCode := '';
      Parsed.MountedCode := '  TBVWasm.LoadFromUrl(''' + BaseCompName +
                            ''', ''/wasm/' + BaseCompName + '.wasm'');' + #10 +
                            Parsed.MountedCode;

      If FileExists(OutManifest) Then
        Begin
          ManifestJson := ReadFileToString(OutManifest);
          JData := GetJSON(ManifestJson);
          Try
            If (JData <> Nil) And (JData.JSONType = jtObject) Then
              Begin
                RootObj := TJSONObject(JData);
                If RootObj.Find('exports', ExportsArr) Then
                  Begin
                    SetLength(Parsed.WasmExports, ExportsArr.Count);
                    For I := 0 To ExportsArr.Count - 1 Do
                      Begin
                        ExpObj := ExportsArr.Objects[I];
                        Meta.Name := GetJsonString(ExpObj, 'name', '');
                        Meta.ReturnType := GetJsonString(ExpObj, 'return_type',
                                           'Void');
                        IsProc := ExpObj.Get('is_procedure', False);
                        PasParams := '';
                        WasmPushLines := '';
                        Meta.Arity := 0;
                        If ExpObj.Find('params', ParamsArr) Then
                          Begin
                            Meta.Arity := ParamsArr.Count;
                            For J := 0 To ParamsArr.Count - 1 Do
                              Begin
                                PObj := ParamsArr.Objects[J];
                                ArgName := GetJsonString(PObj, 'name', 'arg' +
                                           IntToStr(J));
                                If PasParams <> '' Then PasParams := PasParams +
                                                                     '; ';
                                PasParams := PasParams + ArgName + ': ' +
                                             MapDelSafeParamTypeToPascal(
                                             GetJsonString(PObj, 'type',
                                             'JSValue'));
                                WasmPushLines := WasmPushLines +
                                                 '    _wasmArgs.push(' + ArgName
                                                 + ');' + #10;
                              End;
                          End;
                        Meta.ParamsRaw := PasParams;
                        Parsed.WasmExports[I] := Meta;

                        If Meta.Name <> '' Then
                          Begin
                            If PasParams <> '' Then PasParams := '(' + PasParams
                                                                 + ')'
                            Else PasParams := '';
                            Parsed.MethodsCode := Parsed.MethodsCode +
                                                  '  function ' + Meta.Name +
                                                  PasParams + ': JSValue;' + #10
                                                  +
                                                  '  var _wasmArgs: TJSArray;' +
                                                  #10 +
                                                  '  begin' + #10 +



                                                '    _wasmArgs := TJSArray.new;'
                                                  + #10 +
                                                  WasmPushLines +



                                                 '    Result := TBVWasm.Call('''
                                                  + BaseCompName + ''', ''' +
                                                  Meta.Name + ''', _wasmArgs);'
                                                  + #10 +
                                                  '  end;' + #10;
                          End;
                      End;
                  End;
              End;
          Finally
            If JData <> Nil Then JData.Free;
        End;
    End;
  Exit;
End;

// Standard DelSafe -> Object Pascal unit mode
LogicModName := UnitName + '_logic';
BuildDelSafeSourceAndWrappers(LogicModName, BVFilePath, Parsed, False, DelsSource
                             , LineOffset, MethodsPas, ComputedPas);

TmpDelsFile := IncludeTrailingPathDelimiter(TmpDir) + LogicModName + '.dels';
OutPas := IncludeTrailingPathDelimiter(GenDir) + LogicModName + '.pas';
HashFile := IncludeTrailingPathDelimiter(GenDir) + LogicModName + '.hash';
CurHash := ComputeTextHash(DelsSource + '|Uses:' + Parsed.ScriptUses +
           '|Offset:' + IntToStr(LineOffset));
OldHash := '';
If FileExists(HashFile) Then OldHash := Trim(ReadFileToString(HashFile));

If (CurHash = OldHash) And FileExists(OutPas) And FileExists(
   IncludeTrailingPathDelimiter(GenDir) + 'uDelSafeRuntime.pas') Then
  Begin
    WriteLn('  [delsafe cache] ', ExtractFileName(BVFilePath), ' (up to date)');
  End
Else
  Begin
    WriteStringToFile(TmpDelsFile, DelsSource);
    WriteLn('  [delsafe] ', ExtractFileName(BVFilePath),
    ' -> .blaisevue/generated/', LogicModName, '.pas');
    SearchPaths := TStringList.Create;
    ParamsList := TStringList.Create;
    Try
      ResolveDelSafeSearchPaths(ProjectRoot, SearchPaths);
      ParamsList.Add('emit');
      ParamsList.Add('pascal');
      ParamsList.Add(TmpDelsFile);
      ParamsList.Add('--unit');
      ParamsList.Add('--shared-runtime');
      ParamsList.Add('--out-dir=' + GenDir);
      For I := 0 To SearchPaths.Count - 1 Do
        Begin
          ParamsList.Add('-I');
          ParamsList.Add(SearchPaths[I]);
        End;
      ParamsList.Add('--source-file=' + BVFilePath);
      ParamsList.Add('--line-offset=' + IntToStr(LineOffset));
      ParamsList.Add('--emit-json-diag');
      ParamsList.Add('--silent');
      RC := ExecProcessCaptureExit(DelsafecExe, ParamsList.ToStringArray, RawOut)
      ;
    Finally
      ParamsList.Free;
      SearchPaths.Free;
  End;
If RC <> 0 Then
  Begin
    PrintDelSafeJsonDiagnostics(RawOut, BVFilePath);
    Halt(1);
  End;
WriteStringToFile(HashFile, CurHash);
End;

Parsed.DelSafeLogicUnit := LogicModName;
Parsed.MethodsCode := MethodsPas;
Parsed.ComputedCode := ComputedPas;
End;

Procedure CopyWasmArtifactsToDist(Const ProjectRoot, DistPath: String);

Var 
  WasmSrcDir, WasmDestDir: string;
  SR: TSearchRec;
  SrcFS, DstFS: TFileStream;
Begin
  WasmSrcDir := IncludeTrailingPathDelimiter(ProjectRoot) + '.blaisevue' +
                DirectorySeparator + 'wasm';
  If Not DirectoryExists(WasmSrcDir) Then Exit;
  If FindFirst(IncludeTrailingPathDelimiter(WasmSrcDir) + '*.wasm', faAnyFile,
     SR) = 0 Then
    Begin
      WasmDestDir := IncludeTrailingPathDelimiter(DistPath) + 'wasm';
      ForceDir(WasmDestDir);
      Repeat
        If (SR.Attr And faDirectory) = 0 Then
          Begin
            SrcFS := TFileStream.Create(IncludeTrailingPathDelimiter(WasmSrcDir)
                     + SR.Name, fmOpenRead Or fmShareDenyNone);
            Try
              DstFS := TFileStream.Create(IncludeTrailingPathDelimiter(
                       WasmDestDir) + SR.Name, fmCreate);
              Try
                DstFS.CopyFrom(SrcFS, 0);
              Finally
                DstFS.Free;
          End;
      Finally
        SrcFS.Free;
    End;
  WriteLn('  [wasm] ', SR.Name, ' -> dist/wasm/');
End;
Until FindNext(SR) <> 0;
FindClose(SR);
End;
End;

Procedure CmdTranspile;

Var 
  SR: TSearchRec;
  BVFiles: TStringList;
  UnitNames: TStringList;
  i: Integer;
  FileName, UnitName, TagName, GenPath: string;
  Parsed: TBVParsed;
  GeneratedCode: string;
  IsApp: Boolean;
Begin
  GenPath := GetCurrentDir + DirectorySeparator + 'generated' +
             DirectorySeparator;
  SyncProjectVersionUnit(GenPath);
  If Not DirectoryExists(GetCurrentDir + DirectorySeparator + 'src') Then
    Begin
      Exit;
    End;

  ForceDir(GenPath);
  BVFiles := TStringList.Create;
  UnitNames := TStringList.Create;
  Try

    WriteLn('=== BlaiseVue Transpile ===');
    WriteLn('');
    CompileDelSafeSharedModules(GetCurrentDir);

    // Prepares app.bv first

    If FileExists(GetCurrentDir + DirectorySeparator + 'src' +
       DirectorySeparator + 'app.bv') Then
      BVFiles.Add(GetCurrentDir + DirectorySeparator + 'src' +
                  DirectorySeparator + 'app.bv');

    // Scans src and lib recursively

    ScanDirForBV(GetCurrentDir + DirectorySeparator + 'src' + DirectorySeparator
                 + 'components', BVFiles);
    ScanDirForBV(GetCurrentDir + DirectorySeparator + 'src' + DirectorySeparator
                 + 'views', BVFiles);
    ScanDirForBV(GetCurrentDir + DirectorySeparator + 'lib', BVFiles);
    If BVFiles.Count = 0 Then
      Begin
        WriteLn('  (No .bv components found in src/ or lib/)');
        Exit;
      End;

    WriteLn('Processing ', BVFiles.Count, ' .bv file(s) ...');
    WriteLn('');

    // Step 1: Identify units

    For i := 0 To BVFiles.Count - 1 Do
      Begin
        FileName := ExtractFileName(BVFiles[i]);
        FileName := ChangeFileExt(FileName, '');
        If LowerCase(FileName) = 'app' Then
          UnitName := 'uApp'

        Else
          UnitName := 'u' + FileName;

        UnitNames.Add(UnitName);
      End;

    // Step 2: Generate .pas code

    For i := 0 To BVFiles.Count - 1 Do
      Begin
        FileName := ExtractFileName(BVFiles[i]);
        IsApp := (LowerCase(ChangeFileExt(FileName, '')) = 'app');
        UnitName := UnitNames[i];
        TagName := PascalToKebab(ChangeFileExt(FileName, ''));
        If (Not IsApp) And (Pos('src' + DirectorySeparator + 'views', BVFiles[i]
           ) > 0) Then
          TagName := TagName + '-page';

        WriteLn('  ', FileName, ' -> ', UnitName, '.pas');
        ParseBVFile(BVFiles[i], Parsed);
        ProcessDelSafeComponentScript(BVFiles[i], UnitName, ChangeFileExt(
                                     FileName, ''), Parsed);
        ValidateComponentTemplate(BVFiles[i], Parsed);
        If IsApp Then
          GeneratedCode := GenerateAppUnit(Parsed, UnitNames)

        Else
          GeneratedCode := GenerateComponentUnit(UnitName, TagName, FileName,
                           Parsed);

        WriteStringToFile(GenPath + UnitName + '.pas', GeneratedCode);
      End;

    // Generates main.pas

    GeneratedCode := GenerateMainProgram;
    WriteStringToFile(GenPath + 'main.pas', GeneratedCode);
    WriteLn('  main.pas (generated)');
    WriteLn('');
    WriteLn('Transpile completed successfully! Files generated in: ', GenPath);

  Finally

    BVFiles.Free;
    UnitNames.Free;
End;
End;

