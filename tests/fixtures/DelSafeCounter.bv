<template>
  <div class="delsafe-counter">
    <span class="delsafe-val">{{ stepValue(base) }}</span>
  </div>
</template>

<script lang="delsafe">
  data:
    base: integer = 5;

  methods:
    function stepValue(n: Int32) return Int32 is
    begin
      return n * 2 + 1;
    end stepValue;
</script>
