<template>
  <teleport to="body">
    <div class="bui-modal-backdrop" b-if="show" @click="handleBackdropClick">
      <div class="bui-modal-content" @click.stop="">
        <div class="bui-modal-header">
          <span>{{ title }}</span>
          <button class="bui-modal-close" @click="close">&times;</button>
        </div>
        <div class="bui-modal-body">
          <slot></slot>
        </div>
        <div class="bui-modal-footer">
          <slot name="footer">
            <button class="bui-btn bui-btn-secondary" @click="close">{{ cancelLabel }}</button>
            <button class="bui-btn bui-btn-primary" @click="confirm">{{ okLabel }}</button>
          </slot>
        </div>
      </div>
    </div>
  </teleport>
</template>

<script>
  {
    BVModal - Teleported Interactive Dialog
    ----------------------------------------
    Props:
    - title: String modal title
    - okLabel: String confirmation label
    - cancelLabel: String cancellation label
  }

  props:
    title: string = 'Modal';
    okLabel: string = 'Process';
    cancelLabel: string = 'Close';

  data:
    show: boolean = false;

  methods:
    procedure showModal;
    begin
      this['show'] := true;
    end;

    procedure show;
    begin
      this['show'] := true;
    end;

    procedure close;
    begin
      this['show'] := false;
      asm this.$emit('close'); end;
    end;

    procedure confirm;
    begin
      this['show'] := false;
      asm this.$emit('ok'); end;
    end;

    procedure handleBackdropClick;
    begin
      asm this.close(); end;
    end;
</script>
