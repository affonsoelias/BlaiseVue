<template>
  <div :class="'bui-drawer-wrapper' + (isOpen ? ' is-open' : '')">
    <div class="bui-drawer-backdrop" v-if="isOpen && overlay" @click="close"></div>
    <aside :class="'bui-drawer bui-drawer-' + (position || 'left') + (isOpen ? ' is-open' : '')" :style="'width: ' + (width || '280px')">
      <div class="bui-drawer-header">
        <slot name="header">
          <strong class="bui-drawer-title">{{ title }}</strong>
          <button class="bui-drawer-close" type="button" @click="close">&times;</button>
        </slot>
      </div>
      <div class="bui-drawer-body">
        <slot></slot>
      </div>
      <div class="bui-drawer-footer" v-if="hasFooter">
        <slot name="footer"></slot>
      </div>
    </aside>
  </div>
</template>

<script>
  {
    BVDrawer - Responsive Offcanvas Navigation Drawer
    --------------------------------------------------
    Props:
    - title: String title in header
    - width: String drawer width (e.g. '280px')
    - position: String 'left' or 'right'
    - overlay: Boolean show backdrop
    - hasFooter: Boolean toggle footer
    - show: Boolean initial state
  }

  props:
    title: string = 'Menu';
    width: string = '280px';
    position: string = 'left';
    overlay: boolean = true;
    hasFooter: boolean = false;
    show: boolean = false;

  data:
    isOpen: boolean = false;
    position: string = 'left';
    width: string = '280px';
    overlay: boolean = true;
    hasFooter: boolean = false;

  created:
    begin
      if (this['show'] = true) or (this['show'] = 'true') then
        this['isOpen'] := true
      else
        this['isOpen'] := false;
    end;

  methods:
    procedure open;
    begin
      this['isOpen'] := true;
      asm this.$emit('open'); end;
    end;

    procedure close;
    begin
      this['isOpen'] := false;
      asm this.$emit('close'); end;
    end;

    procedure toggle;
    begin
      this['isOpen'] := not Boolean(this['isOpen']);
      if Boolean(this['isOpen']) then
      begin
        asm this.$emit('open'); end;
      end
      else
      begin
        asm this.$emit('close'); end;
      end;
    end;
</script>

<style>
.bui-drawer-wrapper {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1050;
  pointer-events: none;
  visibility: hidden;
}
.bui-drawer-wrapper.is-open {
  pointer-events: auto;
  visibility: visible;
}
.bui-drawer-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(2px);
  z-index: 1050;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: auto;
}
.bui-drawer-wrapper.is-open .bui-drawer-backdrop {
  opacity: 1;
}
.bui-drawer {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  width: 280px;
  max-width: 85vw;
  background: var(--bui-card-bg, #fff);
  color: var(--bui-text, #1e293b);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
  z-index: 1060;
  display: flex;
  flex-direction: column;
  transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  box-sizing: border-box;
  pointer-events: auto;
  visibility: visible;
}
.bui-drawer-left {
  left: 0;
  right: auto;
  transform: translateX(-100%);
}
.bui-drawer-left.is-open {
  transform: translateX(0);
}
.bui-drawer-right {
  left: auto;
  right: 0;
  transform: translateX(100%);
}
.bui-drawer-right.is-open {
  transform: translateX(0);
}
</style>
