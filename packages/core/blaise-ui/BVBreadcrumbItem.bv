<template>
  <li class="bui-breadcrumb-item" :class="{ active: active }">
    <a class="bui-breadcrumb-link" :href="active ? null : href" @click="handleClick">
      <slot></slot>
    </a>
  </li>
</template>

<script>
  {
    BVBreadcrumbItem - Path Trail Step
    ----------------------------------
    Props:
    - active: boolean
    - href: string
  }
  
  props:
    active: boolean = false;
    href: string = '#';

  methods:
    procedure handleClick(ev: TJSEvent);
    begin
       asm
         if (this.active && this.active !== 'false') {
           if (ev && ev.preventDefault) ev.preventDefault();
           return;
         }
         this.$emit('click', ev);
       end;
    end;
</script>
